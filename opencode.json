{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "subagent_depth": 1,
  "share": "disabled",
  "plugin": ["@warp-dot-dev/opencode-warp"],
  "permission": {
    "external_directory": {
      "*": "allow",
      "D:/proyectoSis/Excels/**": "allow"
    },
    "edit": {
      "*": "allow",
      "D:/proyectoSis/Excels/**": "deny"
    },
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "git clean*": "deny",
      "git reset --hard*": "deny",
      "git checkout --*": "deny",
      "git restore*": "deny"
    }
  }
}
