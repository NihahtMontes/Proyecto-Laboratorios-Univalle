# Local Docker example. The PostgreSQL service is normally named `postgres`.
# Use `db` only when that is the service name in the deployment network.
# Never commit real values to this file or to .env.local.
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=GastroExample;Username=postgres;Password=
ConnectionStrings__ControlPlaneRuntime=Host=postgres;Port=5432;Database=GastroExample;Username=lu_auth_login;Password=
AUTH_DB_POOL_MAX=10
TENANT_DB_POOL_MAX=10
TENANT_DB_RUNTIME_ROLE=lu_auth_runtime
# The suffix is the normalized server-side runtime secret reference. Example:
# runtime reference `tenant/local/runtime` -> `TENANT_CONNECTION__TENANT_LOCAL_RUNTIME`.
TENANT_CONNECTION__TENANT_LOCAL_RUNTIME=Host=postgres;Port=5432;Database=GastroExample;Username=lu_auth_login;Password=

# Required by the Auth module. Keep these values in the container secret store.
AUTH_AUDIT_HMAC_KEY=
AUTH_ALLOWED_ORIGINS=http://localhost:5173
HOST=0.0.0.0
PORT=3000
