{
  "name": "@lu/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Cliente HTTP tipado para consumir @lu/api.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "corepack pnpm run build && node --test dist/index.test.js",
    "smoke": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@lu/contracts": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
