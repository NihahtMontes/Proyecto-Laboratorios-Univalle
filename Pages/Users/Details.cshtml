@page "{id:int}"
@model Proyecto_Laboratorios_Univalle.Pages.Users.DetailsModel
@using Proyecto_Laboratorios_Univalle.Models.Enums
@{
    ViewData["Title"] = "Detalle de Usuario";

    string ValueOrFallback(string? value, string fallback = "Sin dato")
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value;
    }

    var avatarUrl = !string.IsNullOrWhiteSpace(Model.User.ProfilePictureUrl)
        ? $"{Url.Content("~/uploads/users/" + Model.User.ProfilePictureUrl)}?v={Model.ProfilePictureVersion}"
        : null;
    var statusClass = Model.User.Status == GeneralStatus.Activo ? "success" : "danger";
}

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap align-items-center border-bottom pb-4 mb-4">
                    <div class="mr-4 mb-3 mb-md-0">
                        @if (!string.IsNullOrEmpty(avatarUrl))
                        {
                            <img src="@avatarUrl" alt="@Model.User.FullName" class="rounded-circle shadow user-detail-avatar">
                        }
                        else
                        {
                            <span class="rounded-circle bg-info text-white font-weight-bold shadow user-detail-avatar user-detail-initials">
                                @(string.IsNullOrWhiteSpace(Model.User.Initials) ? "US" : Model.User.Initials)
                            </span>
                        }
                    </div>
                    <div class="flex-grow-1">
                        <small class="text-muted text-uppercase font-weight-bold">Ficha de usuario</small>
                        <h2 class="font-weight-bold text-dark mb-1">@Model.User.FullName</h2>
                        <div class="text-muted mb-2">@ValueOrFallback(Model.User.Position, "Cargo no registrado")</div>
                        <span class="badge badge-pill badge-info px-3 py-1 mr-1">@Model.User.Role</span>
                        <span class="badge badge-pill badge-@statusClass px-3 py-1">@Model.User.Status</span>
                    </div>
                </div>

                <h5 class="font-weight-bold text-info mb-3">
                    <i class="fas fa-id-card-alt mr-2"></i> Identidad
                </h5>
                <div class="row mb-4">
                    <div class="col-md-4 mb-3">
                        <label class="user-detail-label">Nombres</label>
                        <div class="user-detail-value">@ValueOrFallback(Model.User.FirstName)</div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="user-detail-label">Apellido paterno</label>
                        <div class="user-detail-value">@ValueOrFallback(Model.User.LastName)</div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="user-detail-label">Apellido materno</label>
                        <div class="user-detail-value">@ValueOrFallback(Model.User.SecondLastName, "No registrado")</div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="user-detail-label">C.I.</label>
                        <div class="user-detail-value">@ValueOrFallback(Model.User.IdentityCard)</div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="user-detail-label">Usuario / login</label>
                        <div class="user-detail-value">@($"@{ValueOrFallback(Model.User.UserName)}")</div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="user-detail-label">Fecha de alta</label>
                        <div class="user-detail-value">@(Model.User.HireDate?.ToString("dd/MM/yyyy") ?? "No registrada")</div>
                    </div>
                </div>

                <h5 class="font-weight-bold text-info mb-3">
                    <i class="fas fa-address-book mr-2"></i> Contacto y perfil laboral
                </h5>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="user-detail-label">Correo institucional</label>
                        <div class="user-detail-value">@ValueOrFallback(Model.User.Email, "Correo no registrado")</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="user-detail-label">Telefono</label>
                        <div class="user-detail-value">@ValueOrFallback(Model.User.PhoneNumber, "Telefono no registrado")</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="user-detail-label">Cargo</label>
                        <div class="user-detail-value">@ValueOrFallback(Model.User.Position, "Cargo no registrado")</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="user-detail-label">Departamento</label>
                        <div class="user-detail-value">@ValueOrFallback(Model.User.Department, "Departamento no registrado")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h5 class="font-weight-bold text-dark mb-4">
                    <i class="fas fa-history mr-2 text-warning"></i> Auditoria
                </h5>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="user-detail-label">Creado por</label>
                        <div class="user-detail-value">@ValueOrFallback(Model.User.CreatedBy?.FullName, "Sistema")</div>
                        <small class="text-muted">@Model.User.CreatedDate.ToString("dd/MM/yyyy HH:mm")</small>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="user-detail-label">Ultima modificacion</label>
                        <div class="user-detail-value">@ValueOrFallback(Model.User.ModifiedBy?.FullName, "Sin modificaciones")</div>
                        <small class="text-muted">@(Model.User.LastModifiedDate?.ToString("dd/MM/yyyy HH:mm") ?? "Sin fecha registrada")</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm border-0 mb-4 bg-dark text-white">
            <div class="card-body p-4">
                <h5 class="card-title text-white font-weight-bold small text-uppercase mb-4">
                    <i class="fas fa-shield-alt mr-2 text-info"></i> Seguridad de acceso
                </h5>
                <hr class="border-secondary" />
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted small text-uppercase font-weight-bold">Rol</span>
                    <span class="font-weight-bold text-white">@Model.User.Role</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted small text-uppercase font-weight-bold">Estado</span>
                    <span class="badge badge-pill badge-@statusClass px-3">@Model.User.Status</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted small text-uppercase font-weight-bold">Foto</span>
                    <span class="font-weight-bold text-white">@(string.IsNullOrWhiteSpace(Model.User.ProfilePictureUrl) ? "Sin foto de perfil" : "Registrada")</span>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h5 class="card-title font-weight-bold text-dark mb-4">
                    <i class="fas fa-cogs mr-2 text-warning"></i> Acciones
                </h5>
                <a asp-page="./Edit" asp-route-id="@Model.User.Id" asp-route-returnUrl="Details" class="btn btn-warning btn-block btn-rounded text-white shadow-sm font-weight-bold py-2 mb-2">
                    <i class="fas fa-edit mr-1"></i> Modificar Perfil
                </a>
                <a asp-page="./Index" class="btn btn-outline-secondary btn-block btn-rounded py-2 font-weight-bold mb-3">
                    <i class="fas fa-list mr-1"></i> Volver al Listado
                </a>
                <a asp-page="./Delete" asp-route-id="@Model.User.Id" class="btn btn-link btn-block text-danger small font-weight-bold">
                    <i class="fas fa-user-minus mr-1"></i> Revocar Acceso
                </a>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .user-detail-avatar {
            width: 150px;
            height: 150px;
            min-width: 150px;
            object-fit: cover;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 4px solid #e0f2fe;
        }

        .user-detail-initials {
            font-size: 3.1rem;
            line-height: 1;
        }

        .user-detail-label {
            display: block;
            color: #a6b0bf;
            font-size: 0.68rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            font-weight: 700;
            margin-bottom: 0.25rem;
        }

        .user-detail-value {
            color: #1f2d3d;
            font-weight: 700;
            word-break: break-word;
        }
    </style>
}
