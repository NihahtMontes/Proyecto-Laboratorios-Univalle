@page
@model Proyecto_Laboratorios_Univalle.Pages.Countries.IndexModel
@{
    var hasActiveFilters = !string.IsNullOrWhiteSpace(Model.SearchTerm) || Model.StatusFilter.HasValue;
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-md-flex align-items-center mb-4">
                    <div>
                        <h2 class="mt-3 ml-3">Pa�ses</h2>
                    </div>
                    <div class="ml-auto mt-3">
                        <a asp-page="Create" class="btn bg-white border btn-rounded shadow-sm text-dark">
                            <i class="fas fa-plus-circle mr-1 text-info"></i> Nuevo Pa�s
                        </a>
                    </div>
                </div>

                <!-- ?? Zona de Smart Index: Filtros y B�squeda -->
                <div class="bg-light p-3 mb-4 rounded border-left border-info">
                    <form method="get" data-live-filter-form>
                        <label asp-for="SearchTerm" class="sr-only">Buscar país</label>
                        <div class="input-group mb-3">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-white border-right-0"><i class="fas fa-search text-muted"></i></span>
                            </div>
                            <input type="search" asp-for="SearchTerm"
                                   class="form-control border-left-0 @(!string.IsNullOrWhiteSpace(Model.SearchTerm) ? "border-info" : "")"
                                   placeholder="Buscar por nombre de país"
                                   autocomplete="off"
                                   data-live-filter-search />
                        </div>

                        <div class="d-flex flex-wrap align-items-center border-top pt-3">
                            <select asp-for="StatusFilter"
                                    class="custom-select btn-rounded w-auto mw-100 mr-2 mb-2 @(Model.StatusFilter.HasValue ? "border-info text-info font-weight-bold" : "")"
                                    asp-items="@Proyecto_Laboratorios_Univalle.Helpers.EnumHelper.GetStatusSelectList<Proyecto_Laboratorios_Univalle.Models.Enums.GeneralStatus>()"
                                    aria-label="Estado"
                                    data-live-filter-control>
                                <option value="">Estado</option>
                            </select>

                            @if (hasActiveFilters)
                            {
                                <a asp-page="./Index" class="btn btn-link btn-sm text-muted mb-2" title="Limpiar filtros">
                                    <i class="fas fa-times mr-1"></i> Limpiar filtros
                                </a>
                            }

                            <span class="small text-muted ml-auto mb-2" aria-live="polite">
                                <strong class="text-dark">@Model.Countries.TotalCount</strong> país(es)
                            </span>
                        </div>
                    </form>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover v-middle">
                        <thead class="thead-light">
                            <tr>
                                <th>Pa�s</th>
                                <th>Estado</th>
                                <th>Registrado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Countries)
                            {
                                <tr>
                                    <td>
                                        <h5 class="m-b-0 font-medium">@item.Name</h5>
                                    </td>
                                    <td>
                                        <span class="badge @(item.Status == Proyecto_Laboratorios_Univalle.Models.Enums.GeneralStatus.Activo ? "badge-success" : "badge-danger")">
                                            @item.Status
                                        </span>
                                    </td>
                                    <td>
                                        <small class="text-muted">@item.CreatedDate.ToString("dd/MM/yyyy")</small><br />
                                        <small class="text-info">@item.CreatedBy?.Initials</small>
                                    </td>
                                    <td>
                                        <div class="btn-group">
                                            <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning btn-rounded" title="Editar">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info btn-rounded mx-1" title="Detalles">
                                                <i class="fas fa-search-plus"></i>
                                            </a>
                                            <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger btn-rounded" title="Eliminar">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </div>
                                    
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.Countries.TotalPages > 1)
                {
                    <nav aria-label="Paginación">
                        <ul class="pagination justify-content-center">
                            @if (Model.Countries.HasPreviousPage)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-page="./Index" asp-route-pageIndex="@(Model.Countries.PageIndex - 1)" asp-route-SearchTerm="@Model.SearchTerm" asp-route-StatusFilter="@Model.StatusFilter">Anterior</a>
                                </li>
                            }
                            @for (var i = 1; i <= Model.Countries.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.Countries.PageIndex ? "active" : "")">
                                    <a class="page-link" asp-page="./Index" asp-route-pageIndex="@i" asp-route-SearchTerm="@Model.SearchTerm" asp-route-StatusFilter="@Model.StatusFilter">@i</a>
                                </li>
                            }
                            @if (Model.Countries.HasNextPage)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-page="./Index" asp-route-pageIndex="@(Model.Countries.PageIndex + 1)" asp-route-SearchTerm="@Model.SearchTerm" asp-route-StatusFilter="@Model.StatusFilter">Siguiente</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
} 
