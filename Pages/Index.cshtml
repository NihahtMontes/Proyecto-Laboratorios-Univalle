@page
@model IndexModel
@using Proyecto_Laboratorios_Univalle.Models.Enums
@{
    var now = DateTime.UtcNow;
    string greeting = now.Hour < 12 ? "Buenos días" : now.Hour < 18 ? "Buenas tardes" : "Buenas noches";
}

@Html.AntiForgeryToken()

<div class="container-fluid">
    
    <div id="mainDashboard" class="d-print-none">
        
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="d-flex align-items-center">
                <h3 class="font-weight-bold text-dark mb-0 mr-3">Planificación Global</h3>
                <div class="dropdown">
                    <button class="btn btn-light bg-white border btn-sm shadow-sm dropdown-toggle font-weight-bold text-dark" type="button" data-toggle="dropdown" style="border-radius: 20px; padding: 5px 15px;">
                        Gestión 2025-I | <span class="text-muted font-weight-normal">Junio - Julio 2025</span>
                    </button>
                    <div class="dropdown-menu shadow-lg border-0" style="border-radius: 12px; min-width: 250px;">
                        <h6 class="dropdown-header text-muted uppercase font-weight-bold small">Gestiones Disponibles</h6>
                        <a class="dropdown-item d-flex justify-content-between align-items-center py-2 bg-light-success text-success font-weight-bold" href="#">
                            <div>Gestión 2025-I<br><small class="text-muted font-weight-normal">Junio - Julio 2025</small></div>
                            <i class="fas fa-check"></i>
                        </a>
                        <a class="dropdown-item d-flex justify-content-between align-items-center py-2" href="#">
                            <div>Gestión 2024-II<br><small class="text-muted font-weight-normal">Diciembre - Enero 2024</small></div>
                            <span class="badge badge-light border">Archivada</span>
                        </a>
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item text-primary font-weight-bold py-2" href="#" data-toggle="modal" data-target="#wizardGestionModal">
                            <i class="fas fa-plus mr-2"></i> Nueva Gestión Semestral
                        </a>
                    </div>
                </div>
            </div>
            <div>
                <button type="button" class="btn btn-danger btn-rounded shadow-sm px-4 font-weight-bold mr-2">
                    <i class="fas fa-exclamation-circle mr-2"></i> Falla Rápida
                </button>
                <button type="button" class="btn btn-primary btn-rounded shadow-sm px-4 font-weight-bold" data-toggle="modal" data-target="#wizardGestionModal" style="background-color: #1a237e; border:none;">
                    <i class="fas fa-play mr-2"></i> Iniciar Ronda (Wizard)
                </button>
            </div>
        </div>

        <p class="text-muted small mb-4">Avance de Mantenimientos por Laboratorio y Equipos</p>

        <div class="row mb-4">
            <div class="col-md-4 mb-3 mb-md-0">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
                    <div class="card-body p-4">
                        <h6 class="text-muted font-weight-bold uppercase mb-4 small">Avance Global</h6>
                        <div class="text-center position-relative mx-auto mt-2" style="width: 140px; height: 140px;">
                            <svg viewBox="0 0 36 36" class="circular-chart green" data-toggle="tooltip" data-placement="right" title="Planeado: 55%">
                                <path class="circle-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                                <path class="circle" stroke-dasharray="45, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                            </svg>
                            <div class="position-absolute d-flex flex-column align-items-center justify-content-center" style="top:0; left:0; right:0; bottom:0;">
                                <h2 class="font-weight-bold mb-0 text-dark">45%</h2>
                                <span class="small text-muted font-weight-bold" style="font-size: 9px;">COMPLETADO</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3 mb-md-0">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
                    <div class="card-body p-4">
                        <h6 class="text-muted font-weight-bold uppercase mb-4 small">Por Tipo de Equipo</h6>
                        <div class="mb-3 d-flex align-items-center">
                            <span class="small text-muted mr-3" style="width: 60px;">Mecánicos</span>
                            <div class="progress flex-grow-1" style="height: 12px; cursor:pointer;" data-toggle="tooltip" title="Mecánicos: 80%"><div class="progress-bar" style="background-color: #2962ff; width: 80%"></div></div>
                        </div>
                        <div class="mb-3 d-flex align-items-center">
                            <span class="small text-muted mr-3" style="width: 60px;">Eléctricos</span>
                            <div class="progress flex-grow-1" style="height: 12px; cursor:pointer;" data-toggle="tooltip" title="Eléctricos: 65%"><div class="progress-bar" style="background-color: #ff9800; width: 65%"></div></div>
                        </div>
                        <div class="mb-3 d-flex align-items-center">
                            <span class="small text-muted mr-3" style="width: 60px;">Ópticos</span>
                            <div class="progress flex-grow-1" style="height: 12px; cursor:pointer;" data-toggle="tooltip" title="Ópticos: 90%"><div class="progress-bar" style="background-color: #9c27b0; width: 90%"></div></div>
                        </div>
                        <div class="mb-0 d-flex align-items-center">
                            <span class="small text-muted mr-3" style="width: 60px;">Térmicos</span>
                            <div class="progress flex-grow-1" style="height: 12px; cursor:pointer;" data-toggle="tooltip" title="Térmicos: 40%"><div class="progress-bar" style="background-color: #e91e63; width: 40%"></div></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
                    <div class="card-body p-4">
                        <h6 class="text-muted font-weight-bold uppercase mb-4 small">Avance de Subgrupos</h6>
                        <div class="mb-4 d-flex align-items-center">
                            <span class="small text-muted mr-3 text-right" style="width: 70px;">H-1</span>
                            <div class="progress flex-grow-1" style="height: 12px;"><div class="progress-bar" style="background-color: #00c853; width: 75%"></div></div>
                        </div>
                        <div class="mb-4 d-flex align-items-center">
                            <span class="small text-muted mr-3 text-right" style="width: 70px;">Microbiología</span>
                            <div class="progress flex-grow-1" style="height: 12px;"><div class="progress-bar" style="background-color: #e91e63; width: 45%"></div></div>
                        </div>
                        <div class="mb-0 d-flex align-items-center">
                            <span class="small text-muted mr-3 text-right line-height-normal" style="width: 70px;">Civil y<br>Suelos</span>
                            <div class="progress flex-grow-1" style="height: 12px;"><div class="progress-bar" style="background-color: #2962ff; width: 85%"></div></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-8 mb-3 mb-md-0">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 12px;">
                    <div class="card-body p-4">
                        <h6 class="text-muted font-weight-bold uppercase mb-4 small">Avance por Laboratorio</h6>
                        
                        <div class="d-flex align-items-center mb-3">
                            <span class="small font-weight-bold text-dark" style="width: 100px;">Civil</span>
                            <div class="progress flex-grow-1 mr-3" style="height: 8px;"><div class="progress-bar bg-warning" style="width: 78%"></div></div>
                            <span class="small font-weight-bold text-dark" style="width: 30px;">78%</span>
                            <span class="small text-muted" style="width: 50px;">12 / 15 eq.</span>
                        </div>
                        <div class="d-flex align-items-center mb-3">
                            <span class="small font-weight-bold text-dark" style="width: 100px;">H-1</span>
                            <div class="progress flex-grow-1 mr-3" style="height: 8px;"><div class="progress-bar bg-warning" style="width: 60%"></div></div>
                            <span class="small font-weight-bold text-dark" style="width: 30px;">60%</span>
                            <span class="small text-muted" style="width: 50px;">9 / 15 eq.</span>
                        </div>
                        <div class="d-flex align-items-center mb-3">
                            <span class="small font-weight-bold text-dark" style="width: 100px;">Química</span>
                            <div class="progress flex-grow-1 mr-3" style="height: 8px;"><div class="progress-bar bg-danger" style="width: 40%"></div></div>
                            <span class="small font-weight-bold text-dark" style="width: 30px;">40%</span>
                            <span class="small text-muted" style="width: 50px;">6 / 15 eq.</span>
                        </div>
                        <div class="d-flex align-items-center mb-0">
                            <span class="small font-weight-bold text-dark" style="width: 100px;">Electrónica</span>
                            <div class="progress flex-grow-1 mr-3" style="height: 8px;"><div class="progress-bar bg-danger" style="width: 20%"></div></div>
                            <span class="small font-weight-bold text-dark" style="width: 30px;">20%</span>
                            <span class="small text-muted" style="width: 50px;">3 / 15 eq.</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100 bg-transparent">
                    <div class="card-body p-0 d-flex flex-column">
                        
                        <div class="bg-danger-soft border border-danger-soft rounded-lg p-3 mb-3 flex-grow-1">
                            <h6 class="font-weight-bold text-danger small uppercase mb-3"><i class="fas fa-exclamation-circle mr-1"></i> Vencidos</h6>
                            <div class="d-flex justify-content-between border-bottom border-danger-soft pb-2 mb-2">
                                <div>
                                    <div class="small font-weight-bold text-dark">Horno PINZUAR</div>
                                    <div class="small text-muted" style="font-size:10px;">Civil</div>
                                </div>
                                <span class="small text-danger font-weight-bold">Hace 5 días</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <div>
                                    <div class="small font-weight-bold text-dark">Balanza OHAUS</div>
                                    <div class="small text-muted" style="font-size:10px;">H-1</div>
                                </div>
                                <span class="small text-danger font-weight-bold">Hace 2 días</span>
                            </div>
                        </div>

                        <div class="bg-warning-soft border border-warning-soft rounded-lg p-3 flex-grow-1">
                            <h6 class="font-weight-bold text-warning small uppercase mb-3" style="color:#d48806 !important;"><i class="fas fa-clock mr-1"></i> Próximos a Vencer</h6>
                            <div class="d-flex justify-content-between border-bottom border-warning-soft pb-2 mb-2">
                                <div>
                                    <div class="small font-weight-bold text-dark">Fermentador INOX</div>
                                    <div class="small text-muted" style="font-size:10px;">H-1</div>
                                </div>
                                <span class="small font-weight-bold" style="color:#d48806;">En 2 días</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <div>
                                    <div class="small font-weight-bold text-dark">Campana WILDA</div>
                                    <div class="small text-muted" style="font-size:10px;">H-1</div>
                                </div>
                                <span class="small font-weight-bold" style="color:#d48806;">En 5 días</span>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-5" style="border-radius: 12px;">
            <div class="card-header bg-white border-0 p-4 d-flex justify-content-between align-items-center">
                <h5 class="font-weight-bold text-dark mb-0">Cronograma de Intervenciones</h5>
                <span class="badge badge-light border text-muted px-3 py-1 rounded-pill">Semana 12 - 16</span>
            </div>
            <div class="card-body px-4 pt-0 pb-4">
                
                <div class="d-flex flex-wrap align-items-center mb-4">
                    <span class="text-muted mr-3"><i class="fas fa-filter"></i> Filtros:</span>
                    <select id="filterLab" class="form-control form-control-sm mr-2 filter-cronograma" style="width: 130px; border-radius:20px;"><option value="Todos">Laboratorio</option><option value="Civil">Civil</option><option value="H-1">H-1</option><option value="Química">Química</option></select>
                    <select id="filterCat" class="form-control form-control-sm mr-2 filter-cronograma" style="width: 140px; border-radius:20px;"><option value="Todas">Categoría</option><option value="Equipos de Calentamiento">Calentamiento</option><option value="Equipos de Ensayo">Ensayo</option><option value="Equipos de Medición">Medición</option></select>
                    <select id="filterTech" class="form-control form-control-sm mr-4 filter-cronograma" style="width: 150px; border-radius:20px;"><option value="Todos">Técnico</option><option value="Ing. Carlos Mamani">Ing. Carlos</option><option value="PCS Proyectos">PCS Proyectos</option></select>
                    
                    <div class="btn-group btn-group-sm bg-light rounded-pill p-1 border">
                        <button class="btn btn-white btn-pill-filter active" data-filter="Todos">Todos</button>
                        <button class="btn btn-transparent btn-pill-filter text-muted" data-filter="Planeado">Planeado</button>
                        <button class="btn btn-transparent btn-pill-filter text-muted" data-filter="En Progreso">En Progreso</button>
                        <button class="btn btn-transparent btn-pill-filter text-muted" data-filter="Ejecutado">Ejecutado</button>
                        <button class="btn btn-transparent btn-pill-filter text-muted" data-filter="Externo">Externo</button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover table-borderless v-middle mb-0">
                        <thead class="border-bottom border-light">
                            <tr class="small uppercase font-weight-bold text-muted" style="font-size: 9px; letter-spacing:1px;">
                                <th class="pl-3">Laboratorio</th>
                                <th>Equipo / Inv</th>
                                <th>Falla Reportada</th>
                                <th class="text-center">Servicio</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center" style="width:60px;">S12</th>
                                <th class="text-center" style="width:60px;">S13</th>
                                <th class="text-center" style="width:60px;">S14</th>
                                <th style="width:30px;"></th>
                            </tr>
                        </thead>
                        <tbody id="cronogramaTableBody">
                            </tbody>
                    </table>
                </div>

            </div>
        </div>

    </div>

    <div id="wizardApp" style="display: none; max-width: 1100px; margin: 0 auto;">
        
        <div class="d-flex align-items-center mb-4 d-print-none">
            <h4 class="font-weight-bold text-dark mb-0">Ronda Activa: <span class="text-primary" id="wizardGestTitle">Gestión 2025-I</span></h4>
            <div class="ml-auto d-flex align-items-center">
                <select id="wizardLabSelect" class="form-control form-control-sm font-weight-bold mr-3" style="border-radius: 20px; width: 180px; border: 2px solid #2962ff; color: #2962ff; outline: none; box-shadow: none;" onchange="loadWizardUnits(currentWizardStep)">
                    <option value="">-- Cambiar Laboratorio --</option>
                </select>
                <button class="btn btn-outline-danger btn-sm btn-rounded font-weight-bold" onclick="cancelWizard()">
                    <i class="fas fa-times mr-1"></i> Salir
                </button>
            </div>
        </div>

        <div class="wizard-steps mb-5 d-flex justify-content-between position-relative mt-3 d-print-none">
            <div class="step-line"></div>
            <div class="step-item active" id="barStep1"><span class="step-number">1</span><span class="step-label">L6 Verificación</span></div>
            <div class="step-item" id="barStep2"><span class="step-number">2</span><span class="step-label">L7 Solicitud</span></div>
            <div class="step-item" id="barStep3"><span class="step-number">3</span><span class="step-label">L8 Mantenimiento</span></div>
            <div class="step-item" id="barStep4"><span class="step-number">4</span><span class="step-label">L3 Salida</span></div>
            <div class="step-item" id="barStep5"><span class="step-number">5</span><span class="step-label">Kardex</span></div>
            <div class="step-item" id="barStep6"><span class="step-number">6</span><span class="step-label">Desembolso</span></div>
        </div>

        <div id="wizardStep1Container" class="card shadow-sm border-0 mb-5 d-print-none" style="border-radius: 12px;">
            <div class="card-body p-4 p-md-5">
                <h4 class="font-weight-bold text-dark mb-1">Paso 1: L6 Verificación</h4>
                <p class="text-muted small mb-4">Selecciona un ambiente arriba para verificar sus equipos.</p>
                <div id="wizardUnitsList"><div class="text-center py-5 text-muted"><i class="fas fa-arrow-up mr-2"></i>Selecciona un laboratorio para comenzar.</div></div>
                <div class="text-right mt-4 pt-3 border-top">
                    <button id="btnNextStep1" class="btn btn-primary btn-rounded font-weight-bold px-4 py-2 shadow-sm disabled-btn" style="background-color: #2962ff; border:none;" onclick="goToWizardStep(2)" disabled>
                        Avanzar a L7 Solicitud <i class="fas fa-arrow-right ml-2"></i>
                    </button>
                </div>
            </div>
        </div>

        <div id="wizardStep2Container" class="card shadow-sm border-0 mb-5 d-print-none" style="border-radius: 12px; display: none;">
            <div class="card-body p-4 p-md-5">
                <h4 class="font-weight-bold text-dark mb-1">Paso 2: L7 Solicitud Técnica</h4>
                <p class="text-muted small mb-4">Solo se muestran los equipos reportados con fallas en L6.</p>
                <div id="wizardFaultyUnitsList"></div>
                <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                    <button class="btn btn-light btn-rounded px-4 font-weight-bold text-muted border" onclick="goToWizardStep(1)"><i class="fas fa-arrow-left mr-2"></i> Volver a L6</button>
                    <button id="btnNextStep2" class="btn btn-primary btn-rounded font-weight-bold px-4 py-2 shadow-sm disabled-btn" style="background-color: #2962ff; border:none;" onclick="goToWizardStep(3)" disabled>
                        Avanzar a L8 Mantenimiento <i class="fas fa-arrow-right ml-2"></i>
                    </button>
                </div>
            </div>
        </div>

        <div id="wizardStep3Container" class="card shadow-sm border-0 mb-5 d-print-none" style="border-radius: 12px; display: none;">
            <div class="card-body p-4 p-md-5">
                <h4 class="font-weight-bold text-dark mb-1">Paso 3: L8 Mantenimiento</h4>
                <p class="text-muted small mb-4">Ejecuta las reparaciones de las solicitudes generadas llenando el check-list.</p>
                <div id="wizardMaintenanceList"></div>
                <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                    <button class="btn btn-light btn-rounded px-4 font-weight-bold text-muted border" onclick="goToWizardStep(2)"><i class="fas fa-arrow-left mr-2"></i> Volver a L7</button>
                    <button id="btnNextStep3" class="btn btn-primary btn-rounded font-weight-bold px-4 py-2 shadow-sm disabled-btn" style="background-color: #2962ff; border:none;" onclick="goToWizardStep(4)" disabled>
                        Avanzar a L3 Salida <i class="fas fa-arrow-right ml-2"></i>
                    </button>
                </div>
            </div>
        </div>

        <div id="wizardStep4Container" style="display: none;">
            <div class="card shadow-sm border-0 mb-5 d-print-none" style="border-radius: 12px;">
                <div class="card-body p-4 p-md-5">
                    <h4 class="font-weight-bold text-dark mb-1">Paso 4: L3 Acta de Salida</h4>
                    <p class="text-muted small mb-4">Visualiza e imprime las actas de conformidad de los mantenimientos externos.</p>
                    <div id="wizardActaL3List"></div>
                    <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                        <button class="btn btn-light btn-rounded px-4 font-weight-bold text-muted border" onclick="goToWizardStep(3)"><i class="fas fa-arrow-left mr-2"></i> Volver a L8</button>
                        <button class="btn btn-primary btn-rounded font-weight-bold px-4 py-2 shadow-sm" style="background-color: #2962ff; border:none;" onclick="goToWizardStep(5)">
                            Avanzar a Kardex <i class="fas fa-arrow-right ml-2"></i>
                        </button>
                    </div>
                </div>
            </div>
            <div id="printAreaL3" style="display:none;" class="p-5 bg-white print-only"></div>
        </div>

        <div id="wizardStep5Container" class="card shadow-sm border-0 mb-5 d-print-none" style="border-radius: 12px; display: none;">
            <div class="card-body p-4 p-md-5">
                <h4 class="font-weight-bold text-dark mb-1">Paso 5: Actualización de Kardex</h4>
                <p class="text-muted small mb-4">Registro de intervenciones realizadas en esta gestión, guardado automáticamente.</p>
                <div id="wizardKardexList"></div>
                <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                    <button class="btn btn-light btn-rounded px-4 font-weight-bold text-muted border" onclick="goToWizardStep(4)"><i class="fas fa-arrow-left mr-2"></i> Volver a L3</button>
                    <button class="btn btn-primary btn-rounded font-weight-bold px-4 py-2 shadow-sm" style="background-color: #2962ff; border:none;" onclick="goToWizardStep(6)">
                        Avanzar a Desembolso <i class="fas fa-arrow-right ml-2"></i>
                    </button>
                </div>
            </div>
        </div>

        <div id="wizardStep6Container" class="card shadow-sm border-0 mb-5 d-print-none" style="border-radius: 12px; display: none;">
            <div class="card-body p-4 p-md-5 text-center">
                <h4 class="font-weight-bold text-dark mb-1">Solicitud de Desembolso</h4>
                <p class="text-muted small mb-4">Equipos con mantenimiento completado listos para facturación.</p>
                
                <div class="table-responsive mb-5 border rounded-lg">
                    <table class="table table-borderless table-hover v-middle mb-0 text-left">
                        <thead class="bg-light border-bottom">
                            <tr class="small uppercase font-weight-bold text-muted">
                                <th class="pl-4">Código/Inv</th>
                                <th>Nombre del Equipo</th>
                                <th>Tipo de Servicio</th>
                                <th>Costo Bs.</th>
                                <th>Estado Solicitud</th>
                                <th class="text-center pr-4">Acción</th>
                            </tr>
                        </thead>
                        <tbody id="wizardDesembolsoTableBody"></tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4 p-3 bg-light rounded-lg border">
                    <button class="btn btn-white btn-rounded px-4 font-weight-bold text-muted border" onclick="goToWizardStep(5)"><i class="fas fa-arrow-left mr-2"></i> Volver a Kardex</button>
                    <h5 class="mb-0 text-dark">Total general de desembolso a solicitar: <span class="font-weight-bold text-success ml-2" id="wizardTotalDesembolso">Bs 0.00</span></h5>
                    <button class="btn btn-success btn-rounded font-weight-bold px-4 py-2 shadow-sm" onclick="finishWizardRound()">
                        <i class="fas fa-check-circle mr-2"></i> Finalizar Gestión de Laboratorio
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="kardexOffcanvas" class="kardex-offcanvas shadow-lg d-print-none">
    <div class="bg-dark text-white p-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
