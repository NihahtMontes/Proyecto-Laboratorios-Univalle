@page
@model IndexModel
@using Proyecto_Laboratorios_Univalle.Models.Enums
@using System.Text.Json
@{
    var now = DateTime.UtcNow;
    string greeting = now.Hour < 12 ? "Buenos dÃ­as" : now.Hour < 18 ? "Buenas tardes" : "Buenas noches";
}

@section Styles {
    <link rel="stylesheet" href="~/css/tailwind-dashboard.css" asp-append-version="true" />
    <style>
        .tailwind-scope { text-align: left; }
        .tailwind-scope a:hover { text-decoration: none; }
        .progress-bar-animated { animation: progress-bar-stripes 1s linear infinite; }
    </style>
}

<div class="tailwind-scope p-6 max-w-[1600px] mx-auto space-y-6">
  
  @if (Model.ActiveManagement == null)
  {
      <!-- Empty State: No hay gestiÃ³n activa -->
      <div class="flex flex-col items-center justify-center py-20 bg-white rounded-2xl shadow-sm border border-dashed border-gray-300">
          <div class="w-16 h-16 bg-slate-50 text-slate-400 rounded-full flex items-center justify-center mb-6">
              <i class="fas fa-calendar-times text-2xl"></i>
          </div>
          <h2 class="text-xl font-bold text-slate-800 mb-2">No existe ninguna gestiÃ³n activa</h2>
          <p class="text-slate-500 mb-8 text-center max-w-md px-6">
              Para visualizar el tablero de planificaciÃ³n global, debe iniciar una nueva gestiÃ³n semestral o activar una existente en el mÃ³dulo de administraciÃ³n.
          </p>
          <div class="flex gap-4">
              <a asp-page="/Managements/Create" class="inline-flex items-center justify-center rounded-lg font-medium bg-slate-900 text-white hover:bg-slate-800 h-11 px-6 text-sm gap-2 transition-all">
                  <i class="fas fa-plus"></i> Iniciar Primera GestiÃ³n
              </a>
              <a asp-page="/Managements/Index" class="inline-flex items-center justify-center rounded-lg font-medium bg-white border border-gray-200 text-slate-700 hover:bg-slate-50 h-11 px-6 text-sm gap-2 transition-all">
                  <i class="fas fa-list"></i> Administrar Gestiones
              </a>
          </div>
      </div>
  }
  else
  {
      <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-8 gap-4">
        <div>
          <h1 class="text-2xl font-bold text-slate-900 tracking-tight flex items-center">
            PlanificaciÃ³n Global
            <div class="relative inline-block ml-4">
              <div class="flex items-center gap-2 bg-white border border-gray-200 shadow-sm rounded-lg px-3 py-1.5 transition-colors">
                <span class="text-sm font-semibold text-slate-800">GestiÃ³n @Model.ActiveManagement.Year - @(Model.ActiveManagement.Semester == 1 ? "I" : "II")</span>
                <span class="text-xs text-slate-500">| @(Model.ActiveManagement.StartDate?.ToString("MMM") ?? "N/A") â€“ @(Model.ActiveManagement.PlannedEndDate?.ToString("MMM yyyy") ?? "N/A")</span>
                <i class="fas fa-calendar-check text-green-500 text-xs ml-1"></i>
              </div>
            </div>
          </h1>
          <p class="text-slate-500 text-sm mt-1">Avance de Mantenimientos basados en la planificaciÃ³n L-48 activa.</p>
        </div>
        
        <div class="flex gap-3">
          <button class="inline-flex items-center justify-center rounded-lg font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-slate-400 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none bg-[#DC3545] text-white hover:bg-red-700 active:bg-red-800 border border-transparent shadow-sm h-10 px-4 text-sm gap-2 shrink-0">
            <i class="fas fa-exclamation-circle text-xs"></i>
            <span class="hidden sm:inline">Falla RÃ¡pida</span>
          </button>
          <a asp-page="/Wizard/Index" class="inline-flex">
            <button class="inline-flex items-center justify-center rounded-lg font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-slate-400 focus:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none bg-slate-900 text-white hover:bg-slate-800 active:bg-slate-950 border border-transparent shadow-sm h-10 px-5 text-sm gap-2 shrink-0">
              <i class="fas fa-play text-xs"></i>
              <span>Iniciar Ronda (Wizard)</span>
            </button>
          </a>
        </div>
      </div>


      <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
          <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
              <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Equipos Totales</h3>
              <p class="text-2xl font-bold text-slate-800">@Model.TotalEquipment</p>
          </div>
          <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
              <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Operatividad</h3>
              <p class="text-2xl font-bold text-green-600">@Model.OperationalPercent%</p>
          </div>
          <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
              <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Solicitudes Pend.</h3>
              <p class="text-2xl font-bold text-orange-500">@Model.PendingRequests</p>
          </div>
          <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4">
              <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Mant. en Curso</h3>
              <p class="text-2xl font-bold text-blue-500">@Model.OngoingMaintenances</p>
          </div>
      </div>

      <!-- L22: Top Widgets -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Chart: Avance Global -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden p-5 flex flex-col items-center justify-center relative">
          <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-2 self-start w-full text-left">Avance Global</h3>
          <div class="h-40 w-full relative content-center flex items-center justify-center">
            <div style="height: 140px; width: 140px;" class="relative">
                <canvas id="globalProgressChart"></canvas>
                <div class="absolute inset-0 flex items-center justify-center flex-col pointer-events-none">
                  <span class="text-2xl font-bold text-slate-800">@Model.ActiveManagement.CompletionPercentage%</span>
                  <span class="text-[10px] text-slate-400 font-medium uppercase mt-1">Completado</span>
                </div>
            </div>
          </div>
        </div>

        <!-- Chart: Por Tipo de Equipo -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden p-5">
          <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-4">Por CategorÃ­a de Equipo</h3>
          <div class="h-40 w-full relative">
            @if (Model.TypeProgress.Any()) {
                <canvas id="typeProgressChart"></canvas>
            } else {
                <div class="flex items-center justify-center h-full text-xs text-slate-400 italic">No hay datos de categorÃ­as</div>
            }
          </div>
        </div>

        <!-- Chart: Avance de Subgrupos -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden p-5">
          <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-4">Mantenimientos por ClasificaciÃ³n</h3>
          <div class="h-40 w-full relative">
            @if (Model.GroupProgress.Any()) {
                <canvas id="subgroupsProgressChart"></canvas>
            } else {
                <div class="flex items-center justify-center h-full text-xs text-slate-400 italic">No hay datos de grupos</div>
            }
          </div>
        </div>
      </div>

      <!-- LabProgress Component -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-6">
        <!-- Bars -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden p-5 lg:col-span-2">
          <h3 class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-5">Eficiencia por Laboratorio</h3>
          <div class="space-y-4">
              
            @foreach (var lab in Model.LabProgress)
            {
                var color = lab.Value > 70 ? "#28A745" : lab.Value > 40 ? "#FFC107" : "#DC3545";
                <div class="flex items-center gap-4">
                  <span class="w-24 text-sm font-semibold text-slate-700 truncate" title="@lab.Key">@lab.Key</span>
                  <div class="flex-1 h-3 bg-slate-100 rounded-full overflow-hidden flex">
                    <div class="h-full transition-all duration-500" style="width: @lab.Value%; background-color: @color;"></div>
                  </div>
                  <div class="w-12 text-right text-sm font-bold text-slate-800">@lab.Value%</div>
                </div>
            }
            
            @if (!Model.LabProgress.Any()) {
                <p class="text-sm text-slate-400 italic py-4">No hay planes registrados en laboratorios para esta gestiÃ³n.</p>
            }

          </div>
        </div>

        <!-- Alerts -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden p-0 flex flex-col">
          <div class="px-4 py-3 bg-[#DC3545]/10 border-b border-[#DC3545]/20 flex items-center gap-2">
            <i class="fas fa-exclamation-circle text-[#DC3545]"></i>
            <h3 class="text-xs font-bold text-red-800 uppercase tracking-wider">Mantenimientos Vencidos</h3>
          </div>
          <div class="p-4 space-y-3 bg-white">
            @foreach (var plan in Model.OverduePlans)
            {
                <div class="flex justify-between items-start">
                  <div>
                    <p class="text-sm font-semibold text-slate-800">@plan.EquipmentUnit?.Equipment?.Name</p>
                    <p class="text-xs text-slate-500">@plan.EquipmentUnit?.Laboratory?.Name</p>
                  </div>
                  <span class="text-[10px] font-bold text-[#DC3545] bg-[#DC3545]/10 px-2 py-0.5 rounded-full mt-1">Vencido</span>
                </div>
            }
            @if (!Model.OverduePlans.Any()) {
                <p class="text-xs text-slate-400 italic">Sin mantenimientos vencidos.</p>
            }
          </div>

          <div class="px-4 py-3 bg-[#FFC107]/10 border-y border-[#FFC107]/20 flex items-center gap-2 mt-auto">
            <i class="fas fa-clock text-[#FFC107]"></i>
            <h3 class="text-xs font-bold text-yellow-800 uppercase tracking-wider">PrÃ³ximos a Vencer</h3>
          </div>
          <div class="p-4 space-y-3 bg-white">
            @foreach (var plan in Model.UpcomingPlans)
            {
                <div class="flex justify-between items-start">
                  <div>
                    <p class="text-sm font-semibold text-slate-800">@plan.EquipmentUnit?.Equipment?.Name</p>
                    <p class="text-xs text-slate-500">@plan.EquipmentUnit?.Laboratory?.Name</p>
                  </div>
                  <span class="text-[10px] font-bold text-yellow-800 bg-[#FFC107]/20 px-2 py-0.5 rounded-full mt-1">@plan.PlannedDate?.ToString("dd/MM")</span>
                </div>
            }
            @if (!Model.UpcomingPlans.Any()) {
                <p class="text-xs text-slate-400 italic">No hay planes programados prÃ³ximos.</p>
            }
          </div>
        </div>
      </div>

      <!-- L48: Main Table Area -->
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 flex flex-col overflow-visible mt-6">
        <div class="px-6 py-4 border-b border-gray-100 flex flex-col gap-4 bg-white rounded-t-xl">
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-bold text-slate-800">Cronograma de Intervenciones L-48</h2>
            <div class="flex gap-2">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full font-semibold bg-slate-100 text-slate-700 border border-slate-200 text-[10px]">GestiÃ³n Activa</span>
            </div>
          </div>
        </div>
        
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm whitespace-nowrap m-0 border-0">
            <thead class="bg-[#F8F9FA] text-slate-500 uppercase font-semibold text-xs tracking-wider border-b-2 border-gray-200">
              <tr>
                <th class="px-6 py-4 font-semibold border-0">Laboratorio</th>
                <th class="px-6 py-4 font-semibold border-0">Equipo / Inv.</th>
                <th class="px-6 py-4 font-semibold border-0">Falla/Servicio</th>
                <th class="px-6 py-4 font-semibold border-0">Estado Plan</th>
                <th class="px-6 py-4 font-semibold border-0">Fecha Prog.</th>
                <th class="px-6 py-4 font-semibold border-0 text-center w-12"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 bg-white">
                @foreach (var item in Model.ActiveManagement.ManagementPlans.OrderByDescending(p => p.Id).Take(10))
                {
                    <tr class="hover:bg-slate-50/50 transition-colors group">
                      <td class="px-6 py-4 border-0">
                        <span class="font-medium text-slate-700">@item.EquipmentUnit?.Laboratory?.Name</span>
                      </td>
                      <td class="px-6 py-4 border-0">
                        <span class="font-semibold text-[#3B82F6]">@item.EquipmentUnit?.Equipment?.Name</span>
                        <p class="text-xs text-slate-400 mt-0.5 mb-0">Inv: @item.EquipmentUnit?.InventoryNumber</p>
                      </td>
                      <td class="px-6 py-4 border-0">
                        <span class="text-slate-600 truncate max-w-[200px] inline-block">@item.Notes</span>
                      </td>
                      <td class="px-6 py-4 border-0">
                        @{
                            var badgeColor = item.PlanStatus == ManagementPlanStatus.Completed ? "bg-green-100 text-green-800 border-green-200" : 
                                            item.PlanStatus == ManagementPlanStatus.InProgress ? "bg-yellow-100 text-yellow-800 border-yellow-200" : 
                                            "bg-slate-100 text-slate-700 border-slate-200";
                        }
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold @badgeColor border">
                          @item.PlanStatus
                        </span>
                      </td>
                      <td class="px-6 py-4 border-0">
                        <span class="text-slate-600">@item.PlannedDate?.ToString("dd/MM/yyyy")</span>
                      </td>
                      <td class="px-6 py-4 text-center border-0 text-slate-400">
                        <i class="fas fa-search"></i>
                      </td>
                    </tr>
                }
            </tbody>
          </table>
        </div>
      </div>
  }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            @if (Model.ActiveManagement != null)
            {
                <text>
                // Global Progress Pie
                const ctxGlobal = document.getElementById('globalProgressChart').getContext('2d');
                new Chart(ctxGlobal, {
                    type: 'doughnut',
                    data: {
                        datasets: [{
                            data: [@Model.ActiveManagement.CompletionPercentage, @(100 - Model.ActiveManagement.CompletionPercentage)],
                            backgroundColor: ['#28A745', '#E2E8F0'],
                            borderWidth: 0,
                            cutout: '75%'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false }, tooltip: { enabled: false } }
                    }
                });

                // Type Progress Bar
                const ctxType = document.getElementById('typeProgressChart')?.getContext('2d');
                if (ctxType) {
                    new Chart(ctxType, {
                        type: 'bar',
                        data: {
                            labels: @Html.Raw(JsonSerializer.Serialize(Model.TypeProgress.Keys)),
                            datasets: [{
                                data: @Html.Raw(JsonSerializer.Serialize(Model.TypeProgress.Values)),
                                backgroundColor: ['#3B82F6', '#F59E0B', '#8B5CF6', '#EC4899', '#10B981'],
                                borderRadius: 4,
                                barThickness: 16
                            }]
                        },
                        options: {
                            indexAxis: 'y',
                            responsive: true,
                            maintainAspectRatio: false,
                            scales: {
                                x: { display: false },
                                y: { grid: { display: false }, border: { display: false }, ticks: { color: '#64748b', font: { size: 11 } } }
                            },
                            plugins: { legend: { display: false } }
                        }
                    });
                }

                // Subgroups Progress Bar
                const ctxSub = document.getElementById('subgroupsProgressChart')?.getContext('2d');
                if (ctxSub) {
                    new Chart(ctxSub, {
                        type: 'bar',
                        data: {
                            labels: @Html.Raw(JsonSerializer.Serialize(Model.GroupProgress.Keys)),
                            datasets: [{
                                data: @Html.Raw(JsonSerializer.Serialize(Model.GroupProgress.Values)),
                                backgroundColor: ['#10B981', '#F43F5E', '#3B82F6', '#FFC107'],
                                borderRadius: 4,
                                barThickness: 16
                            }]
                        },
                        options: {
                            indexAxis: 'y',
                            responsive: true,
                            maintainAspectRatio: false,
                            scales: {
                                x: { display: false },
                                y: { grid: { display: false }, border: { display: false }, ticks: { color: '#64748b', font: { size: 11 } } }
                            },
                            plugins: { legend: { display: false } }
                        }
                    });
                }
                </text>
            }