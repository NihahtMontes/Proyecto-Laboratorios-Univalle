@section Scripts {
    <script src="~/assets/libs/sweetalert2/dist/sweetalert2.all.min.js"></script>
    <script>
        // =========================================================================
        // LÓGICA DEL DASHBOARD PRINCIPAL (FILTROS Y KARDEX)
        // =========================================================================
        let allInterventions = [];

        $(function () {
            $('[data-toggle="tooltip"]').tooltip();
            loadDashboardInterventions();

            // Filtros Dashboard
            $('.filter-cronograma').on('change', applyDashboardFilters);
            $('.btn-pill-filter').on('click', function() {
                $('.btn-pill-filter').removeClass('active text-dark').addClass('text-muted');
                $(this).addClass('active text-dark').removeClass('text-muted');
                applyDashboardFilters();
            });
        });

        function loadDashboardInterventions() {
            $.get('/Index?handler=DashboardInterventions', function(data) {
                allInterventions = data;
                applyDashboardFilters();
            });
        }

        function applyDashboardFilters() {
            let labFilter = $('#filterLab').val();
            let catFilter = $('#filterCat').val();
            let techFilter = $('#filterTech').val();
            let pillFilter = $('.btn-pill-filter.active').data('filter');

            let filtered = allInterventions.filter(item => {
                let matchLab = (labFilter === 'Todos' || item.lab === labFilter);
                let matchCat = (catFilter === 'Todas' || item.cat === catFilter);
                let matchTech = (techFilter === 'Todos' || item.tech === techFilter);
                
                let matchPill = true;
                if (pillFilter !== 'Todos') {
                    if(pillFilter === 'Externo') matchPill = item.servicio === 'Externo';
                    else matchPill = item.estado === pillFilter;
                }

                return matchLab && matchCat && matchTech && matchPill;
            });

            renderCronogramaTable(filtered);
        }

        function renderCronogramaTable(data) {
            let $tbody = $('#cronogramaTableBody');
            $tbody.empty();

            if(data.length === 0) {
                $tbody.append('<tr><td colspan="9" class="text-center py-4 text-muted">No se encontraron registros con los filtros actuales.</td></tr>');
                return;
            }

            data.forEach(item => {
                let servBadge = item.servicio === 'Interno' ? 'badge-soft-primary text-primary' : 'badge-light border text-muted';
                let estBadge = item.estado === 'Planeado' ? 'badge-light border text-muted' : (item.estado === 'En Progreso' ? 'badge-soft-warning text-warning' : 'badge-soft-success text-success');
                
                let s12Box = item.s12 ? `<span class="cronograma-gantt-box gantt-${item.s12 === 'OK' ? 'ok' : 'prev'}">${item.s12}</span>` : `<span class="cronograma-gantt-box gantt-empty">&nbsp;</span>`;
                let s13Box = item.s13 ? `<span class="cronograma-gantt-box gantt-${item.s13 === 'OK' ? 'ok' : (item.s13 === 'En curso' ? 'prev' : 'prev')}">${item.s13}</span>` : `<span class="cronograma-gantt-box gantt-empty">&nbsp;</span>`;
                let s14Box = item.s14 ? `<span class="cronograma-gantt-box gantt-${item.s14 === 'OK' ? 'ok' : 'prev'}">${item.s14}</span>` : `<span class="cronograma-gantt-box gantt-empty">&nbsp;</span>`;

                let html = `<tr>
                                <td class="pl-3 font-weight-bold text-muted small">${item.lab}</td>
                                <td><div class="font-weight-bold text-primary small">${item.eqName}</div><div class="text-muted" style="font-size:10px;">${item.inv}</div></td>
                                <td class="small text-dark">${item.falla}</td>
                                <td class="text-center"><span class="badge ${servBadge} rounded-pill px-2 py-1">${item.servicio}</span></td>
                                <td class="text-center"><span class="badge ${estBadge} rounded-pill px-2 py-1">${item.estado}</span></td>
                                <td class="text-center">${s12Box}</td>
                                <td class="text-center">${s13Box}</td>
                                <td class="text-center">${s14Box}</td>
                                <td class="text-center"><button class="btn btn-sm btn-link text-muted p-0" onclick="openKardex(${item.unitId}, '${item.eqName}', '${item.inv}', '${item.lab}')"><i class="fas fa-ellipsis-v"></i></button></td>
                            </tr>`;
                $tbody.append(html);
            });
        }

        function openKardex(unitId, name, inv, lab) {
            $('#kdxName').text(name);
            $('#kdxInv').text(inv);
            $('#kdxLab').text(lab);
            
            $('#kardexTimeline').html('<div class="text-center py-4"><i class="fas fa-spinner fa-spin"></i> Cargando historial...</div>');
            
            $.get(`/Index?handler=KardexHistory&unitId=${unitId}`, function(data) {
                $('#kardexTimeline').empty();
                data.forEach(h => {
                    $('#kardexTimeline').append(`
                        <div class="timeline-item">
                            <div class="timeline-dot"></div>
                            <div class="small font-weight-bold text-primary mb-1">${h.date}</div>
                            <div class="timeline-card shadow-sm">
                                <h6 class="font-weight-bold text-dark mb-2">${h.action}</h6>
                                <p class="small text-muted mb-3 bg-light p-2 rounded">${h.detail}</p>
                                <div class="d-flex justify-content-between small">
                                    <span class="text-muted"><i class="far fa-user mr-1"></i> Ejecutor: <span class="text-dark">${h.exec}</span></span>
                                </div>
                                <div class="small mt-1"><span class="text-muted"><i class="fas fa-money-bill-wave mr-1"></i> Importe:</span> <span class="text-success font-weight-bold">${h.cost}</span></div>
                            </div>
                        </div>
                    `);
                });
                
                $('#kardexOverlay').fadeIn(200);
                $('#kardexOffcanvas').addClass('open');
            });
        }

        function closeKardex() {
            $('#kardexOffcanvas').removeClass('open');
            $('#kardexOverlay').fadeOut(200);
        }

        // =========================================================================
        // AJAX WIZARD LOGIC CON MOCK DB
        // =========================================================================
        let currentWizardStep = 1;

        function startWizardApp() {
            $('#wizardGestionModal').modal('hide');
            Swal.fire({
                title: 'Activando Ronda...',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading() },
                timer: 800
            }).then(() => {
                $('#mainDashboard').slideUp(300, function() {
                    $('#wizardApp').fadeIn(300);
                    loadWizardLabs();
                });
            });
        }

        function cancelWizard() {
            Swal.fire({
                title: '¿Abortar ronda?',
                text: "Volverás al dashboard principal. Los datos temporales se perderán al refrescar.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Sí, salir',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if(result.isConfirmed) {
                    $('#wizardApp').slideUp(300, function() {
                        $('#mainDashboard').fadeIn(300);
                    });
                }
            });
        }

        function loadWizardLabs() {
            $.get('/Index?handler=WizardLabs', function(data) {
                let $select = $('#wizardLabSelect');
                $select.empty().append('<option value="">-- Selecciona --</option>');
                data.forEach(l => {
                    $select.append(`<option value="${l.id}">${l.name}</option>`);
                });
            });
        }

        function loadWizardUnits(stepNum) {
            let labId = $('#wizardLabSelect').val();
            if (!labId) return;

            let handlerUrl = '';
            let $container = null;
            
            if (stepNum === 1) { handlerUrl = 'WizardUnitsL6'; $container = $('#wizardUnitsList'); }
            else if (stepNum === 2) { handlerUrl = 'WizardFaultyUnitsL7'; $container = $('#wizardFaultyUnitsList'); }
            else if (stepNum === 3) { handlerUrl = 'WizardPendingL8'; $container = $('#wizardMaintenanceList'); }
            else if (stepNum === 4) { handlerUrl = 'WizardCompletedL8ForL3'; $container = $('#wizardActaL3List'); }
            else if (stepNum === 5) { handlerUrl = 'WizardKardex'; $container = $('#wizardKardexList'); }
            else if (stepNum === 6) { handlerUrl = 'WizardDesembolso'; $container = $('#wizardDesembolsoTableBody'); }

            if(stepNum < 6) $container.html('<div class="text-center py-4 text-muted"><i class="fas fa-spinner fa-spin"></i> Cargando...</div>');

            $.get(`/Index?handler=${handlerUrl}&labId=${labId}`, function(data) {
                if(stepNum < 6) $container.empty();
                let itemsArray = stepNum === 6 ? data.items : data;

                if(itemsArray.length === 0) {
                    if(stepNum < 6) $container.html(`<div class="text-center py-4 text-muted">No hay equipos pendientes en esta fase.</div>`);
                    if(stepNum === 1) $('#btnNextStep1').removeClass('disabled-btn').prop('disabled', false);
                    if(stepNum === 2) $('#btnNextStep2').removeClass('disabled-btn').prop('disabled', false);
                    if(stepNum === 3) $('#btnNextStep3').removeClass('disabled-btn').prop('disabled', false);
                    if(stepNum === 6) { $container.empty(); $('#wizardTotalDesembolso').text('Bs 0.00'); }
                    return;
                }

                if(stepNum === 6) {
                    $('#wizardTotalDesembolso').text('Bs ' + data.total.toLocaleString('es-BO', { minimumFractionDigits: 2 }));
                    $container.empty();
                    data.items.forEach(u => {
                        let actionHtml = u.isRequested 
                            ? `<span class="badge badge-primary px-3 py-1 rounded-pill" style="background:#2962ff;"><i class="fas fa-check mr-1"></i> Solicitado</span>`
                            : `<button class="btn btn-sm btn-outline-primary btn-rounded font-weight-bold px-3" onclick="openDesembolsoModal(${u.id}, '${u.name}', '${u.inventory}', ${u.cost})"><i class="far fa-file-alt mr-1"></i> Hacer solicitud</button>`;

                        $container.append(`
                            <tr>
                                <td class="pl-4"><span class="text-muted small">Inv: ${u.inventory}</span></td>
                                <td class="font-weight-bold text-dark">${u.name}</td>
                                <td><span class="text-muted small">Correctivo</span></td>
                                <td class="font-weight-bold">Bs. ${u.cost.toLocaleString('es-BO', { minimumFractionDigits: 2 })}</td>
                                <td>${actionHtml}</td>
                                <td class="text-center pr-4">...</td>
                            </tr>
                        `);
                    });
                    return;
                }

                let allCompleted = true;

                data.forEach(u => {
                    let html = `<div class="wizard-equipment-card p-3 d-flex flex-column flex-md-row justify-content-between align-items-center">
                                    <div class="mb-3 mb-md-0 text-center text-md-left">
                                        <div class="d-flex align-items-center justify-content-center justify-content-md-start mb-1">
                                            <h6 class="font-weight-bold text-dark mb-0">${u.name}</h6>
                                            <span class="badge-inv">${u.inventory}</span>
                                        </div>
                                        <small class="text-muted">${u.category || u.description || u.faultDetails || u.technician || ''}</small>
                                    </div>
                                    <div>`;
                    
                    if (stepNum === 1) {
                        if(!u.isVerified) allCompleted = false;
                        if(u.isVerified) html += `<span class="badge ${u.isOk ? 'badge-success' : 'badge-danger'} px-3 py-2 border-0 rounded-pill"><i class="fas ${u.isOk ? 'fa-check' : 'fa-times'} mr-1"></i> ${u.isOk ? 'Todo bien' : u.faults + ' desperfecto(s)'}</span>`;
                        else html += `<span class="btn-wizard-action mr-2 border-0 text-muted">Sin verificar</span><button class="btn-wizard-action btn-wizard-primary" onclick="openModalL6(${u.id}, '${u.name}', '${u.inventory}')">Verificar</button>`;
                    } 
                    else if (stepNum === 2) {
                        if(!u.hasRequest) allCompleted = false;
                        if(u.hasRequest) html += `<span class="badge badge-primary px-3 py-2 border-0 rounded-pill" style="background:#2962ff;"><i class="fas fa-check mr-1"></i> Solicitud enviada</span>`;
                        else html += `<span class="btn-wizard-action mr-2 border-0 text-muted">Sin solicitud</span><button class="btn-wizard-action btn-wizard-primary" onclick="openModalL7(${u.id}, '${u.name}', '${u.inventory}', '${u.faultDetails}')">Hacer Solicitud</button>`;
                    }
                    else if (stepNum === 3) {
                        if(!u.isMaintained) allCompleted = false;
                        if(u.isMaintained) html += `<span class="badge badge-success px-3 py-2 border-0 rounded-pill"><i class="fas fa-check-double mr-1"></i> Mantenimiento OK</span>`;
                        else html += `<button class="btn-wizard-action btn-wizard-primary" onclick="toggleTaskPanel(${u.id})"><i class="fas fa-wrench mr-1"></i> Ejecutar Mantenimiento</button>`;
                    }
                    else if (stepNum === 4) {
                        html += `<button class="btn-wizard-action btn-wizard-primary" onclick="renderActaL3('${u.name}', '${u.inventory}', '${u.description}')"><i class="fas fa-print mr-1"></i> Generar L3</button>`;
                    }
                    else if (stepNum === 5) {
                        html += `<span class="badge badge-success px-3 py-2 border-0 rounded-pill bg-success-soft text-success"><i class="fas fa-check-circle mr-1"></i> Kardex Actualizado</span>`;
                    }

                    html += `</div></div>`;

                    if(stepNum === 3 && !u.isMaintained) {
                        html += `<div id="taskPanel_${u.id}" class="mt-2 p-4 bg-white border rounded-lg" style="display:none; margin-bottom:15px;">
                                    <h6 class="font-weight-bold text-dark mb-3">Avance del Mantenimiento</h6>
                                    <div class="d-flex justify-content-between small font-weight-bold mb-1"><span>Progreso Total</span><span id="txtProg_${u.id}" class="text-warning">0%</span></div>
                                    <div class="progress mb-4" style="height: 10px;"><div id="barProg_${u.id}" class="progress-bar bg-warning" style="width: 0%"></div></div>
                                    <p class="small text-muted font-weight-bold uppercase mb-2">TAREAS DE MANTENIMIENTO</p>
                                    
                                    <div class="task-row custom-control custom-checkbox">
                                        <input type="checkbox" class="custom-control-input chk-${u.id}" id="chk1_${u.id}" onchange="calcProg(${u.id})">
                                        <label class="custom-control-label text-dark font-weight-bold small pt-1" for="chk1_${u.id}">Limpieza exterior e interior del equipo</label>
                                    </div>
                                    <div class="task-row custom-control custom-checkbox">
                                        <input type="checkbox" class="custom-control-input chk-${u.id}" id="chk2_${u.id}" onchange="calcProg(${u.id})">
                                        <label class="custom-control-label text-dark font-weight-bold small pt-1" for="chk2_${u.id}">Revisión y ajuste de componentes mecánicos</label>
                                    </div>
                                    <div class="task-row custom-control custom-checkbox">
                                        <input type="checkbox" class="custom-control-input chk-${u.id}" id="chk3_${u.id}" onchange="calcProg(${u.id})">
                                        <label class="custom-control-label text-dark font-weight-bold small pt-1" for="chk3_${u.id}">Calibración y verificación de parámetros</label>
                                    </div>
                                    
                                    <div class="row mt-4 align-items-center">
                                        <div class="col-md-4"><input type="number" id="cost_${u.id}" class="form-control form-control-sm" placeholder="Costo Total (Bs.)"></div>
                                        <div class="col-md-8 text-right"><button class="btn btn-primary btn-sm btn-rounded font-weight-bold px-4" style="background:#2962ff; border:none;" onclick="saveTaskL8(${u.id}, ${u.requestId})">Guardar Mantenimiento <i class="fas fa-check ml-1"></i></button></div>
                                    </div>
                                 </div>`;
                    }
                    $container.append(html);
                });

                if(stepNum === 1) $('#btnNextStep1').prop('disabled', !allCompleted).toggleClass('disabled-btn', !allCompleted);
                if(stepNum === 2) $('#btnNextStep2').prop('disabled', !allCompleted).toggleClass('disabled-btn', !allCompleted);
                if(stepNum === 3) $('#btnNextStep3').prop('disabled', !allCompleted).toggleClass('disabled-btn', !allCompleted);
            });
        }

        // ================= MODAL L6 =================
        function openModalL6(unitId, name, inv) {
            $('#l6ModalLabName').val($('#wizardLabSelect option:selected').text());
            $('#l6ModalUnitName').val(name + ' (Inv: ' + inv + ')');
            $('#l6ModalUnitId').val(unitId);
            $('.l6-check').prop('checked', false); 
            $('#modalL6').modal('show');
        }
        function checkAllL6() { $('.l6-check').prop('checked', false); }
        
        function saveL6Form() {
            let faults = $('.l6-check:checked').length;
            let unitId = $('#l6ModalUnitId').val();
            let token = $('input[name="__RequestVerificationToken"]').val();
            $.post({ url: '/Index?handler=WizardVerifyL6', data: { __RequestVerificationToken: token, unitId: unitId, faultCount: faults }, success: function() {
                $('#modalL6').modal('hide');
                loadWizardUnits(1);
            }});
        }

        // ================= MODAL L7 =================
        function openModalL7(unitId, name, inv, desc) {
            $('#l7ModalLabNameInput').val($('#wizardLabSelect option:selected').text());
            $('#l7ModalLabName2').text($('#wizardLabSelect option:selected').text());
            $('#l7ModalUnitName').val(name + ' (Inv: ' + inv + ')');
            $('#l7Desc').val(desc);
            $('#l7ModalUnitId').val(unitId);
            $('#modalL7').modal('show');
        }
        function saveL7Form() {
            let unitId = $('#l7ModalUnitId').val();
            let labId = $('#wizardLabSelect').val();
            let token = $('input[name="__RequestVerificationToken"]').val();
            $.post({ url: '/Index?handler=WizardGenerateL7', data: { __RequestVerificationToken: token, unitId: unitId, labId: labId }, success: function() {
                $('#modalL7').modal('hide');
                loadWizardUnits(2);
            }});
        }

        // ================= PASO 3 (L8) =================
        function toggleTaskPanel(unitId) { $('#taskPanel_'+unitId).slideToggle(); }
        function calcProg(unitId) {
            let total = $('.chk-'+unitId).length;
            let checked = $('.chk-'+unitId+':checked').length;
            let perc = Math.round((checked/total)*100);
            $('#txtProg_'+unitId).text(perc+'%');
            $('#barProg_'+unitId).css('width', perc+'%');
            $('.chk-'+unitId).each(function(){
                if($(this).is(':checked')) $(this).next('label').addClass('task-completed');
                else $(this).next('label').removeClass('task-completed');
            });
        }
        function saveTaskL8(unitId, reqId) {
            let labId = $('#wizardLabSelect').val();
            let cost = $('#cost_'+unitId).val() || 0;
            let token = $('input[name="__RequestVerificationToken"]').val();
            $.post({ url: '/Index?handler=WizardSaveL8', data: { __RequestVerificationToken: token, unitId: unitId, requestId: reqId, labId: labId, cost: cost, description: '' }, success: () => loadWizardUnits(3) });
        }

        // ================= PASO 4 (L3 Acta Print) =================
        function renderActaL3(name, inv, desc) {
            let labName = $('#wizardLabSelect option:selected').text();
            let html = `
                <div class="acta-l3-paper">
                    <div class="d-flex justify-content-between align-items-center border-bottom pb-4 mb-4">
                        <div class="bg-light text-muted font-weight-bold p-3 text-center" style="width: 120px;">LOGO</div>
                        <div class="text-center">
                            <h4 class="font-weight-bold text-dark mb-0">ACTA DE SALIDA — MANTENIMIENTO</h4>
                            <h5 class="font-weight-bold text-dark">EXTERNO</h5>
                            <small class="text-muted">Gestión 2025-I</small>
                        </div>
                        <div class="text-danger font-weight-bold h5">N° ACT-001</div>
                    </div>
                    <div class="row">
                        <div class="col-6 pr-4 border-right">
                            <h6 class="font-weight-bold text-dark uppercase mb-3">Datos del Equipo</h6>
                            <p class="small text-muted mb-0 uppercase">Inventario</p><p class="font-weight-bold text-dark">${inv}</p>
                            <p class="small text-muted mb-0 uppercase">Equipo</p><p class="font-weight-bold text-dark">${name}</p>
                            <p class="small text-muted mb-0 uppercase">Laboratorio</p><p class="font-weight-bold text-dark">${labName}</p>
                        </div>
                        <div class="col-6 pl-4">
                            <h6 class="font-weight-bold text-dark uppercase mb-3">Datos Empresa Externa</h6>
                            <div class="form-group mb-2"><label class="small text-muted uppercase mb-1">Empresa</label><input type="text" class="form-control form-control-sm" value="Tech Services S.R.L."></div>
                            <div class="form-group mb-2"><label class="small text-muted uppercase mb-1">NIT</label><input type="text" class="form-control form-control-sm" value="123456789"></div>
                            <div class="row mb-3">
                                <div class="col-6"><label class="small text-muted uppercase mb-1">Fecha Salida</label><input type="date" class="form-control form-control-sm"></div>
                                <div class="col-6"><label class="small text-muted uppercase mb-1">Retorno Est.</label><input type="date" class="form-control form-control-sm"></div>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between mt-5 pt-5 px-5 text-center">
                        <div class="border-top pt-2" style="width: 200px;"><small class="font-weight-bold text-dark d-block">Responsable Laboratorio</small></div>
                        <div class="rounded-circle bg-light d-flex align-items-center justify-content-center text-muted small font-weight-bold" style="width:80px; height:80px;">SELLO</div>
                        <div class="border-top pt-2" style="width: 200px;"><small class="font-weight-bold text-dark d-block">Empresa Externa</small></div>
                    </div>
                    <div class="text-center mt-5 d-print-none">
                        <button class="btn btn-secondary btn-rounded px-4 mr-2" onclick="$('#printAreaL3').hide()">Cerrar</button>
                        <button class="btn btn-primary btn-rounded px-5 font-weight-bold shadow" onclick="window.print()"><i class="fas fa-print mr-2"></i> Imprimir</button>
                    </div>
                </div>`;
            $('#printAreaL3').html(html).fadeIn();
        }

        // ================= PASO 6 (Desembolso Modal) =================
        function openDesembolsoModal(id, name, inv, cost) {
            $('#currentDesembUnitId').val(id);
            $('#desembEqName').text(name);
            $('#desembEqInv').text(inv);
            $('#desembEqCost').text(cost + ' Bs.');
            $('#modalDesembolso').modal('show');
        }

        function submitDesembolso() {
            let id = $('#currentDesembUnitId').val();
            let token = $('input[name="__RequestVerificationToken"]').val();
            $.post({ url: '/Index?handler=WizardRequestDesembolso', data: { __RequestVerificationToken: token, unitId: id }, success: function() {
                $('#modalDesembolso').modal('hide');
                loadWizardUnits(6);
            }});
        }

        // === NAVEGACIÓN ===
        function goToWizardStep(stepNumber) {
            if (!$("#wizardLabSelect").val()) { Swal.fire('Atención', 'Selecciona un laboratorio en el Paso 1.', 'warning'); return; }
            $('#wizardStep1Container, #wizardStep2Container, #wizardStep3Container, #wizardStep4Container, #wizardStep5Container, #wizardStep6Container, #printAreaL3').hide();
            
            $('.step-item').removeClass('active completed');
            for(let i=1; i<stepNumber; i++) $('.step-item:nth-child('+(i+1)+')').addClass('completed');
            $('.step-item:nth-child('+(stepNumber+1)+')').addClass('active');
            
            currentWizardStep = stepNumber;
            $('#wizardStep' + stepNumber + 'Container').fadeIn(300);
            loadWizardUnits(stepNumber);
        }

        function finishWizardRound() {
            let token = $('input[name="__RequestVerificationToken"]').val();
            let labId = $('#wizardLabSelect').val();
            $.post({ url: '/Index?handler=WizardFinishRound', data: { __RequestVerificationToken: token, labId: labId }, success: function() {
                Swal.fire('Gestión del laboratorio finalizada con éxito', 'Los registros han sido archivados.', 'success').then(() => {
                    $('#wizardApp').slideUp(300, () => $('#mainDashboard').fadeIn(300));
                    $('#wizardLabSelect').val('');
                    $('.step-item').removeClass('active completed');
                    $('#barStep1').addClass('active');
                    $('#wizardStep6Container').hide();
                    $('#wizardStep1Container').show();
                });
            }});
        }
    </script>
}