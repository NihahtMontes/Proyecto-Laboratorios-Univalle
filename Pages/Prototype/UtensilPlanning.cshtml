@page "/Prototype/UtensilPlanning"
@{
    ViewData["Title"] = "Prototipo - Planificacion de utensilios";
}

@section Styles {
    <style>
        .prototype-shell { --brand: #bb1e2d; --brand-dark: #85131f; --ink: #263238; --muted: #6b7280; }
        .prototype-hero { background: linear-gradient(120deg, #8d1723 0%, #bb1e2d 58%, #d84b58 100%); border-radius: 12px; color: #fff; overflow: hidden; position: relative; }
        .prototype-hero:after { content: ""; position: absolute; width: 230px; height: 230px; border-radius: 50%; right: -65px; top: -110px; background: rgba(255,255,255,.10); }
        .prototype-hero .hero-icon { width: 58px; height: 58px; border-radius: 14px; display: inline-flex; align-items: center; justify-content: center; background: rgba(255,255,255,.16); font-size: 26px; }
        .demo-ribbon { background: #fff7ed; color: #9a3412; border: 1px solid #fed7aa; border-radius: 8px; }
        .prototype-nav { gap: 8px; overflow-x: auto; flex-wrap: nowrap; padding-bottom: 4px; }
        .prototype-nav .nav-link { border: 1px solid #e5e7eb; background: #fff; color: #4b5563; border-radius: 24px; font-weight: 700; white-space: nowrap; padding: .65rem 1rem; }
        .prototype-nav .nav-link.active { background: var(--brand); border-color: var(--brand); color: #fff; box-shadow: 0 7px 16px rgba(187,30,45,.22); }
        .prototype-view { display: none; }
        .prototype-view.active { display: block; animation: prototypeFade .18s ease-out; }
        @@keyframes prototypeFade { from { opacity: .35; transform: translateY(4px); } to { opacity: 1; transform: none; } }
        .metric-card { border: 0; border-radius: 10px; box-shadow: 0 8px 22px rgba(15,23,42,.07); height: 100%; }
        .metric-icon { width: 42px; height: 42px; border-radius: 11px; display: inline-flex; align-items: center; justify-content: center; }
        .bg-soft-red { background: #feecef; color: #bb1e2d; }
        .bg-soft-green { background: #e8f8f1; color: #087f5b; }
        .bg-soft-amber { background: #fff6dc; color: #b7791f; }
        .bg-soft-blue { background: #e8f2ff; color: #2962ff; }
        .surface-card { border: 0; border-radius: 10px; box-shadow: 0 8px 22px rgba(15,23,42,.06); }
        .section-kicker { color: var(--brand); letter-spacing: .08em; font-size: .72rem; font-weight: 800; text-transform: uppercase; }
        .practice-row { border-left: 4px solid #d1d5db; transition: .15s ease; }
        .practice-row:hover { border-left-color: var(--brand); background: #fffafa; }
        .status-dot { width: 9px; height: 9px; display: inline-block; border-radius: 50%; margin-right: 6px; }
        .step-track { display: flex; align-items: flex-start; justify-content: space-between; position: relative; }
        .step-track:before { content: ""; position: absolute; height: 3px; background: #e5e7eb; left: 7%; right: 7%; top: 19px; }
        .flow-step { width: 18%; text-align: center; position: relative; z-index: 1; color: #9ca3af; }
        .flow-step .circle { width: 40px; height: 40px; border-radius: 50%; background: #fff; border: 3px solid #e5e7eb; display: flex; align-items: center; justify-content: center; margin: 0 auto 7px; }
        .flow-step.done, .flow-step.current { color: #374151; font-weight: 700; }
        .flow-step.done .circle { border-color: #0f9d72; color: #0f9d72; }
        .flow-step.current .circle { border-color: var(--brand); background: var(--brand); color: #fff; box-shadow: 0 0 0 5px #feecef; }
        .availability-bar { height: 7px; border-radius: 6px; background: #edf0f3; overflow: hidden; min-width: 90px; }
        .availability-bar span { display: block; height: 100%; border-radius: 6px; }
        .phone-hint { display: none; }
        .data-contract { border-left: 4px solid #2962ff; background: #f4f8ff; }
        .clickable-card { cursor: pointer; transition: transform .15s ease, box-shadow .15s ease; }
        .clickable-card:hover { transform: translateY(-2px); box-shadow: 0 12px 25px rgba(15,23,42,.10); }
        @@media (max-width: 767.98px) {
            .prototype-hero h2 { font-size: 1.35rem; }
            .step-track { overflow-x: auto; justify-content: flex-start; gap: 22px; padding-bottom: 10px; }
            .step-track:before { display: none; }
            .flow-step { min-width: 100px; }
            .phone-hint { display: block; }
        }
    </style>
}

