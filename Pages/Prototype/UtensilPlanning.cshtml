@section Scripts {
    <script>
        (function () {
            function openView(name, updateHash) {
                var target = document.getElementById('view-' + name);
                if (!target) return;
                document.querySelectorAll('.prototype-view').forEach(function (item) { item.classList.remove('active'); });
                document.querySelectorAll('.prototype-nav .nav-link').forEach(function (item) { item.classList.toggle('active', item.getAttribute('data-view') === name); });
                target.classList.add('active');
                if (updateHash !== false && history.replaceState) history.replaceState(null, '', '#' + name);
                window.scrollTo({ top: Math.max(0, document.querySelector('.prototype-shell').offsetTop - 80), behavior: 'smooth' });
            }

            document.querySelectorAll('[data-view], [data-go]').forEach(function (link) {
                link.addEventListener('click', function (event) {
                    event.preventDefault();
                    openView(link.getAttribute('data-view') || link.getAttribute('data-go'));
                });
            });

            document.addEventListener('click', function (event) {
                var action = event.target.closest('[data-demo]');
                if (!action) return;
                var type = action.getAttribute('data-demo');
                if (type === 'remove-row') {
                    action.closest('tr').remove();
                    return;
                }
                if (type === 'add-item') {
                    Swal.fire({ type: 'info', title: 'Selector de catálogo', text: 'En la versión funcional se consultarán únicamente catálogos confirmados y unidades disponibles.', confirmButtonColor: '#bb1e2d' });
                    return;
                }
                if (type === 'resolve-conflict') {
                    Swal.fire({ type: 'question', title: 'Solicitar préstamo interno', text: 'Se reservarán 2 pipetas de LAB-Q-02 para este horario.', showCancelButton: true, confirmButtonText: 'Simular préstamo', cancelButtonText: 'Cancelar', confirmButtonColor: '#bb1e2d' }).then(function (result) {
                        if (result.value || result.isConfirmed) Swal.fire({ type: 'success', title: 'Préstamo simulado', text: 'La brecha queda cubierta en el prototipo.' });
                    });
                    return;
                }
                if (type === 'approve-reservation') {
                    Swal.fire({ type: 'success', title: 'Reserva simulada', text: 'La práctica pasó a la cola semanal de preparación L-3.' }).then(function () { openView('operacion'); });
                    return;
                }
                if (type === 'close-return') {
                    Swal.fire({ type: 'warning', title: 'Existe una diferencia', text: 'Se devolvieron 11 de 12 pipetas. Registre la novedad antes de cerrar.', showCancelButton: true, confirmButtonText: 'Registrar novedad', cancelButtonText: 'Volver', confirmButtonColor: '#bb1e2d' }).then(function (result) { if (result.value || result.isConfirmed) openView('incidentes'); });
                    return;
                }
                var messages = {
                    'save-draft': ['Borrador guardado', 'La simulación conserva los datos mientras permanezca en esta página.'],
                    'print-l3': ['Vista previa L-3', 'El PDF operativo se generará cuando el contrato definitivo sea aprobado.'],
                    'create-l5': ['Borrador L-5 generado', 'La novedad quedó vinculada a L3-2026-0087 en esta demostración.'],
                    'purchase-proposal': ['Propuesta de compra', 'La recomendación debe revisarse con Inventario y no crea una adquisición automáticamente.']
                };
                var message = messages[type] || ['Acción demostrativa', 'Esta interacción no modifica datos reales.'];
                Swal.fire({ type: 'success', title: message[0], text: message[1], confirmButtonColor: '#bb1e2d' });
            });

            var initial = (window.location.hash || '#resumen').substring(1);
            openView(document.getElementById('view-' + initial) ? initial : 'resumen', false);
        })();
    </script>
}
