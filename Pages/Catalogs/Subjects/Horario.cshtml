@page
@model Proyecto_Laboratorios_Univalle.Pages.Catalogs.Subjects.HorarioModel
@using Proyecto_Laboratorios_Univalle.Pages.Shared
@{
    ViewData["Title"] = "Horario de la materia";
    ViewData["Section"] = "Planificación académica";
    ViewData["HidePageTitle"] = true;
}

<div class="page-breadcrumb">
    <div class="row align-items-center">
        <div class="col-md-8">
            <nav aria-label="breadcrumb" class="mb-2">
                <ol class="breadcrumb bg-transparent p-0 mb-0 small">
                    <li class="breadcrumb-item">
                        <a asp-page="./Index" class="text-muted text-decoration-none">
                            <i class="fas fa-arrow-left mr-1"></i>Volver al listado
                        </a>
                    </li>
                </ol>
            </nav>
            <h4 class="page-title text-uppercase text-primary font-weight-bold mb-0 mt-1">Catálogo de Materias</h4>
            <h2 class="font-weight-bold text-dark mb-0">Horario semanal de clases</h2>
            @if (Model.Subject != null)
            {
                <div class="text-muted small mt-1">
                    <span class="font-weight-bold text-dark">@Model.Subject.Name</span>
                    @if (!string.IsNullOrWhiteSpace(Model.Subject.Code))
                    {
                        <span class="badge badge-pill badge-light border text-muted ml-1 font-weight-bold">@Model.Subject.Code</span>
                    }
                    @if (Model.Subject.Career != null)
                    {
                        <span class="ml-2"><i class="fas fa-graduation-cap mr-1"></i>@Model.Subject.Career.Name</span>
                    }
                    @if (Model.Subject.Semester.HasValue)
                    {
                        <span class="ml-2">@($"{Model.Subject.Semester.Value}.º semestre")</span>
                    }
                </div>
            }
        </div>
        @if (Model.Managements.Count > 0)
        {
            <div class="col-md-4 mt-2 mt-md-0">
                <form method="get" class="d-flex align-items-center justify-content-md-end">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <label for="hg-management" class="small text-muted mb-0 mr-2">Gestión</label>
                    <select id="hg-management" name="managementId" class="custom-select custom-select-sm w-auto"
                            onchange="this.form.submit()"
                            title="Cambiar la gestión consultada">
                        @foreach (var m in Model.Managements)
                        {
                            <option value="@m.Id" selected="@(Model.Management?.Id == m.Id)">@m.Code · @m.StatusText@(m.IsCurrent ? " (actual)" : "")</option>
                        }
                    </select>
                </form>
            </div>
        }
    </div>
</div>

<div class="container-fluid mt-3">
    @if (Model.Management == null)
    {
        <div class="gr-empty-state">
            <i class="mdi mdi-table-large gr-empty-state__icon"></i>
            <h3 class="font-weight-bold text-dark mb-2">No hay un semestre académico activo</h3>
            <p class="text-muted mb-4">Active una gestión semestral o elija una en el selector para consultar o editar el horario de los grupos de esta materia.</p>
            <a asp-page="/Managements/Index" class="btn btn-primary btn-rounded px-4 shadow-sm gr-btn-primary">
                <i class="fas fa-university mr-2"></i> Ir a Gestiones
            </a>
        </div>
    }
    else
    {
        var management = Model.Management;

        @if (Model.IsReadOnly)
        {
            <div class="alert border-0 shadow-sm rounded-lg d-flex align-items-center mb-3 gr-readonly">
                <i class="fas fa-eye text-warning fa-lg mr-3"></i>
                <div class="flex-grow-1">
                    <strong class="text-dark">Consultando la gestión @management.Code (@management.StatusText): solo lectura.</strong>
                    <div class="small text-muted">El horario de esta gestión no admite cambios.</div>
                </div>
            </div>
        }

        @if (Model.Periods.Count == 0)
        {
            <div class="gr-empty-state">
                <i class="far fa-clock gr-empty-state__icon"></i>
                <h4 class="font-weight-bold text-dark mb-2">No hay periodos académicos configurados</h4>
                <p class="text-muted mb-0">La grilla usa el catálogo de periodos de clase (1 a 12) para armar las filas del horario.</p>
            </div>
        }
        else if (Model.Groups.Count == 0)
        {
            <div class="gr-empty-state">
                <i class="mdi mdi-account-group-outline gr-empty-state__icon"></i>
                <h4 class="font-weight-bold text-dark mb-2">@Model.Subject!.Name no tiene grupos en la gestión @management.Code</h4>
                <p class="text-muted mb-4">Registre un grupo (paralelo) de esta materia para poder cargar su horario semanal.</p>
                <a asp-page="/Catalogs/CourseGroups/Create"
                   asp-route-managementId="@management.Id"
                   asp-route-subjectId="@Model.Id"
                   class="btn btn-primary btn-rounded px-4 shadow-sm gr-btn-primary">
                    <i class="mdi mdi-account-plus mr-2"></i> Crear grupo de materia
                </a>
            </div>
        }
        else
        {
            <form method="post" asp-page="./Horario" asp-route-id="@Model.Id" asp-route-managementId="@Model.ManagementId"
                  id="hg-form" novalidate>
                <input type="hidden" asp-for="SlotsJson" />

                <!-- Chips de grupos, resumen en vivo e indicador de cambios -->
                <div class="card border-0 shadow-sm rounded-lg mb-4">
                    <div class="card-body py-3">
                        <div class="d-flex flex-wrap align-items-center">
                            <h6 class="font-weight-bold text-dark mb-0 mr-3">
                                <i class="mdi mdi-account-group mr-1"></i> Grupos de la materia
                            </h6>
                            <div class="d-flex flex-wrap hg-chips" id="hg-chips" role="group" aria-label="Grupos de la materia"></div>
                            <span class="badge ml-auto px-3 py-2 hg-unsaved" id="hg-unsaved" hidden>
                                <i class="mdi mdi-circle-edit-outline mr-1"></i> Cambios sin guardar
                            </span>
                        </div>
                        <div class="hg-summaries mt-3" id="hg-summaries" aria-live="polite"></div>
                    </div>
                </div>

                <!-- Hoja del horario (mismo formato que la Grilla por laboratorio) -->
                <section class="card border-0 shadow-sm rounded-lg mb-4" aria-label="Horario semanal de la materia">
                    <header class="gr-sheet__head">
                        <div class="gr-sheet__brand">
                            <strong>UNIVALLE</strong>
                            <span>Laboratorios</span>
                        </div>
                        <div class="gr-sheet__title">
                            <span>HORARIO SEMANAL DE CLASES — POR GRUPO</span>
                        </div>
                        <div class="gr-sheet__code">
                            <span>Gestión</span>
                            <strong>@management.Code</strong>
                        </div>
                    </header>
                    <dl class="gr-sheet__meta">
                        <div class="gr-sheet__meta-wide"><dt>Materia</dt><dd>@Model.Subject!.Name@(string.IsNullOrWhiteSpace(Model.Subject.Code) ? "" : " · " + Model.Subject.Code)</dd></div>
                        <div><dt>Carrera</dt><dd>@(Model.Subject.Career != null ? Model.Subject.Career.Name : "Sin carrera")</dd></div>
                        <div><dt>Semestre</dt><dd>@(Model.Subject.Semester.HasValue ? $"{Model.Subject.Semester.Value}.º" : "—")</dd></div>
                        <div><dt>Grupos</dt><dd>@Model.Groups.Count</dd></div>
                        <div><dt>Estado</dt><dd>@(Model.IsReadOnly ? "Solo lectura" : "Editable")</dd></div>
                    </dl>

                    <div class="gr-scroll">
                        <div class="gr-grid" id="hg-grid"
                             style="grid-template-rows: auto repeat(@Model.Periods.Count, minmax(var(--gr-row-height), auto));">
                            <partial name="_PeriodWeekGrid" model="Model.GridModel" />
                            @foreach (var period in Model.Periods)
                            {
                                @for (var weekday = 1; weekday <= 6; weekday++)
                                {
                                    <button type="button"
                                            class="gr-cell hg-cell"
                                            style="grid-column: @(weekday + 1); grid-row: @(period.Order + 1);"
                                            data-weekday="@weekday" data-order="@period.Order"
                                            aria-label="@PeriodWeekGridModel.DefaultDayNames[weekday - 1], periodo @period.Order (@period.Label)"
                                            aria-pressed="false"
                                            disabled="@Model.IsReadOnly"></button>
                                }
                            }
                        </div>
                    </div>

                    @if (!Model.IsReadOnly)
                    {
                        <div class="hg-form-foot d-flex align-items-center border-top px-4 py-3">
                            <span class="small text-muted">
                                <i class="fas fa-info-circle mr-1"></i>
                                Elija un grupo y haga clic (o arrastre) sobre las celdas para marcar o desmarcar sus clases.
                            </span>
                            <button type="button" id="hg-save" class="btn btn-primary btn-rounded font-weight-bold px-4 ml-auto gr-btn-primary">
                                <i class="mdi mdi-content-save mr-1"></i> Guardar horario
                            </button>
                        </div>
                    }
                </section>
            </form>
        }
    }
</div>

<script type="application/json" id="hg-config">@Html.Raw(Model.ConfigJson)</script>

@section Styles {
    <link href="~/css/grilla.css" rel="stylesheet" asp-append-version="true">
    <link href="~/css/horario-grupos.css" rel="stylesheet" asp-append-version="true">
}
@section Scripts {
    <script src="~/js/horario-grupos.js" asp-append-version="true"></script>
}
