@page
@model Proyecto_Laboratorios_Univalle.Pages.Catalogs.CourseGroups.CreateModel
@{
    ViewData["Title"] = "Nuevo grupo";
    ViewData["Section"] = "Planificación académica";
}

<div class="row justify-content-center">
    <div class="col-lg-11 col-xl-10">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <!-- Header -->
                <div class="d-flex no-block align-items-center mb-4 pb-3 border-bottom">
                    <div>
                        <h4 class="card-title text-dark font-weight-bold">Nuevo grupo de la gestión</h4>
                        <h6 class="card-subtitle text-muted">Registre un paralelo (G1, A1...) de la gestión con su materia, docente, laboratorio y características operativas.</h6>
                    </div>
                    <div class="ml-auto mt-2 mt-md-0">
                        <i class="fas fa-users-class fa-2x text-info opacity-5"></i>
                    </div>
                </div>

                <form method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm border-0 small" role="alert"></div>

                    <div class="row">
                        <!-- Identification -->
                        <div class="col-md-5 border-right">
                            <h5 class="font-weight-bold text-info mb-3">
                                <i class="fas fa-id-card mr-2"></i> Identidad del Grupo
                            </h5>

                            <div class="form-group mb-4 border-left border-warning pl-3 bg-light p-3 rounded shadow-none">
                                <label class="control-label font-weight-bold small text-warning uppercase mb-2">Código del Grupo</label>
                                <input class="form-control bg-light border-warning shadow-none font-weight-bold" value="Se generará automáticamente" disabled />
                                <small class="form-text text-muted"><i class="fas fa-magic mr-1"></i>Formato GRP-00001.</small>
                            </div>

                            <div class="form-group mb-4">
                                <label asp-for="Input.Name" class="control-label font-weight-bold small uppercase text-muted">Nombre del Grupo <span class="text-danger">*</span></label>
                                <input asp-for="Input.Name" class="form-control" placeholder="Ej: G1, A1, B2..." required maxlength="20" />
                                <small class="text-muted italic mt-1 d-block">Junto con la gestión y la materia, debe ser único.</small>
                                <span asp-validation-for="Input.Name" class="text-danger small font-weight-bold"></span>
                            </div>

                            <div class="form-group mb-4">
                                <label asp-for="Input.ManagementId" class="control-label font-weight-bold small uppercase text-muted">Gestión <span class="text-danger">*</span></label>
                                <select asp-for="Input.ManagementId" class="form-control custom-select select2" asp-items="Model.ManagementOptions" required>
                                    <option value="">-- Seleccione gestión --</option>
                                </select>
                                <span asp-validation-for="Input.ManagementId" class="text-danger small font-weight-bold"></span>
                            </div>

                            <!-- Filtro opcional por carrera (solo aplica a subjects con CareerId) -->
                            <div class="form-group mb-4">
                                <label class="control-label font-weight-bold small uppercase text-muted">Filtrar materias por carrera (opcional)</label>
                                <select id="careerFilter" class="form-control custom-select select2" asp-items="Model.CareerOptions" data-placeholder="-- Todas las carreras --">
                                    <option value="">-- Todas las carreras --</option>
                                </select>
                                <small class="text-muted italic mt-1 d-block">Solo afecta al listado de materias.</small>
                            </div>

                            <div class="form-group mb-4">
                                <label asp-for="Input.SubjectId" class="control-label font-weight-bold small uppercase text-muted">Materia <span class="text-danger">*</span></label>
                                <select asp-for="Input.SubjectId" class="form-control custom-select select2" required id="subjectSelect">
                                    <option value="">-- Seleccione materia --</option>
                                    @foreach (var opt in Model.SubjectOptions)
                                    {
                                        <option value="@opt.Id" data-career="@(opt.CareerId?.ToString() ?? "")">@opt.Name</option>
                                    }
                                </select>
                                <small id="subjectFilterHint" class="text-muted italic d-block mt-1"></small>
                                <span asp-validation-for="Input.SubjectId" class="text-danger small font-weight-bold"></span>
                            </div>
                        </div>

                        <!-- Operación -->
                        <div class="col-md-7 pl-lg-4">
                            <h5 class="font-weight-bold text-info mb-3">
                                <i class="fas fa-chalkboard-teacher mr-2"></i> Operación Académica
                            </h5>

                            <div class="form-group mb-4">
                                <label asp-for="Input.TeacherPersonId" class="control-label font-weight-bold small uppercase text-muted">Docente <span class="text-danger">*</span></label>
                                <select asp-for="Input.TeacherPersonId" class="form-control custom-select select2" asp-items="Model.TeacherOptions" required>
                                    <option value="">-- Seleccione docente --</option>
                                </select>
                                <span asp-validation-for="Input.TeacherPersonId" class="text-danger small font-weight-bold"></span>
                            </div>

                            <div class="form-group mb-4">
                                <label asp-for="Input.LaboratoryId" class="control-label font-weight-bold small uppercase text-muted">Laboratorio Habitual</label>
                                <select asp-for="Input.LaboratoryId" class="form-control custom-select select2" asp-items="Model.LaboratoryOptions">
                                    <option value="">-- Sin laboratorio definido --</option>
                                </select>
                                <small class="text-muted italic mt-1 d-block">Opcional. Indique el laboratorio donde el grupo suele dictar clases.</small>
                                <span asp-validation-for="Input.LaboratoryId" class="text-danger small font-weight-bold"></span>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group mb-4">
                                        <label asp-for="Input.StudentCount" class="control-label font-weight-bold small uppercase text-muted">N.º de Estudiantes</label>
                                        <input asp-for="Input.StudentCount" type="number" min="0" max="1000" class="form-control" placeholder="0 – 1000" />
                                        <span asp-validation-for="Input.StudentCount" class="text-danger small"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group mb-4">
                                        <label asp-for="Input.ScalingFactor" class="control-label font-weight-bold small uppercase text-muted">Factor de Escalamiento</label>
                                        <input asp-for="Input.ScalingFactor" type="number" min="0" max="1000" class="form-control" placeholder="0 – 1000" />
                                        <small class="text-muted italic mt-1 d-block">Multiplica las cantidades de la receta del grupo.</small>
                                        <span asp-validation-for="Input.ScalingFactor" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="alert alert-light border-0 small p-3 mt-2 text-info italic shadow-none border-left border-info border-3">
                                <i class="fas fa-info-circle mr-1"></i> El grupo quedará <strong>Activo</strong> y disponible para asociar prácticas y recetas.
                            </div>
                        </div>
                    </div>

                    <!-- Horario de clases por periodos -->
                    <div class="border-top pt-4 mt-2">
                        <partial name="_GroupScheduleField" model="Model.ScheduleField" />
                        <span asp-validation-for="Input.SlotsJson" class="text-danger small font-weight-bold d-block mt-2"></span>
                    </div>

                    <hr />

                    <div class="form-actions text-right mt-4">
                        <button type="submit" class="btn btn-info btn-rounded px-5 shadow-sm font-weight-bold py-2">
                            <i class="fas fa-save mr-1"></i> Registrar Grupo
                        </button>
                        <a asp-page="./Index" asp-route-ManagementFilter="@Model.Input.ManagementId" class="btn btn-outline-secondary btn-rounded ml-2 py-2 px-4 font-weight-bold">
                            Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="~/assets/libs/select2/dist/css/select2.min.css" rel="stylesheet">
    <link href="~/css/grilla.css" rel="stylesheet" asp-append-version="true">
    <style>
        .help-block ul { list-style: none; padding-left: 0; }
        .italic { font-style: italic; }
        .uppercase { text-transform: uppercase; letter-spacing: 1px; }
        .border-3 { border-left-width: 4px !important; }
        .opacity-5 { opacity: 0.5; }
        .select2-container--default .select2-selection--single { height: 38px; border: 1px solid #ced4da; }
        .select2-container--default .select2-selection--single .select2-selection__rendered { line-height: 38px; }
        .select2-container--default .select2-selection--single .select2-selection__arrow { height: 36px; }
    </style>
}

@section Scripts {
    <script src="~/assets/libs/select2/dist/js/select2.full.min.js"></script><script src="~/js/select2-es.js" asp-append-version="true"></script>
    <script>
        $(function () {
            "use strict";
            $('.select2').select2({ width: '100%', allowClear: true });

            // Filtro opcional por carrera: reconstruye la lista de materias (no deshabilita opciones,
            // porque Select2 las mostraba grises y no se podía elegir ninguna).
            var subjectSelect = $('#subjectSelect');
            var allSubjectOptions = subjectSelect.find('option').filter(function () { return this.value !== ''; }).clone();
            $('#careerFilter').on('change', function () {
                var careerId = $(this).val();
                var currentValue = subjectSelect.val();
                subjectSelect.find('option').filter(function () { return this.value !== ''; }).remove();
                var matches = allSubjectOptions.filter(function () {
                    return !careerId || String($(this).data('career')) === String(careerId);
                }).clone();
                subjectSelect.append(matches);
                var keep = matches.filter(function () { return this.value === currentValue; }).length > 0;
                subjectSelect.val(keep ? currentValue : '').trigger('change');
                $('#subjectFilterHint').text(careerId ? matches.length + ' materia(s) de la carrera seleccionada.' : '');
            });
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}