@page
@model Proyecto_Laboratorios_Univalle.Pages.Catalogs.CourseGroups.IndexModel
@using Proyecto_Laboratorios_Univalle.Models.Enums
@{
    ViewData["Title"] = "Grupos";
    ViewData["Section"] = "Planificación académica";
    var hasActiveFilters = !string.IsNullOrWhiteSpace(Model.SearchTerm)
        || Model.ManagementFilter.HasValue
        || Model.SubjectFilter.HasValue
        || Model.TeacherFilter.HasValue
        || Model.SemesterFilter.HasValue
        || Model.StatusFilter.HasValue;

    string WeekdayName(int? wd) => wd switch
    {
        1 => "Lunes",
        2 => "Martes",
        3 => "Miércoles",
        4 => "Jueves",
        5 => "Viernes",
        6 => "Sábado",
        _ => "—"
    };

    string FormatTime(TimeSpan? t) => t.HasValue ? t.Value.ToString(@"hh\:mm") : "";
    string FormatSchedule(int? wd, TimeSpan? start, TimeSpan? end)
    {
        var day = WeekdayName(wd);
        var s = FormatTime(start);
        var e = FormatTime(end);
        if (string.IsNullOrEmpty(s) && string.IsNullOrEmpty(e)) return "Sin horario definido";
        if (string.IsNullOrEmpty(e)) return $"{day} · {s}";
        if (string.IsNullOrEmpty(s)) return $"{day} · fin {e}";
        return $"{day} · {s} – {e}";
    }
}
<partial name="../Subjects/_SubjectsTabs" model='(ActiveTab: "grupos", ManagementId: Model.ManagementFilter)' />
<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <!-- Header section -->
                <div class="d-md-flex align-items-center mb-4 pb-3 border-bottom">
                    <div>
                        <h3 class="card-title text-dark font-weight-bold mt-2 ml-2">Catálogo de materias</h3>
                        <h6 class="card-subtitle text-muted ml-2">Grupos de trabajo de la gestión: paralelos (G1, A1...) por materia, docente, laboratorio y horario.</h6>
                    </div>
                    <div class="ml-auto mt-3 mt-md-0 d-flex align-items-center">
                        <a asp-page="/Catalogs/StudentGroups/Index" asp-route-managementId="@Model.ManagementFilter"
                           class="btn btn-link text-muted mr-2">
                            <i class="fas fa-users mr-1"></i> Ver por grupo
                        </a>
                        <a asp-page="/Catalogs/StudentGroups/Create" asp-route-managementId="@Model.ManagementFilter"
                           class="btn bg-white border btn-rounded shadow-sm text-dark px-4 font-weight-bold">
                            <i class="fas fa-plus-circle mr-1 text-info"></i> Nuevo Grupo
                        </a>
                    </div>
                </div>

                <!-- 🔍 Smart Index Zone: Search and Filters -->
                <div class="bg-light p-3 mb-4 rounded border-left border-info">
                    <form method="get" data-live-filter-form>
                        <label asp-for="SearchTerm" class="sr-only">Buscar grupo</label>
                        <div class="input-group mb-3">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-white border-right-0"><i class="fas fa-search text-muted"></i></span>
                            </div>
                            <input type="search" asp-for="SearchTerm"
                                   class="form-control border-left-0 @(!string.IsNullOrWhiteSpace(Model.SearchTerm) ? "border-info" : "")"
                                   placeholder="Buscar por código o nombre del grupo"
                                   autocomplete="off"
                                   data-live-filter-search />
                        </div>

                        <div class="d-flex flex-wrap align-items-center border-top pt-3">
                            <select asp-for="ManagementFilter"
                                    class="custom-select btn-rounded w-auto mw-100 mr-2 mb-2 @(Model.ManagementFilter.HasValue ? "border-info text-info font-weight-bold" : "")"
                                    asp-items="Model.ManagementOptions"
                                    aria-label="Gestión"
                                    data-live-filter-control>
                                <option value="">Gestión</option>
                            </select>

                            <select asp-for="SubjectFilter"
                                    class="custom-select btn-rounded w-auto mw-100 mr-2 mb-2 @(Model.SubjectFilter.HasValue ? "border-info text-info font-weight-bold" : "")"
                                    asp-items="Model.SubjectOptions"
                                    aria-label="Materia"
                                    data-live-filter-control>
                                <option value="">Materia</option>
                            </select>

                            <select asp-for="TeacherFilter"
                                    class="custom-select btn-rounded w-auto mw-100 mr-2 mb-2 @(Model.TeacherFilter.HasValue ? "border-info text-info font-weight-bold" : "")"
                                    asp-items="Model.TeacherOptions"
                                    aria-label="Docente"
                                    data-live-filter-control>
                                <option value="">Docente</option>
                            </select>

                            <select asp-for="SemesterFilter"
                                    class="custom-select btn-rounded w-auto mw-100 mr-2 mb-2 @(Model.SemesterFilter.HasValue ? "border-info text-info font-weight-bold" : "")"
                                    asp-items="Model.SemesterOptions"
                                    aria-label="Semestre"
                                    data-live-filter-control>
                                <option value="">Semestre</option>
                            </select>

                            <select asp-for="StatusFilter"
                                    class="custom-select btn-rounded w-auto mw-100 mr-2 mb-2 @(Model.StatusFilter.HasValue ? "border-info text-info font-weight-bold" : "")"
                                    asp-items="@Proyecto_Laboratorios_Univalle.Helpers.EnumHelper.GetStatusSelectList<GeneralStatus>()"
                                    aria-label="Estado"
                                    data-live-filter-control>
                                <option value="">Estado</option>
                            </select>

                            @if (hasActiveFilters)
                            {
                                <a asp-page="./Index" class="btn btn-link btn-sm text-muted mb-2" title="Limpiar filtros">
                                    <i class="fas fa-times mr-1"></i> Limpiar filtros
                                </a>
                            }

                            <span class="small text-muted ml-auto mb-2" aria-live="polite">
                                <strong class="text-dark">@Model.CourseGroups.TotalCount</strong> grupo(s)
                            </span>
                        </div>
                    </form>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover v-middle">
                        <thead class="bg-light">
                            <tr class="small uppercase font-weight-bold">
                                <th>Grupo / Código</th>
                                <th>Materia · Gestión</th>
                                <th>Docente</th>
                                <th>Horario</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.CourseGroups == null || !Model.CourseGroups.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted italic">
                                        <i class="fas fa-users-class fa-3x mb-3 d-block opacity-2"></i>
                                        No se encontraron grupos con los filtros aplicados.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model.CourseGroups)
                                {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="m-r-10">
                                                <span class="btn btn-circle btn-info text-white shadow-sm font-weight-bold"><i class="fas fa-users-class"></i></span>
                                            </div>
                                            <div>
                                                <h6 class="m-b-0 font-weight-bold text-dark">@item.Name</h6>
                                                <span class="text-muted small">Cód: @(string.IsNullOrWhiteSpace(item.Code) ? "—" : item.Code)</span>
                                                <div class="mt-1">
                                                    <span class="badge badge-pill badge-light border text-muted small font-weight-bold"
                                                          title="Cohorte: materias de la misma carrera, semestre y grupo"
                                                          data-toggle="tooltip">
                                                        <i class="fas fa-layer-group mr-1"></i>@Proyecto_Laboratorios_Univalle.Services.GroupScheduleService.CohortLabel(item.Subject?.Semester, item.Name)
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="font-weight-bold text-dark">@(item.Subject?.Name ?? "Sin materia")</div>
                                        <div class="small text-muted">@(item.Management?.Code ?? "Sin gestión")</div>
                                    </td>
                                    <td>
                                        <span class="text-dark font-weight-bold">@(Model.GetTeacherName(item.TeacherPersonId))</span>
                                    </td>
                                    <td>
                                        <div class="small">
                                        @{
                                            var scheduleSummary = Model.GetScheduleSummary(item.Id);
                                        }
                                        @if (scheduleSummary != null)
                                        {
                                            <div class="text-dark"><i class="far fa-calendar-alt text-muted mr-1"></i>@scheduleSummary</div>
                                        }
                                        else
                                        {
                                            <div class="text-dark"><i class="far fa-clock text-muted mr-1"></i>@FormatSchedule(item.Weekday, item.StartTime, item.EndTime)</div>
                                        }
                                            @if (item.Laboratory != null)
                                            {
                                                <div class="text-muted"><i class="fas fa-flask mr-1"></i>@item.Laboratory.Code · @item.Laboratory.Name</div>
                                            }
                                            else
                                            {
                                                <div class="text-muted italic"><i class="fas fa-flask mr-1"></i>Sin laboratorio</div>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge badge-pill @(item.Status == GeneralStatus.Activo ? "badge-success" : "badge-danger") px-3 py-1 font-weight-bold">@item.Status</span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group">
                                            <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning btn-rounded shadow-none" title="Editar">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger btn-rounded mx-1 shadow-none" title="Eliminar">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.CourseGroups!.TotalPages > 1)
                {
                    <nav aria-label="Paginación">
                        <ul class="pagination justify-content-center">
                            @if (Model.CourseGroups.HasPreviousPage)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-page="./Index" asp-route-pageIndex="@(Model.CourseGroups.PageIndex - 1)"
                                       asp-route-SearchTerm="@Model.SearchTerm"
                                       asp-route-ManagementFilter="@Model.ManagementFilter"
                                       asp-route-SubjectFilter="@Model.SubjectFilter"
                                       asp-route-TeacherFilter="@Model.TeacherFilter"
                                       asp-route-SemesterFilter="@Model.SemesterFilter"
                                       asp-route-StatusFilter="@Model.StatusFilter">Anterior</a>
                                </li>
                            }
                            @for (var i = 1; i <= Model.CourseGroups.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CourseGroups.PageIndex ? "active" : "")">
                                    <a class="page-link" asp-page="./Index" asp-route-pageIndex="@i"
                                       asp-route-SearchTerm="@Model.SearchTerm"
                                       asp-route-ManagementFilter="@Model.ManagementFilter"
                                       asp-route-SubjectFilter="@Model.SubjectFilter"
                                       asp-route-TeacherFilter="@Model.TeacherFilter"
                                       asp-route-SemesterFilter="@Model.SemesterFilter"
                                       asp-route-StatusFilter="@Model.StatusFilter">@i</a>
                                </li>
                            }
                            @if (Model.CourseGroups.HasNextPage)
                            {
                                <li class="page-item">
                                        <a class="page-link" asp-page="./Index" asp-route-pageIndex="@(Model.CourseGroups.PageIndex + 1)"
                                           asp-route-SearchTerm="@Model.SearchTerm"
                                           asp-route-ManagementFilter="@Model.ManagementFilter"
                                           asp-route-SubjectFilter="@Model.SubjectFilter"
                                           asp-route-TeacherFilter="@Model.TeacherFilter"
                                           asp-route-SemesterFilter="@Model.SemesterFilter"
                                           asp-route-StatusFilter="@Model.StatusFilter">Siguiente</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .v-middle td { vertical-align: middle !important; }
        .uppercase { text-transform: uppercase; letter-spacing: 1px; }
        .italic { font-style: italic; }
        .opacity-2 { opacity: 0.2; }
    </style>
}
@section Scripts {
    <script>
        $(function () {
            "use strict";
            $('[data-toggle="tooltip"]').tooltip();
        });
    </script>
}