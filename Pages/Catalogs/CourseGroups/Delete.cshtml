@page "{id:int}"
@model Proyecto_Laboratorios_Univalle.Pages.Catalogs.CourseGroups.DeleteModel
@using Proyecto_Laboratorios_Univalle.Models.Enums

@{
    string WeekdayName(int? wd) => wd switch
    {
        1 => "Lunes",
        2 => "Martes",
        3 => "Miércoles",
        4 => "Jueves",
        5 => "Viernes",
        6 => "Sábado",
        _ => "—"
    };

    string FormatSchedule(int? wd, TimeSpan? start, TimeSpan? end)
    {
        var day = WeekdayName(wd);
        var s = start.HasValue ? start.Value.ToString(@"hh\:mm") : "";
        var e = end.HasValue ? end.Value.ToString(@"hh\:mm") : "";
        if (string.IsNullOrEmpty(s) && string.IsNullOrEmpty(e)) return "Sin horario definido";
        if (string.IsNullOrEmpty(e)) return $"{day} · {s}";
        if (string.IsNullOrEmpty(s)) return $"{day} · fin {e}";
        return $"{day} · {s} – {e}";
    }
}

<div class="row justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col-md-7 col-lg-6 col-xl-5">
        <div class="card shadow-lg border-0 rounded-lg">
            <div class="card-body p-5 text-center">

                <!-- Animated Icon -->
                <div class="mb-4 d-inline-block position-relative">
                    <div class="icon-circle bg-soft-danger text-danger d-flex align-items-center justify-content-center rounded-circle mx-auto"
                         style="width: 80px; height: 80px;">
                        <i class="fas fa-exclamation-triangle fa-3x"></i>
                    </div>
                    <div class="position-absolute w-100 h-100 rounded-circle bg-danger opacity-1"
                         style="top:0; left:0; animation: ping 2s cubic-bezier(0, 0, 0.2, 1) infinite; z-index: -1;">
                    </div>
                </div>

                <h3 class="font-weight-bold text-dark mb-2">¿Eliminar este grupo?</h3>
                <p class="text-muted mb-4 opacity-7">
                    Se eliminará el grupo <span class="font-weight-bold text-dark">@Model.Group.Name</span> definitivamente.
                    Las planificaciones que lo usan conservan la materia y el nombre del grupo.
                </p>

                <!-- Summary Card -->
                <div class="card bg-light border-0 mb-4 p-3 text-left shadow-none">
                    <div class="d-flex align-items-start mb-3">
                        <div class="mr-3 mt-1 text-muted">
                            <i class="fas fa-users-class fa-lg"></i>
                        </div>
                        <div>
                            <small class="text-uppercase text-muted font-weight-bold d-block" style="font-size: 0.7rem;">Grupo</small>
                            <h6 class="font-weight-bold text-dark mb-0">@Model.Group.Name</h6>
                            <small class="text-muted">Cód: @(string.IsNullOrWhiteSpace(Model.Group.Code) ? "—" : Model.Group.Code)</small>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center border-top pt-2">
                        <div>
                            <small class="text-uppercase text-muted font-weight-bold d-block mb-1" style="font-size: 0.7rem;">Materia · Gestión</small>
                            <span class="text-dark font-weight-bold small d-block">@Model.SubjectName</span>
                            <span class="text-muted small">@Model.ManagementCode</span>
                        </div>
                        <div class="text-right">
                            <small class="text-uppercase text-muted font-weight-bold d-block mb-1" style="font-size: 0.7rem;">Estado Actual</small>
                            <span class="badge badge-pill @(Model.Group.Status == GeneralStatus.Activo ? "badge-success" : "badge-danger") text-white border-0 px-3 font-weight-bold">
                                @Model.Group.Status
                            </span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center border-top pt-2 mt-2">
                        <div>
                            <small class="text-uppercase text-muted font-weight-bold d-block mb-1" style="font-size: 0.7rem;">Docente · Horario</small>
                            <span class="text-dark font-weight-bold small d-block">@Model.TeacherName</span>
                            <span class="text-muted small">@(Model.ScheduleSummary ?? FormatSchedule(Model.Group.Weekday, Model.Group.StartTime, Model.Group.EndTime))</span>
                        </div>
                        <div class="text-right">
                            <small class="text-uppercase text-muted font-weight-bold d-block mb-1" style="font-size: 0.7rem;">Laboratorio</small>
                            <span class="text-dark font-weight-bold small">@Model.LaboratoryName</span>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <form method="post" class="d-flex justify-content-center" id="deleteGroupForm">
                    <input type="hidden" asp-for="Group.Id" />

                    <a asp-page="./Index" asp-route-ManagementFilter="@Model.Group.ManagementId" class="btn btn-outline-secondary btn-rounded font-weight-bold px-4 mr-2 py-2">
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-danger btn-rounded font-weight-bold px-4 shadow-sm py-2">
                        <i class="fas fa-trash-alt mr-2"></i>Sí, Eliminar Grupo
                    </button>
                </form>

                <div class="mt-4">
                    <a asp-page="./Index" asp-route-ManagementFilter="@Model.Group.ManagementId" class="btn btn-link text-muted small">Volver a Grupos de la gestión</a>
                </div>

                <div class="mt-3 text-muted small font-italic opacity-7">
                    <i class="fas fa-info-circle mr-1"></i>
                    <strong>Nota:</strong> La eliminación es definitiva. Las planificaciones que usan el grupo conservan la materia y el nombre del grupo.
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .bg-soft-danger {
            background-color: #ffebee;
        }
        .icon-circle { transition: transform 0.3s ease; }
        .icon-circle:hover { transform: scale(1.1); }
        .opacity-1 { opacity: 0.15; }
        .opacity-7 { opacity: 0.7; }
        .btn-rounded { border-radius: 50px; }
        @@keyframes ping {
            75%, 100% {
                transform: scale(1.5);
                opacity: 0;
            }
        }
    </style>
}

@section Scripts {
    <script>
        $(function () {
            var $deleteForm = $('#deleteGroupForm');
            $deleteForm.on('submit', function (e) {
                e.preventDefault();
                var form = this;
                if (typeof Swal === 'undefined') {
                    HTMLFormElement.prototype.submit.call(form);
                    return;
                }
                Swal.fire({
                    title: '¿Eliminar este grupo?',
                    text: 'Se eliminará el grupo definitivamente. Las planificaciones que lo usan conservan la materia y el nombre del grupo.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, Eliminar Grupo',
                    cancelButtonText: 'Cancelar',
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d'
                }).then(function (result) {
                    if (result && (result.isConfirmed === true || result.value === true)) {
                        HTMLFormElement.prototype.submit.call(form);
                    }
                });
            });
        });
    </script>
}