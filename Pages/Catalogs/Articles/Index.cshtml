@page
@model Proyecto_Laboratorios_Univalle.Pages.Catalogs.Articles.IndexModel
@using Proyecto_Laboratorios_Univalle.Models.Enums
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    var hasActiveFilters = !string.IsNullOrWhiteSpace(Model.SearchTerm)
                           || Model.StatusFilter.HasValue
                           || Model.ArticleCategoryId.HasValue
                           || Model.ReviewStatusFilter.HasValue;
}

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <!-- Header section -->
                <div class="d-md-flex align-items-center mb-4 pb-3 border-bottom">
                    <div>
                        <h3 class="card-title text-dark font-weight-bold mt-2 ml-2">
                            <i class="fas fa-boxes mr-2 text-info"></i>Catálogo de Artículos
                        </h3>
                        <h6 class="card-subtitle text-muted ml-2">Maestro de artículos consumibles, utensilios y equipos no patrimoniales del entorno institucional.</h6>
                    </div>
                    <div class="ml-auto mt-3 mt-md-0">
                        <a asp-page="Create" class="btn bg-white border btn-rounded shadow-sm text-dark px-4 font-weight-bold">
                            <i class="fas fa-plus-circle mr-1 text-info"></i> Nuevo Artículo
                        </a>
                    </div>
                </div>

                <!-- 🔍 Smart Index Zone -->
                <div class="bg-light p-3 mb-4 rounded border-left border-info">
                    <form method="get" data-live-filter-form>
                        <label asp-for="SearchTerm" class="sr-only">Buscar artículo</label>
                        <div class="input-group mb-3">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-white border-right-0"><i class="fas fa-search text-muted"></i></span>
                            </div>
                            <input type="search" asp-for="SearchTerm"
                                   class="form-control border-left-0 @(!string.IsNullOrWhiteSpace(Model.SearchTerm) ? "border-info" : "")"
                                   placeholder="Buscar por código o nombre"
                                   autocomplete="off"
                                   data-live-filter-search />
                        </div>

                        <div class="d-flex flex-wrap align-items-center border-top pt-3">
                            <select asp-for="ArticleCategoryId"
                                    class="custom-select btn-rounded w-auto mw-100 mr-2 mb-2 @(Model.ArticleCategoryId.HasValue ? "border-info text-info font-weight-bold" : "")"
                                    asp-items="@(new SelectList(Model.CategoryOptions, "Value", "Text", Model.ArticleCategoryId))"
                                    data-live-filter-control>
                                <option value="">Categoría</option>
                            </select>

                            <select asp-for="ReviewStatusFilter"
                                    class="custom-select btn-rounded w-auto mw-100 mr-2 mb-2 @(Model.ReviewStatusFilter.HasValue ? "border-info text-info font-weight-bold" : "")"
                                    data-live-filter-control>
                                <option value="">Revisión (Todos)</option>
                                @foreach (var item in (IEnumerable<SelectListItem>)(
                                    new[] {
                                        new SelectListItem { Value = ((int)DataReviewStatus.Confirmed).ToString(), Text = "Confirmado" },
                                        new SelectListItem { Value = ((int)DataReviewStatus.PorConfirmar).ToString(), Text = "Por confirmar" }
                                    }))
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>

                            <select asp-for="StatusFilter"
                                    class="custom-select btn-rounded w-auto mw-100 mr-2 mb-2 @(Model.StatusFilter.HasValue ? "border-info text-info font-weight-bold" : "")"
                                    asp-items="@Proyecto_Laboratorios_Univalle.Helpers.EnumHelper.GetStatusSelectList<GeneralStatus>()"
                                    aria-label="Estado"
                                    data-live-filter-control>
                                <option value="">Estado</option>
                            </select>

                            @if (hasActiveFilters)
                            {
                                <a asp-page="./Index" class="btn btn-link btn-sm text-muted mb-2" title="Limpiar filtros">
                                    <i class="fas fa-times mr-1"></i> Limpiar filtros
                                </a>
                            }

                            <span class="small text-muted ml-auto mb-2" aria-live="polite">
                                <strong class="text-dark">@Model.Articles.TotalCount</strong> artículo(s)
                                @if (Model.PendingReviewCount > 0)
                                {
                                    <span class="badge badge-pill badge-soft-warning text-warning ml-2 px-3 py-1 font-weight-bold"
                                          title="Artículos aún no confirmados en la fuente del cliente">
                                        <i class="fas fa-exclamation-circle mr-1"></i>@Model.PendingReviewCount por confirmar
                                    </span>
                                }
                            </span>
                        </div>
                    </form>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover v-middle">
                        <thead class="bg-light">
                            <tr class="small uppercase font-weight-bold text-muted">
                                <th>Artículo</th>
                                <th>Categoría / Unidad</th>
                                <th class="text-center">Revisión</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Articles == null || !Model.Articles.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-muted italic">
                                        <i class="fas fa-box-open fa-3x mb-3 d-block opacity-2"></i>
                                        No se encontraron artículos registrados con los filtros actuales.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model.Articles)
                                {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="m-r-10">
                                                <span class="btn btn-circle btn-info text-white shadow-sm font-weight-bold"><i class="fas fa-box"></i></span>
                                            </div>
                                            <div>
                                                <h6 class="m-b-0 font-weight-bold text-dark">@item.Name</h6>
                                                <span class="text-muted small">Cód: @(item.Code ?? "No asignado")</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small">
                                            <div class="font-weight-bold text-dark"><i class="fas fa-tag mr-1 text-muted"></i>@(item.ArticleCategory?.Name ?? item.Category ?? "Sin categoría")</div>
                                            <div class="text-muted"><i class="fas fa-ruler mr-1"></i>@(item.MeasurementUnit?.Name ?? item.UnitOfMeasure)</div>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        @if (item.ReviewStatus == DataReviewStatus.PorConfirmar)
                                        {
                                            <span class="badge badge-pill badge-soft-warning text-warning px-3 py-1 font-weight-bold"
                                                  title="Dato pendiente de confirmación en la fuente del cliente">
                                                <i class="fas fa-exclamation-circle mr-1"></i>Por confirmar
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-pill badge-soft-success text-success px-3 py-1 font-weight-bold"
                                                  title="Dato confirmado en la fuente del cliente">
                                                <i class="fas fa-check-circle mr-1"></i>Confirmado
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge badge-pill @(item.Status == GeneralStatus.Activo ? "badge-success" : (item.Status == GeneralStatus.Inactivo ? "badge-secondary" : "badge-danger")) px-3 py-1 font-weight-bold">@item.Status</span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group">
                                            <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning btn-rounded shadow-none" title="Editar">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger btn-rounded mx-1 shadow-none" title="Eliminar">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.Articles!.TotalPages > 1)
                {
                    <nav aria-label="Paginación">
                        <ul class="pagination justify-content-center">
                            @if (Model.Articles.HasPreviousPage)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-page="./Index"
                                       asp-route-pageIndex="@(Model.Articles.PageIndex - 1)"
                                       asp-route-SearchTerm="@Model.SearchTerm"
                                       asp-route-StatusFilter="@Model.StatusFilter"
                                       asp-route-ArticleCategoryId="@Model.ArticleCategoryId"
                                       asp-route-ReviewStatusFilter="@Model.ReviewStatusFilter">Anterior</a>
                                </li>
                            }
                            @for (var i = 1; i <= Model.Articles.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.Articles.PageIndex ? "active" : "")">
                                    <a class="page-link" asp-page="./Index"
                                       asp-route-pageIndex="@i"
                                       asp-route-SearchTerm="@Model.SearchTerm"
                                       asp-route-StatusFilter="@Model.StatusFilter"
                                       asp-route-ArticleCategoryId="@Model.ArticleCategoryId"
                                       asp-route-ReviewStatusFilter="@Model.ReviewStatusFilter">@i</a>
                                </li>
                            }
                            @if (Model.Articles.HasNextPage)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-page="./Index"
                                       asp-route-pageIndex="@(Model.Articles.PageIndex + 1)"
                                       asp-route-SearchTerm="@Model.SearchTerm"
                                       asp-route-StatusFilter="@Model.StatusFilter"
                                       asp-route-ArticleCategoryId="@Model.ArticleCategoryId"
                                       asp-route-ReviewStatusFilter="@Model.ReviewStatusFilter">Siguiente</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .v-middle td { vertical-align: middle !important; }
        .uppercase { text-transform: uppercase; letter-spacing: 1px; }
        .italic { font-style: italic; }
        .opacity-2 { opacity: 0.2; }
        .badge-soft-warning { background-color: #fff3cd; }
        .badge-soft-success { background-color: #d4edda; }
    </style>
}
@section Scripts {
    <script>
        $(function () {
            "use strict";
            $('[data-toggle="tooltip"]').tooltip();
        });
    </script>
}