@page
@model Proyecto_Laboratorios_Univalle.Pages.Catalogs.Articles.CreateModel

<div class="row justify-content-center">
    <div class="col-lg-11 col-xl-10">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <!-- Header -->
                <div class="d-flex no-block align-items-center mb-4 pb-3 border-bottom">
                    <div>
                        <h4 class="card-title text-dark font-weight-bold">
                            <i class="fas fa-boxes mr-2 text-info"></i>Alta de Artículo
                        </h4>
                        <h6 class="card-subtitle text-muted">Registre un nuevo artículo (consumible, utensilio o equipo) en el catálogo institucional.</h6>
                    </div>
                    <div class="ml-auto mt-2 mt-md-0">
                        <i class="fas fa-box fa-2x text-info opacity-5"></i>
                    </div>
                </div>

                <form method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm border-0 small" role="alert"></div>

                    <div class="row">
                        <!-- Identidad -->
                        <div class="col-md-6 border-right">
                            <h5 class="font-weight-bold text-info mb-3">
                                <i class="fas fa-id-card mr-2"></i> Identidad del Artículo
                            </h5>

                            <div class="form-group mb-4">
                                <label asp-for="Input.Code" class="control-label font-weight-bold small uppercase text-muted">Código Único <span class="text-danger">*</span></label>
                                <input asp-for="Input.Code" class="form-control" placeholder="Ej: ART-001" required maxlength="30" />
                                <span asp-validation-for="Input.Code" class="text-danger small font-weight-bold"></span>
                            </div>

                            <div class="form-group mb-4">
                                <label asp-for="Input.Name" class="control-label font-weight-bold small uppercase text-muted">Nombre del Artículo <span class="text-danger">*</span></label>
                                <input asp-for="Input.Name" class="form-control" placeholder="Ej: Pipeta volumétrica 25 ml" required maxlength="200" />
                                <span asp-validation-for="Input.Name" class="text-danger small font-weight-bold"></span>
                            </div>

                            <div class="form-group mb-4">
                                <label asp-for="Input.ArticleType" class="control-label font-weight-bold small uppercase text-muted">Tipo <span class="text-danger">*</span></label>
                                <select asp-for="Input.ArticleType" class="form-control custom-select" required>
                                    <option value="">-- Seleccione tipo --</option>
                                    @foreach (var t in Model.ArticleTypeOptions)
                                    {
                                        <option value="@t.Value">@t.Text</option>
                                    }
                                </select>
                                <span asp-validation-for="Input.ArticleType" class="text-danger small font-weight-bold"></span>
                            </div>
                        </div>

                        <!-- Clasificación -->
                        <div class="col-md-6">
                            <h5 class="font-weight-bold text-info mb-3">
                                <i class="fas fa-sitemap mr-2"></i> Clasificación
                            </h5>

                            <div class="form-group mb-4">
                                <label asp-for="Input.ArticleCategoryId" class="control-label font-weight-bold small uppercase text-muted">Categoría <span class="text-danger">*</span></label>
                                <select asp-for="Input.ArticleCategoryId" class="form-control custom-select select2" required>
                                    <option value="">-- Seleccione categoría --</option>
                                    @foreach (var c in Model.CategoryOptions)
                                    {
                                        <option value="@c.Value">@c.Text</option>
                                    }
                                </select>
                                <span asp-validation-for="Input.ArticleCategoryId" class="text-danger small font-weight-bold"></span>
                                <small class="text-muted italic">Categorías inactivas o eliminadas no se listan.</small>
                            </div>

                            <div class="form-group mb-4">
                                <label asp-for="Input.MeasurementUnitId" class="control-label font-weight-bold small uppercase text-muted">Unidad de Medida <span class="text-danger">*</span></label>
                                <select asp-for="Input.MeasurementUnitId" class="form-control custom-select select2" required>
                                    <option value="">-- Seleccione unidad --</option>
                                    @foreach (var u in Model.UnitOptions)
                                    {
                                        <option value="@u.Value">@u.Text</option>
                                    }
                                </select>
                                <span asp-validation-for="Input.MeasurementUnitId" class="text-danger small font-weight-bold"></span>
                                <small class="text-muted italic">Si elige una unidad, el campo legado <code>UnitOfMeasure</code> se sincroniza con su código.</small>
                            </div>

                            <div class="form-group mb-4" id="equipmentField" style="display:none;">
                                <label asp-for="Input.EquipmentId" class="control-label font-weight-bold small uppercase text-muted">Equipo de catálogo (opcional)</label>
                                <select asp-for="Input.EquipmentId" class="form-control custom-select select2" data-placeholder="-- Seleccione equipo --">
                                    <option value="">-- Sin equipo asociado --</option>
                                    @foreach (var e in Model.EquipmentOptions)
                                    {
                                        <option value="@e.Value">@e.Text</option>
                                    }
                                </select>
                                <span asp-validation-for="Input.EquipmentId" class="text-danger small font-weight-bold"></span>
                                <small class="text-muted italic">Sólo relevante cuando el tipo es <strong>Equipo</strong>.</small>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <div class="form-actions text-right mt-4">
                        <button type="submit" class="btn btn-info btn-rounded px-5 shadow-sm font-weight-bold py-2">
                            <i class="fas fa-save mr-1"></i> Registrar Artículo
                        </button>
                        <a asp-page="./Index" class="btn btn-outline-secondary btn-rounded ml-2 py-2 px-4 font-weight-bold">
                            Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="~/assets/libs/select2/dist/css/select2.min.css" rel="stylesheet">
    <script src="~/assets/libs/select2/dist/js/select2.full.min.js"></script>
    <script src="~/assets/extra-libs/jqbootstrapvalidation/validation.js"></script>
    <script>
        $(function () {
            "use strict";
            $("input,select,textarea").not("[type=submit]").jqBootstrapValidation();

            var alphanumericPattern = /^[a-zA-Z0-9áéíóúÁÉÍÓÚñÑ\s\-\.\(\)]*$/;
            function setupBlocking(selector, pattern) {
                $(selector).on('input', function () {
                    var $field = $(this);
                    var val = $field.val();
                    if (!pattern.test(val)) {
                        $field.val(val.replace(/[^a-zA-Z0-9áéíóúÁÉÍÓÚñÑ\s\-\.\(\)]/g, ''));
                    }
                });
            }
            setupBlocking('#Input_Code', alphanumericPattern);
            setupBlocking('#Input_Name', alphanumericPattern);

            // Select2
            $('.select2').select2({ width: '100%', allowClear: true, placeholder: '-- Seleccione --' });

            // Mostrar/ocultar Equipo según tipo seleccionado
            function toggleEquipment() {
                var val = parseInt($('#Input_ArticleType').val(), 10);
                if (val === 1) {
                    $('#equipmentField').slideDown(150);
                } else {
                    $('#equipmentField').slideUp(150);
                    $('#Input_EquipmentId').val(null).trigger('change');
                }
            }
            $('#Input_ArticleType').on('change', toggleEquipment);
            toggleEquipment();
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@section Styles {
    <style>
        .help-block ul { list-style: none; padding-left: 0; }
        .uppercase { text-transform: uppercase; letter-spacing: 1px; }
        .italic { font-style: italic; }
    </style>
}