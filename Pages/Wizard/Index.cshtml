@page
@model Proyecto_Laboratorios_Univalle.Pages.Wizard.IndexModel
@using Proyecto_Laboratorios_Univalle.Models.Enums
@{
    ViewData["Title"] = "Asistente de Gestión";
    var steps = new[] { "Progreso", "L6 Verificación", "L7 Solicitud", "L8 Mantenimiento", "L3 Salida", "Kardex", "Desembolso" };
}

@section Styles {
    <link rel="stylesheet" href="~/css/tailwind-dashboard.css" asp-append-version="true" />
    <style>
        .tailwind-scope { text-align: left; }
        .step-active { background-color: #28A745; border-color: #28A745; color: white; }
        .step-inactive { background-color: white; border-color: #e2e8f0; color: #94a3b8; }
        .wizard-card { border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px; margin-bottom: 12px; display: flex; justify-content: space-between; align-items: center; background: white; }
        .btn-status-gray { background-color: #f1f5f9; color: #64748b; font-size: 11px; font-weight: bold; padding: 6px 12px; border-radius: 8px; border: 1px solid #e2e8f0; }
        .btn-verify-outline { background-color: white; color: #64748b; font-size: 11px; font-weight: bold; padding: 6px 12px; border-radius: 8px; border: 1px solid #e2e8f0; text-decoration: none !important; transition: all 0.2s; }
        .wizard-header-dark { background-color: #1e293b; border-radius: 12px 12px 0 0; padding: 16px 24px; color: white; display: flex; justify-content: space-between; align-items: center; }
        .btn-blue-next { background-color: #3b82f6; color: white; padding: 10px 24px; border-radius: 10px; font-weight: bold; display: flex; align-items: center; gap: 8px; border: none; }
        .btn-red-finish { background-color: #ef4444; color: white; padding: 10px 24px; border-radius: 10px; font-weight: bold; display: flex; align-items: center; gap: 8px; border: none; }
    </style>
}

<div class="tailwind-scope max-w-[1200px] mx-auto mt-6 mb-12 animate-in fade-in zoom-in-95 duration-500">
    @if (Model.ActiveManagement == null)
    {
        <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-4 rounded shadow-sm">
            <h3 class="text-red-700 font-bold m-0"><i class="fas fa-exclamation-triangle mr-2"></i> No hay Gestión Activa</h3>
            <p class="text-red-600 m-0 mt-2">Para utilizar el Wizard debe existir una Gestión (Ronda de Mantenimiento) iniciada. Dirígete a <a asp-page="/Managements/Index" class="font-bold underline text-red-800">Gestiones</a> para crear una nueva.</p>
        </div>
    }
    else
    {
        <div class="wizard-header-dark shadow-lg">
            <h2 class="text-xl font-bold m-0"><i class="fas fa-magic text-[#28A745] mr-2"></i>Ronda de Mantenimiento: @Model.ActiveManagement.Code</h2>
            <a asp-page="/Index" class="text-white opacity-70 hover:opacity-100 font-bold text-decoration-none">Cancelar</a>
        </div>

        <!-- Stepper -->
        <div class="bg-white border-x p-8 flex justify-between relative shadow-sm">
            <div class="absolute left-[10%] top-[3rem] w-[80%] h-0.5 bg-gray-100 -z-0"></div>
            @for (int i = 0; i < steps.Length; i++)
            {
                int stepNum = i;
                <div class="flex flex-col items-center gap-2 z-10 w-32">
                    <div class="w-12 h-12 rounded-full flex items-center justify-center font-bold border-4 @(Model.Step >= stepNum ? "step-active" : "step-inactive")">
                        @if (Model.Step > stepNum)
                        {
                            <i class="fas fa-check"></i>
                        }
                        else
                        {
                            <span>@stepNum</span>
                        }
                    </div>
                    <span class="text-[10px] font-bold uppercase text-center @(Model.Step == stepNum ? "text-slate-900" : "text-slate-400")">@steps[i]</span>
                </div>
            }
        </div>

        <div class="bg-white border-x border-b p-0 rounded-b-2xl shadow-xl min-h-[500px]">
            
            @if (Model.Step == 0)
            {
                <div class="p-8">
                    <div class="flex justify-between items-center mb-6">
                        <div>
                            <h3 class="text-xl font-bold text-slate-800">Paso 0: Progreso de Ambiente</h3>
                            <p class="text-sm text-slate-500">Visualiza el estado global de todos los equipos del laboratorio.</p>
                        </div>
                        <form method="get" class="flex items-center gap-3">
                            <input type="hidden" name="Step" value="0" />
                            <label class="text-xs font-bold text-slate-600 uppercase">Laboratorio / Ambiente:</label>
                            <select name="SelectedLabId" asp-items="Model.LaboratoriesList" class="border rounded-lg p-2 text-sm bg-slate-50 w-64 outline-blue-400 shadow-sm" onchange="this.form.submit()">
                                <option value="">-- Selecciona un laboratorio --</option>
                            </select>
                        </form>
                    </div>

                    @if (!Model.SelectedLabId.HasValue)
                    {
                        <div class="border-2 border-dashed border-slate-200 rounded-2xl p-16 text-center text-slate-400 italic bg-slate-50">
                            Selecciona un laboratorio para ver el progreso de sus equipos.
                        </div>
                    }
                    else
                    {
                        <div class="overflow-hidden rounded-xl border border-slate-200">
                            <table class="w-full text-left text-sm">
                                <thead class="bg-slate-50 text-slate-500 uppercase font-bold text-[10px] tracking-wider border-b">
                                    <tr>
                                        <th class="px-6 py-4 font-bold">Identificación</th>
                                        <th class="px-6 py-4 font-bold">Equipo</th>
                                        <th class="px-6 py-4 font-bold">Fase Actual</th>
                                        <th class="px-6 py-4 font-bold">Estado</th>
                                        <th class="px-6 py-4 font-bold text-right">Acción</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    @foreach (var item in Model.ActivePlans)
                                    {
                                        <tr class="hover:bg-slate-50/50">
                                            <td class="px-6 py-4">
                                                <span class="bg-slate-100 text-slate-600 px-2 py-1 rounded font-bold text-[10px]">@item.EquipmentUnit?.InventoryNumber</span>
                                            </td>
                                            <td class="px-6 py-4 font-semibold text-slate-800">@item.EquipmentUnit?.Equipment?.Name</td>
                                            <td class="px-6 py-4">
                                                @{
                                                    var phaseText = item.CurrentPhase switch {
                                                        WizardPhase.Verification => "L6 Verificación",
                                                        WizardPhase.TechnicalRequest => "L7 Solicitud",
                                                        WizardPhase.Maintenance => "L8 Mantenimiento",
                                                        WizardPhase.Exit => "L3 Salida",
                                                        WizardPhase.Kardex => "Kardex",
                                                        WizardPhase.Disbursement => "Desembolso",
                                                        _ => item.CurrentPhase.ToString()
                                                    };
                                                    var phaseColor = item.CurrentPhase switch {
                                                        WizardPhase.Verification => "bg-blue-100 text-blue-700",
                                                        WizardPhase.TechnicalRequest => "bg-amber-100 text-amber-700",
                                                        WizardPhase.Maintenance => "bg-orange-100 text-orange-700",
                                                        WizardPhase.Exit => "bg-purple-100 text-purple-700",
                                                        _ => "bg-green-100 text-green-700"
                                                    };
                                                }
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold @phaseColor border uppercase">
                                                    @phaseText
                                                </span>
                                            </td>
                                            <td class="px-6 py-4">
                                                <span class="text-xs text-slate-500 font-medium">@item.CurrentState</span>
                                            </td>
                                            <td class="px-6 py-4 text-right">
                                                <a href="?Step=@((int)item.CurrentPhase)&SelectedLabId=@Model.SelectedLabId" class="text-blue-600 hover:text-blue-800 font-bold text-xs">
                                                    Atender <i class="fas fa-chevron-right ml-1"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <div class="flex justify-end mt-8 pt-6 border-t border-slate-50">
                        <form method="post" asp-page-handler="NextStep">
                            <input type="hidden" asp-for="Step" />
                            <input type="hidden" asp-for="SelectedLabId" />
                            <button type="submit" class="btn-blue-next">
                                Iniciar Ronda (Verificación L6) <i class="fas fa-arrow-right"></i>
                            </button>
                        </form>
                    </div>
                </div>
            }
            else if (Model.Step == 1)
            {
                <div class="p-8">
                    <div class="flex justify-between items-center mb-6">
                        <div>
                            <h3 class="text-xl font-bold text-slate-800">Paso 1: L6 Verificación</h3>
                            <p class="text-sm text-slate-500">Selecciona un ambiente para verificar sus equipos.</p>
                        </div>
                        <form method="get" class="flex items-center gap-3">
                            <input type="hidden" name="Step" value="1" />
                            <label class="text-xs font-bold text-slate-600 uppercase">Laboratorio / Ambiente:</label>
                            <select name="SelectedLabId" asp-items="Model.LaboratoriesList" class="border rounded-lg p-2 text-sm bg-slate-50 w-64 outline-blue-400 shadow-sm" onchange="this.form.submit()">
                                <option value="">-- Selecciona un laboratorio --</option>
                            </select>
                        </form>
                    </div>

                    <div class="space-y-3 min-h-[250px]">
                        @{
                            var step1Equipments = Model.ActivePlans.Where(e => e.CurrentPhase == WizardPhase.Verification).ToList();
                        }
                        @if (!Model.SelectedLabId.HasValue)
                        {
                            <div class="border-2 border-dashed border-slate-200 rounded-2xl p-16 text-center text-slate-400 italic bg-slate-50">
                                <i class="fas fa-flask text-4xl mb-4 opacity-20"></i><br>
                                Selecciona un laboratorio para ver sus equipos pendientes de L-6.
                            </div>
                        }
                        else if (!step1Equipments.Any())
                        {
                            <div class="border-2 border-dashed border-slate-200 rounded-2xl p-16 text-center text-slate-400 italic bg-slate-50">
                                <i class="fas fa-check-circle text-4xl mb-4 text-green-300"></i><br>
                                No hay equipos pendientes de verificación (L-6) en este laboratorio.
                            </div>
                        }
                        else
                        {
                            foreach (var item in step1Equipments)
                            {
                                <div class="wizard-card shadow-sm">
                                    <div>
                                        <h4 class="font-bold text-slate-800 m-0">@(item.EquipmentUnit?.Equipment?.Name ?? "Equipo Sin Nombre") <span class="text-[10px] bg-slate-100 text-slate-500 px-2 py-0.5 rounded ml-2 border border-slate-200">@(item.EquipmentUnit?.InventoryNumber)</span></h4>
                                        <p class="text-xs text-slate-400 mt-1 m-0">Equipamiento General</p>
                                    </div>
                                    <div class="flex gap-2 items-center">
                                        <span class="btn-status-gray border-0">@item.CurrentState</span>
                                        <!-- BOTÓN REAL HACIA LLENADO DE L6 -->
                                        <a asp-page="/Verifications/Create" asp-route-equipmentUnitId="@item.EquipmentUnitId" asp-route-managementPlanId="@item.Id" asp-route-isWizard="true" class="btn-verify-outline hover:border-blue-500 hover:text-blue-600">
                                            Llenar CheckList
                                        </a>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <div class="flex justify-end mt-8 pt-6 border-t border-slate-50">
                        <form method="post" asp-page-handler="NextStep">
                            <input type="hidden" asp-for="Step" />
                            <input type="hidden" asp-for="SelectedLabId" />
                            <button type="submit" class="btn-blue-next">
                                Avanzar a L7 Solicitud <i class="fas fa-arrow-right"></i>
                            </button>
                        </form>
                    </div>
                </div>
            }
            else if (Model.Step == 2)
            {
                <div class="p-8">
                    <div class="flex justify-between items-center mb-6">
                        <div>
                            <h3 class="text-xl font-bold text-slate-800">Paso 2: L7 Solicitud</h3>
                            <p class="text-sm text-slate-500">Genera la solicitud para los equipos con desperfectos detectados en el paso anterior.</p>
                        </div>
                    </div>

                    <div class="space-y-3 min-h-[250px]">
                        @{
                            var step2Equipments = Model.ActivePlans.Where(e => e.CurrentPhase == WizardPhase.TechnicalRequest).ToList();
                        }
                        
                        @if (!step2Equipments.Any())
                        {
                            <div class="border-2 border-dashed border-slate-200 rounded-2xl p-16 text-center text-slate-400 italic bg-slate-50">
                                No se encontraron equipos pendientes de Solicitud (L-7) para este laboratorio en este momento.
                            </div>
                        }
                        else
                        {
                            foreach (var item in step2Equipments)
                            {
                                int fails = Model.CountVerificationFails(item.Verification);
                                <div class="wizard-card shadow-sm border-l-4 border-l-red-400">
                                    <div>
                                        <h4 class="font-bold text-slate-800 m-0">@(item.EquipmentUnit?.Equipment?.Name) <span class="text-[10px] bg-slate-100 text-slate-500 px-2 py-0.5 rounded border">@(item.EquipmentUnit?.InventoryNumber)</span></h4>
                                        <p class="text-xs text-red-500 mt-1 m-0 font-bold">
                                            <i class="fas fa-exclamation-circle"></i> @fails Falla(s) detectada(s) en L-6
                                        </p>
                                    </div>
                                    <div class="flex gap-2 items-center">
                                        <span class="btn-status-gray border-0">@item.CurrentState</span>
                                        <!-- BOTÓN HACIA LA SOLICITUD -->
                                        <a asp-page="/Requests/Create" asp-route-equipmentUnitId="@item.EquipmentUnitId" asp-route-managementPlanId="@item.Id" asp-route-isWizard="true" class="btn-verify-outline border-blue-200 text-blue-600 hover:bg-blue-50">
                                            Hacer Solicitud (L-7)
                                        </a>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <div class="flex justify-between mt-8 pt-6 border-t border-slate-50">
                        <form method="post" asp-page-handler="PreviousStep">
                            <input type="hidden" asp-for="Step" />
                            <input type="hidden" asp-for="SelectedLabId" />
                            <button type="submit" class="border border-slate-200 text-slate-600 px-8 py-3 rounded-xl font-bold flex items-center gap-2 hover:bg-slate-50">
                                <i class="fas fa-arrow-left"></i> Volver a L6
                            </button>
                        </form>
                        <form method="post" asp-page-handler="NextStep">
                            <input type="hidden" asp-for="Step" />
                            <input type="hidden" asp-for="SelectedLabId" />
                            <button type="submit" class="btn-blue-next">
                                Avanzar a L8 Mantenimiento <i class="fas fa-arrow-right"></i>
                            </button>
                        </form>
                    </div>
                </div>
            }
            else if (Model.Step == 3)
            {
                <div class="p-8">
                    <div class="flex justify-between items-center mb-6">
                        <div>
                            <h3 class="text-xl font-bold text-slate-800">Paso 3: L8 Mantenimiento</h3>
                            <p class="text-sm text-slate-500">Registra el mantenimiento para los equipos con solicitud aprobada.</p>
                        </div>
                    </div>

                    <div class="space-y-3 min-h-[250px]">
                        @{
                            var step3Equipments = Model.ActivePlans.Where(e => e.CurrentPhase == WizardPhase.Maintenance).ToList();
                        }
                        @if (!step3Equipments.Any())
                        {
                            <div class="border-2 border-dashed border-slate-200 rounded-2xl p-16 text-center text-slate-400 italic bg-slate-50">
                                <i class="fas fa-tools text-4xl mb-4 opacity-20"></i><br>
                                No hay equipos pendientes de Mantenimiento (L-8) en este momento.
                            </div>
                        }
                        else
                        {
                            foreach (var item in step3Equipments)
                            {
                                <div class="wizard-card shadow-sm border-l-4" style="border-left-color: #f59e0b;">
                                    <div>
                                        <h4 class="font-bold text-slate-800 m-0">
                                            @(item.EquipmentUnit?.Equipment?.Name)
                                            <span class="text-[10px] bg-slate-100 text-slate-500 px-2 py-0.5 rounded border">@(item.EquipmentUnit?.InventoryNumber)</span>
                                        </h4>
                                        @if (item.RequestId.HasValue)
                                        {
                                            <p class="text-xs text-amber-600 mt-1 m-0 font-bold">
                                                <i class="fas fa-file-alt"></i> Solicitud #@item.RequestId aprobada
                                            </p>
                                        }
                                        else
                                        {
                                            <p class="text-xs text-green-600 mt-1 m-0 font-bold">
                                                <i class="fas fa-shield-check"></i> Verificado (Mantenimiento Preventivo)
                                            </p>
                                        }
                                    </div>
                                    <div class="flex gap-2 items-center">
                                        <span class="btn-status-gray border-0">@item.CurrentState</span>
                                        <a asp-page="/Maintenances/Create" asp-route-equipmentUnitId="@item.EquipmentUnitId" asp-route-managementPlanId="@item.Id" asp-route-isWizard="true" class="btn-verify-outline text-amber-600 border-amber-200 hover:bg-amber-50">
                                            Registrar L-8
                                        </a>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <div class="flex justify-between mt-8 pt-6 border-t border-slate-50">
                        <form method="post" asp-page-handler="PreviousStep">
                            <input type="hidden" asp-for="Step" />
                            <input type="hidden" asp-for="SelectedLabId" />
                            <button type="submit" class="border border-slate-200 text-slate-600 px-8 py-3 rounded-xl font-bold flex items-center gap-2 hover:bg-slate-50">
                                <i class="fas fa-arrow-left"></i> Volver a L7
                            </button>
                        </form>
                        <form method="post" asp-page-handler="NextStep">
                            <input type="hidden" asp-for="Step" />
                            <input type="hidden" asp-for="SelectedLabId" />
                            <button type="submit" class="btn-blue-next">
                                Avanzar a L3 Salida <i class="fas fa-arrow-right"></i>
                            </button>
                        </form>
                    </div>
                </div>
            }
            else if (Model.Step == 4)
            {
                <div class="p-8">
                    <div class="flex justify-between items-center mb-6">
                        <div>
                            <h3 class="text-xl font-bold text-slate-800">Paso 4: L3 Salida</h3>
                            <p class="text-sm text-slate-500">Registra la salida del equipo tras completar el mantenimiento.</p>
                        </div>
                    </div>

                    <div class="space-y-3 min-h-[250px]">
                        @{
                            var step4Equipments = Model.ActivePlans.Where(e => e.CurrentPhase == WizardPhase.Exit).ToList();
                        }
                        @if (!step4Equipments.Any())
                        {
                            <div class="border-2 border-dashed border-slate-200 rounded-2xl p-16 text-center text-slate-400 italic bg-slate-50">
                                <i class="fas fa-truck text-4xl mb-4 opacity-20"></i><br>
                                No hay equipos pendientes de registro de Salida (L-3).
                            </div>
                        }
                        else
                        {
                            foreach (var item in step4Equipments)
                            {
                                <div class="wizard-card shadow-sm border-l-4" style="border-left-color: #8b5cf6;">
                                    <div>
                                        <h4 class="font-bold text-slate-800 m-0">
                                            @(item.EquipmentUnit?.Equipment?.Name)
                                            <span class="text-[10px] bg-slate-100 text-slate-500 px-2 py-0.5 rounded border">@(item.EquipmentUnit?.InventoryNumber)</span>
                                        </h4>
                                        <p class="text-xs text-purple-500 mt-1 m-0 font-bold">
                                            <i class="fas fa-wrench"></i> Mantenimiento #@item.MaintenanceId completado
                                        </p>
                                    </div>
                                    <div class="flex gap-2 items-center">
                                        <span class="btn-status-gray border-0">@item.CurrentState</span>
                                        <a asp-page="/Departures/Create" asp-route-equipmentUnitId="@item.EquipmentUnitId" asp-route-managementPlanId="@item.Id" asp-route-isWizard="true" class="btn-verify-outline text-purple-600 border-purple-200 hover:bg-purple-50">
                                            Registrar Salida
                                        </a>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <div class="flex justify-between mt-8 pt-6 border-t border-slate-50">
                        <form method="post" asp-page-handler="PreviousStep">
                            <input type="hidden" asp-for="Step" />
                            <input type="hidden" asp-for="SelectedLabId" />
                            <button type="submit" class="border border-slate-200 text-slate-600 px-8 py-3 rounded-xl font-bold flex items-center gap-2 hover:bg-slate-50">
                                <i class="fas fa-arrow-left"></i> Volver a L8
                            </button>
                        </form>
                        <form method="post" asp-page-handler="NextStep">
                            <input type="hidden" asp-for="Step" />
                            <input type="hidden" asp-for="SelectedLabId" />
                            <button type="submit" class="btn-blue-next">
                                Avanzar a Kardex <i class="fas fa-arrow-right"></i>
                            </button>
                        </form>
                    </div>
                </div>
            }
            else if (Model.Step == 5)
            {
                <div class="p-8">
                    <div class="flex justify-between items-center mb-6">
                        <div>
                            <h3 class="text-xl font-bold text-slate-800">Paso 5: Kardex</h3>
                            <p class="text-sm text-slate-500">Registro del historial del mantenimiento en el Kardex del equipo.</p>
                        </div>
                    </div>

                    <div class="space-y-3 min-h-[250px]">
                        @{
                            var step5Equipments = Model.ActivePlans.Where(e => e.CurrentPhase == WizardPhase.Kardex).ToList();
                        }
                        @if (!step5Equipments.Any())
                        {
                            <div class="border-2 border-dashed border-green-100 rounded-2xl p-16 text-center text-green-500 italic bg-green-50">
                                <i class="fas fa-check-circle text-4xl mb-4"></i><br>
                                Todos los equipos han completado el Kardex.
                            </div>
                        }
                        else
                        {
                            foreach (var item in step5Equipments)
                            {
                                <div class="wizard-card shadow-sm border-l-4" style="border-left-color: #10b981;">
                                    <div>
                                        <h4 class="font-bold text-slate-800 m-0">
                                            @(item.EquipmentUnit?.Equipment?.Name)
                                            <span class="text-[10px] bg-slate-100 text-slate-500 px-2 py-0.5 rounded border">@(item.EquipmentUnit?.InventoryNumber)</span>
                                        </h4>
                                        <p class="text-xs text-green-600 mt-1 m-0">
                                            <i class="fas fa-history"></i> Mantenimiento listo para registrar en Kardex
                                        </p>
                                        @if (item.Maintenance != null)
                                        {
                                            <p class="text-[10px] text-slate-400 m-0">Tipo: @item.Maintenance?.Status | Costo: $@item.Maintenance?.ActualCost</p>
                                        }
                                    </div>
                                    <div class="flex gap-2 items-center">
                                        <!-- Kardex: Confirmar directamente sin redirigir a ningún lado -->
                                        <form method="post" asp-page-handler="ConfirmKardex">
                                            <input type="hidden" name="planId" value="@item.Id" />
                                            <button type="submit" class="btn-verify-outline text-green-700 border-green-300 hover:bg-green-50" style="font-size:11px;">
                                                <i class="fas fa-check"></i> Confirmar Kardex
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <div class="flex justify-between mt-8 pt-6 border-t border-slate-50">
                        <form method="post" asp-page-handler="PreviousStep">
                            <input type="hidden" asp-for="Step" />
                            <input type="hidden" asp-for="SelectedLabId" />
                            <button type="submit" class="border border-slate-200 text-slate-600 px-8 py-3 rounded-xl font-bold flex items-center gap-2 hover:bg-slate-50">
                                <i class="fas fa-arrow-left"></i> Volver a Salidas
                            </button>
                        </form>
                        <form method="post" asp-page-handler="NextStep">
                            <input type="hidden" asp-for="Step" />
                            <input type="hidden" asp-for="SelectedLabId" />
                            <button type="submit" class="btn-blue-next">
                                Avanzar a Desembolso <i class="fas fa-arrow-right"></i>
                            </button>
                        </form>
                    </div>
                </div>
            }
            else if (Model.Step == 6)
            {
                <div class="p-8">
                    <div class="flex justify-between items-center mb-6">
                        <div>
                            <h3 class="text-xl font-bold text-slate-800">Paso 6: Desembolso</h3>
                            <p class="text-sm text-slate-500">Gestiona la solicitud de adquisición de repuestos o equipos necesarios.</p>
                        </div>
                    </div>

                    <div class="space-y-3 min-h-[250px]">
                        @{
                            var step6Equipments = Model.ActivePlans.Where(e => e.CurrentPhase == WizardPhase.Disbursement).ToList();
                        }
                        @if (!step6Equipments.Any())
                        {
                            <div class="border-2 border-dashed border-blue-100 rounded-2xl p-16 text-center text-blue-500 italic bg-blue-50">
                                <i class="fas fa-dollar-sign text-4xl mb-4"></i><br>
                                No hay equipos con solicitudes de desembolso pendientes.
                            </div>
                        }
                        else
                        {
                            foreach (var item in step6Equipments)
                            {
                                <div class="wizard-card shadow-sm border-l-4" style="border-left-color: #3b82f6;">
                                    <div>
                                        <h4 class="font-bold text-slate-800 m-0">
                                            @(item.EquipmentUnit?.Equipment?.Name)
                                            <span class="text-[10px] bg-slate-100 text-slate-500 px-2 py-0.5 rounded border">@(item.EquipmentUnit?.InventoryNumber)</span>
                                        </h4>
                                        <p class="text-xs text-blue-500 mt-1 m-0 font-bold">
                                            <i class="fas fa-shopping-cart"></i> Requiere solicitud de adquisición
                                        </p>
                                    </div>
                                    <div class="flex gap-2 items-center">
                                        <a asp-page="/Acquisitions/Create" asp-route-managementPlanId="@item.Id" class="btn-verify-outline text-blue-600 border-blue-200 hover:bg-blue-50">
                                            <i class="fas fa-file-invoice-dollar"></i> Crear Solicitud
                                        </a>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <div class="flex justify-between mt-8 pt-6 border-t border-slate-50">
                        <form method="post" asp-page-handler="PreviousStep">
                            <input type="hidden" asp-for="Step" />
                            <input type="hidden" asp-for="SelectedLabId" />
                            <button type="submit" class="border border-slate-200 text-slate-600 px-8 py-3 rounded-xl font-bold flex items-center gap-2 hover:bg-slate-50">
                                <i class="fas fa-arrow-left"></i> Volver a Kardex
                            </button>
                        </form>
                        <form method="post" asp-page-handler="NextStep">
                            <input type="hidden" asp-for="Step" />
                            <button type="submit" class="btn-red-finish border-0 shadow-lg">
                                Finalizar Ronda <i class="fas fa-check-double ml-2"></i>
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>