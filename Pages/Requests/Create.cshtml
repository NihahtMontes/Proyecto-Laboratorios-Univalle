@page
@model Proyecto_Laboratorios_Univalle.Pages.Requests.CreateModel
@using Proyecto_Laboratorios_Univalle.Models.Enums

@{
    ViewData["Title"] = "Registrar Requerimiento Técnico (L-7)";
    bool isWizard = (bool)(ViewData["IsWizard"] ?? false);
}

<div class="row justify-content-center">
    <div class="col-lg-10 col-xl-9">
        
        @if (isWizard)
        {
            await Html.RenderPartialAsync("_WizardSteps", 2);
        }

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="d-flex no-block align-items-center mb-4">
                    <div>
                        <h4 class="card-title text-dark">Registrar Requerimiento Técnico (L-7)</h4>
                        <h6 class="card-subtitle text-muted">Apertura de ficha para mantenimiento o asistencia técnica de activos.</h6>
                    </div>
                    <div class="ml-auto">
                        <i class="fas fa-tools fa-2x text-info opacity-5"></i>
                    </div>
                </div>

                <form method="post" id="createRequestForm">
                    <!-- Mantiene el estado del Wizard -->
                    <input type="hidden" name="isWizard" value="@(ViewData["IsWizard"]?.ToString()?.ToLower() ?? "false")" />
                    <input type="hidden" asp-for="ManagementPlanId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm border-0 small"></div>
                    <input type="hidden" asp-for="Input.Type" value="Technical" />

                    <div class="row">
                        <div class="col-md-5 border-right">
                            <h5 class="font-weight-bold text-info mb-3">
                                <i class="fas fa-university mr-2"></i> Ubicación y Activo
                            </h5>

                            <div class="form-group mb-4">
                                <label asp-for="Input.FacultyId" class="control-label font-weight-bold small text-info text-uppercase">Facultad <span class="text-danger">*</span></label>
                                @if (isWizard)
                                {
                                    <select asp-for="Input.FacultyId" class="form-control select2" id="facultySelect" asp-items="ViewBag.FacultyId" disabled>
                                        <option value="">-- Seleccionar Facultad --</option>
                                    </select>
                                    <input type="hidden" asp-for="Input.FacultyId" />
                                }
                                else
                                {
                                    <select asp-for="Input.FacultyId" class="form-control select2" id="facultySelect" asp-items="ViewBag.FacultyId">
                                        <option value="">-- Seleccionar Facultad --</option>
                                    </select>
                                }
                            </div>

                            <div class="form-group mb-4 border-left border-info pl-3 bg-light p-2 rounded">
                                <label asp-for="Input.LaboratoryId" class="control-label font-weight-bold small text-info text-uppercase">Laboratorio <span class="text-danger">*</span></label>
                                @if (isWizard)
                                {
                                    <select asp-for="Input.LaboratoryId" class="form-control select2" id="laboratorySelect" asp-items="ViewBag.LaboratoryId" disabled>
                                        <option value="">-- Seleccione Facultad --</option>
                                    </select>
                                    <input type="hidden" asp-for="Input.LaboratoryId" />
                                }
                                else
                                {
                                    <select asp-for="Input.LaboratoryId" class="form-control select2" id="laboratorySelect" asp-items="ViewBag.LaboratoryId">
                                        <option value="">-- Seleccione Facultad --</option>
                                    </select>
                                }
                            </div>

                            <div class="form-group mb-4 border-left border-warning pl-3 bg-light p-2 rounded">
                                <label asp-for="Input.EquipmentUnitId" class="control-label font-weight-bold small text-warning text-uppercase">Unidad Física Afectada <span class="text-danger">*</span></label>
                                @if (isWizard)
                                {
                                    <select asp-for="Input.EquipmentUnitId" class="form-control select2" id="equipmentUnitSelect" asp-items="ViewBag.EquipmentUnitId" disabled>
                                        <option value="">-- Seleccione Laboratorio --</option>
                                    </select>
                                    <input type="hidden" asp-for="Input.EquipmentUnitId" />
                                }
                                else
                                {
                                    <select asp-for="Input.EquipmentUnitId" class="form-control select2" id="equipmentUnitSelect" asp-items="ViewBag.EquipmentUnitId">
                                        <option value="">-- Seleccione Laboratorio --</option>
                                    </select>
                                }
                            </div>

                            @if (isWizard && ViewData["LinkedVerificationId"] != null)
                            {
                                <div class="form-group mt-3 mb-4">
                                    <label class="control-label font-weight-bold small text-uppercase text-muted">Verificación Técnica Relacionada (L-6)</label>
                                    <div class="p-2 rounded" style="background:#f0fdf4; border: 1px solid #bbf7d0;">
                                        <div class="d-flex align-items-center">
                                            <div class="mr-3" style="color: #16a34a;"><i class="fas fa-clipboard-check fa-lg"></i></div>
                                            <div>
                                                <h6 class="m-0 font-weight-bold" style="color: #15803d;">Verificación L-6 Vinculada</h6>
                                                <span class="small" style="color: #16a34a;">ID: @ViewData["LinkedVerificationId"]</span>
                                            </div>
                                            <a href="/Verifications/Details?id=@ViewData["LinkedVerificationId"]" target="_blank" class="btn btn-sm btn-light rounded-pill font-weight-bold shadow-sm ml-auto" style="color: #16a34a; border: 1px solid #bbf7d0;">
                                                Ver Detalles <i class="fas fa-external-link-alt ml-1"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-outline-danger btn-rounded font-weight-bold shadow-sm ml-2" onclick="confirmRedoPhase(@Model.ManagementPlanId, 1, 'L-6 Verificación')">
                                                <i class="fas fa-undo"></i> Rehacer L-6
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }

                            <hr class="my-4" />
                            <h6 class="text-muted font-weight-bold text-uppercase mb-3"><i class="fas fa-sliders-h mr-2"></i> Parámetros Técnicos</h6>

                            <div class="form-group mb-3">
                                <label asp-for="Input.Priority" class="control-label font-weight-bold small uppercase text-muted">Grado de Prioridad <span class="text-danger">*</span></label>
                                <select asp-for="Input.Priority" class="form-control custom-select" asp-items="Html.GetEnumSelectList<RequestPriority>()"></select>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Input.EstimatedRepairTime" class="control-label font-weight-bold small uppercase text-muted">Tiempo Estimado</label>
                                <input asp-for="Input.EstimatedRepairTime" class="form-control" placeholder="Ej: 2 horas, 1 día..." />
                            </div>
                        </div>

                        <div class="col-md-7 pl-lg-4">
                            <h5 class="font-weight-bold text-info mb-3">
                                <i class="fas fa-align-left mr-2"></i> Naturaleza del Problema
                            </h5>

                            <div class="form-group mb-4 pl-3 bg-light p-2 rounded" style="border-left: 4px solid #ffc107;">
                                <label asp-for="Input.Description" class="control-label font-weight-bold small text-uppercase text-dark">FALLAS O PROBLEMAS DEL EQUIPO <span class="text-danger">*</span></label>
                                <textarea asp-for="Input.Description" class="form-control shadow-none border-0 bg-transparent" rows="4" placeholder="Describa detalladamente los fallos detectados..."></textarea>
                            </div>

                            <div class="form-group mb-4">
                                <label asp-for="Input.Observations" class="control-label font-weight-bold small text-uppercase text-dark">SUGERENCIAS U OBSERVACIONES PARA MANTENIMIENTO</label>
                                <textarea asp-for="Input.Observations" class="form-control shadow-sm" rows="14" placeholder="Indique las actividades sugeridas..."></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="form-actions text-right mt-4">
                        @if (isWizard)
                        {
                            <a asp-page="/Index" asp-route-ShowWizard="true" asp-route-Step="2" class="btn btn-outline-secondary btn-rounded mr-2 px-4">Volver al Wizard</a>
                        }
                        <button type="submit" class="btn btn-info btn-rounded px-5 shadow-sm font-weight-bold">
                            Guardar y continuar <i class="fas fa-arrow-right ml-2"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/libs/select2/dist/js/select2.full.min.js"></script>
    <script>
        $(function() {
            $(".select2").select2({ width: '100%' });

            $('#facultySelect').on('change', function() {
                let id = $(this).val();
                if (!id) return;
                $.get('?handler=LaboratoriesByFaculty', { facultyId: id }, function(data) {
                    let opts = '<option value="">-- Seleccionar Laboratorio --</option>';
                    $.each(data, function(i, item) { opts += `<option value="${item.id}">${item.name}</option>`; });
                    $('#laboratorySelect').html(opts).prop('disabled', false).trigger('change');
                });
            });

            $('#laboratorySelect').on('change', function() {
                let id = $(this).val();
                if (!id) return;
                $.get('?handler=UnitsByLab', { laboratoryId: id }, function(data) {
                    let opts = '<option value="">-- Seleccionar Unidad Física --</option>';
                    $.each(data, function(i, item) { opts += `<option value="${item.id}">${item.name}</option>`; });
                    $('#equipmentUnitSelect').html(opts).prop('disabled', false).trigger('change');
                });
            });
        });
    </script>
}