@page
@model Proyecto_Laboratorios_Univalle.Pages.Requests.IndexModel
@using Proyecto_Laboratorios_Univalle.Models.Enums

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle mr-2"></i> @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="d-md-flex align-items-center mb-4">
                    <div>
                        <h3 class="card-title text-dark font-weight-bold mt-2 ml-2">Registro de Solicitudes L-7</h3>
                        <h6 class="card-subtitle text-muted ml-2">Gestión y seguimiento de requerimientos para el mantenimiento técnico de activos.</h6>
                    </div>
                    <div class="ml-auto mt-3">
                        <a asp-page="Create" class="btn bg-white border btn-rounded shadow-sm text-dark px-4 font-weight-bold">
                            <i class="fas fa-plus-circle mr-1 text-info"></i> Generar Solicitud de Reparación L-7
                        </a>
                    </div>
                </div>

                <div id="localNotificationsArea" class="mb-4" style="display: none;">
                    <h5 class="font-weight-bold text-danger mb-3 border-bottom pb-2">
                        <i class="fas fa-exclamation-circle mr-2"></i> Alertas de Requerimientos L-7
                    </h5>
                    <div id="localNotificationsList">
                    </div>
                </div>

                <div class="bg-light p-4 mb-4 rounded border shadow-sm">
                    <form method="post" asp-page-handler="GenerateL7">
                        <div class="d-lg-flex align-items-center mb-4 pb-3 border-bottom border-muted">
                            <div class="mb-2 mb-lg-0 mr-auto">
                                <h6 class="font-weight-bold text-dark mb-1"><i class="fas fa-file-excel mr-2 text-success"></i> Reporte Oficial L-7</h6>
                                <small class="text-muted d-block">Seleccione los parámetros para descargar el registro de solicitudes.</small>
                            </div>

                            <div class="d-flex flex-wrap align-items-center justify-content-lg-end">
                                <div class="input-group input-group-sm mr-2 mb-2" style="width: 200px;">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-white border-right-0"><i class="fas fa-flask text-muted"></i></span>
                                    </div>
                                    <select asp-for="ReportInput.LaboratoryId" class="form-control border-left-0" asp-items="Model.LaboratoryList" required>
                                        <option value="">-- Laboratorio --</option>
                                    </select>
                                </div>

                                <div class="input-group input-group-sm mr-2 mb-2" style="width: 140px;">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-white border-right-0"><i class="fas fa-calendar-alt text-muted"></i></span>
                                    </div>
                                    <select asp-for="ReportInput.ManagementId" class="form-control border-left-0" asp-items="Model.ManagementList" required>
                                        <option value="">-- Gestión --</option>
                                    </select>
                                </div>

                                <div class="input-group input-group-sm mr-2 mb-2" style="width: 180px;">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-white border-right-0"><i class="fas fa-user text-muted"></i></span>
                                    </div>
                                    <select asp-for="ReportInput.ResponsibleId" class="form-control border-left-0" asp-items="Model.PersonnelList" required>
                                        <option value="">-- Responsable --</option>
                                    </select>
                                </div>
                                <button type="submit" class="btn btn-success btn-sm btn-rounded shadow-sm font-weight-bold px-3 mb-2">
                                    <i class="fas fa-download mr-1"></i> Excel L-7
                                </button>
                            </div>
                        </div>
                    </form>

                    <form method="get">
                        <div class="row align-items-end">
                            <div class="col-md-3">
                                <label class="small font-weight-bold text-muted uppercase">Laboratorio</label>
                                <select asp-for="FilterLaboratoryId" class="form-control custom-select" asp-items="Model.LaboratoryList">
                                    <option value="">-- Todos --</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="small font-weight-bold text-muted uppercase">Búsqueda Rápida</label>
                                <div class="input-group drop-shadow">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-white border-right-0"><i class="fas fa-search text-muted"></i></span>
                                    </div>
                                    <input type="text" asp-for="SearchTerm" class="form-control border-left-0" placeholder="Equipo, código o solicitante..." />
                                </div>
                            </div>
                            <div class="col-md-2">
                                <label class="small font-weight-bold text-muted uppercase">Prioridad</label>
                                <select asp-for="PriorityFilter" class="form-control custom-select"
                                        asp-items="@Proyecto_Laboratorios_Univalle.Helpers.EnumHelper.GetStatusSelectList<RequestPriority>()">
                                    <option value="">-- Todas --</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="small font-weight-bold text-muted uppercase">Estado</label>
                                <select asp-for="StatusFilter" class="form-control custom-select"
                                        asp-items="@Proyecto_Laboratorios_Univalle.Helpers.EnumHelper.GetStatusSelectList<RequestStatus>()">
                                    <option value="">-- Todos --</option>
                                </select>
                            </div>
                            <div class="col-md-2 text-right mt-2 mt-md-0">
                                <button type="submit" class="btn btn-dark btn-rounded px-3 shadow-sm" title="Filtrar">
                                    <i class="fas fa-filter"></i>
                                </button>
                                <a asp-page="./Index" class="btn btn-outline-secondary btn-rounded ml-1" title="Limpiar">
                                    <i class="fas fa-sync-alt"></i>
                                </a>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover v-middle">
                        <thead class="thead-light">
                            <tr class="small uppercase font-weight-bold">
                                <th>Equipamiento Asignado</th>
                                <th>Detalle de la falla</th>
                                <th class="text-center">Prioridad</th>
                                <th class="text-center">Estado</th>
                                <th>Solicitante</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var technicalRequests = Model.Requests?.Where(r => r.Type == RequestType.Technical) ?? Enumerable.Empty<Proyecto_Laboratorios_Univalle.Models.Request>();
                            }

                            @if (!technicalRequests.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="fas fa-inbox fa-3x mb-3 d-block opacity-2"></i>
                                        No se encontraron requerimientos técnicos (L-7) registrados.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in technicalRequests)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="m-r-10">
                                                    <span class="btn btn-circle btn-light-info text-info"><i class="fas fa-tools"></i></span>
                                                </div>
                                                <div>
                                                    <h6 class="m-b-0 font-weight-bold text-dark">@(item.EquipmentUnit?.Equipment?.Name ?? item.Equipment?.Name ?? "S/E")</h6>
                                                    <span class="text-muted small">Inv: @(item.EquipmentUnit?.InventoryNumber ?? "-")</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="text-dark text-truncate" style="max-width: 250px;">@item.Description</div>
                                            <small class="text-muted italic"><i class="far fa-clock mr-1"></i> @item.CreatedDate.ToString("dd/MM/yyyy")</small>
                                        </td>
                                        <td class="text-center">
                                            @{
                                                var (priorityClass, priorityText) = item.Priority switch
                                                {
                                                    RequestPriority.High => ("badge-danger", "ALTA"),
                                                    RequestPriority.Medium => ("badge-warning", "MEDIA"),
                                                    _ => ("badge-info", "BAJA")
                                                };
                                            }
                                            <span class="badge @priorityClass px-3 py-1 text-uppercase" style="font-size: 0.7rem;">@priorityText</span>
                                        </td>
                                        <td class="text-center">
                                            @{
                                                var (statusClass, statusText) = item.Status switch
                                                {
                                                    RequestStatus.Approved => ("badge-success", "APROBADA"),
                                                    RequestStatus.Pending => ("badge-warning", "PENDIENTE"),
                                                    RequestStatus.Rejected => ("badge-danger", "RECHAZADA"),
                                                    _ => ("badge-light text-muted border", "DESCONOCIDO")
                                                };
                                            }
                                            <span class="badge @statusClass px-3 py-1">@statusText</span>
                                        </td>
                                        <td>
                                            <div class="small">
                                                <div class="font-weight-bold text-dark">@(item.RequestedBy?.FullName ?? "-")</div>
                                                <div class="text-muted">@(item.RequestedBy?.Position ?? "Colaborador")</div>
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group">
                                                <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning btn-rounded" title="Gestionar">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info btn-rounded mx-1" title="Detalles">
                                                    <i class="fas fa-search-plus"></i>
                                                </a>
                                                <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger btn-rounded" title="Eliminar">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>