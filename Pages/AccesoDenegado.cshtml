@page
@model Proyecto_Laboratorios_Univalle.Pages.AccesoDenegadoModel
@{
    ViewData["Title"] = "Acceso denegado";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card shadow-sm border-0 mt-4">
            <div class="card-body p-5">
                <div class="d-flex align-items-start">
                    <div class="btn btn-circle btn-lg btn-light-danger text-danger mr-4">
                        <i class="fas fa-lock"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h2 class="font-weight-bold text-dark mb-2">Acceso denegado</h2>
                        <p class="text-muted mb-4">
                            No tiene permiso para abrir esta pantalla. Si necesita usarla, pida acceso al administrador del sistema.
                        </p>
                        <div class="d-flex flex-wrap">
                            <a href="@Model.HomeUrl" class="btn btn-primary btn-rounded px-4 mb-2 shadow-sm">
                                <i class="fas fa-home mr-2"></i> Ir al inicio
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
