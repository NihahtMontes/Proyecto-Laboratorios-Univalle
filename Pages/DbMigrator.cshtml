@page
@model Proyecto_Laboratorios_Univalle.Pages.DbMigratorModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Migrador de Base de Datos - Laboratorios Univalle</title>
    <!-- Bootstrap CSS -->
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #1e1e2f 0%, #0f0c1b 100%);
            color: #ffffff;
            font-family: 'Outfit', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .migrator-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
            max-width: 600px;
            width: 100%;
        }
        .title {
            font-weight: 800;
            background: linear-gradient(45deg, #ff416c, #ff4b2b);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 10px;
            text-align: center;
        }
        .subtitle {
            color: #a0aec0;
            font-size: 0.95rem;
            margin-bottom: 30px;
            text-align: center;
        }
        .db-info {
            background: rgba(0, 0, 0, 0.3);
            border-radius: 12px;
            padding: 15px;
            margin-bottom: 20px;
            border-left: 4px solid #ff4b2b;
        }
        .btn-migrate {
            background: linear-gradient(45deg, #ff416c, #ff4b2b);
            border: none;
            font-weight: 600;
            padding: 12px;
            border-radius: 10px;
            transition: transform 0.2s, box-shadow 0.2s;
            color: white;
            width: 100%;
        }
        .btn-migrate:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(255, 75, 43, 0.4);
            color: white;
        }
        .alert {
            border-radius: 10px;
            margin-top: 20px;
        }
        .loader {
            display: none;
            margin: 20px auto 0 auto;
            border: 4px solid rgba(255, 255, 255, 0.1);
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border-left-color: #ff4b2b;
            animation: spin 1s linear infinite;
        }
        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
</head>
<body>

    <div class="migrator-card">
        <h2 class="title">Migrador Local ➔ Cloud</h2>
        <p class="subtitle">Copia de forma segura todos tus datos locales a la base de datos en la nube.</p>

        <div class="db-info">
            <strong>Origen (Local):</strong><br>
            <span class="text-muted" style="font-size:0.85rem;">Server=localhost;Database=DB_Laboratorios_Univalle_DEV</span>
        </div>

        <div class="db-info" style="border-left-color: #4cd137;">
            <strong>Destino (Nube):</strong><br>
            <span class="text-muted" style="font-size:0.85rem;">db40037 (Configurado mediante User Secrets)</span>
        </div>

        <form method="post" asp-page-handler="Migrate" id="migrationForm">
            <button type="submit" class="btn btn-migrate" id="btnSubmit">
                Comenzar Migración de Datos
            </button>
        </form>

        <div class="loader" id="loader"></div>
        <p class="text-center text-muted mt-2" id="loaderText" style="display:none; font-size:0.9rem;">
            Migrando tablas y aplicando relaciones... Por favor no cierres esta ventana.
        </p>

        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="alert alert-success mt-4">
                <strong>¡Éxito!</strong> @Model.Message
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger mt-4">
                <strong>Error:</strong> @Model.ErrorMessage
            </div>
        }
    </div>

    <script>
        document.getElementById('migrationForm').addEventListener('submit', function () {
            document.getElementById('btnSubmit').disabled = true;
            document.getElementById('btnSubmit').innerText = "Migrando...";
            document.getElementById('loader').style.display = "block";
            document.getElementById('loaderText').style.display = "block";
        });
    </script>
</body>
</html>
