@model Proyecto_Laboratorios_Univalle.Pages.WizardStepViewModel
@using Proyecto_Laboratorios_Univalle.Models.Enums

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="wizard-title text-dark mb-1">@Model.Title</h3>
        <p class="wizard-subtitle mb-0">@Model.Description</p>
    </div>
    @if (Model.StepIndex == 0 || Model.StepIndex == 1) {
        <form method="get" class="d-flex align-items-center gap-3">
            <input type="hidden" name="ShowWizard" value="true" />
            <input type="hidden" name="Step" value="@Model.StepIndex" />
            <select name="SelectedLabId" asp-items="Model.LaboratoriesList" class="form-control shadow-sm" onchange="this.form.submit()">
                <option value="">-- Selecciona Laboratorio --</option>
            </select>
        </form>
    }
</div>

<div class="step-stack">
    @if (!Model.Plans.Any())
    {
        <div class="border-2 border-dashed rounded-3 p-5 text-center text-slate-400 bg-slate-50">
            <i class="@Model.EmptyIcon text-3xl mb-3 opacity-25"></i><br>
            @Model.EmptyMessage
        </div>
    }
    else
    {
        @foreach (var item in Model.Plans)
        {
            <div class="chart-card d-flex justify-content-between align-items-center py-3 mb-2 border-start border-4 @Model.BorderClass">
                <div>
                    <h4 class="font-bold text-slate-800 m-0">@item.EquipmentUnit?.Equipment?.Name</h4>
                    <span class="inventory-code">@item.EquipmentUnit?.InventoryNumber • @Model.StatusLabel</span>
                    @if (Model.ShowFailCount) {
                        <span class="text-danger small font-bold d-block mt-1">
                            <i class="fas fa-exclamation-triangle"></i> @(item.Verification?.FailuresCount ?? 0) Falla(s) detectada(s)
                        </span>
                    }
                </div>
                <div class="d-flex gap-2">
                    @if (!string.IsNullOrEmpty(Model.ActionPage)) {
                        <a asp-page="@Model.ActionPage" 
                           asp-route-equipmentUnitId="@item.EquipmentUnitId" 
                           asp-route-managementPlanId="@item.Id" 
                           asp-route-isWizard="true" 
                           class="btn @Model.ActionClass btn-sm rounded-pill font-weight-bold px-3">
                            @Model.ActionLabel
                        </a>
                    }
                    else if (Model.StepIndex == 5) {
                        <form method="post" asp-page-handler="ConfirmKardex">
                            <input type="hidden" name="planId" value="@item.Id" />
                            <input type="hidden" name="SelectedLabId" value="@(item.EquipmentUnit?.LaboratoryId)" />
                            <button type="submit" class="btn btn-info btn-sm rounded-pill font-weight-bold px-3 text-white">
                                Confirmar Kardex
                            </button>
                        </form>
                    }
                    
                    @if (Model.StepIndex == 1) {
                        <form method="post" asp-page-handler="FastFail">
                            <input type="hidden" name="planId" value="@item.Id" />
                            <button type="submit" class="btn btn-link btn-sm text-danger font-weight-bold">Falla Rápida</button>
                        </form>
                    }

                    @if (Model.StepIndex == 0) {
                        <a href="?ShowWizard=true&Step=@((int)item.CurrentPhase)&SelectedLabId=@(item.EquipmentUnit?.LaboratoryId)" class="btn btn-link btn-sm font-bold text-primary">
                            Atender <i class="fas fa-chevron-right ms-1"></i>
                        </a>
                    }
                </div>
            </div>
        }
    }
</div>
