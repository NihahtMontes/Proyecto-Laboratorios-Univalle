@model Proyecto_Laboratorios_Univalle.Pages.WizardStepViewModel
@using Proyecto_Laboratorios_Univalle.Models.Enums
@using Proyecto_Laboratorios_Univalle.Helpers

@{
    // Construir URL base con todos los filtros preservados
    var baseUrl = $"?ShowWizard=true&Step={Model.StepIndex}&ManagementId={Model.ManagementId}";
    if (Model.SelectedLabId.HasValue) { baseUrl += $"&SelectedLabId={Model.SelectedLabId}"; }
    if (Model.FocusPlanId.HasValue) { baseUrl += $"&FocusPlanId={Model.FocusPlanId}"; }
    if (!string.IsNullOrEmpty(Model.SearchTerm)) { baseUrl += $"&SearchTerm={Uri.EscapeDataString(Model.SearchTerm)}"; }
    if (!string.IsNullOrEmpty(Model.SerialNumberFilter)) { baseUrl += $"&SerialNumberFilter={Uri.EscapeDataString(Model.SerialNumberFilter)}"; }
    if (!string.IsNullOrEmpty(Model.InventoryNumberFilter)) { baseUrl += $"&InventoryNumberFilter={Uri.EscapeDataString(Model.InventoryNumberFilter)}"; }
    var isFocusMode = Model.FocusPlanId.HasValue;
}

<div class="d-flex justify-content-between align-items-center mb-4" style="font-family: 'Inter', sans-serif;">
    <div>
        <h3 class="wizard-title text-dark mb-1" style="font-weight: 900; color: #0f172a !important;">@Model.Title</h3>
        <p class="wizard-subtitle mb-0" style="font-weight: 500; color: #64748b;">@Model.Description</p>
    </div>
</div>

<div class="step-stack" style="font-family: 'Inter', sans-serif;">
    @if (!Model.Plans.Any())
    {
        <div class="border-2 border-dashed rounded p-5 text-center text-slate-400 bg-slate-50" style="border-radius: 12px !important;">
            <i class="@Model.EmptyIcon text-3xl mb-3 opacity-25 d-block"></i>
            <span style="font-weight: 500;">@Model.EmptyMessage</span>
        </div>
    }
    else if (Model.StepIndex == 5)
    {
        <div class="accordion" id="kardexAccordion">
            @{ var groupedPlans = Model.Plans.GroupBy(p => p.EquipmentUnit?.Laboratory?.Name ?? "General"); }
            @foreach (var group in groupedPlans)
            {
                var labNameId = group.Key.Replace(" ", "").Replace(".", "").Replace(",", "");
                <div class="card border-0 mb-3 shadow-sm" style="border-radius: 12px; overflow: hidden;">
                    <div class="card-header bg-white border-bottom-0 p-1" id="heading-@labNameId">
                        <h2 class="mb-0">
                            <button class="btn btn-link btn-block text-left font-weight-bold text-dark text-decoration-none px-4 py-3" type="button" data-toggle="collapse" data-target="#collapse-@labNameId" aria-expanded="true" aria-controls="collapse-@labNameId" style="font-size: 1.1rem;">
                                <i class="fas fa-flask text-primary mr-2"></i> @group.Key <span class="badge badge-primary ml-2">@group.Count()</span>
                            </button>
                        </h2>
                    </div>
                    <div id="collapse-@labNameId" class="collapse show" aria-labelledby="heading-@labNameId" data-parent="#kardexAccordion">
                        <div class="card-body bg-light p-4">
                            @foreach (var item in group)
                            {
                                <div class="bg-white p-4 rounded mb-4 shadow-sm border border-light">
                                    <h5 class="font-weight-bold text-primary mb-3">
                                        @item.EquipmentUnit?.Equipment?.Name <span class="text-muted small">(@item.EquipmentUnit?.InventoryNumber)</span>
                                        @if (item.IsDraft)
                                        {
                                            <span class="badge badge-warning badge-pill ml-2 px-3 py-1" title="@(item.DraftSummary ?? "Avance guardado como borrador")">
                                                <i class="fas fa-save mr-1"></i> Borrador
                                            </span>
                                        }
                                    </h5>
                                    
                                    <div class="table-responsive">
                                        <table class="table table-bordered table-sm m-0 pixel-perfect-table" style="font-size: 0.85rem;">
                                            <thead class="bg-primary text-white text-center">
                                                <tr>
                                                    <th style="width: 10%;">Fecha</th>
                                                    <th style="width: 25%;">Descripción</th>
                                                    <th style="width: 15%;">Servicio Efectuado Por</th>
                                                    <th style="width: 10%;">Próx. Mant.</th>
                                                    <th style="width: 10%;">Importe (Bs)</th>
                                                    <th style="width: 20%;">Observaciones</th>
                                                    <th style="width: 10%;">Acción</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td class="text-center align-middle font-weight-bold">@(item.Maintenance?.EndDate?.ToString("dd/MM/yyyy") ?? "Pendiente")</td>
                                                    <td class="align-middle">@(item.Maintenance?.Description ?? "Sin descripción")</td>
                                                    <td class="text-center align-middle">@(item.Maintenance?.Technician?.FullName ?? "Interno")</td>
                                                    <td class="text-center align-middle">@(item.Maintenance?.SuggestedNextMaintenanceDate?.ToString("dd/MM/yyyy") ?? "Pendiente")</td>
                                                    <td class="text-center align-middle font-weight-bold text-success h6 m-0">@((item.Maintenance?.ActualCost ?? 0m).ToString("N2"))</td>
                                                    <td class="align-middle text-muted">@(item.Maintenance?.Recommendations ?? "Pendiente")</td>
                                                    <td class="text-center align-middle">
                                                        <a href="/Kardex/Create?managementPlanId=@item.Id&isWizard=true&managementId=@ViewData["ManagementId"]"
                                                           class="btn btn-login-glow btn-sm rounded-pill font-weight-bold w-100 text-white shadow-sm mb-2"
                                                           style="background: linear-gradient(to right, #2563eb, #1e40af); border: none;">
                                                            <i class="fas fa-check-double mr-1"></i> Completar Kardex
                                                        </a>
                                                        <a href="/EquipmentUnits/Kardex/@(item.EquipmentUnitId)?isWizard=true&managementId=@ViewData["ManagementId"]&selectedLabId=@(item.EquipmentUnit?.LaboratoryId)&returnStep=5"
                                                           class="btn btn-sm btn-outline-info btn-rounded font-weight-bold px-2 w-100 shadow-sm"
                                                           target="_blank" title="Ver historial completo de mantenimientos del equipo">
                                                            <i class="fas fa-history mr-1"></i> Ver Kardex
                                                        </a>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        @foreach (var item in Model.Plans)
        {
            <div class="chart-card d-flex justify-content-between align-items-center py-3 px-4 mb-3 premium-card border-start border-4 @Model.BorderClass" style="background: #ffffff; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); transition: transform 0.2s, box-shadow 0.2s;">
                <div class="flex-grow-1 min-width-0 mr-3">
                    <div class="d-flex align-items-center mb-1">
                        <h4 class="font-bold text-slate-800 m-0 mr-2" style="font-weight: 800; color: #1e293b;">@item.EquipmentUnit?.Equipment?.Name</h4>
                        <span class="badge badge-light border text-muted small" style="font-size: 0.65rem;">
                            <i class="fas fa-flask mr-1"></i>@item.EquipmentUnit?.Laboratory?.Name
                        </span>
                    </div>
                    <div class="d-flex flex-wrap gap-2 text-muted" style="font-size: 0.75rem; font-weight: 600;">
                        <span><i class="fas fa-barcode mr-1"></i>Inv: @item.EquipmentUnit?.InventoryNumber</span>
                        @if (!string.IsNullOrEmpty(item.EquipmentUnit?.SerialNumber))
                        {
                            <span class="mx-1">|</span>
                            <span><i class="fas fa-fingerprint mr-1"></i>Serie: @item.EquipmentUnit?.SerialNumber</span>
                        }
                        <span class="mx-1">|</span>
                        <span class="text-@(Model.StepIndex switch { 1 => "info", 2 => "warning", 3 => "success", 4 => "primary", 6 => "dark", _ => "muted" })">@Model.StatusLabel</span>
                    </div>
                    @if (item.IsDraft)
                    {
                        <span class="badge badge-warning badge-pill d-inline-block mt-2 px-3 py-1" title="@(item.DraftSummary ?? "Avance guardado como borrador")">
                            <i class="fas fa-save mr-1"></i> Borrador
                        </span>
                    }
                    @if (Model.ShowFailCount) {
                        <span class="text-danger small font-bold d-block mt-1">
                            <i class="fas fa-exclamation-triangle"></i> @(item.Verification?.FailuresCount ?? 0) Falla(s) detectada(s)
                        </span>
                    }
                    @if (isFocusMode && Model.StepIndex == 1 && item.Verification != null)
                    {
                        <span class="text-muted small d-block mt-1">
                            <i class="fas fa-comment-medical mr-1"></i>@(string.IsNullOrWhiteSpace(item.Verification.Observations) ? "Sin observaciones registradas." : item.Verification.Observations)
                        </span>
                    }
                    @if (isFocusMode && Model.StepIndex == 2 && item.TechnicalRequest != null)
                    {
                        <span class="text-muted small d-block mt-1">
                            <i class="fas fa-file-alt mr-1"></i>@item.TechnicalRequest.Description
                        </span>
                    }
                </div>
                <div class="d-flex gap-2 align-items-center flex-shrink-0">
                    @if (isFocusMode && Model.StepIndex == 1 && item.VerificationId.HasValue)
                    {
                        <a asp-page="/Verifications/Details"
                           asp-route-id="@item.VerificationId"
                           asp-route-isWizard="true"
                           asp-route-managementId="@ViewData["ManagementId"]"
                           asp-route-focusPlanId="@Model.FocusPlanId"
                           class="btn btn-outline-success btn-sm rounded-pill font-weight-bold px-3 shadow-sm mr-2">
                            Ver L-6
                        </a>
                        <button type="button"
                                class="btn btn-outline-info btn-sm rounded-pill font-weight-bold px-3 shadow-sm"
                                data-toggle="modal"
                                data-target="#l6ObservationModal-@item.Id">
                            Observacion
                        </button>
                    }
                    else if (!string.IsNullOrEmpty(Model.ActionPage)) {
                        <a asp-page="@Model.ActionPage" 
                           asp-route-equipmentUnitId="@item.EquipmentUnitId" 
                           asp-route-managementPlanId="@item.Id" 
                           asp-route-isWizard="true" 
                           asp-route-managementId="@ViewData["ManagementId"]"
                           class="btn @Model.ActionClass btn-sm rounded-pill font-weight-bold px-4 shadow-sm" style="letter-spacing: 0.03em;">
                            @Model.ActionLabel
                        </a>
                    }
                    
                    @if (Model.StepIndex == 0) {
                        <a href="?ShowWizard=true&Step=@((int)item.CurrentPhase)&SelectedLabId=@(item.EquipmentUnit?.LaboratoryId)&ManagementId=@ViewData["ManagementId"]" class="btn btn-light border btn-sm font-bold text-primary rounded-pill px-3 shadow-sm">
                            Atender <i class="fas fa-chevron-right ms-1"></i>
                        </a>
                    }
                </div>
            </div>

            @if (isFocusMode && Model.StepIndex == 1 && item.VerificationId.HasValue)
            {
                <div class="modal fade" id="l6ObservationModal-@item.Id" tabindex="-1" role="dialog" aria-labelledby="l6ObservationModalLabel-@item.Id" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered" role="document">
                        <div class="modal-content border-0 shadow">
                            <form method="post" asp-page="/Index" asp-page-handler="UpdateFocusedVerificationObservation" class="js-l6-observation-form">
                                <div class="modal-header bg-info text-white">
                                    <h5 class="modal-title font-weight-bold" id="l6ObservationModalLabel-@item.Id">Observacion L-6</h5>
                                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Cerrar">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>
                                <div class="modal-body">
                                    <input type="hidden" name="planId" value="@item.Id" />
                                    <input type="hidden" name="verificationId" value="@item.VerificationId" />
                                    <input type="hidden" name="ManagementId" value="@ViewData["ManagementId"]" />
                                    <input type="hidden" name="FocusPlanId" value="@Model.FocusPlanId" />
                                    <label class="font-weight-bold text-dark" for="l6Observations-@item.Id">Comentario de verificacion</label>
                                    <textarea id="l6Observations-@item.Id" name="observations" class="form-control" rows="5" maxlength="1000">@(item.Verification?.Observations)</textarea>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary btn-rounded" data-dismiss="modal">Cancelar</button>
                                    <button type="submit" class="btn btn-info btn-rounded shadow-sm font-weight-bold">Guardar</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
    }
</div>

<!-- Paginación -->
@if (Model.TotalPages > 1)
{
    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
        <span class="text-muted small">
            Mostrando @(((Model.CurrentPage - 1) * Model.PageSize) + 1)-@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems) de @Model.TotalItems equipos
        </span>
        <nav aria-label="Paginación">
            <ul class="pagination pagination-sm mb-0">
                @* Anterior *@
                <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                    <a class="page-link" href="@(baseUrl)&CurrentPage=@(Model.CurrentPage - 1)" aria-label="Anterior">
                        <span aria-hidden="true"><i class="fas fa-chevron-left"></i></span>
                    </a>
                </li>

                @* Números de página con ventana deslizante *@
                @{
                    var pageNumbers = new List<int>();
                    var total = Model.TotalPages;
                    var current = Model.CurrentPage;

                    if (total <= 9)
                    {
                        for (int p = 1; p <= total; p++) { pageNumbers.Add(p); }
                    }
                    else if (current <= 5)
                    {
                        // Cerca del inicio: 1 2 3 4 5 ... last
                        for (int p = 1; p <= 5; p++) { pageNumbers.Add(p); }
                        pageNumbers.Add(-1); // ellipsis
                        pageNumbers.Add(total);
                    }
                    else if (current >= total - 4)
                    {
                        // Cerca del final: 1 ... total-4 total-3 total-2 total-1 total
                        pageNumbers.Add(1);
                        pageNumbers.Add(-1);
                        for (int p = total - 4; p <= total; p++) { pageNumbers.Add(p); }
                    }
                    else
                    {
                        // En el medio: 1 ... current-2 current-1 current current+1 current+2 ... last
                        pageNumbers.Add(1);
                        pageNumbers.Add(-1);
                        for (int p = current - 2; p <= current + 2; p++) { pageNumbers.Add(p); }
                        pageNumbers.Add(-1);
                        pageNumbers.Add(total);
                    }
                }

                @foreach (var p in pageNumbers)
                {
                    if (p == -1)
                    {
                        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                    }
                    else
                    {
                        <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" href="@(baseUrl)&CurrentPage=@p">@p</a>
                        </li>
                    }
                }

                @* Siguiente *@
                <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@(baseUrl)&CurrentPage=@(Model.CurrentPage + 1)" aria-label="Siguiente">
                        <span aria-hidden="true"><i class="fas fa-chevron-right"></i></span>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
}
else if (Model.TotalItems > 0)
{
    <div class="text-center mt-3">
        <span class="text-muted small">Mostrando @Model.TotalItems equipo(s)</span>
    </div>
}
