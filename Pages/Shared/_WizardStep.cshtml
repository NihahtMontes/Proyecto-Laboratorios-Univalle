@model Proyecto_Laboratorios_Univalle.Pages.WizardStepViewModel
@using Proyecto_Laboratorios_Univalle.Models.Enums
@using Proyecto_Laboratorios_Univalle.Helpers

<div class="d-flex justify-content-between align-items-center mb-4" style="font-family: 'Inter', sans-serif;">
    <div>
        <h3 class="wizard-title text-dark mb-1" style="font-weight: 900; color: #0f172a !important;">@Model.Title</h3>
        <p class="wizard-subtitle mb-0" style="font-weight: 500; color: #64748b;">@Model.Description</p>
    </div>
    @if (Model.LaboratoriesList != null && Model.LaboratoriesList.Any()) {
        <form method="get" class="d-flex align-items-center gap-3">
            <input type="hidden" name="ShowWizard" value="true" />
            <input type="hidden" name="Step" value="@Model.StepIndex" />
            <input type="hidden" name="ManagementId" value="@ViewData["ManagementId"]" />
            <select name="SelectedLabId" asp-items="Model.LaboratoriesList" class="form-control shadow-sm input-group-custom" style="border-radius: 12px; background-color: #f8fafc; border: 1.5px solid #e2e8f0; font-weight: 600; color: #334155; padding: 8px 12px; height: 44px; outline: none; transition: box-shadow 0.2s;" onchange="this.form.submit()">
                <option value="">-- Selecciona Laboratorio --</option>
            </select>
        </form>
    }
</div>

<div class="step-stack" style="font-family: 'Inter', sans-serif;">
    @if (!Model.Plans.Any())
    {
        <div class="border-2 border-dashed rounded p-5 text-center text-slate-400 bg-slate-50" style="border-radius: 12px !important;">
            <i class="@Model.EmptyIcon text-3xl mb-3 opacity-25"></i><br>
            <span style="font-weight: 500;">@Model.EmptyMessage</span>
        </div>
    }
    else if (Model.StepIndex == 5)
    {
        <div class="accordion" id="kardexAccordion">
            @{ var groupedPlans = Model.Plans.GroupBy(p => p.EquipmentUnit?.Laboratory?.Name ?? "General"); }
            @foreach (var group in groupedPlans)
            {
                var labNameId = group.Key.Replace(" ", "").Replace(".", "").Replace(",", "");
                <div class="card border-0 mb-3 shadow-sm" style="border-radius: 12px; overflow: hidden;">
                    <div class="card-header bg-white border-bottom-0 p-1" id="heading-@labNameId">
                        <h2 class="mb-0">
                            <button class="btn btn-link btn-block text-left font-weight-bold text-dark text-decoration-none px-4 py-3" type="button" data-toggle="collapse" data-target="#collapse-@labNameId" aria-expanded="true" aria-controls="collapse-@labNameId" style="font-size: 1.1rem;">
                                <i class="fas fa-flask text-primary mr-2"></i> @group.Key <span class="badge badge-primary ml-2">@group.Count()</span>
                            </button>
                        </h2>
                    </div>
                    <div id="collapse-@labNameId" class="collapse show" aria-labelledby="heading-@labNameId" data-parent="#kardexAccordion">
                        <div class="card-body bg-light p-4">
                            @foreach (var item in group)
                            {
                                <div class="bg-white p-4 rounded mb-4 shadow-sm border border-light">
                                    <h5 class="font-weight-bold text-primary mb-3">
                                        @item.EquipmentUnit?.Equipment?.Name <span class="text-muted small">(@item.EquipmentUnit?.InventoryNumber)</span>
                                        @if (item.IsDraft)
                                        {
                                            <span class="badge badge-warning badge-pill ml-2 px-3 py-1" title="@(item.DraftSummary ?? "Avance guardado como borrador")">
                                                <i class="fas fa-save mr-1"></i> Borrador
                                            </span>
                                        }
                                    </h5>
                                    
                                    <div class="table-responsive">
                                        <table class="table table-bordered table-sm m-0 pixel-perfect-table" style="font-size: 0.85rem;">
                                            <thead class="bg-primary text-white text-center">
                                                <tr>
                                                    <th style="width: 10%;">Fecha</th>
                                                    <th style="width: 25%;">Descripción</th>
                                                    <th style="width: 15%;">Servicio Efectuado Por</th>
                                                    <th style="width: 10%;">Próx. Mant.</th>
                                                    <th style="width: 10%;">Importe (Bs)</th>
                                                    <th style="width: 20%;">Observaciones</th>
                                                    <th style="width: 10%;">Acción</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td class="text-center align-middle font-weight-bold">@(item.Maintenance?.EndDate?.ToString("dd/MM/yyyy") ?? "Pendiente")</td>
                                                    <td class="align-middle">@(item.Maintenance?.Description ?? "Sin descripción")</td>
                                                    <td class="text-center align-middle">@(item.Maintenance?.Technician?.FullName ?? "Interno")</td>
                                                    <td class="text-center align-middle">@(item.Maintenance?.SuggestedNextMaintenanceDate?.ToString("dd/MM/yyyy") ?? "Pendiente")</td>
                                                    <td class="text-center align-middle font-weight-bold text-success h6 m-0">@((item.Maintenance?.ActualCost ?? 0m).ToString("N2"))</td>
                                                    <td class="align-middle text-muted">@(item.Maintenance?.Recommendations ?? "Pendiente")</td>
                                                    <td class="text-center align-middle">
                                                        <a href="/Kardex/Create?managementPlanId=@item.Id&isWizard=true&managementId=@ViewData["ManagementId"]"
                                                           class="btn btn-login-glow btn-sm rounded-pill font-weight-bold w-100 text-white shadow-sm mb-2"
                                                           style="background: linear-gradient(to right, #2563eb, #1e40af); border: none;">
                                                            <i class="fas fa-check-circle mr-1"></i> Concluir Mantenimiento
                                                        </a>
                                                        <a href="/Maintenances/Edit?id=@(item.MaintenanceId)&managementPlanId=@item.Id&isWizard=true&managementId=@ViewData["ManagementId"]"
                                                           class="btn btn-sm btn-outline-warning btn-rounded font-weight-bold px-2 mb-2 w-100 shadow-sm">
                                                            <i class="fas fa-edit mr-1"></i> Editar L-8
                                                        </a>
                                                        <a href="/EquipmentUnits/Kardex/@(item.EquipmentUnitId)?isWizard=true&managementId=@ViewData["ManagementId"]&selectedLabId=@(item.EquipmentUnit?.LaboratoryId)&returnStep=5"
                                                           class="btn btn-sm btn-outline-info btn-rounded font-weight-bold px-2 w-100 shadow-sm"
                                                           target="_blank" title="Ver historial completo de mantenimientos del equipo">
                                                            <i class="fas fa-history mr-1"></i> Ver Kardex
                                                        </a>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        @foreach (var item in Model.Plans)
        {
            <div class="chart-card d-flex justify-content-between align-items-center py-3 px-4 mb-3 premium-card border-start border-4 @Model.BorderClass" style="background: #ffffff; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); transition: transform 0.2s, box-shadow 0.2s;">
                <div>
                    <h4 class="font-bold text-slate-800 m-0" style="font-weight: 800; color: #1e293b;">@item.EquipmentUnit?.Equipment?.Name</h4>
                    <span class="inventory-code text-muted small" style="font-weight: 600;">@item.EquipmentUnit?.InventoryNumber • @Model.StatusLabel</span>
                    @if (item.IsDraft)
                    {
                        <span class="badge badge-warning badge-pill d-inline-block mt-2 px-3 py-1" title="@(item.DraftSummary ?? "Avance guardado como borrador")">
                            <i class="fas fa-save mr-1"></i> Borrador
                        </span>
                    }
                    @if (Model.ShowFailCount) {
                        <span class="text-danger small font-bold d-block mt-1">
                            <i class="fas fa-exclamation-triangle"></i> @(item.Verification?.FailuresCount ?? 0) Falla(s) detectada(s)
                        </span>
                    }
                </div>
                <div class="d-flex gap-2 align-items-center">
                    @if (!string.IsNullOrEmpty(Model.ActionPage)) {
                        <a asp-page="@Model.ActionPage" 
                           asp-route-equipmentUnitId="@item.EquipmentUnitId" 
                           asp-route-managementPlanId="@item.Id" 
                           asp-route-isWizard="true" 
                           asp-route-managementId="@ViewData["ManagementId"]"
                           class="btn @Model.ActionClass btn-sm rounded-pill font-weight-bold px-4 shadow-sm" style="letter-spacing: 0.03em;">
                            @Model.ActionLabel
                        </a>
                    }
                    
                    @if (Model.StepIndex == 1) {
                        <form method="post" asp-page-handler="FastFail" class="m-0">
                            <input type="hidden" name="planId" value="@item.Id" />
                            <input type="hidden" name="ManagementId" value="@ViewData["ManagementId"]" />
                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill font-weight-bold px-3">Falla Rápida</button>
                        </form>
                    }

                    @if (Model.StepIndex == 0) {
                        <a href="?ShowWizard=true&Step=@((int)item.CurrentPhase)&SelectedLabId=@(item.EquipmentUnit?.LaboratoryId)&ManagementId=@ViewData["ManagementId"]" class="btn btn-light border btn-sm font-bold text-primary rounded-pill px-3 shadow-sm">
                            Atender <i class="fas fa-chevron-right ms-1"></i>
                        </a>
                    }
                </div>
            </div>
        }
    }
</div>
