                        </li>

                        <li class="sidebar-item">
                            <a asp-page="/Departures/Index" class="sidebar-link">
                                <i class="fas fa-sign-out-alt"></i>
                                <span class="hide-menu"> Salidas (L-3) </span>
                            </a>
                        </li>
                      </ul>
                </li>

                <li class="sidebar-item">
                    <a class="sidebar-link has-arrow waves-effect waves-dark" href="javascript:void(0)" aria-expanded="false">
                        <i class="mdi mdi-book-open-variant"></i>
                        <span class="hide-menu">Catálogos </span>
                    </a>
                    <ul aria-expanded="false" class="collapse first-level">
                        <li class="sidebar-item">
                            <a asp-page="/Laboratories/Index" class="sidebar-link">
                                <i class="mdi mdi-home-modern"></i>
                                <span class="hide-menu"> Laboratorios </span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a asp-page="/Cities/Index" class="sidebar-link">
                                <i class="mdi mdi-earth"></i>
                                <span class="hide-menu">Regiones</span>
                            </a>
                        </li>
                    </ul>
                </li>

                <li class="nav-small-cap">
                    <i class="mdi mdi-dots-horizontal"></i>
                    <span class="hide-menu">Personas</span>
                </li>

                <li class="sidebar-item">
                    <a class="sidebar-link has-arrow waves-effect waves-dark" href="javascript:void(0)" aria-expanded="false">
                        <i class="mdi mdi-account-key"></i>
