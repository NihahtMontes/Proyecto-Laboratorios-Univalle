@using Proyecto_Laboratorios_Univalle.Models.Enums
@using Proyecto_Laboratorios_Univalle.Helpers
@{
    var closureOnly = PracticeClosureAccess.IsClosureOnly(User);
    // Las páginas de administración (AdminRoles) no se muestran al Supervisor en el menú (H-021): antes terminaban en /Error.
    var isAdminMenu = User.IsInRole(AuthorizationHelper.RoleAdministrator) || User.IsInRole(AuthorizationHelper.RoleSuperAdmin);
    var isSupervisor = !closureOnly && !isAdminMenu;
    var currentSidebarRoute = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var isCierreActive = currentSidebarRoute.StartsWith("/Cierre", StringComparison.OrdinalIgnoreCase);
    // Los grupos (CourseGroups) se gestionan como pestañas de Materias: la entrada de Materias
    // queda marcada también cuando la ruta está bajo /Catalogs/CourseGroups.
    var isMateriasActive = currentSidebarRoute.StartsWith("/Catalogs/Subjects", StringComparison.OrdinalIgnoreCase)
        || currentSidebarRoute.StartsWith("/Catalogs/CourseGroups", StringComparison.OrdinalIgnoreCase)
        || currentSidebarRoute.StartsWith("/Catalogs/StudentGroups", StringComparison.OrdinalIgnoreCase);
}
<aside class="left-sidebar" data-sidebarbg="skin5">
    <div class="scroll-sidebar">
        <nav class="sidebar-nav">
            <ul id="sidebarnav">
                @if (!closureOnly)
                {
                    <li class="nav-small-cap">
                        <i class="mdi mdi-dots-horizontal"></i>
                        <span class="hide-menu">Inicio</span>
                    </li>

                    <li class="sidebar-item">
                        <a asp-page="/Index" class="sidebar-link waves-effect waves-dark">
                            <i class="mdi mdi-home-outline"></i>
                            <span class="hide-menu">Inicio</span>
                        </a>
                    </li>

                    <li class="nav-small-cap">
                        <i class="mdi mdi-dots-horizontal"></i>
                        <span class="hide-menu">Mantenimiento de equipos</span>
                    </li>

                    @if (isAdminMenu)
                    {
                        <li class="sidebar-item">
                            <a asp-page="/Managements/Index" asp-route-type="Preventive" class="sidebar-link waves-effect waves-dark">
                                <i class="mdi mdi-calendar-range"></i>
                                <span class="hide-menu">Gestiones</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a asp-page="/Index" asp-route-ShowWizard="true" class="sidebar-link waves-effect waves-dark">
                                <i class="mdi mdi-shield-outline"></i>
                                <span class="hide-menu">Mantenimiento preventivo</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a asp-page="/Managements/Index" asp-page-handler="CurrentCorrective" class="sidebar-link waves-effect waves-dark">
                                <i class="mdi mdi-wrench"></i>
                                <span class="hide-menu">Mantenimiento correctivo</span>
                            </a>
                        </li>
                    }
                    else if (isSupervisor)
                    {
                        @* El Supervisor no entra a Gestiones (AdminRoles): su acceso al correctivo es la solicitud de servicio técnico. *@
                        <li class="sidebar-item">
                            <a asp-page="/Requests/Index" asp-page-handler="NewRequest" class="sidebar-link waves-effect waves-dark">
                                <i class="mdi mdi-wrench"></i>
                                <span class="hide-menu">Mantenimiento correctivo</span>
                            </a>
                        </li>
                    }

                    <li class="sidebar-item">
                        <a asp-page="/Reports/Index" class="sidebar-link waves-effect waves-dark">
                            <i class="mdi mdi-file-chart"></i>
                            <span class="hide-menu">Reportes</span>
                        </a>
                    </li>

                    <li class="sidebar-item">
                        <a class="sidebar-link has-arrow waves-effect waves-dark" href="javascript:void(0)" aria-expanded="false">
                            <i class="mdi mdi-clipboard-text"></i>
                            <span class="hide-menu">Registros</span>
                        </a>
                        <ul aria-expanded="false" class="collapse first-level">
                            @if (isAdminMenu)
                            {
                                <li class="sidebar-item">
                                    <a asp-page="/Verifications/Index" class="sidebar-link waves-effect waves-dark">
                                        <i class="mdi mdi-checkbox-marked-circle-outline"></i>
                                        <span class="hide-menu">Verificaciones de equipos</span>
                                    </a>
                                </li>
                            }
                            <li class="sidebar-item">
                                <a asp-page="/Requests/Index" class="sidebar-link waves-effect waves-dark">
                                    <i class="mdi mdi-message-text-outline"></i>
                                    <span class="hide-menu">Solicitudes de servicio técnico</span>
                                </a>
                            </li>
                            @if (isAdminMenu)
                            {
                                <li class="sidebar-item">
                                    <a asp-page="/Maintenances/Index" class="sidebar-link waves-effect waves-dark">
                                        <i class="mdi mdi-clipboard-outline"></i>
                                        <span class="hide-menu">Registros de mantenimiento</span>
                                    </a>
                                </li>
                                <li class="sidebar-item">
                                    <a asp-page="/Departures/Index" class="sidebar-link waves-effect waves-dark">
                                        <i class="mdi mdi-truck-delivery"></i>
                                        <span class="hide-menu">Salidas de equipos</span>
                                    </a>
                                </li>
                            }
                            <li class="sidebar-item">
                                <a asp-page="/Acquisitions/Index" class="sidebar-link waves-effect waves-dark">
                                    <i class="mdi mdi-cart-outline"></i>
                                    <span class="hide-menu">Solicitudes de compra</span>
                                </a>
                            </li>
                        </ul>
                    </li>

                    <li class="nav-small-cap">
                        <i class="mdi mdi-dots-horizontal"></i>
                        <span class="hide-menu">Equipos e inventario</span>
                    </li>

                    @if (isAdminMenu)
                    {
                        <li class="sidebar-item">
                            <a asp-page="/Equipment/Index" class="sidebar-link waves-effect waves-dark">
                                <i class="mdi mdi-cube-outline"></i>
                                <span class="hide-menu">Equipos</span>
                            </a>
                        </li>
                    }

                    <li class="sidebar-item">
                        <a asp-page="/AssetView/Index" class="sidebar-link waves-effect waves-dark">
                            <i class="mdi mdi-database"></i>
                            <span class="hide-menu">Inventario general</span>
                        </a>
                    </li>

                    @if (isAdminMenu)
                    {
                        <li class="sidebar-item">
                            <a asp-page="/Catalogs/Articles/Index" class="sidebar-link waves-effect waves-dark">
                                <i class="mdi mdi-package-variant-closed"></i>
                                <span class="hide-menu">Artículos</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a asp-page="/Catalogs/Stock/Index" class="sidebar-link waves-effect waves-dark">
                                <i class="mdi mdi-store"></i>
                                <span class="hide-menu">Existencias</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a asp-page="/Catalogs/ArticleCategories/Index" class="sidebar-link waves-effect waves-dark">
                                <i class="mdi mdi-tag-multiple"></i>
                                <span class="hide-menu">Categorías de artículo</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a asp-page="/Catalogs/MeasurementUnits/Index" class="sidebar-link waves-effect waves-dark">
                                <i class="mdi mdi-ruler"></i>
                                <span class="hide-menu">Unidades de medida</span>
                            </a>
                        </li>
                    }

                    <li class="nav-small-cap">
                        <i class="mdi mdi-dots-horizontal"></i>
                        <span class="hide-menu">Planificación académica</span>
                    </li>

                    <li class="sidebar-item">
                        <a asp-page="/LaboratoryOperations/Index" class="sidebar-link waves-effect waves-dark">
                            <i class="mdi mdi-view-dashboard"></i>
                            <span class="hide-menu">Panel de planificación</span>
                        </a>
                    </li>

                    <li class="sidebar-item">
                        <a asp-page="/LaboratoryOperations/Planificaciones" class="sidebar-link waves-effect waves-dark">
                            <i class="mdi mdi-format-list-numbers"></i>
                            <span class="hide-menu">Planificaciones</span>
                        </a>
                    </li>

                    <li class="sidebar-item">
                        <a asp-page="/LaboratoryOperations/Grilla" class="sidebar-link waves-effect waves-dark">
                            <i class="mdi mdi-table-large"></i>
                            <span class="hide-menu">Grilla por laboratorio</span>
                        </a>
                    </li>

                    <li class="sidebar-item">
                        <a asp-page="/LaboratoryOperations/CalendarioAcademico" class="sidebar-link waves-effect waves-dark">
                            <i class="mdi mdi-calendar-text"></i>
                            <span class="hide-menu">Calendario académico</span>
                        </a>
                    </li>

                    <li class="sidebar-item">
                        <a asp-page="/LaboratoryOperations/Reposiciones" class="sidebar-link waves-effect waves-dark">
                            <i class="mdi mdi-backup-restore"></i>
                            <span class="hide-menu">Días suspendidos y reposiciones</span>
                        </a>
                    </li>

                    <li class="sidebar-item @(isCierreActive ? "selected" : null)">
                        <a asp-page="/Cierre/Index" class="sidebar-link waves-effect waves-dark @(isCierreActive ? "active" : null)">
                            <i class="mdi mdi-clipboard-check"></i>
                            <span class="hide-menu">Cierre de práctica</span>
                        </a>
                    </li>

                    <li class="sidebar-item">
                        <a asp-page="/LaboratoryOperations/Demanda" class="sidebar-link waves-effect waves-dark">
                            <i class="mdi mdi-chart-bar"></i>
                            <span class="hide-menu">Demanda de material</span>
                        </a>
                    </li>

                    @if (isAdminMenu)
                    {
                        <li class="sidebar-item @(isMateriasActive ? "selected" : null)">
                            <a asp-page="/Catalogs/Subjects/Index" class="sidebar-link waves-effect waves-dark @(isMateriasActive ? "active" : null)">
                                <i class="mdi mdi-book-open-variant"></i>
                                <span class="hide-menu">Materias</span>
                            </a>
                        </li>

                        <li class="sidebar-item">
                            <a asp-page="/Catalogs/Practices/Index" class="sidebar-link waves-effect waves-dark">
                                <i class="mdi mdi-flask-outline"></i>
                                <span class="hide-menu">Prácticas</span>
                            </a>
                        </li>
                    }

                    @if (isAdminMenu)
                    {
                        <li class="nav-small-cap">
                            <i class="mdi mdi-dots-horizontal"></i>
                            <span class="hide-menu">Configuración</span>
                        </li>

                        <li class="sidebar-item">
                            <a asp-page="/Laboratories/Index" class="sidebar-link waves-effect waves-dark">
                                <i class="mdi mdi-home-modern"></i>
                                <span class="hide-menu">Laboratorios, facultades y carreras</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a asp-page="/Cities/Index" class="sidebar-link waves-effect waves-dark">
                                <i class="mdi mdi-earth"></i>
                                <span class="hide-menu">Ciudades y países</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a asp-page="/Users/Index" class="sidebar-link waves-effect waves-dark">
                                <i class="mdi mdi-account-multiple-outline"></i>
                                <span class="hide-menu">Usuarios y personal</span>
                            </a>
                        </li>
                    }
                }
                else
                {
                    <li class="sidebar-item selected">
                        <a asp-page="/Cierre/Index" class="sidebar-link waves-effect waves-dark active">
                            <i class="mdi mdi-clipboard-check"></i>
                            <span class="hide-menu">Cierre de práctica</span>
                        </a>
                    </li>
                }

                <li class="nav-small-cap">
                    <i class="mdi mdi-dots-horizontal"></i>
                    <span class="hide-menu">Ayuda</span>
                </li>

                <li class="sidebar-item">
                    <a href="/Ayuda" class="sidebar-link waves-effect waves-dark">
                        <i class="mdi mdi-help-circle-outline"></i>
                        <span class="hide-menu">Ayuda</span>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</aside>
