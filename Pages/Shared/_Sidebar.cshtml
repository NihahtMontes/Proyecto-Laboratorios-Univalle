                            <a asp-page="/Verifications/Index" class="sidebar-link">
                                <i class="mdi mdi-check-circle-outline"></i>
                                <span class="hide-menu"> Verificaciones (L6) </span>
                            </a>
                        </li>

                        <li class="sidebar-item">
                            <a asp-page="/Requests/Index" class="sidebar-link">
                                <i class="mdi mdi-message-text-outline"></i>
                                <span class="hide-menu"> Solicitudes de Servicio (L-7) </span>
                            </a>
                        </li>

                        <li class="sidebar-item">
                            <a asp-page="/Acquisitions/Index" class="sidebar-link">
                                <i class="mdi mdi-cart-outline"></i>
                                <span class="hide-menu"> Solicitudes de Adquisición </span>
                            </a>
                        </li>

                        <li class="sidebar-item">
                            <a asp-page="/Maintenances/Index" class="sidebar-link">
                                <i class="mdi mdi-view-quilt"></i>
                                <span class="hide-menu"> Mantenimiento (L-8) </span>
