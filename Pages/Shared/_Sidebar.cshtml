                    <i class="mdi mdi-dots-horizontal"></i>
                    <span class="hide-menu">Elementos</span>
                </li>

               
              
                <li class="sidebar-item">
                    <a class="sidebar-link has-arrow waves-effect waves-dark" href="javascript:void(0)" aria-expanded="false">
                        <i class="mdi mdi-cube-outline"></i>
                        <span class="hide-menu">Procesos </span>
                    </a>
                    <ul aria-expanded="false" class="collapse first-level">

                        <li class="sidebar-item">
                            <a class="sidebar-link waves-effect waves-dark sidebar-link" asp-page="/Managements/Index" asp-route-type="Preventive" aria-expanded="false">
                                <i class="fas fa-boxes text-info"></i>
                                <span class="hide-menu font-weight-bold uppercase">Gestiones</span>
                            </a>
                        </li>

                        <li class="sidebar-item">
                            <a class="sidebar-link waves-effect waves-dark sidebar-link" asp-page="/Index" aria-expanded="false">
                                <i class="mdi mdi-view-dashboard"></i>
                                <span class="hide-menu">Man. Preventivos</span>
                            </a>
                        </li>


                        <li class="sidebar-item">
                            <a class="sidebar-link waves-effect waves-dark sidebar-link" asp-page="/Managements/Index" asp-page-handler="CurrentCorrective" aria-expanded="false">
                                <i class="mdi mdi-view-dashboard"></i>
                                <span class="hide-menu">Man. Correctivos</span>
                            </a>
                        </li>

                </ul>
                </li>


                <li class="nav-small-cap">
                    <i class="mdi mdi-dots-horizontal"></i>
                    <span class="hide-menu">Equipos y Actividades</span>
                </li>

                <li class="sidebar-item">
                    <a asp-page="/Equipment/Index" class="sidebar-link">
                        <i class="mdi mdi-cube-outline"></i>
                        <span class="hide-menu">Equipo</span>
                    </a>
                </li>

              

               


                <li class="sidebar-item">
                    <a class="sidebar-link has-arrow waves-effect waves-dark" href="javascript:void(0)" aria-expanded="false">
