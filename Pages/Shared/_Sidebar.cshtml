@using Proyecto_Laboratorios_Univalle.Models.Enums
@using Proyecto_Laboratorios_Univalle.Helpers
@{
    var closureOnly = PracticeClosureAccess.IsClosureOnly(User);
    var currentSidebarRoute = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var isCierreActive = currentSidebarRoute.StartsWith("/Cierre", StringComparison.OrdinalIgnoreCase);
}
<aside class="left-sidebar" data-sidebarbg="skin5">
    <div class="scroll-sidebar">
        <nav class="sidebar-nav">
            <ul id="sidebarnav">
                @if (!closureOnly)
                {
                    <li class="nav-small-cap">
                    <i class="mdi mdi-dots-horizontal"></i>
                    <span class="hide-menu">Inicio</span>
                </li>

              

               @*  Aca poner lo que es el Inicio con Metricas y Filtrado de Activos *@

                <li class="sidebar-item">
                    <a asp-page="/AssetView/Index" class="sidebar-link">
                        <i class="mdi mdi-eye-outline"></i>
                        <span class="hide-menu">Ver</span>
                    </a>
                </li>

                <li class="sidebar-item">
                    <a class="sidebar-link has-arrow waves-effect waves-dark" href="javascript:void(0)" aria-expanded="false">
                        <i class="mdi mdi-calendar-check"></i>
                        <span class="hide-menu">Planificación</span>
                    </a>
                    <ul aria-expanded="false" class="collapse first-level">
                        <li class="sidebar-item">
                            <a asp-page="/LaboratoryOperations/Index" class="sidebar-link waves-effect waves-dark">
                                <i class="mdi mdi-view-dashboard"></i>
                                <span class="hide-menu">Planificación activa</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a asp-page="/LaboratoryOperations/Practicas" class="sidebar-link waves-effect waves-dark">
                                <i class="mdi mdi-format-list-checks"></i>
                                <span class="hide-menu">Prácticas</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a asp-page="/LaboratoryOperations/Planificaciones" class="sidebar-link waves-effect waves-dark">
                                <i class="mdi mdi-clipboard-text-outline"></i>
                                <span class="hide-menu">Planificaciones</span>
                            </a>
                        </li>
                        <li class="sidebar-item @(isCierreActive ? "selected" : null)">
                            <a asp-page="/Cierre/Index" class="sidebar-link waves-effect waves-dark @(isCierreActive ? "active" : null)">
                                <i class="mdi mdi-clipboard-check"></i>
                                <span class="hide-menu">Cierre de práctica</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <a asp-page="/LaboratoryOperations/Demanda" class="sidebar-link waves-effect waves-dark">
                                <i class="mdi mdi-chart-bar"></i>
                                <span class="hide-menu">Demanda</span>
