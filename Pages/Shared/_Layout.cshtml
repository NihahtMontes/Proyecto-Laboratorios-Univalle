@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var antiforgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<!DOCTYPE html>
<html dir="ltr" lang="es">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="request-verification-token" content="@antiforgeryToken">
    <title>@ViewData["Title"] - Laboratorios Univalle</title>
    <link rel="icon" type="image/png" sizes="16x16" href="~/assets/images/favicon.png">
    
        <link href="~/dist/css/style.min.css" rel="stylesheet">
            <link href="~/assets/libs/sweetalert2/dist/sweetalert2.min.css" rel="stylesheet">
    <link href="~/assets/extra-libs/c3/c3.min.css" rel="stylesheet">
    <link href="~/css/smart-index.css" rel="stylesheet" asp-append-version="true">

    <style>
        /* ===== WIZARD STEPPER GLOBAL ===== */
        .wizard-steps   { height: 70px; }
        .step-line      { border-bottom: 2px solid #e9ecef; position: absolute;
                          top: 20px; left: 10%; right: 10%; z-index: 1; }
        .step-item      { position: relative; z-index: 2;
                          text-align: center; width: 100px; }
        .step-number    { width: 40px; height: 40px; border-radius: 50%;
                          background: white; border: 2px solid #e9ecef;
                          display: flex; align-items: center; justify-content: center;
                          margin: 0 auto 5px; font-weight: bold; color: #adb5bd; }
        .step-label     { font-size: 0.75rem; font-weight: bold;
                          color: #adb5bd; display: block; }
        .step-item.active .step-number  { border-color: #f59e0b; color: #f59e0b; background: #fffcf0; }
        .step-item.active .step-label   { color: #f59e0b; }
    </style>

                @await RenderSectionAsync("Styles", required: false)
            </head>
            <body>
                <div class="preloader">
                    <div class="lds-ripple">
                        <div class="lds-pos"></div>
                        <div class="lds-pos"></div>
                    </div>
                </div>
                <div id="main-wrapper">
                    <header class="topbar">
                        <nav class="navbar top-navbar navbar-expand-md navbar-dark">
                            <div class="navbar-header">
                                <a class="nav-toggler waves-effect waves-light d-block d-md-none" href="javascript:void(0)">
                                    <i class="ti-menu ti-close"></i>
                                </a>
                                <div class="navbar-brand">
                                    <a href="/" class="logo">
                                        <b class="logo-icon">
                                            <img src="~/assets/images/logo-icon.png" alt="homepage" class="dark-logo" />
                                            <img src="~/assets/images/logo-light-icon.png" alt="homepage" class="light-logo" />
                                        </b>
                                        <span class="logo-text">
                                            <span class="font-weight-bold text-white" style="font-size: 1.1rem; letter-spacing: 1px;">LABORATORIOS</span>
                                        </span>
                                    </a>
                                    <a class="sidebartoggler d-none d-md-block" href="javascript:void(0)" data-sidebartype="mini-sidebar">
                                        <i class="mdi mdi-toggle-switch mdi-toggle-switch-off font-20"></i>
                                    </a>
                                </div>
                            </div>

                            <div class="navbar-collapse collapse" id="navbarSupportedContent">
                                <ul class="navbar-nav float-left mr-auto">
                                    <li class="nav-item search-box">
                                        <a class="nav-link waves-effect waves-dark" href="javascript:void(0)">
                                            <div class="d-flex align-items-center">
                                                <i class="mdi mdi-magnify font-20 mr-1"></i>
                                                <div class="ml-1 d-none d-sm-block"><span>Buscar</span></div>
                                            </div>
                                        </a>
                                        <form class="app-search position-absolute">
                                            <input type="text" class="form-control" placeholder="Buscar &amp; enter">
                                            <a class="srh-btn"><i class="ti-close"></i></a>
                                        </form>
                                    </li>
                                </ul>

                                @{
                                    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
                                    bool showBell = User.Identity != null && User.Identity.IsAuthenticated;

                                    var notificationManagementId = ViewData["ManagementId"]?.ToString() ?? "";
                                    if (string.IsNullOrWhiteSpace(notificationManagementId) && currentPage.StartsWith("/Managements"))
                                    {
                                        notificationManagementId = Context.Request.Query["id"].ToString();
                                    }
                                    var notificationManagementType = ViewData["ManagementType"]?.ToString() ?? Context.Request.Query["ManagementType"].ToString();
                                    var notificationScope =
                                        currentPage == "/Index" || currentPage == "/" || currentPage == "" || currentPage.StartsWith("/Managements") ? "dashboard" :
                                        currentPage.StartsWith("/Maintenances") || currentPage.StartsWith("/Kardex") || currentPage.EndsWith("/Kardex") ? "maintenance" :
                                        currentPage.StartsWith("/LaboratoryOperations") ? "planning" :
                                        currentPage.StartsWith("/Acquisitions") ? "acquisition" :
                                        currentPage.StartsWith("/Departures") ? "departure" :
                                        currentPage.StartsWith("/Requests") ? "request" :
                                        currentPage.StartsWith("/Notifications") ? "all" :
                                        "dashboard";
                                }

                                <ul class="navbar-nav float-right">
                                    @if (showBell)
                                    {
                                        <li class="nav-item dropdown" id="notificationDropdown">
                                            <a class="nav-link dropdown-toggle waves-effect waves-dark" href="" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                                <i class="mdi mdi-bell font-24"></i>
                                                <span class="badge badge-danger badge-pill rounded-circle" id="notificationCount" style="position: absolute; top: 15px; right: 5px; font-size: 10px; display: none;">0</span>
                                            </a>
                                            <div class="dropdown-menu dropdown-menu-right mailbox animated bounceInDown" style="min-width: 380px; max-width: 420px;">
                                                @Html.AntiForgeryToken()
                                                <div class="p-3 border-bottom">
                                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                                        <h6 class="font-weight-bold mb-0"><i class="fas fa-bell mr-2 text-warning"></i> Notificaciones</h6>
                                                        <button type="button" class="btn btn-sm btn-link text-muted p-0" id="btnMarkAllRead" title="Marcar todas como leídas">
                                                            <i class="fas fa-check-double mr-1"></i> Marcar leídas
                                                        </button>
                                                    </div>
                                                    <div id="notificationCounters" class="d-flex flex-wrap gap-2 small" style="display: none;"></div>
                                                </div>
                                                <div id="notificationList" style="max-height: 400px; overflow-y: auto;">
                                                    <div class="text-center text-muted p-4 small">
                                                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                                        <div class="mt-2">Cargando notificaciones...</div>
                                                    </div>
                                                </div>
                                                <div class="text-center border-top py-2">
                                                    <a href="/Notifications" class="small font-weight-bold text-primary text-decoration-none">
                                                        <i class="fas fa-chevron-right mr-1"></i> Ver todas las notificaciones
                                                    </a>
                                                </div>
                                            </div>
                                        </li>
                                    }

                                    @await Component.InvokeAsync("UserProfile")
                                    </ul>
                                </div>
                            </nav>
                        </header>
                        <partial name="_Sidebar" />

                        <div class="page-wrapper">
                            @if (!(ViewData["HidePageTitle"] is bool hidePageTitle && hidePageTitle))
                            {
                                <div class="page-breadcrumb">
                                    <div class="row">
                                        <div class="col-5 align-self-center">
                                            <h4 class="page-title">@ViewData["Title"]</h4>
                                        </div>
                                    </div>
                                </div>
                            }
                            <div class="container-fluid">
                                @RenderBody()
                            </div>
                            <footer class="footer text-center">
                            </footer>
                        </div>
                    </div>
    
                    <script src="~/assets/libs/jquery/dist/jquery.min.js"></script>
                    <script src="~/assets/libs/popper.js/dist/umd/popper.min.js"></script>
                    <script src="~/assets/libs/bootstrap/dist/js/bootstrap.min.js"></script>
                    <script src="~/dist/js/app.min.js"></script>
                    <script src="~/dist/js/app.init.js"></script>
                    <script src="~/dist/js/app-style-switcher.js"></script>
                    <script src="~/assets/libs/perfect-scrollbar/dist/perfect-scrollbar.jquery.min.js"></script>
                    <script src="~/assets/extra-libs/sparkline/sparkline.js"></script>
                    <script src="~/dist/js/waves.js"></script>
                    <script src="~/dist/js/sidebarmenu.js"></script>
                    <script src="~/dist/js/custom.min.js"></script>
                    <script src="~/assets/libs/sweetalert2/dist/sweetalert2.all.min.js"></script>
                    <script src="~/assets/extra-libs/c3/d3.min.js"></script>
                    <script src="~/assets/extra-libs/c3/c3.min.js"></script>

                    @* INTERPRETADOR GLOBAL DE NOTIFICACIONES SWEETALERT2 *@
                    <script>
                            $(function () {
                                const Toast = Swal.mixin({
                                    toast: true,
                                    position: 'top-end',
                                    showConfirmButton: false,
                                    timer: 4000,
                                    timerProgressBar: true
                                });

                                @{
                                    var successMessage = TempData["SuccessMessage"] ?? TempData["Success"];
                                    var errorMessage = TempData["ErrorMessage"] ?? TempData["Error"];
                                    var warningMessage = TempData["WarningMessage"] ?? TempData["Warning"];
                                    var infoMessage = TempData["InfoMessage"] ?? TempData["Info"];

                                    var successMessageJson = System.Text.Json.JsonSerializer.Serialize(successMessage?.ToString() ?? string.Empty);
                                    var errorMessageJson = System.Text.Json.JsonSerializer.Serialize(errorMessage?.ToString() ?? string.Empty);
                                    var warningMessageJson = System.Text.Json.JsonSerializer.Serialize(warningMessage?.ToString() ?? string.Empty);
                                    var infoMessageJson = System.Text.Json.JsonSerializer.Serialize(infoMessage?.ToString() ?? string.Empty);
                                }

                                @if (successMessage != null)
                                {
                                        <text>
                                            Toast.fire({
                                                icon: 'success',
                                                title: @Html.Raw(successMessageJson)
                                            });
                                        </text>
                                }

                                @if (errorMessage != null)
                                {
                                        <text>
                                            Swal.fire({
                                                icon: 'error',
                                                title: '¡Ups!',
                                                text: @Html.Raw(errorMessageJson),
                                                confirmButtonColor: '#2962ff'
                                            });
                                        </text>
                                }

                                @if (warningMessage != null)
                                {
                                        <text>
                                            Swal.fire({
                                                icon: 'warning',
                                                title: 'Atención',
                                                text: @Html.Raw(warningMessageJson),
                                                confirmButtonColor: '#ffc107'
                                            });
                                        </text>
                                }

                                @if (infoMessage != null)
                                {
                                        <text>
                                            Toast.fire({
                                                icon: 'info',
                                                title: @Html.Raw(infoMessageJson)
                                            });
                                        </text>
                                }
                            });
                    </script>

                    <script src="~/js/site.js" asp-append-version="true"></script>
                    @await RenderSectionAsync("Scripts", required: false)

                    @if (showBell)
                    {
                        <script>
                                $(function() {
                                    const managementId = '@notificationManagementId';
                                    const managementType = '@notificationManagementType';
                                    const notificationScope = '@notificationScope';
                                    const LS_SNOOZE_KEY = 'postponed_notifications';

                                    // ─── Fecha local (yyyy-mm-dd) ───
                                    function localDateKey() {
                                        return new Date().toLocaleDateString('en-CA');
                                    }

                                    // ─── Posponer calculados: ocultos solo el día en que se pospusieron ───
                                    function getSnoozedMap() {
                                        try {
                                            const raw = localStorage.getItem(LS_SNOOZE_KEY);
                                            if (!raw) return {};
                                            const data = JSON.parse(raw);
                                            if (!data || typeof data !== 'object') return {};
                                            const today = localDateKey();
                                            const clean = {};
                                            for (const [key, date] of Object.entries(data)) {
                                                if (typeof date === 'string' && date === today) clean[key] = date;
                                            }
                                            return clean;
                                        } catch { return {}; }
                                    }

                                    function snoozeSynthetic(syntheticKey) {
                                        if (!syntheticKey) return;
                                        try {
                                            const data = getSnoozedMap();
                                            data[syntheticKey] = localDateKey();
                                            localStorage.setItem(LS_SNOOZE_KEY, JSON.stringify(data));
                                        } catch { }
                                    }

                                    // ─── API global reutilizable por las páginas ───
                                    window.LabNotifications = {
                                        token: function() {
                                            const $input = $('#notificationDropdown input[name="__RequestVerificationToken"]').first();
                                            if ($input.length && $input.val()) return $input.val();
                                            return $('meta[name="request-verification-token"]').attr('content') || '';
                                        },
                                        markAsRead: function(id) {
                                            id = parseInt(id, 10) || 0;
                                            if (id <= 0) return $.Deferred().resolve().promise();
                                            return $.ajax({
                                                url: '/Api/Notifications?handler=MarkAsRead',
                                                type: 'POST',
                                                data: { id: id },
                                                headers: { 'RequestVerificationToken': window.LabNotifications.token() }
                                            });
                                        },
                                        markAllAsRead: function() {
                                            return $.ajax({
                                                url: '/Api/Notifications?handler=MarkAllAsRead',
                                                type: 'POST',
                                                headers: { 'RequestVerificationToken': window.LabNotifications.token() }
                                            });
                                        },
                                        snooze: function(syntheticKey) { snoozeSynthetic(syntheticKey); },
                                        isSnoozed: function(syntheticKey) {
                                            if (!syntheticKey) return false;
                                            return !!getSnoozedMap()[syntheticKey];
                                        }
                                    };

                                    // ─── URL builder ───
                                    function getNotificationsUrl() {
                                        let url = '/Api/Notifications?handler=Unread';
                                        url += '&scope=' + encodeURIComponent(notificationScope);
                                        if (managementId) url += '&managementId=' + encodeURIComponent(managementId);
                                        if (managementType) url += '&managementType=' + encodeURIComponent(managementType);
                                        url += '&take=30';
                                        return url;
                                    }

                                    // ─── UI helpers ───
                                    function sanitizeIconClass(icon) {
                                        if (!icon || !/^[a-z0-9\-\s]+$/i.test(icon)) return 'fas fa-info-circle text-info';
                                        return icon;
                                    }

                                    function getSafeUrl(url) {
                                        if (!url || typeof url !== 'string') return '';
                                        return url.indexOf('/') === 0 && url.indexOf('//') !== 0 ? url : '';
                                    }

                                    const groupOrder = ['vencidos', 'hoy', 'proximos', 'preventivo', 'planificacion', 'prestamos', 'adquisiciones', 'otros'];
                                    const groupConfig = {
                                        vencidos:      { label: 'Vencidos',            color: 'danger',    icon: 'fas fa-exclamation-triangle' },
                                        hoy:           { label: 'Para hoy',            color: 'warning',   icon: 'fas fa-calendar-day' },
                                        proximos:      { label: 'Próximos',            color: 'info',      icon: 'fas fa-tools' },
                                        preventivo:    { label: 'Preventivo sugerido', color: 'primary',   icon: 'fas fa-calendar-check' },
                                        planificacion: { label: 'Planificación',       color: 'primary',   icon: 'fas fa-flask' },
                                        prestamos:     { label: 'Préstamos',           color: 'warning',   icon: 'fas fa-exchange-alt' },
                                        adquisiciones: { label: 'Adquisiciones',       color: 'success',   icon: 'fas fa-shopping-cart' },
                                        otros:         { label: 'Otros',               color: 'secondary', icon: 'fas fa-bell' }
                                    };

                                    function urgencyColor(urgency) {
                                        return urgency === 'danger' ? '#ef4444'
                                            : urgency === 'warning' ? '#f59e0b'
                                            : urgency === 'success' ? '#22c55e'
                                            : urgency === 'secondary' ? '#6c757d'
                                            : '#3b82f6';
                                    }

                                    // ─── Render single notification ───
                                    function renderNotificationItem(item) {
                                        const safeUrl = getSafeUrl(item.url);
                                        const cfg = groupConfig[item.group] || groupConfig.otros;
                                        const isPersisted = (parseInt(item.id, 10) || 0) > 0;

                                        const $wrap = $('<div/>', {
                                            class: 'd-flex align-items-start px-3 py-2 js-notification-item',
                                            style: 'border-left: 4px solid ' + urgencyColor(item.urgency) + '; background: ' + (item.urgency === 'danger' ? '#fef2f2' : 'transparent') + ';'
                                        });
                                        $wrap.attr('data-notification-id', item.id || 0);
                                        if (item.syntheticKey) {
                                            $wrap.attr('data-synthetic-key', item.syntheticKey);
                                        }

                                        // Icon
                                        const $iconWrap = $('<span/>', {
                                            class: 'btn btn-circle btn-light-' + cfg.color + ' mr-2 flex-shrink-0',
                                            style: 'width:36px; height:36px; line-height:36px; text-align:center;'
                                        });
                                        $('<i/>', { class: sanitizeIconClass(item.icon) }).appendTo($iconWrap);

                                        // Body
                                        const $body = $('<div/>', { class: 'flex-grow-1' });
                                        $('<div/>', { class: 'font-weight-bold text-dark small text-truncate' }).text(item.title || 'Notificación').appendTo($body);
                                        $('<div/>', { class: 'text-muted small text-truncate' }).text(item.message || '').appendTo($body);
                                        $('<div/>', { class: 'text-muted', style: 'font-size: 0.7rem;' })
                                            .append($('<i/>', { class: 'far fa-clock mr-1' }))
                                            .append(document.createTextNode(item.time || ''))
                                            .appendTo($body);

                                        // Actions
                                        const $actions = $('<div/>', { class: 'ml-2 d-flex align-items-start flex-shrink-0' });

                                        // Posponer (calculado) o marcar leída (persistido)
                                        const $actionBtn = $('<button/>', {
                                            type: 'button',
                                            class: 'btn btn-sm btn-link text-muted p-0 ml-1',
                                            title: isPersisted ? 'Marcar como leída' : 'Posponer hasta mañana',
                                            style: 'font-size: 0.8rem; line-height: 1;'
                                        }).html('<i class="' + (isPersisted ? 'fas fa-check' : 'far fa-clock') + '"></i>');
                                        $actionBtn.on('click', function(e) {
                                            e.preventDefault();
                                            e.stopPropagation();
                                            if (isPersisted) {
                                                window.LabNotifications.markAsRead(item.id).always(function() {
                                                    $wrap.fadeOut(200, function() { $(this).remove(); });
                                                    setTimeout(loadNotifications, 250);
                                                });
                                            } else if (item.syntheticKey) {
                                                window.LabNotifications.snooze(item.syntheticKey);
                                                $wrap.fadeOut(200, function() { $(this).remove(); });
                                                setTimeout(loadNotifications, 250);
                                            }
                                        });
                                        $actions.append($actionBtn);

                                        $wrap.append($iconWrap, $body, $actions);

                                        // Click on body navigates (persistido: marca leída y luego navega; calculado: navega directo)
                                        if (safeUrl) {
                                            $body.css('cursor', 'pointer').on('click', function(e) {
                                                e.preventDefault();
                                                if (isPersisted) {
                                                    window.LabNotifications.markAsRead(item.id).always(function() {
                                                        window.location.href = safeUrl;
                                                    });
                                                } else {
                                                    window.location.href = safeUrl;
                                                }
                                            });
                                        }

                                        return $wrap;
                                    }

                                    // ─── Pospuestos presentes en la lista ───
                                    function snoozedKeysIn(items) {
                                        const snoozed = getSnoozedMap();
                                        const keys = {};
                                        (items || []).forEach(function(item) {
                                            if (item.syntheticKey && snoozed[item.syntheticKey]) keys[item.syntheticKey] = true;
                                        });
                                        return keys;
                                    }

                                    function getVisibleNotifications(items) {
                                        const snoozed = getSnoozedMap();
                                        return (items || []).filter(function(item) {
                                            if (item.syntheticKey && snoozed[item.syntheticKey]) return false;
                                            return true;
                                        });
                                    }

                                    function updateBadge(count) {
                                        const $badge = $('#notificationCount');
                                        if (count > 0) {
                                            $badge.text(count).fadeIn();
                                        } else {
                                            $badge.fadeOut();
                                        }
                                    }

                                    // ─── Group and render all notifications ───
                                    function renderNotifications(items, groupCounts, totalCount) {
                                        const $list = $('#notificationList');
                                        $list.empty();

                                        const snoozedKeys = snoozedKeysIn(items);
                                        const snoozedCount = Object.keys(snoozedKeys).length;
                                        updateBadge(Math.max(0, (totalCount || 0) - snoozedCount));

                                        const filtered = getVisibleNotifications(items);
                                        if (filtered.length === 0) {
                                            $list.html(
                                                '<div class="text-center text-muted p-5">' +
                                                '<i class="fas fa-check-circle fa-3x mb-3 text-success opacity-5"></i>' +
                                                '<div class="font-weight-bold">Todo al día</div>' +
                                                '<div class="small">No tienes notificaciones nuevas.</div>' +
                                                '</div>'
                                            );
                                            return;
                                        }

                                        // Group by group
                                        const groups = {};
                                        filtered.forEach(function(item) {
                                            const g = item.group || 'otros';
                                            if (!groups[g]) groups[g] = [];
                                            groups[g].push(item);
                                        });

                                        // Render groups in order
                                        groupOrder.forEach(function(gKey) {
                                            if (!groups[gKey] || groups[gKey].length === 0) return;
                                            const cfg = groupConfig[gKey] || groupConfig.otros;

                                            // Contador del grupo (total del servidor menos pospuestos de ese grupo)
                                            var snoozedInGroup = 0;
                                            filtered.filter(function(i) { return (i.group || 'otros') === gKey; }).forEach(function(i) {
                                                if (i.syntheticKey && snoozedKeys[i.syntheticKey]) snoozedInGroup++;
                                            });
                                            const groupCount = Math.max(0, ((groupCounts && groupCounts[gKey]) || groups[gKey].length) - snoozedInGroup);

                                            // Group header
                                            var $header = $('<div/>', {
                                                class: 'd-flex align-items-center px-3 py-1',
                                                style: 'background: #f8f9fa;'
                                            });
                                            $('<small/>', {
                                                class: 'font-weight-bold text-uppercase text-' + cfg.color + ' mr-2'
                                            }).html('<i class="' + cfg.icon + ' mr-1"></i> ' + cfg.label).appendTo($header);
                                            $('<span/>', {
                                                class: 'badge badge-' + cfg.color + ' badge-pill ml-auto',
                                                style: 'font-size: 0.65rem;'
                                            }).text(groupCount).appendTo($header);
                                            $list.append($header);

                                            // Items
                                            groups[gKey].forEach(function(item) {
                                                $list.append(renderNotificationItem(item));
                                            });
                                        });
                                    }

                                    // ─── Update counters (chips por grupo) ───
                                    function updateCounters(items, groupCounts) {
                                        const snoozedKeys = snoozedKeysIn(items);
                                        const $el = $('#notificationCounters');
                                        $el.empty();
                                        var hasCounters = false;
                                        groupOrder.forEach(function(gKey) {
                                            const total = (groupCounts && groupCounts[gKey]) || 0;
                                            if (!total) return;
                                            var snoozedInGroup = 0;
                                            (items || []).forEach(function(i) {
                                                if ((i.group || 'otros') === gKey && i.syntheticKey && snoozedKeys[i.syntheticKey]) snoozedInGroup++;
                                            });
                                            const visible = Math.max(0, total - snoozedInGroup);
                                            if (visible <= 0) return;
                                            hasCounters = true;
                                            const cfg = groupConfig[gKey] || groupConfig.otros;
                                            $('<span/>', {
                                                class: 'text-' + cfg.color
                                            }).html('<i class="' + cfg.icon + ' mr-1"></i>' + visible).appendTo($el);
                                        });
                                        $el.css('display', hasCounters ? 'flex' : 'none');
                                    }

                                    // ─── Toast "en pantalla": una vez por día y ámbito ───
                                    function maybeShowCriticalToast(items, groupCounts, data) {
                                        try {
                                            const today = localDateKey();
                                            // La página de planificación muestra su propio aviso.
                                            if (sessionStorage.getItem('lab-planning-notif-' + today)) return;

                                            const toastMarkKey = 'notif-toast-' + notificationScope + '-' + today;
                                            if (sessionStorage.getItem(toastMarkKey)) return;

                                            const snoozedKeys = snoozedKeysIn(items);
                                            var snoozedCritical = 0;
                                            var snoozedOverdue = 0;
                                            (items || []).forEach(function(item) {
                                                if (!item.syntheticKey || !snoozedKeys[item.syntheticKey]) return;
                                                if (item.urgency === 'danger' || item.urgency === 'warning') snoozedCritical++;
                                                if (item.group === 'vencidos') snoozedOverdue++;
                                            });

                                            const criticalCount = Math.max(0, ((data && data.criticalCount) || 0) - snoozedCritical);
                                            if (criticalCount <= 0) return;

                                            const overdueCount = Math.max(0, ((groupCounts && groupCounts.vencidos) || 0) - snoozedOverdue);
                                            const restCount = Math.max(0, criticalCount - overdueCount);

                                            const parts = [];
                                            if (overdueCount > 0) parts.push(overdueCount + ' vencido(s)');
                                            if (restCount > 0) parts.push(restCount + ' para hoy');
                                            const summary = parts.length > 0 ? parts.join(' · ') : criticalCount + ' requiere(n) atención';

                                            const openBell = function() {
                                                $('#notificationDropdown [data-toggle="dropdown"]').dropdown('toggle');
                                            };

                                            const CriticalToast = Swal.mixin({
                                                toast: true,
                                                position: 'top-end',
                                                timer: 7000,
                                                showConfirmButton: false,
                                                timerProgressBar: true,
                                                onOpen: function(el) { if (el && el.addEventListener) el.addEventListener('click', openBell); },
                                                didOpen: function(el) { if (el && el.addEventListener) el.addEventListener('click', openBell); }
                                            });

                                            CriticalToast.fire({
                                                icon: overdueCount > 0 ? 'error' : 'warning',
                                                title: 'Tienes ' + criticalCount + ' aviso' + (criticalCount === 1 ? '' : 's') + ' que ' + (criticalCount === 1 ? 'requiere' : 'requieren') + ' atención',
                                                text: summary
                                            });

                                            sessionStorage.setItem(toastMarkKey, '1');
                                        } catch { }
                                    }

                                    // ─── Load notifications ───
                                    var firstLoadDone = false;
                                    function loadNotifications() {
                                        $.get(getNotificationsUrl(), function(data) {
                                            const items = data.items || [];
                                            const groupCounts = data.groupCounts || {};
                                            renderNotifications(items, groupCounts, data.count || 0);
                                            updateCounters(items, groupCounts);
                                            if (!firstLoadDone) {
                                                firstLoadDone = true;
                                                maybeShowCriticalToast(items, groupCounts, data);
                                            }
                                        });
                                    }

                                    // ─── Actions ───
                                    $('#btnMarkAllRead').on('click', function() {
                                        window.LabNotifications.markAllAsRead().always(function() {
                                            // Posponer los calculados visibles.
                                            $('#notificationList [data-synthetic-key]').each(function() {
                                                const key = $(this).attr('data-synthetic-key');
                                                if (key) snoozeSynthetic(key);
                                            });
                                            loadNotifications();
                                        });
                                    });

                                    // ─── Init: recarga cada 60 s solo con pestaña visible; recarga al volver ───
                                    loadNotifications();
                                    setInterval(function() {
                                        if (document.visibilityState === 'visible') loadNotifications();
                                    }, 60000);
                                    document.addEventListener('visibilitychange', function() {
                                        if (document.visibilityState === 'visible') loadNotifications();
                                    });
                                });
                        </script>
                    }
                </body>
            </html>
