@model int

@{
    var isCorrective = (bool)(ViewData["IsCorrective"] ?? false);
    var steps = isCorrective
        ? new[] { "L7 Solicitud", "L8 Mantenimiento", "L3 Salida", "Kardex", "Desembolso" }
        : new[] { "L6 Verificación", "L7 Solicitud", "L8 Mantenimiento", "L3 Salida", "Kardex", "Desembolso" };
}
    
<div class="wizard-steps mb-4 d-flex justify-content-between position-relative mt-2 px-5">
    <div class="step-line"></div>

    @for (int i = 0; i < steps.Length; i++)
    {
        int stepNumber  = isCorrective ? (i + 2) : (i + 1);
        bool isActive   = stepNumber == Model;
        bool isComplete = stepNumber < Model;

        string numberStyle = isComplete
            ? "background:#28a745; color:white; border-color:#28a745;"
            : "";
        string itemClass   = isActive ? "step-item active" : "step-item";
            
        <div class="@itemClass">
            <span class="step-number" style="@numberStyle">
                @if (isComplete)
                {
                    <i class="fas fa-check"></i>
                }
                else
                {
                    @(i + 1)
                }
            </span>
            <span class="step-label">@steps[i]</span>
        </div>
    }
</div>
