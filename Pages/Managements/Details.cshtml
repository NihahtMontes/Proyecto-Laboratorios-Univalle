    <!-- ===== TAB: EDITAR ===== -->
    @if (Model.ActiveTab == "editar")
    {
        <div class="card shadow-sm border-0 p-4" style="max-width:640px;">
            <h5 class="wizard-title mb-3">Editar Gestión</h5>
            <p class="text-muted small mb-4">Modifica los campos de la gestión activa con cuidado. Los cambios quedan registrados en la auditoría del sistema.</p>
            <a asp-page="./Edit" asp-route-id="@Model.Management.Id"
               class="btn btn-outline-primary rounded-pill px-4 font-weight-bold">
                <i class="fas fa-edit mr-2"></i>Ir al formulario de edición
            </a>
        </div>
    }

</div>

@section Scripts {

    <script src="~/assets/extra-libs/sweetalert2/sweetalert2.all.min.js"></script>
    <script>
        function confirmRedoPhase(planId, targetPhase, targetPhaseName, currentPhase) {
            Swal.fire({
                title: '¿Rehacer Fase?',
                html: 'Está intentando retroceder el equipo a la fase <b>' + targetPhaseName + '</b>.<br>Se borrarán los registros posteriores al paso ' + targetPhase + '.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Sí, rehacer y limpiar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    const form = document.createElement('form');
                    form.method = 'POST';
                    form.action = '/Index?handler=RedoPhase';
                    
                    const p1 = document.createElement('input'); p1.type = 'hidden'; p1.name = 'planId'; p1.value = planId;
                    const p2 = document.createElement('input'); p2.type = 'hidden'; p2.name = 'targetPhase'; p2.value = targetPhase;
                    
                    // Necesitamos el RequestVerificationToken
                    const token = document.querySelector('input[name="__RequestVerificationToken"]');
                    if(token) form.appendChild(token.cloneNode(true));

                    form.appendChild(p1);
                    form.appendChild(p2);
                    document.body.appendChild(form);
                    form.submit();
                }
            });
        }

        async function toggleWeek(planId, weekNumber, type) {
            const formData = new FormData();
            formData.append('planId', planId);
            formData.append('weekNumber', weekNumber);
            formData.append('type', type);

            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) {
                formData.append('__RequestVerificationToken', token.value);
            }

            try {
                const response = await fetch('?handler=ToggleWeek', {
                    method: 'POST',
                    body: formData
                });

                if (response.ok) {
                    const result = await response.json();
                    if (!result.success) {
                        Swal.fire({ icon: 'warning', title: 'Regla de negocio', text: result.error, confirmButtonColor: '#f59e0b' });
                        return;
                    }

                    // Update UI immediately without reload
                    // Clear all in this row
                    for (let i = 1; i <= 8; i++) {
                        const cell = document.getElementById(`badge-${type}-${planId}`);
                        if (cell) cell.remove();
                        const placeholder = document.getElementById(`placeholder-${type}-${planId}-${i}`);
                        if (!placeholder && i !== weekNumber) {
                            // Needs placeholder back
                            const td = document.querySelector(`td[onclick="toggleWeek(${planId}, ${i}, '${type}')"]`);
                            if(td) td.innerHTML = `<span id="placeholder-${type}-${planId}-${i}" style="display:inline-block; width:100%; height:100%;"></span>`;
                        }
                    }

                    // Toggle logic
                    const td = document.querySelector(`td[onclick="toggleWeek(${planId}, ${weekNumber}, '${type}')"]`);
                    const isCurrentlyActive = td.innerHTML.includes(`badge-${type}-${planId}`);
                    
                    if (isCurrentlyActive) {
                        td.innerHTML = `<span id="placeholder-${type}-${planId}-${weekNumber}" style="display:inline-block; width:100%; height:100%;"></span>`;
                    } else {
                        const badgeClass = type === 'planned' ? 'bg-primary' : 'bg-success';
                        const badgeText = type === 'planned' ? 'Prev.' : 'Ejec.';
                        td.innerHTML = `<span id="badge-${type}-${planId}" class="badge ${badgeClass} text-white px-2 py-1 rounded" style="font-size:0.6rem;">${badgeText}</span>`;
                    }
                } else {
                    Swal.fire('Error', 'No se pudo actualizar el cronograma.', 'error');
                }
            } catch (err) {
                console.error(err);
                Swal.fire('Error', 'Hubo un error de conexión.', 'error');
            }
        }
    </script>

    <!-- Dashboard Charts (Chart.js 3.x) -->
    @if (Model.ActiveTab == "dashboard" || Model.ActiveTab == "")
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                // Global Donut
                const ctxGlobal = document.getElementById('globalProgressChart');
                if (ctxGlobal) {
                    new Chart(ctxGlobal.getContext('2d'), {
                        type: 'doughnut',
                        data: {
                            datasets: [{
                                data: [@Model.Management.CompletionPercentage, @(100 - Model.Management.CompletionPercentage)],
                                backgroundColor: ['#2eca6a', '#e2e8f0'],
                                borderWidth: 0
                            }]
                        },
                        options: {
                            responsive: true, maintainAspectRatio: false, cutout: '72%',
                            plugins: { legend: { display: false }, tooltip: { enabled: false } }
                        }
                    });
                }

                @if (Model.TopEquipmentTypes.Any())
                {
                    <text>
                    const ctxType = document.getElementById('typeProgressChart');
                    if (ctxType) {
                        new Chart(ctxType.getContext('2d'), {
                            type: 'bar',
                            data: {
                                labels: @Html.Raw(JsonSerializer.Serialize(Model.TopEquipmentTypes.Keys)),
                                datasets: [{
                                    data: @Html.Raw(JsonSerializer.Serialize(Model.TopEquipmentTypes.Values)),
                                    backgroundColor: ['#3B82F6','#F59E0B','#8B5CF6','#EC4899','#10B981'],
                                    borderRadius: 4, barThickness: 14
                                }]
                            },
                            options: {
                                indexAxis: 'y', responsive: true, maintainAspectRatio: false,
                                plugins: { legend: { display: false } },
                                scales: {
                                    x: { display: false, beginAtZero: true },
                                    y: { grid: { display: false }, border: { display: false },
                                         ticks: { color: '#64748b', font: { size: 10 } } }
                                }
                            }
                        });
                    }
                    </text>
                }

                @if (Model.TopLaboratories.Any())
                {
                    <text>
                    const ctxLab = document.getElementById('labProgressChart');
                    if (ctxLab) {
                        new Chart(ctxLab.getContext('2d'), {
                            type: 'bar',
                            data: {
                                labels: @Html.Raw(JsonSerializer.Serialize(Model.TopLaboratories.Keys)),
                                datasets: [{
                                    data: @Html.Raw(JsonSerializer.Serialize(Model.TopLaboratories.Values)),
                                    backgroundColor: ['#2eca6a','#f43f5e','#3b82f6','#f59e0b','#8b5cf6'],
                                    borderRadius: 4, barThickness: 14
                                }]
                            },
                            options: {
                                indexAxis: 'y', responsive: true, maintainAspectRatio: false,
                                plugins: { legend: { display: false } },
                                scales: {
                                    x: { display: false, beginAtZero: true },
                                    y: { grid: { display: false }, border: { display: false },
                                         ticks: { color: '#64748b', font: { size: 10 } } }
                                }
                            }
                        });
                    }
                    </text>
                }
            });
        </script>
    }

    <!-- FullCalendar v3 (solo cuando el tab es "calendario") -->
    @if (Model.ActiveTab == "calendario")
    {
        <link href="~/assets/libs/fullcalendar/dist/fullcalendar.min.css" rel="stylesheet" />
        <style>
            /* Estilos custom para eventos del calendario */
            .fc-event.ev-completed { background:#2eca6a !important; border-color:#25a85c !important; color:#fff !important; }
            .fc-event.ev-progress  { background:#f59e0b !important; border-color:#d97706 !important; color:#fff !important; }
            .fc-event.ev-planned   { background:#6366f1 !important; border-color:#4f46e5 !important; color:#fff !important; }
            /* Sombreado de 8 semanas */
            .fc-bgevent { opacity: 0.15 !important; }
            /* Hover en día para indicar que es clickeable */
            .fc-day:hover { background: rgba(99,102,241,0.04); cursor: pointer; }
            /* Evento más compacto */
            .fc-event { font-size: 0.72rem; padding: 2px 5px; border-radius: 4px; margin-bottom: 1px; }
            /* More link */
            .fc-more { font-size: 0.7rem; font-weight: 700; color: #6366f1; }
            /* Day detail item */
            .day-detail-item { display:flex; align-items:center; padding:12px 20px; border-bottom:1px solid #f1f5f9; transition:background 0.15s; }
            .day-detail-item:hover { background:#f8fafc; }
            .day-detail-item:last-child { border-bottom:none; }
            .day-detail-status { width:8px; height:8px; border-radius:50%; margin-right:12px; flex-shrink:0; }
            .day-detail-status.st-completed { background:#2eca6a; }
            .day-detail-status.st-progress  { background:#f59e0b; }
            .day-detail-status.st-planned   { background:#6366f1; }
            .day-detail-actions .btn { font-size:0.72rem; padding:3px 10px; }
            .day-detail-empty { padding:40px 20px; text-align:center; color:#94a3b8; }
        </style>
        <script src="~/assets/libs/moment/min/moment.min.js"></script>
        <script src="~/assets/libs/fullcalendar/dist/fullcalendar.min.js"></script>
        <script>
            // Configurar moment.js en español
            moment.locale('es', {
                months: 'Enero_Febrero_Marzo_Abril_Mayo_Junio_Julio_Agosto_Septiembre_Octubre_Noviembre_Diciembre'.split('_'),
                monthsShort: 'Ene_Feb_Mar_Abr_May_Jun_Jul_Ago_Sep_Oct_Nov_Dic'.split('_'),
                weekdays: 'Domingo_Lunes_Martes_Miércoles_Jueves_Viernes_Sábado'.split('_'),
                weekdaysShort: 'Dom_Lun_Mar_Mié_Jue_Vie_Sáb'.split('_'),
                weekdaysMin: 'Do_Lu_Ma_Mi_Ju_Vi_Sá'.split('_')
            });

            $(document).ready(function () {
                var allEvents = @Html.Raw(JsonSerializer.Serialize(Model.CalendarEvents));
                var shadingStart = '@Model.ShadingStart';
                var shadingEnd   = '@Model.ShadingEnd';
                var mgmtId       = @Model.Management.Id;

                // Preparar eventos para FullCalendar
                var calEvents = allEvents.map(function (e) {
                    return {
                        title:     e.Title,
                        start:     e.Start,
                        end:       e.End,
                        className: e.ClassName,
                        // Datos extra para el panel
                        _raw: e
                    };
                });

                // Bloque de sombreado de 8 semanas
                if (shadingStart && shadingEnd) {
                    calEvents.push({
                        start:     shadingStart,
                        end:       shadingEnd,
                        rendering: 'background',
                        color:     '#6366f1',
                        _isBg:     true
                    });
                }

                // FullCalendar init
                $('#calendar').fullCalendar({
                    header: {
                        left:   'prev,next today',
                        center: 'title',
                        right:  'month,agendaWeek'
                    },
                    locale:           'es',
                    editable:         false,
                    droppable:        false,
                    displayEventTime: false,
                    eventLimit:       3, // +X more cuando hay muchos
                    events:           calEvents,
                    dayClick: function (date, jsEvent, view) {
                        openDayPanel(date.format('YYYY-MM-DD'), allEvents);
                    },
                    eventClick: function (event, jsEvent, view) {
                        if (event._isBg) return false;
                        // Click en evento individual → abrir panel del día
                        openDayPanel(event.start.format('YYYY-MM-DD'), allEvents);
                        return false;
                    },
                    eventRender: function (event, element) {
                        if (event._isBg) return;
                        element.attr('title', event._raw ? event._raw.Title + ' — ' + event._raw.LabName : event.title);
                    }
                });

                // ============ ZOOM ============
                var zoomLevel = 1.0;
                var $wrapper = $('#calendarZoomWrapper');
                var $label   = $('#calZoomReset');

                function applyZoom() {
                    $wrapper.css('transform', 'scale(' + zoomLevel + ')');
                    $label.text(Math.round(zoomLevel * 100) + '%');
                }
                $('#calZoomIn').click(function () {
                    if (zoomLevel < 1.5) { zoomLevel += 0.1; applyZoom(); }
                });
                $('#calZoomOut').click(function () {
                    if (zoomLevel > 0.5) { zoomLevel -= 0.1; applyZoom(); }
                });
                $label.click(function () {
                    zoomLevel = 1.0; applyZoom();
                });

                // ============ PANEL DE DÍA ============
                function openDayPanel(dateStr, events) {
                    var dayEvents = events.filter(function (e) { return e.Start === dateStr; });
                    var dateLabel = moment(dateStr).format('dddd D [de] MMMM, YYYY');

                    $('#dayDetailTitle').text('Mantenimientos programados');
                    $('#dayDetailSubtitle').text(dateLabel + ' — ' + dayEvents.length + ' equipo(s)');

                    var $body = $('#dayDetailBody');
                    $body.empty();

                    if (dayEvents.length === 0) {
                        $body.html('<div class="day-detail-empty"><i class="fas fa-calendar-check fa-2x mb-3 d-block" style="color:#cbd5e1;"></i>No hay mantenimientos para este día</div>');
                    } else {
                        dayEvents.forEach(function (ev) {
                            var statusClass = ev.ClassName === 'ev-completed' ? 'st-completed' : ev.ClassName === 'ev-progress' ? 'st-progress' : 'st-planned';
                            var detailUrl = ev.MaintenanceId ? '/Maintenances/Details/' + ev.MaintenanceId : '/Managements/Details?id=' + mgmtId + '&ActiveTab=l48';
                            var editUrl   = ev.MaintenanceId ? '/Maintenances/Edit?id=' + ev.MaintenanceId : null;

                            var html = '<div class="day-detail-item">';
                            html += '<span class="day-detail-status ' + statusClass + '"></span>';
                            html += '<div style="flex:1;min-width:0;">';
                            html += '<div class="font-weight-bold text-truncate" style="font-size:0.88rem;">' + ev.Title + '</div>';
                            html += '<div class="text-muted" style="font-size:0.75rem;">Inv: ' + ev.InventoryNumber + ' · ' + ev.LabName + ' · ' + ev.TechnicianName + '</div>';
                            html += '</div>';
                            html += '<div class="day-detail-actions ml-2 d-flex">';
                            html += '<a href="' + detailUrl + '" class="btn btn-outline-primary btn-sm mr-1" title="Ver detalle"><i class="fas fa-eye"></i></a>';
                            if (editUrl) {
                                html += '<a href="' + editUrl + '" class="btn btn-outline-warning btn-sm mr-1" title="Editar"><i class="fas fa-edit"></i></a>';
                                if (ev._raw && ev._raw.CurrentPhaseInt > 3) {
                                    html += '<button type="button" class="btn btn-outline-danger btn-sm" title="Rehacer Mantenimiento" onclick="confirmRedoPhase(' + ev._raw.PlanId + ', 3, \'L-8 Mantenimiento\', ' + ev._raw.CurrentPhaseInt + ')"><i class="fas fa-undo"></i></button>';
                                }
                            }
                            html += '</div></div>';
                            $body.append(html);
                        });
                    }

                    $('#dayDetailModal').modal('show');
                }
            });
        </script>
    }

    <!-- Tabla L-48: ordernamiento por columna -->
    @if (Model.ActiveTab == "l48")
    {
        <script>
            document.querySelectorAll('#tableL48 thead tr:first-child th').forEach(function (th, i) {
                th.style.cursor = 'pointer';
                th.title = 'Haz clic para ordenar';
                th.addEventListener('click', function () {
                    var table  = document.getElementById('tableL48');
                    var rows   = Array.from(table.querySelectorAll('tbody tr:nth-child(odd)'));
                    var sorted = rows.sort(function (a, b) {
                        var aText = (a.cells[i] ? a.cells[i].innerText : '').trim();
                        var bText = (b.cells[i] ? b.cells[i].innerText : '').trim();
                        return aText.localeCompare(bText, 'es');
                    });
                    var tbody = table.querySelector('tbody');
                    tbody.innerHTML = '';
                    sorted.forEach(function (row) { tbody.appendChild(row); });
                });
            });
        </script>
    }
}
