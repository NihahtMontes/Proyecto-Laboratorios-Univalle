@page
@model Proyecto_Laboratorios_Univalle.Pages.Managements.DetailsModel
@using Proyecto_Laboratorios_Univalle.Models.Enums
@using System.Text.Json
@{
    ViewData["Title"] = $"{(Model.Management.Type == ManagementType.Corrective ? "Mantenimiento Correctivo" : "Mantenimiento Preventivo")} {Model.Management.Code}";
    var isManagementActive = Model.Management.Status == ManagementStatus.Active;
    // Variables L-48 (usadas solo cuando ActiveTab == l48, declaradas aqui para evitar RZ1010)
    var l48Sem      = Model.Management.Semester;
    var l48Year     = Model.Management.Year;
    var l48Col1Name = l48Sem == 1 ? $"Jun {l48Year}" : $"Dic {l48Year}";
    var l48Col2Name = l48Sem == 1 ? $"Jul {l48Year}" : $"Ene {l48Year + 1}";
    var isCorrective = Model.Management.Type == ManagementType.Corrective;
    var globalProgressJs = Model.GlobalProgress.ToString(System.Globalization.CultureInfo.InvariantCulture);
    var remainingProgressJs = Math.Max(0, 100 - Model.GlobalProgress).ToString(System.Globalization.CultureInfo.InvariantCulture);
}

@section Styles {
    <style> 
        /* Badge soft colors */
        .badge-soft-success { background: #d1fae5; color: #065f46; }
        .badge-soft-danger  { background: #fef2f2; color: #991b1b; }

        /* Wizard utilities (same as Index) */
        .wizard-title    { font-size: 1.5rem; font-weight: 800; color: #012970; }
        .wizard-subtitle { font-size: 0.85rem; color: #899bbd; }

        /* Metric tiles (modern style from AssetView) */
        .asset-metric-tile {
            min-height: 134px;
            border-radius: 8px;
            color: #fff;
            box-shadow: 0 10px 24px rgba(15, 23, 42, .12);
            overflow: hidden;
            position: relative;
            transition: transform .18s ease, box-shadow .18s ease;
            display: block;
            text-decoration: none !important;
        }
        .asset-metric-tile:hover { transform: translateY(-3px); box-shadow: 0 16px 30px rgba(15, 23, 42, .16); }
        .asset-metric-tile:after {
            content: "";
            width: 96px; height: 96px;
            border-radius: 50%;
            background: rgba(255, 255, 255, .14);
            position: absolute;
            right: -24px; top: -24px;
        }
        .asset-metric-icon {
            width: 42px; height: 42px;
            border-radius: 50%;
            background: rgba(255, 255, 255, .18);
            display: inline-flex; align-items: center; justify-content: center;
            font-size: 18px;
        }
        .asset-metric-value {
            font-size: 2rem;
            line-height: 1;
            letter-spacing: 0;
        }
        .asset-bg-blue   { background: linear-gradient(135deg, #2962ff, #36a3ff); }
        .asset-bg-green  { background: linear-gradient(135deg, #00c292, #48d65b); }
        .asset-bg-amber  { background: linear-gradient(135deg, #ffb22b, #ff8f00); }
        .asset-bg-purple { background: linear-gradient(135deg, #7460ee, #a163f7); }
        .asset-bg-red    { background: linear-gradient(135deg, #f62d51, #ff6b6b); }
        .asset-bg-cyan   { background: linear-gradient(135deg, #03a9f3, #4fc3f7); }
        .asset-bg-slate  { background: linear-gradient(135deg, #475569, #64748b); }

        /* Nav tabs override */
        .nav-tabs .nav-link { color: #64748b; font-weight: 600; }
        .nav-tabs .nav-link.active { color: #012970; font-weight: 700; border-bottom: 2px solid #4154f1; }

        /* Chart containers */
        .chart-container-detail { height: 240px; position: relative; }

        /* L-48 table */
        #tableL48 thead th { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.04em; }
        #tableL48 tbody td { vertical-align: middle; }
    </style>
}

<div class="container-fluid py-4">

    <!-- CABECERA DE LA GESTIÓN -->
    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap">
        <div>
            <h1 class="wizard-title mb-1">@(isCorrective ? "Mantenimiento Correctivo" : "Mantenimiento Preventivo") @Model.Management.Code</h1>
            <p class="wizard-subtitle">
                @(string.IsNullOrEmpty(Model.Management.Description)
                    ? (isCorrective ? "Gestión semestral de fallas correctivas." : "Resumen de indicadores para este período administrativo.")
                    : Model.Management.Description)
            </p>
        </div>
        <div class="d-flex flex-wrap">
            @if (isManagementActive)
            {
                if (!isCorrective)
                {
                    <a asp-page="./PlanAssets" asp-route-id="@Model.Management.Id" class="btn rounded-pill px-3 font-weight-bold shadow-sm mr-2" style="color: #7c3aed; border-color: #7c3aed; background: #f5f3ff;">
                        <i class="fas fa-tasks mr-2"></i>Planificar Activos
                    </a>
                    <a asp-page="/Index" asp-route-ShowWizard="true" asp-route-ManagementId="@Model.Management.Id" class="btn rounded-pill px-3 font-weight-bold shadow-sm mr-2" style="background-color: #334155; color: white;">
                        <i class="fas fa-play mr-2"></i>Iniciar Ronda (Wizard)
                    </a>
                }
                else
                {
                    <a asp-page="/Index" asp-route-ShowWizard="true" asp-route-ManagementId="@Model.Management.Id" class="btn btn-danger rounded-pill px-3 font-weight-bold shadow-sm mr-2">
                        <i class="fas fa-exclamation-triangle mr-2"></i>Reportar Falla Crítica
                    </a>
                }
            }
            else
            {
                <button class="btn btn-light border rounded-pill px-3 font-weight-bold mr-2" disabled>
                    <i class="fas fa-lock mr-2"></i>Histórico Inmutable
                </button>
            }
            <a asp-page="/Reports/Index" asp-route-managementId="@Model.Management.Id" class="btn rounded-pill px-3 font-weight-bold shadow-sm text-white mr-2" style="background-color: #0ea5e9;">
                <i class="fas fa-file-pdf mr-2"></i>Reportes Oficiales
            </a>
            <form method="post" asp-page-handler="UpdateActiveManagement" asp-route-id="@Model.Management.Id" class="d-inline mr-2">
                <button type="submit" class="btn rounded-pill px-3 font-weight-bold shadow-sm text-white" style="background-color:#10b981;">
                    <i class="fas fa-sync-alt mr-2"></i>Actualizar Gestión
                </button>
            </form>
            <a asp-page="./Index" class="btn btn-light border rounded-pill px-4">
                <i class="fas fa-arrow-left mr-2"></i>Volver
            </a>
        </div>
    </div>

    <!-- TABS DE NAVEGACIÓN -->
    <ul class="nav nav-tabs border-bottom mb-4" id="gestionTabs" role="tablist">
        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "dashboard" ? "active" : "")"
               href="?id=@Model.Management.Id&ActiveTab=dashboard">
                <i class="fas fa-chart-pie mr-1"></i> Dashboard
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "l48" || Model.ActiveTab == "" ? "active" : "")"
               href="?id=@Model.Management.Id&ActiveTab=l48">
                <i class="fas fa-table mr-1"></i> @(isCorrective ? "Fallas Registradas" : "L-48 / Cronograma")
            </a>
        </li>
        @if (!isCorrective)
        {
            <li class="nav-item">
                <a class="nav-link @(Model.ActiveTab == "sanos" ? "active" : "")"
                   href="?id=@Model.Management.Id&ActiveTab=sanos">
                    <i class="fas fa-heartbeat mr-1"></i> Activos Sanos
                </a>
            </li>
        }
        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "calendario" ? "active" : "")"
               href="?id=@Model.Management.Id&ActiveTab=calendario">
                <i class="fas fa-calendar-alt mr-1"></i> Calendario
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "editar" ? "active" : "")"
               href="?id=@Model.Management.Id&ActiveTab=editar">
                <i class="fas fa-edit mr-1"></i> Editar
            </a>
        </li>
    </ul>

    <!-- ===== TAB: DASHBOARD ===== -->
    @if (Model.ActiveTab == "dashboard")
    {
        <!-- FILA 1: KPIs globales -->
        <div class="row mb-3">
            <!-- Activos Totales -->
            <div class="col-6 col-md mb-3">
                <a href="?id=@Model.Management.Id&ActiveTab=l48&StatusFilter=Todos" class="asset-metric-tile asset-bg-blue p-3">
                    <div class="asset-metric-icon mb-3"><i class="fas fa-boxes"></i></div>
                    <div class="asset-metric-value font-weight-bold">@Model.TotalPlans</div>
                    <div class="font-weight-bold mt-2">Activos Totales</div>
                </a>
            </div>
            @if (!isCorrective)
            {
                <!-- Activos Sanos -->
                <div class="col-6 col-md mb-3">
                    <a href="?id=@Model.Management.Id&ActiveTab=sanos" class="asset-metric-tile asset-bg-green p-3">
                        <div class="asset-metric-icon mb-3"><i class="fas fa-heartbeat"></i></div>
                        <div class="asset-metric-value font-weight-bold">@Model.CountBuenos</div>
                        <div class="font-weight-bold mt-2">Activos Sanos</div>
                    </a>
                </div>
            }
            <!-- Vencidos -->
            <div class="col-6 col-md mb-3">
                <a href="?id=@Model.Management.Id&ActiveTab=l48&StatusFilter=Delay" class="asset-metric-tile asset-bg-red p-3">
                    <div class="asset-metric-icon mb-3"><i class="fas fa-exclamation-triangle"></i></div>
                    <div class="asset-metric-value font-weight-bold">@Model.TotalVencidos</div>
                    <div class="font-weight-bold mt-2">Vencidos</div>
                </a>
            </div>
            <!-- Completados -->
            <div class="col-6 col-md mb-3">
                <a href="/Index?ShowWizard=true&Step=7&ManagementId=@Model.Management.Id" class="asset-metric-tile asset-bg-cyan p-3">
                    <div class="asset-metric-icon mb-3"><i class="fas fa-check-circle"></i></div>
                    <div class="asset-metric-value font-weight-bold">@Model.CompletedPlans</div>
                    <div class="font-weight-bold mt-2">Completados</div>
                </a>
            </div>
            <!-- Avance -->
            <div class="col-6 col-md mb-3">
                <div class="asset-metric-tile asset-bg-amber p-3">
                    <div class="asset-metric-icon mb-3"><i class="fas fa-percentage"></i></div>
                    <div class="asset-metric-value font-weight-bold">@Model.GlobalProgress%</div>
                    <div class="font-weight-bold mt-2">% Avance</div>
                </div>
            </div>
        </div>

        <!-- FILA 2 DE KPIS -->
        <div class="row mb-4">
            @if (!isCorrective)
            {
                <!-- L6 -->
                <div class="col-6 col-md-2 mb-3">
                    <a href="/Index?ShowWizard=true&Step=1&ManagementId=@Model.Management.Id" class="asset-metric-tile asset-bg-cyan p-3">
                        <div class="asset-metric-icon mb-3"><i class="fas fa-clipboard-check"></i></div>
                        <div class="asset-metric-value font-weight-bold">@Model.CountL6</div>
                        <div class="font-weight-bold mt-2">L-6 Verificación</div>
                    </a>
                </div>
            }
            <!-- L7 -->
            <div class="col-6 col-md-2 mb-3">
                <a href="/Index?ShowWizard=true&Step=2&ManagementId=@Model.Management.Id" class="asset-metric-tile asset-bg-amber p-3">
                    <div class="asset-metric-icon mb-3"><i class="fas fa-tools"></i></div>
                    <div class="asset-metric-value font-weight-bold">@Model.CountL7</div>
                    <div class="font-weight-bold mt-2">L-7 Solicitud</div>
                </a>
            </div>
            <!-- L8 -->
            <div class="col-6 col-md-2 mb-3">
                <a href="/Index?ShowWizard=true&Step=3&ManagementId=@Model.Management.Id" class="asset-metric-tile asset-bg-red p-3">
                    <div class="asset-metric-icon mb-3"><i class="fas fa-wrench"></i></div>
                    <div class="asset-metric-value font-weight-bold">@Model.CountL8</div>
                    <div class="font-weight-bold mt-2">L-8 Mantenimiento</div>
                </a>
            </div>
            <!-- L3 / Salida -->
            <div class="col-6 col-md-3 mb-3">
                <a href="/Index?ShowWizard=true&Step=4&ManagementId=@Model.Management.Id" class="asset-metric-tile asset-bg-purple p-3">
                    <div class="asset-metric-icon mb-3"><i class="fas fa-truck-loading"></i></div>
                    <div class="asset-metric-value font-weight-bold">@Model.CountSalida</div>
                    <div class="font-weight-bold mt-2">L-3 Salida</div>
                </a>
            </div>
            <!-- Desembolso -->
            <div class="col-12 col-md-3 mb-3">
                <a href="/Index?ShowWizard=true&Step=6&ManagementId=@Model.Management.Id" class="asset-metric-tile asset-bg-slate p-3">
                    <div class="asset-metric-icon mb-3"><i class="fas fa-file-invoice-dollar"></i></div>
                    <div class="asset-metric-value font-weight-bold">@Model.CountDesembolso</div>
                    <div class="font-weight-bold mt-2">Desembolso</div>
                </a>
            </div>
        </div>

        <!-- GRÁFICOS -->
        <div class="row mb-4">
            <!-- Avance Global (Donut) -->
            <div class="col-lg-4 col-md-12 mb-4">
                <div class="card shadow-sm border-0 rounded h-100 p-4">
                    <h6 class="text-xs-premium text-muted mb-3 text-uppercase border-bottom pb-2">Avance Global</h6>
                    <div class="chart-container-detail d-flex align-items-center justify-content-center" style="position:relative;">
                        <canvas id="globalProgressChart"></canvas>
                        <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none;">
                            <span style="font-size:2rem;font-weight:800;color:#1E293B;">@Model.GlobalProgress%</span>
                            <span class="text-muted" style="font-size:0.65rem;letter-spacing:0.05em;">COMPLETADO</span>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Por Tipo de Equipo -->
            <div class="col-lg-4 col-md-12 mb-4">
                <div class="card shadow-sm border-0 rounded h-100 p-4">
                    <h6 class="text-xs-premium text-muted mb-3 text-uppercase border-bottom pb-2">Por Categoría</h6>
                    <div class="chart-container-detail">
                        @if (Model.TopEquipmentTypes.Any())
                        {
                            <canvas id="typeProgressChart"></canvas>
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center h-100 text-muted small font-italic">Sin datos</div>
                        }
                    </div>
                </div>
            </div>
            <!-- Por Laboratorio -->
            <div class="col-lg-4 col-md-12 mb-4">
                <div class="card shadow-sm border-0 rounded h-100 p-4">
                    <h6 class="text-xs-premium text-muted mb-3 text-uppercase border-bottom pb-2">Por Laboratorio</h6>
                    <div class="chart-container-detail">
                        @if (Model.TopLaboratories.Any())
                        {
                            <canvas id="labProgressChart"></canvas>
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center h-100 text-muted small font-italic">Sin datos</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Lista de Vencidos -->
        @if (Model.OverduePlans.Any())
        {
            <div class="card shadow-sm border-0 p-4 mb-4">
                <h6 class="text-xs-premium text-muted mb-3 text-uppercase border-bottom pb-2">
                    <i class="fas fa-exclamation-circle text-danger mr-2"></i>Equipos con Retraso
                </h6>
                <div class="row">
                    @foreach (var plan in Model.OverduePlans)
                    {
                        <div class="col-md-4 mb-3">
                            <div class="d-flex justify-content-between align-items-start p-3 bg-light rounded">
                                <div>
                                    <div class="font-weight-bold small text-dark">@plan.EquipmentUnit?.Equipment?.Name</div>
                                    <div class="text-muted" style="font-size:0.72rem;">@plan.EquipmentUnit?.Laboratory?.Name</div>
                                </div>
                                <span class="badge badge-soft-danger px-2 py-1 rounded-pill small">RETRASO</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }

    <!-- ===== TAB: ACTIVOS SANOS ===== -->
    @if (Model.ActiveTab == "sanos")
    {
        <!-- Filtro de Laboratorio para Activos Sanos -->
        <div class="d-flex flex-wrap align-items-center gap-3 mb-4 p-3 bg-light rounded border">
            <form method="get" class="d-flex flex-wrap gap-2 w-100 align-items-center">
                <input type="hidden" name="id" value="@Model.Management.Id" />
                <input type="hidden" name="ActiveTab" value="sanos" />

                <select name="LabFilterId" asp-items="Model.LabFList"
                        class="form-control form-control-sm shadow-sm" style="width:150px;"
                        onchange="this.form.submit()">
                    <option value="">Laboratorio</option>
                </select>
            </form>
        </div>

        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="text-muted small">Laboratorio</th>
                            <th class="text-muted small">Equipo / Inv.</th>
                            <th class="text-muted small">Fecha Verificación</th>
                            <th class="text-muted small">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.ManagementPlans.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted p-4">No hay activos sanos para mostrar con los filtros actuales.</td>
                            </tr>
                        }
                        @foreach (var plan in Model.ManagementPlans)
                        {
                            <tr>
                                <td class="font-weight-bold align-middle small">
                                    @plan.EquipmentUnit?.Laboratory?.Name
                                </td>
                                <td class="align-middle">
                                    <div class="font-weight-bold text-primary" style="font-size:0.82rem;">
                                        @plan.EquipmentUnit?.Equipment?.Name
                                    </div>
                                    <div class="text-muted" style="font-size:0.72rem;">
                                        INV-@plan.EquipmentUnit?.InventoryNumber
                                    </div>
                                </td>
                                <td class="small align-middle text-muted">
                                    @(plan.Verification?.CreatedDate.ToString("dd/MM/yyyy") ?? "—")
                                </td>
                                <td class="align-middle">
                                    <span class="badge badge-soft-success px-2 py-1 rounded-pill small">Bueno / Operativo</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ===== TAB: L-48 / CRONOGRAMA ===== -->
    @if (Model.ActiveTab == "l48" || Model.ActiveTab == "")
    {
        <!-- Filtros -->
        <div class="d-flex flex-wrap align-items-center gap-3 mb-4 p-3 bg-light rounded border">
            <form method="get" class="d-flex flex-wrap gap-2 w-100 align-items-center">
                <input type="hidden" name="id" value="@Model.Management.Id" />
                <input type="hidden" name="ActiveTab" value="l48" />

                <select name="LabFilterId" asp-items="Model.LabFList"
                        class="form-control form-control-sm shadow-sm" style="width:150px;"
                        onchange="this.form.submit()">
                    <option value="">Laboratorio</option>
                </select>

                <select name="TechFilterId" asp-items="Model.TechFList"
                        class="form-control form-control-sm shadow-sm" style="width:150px;"
                        onchange="this.form.submit()">
                    <option value="">Técnico</option>
                </select>

                <select name="CategoryFilter" class="form-control form-control-sm shadow-sm" style="width:180px;"
                        onchange="this.form.submit()">
                    <option value="">Categoría</option>
                    <option value="Electronico"  selected="@(Model.CategoryFilter == "Electronico")">Electrónico / Eléctrico</option>
                    <option value="Manual"       selected="@(Model.CategoryFilter == "Manual")">Manual / Mecánico</option>
                    <option value="Mobiliario"   selected="@(Model.CategoryFilter == "Mobiliario")">Mobiliario</option>
                    <option value="Medicion"     selected="@(Model.CategoryFilter == "Medicion")">Instrumental de Medición</option>
                    <option value="Vidrio"       selected="@(Model.CategoryFilter == "Vidrio")">Material de Vidrio</option>
                    <option value="Informatico"  selected="@(Model.CategoryFilter == "Informatico")">Informático</option>
                    <option value="Utensilio"    selected="@(Model.CategoryFilter == "Utensilio")">Utensilio</option>
                </select>

                @foreach (var s in new[] { "Todos", "Planeado", "InProgress", "Completed", "Externo", "Delay" })
                {
                    var label = s switch {
                        "Todos"      => "Todos",
                        "Planeado"   => "Planeado",
                        "InProgress" => "En Progreso",
                        "Completed"  => "Ejecutado",
                        "Externo"    => "Externo",
                        "Delay"      => "Vencidos",
                        _            => s
                    };
                    var btnClass = s == "Delay"
                        ? (Model.StatusFilter == s ? "btn-danger" : "btn-outline-danger")
                        : (Model.StatusFilter == s || (s == "Todos" && string.IsNullOrEmpty(Model.StatusFilter)) ? "btn-primary" : "btn-outline-secondary");
                    <a href="?id=@Model.Management.Id&ActiveTab=l48&StatusFilter=@s&LabFilterId=@Model.LabFilterId&TechFilterId=@Model.TechFilterId&CategoryFilter=@Model.CategoryFilter"
                       class="btn btn-sm @btnClass rounded-pill px-3">
                        @if (s == "Delay") { <i class="fas fa-exclamation-triangle mr-1"></i> }
                        @label
                    </a>
                }
            </form>
        </div>

        <!-- Tabla L-48 con filas dobles (Planeado / Real) -->
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="tableL48">
                    <thead class="bg-light">
                        <tr>
                            <th class="text-muted small" style="width:36px;">No</th>
                            <th class="text-muted small">Laboratorio</th>
                            <th class="text-muted small">Equipo / Inv.</th>
                            <th class="text-muted small">Falla Reportada</th>
                            <th class="text-muted small">Servicio</th>
                            <th class="text-muted small text-center" colspan="4">@l48Col1Name</th>
                            <th class="text-muted small text-center" colspan="4">@l48Col2Name</th>
                            <th class="text-muted small text-center">%</th>
                            <th class="text-muted small">Técnico</th>
                            <th class="text-muted small text-center" style="width: 120px;">Acciones</th>
                        </tr>
                        <tr class="bg-light">
                            <th colspan="5"></th>
                            @for (int s2 = 1; s2 <= 8; s2++) {
                                <th class="text-center small text-muted" style="min-width:42px;">S@(s2)</th>
                            }
                            <th colspan="3"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int rowNum = 1; }
                        @foreach (var plan in Model.ManagementPlans)
                        {
                            var failText = plan.TechnicalRequest?.Description ?? "Sin falla reportada";

                            var svcLabel = plan.Maintenance?.Technician != null 
                                ? (plan.Maintenance.Technician.Category == PersonCategory.Tecnico ? "I" : "E") 
                                : (plan.Maintenance?.ServiceType == ServiceType.External ? "E" : "I");
                            
                            var svcClass = svcLabel == "I" ? "badge-soft-success" : "badge-soft-danger";

                            int? plannedWeek = plan.PlannedWeek;
                            int? executedWeek = plan.ExecutedWeek;

                            <!-- FILA 1: Planeado -->
                            <tr class="border-bottom-0">
                                <td rowspan="2" class="text-muted small align-middle text-center">@rowNum</td>
                                <td rowspan="2" class="font-weight-bold align-middle small">
                                    @plan.EquipmentUnit?.Laboratory?.Name
                                </td>
                                @{
                                    var wizardStep = isCorrective
                                        ? plan.CurrentPhase switch {
                                            WizardPhase.TechnicalRequest => 1,
                                            WizardPhase.Maintenance => 2,
                                            WizardPhase.Exit => 3,
                                            WizardPhase.Kardex => 4,
                                            WizardPhase.Disbursement => 5,
                                            _ => 1
                                        }
                                        : plan.CurrentPhase switch {
                                            WizardPhase.Verification => 1,
                                            WizardPhase.TechnicalRequest => 2,
                                            WizardPhase.Maintenance => 3,
                                            WizardPhase.Exit => 4,
                                            WizardPhase.Kardex => 5,
                                            WizardPhase.Disbursement => 6,
                                            _ => 1
                                        };
                                    var wizardUrl = $"/Index?ShowWizard=true&Step={wizardStep}&ManagementId={Model.Management.Id}&SelectedLabId={plan.EquipmentUnit?.LaboratoryId}&FocusPlanId={plan.Id}";
                                }
                                <td rowspan="2" class="align-middle">
                                    <div class="font-weight-bold" style="font-size:0.82rem;">
                                        <a href="@wizardUrl" class="text-primary" title="Abrir wizard en fase actual">
                                            @plan.EquipmentUnit?.Equipment?.Name
                                        </a>
                                    </div>
                                    <div class="text-muted" style="font-size:0.72rem;">
                                        INV-@plan.EquipmentUnit?.InventoryNumber
                                    </div>
                                </td>
                                <td rowspan="2" class="small align-middle">@failText</td>
                                <td rowspan="2" class="align-middle text-center">
                                    <span class="badge @svcClass px-2 py-1 rounded-pill small">@svcLabel</span>
                                </td>
                                @for (int s3 = 1; s3 <= 8; s3++)
                                {
                                    <td class="text-center p-1" style="cursor:pointer;" onclick="toggleWeek(@plan.Id, @s3, 'planned')">
                                        @if (plannedWeek == s3)
                                        {
                                            <span id="badge-planned-@(plan.Id)" class="badge bg-primary text-white px-2 py-1 rounded"
                                                  style="font-size:0.6rem;">Prev.</span>
                                        }
                                        else
                                        {
                                            <span id="placeholder-planned-@(plan.Id)-@s3" style="display:inline-block; width:100%; height:100%;"></span>
                                        }
                                    </td>
                                }
                                <td rowspan="2" class="align-middle text-center">
                                    <span class="badge badge-light border font-weight-bold text-dark" style="font-size:0.82rem;">
                                        @(plan.Maintenance?.CompletionPercentage ?? 0)%
                                    </span>
                                </td>
                                <td rowspan="2" class="small align-middle text-muted">
                                    @(plan.Maintenance?.Technician?.FullName ?? "—")
                                </td>
                                <td rowspan="2" class="align-middle text-center">
                                    <a href="@wizardUrl" class="btn btn-sm btn-outline-primary btn-rounded font-weight-bold shadow-sm" title="Atender en wizard">
                                        <i class="fas fa-external-link-alt mr-1"></i> Atender
                                    </a>
                                </td>
                            </tr>
                            <!-- FILA 2: Real -->
                            <tr>
                                @for (int s4 = 1; s4 <= 8; s4++)
                                {
                                    <td class="text-center p-1" style="border-top:1px dashed #e2e8f0; cursor:pointer;" onclick="toggleWeek(@plan.Id, @s4, 'executed')">
                                        @if (executedWeek == s4)
                                        {
                                            <span id="badge-executed-@(plan.Id)" class="badge bg-success text-white px-2 py-1 rounded"
                                                  style="font-size:0.6rem;">Ejec.</span>
                                        }
                                        else
                                        {
                                            <span id="placeholder-executed-@(plan.Id)-@s4" style="display:inline-block; width:100%; height:100%;"></span>
                                        }
                                    </td>
                                }
                            </tr>
                            rowNum++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

