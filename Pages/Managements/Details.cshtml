@page
@model Proyecto_Laboratorios_Univalle.Pages.Managements.DetailsModel
@using Proyecto_Laboratorios_Univalle.Models.Enums
@using System.Text.Json
@{
    ViewData["Title"] = $"Mantenimiento Preventivo {Model.Management.Code}";
    var isManagementActive = Model.Management.Status == ManagementStatus.Active;
    // Variables L-48 (usadas solo cuando ActiveTab == l48, declaradas aqui para evitar RZ1010)
    var l48Sem      = Model.Management.Semester;
    var l48Year     = Model.Management.Year;
    var l48Col1Name = l48Sem == 1 ? $"Jun {l48Year}" : $"Dic {l48Year}";
    var l48Col2Name = l48Sem == 1 ? $"Jul {l48Year}" : $"Ene {l48Year + 1}";
    var isCorrective = Model.Management.Type == ManagementType.Corrective;
}

@section Styles {
    <style> 
        /* Badge soft colors */
        .badge-soft-success { background: #d1fae5; color: #065f46; }
        .badge-soft-danger  { background: #fef2f2; color: #991b1b; }

        /* Wizard utilities (same as Index) */
        .wizard-title    { font-size: 1.5rem; font-weight: 800; color: #012970; }
        .wizard-subtitle { font-size: 0.85rem; color: #899bbd; }

        /* Phase cards (replicated from Index) */
        .phase-icon {
            width: 44px; height: 44px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 0.5rem;
        }
        .phase-icon--blue   { background: #eff6ff; color: #3b82f6; }
        .phase-icon--purple { background: #f5f3ff; color: #8b5cf6; }
        .phase-icon--amber  { background: #fffbeb; color: #f59e0b; }
        .phase-icon--red    { background: #fef2f2; color: #ef4444; }
        .phase-icon--green  { background: #d1fae5; color: #10b981; }
        .phase-card {
            border: none; border-radius: 1rem; padding: 1.25rem;
            text-align: center; height: 100%; transition: transform 0.2s;
            text-decoration: none !important; display: block;
        }
        .phase-card:hover { transform: translateY(-3px); }
        .phase-card h6 { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; margin-bottom: 0.5rem; }
        .phase-card h2 { font-size: 1.8rem; font-weight: 800; margin: 0; }

        /* Nav tabs override */
        .nav-tabs .nav-link { color: #64748b; font-weight: 600; }
        .nav-tabs .nav-link.active { color: #012970; font-weight: 700; border-bottom: 2px solid #4154f1; }

        /* Chart containers */
        .chart-container-detail { height: 240px; position: relative; }

        /* L-48 table */
        #tableL48 thead th { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.04em; }
        #tableL48 tbody td { vertical-align: middle; }
    </style>
}

<div class="container-fluid py-4">

    <!-- CABECERA DE LA GESTIÓN -->
    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
        <div>
            <h1 class="wizard-title mb-1">@(isCorrective ? "Mantenimiento Correctivo" : "Mantenimiento Preventivo") @Model.Management.Code</h1>
            <p class="wizard-subtitle">
                @(string.IsNullOrEmpty(Model.Management.Description)
                    ? (isCorrective ? "Contenedor anual de fallas críticas." : "Resumen de indicadores para este período administrativo.")
                    : Model.Management.Description)
            </p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            @if (isManagementActive)
            {
                if (!isCorrective)
                {
                    <form method="post" asp-page-handler="SyncEquipments" asp-route-id="@Model.Management.Id" class="m-0">
                        <button type="submit" class="btn rounded-pill px-3 font-weight-bold shadow-sm" style="color: #7c3aed; border-color: #7c3aed; background: #f5f3ff;">
                            <i class="fas fa-sync-alt mr-2"></i>Sincronizar Equipos
                        </button>
                    </form>
                    <a asp-page="/Index" asp-route-ShowWizard="true" class="btn rounded-pill px-3 font-weight-bold shadow-sm" style="background-color: #334155; color: white;">
                        <i class="fas fa-play mr-2"></i>Iniciar Ronda (Wizard)
                    </a>
                }
                else
                {
                    <a asp-page="/Index" asp-route-ShowWizard="true" class="btn btn-danger rounded-pill px-3 font-weight-bold shadow-sm">
                        <i class="fas fa-exclamation-triangle mr-2"></i>Reportar Falla Crítica
                    </a>
                }
            }
            else
            {
                <button class="btn btn-light border rounded-pill px-3 font-weight-bold" disabled>
                    <i class="fas fa-lock mr-2"></i>Histórico Inmutable
                </button>
            }
            <a asp-page="/Reports/Index" class="btn rounded-pill px-3 font-weight-bold shadow-sm text-white" style="background-color: #0ea5e9;">
                <i class="fas fa-file-pdf mr-2"></i>Reportes Oficiales
            </a>
            <a asp-page="./Index" class="btn btn-light border rounded-pill px-4">
                <i class="fas fa-arrow-left mr-2"></i>Volver
            </a>
        </div>
    </div>

    <!-- TABS DE NAVEGACIÓN -->
    <ul class="nav nav-tabs border-bottom mb-4" id="gestionTabs" role="tablist">
        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "dashboard" ? "active" : "")"
               href="?id=@Model.Management.Id&ActiveTab=dashboard">
                <i class="fas fa-chart-pie mr-1"></i> Dashboard
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "l48" || Model.ActiveTab == "" ? "active" : "")"
               href="?id=@Model.Management.Id&ActiveTab=l48">
                <i class="fas fa-table mr-1"></i> @(isCorrective ? "Fallas Registradas" : "L-48 / Cronograma")
            </a>
        </li>
        @if (!isCorrective)
        {
            <li class="nav-item">
                <a class="nav-link @(Model.ActiveTab == "sanos" ? "active" : "")"
                   href="?id=@Model.Management.Id&ActiveTab=sanos">
                    <i class="fas fa-heartbeat mr-1"></i> Activos Sanos
                </a>
            </li>
        }
        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "calendario" ? "active" : "")"
               href="?id=@Model.Management.Id&ActiveTab=calendario">
                <i class="fas fa-calendar-alt mr-1"></i> Calendario
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "editar" ? "active" : "")"
               href="?id=@Model.Management.Id&ActiveTab=editar">
                <i class="fas fa-edit mr-1"></i> Editar
            </a>
        </li>
    </ul>

    <!-- ===== TAB: DASHBOARD ===== -->
    @if (Model.ActiveTab == "dashboard")
    {
        <!-- FILA 1: KPIs globales -->
        <div class="row mb-3">
            <!-- Activos Totales -->
            <div class="col-6 col-md mb-3">
                <a href="?id=@Model.Management.Id&ActiveTab=l48&StatusFilter=Todos" class="phase-card shadow-sm" style="background:#f6f9ff;">
                    <div class="phase-icon phase-icon--blue"><i class="fas fa-boxes"></i></div>
                    <h6 class="text-muted">Activos Totales</h6>
                    <h2 style="color:#4154f1;">@Model.TotalPlans</h2>
                </a>
            </div>
            @if (!isCorrective)
            {
                <!-- Activos Sanos -->
                <div class="col-6 col-md mb-3">
                    <a href="?id=@Model.Management.Id&ActiveTab=sanos" class="phase-card shadow-sm" style="background:#eafaf1; border:1px solid #a7f3d0;">
                        <div class="phase-icon phase-icon--green"><i class="fas fa-heartbeat"></i></div>
                        <h6 style="color:#059669;">Activos Sanos</h6>
                        <h2 style="color:#059669;">@Model.CountBuenos</h2>
                    </a>
                </div>
            }
            <!-- Vencidos -->
            <div class="col-6 col-md mb-3">
                <a href="?id=@Model.Management.Id&ActiveTab=l48&StatusFilter=Delay" class="phase-card shadow-sm bg-danger text-white">
                    <div class="phase-icon" style="background:rgba(255,255,255,.2);color:#fff;">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <h6 class="text-white opacity-75">Vencidos</h6>
                    <h2 class="text-white">@Model.OverduePlans.Count</h2>
                </a>
            </div>
            <!-- Completados -->
            <div class="col-6 col-md mb-3">
                <a href="?id=@Model.Management.Id&ActiveTab=l48&StatusFilter=Completed" class="phase-card shadow-sm" style="background:#d1fae5;">
                    <div class="phase-icon phase-icon--green"><i class="fas fa-check-circle"></i></div>
                    <h6 style="color:#10b981;">Completados</h6>
                    <h2 style="color:#10b981;">@Model.CompletedPlans</h2>
                </a>
            </div>
            <!-- Avance -->
            <div class="col-6 col-md mb-3">
                <div class="phase-card shadow-sm" style="background:#fffbeb;">
                    <div class="phase-icon phase-icon--amber"><i class="fas fa-percentage"></i></div>
                    <h6 style="color:#f59e0b;">% Avance</h6>
                    <h2 style="color:#f59e0b;">@Model.Management.CompletionPercentage%</h2>
                </div>
            </div>
        </div>

        <!-- FILA 2 DE KPIS -->
        <div class="row mb-4">
            @if (!isCorrective)
            {
                <!-- L6 -->
                <div class="col-6 col-md-2 mb-3">
                    <a href="/Index?ShowWizard=true&Step=1" class="phase-card shadow-sm" style="background:#e0f2fe; border:1px solid #bae6fd;">
                        <div class="phase-icon phase-icon--blue"><i class="fas fa-clipboard-check"></i></div>
                        <h6 style="color:#0284c7; font-size:0.75rem;">L-6 Verificación</h6>
                        <h2 style="color:#0284c7; font-size:1.5rem;">@Model.CountL6</h2>
                    </a>
                </div>
            }
            <!-- L7 -->
            <div class="col-6 col-md-2 mb-3">
                <a href="/Index?ShowWizard=true&Step=2" class="phase-card shadow-sm" style="background:#fef3c7; border:1px solid #fde68a;">
                    <div class="phase-icon phase-icon--amber"><i class="fas fa-tools"></i></div>
                    <h6 style="color:#d97706; font-size:0.75rem;">L-7 Solicitud</h6>
                    <h2 style="color:#d97706; font-size:1.5rem;">@Model.CountL7</h2>
                </a>
            </div>
            <!-- L8 -->
            <div class="col-6 col-md-2 mb-3">
                <a href="/Index?ShowWizard=true&Step=3" class="phase-card shadow-sm" style="background:#fee2e2; border:1px solid #fecaca;">
                    <div class="phase-icon phase-icon--red"><i class="fas fa-wrench"></i></div>
                    <h6 style="color:#dc2626; font-size:0.75rem;">L-8 Mantenimiento</h6>
                    <h2 style="color:#dc2626; font-size:1.5rem;">@Model.CountL8</h2>
                </a>
            </div>
            <!-- L3 / Salida -->
            <div class="col-6 col-md-3 mb-3">
                <a href="/Index?ShowWizard=true&Step=4" class="phase-card shadow-sm" style="background:#f3e8ff; border:1px solid #e9d5ff;">
                    <div class="phase-icon" style="background:rgba(147, 51, 234, 0.1); color:#9333ea;"><i class="fas fa-truck-loading"></i></div>
                    <h6 style="color:#9333ea; font-size:0.75rem;">L-3 Salida</h6>
                    <h2 style="color:#9333ea; font-size:1.5rem;">@Model.CountSalida</h2>
                </a>
            </div>
            <!-- Desembolso -->
            <div class="col-12 col-md-3 mb-3">
                <a href="/Index?ShowWizard=true&Step=6" class="phase-card shadow-sm" style="background:#f1f5f9; border:1px solid #e2e8f0;">
                    <div class="phase-icon" style="background:rgba(71, 85, 105, 0.1); color:#475569;"><i class="fas fa-file-invoice-dollar"></i></div>
                    <h6 style="color:#475569; font-size:0.75rem;">Desembolso</h6>
                    <h2 style="color:#475569; font-size:1.5rem;">@Model.CountDesembolso</h2>
                </a>
            </div>
        </div>

        <!-- GRÁFICOS -->
        <div class="row mb-4">
            <!-- Avance Global (Donut) -->
            <div class="col-lg-4 col-md-12 mb-4">
                <div class="card shadow-sm border-0 rounded h-100 p-4">
                    <h6 class="text-xs-premium text-muted mb-3 text-uppercase border-bottom pb-2">Avance Global</h6>
                    <div class="chart-container-detail d-flex align-items-center justify-content-center" style="position:relative;">
                        <canvas id="globalProgressChart"></canvas>
                        <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none;">
                            <span style="font-size:2rem;font-weight:800;color:#1E293B;">@Model.Management.CompletionPercentage%</span>
                            <span class="text-muted" style="font-size:0.65rem;letter-spacing:0.05em;">COMPLETADO</span>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Por Tipo de Equipo -->
            <div class="col-lg-4 col-md-12 mb-4">
                <div class="card shadow-sm border-0 rounded h-100 p-4">
                    <h6 class="text-xs-premium text-muted mb-3 text-uppercase border-bottom pb-2">Por Categoría</h6>
                    <div class="chart-container-detail">
                        @if (Model.TopEquipmentTypes.Any())
                        {
                            <canvas id="typeProgressChart"></canvas>
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center h-100 text-muted small font-italic">Sin datos</div>
                        }
                    </div>
                </div>
            </div>
            <!-- Por Laboratorio -->
            <div class="col-lg-4 col-md-12 mb-4">
                <div class="card shadow-sm border-0 rounded h-100 p-4">
                    <h6 class="text-xs-premium text-muted mb-3 text-uppercase border-bottom pb-2">Por Laboratorio</h6>
                    <div class="chart-container-detail">
                        @if (Model.TopLaboratories.Any())
                        {
                            <canvas id="labProgressChart"></canvas>
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center h-100 text-muted small font-italic">Sin datos</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Lista de Vencidos -->
        @if (Model.OverduePlans.Any())
        {
            <div class="card shadow-sm border-0 p-4 mb-4">
                <h6 class="text-xs-premium text-muted mb-3 text-uppercase border-bottom pb-2">
                    <i class="fas fa-exclamation-circle text-danger mr-2"></i>Equipos con Retraso
                </h6>
                <div class="row">
                    @foreach (var plan in Model.OverduePlans)
                    {
                        <div class="col-md-4 mb-3">
                            <div class="d-flex justify-content-between align-items-start p-3 bg-light rounded">
                                <div>
                                    <div class="font-weight-bold small text-dark">@plan.EquipmentUnit?.Equipment?.Name</div>
                                    <div class="text-muted" style="font-size:0.72rem;">@plan.EquipmentUnit?.Laboratory?.Name</div>
                                </div>
                                <span class="badge badge-soft-danger px-2 py-1 rounded-pill small">RETRASO</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }

    <!-- ===== TAB: ACTIVOS SANOS ===== -->
    @if (Model.ActiveTab == "sanos")
    {
        <!-- Filtro de Laboratorio para Activos Sanos -->
        <div class="d-flex flex-wrap align-items-center gap-3 mb-4 p-3 bg-light rounded border">
            <form method="get" class="d-flex flex-wrap gap-2 w-100 align-items-center">
                <input type="hidden" name="id" value="@Model.Management.Id" />
                <input type="hidden" name="ActiveTab" value="sanos" />

                <select name="LabFilterId" asp-items="Model.LabFList"
                        class="form-control form-control-sm shadow-sm" style="width:150px;"
                        onchange="this.form.submit()">
                    <option value="">Laboratorio</option>
                </select>
            </form>
        </div>

        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="text-muted small">Laboratorio</th>
                            <th class="text-muted small">Equipo / Inv.</th>
                            <th class="text-muted small">Fecha Verificación</th>
                            <th class="text-muted small">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.ManagementPlans.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted p-4">No hay activos sanos para mostrar con los filtros actuales.</td>
                            </tr>
                        }
                        @foreach (var plan in Model.ManagementPlans)
                        {
                            <tr>
                                <td class="font-weight-bold align-middle small">
                                    @plan.EquipmentUnit?.Laboratory?.Name
                                </td>
                                <td class="align-middle">
                                    <div class="font-weight-bold text-primary" style="font-size:0.82rem;">
                                        @plan.EquipmentUnit?.Equipment?.Name
                                    </div>
                                    <div class="text-muted" style="font-size:0.72rem;">
                                        INV-@plan.EquipmentUnit?.InventoryNumber
                                    </div>
                                </td>
                                <td class="small align-middle text-muted">
                                    @(plan.Verification?.CreatedDate.ToString("dd/MM/yyyy") ?? "—")
                                </td>
                                <td class="align-middle">
                                    <span class="badge badge-soft-success px-2 py-1 rounded-pill small">Bueno / Operativo</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ===== TAB: L-48 / CRONOGRAMA ===== -->
    @if (Model.ActiveTab == "l48" || Model.ActiveTab == "")
    {
        <!-- Filtros -->
        <div class="d-flex flex-wrap align-items-center gap-3 mb-4 p-3 bg-light rounded border">
            <form method="get" class="d-flex flex-wrap gap-2 w-100 align-items-center">
                <input type="hidden" name="id" value="@Model.Management.Id" />
                <input type="hidden" name="ActiveTab" value="l48" />

                <select name="LabFilterId" asp-items="Model.LabFList"
                        class="form-control form-control-sm shadow-sm" style="width:150px;"
                        onchange="this.form.submit()">
                    <option value="">Laboratorio</option>
                </select>

                <select name="TechFilterId" asp-items="Model.TechFList"
                        class="form-control form-control-sm shadow-sm" style="width:150px;"
                        onchange="this.form.submit()">
                    <option value="">Técnico</option>
                </select>

                <select name="CategoryFilter" class="form-control form-control-sm shadow-sm" style="width:180px;"
                        onchange="this.form.submit()">
                    <option value="">Categoría</option>
                    <option value="Electronico"  selected="@(Model.CategoryFilter == "Electronico")">Electrónico / Eléctrico</option>
                    <option value="Manual"       selected="@(Model.CategoryFilter == "Manual")">Manual / Mecánico</option>
                    <option value="Mobiliario"   selected="@(Model.CategoryFilter == "Mobiliario")">Mobiliario</option>
                    <option value="Medicion"     selected="@(Model.CategoryFilter == "Medicion")">Instrumental de Medición</option>
                    <option value="Vidrio"       selected="@(Model.CategoryFilter == "Vidrio")">Material de Vidrio</option>
                    <option value="Informatico"  selected="@(Model.CategoryFilter == "Informatico")">Informático</option>
                    <option value="Utensilio"    selected="@(Model.CategoryFilter == "Utensilio")">Utensilio</option>
                </select>

                @foreach (var s in new[] { "Todos", "Planeado", "InProgress", "Completed", "Externo" })
                {
                    var label = s switch {
                        "Todos"      => "Todos",
                        "Planeado"   => "Planeado",
                        "InProgress" => "En Progreso",
                        "Completed"  => "Ejecutado",
                        "Externo"    => "Externo",
                        _            => s
                    };
                    <a href="?id=@Model.Management.Id&ActiveTab=l48&StatusFilter=@s&LabFilterId=@Model.LabFilterId&TechFilterId=@Model.TechFilterId&CategoryFilter=@Model.CategoryFilter"
                       class="btn btn-sm @(Model.StatusFilter == s || (s == "Todos" && string.IsNullOrEmpty(Model.StatusFilter)) ? "btn-primary" : "btn-outline-secondary") rounded-pill px-3">
                        @label
                    </a>
                }
            </form>
        </div>

        <!-- Tabla L-48 con filas dobles (Planeado / Real) -->
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="tableL48">
                    <thead class="bg-light">
                        <tr>
                            <th class="text-muted small" style="width:36px;">No</th>
                            <th class="text-muted small">Laboratorio</th>
                            <th class="text-muted small">Equipo / Inv.</th>
                            <th class="text-muted small">Falla Reportada</th>
                            <th class="text-muted small">Servicio</th>
                            <th class="text-muted small text-center" colspan="4">@l48Col1Name</th>
                            <th class="text-muted small text-center" colspan="4">@l48Col2Name</th>
                            <th class="text-muted small text-center">%</th>
                            <th class="text-muted small">Técnico</th>
                        </tr>
                        <tr class="bg-light">
                            <th colspan="5"></th>
                            @for (int s2 = 1; s2 <= 8; s2++) {
                                <th class="text-center small text-muted" style="min-width:42px;">S@(s2)</th>
                            }
                            <th colspan="2"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int rowNum = 1; }
                        @foreach (var plan in Model.ManagementPlans)
                        {
                            var failText = plan.TechnicalRequest?.Description ?? "Sin falla reportada";

                            var svcLabel = plan.Maintenance?.Technician != null 
                                ? (plan.Maintenance.Technician.Category == PersonCategory.Tecnico ? "I" : "E") 
                                : (plan.Maintenance?.ServiceType == ServiceType.External ? "E" : "I");
                            
                            var svcClass = svcLabel == "I" ? "badge-soft-success" : "badge-soft-danger";

                            int? plannedWeek = plan.PlannedWeek;
                            int? executedWeek = plan.ExecutedWeek;

                            <!-- FILA 1: Planeado -->
                            <tr class="border-bottom-0">
                                <td rowspan="2" class="text-muted small align-middle text-center">@rowNum</td>
                                <td rowspan="2" class="font-weight-bold align-middle small">
                                    @plan.EquipmentUnit?.Laboratory?.Name
                                </td>
                                <td rowspan="2" class="align-middle">
                                    <div class="font-weight-bold text-primary" style="font-size:0.82rem;">
                                        @plan.EquipmentUnit?.Equipment?.Name
                                    </div>
                                    <div class="text-muted" style="font-size:0.72rem;">
                                        INV-@plan.EquipmentUnit?.InventoryNumber
                                    </div>
                                </td>
                                <td rowspan="2" class="small align-middle">@failText</td>
                                <td rowspan="2" class="align-middle text-center">
                                    <span class="badge @svcClass px-2 py-1 rounded-pill small">@svcLabel</span>
                                </td>
                                @for (int s3 = 1; s3 <= 8; s3++)
                                {
                                    <td class="text-center p-1" style="cursor:pointer;" onclick="toggleWeek(@plan.Id, @s3, 'planned')">
                                        @if (plannedWeek == s3)
                                        {
                                            <span id="badge-planned-@(plan.Id)" class="badge bg-primary text-white px-2 py-1 rounded"
                                                  style="font-size:0.6rem;">Prev.</span>
                                        }
                                        else
                                        {
                                            <span id="placeholder-planned-@(plan.Id)-@s3" style="display:inline-block; width:100%; height:100%;"></span>
                                        }
                                    </td>
                                }
                                <td rowspan="2" class="align-middle text-center">
                                    <span class="badge badge-light border font-weight-bold text-dark" style="font-size:0.82rem;">
                                        @(plan.Maintenance?.CompletionPercentage ?? 0)%
                                    </span>
                                </td>
                                <td rowspan="2" class="small align-middle text-muted">
                                    @(plan.Maintenance?.Technician?.FullName ?? "—")
                                </td>
                            </tr>
                            <!-- FILA 2: Real -->
                            <tr>
                                @for (int s4 = 1; s4 <= 8; s4++)
                                {
                                    <td class="text-center p-1" style="border-top:1px dashed #e2e8f0; cursor:pointer;" onclick="toggleWeek(@plan.Id, @s4, 'executed')">
                                        @if (executedWeek == s4)
                                        {
                                            <span id="badge-executed-@(plan.Id)" class="badge bg-success text-white px-2 py-1 rounded"
                                                  style="font-size:0.6rem;">Ejec.</span>
                                        }
                                        else
                                        {
                                            <span id="placeholder-executed-@(plan.Id)-@s4" style="display:inline-block; width:100%; height:100%;"></span>
                                        }
                                    </td>
                                }
                            </tr>
                            rowNum++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ===== TAB: CALENDARIO ===== -->
    @if (Model.ActiveTab == "calendario")
    {
        <!-- Controles de zoom -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <span class="badge badge-soft-success px-3 py-2 mr-2"><i class="fa fa-circle mr-1"></i>Completado</span>
                <span class="badge px-3 py-2 mr-2" style="background:#fff3cd;color:#856404;"><i class="fa fa-circle mr-1"></i>En Progreso</span>
                <span class="badge px-3 py-2" style="background:#cfe2ff;color:#084298;"><i class="fa fa-circle mr-1"></i>Pendiente</span>
            </div>
            <div class="btn-group btn-group-sm" role="group" aria-label="Zoom">
                <button type="button" class="btn btn-outline-secondary" id="calZoomOut" title="Reducir"><i class="fas fa-search-minus"></i></button>
                <button type="button" class="btn btn-outline-secondary" id="calZoomReset" title="Normal">100%</button>
                <button type="button" class="btn btn-outline-secondary" id="calZoomIn" title="Ampliar"><i class="fas fa-search-plus"></i></button>
            </div>
        </div>

        <div class="card shadow-sm border-0 p-3" style="overflow:auto;">
            <div id="calendarZoomWrapper" style="transform-origin:top left; transition:transform 0.3s ease;">
                <div id="calendar"></div>
            </div>
        </div>

        <!-- PANEL LATERAL: Detalle del día seleccionado -->
        <div class="modal fade" id="dayDetailModal" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog modal-dialog-scrollable modal-lg" role="document">
                <div class="modal-content border-0 shadow-lg" style="border-radius:1rem;">
                    <div class="modal-header border-0 pb-0" style="background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border-radius:1rem 1rem 0 0;">
                        <div>
                            <h5 class="modal-title font-weight-bold" id="dayDetailTitle">Mantenimientos del día</h5>
                            <small id="dayDetailSubtitle" class="opacity-75"></small>
                        </div>
                        <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
                    </div>
                    <div class="modal-body p-0" id="dayDetailBody">
