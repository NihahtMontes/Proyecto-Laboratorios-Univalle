@page
@model Proyecto_Laboratorios_Univalle.Pages.Managements.DetailsModel
@using Proyecto_Laboratorios_Univalle.Models.Enums
@using System.Text.Json
@{
    ViewData["Title"] = $"Gestión {Model.Management.Code}";
    var isManagementActive = Model.Management.Status == ManagementStatus.Active;
    // Variables L-48 (usadas solo cuando ActiveTab == l48, declaradas aqui para evitar RZ1010)
    var l48Sem      = Model.Management.Semester;
    var l48Year     = Model.Management.Year;
    var l48Col1Name = l48Sem == 1 ? $"Dic {l48Year - 1}" : $"Jun {l48Year}";
    var l48Col2Name = l48Sem == 1 ? $"Ene {l48Year}"     : $"Jul {l48Year}";
}

@section Styles {
    <style>
        /* Badge soft colors */
        .badge-soft-success { background: #d1fae5; color: #065f46; }
        .badge-soft-danger  { background: #fef2f2; color: #991b1b; }

        /* Wizard utilities (same as Index) */
        .wizard-title    { font-size: 1.5rem; font-weight: 800; color: #012970; }
        .wizard-subtitle { font-size: 0.85rem; color: #899bbd; }

        /* Phase cards (replicated from Index) */
        .phase-icon {
            width: 44px; height: 44px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 0.5rem;
        }
        .phase-icon--blue   { background: #eff6ff; color: #3b82f6; }
        .phase-icon--purple { background: #f5f3ff; color: #8b5cf6; }
        .phase-icon--amber  { background: #fffbeb; color: #f59e0b; }
        .phase-icon--red    { background: #fef2f2; color: #ef4444; }
        .phase-icon--green  { background: #d1fae5; color: #10b981; }
        .phase-card {
            border: none; border-radius: 1rem; padding: 1.25rem;
            text-align: center; height: 100%; transition: transform 0.2s;
            text-decoration: none !important; display: block;
        }
        .phase-card:hover { transform: translateY(-3px); }
        .phase-card h6 { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; margin-bottom: 0.5rem; }
        .phase-card h2 { font-size: 1.8rem; font-weight: 800; margin: 0; }

        /* Nav tabs override */
        .nav-tabs .nav-link { color: #64748b; font-weight: 600; }
        .nav-tabs .nav-link.active { color: #012970; font-weight: 700; border-bottom: 2px solid #4154f1; }

        /* Chart containers */
        .chart-container-detail { height: 240px; position: relative; }

        /* L-48 table */
        #tableL48 thead th { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.04em; }
        #tableL48 tbody td { vertical-align: middle; }
    </style>
}

<div class="container-fluid py-4">

    <!-- CABECERA DE LA GESTIÓN -->
    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
        <div>
            <h1 class="wizard-title mb-1">Gestión @Model.Management.Code</h1>
            <p class="wizard-subtitle">
                @(string.IsNullOrEmpty(Model.Management.Description)
                    ? "Resumen de indicadores para este período administrativo."
                    : Model.Management.Description)
            </p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            @if (isManagementActive)
            {
                <form method="post" asp-page-handler="SyncEquipments" asp-route-id="@Model.Management.Id" class="m-0">
                    <button type="submit" class="btn btn-outline-primary rounded-pill px-3 font-weight-bold shadow-sm">
                        <i class="fas fa-sync-alt mr-2"></i>Sincronizar Equipos
                    </button>
                </form>
                <a asp-page="/Index" asp-route-ShowWizard="true" class="btn btn-dark rounded-pill px-3 font-weight-bold shadow-sm">
                    <i class="fas fa-play mr-2"></i>Iniciar Ronda (Wizard)
                </a>
            }
            else
            {
                <button class="btn btn-light border rounded-pill px-3 font-weight-bold" disabled>
                    <i class="fas fa-lock mr-2"></i>Histórico Inmutable
                </button>
            }
            <a asp-page="./Index" class="btn btn-light border rounded-pill px-4">
                <i class="fas fa-arrow-left mr-2"></i>Volver
            </a>
        </div>
    </div>

    <!-- TABS DE NAVEGACIÓN -->
    <ul class="nav nav-tabs border-bottom mb-4" id="gestionTabs" role="tablist">
        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "dashboard" ? "active" : "")"
               href="?id=@Model.Management.Id&ActiveTab=dashboard">
                <i class="fas fa-chart-pie mr-1"></i> Dashboard
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "l48" || Model.ActiveTab == "" ? "active" : "")"
               href="?id=@Model.Management.Id&ActiveTab=l48">
                <i class="fas fa-table mr-1"></i> L-48 / Cronograma
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "calendario" ? "active" : "")"
               href="?id=@Model.Management.Id&ActiveTab=calendario">
                <i class="fas fa-calendar-alt mr-1"></i> Calendario
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "editar" ? "active" : "")"
               href="?id=@Model.Management.Id&ActiveTab=editar">
                <i class="fas fa-edit mr-1"></i> Editar
            </a>
        </li>
    </ul>

    <!-- ===== TAB: DASHBOARD ===== -->
    @if (Model.ActiveTab == "dashboard")
    {
        <!-- FILA 1: KPIs globales -->
        <div class="row mb-3">
            <!-- Activos Totales -->
            <div class="col-6 col-md-3 mb-3">
                <div class="phase-card shadow-sm" style="background:#f6f9ff;">
                    <div class="phase-icon phase-icon--blue"><i class="fas fa-boxes"></i></div>
                    <h6 class="text-muted">Activos Totales</h6>
                    <h2 style="color:#4154f1;">@Model.TotalPlans</h2>
                </div>
            </div>
            <!-- Vencidos -->
            <div class="col-6 col-md-3 mb-3">
                <div class="phase-card shadow-sm bg-danger text-white">
                    <div class="phase-icon" style="background:rgba(255,255,255,.2);color:#fff;">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <h6 class="text-white opacity-75">Vencidos</h6>
                    <h2 class="text-white">@Model.OverduePlans.Count</h2>
                </div>
            </div>
            <!-- Completados -->
            <div class="col-6 col-md-3 mb-3">
                <div class="phase-card shadow-sm" style="background:#d1fae5;">
                    <div class="phase-icon phase-icon--green"><i class="fas fa-check-circle"></i></div>
                    <h6 style="color:#10b981;">Completados</h6>
                    <h2 style="color:#10b981;">@Model.CompletedPlans</h2>
                </div>
            </div>
            <!-- Avance -->
            <div class="col-6 col-md-3 mb-3">
                <div class="phase-card shadow-sm" style="background:#fffbeb;">
                    <div class="phase-icon phase-icon--amber"><i class="fas fa-percentage"></i></div>
                    <h6 style="color:#f59e0b;">% Avance</h6>
                    <h2 style="color:#f59e0b;">@Model.Management.CompletionPercentage%</h2>
                </div>
            </div>
        </div>

        <!-- GRÁFICOS -->
        <div class="row mb-4">
            <!-- Avance Global (Donut) -->
            <div class="col-lg-4 col-md-12 mb-4">
                <div class="card shadow-sm border-0 rounded h-100 p-4">
                    <h6 class="text-xs-premium text-muted mb-3 text-uppercase border-bottom pb-2">Avance Global</h6>
                    <div class="chart-container-detail d-flex align-items-center justify-content-center" style="position:relative;">
                        <canvas id="globalProgressChart"></canvas>
                        <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none;">
                            <span style="font-size:2rem;font-weight:800;color:#1E293B;">@Model.Management.CompletionPercentage%</span>
                            <span class="text-muted" style="font-size:0.65rem;letter-spacing:0.05em;">COMPLETADO</span>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Por Tipo de Equipo -->
            <div class="col-lg-4 col-md-12 mb-4">
                <div class="card shadow-sm border-0 rounded h-100 p-4">
                    <h6 class="text-xs-premium text-muted mb-3 text-uppercase border-bottom pb-2">Por Categoría</h6>
                    <div class="chart-container-detail">
                        @if (Model.TopEquipmentTypes.Any())
                        {
                            <canvas id="typeProgressChart"></canvas>
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center h-100 text-muted small font-italic">Sin datos</div>
                        }
                    </div>
                </div>
            </div>
            <!-- Por Laboratorio -->
            <div class="col-lg-4 col-md-12 mb-4">
                <div class="card shadow-sm border-0 rounded h-100 p-4">
                    <h6 class="text-xs-premium text-muted mb-3 text-uppercase border-bottom pb-2">Por Laboratorio</h6>
                    <div class="chart-container-detail">
                        @if (Model.TopLaboratories.Any())
                        {
                            <canvas id="labProgressChart"></canvas>
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center h-100 text-muted small font-italic">Sin datos</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Lista de Vencidos -->
        @if (Model.OverduePlans.Any())
        {
            <div class="card shadow-sm border-0 p-4 mb-4">
                <h6 class="text-xs-premium text-muted mb-3 text-uppercase border-bottom pb-2">
                    <i class="fas fa-exclamation-circle text-danger mr-2"></i>Equipos con Retraso
                </h6>
                <div class="row">
                    @foreach (var plan in Model.OverduePlans)
                    {
                        <div class="col-md-4 mb-3">
                            <div class="d-flex justify-content-between align-items-start p-3 bg-light rounded">
                                <div>
                                    <div class="font-weight-bold small text-dark">@plan.EquipmentUnit?.Equipment?.Name</div>
                                    <div class="text-muted" style="font-size:0.72rem;">@plan.EquipmentUnit?.Laboratory?.Name</div>
                                </div>
                                <span class="badge badge-soft-danger px-2 py-1 rounded-pill small">RETRASO</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }

    <!-- ===== TAB: L-48 / CRONOGRAMA ===== -->
    @if (Model.ActiveTab == "l48" || Model.ActiveTab == "")
    {
        <!-- Filtros -->
        <div class="d-flex flex-wrap align-items-center gap-3 mb-4 p-3 bg-light rounded border">
            <form method="get" class="d-flex flex-wrap gap-2 w-100 align-items-center">
                <input type="hidden" name="id" value="@Model.Management.Id" />
                <input type="hidden" name="ActiveTab" value="l48" />

                <select name="LabFilterId" asp-items="Model.LabFList"
                        class="form-control form-control-sm shadow-sm" style="width:150px;"
                        onchange="this.form.submit()">
                    <option value="">Laboratorio</option>
                </select>

                <select name="TechFilterId" asp-items="Model.TechFList"
                        class="form-control form-control-sm shadow-sm" style="width:150px;"
                        onchange="this.form.submit()">
                    <option value="">Técnico</option>
                </select>

                <select name="CategoryFilter" class="form-control form-control-sm shadow-sm" style="width:180px;"
                        onchange="this.form.submit()">
                    <option value="">Categoría</option>
                    <option value="Electronico"  selected="@(Model.CategoryFilter == "Electronico")">Electrónico / Eléctrico</option>
                    <option value="Manual"       selected="@(Model.CategoryFilter == "Manual")">Manual / Mecánico</option>
                    <option value="Mobiliario"   selected="@(Model.CategoryFilter == "Mobiliario")">Mobiliario</option>
                    <option value="Medicion"     selected="@(Model.CategoryFilter == "Medicion")">Instrumental de Medición</option>
                    <option value="Vidrio"       selected="@(Model.CategoryFilter == "Vidrio")">Material de Vidrio</option>
                    <option value="Informatico"  selected="@(Model.CategoryFilter == "Informatico")">Informático</option>
                    <option value="Utensilio"    selected="@(Model.CategoryFilter == "Utensilio")">Utensilio</option>
                </select>

                @foreach (var s in new[] { "Todos", "Planeado", "InProgress", "Completed", "Externo" })
                {
                    var label = s switch {
                        "Todos"      => "Todos",
                        "Planeado"   => "Planeado",
                        "InProgress" => "En Progreso",
                        "Completed"  => "Ejecutado",
                        "Externo"    => "Externo",
                        _            => s
                    };
                    <a href="?id=@Model.Management.Id&ActiveTab=l48&StatusFilter=@s&LabFilterId=@Model.LabFilterId&TechFilterId=@Model.TechFilterId&CategoryFilter=@Model.CategoryFilter"
                       class="btn btn-sm @(Model.StatusFilter == s || (s == "Todos" && string.IsNullOrEmpty(Model.StatusFilter)) ? "btn-primary" : "btn-outline-secondary") rounded-pill px-3">
                        @label
                    </a>
                }
            </form>
        </div>

        <!-- Tabla L-48 con filas dobles (Planeado / Real) -->
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="tableL48">
                    <thead class="bg-light">
                        <tr>
                            <th class="text-muted small" style="width:36px;">No</th>
                            <th class="text-muted small">Laboratorio</th>
                            <th class="text-muted small">Equipo / Inv.</th>
                            <th class="text-muted small">Falla Reportada</th>
                            <th class="text-muted small">Servicio</th>
                            <th class="text-muted small text-center" colspan="4">@l48Col1Name</th>
                            <th class="text-muted small text-center" colspan="4">@l48Col2Name</th>
                            <th class="text-muted small text-center">%</th>
                            <th class="text-muted small">Técnico</th>
                        </tr>
                        <tr class="bg-light">
                            <th colspan="5"></th>
                            @for (int s2 = 1; s2 <= 8; s2++) {
                                <th class="text-center small text-muted" style="min-width:42px;">S@s2</th>
                            }
                            <th colspan="2"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int rowNum = 1; }
                        @foreach (var plan in Model.ManagementPlans)
                        {
                            var failText = plan.Verification != null
                                ? (plan.Verification.FailuresCount > 0
                                    ? plan.Verification.Observations ?? "Con fallas"
                                    : "Ninguna")
                                : "—";

                            var isExternal = plan.Maintenance?.ServiceType == ServiceType.External;
                            var svcLabel   = isExternal ? "Externo" : "Interno";
                            var svcClass   = isExternal ? "badge-soft-danger" : "badge-soft-success";

                            int? plannedWeek = null;
                            if (plan.PlannedDate.HasValue)
                            {
                                var day = plan.PlannedDate.Value.Day;
                                plannedWeek = (day - 1) / 7 + 1;
                                var pm = plan.PlannedDate.Value.Month;
                                bool isM2 = l48Sem == 1 ? (pm == 1 || pm == 2) : (pm == 7 || pm == 8);
                                if (isM2) plannedWeek += 4;
                            }

                            int? realWeek = null;
                            if (plan.Maintenance?.ScheduledDate.HasValue == true)
                            {
                                var day = plan.Maintenance.ScheduledDate.Value.Day;
                                realWeek = (day - 1) / 7 + 1;
                                var rm = plan.Maintenance.ScheduledDate.Value.Month;
                                bool isM2 = l48Sem == 1 ? (rm == 1 || rm == 2) : (rm == 7 || rm == 8);
                                if (isM2) realWeek += 4;
                            }

                            <!-- FILA 1: Planeado -->
                            <tr class="border-bottom-0">
                                <td rowspan="2" class="text-muted small align-middle text-center">@rowNum</td>
                                <td rowspan="2" class="font-weight-bold align-middle small">
                                    @plan.EquipmentUnit?.Laboratory?.Name
                                </td>
                                <td rowspan="2" class="align-middle">
                                    <div class="font-weight-bold text-primary" style="font-size:0.82rem;">
                                        @plan.EquipmentUnit?.Equipment?.Name
                                    </div>
                                    <div class="text-muted" style="font-size:0.72rem;">
                                        INV-@plan.EquipmentUnit?.InventoryNumber
                                    </div>
                                </td>
                                <td rowspan="2" class="small align-middle">@failText</td>
                                <td rowspan="2" class="align-middle">
                                    <span class="badge @svcClass px-2 py-1 rounded-pill small">@svcLabel</span>
                                </td>
                                @for (int s3 = 1; s3 <= 8; s3++)
                                {
                                    <td class="text-center p-1">
                                        @if (plannedWeek == s3)
                                        {
                                            <span class="badge bg-primary text-white px-2 py-1 rounded"
                                                  style="font-size:0.6rem;">Prev.</span>
                                        }
                                    </td>
                                }
                                <td rowspan="2" class="align-middle text-center">
                                    <span class="font-weight-bold" style="font-size:0.82rem;">
                                        @(plan.Maintenance?.CompletionPercentage)%
                                    </span>
                                </td>
                                <td rowspan="2" class="small align-middle text-muted">
                                    @(plan.Maintenance?.Technician?.FullName ?? "—")
                                </td>
                            </tr>
                            <!-- FILA 2: Real -->
                            <tr>
                                @for (int s4 = 1; s4 <= 8; s4++)
                                {
                                    <td class="text-center p-1" style="border-top:1px dashed #e2e8f0;">
                                        @if (realWeek == s4)
                                        {
                                            <span class="badge bg-success text-white px-2 py-1 rounded"
                                                  style="font-size:0.6rem;">OK</span>
                                        }
                                    </td>
                                }
                            </tr>
                            rowNum++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ===== TAB: CALENDARIO ===== -->
    @if (Model.ActiveTab == "calendario")
    {
        <div class="card shadow-sm border-0 p-4">
            <div id="calendar"></div>
        </div>

        <div id="calendar-events" class="d-none">
            <div class="calendar-events" data-class="bg-primary">
                <i class="fa fa-circle text-primary mr-2"></i>Planeado
            </div>
            <div class="calendar-events" data-class="bg-warning">
                <i class="fa fa-circle text-warning mr-2"></i>En Progreso
            </div>
            <div class="calendar-events" data-class="bg-success">
                <i class="fa fa-circle text-success mr-2"></i>Ejecutado
            </div>
        </div>
    }

    <!-- ===== TAB: EDITAR ===== -->
    @if (Model.ActiveTab == "editar")
    {
        <div class="card shadow-sm border-0 p-4" style="max-width:640px;">
            <h5 class="wizard-title mb-3">Editar Gestión</h5>
            <p class="text-muted small mb-4">Modifica los campos de la gestión activa con cuidado. Los cambios quedan registrados en la auditoría del sistema.</p>
            <a asp-page="./Edit" asp-route-id="@Model.Management.Id"
               class="btn btn-outline-primary rounded-pill px-4 font-weight-bold">
                <i class="fas fa-edit mr-2"></i>Ir al formulario de edición
            </a>
        </div>
    }

</div>

@section Scripts {

    <!-- Dashboard Charts (Chart.js 3.x) -->
    @if (Model.ActiveTab == "dashboard" || Model.ActiveTab == "")
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                // Global Donut
                const ctxGlobal = document.getElementById('globalProgressChart');
                if (ctxGlobal) {
                    new Chart(ctxGlobal.getContext('2d'), {
                        type: 'doughnut',
                        data: {
                            datasets: [{
                                data: [@Model.Management.CompletionPercentage, @(100 - Model.Management.CompletionPercentage)],
                                backgroundColor: ['#2eca6a', '#e2e8f0'],
                                borderWidth: 0
                            }]
                        },
                        options: {
                            responsive: true, maintainAspectRatio: false, cutout: '72%',
                            plugins: { legend: { display: false }, tooltip: { enabled: false } }
                        }
                    });
                }

                @if (Model.TopEquipmentTypes.Any())
                {
                    <text>
                    const ctxType = document.getElementById('typeProgressChart');
                    if (ctxType) {
                        new Chart(ctxType.getContext('2d'), {
                            type: 'bar',
                            data: {
                                labels: @Html.Raw(JsonSerializer.Serialize(Model.TopEquipmentTypes.Keys)),
                                datasets: [{
                                    data: @Html.Raw(JsonSerializer.Serialize(Model.TopEquipmentTypes.Values)),
                                    backgroundColor: ['#3B82F6','#F59E0B','#8B5CF6','#EC4899','#10B981'],
                                    borderRadius: 4, barThickness: 14
                                }]
                            },
                            options: {
                                indexAxis: 'y', responsive: true, maintainAspectRatio: false,
                                plugins: { legend: { display: false } },
                                scales: {
                                    x: { display: false, beginAtZero: true },
                                    y: { grid: { display: false }, border: { display: false },
                                         ticks: { color: '#64748b', font: { size: 10 } } }
                                }
                            }
                        });
                    }
                    </text>
                }

                @if (Model.TopLaboratories.Any())
                {
                    <text>
                    const ctxLab = document.getElementById('labProgressChart');
                    if (ctxLab) {
                        new Chart(ctxLab.getContext('2d'), {
                            type: 'bar',
                            data: {
                                labels: @Html.Raw(JsonSerializer.Serialize(Model.TopLaboratories.Keys)),
                                datasets: [{
                                    data: @Html.Raw(JsonSerializer.Serialize(Model.TopLaboratories.Values)),
                                    backgroundColor: ['#2eca6a','#f43f5e','#3b82f6','#f59e0b','#8b5cf6'],
                                    borderRadius: 4, barThickness: 14
                                }]
                            },
                            options: {
                                indexAxis: 'y', responsive: true, maintainAspectRatio: false,
                                plugins: { legend: { display: false } },
                                scales: {
                                    x: { display: false, beginAtZero: true },
                                    y: { grid: { display: false }, border: { display: false },
                                         ticks: { color: '#64748b', font: { size: 10 } } }
                                }
                            }
                        });
                    }
                    </text>
                }
            });
        </script>
    }

    <!-- FullCalendar v3 (solo cuando el tab es "calendario") -->
    @if (Model.ActiveTab == "calendario")
    {
        <link href="~/assets/libs/fullcalendar/dist/fullcalendar.min.css" rel="stylesheet" />
        <link href="~/assets/extra-libs/calendar/calendar.css" rel="stylesheet" />
        <script src="~/assets/libs/moment/min/moment.min.js"></script>
        <script src="~/assets/libs/fullcalendar/dist/fullcalendar.min.js"></script>
        <script>
            $(document).ready(function () {
                var events = @Html.Raw(JsonSerializer.Serialize(Model.CalendarEvents));

                $('#calendar').fullCalendar({
                    header: {
                        left:   'prev,next today',
                        center: 'title',
                        right:  'month,agendaWeek,agendaDay'
                    },
                    locale:    'es',
                    editable:  false,
                    droppable: false,
                    events: events.map(function (e) {
                        return {
                            title:     e.Title,
                            start:     e.Start,
                            end:       e.End,
                            className: e.ClassName
                        };
                    })
                });
            });
        </script>
    }

    <!-- Tabla L-48: ordernamiento por columna -->
    @if (Model.ActiveTab == "l48")
    {
        <script>
            document.querySelectorAll('#tableL48 thead tr:first-child th').forEach(function (th, i) {
                th.style.cursor = 'pointer';
                th.title = 'Haz clic para ordenar';
                th.addEventListener('click', function () {
                    var table  = document.getElementById('tableL48');
                    var rows   = Array.from(table.querySelectorAll('tbody tr:nth-child(odd)'));
                    var sorted = rows.sort(function (a, b) {
                        var aText = (a.cells[i] ? a.cells[i].innerText : '').trim();
                        var bText = (b.cells[i] ? b.cells[i].innerText : '').trim();
                        return aText.localeCompare(bText, 'es');
                    });
                    var tbody = table.querySelector('tbody');
                    tbody.innerHTML = '';
                    sorted.forEach(function (row) { tbody.appendChild(row); });
                });
            });
        </script>
    }
}
