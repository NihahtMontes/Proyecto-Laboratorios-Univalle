@page
@model Proyecto_Laboratorios_Univalle.Pages.Managements.ReconstruirPlanesModel
@using Proyecto_Laboratorios_Univalle.Models.Enums
@{
    ViewData["Title"] = "Reconstruir planes de gestión";
    ViewData["Section"] = "Gestiones";
    var stateOrder = new[]
    {
        WizardEquipmentState.PendingVerification,
        WizardEquipmentState.VerifiedGood,
        WizardEquipmentState.AwaitingRequest,
        WizardEquipmentState.AwaitingMaintenance,
        WizardEquipmentState.InMaintenance,
        WizardEquipmentState.AwaitingDeparture,
        WizardEquipmentState.AwaitingKardex,
        WizardEquipmentState.AwaitingDisbursement,
        WizardEquipmentState.Completed
    };
}

@section Styles {
    <style>
        .rp-kpi { border-radius: 14px; padding: 14px 16px; background: #fff; border: 1px solid #eef0f4; height: 100%; }
        .rp-kpi__value { font-size: 1.75rem; font-weight: 800; line-height: 1.1; }
        .rp-kpi__label { font-size: .75rem; color: #6b7280; font-weight: 600; text-transform: uppercase; letter-spacing: .3px; }
        .rp-state { margin: 2px; }
        .rp-table td { vertical-align: top; }
    </style>
}

<div class="page-breadcrumb">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h4 class="page-title text-uppercase text-primary font-weight-bold mb-0">GESTIONES</h4>
            <h2 class="font-weight-bold text-dark mb-0">Reconstruir planes de mantenimiento</h2>
            <div class="text-muted small">Arma la lista de equipos de cada gestión a partir de las verificaciones, solicitudes, mantenimientos y salidas ya registradas. No modifica ningún registro; se puede repetir sin duplicar.</div>
        </div>
        <div class="col-md-4 text-md-right mt-2 mt-md-0">
            <a asp-page="/Managements/Index" class="btn btn-light border btn-rounded btn-sm">
                <i class="mdi mdi-arrow-left mr-1"></i> Volver a gestiones
            </a>
        </div>
    </div>
</div>

<div class="container-fluid mt-3">

    @if (!Model.Managements.Any())
    {
        <div class="card border-0 shadow-sm rounded-lg"><div class="card-body text-center py-5">
            <i class="mdi mdi-calendar-remove fa-3x text-muted" aria-hidden="true"></i>
            <h5 class="font-weight-bold mt-3">No hay gestiones registradas</h5>
            <p class="text-muted mb-0">Cree una gestión antes de reconstruir sus planes.</p>
        </div></div>
    }
    else
    {
        <!-- Filtro por gestión -->
        <div class="card border-0 shadow-sm rounded-lg mb-3"><div class="card-body py-3">
            <form method="get" class="form-inline flex-wrap">
                <label for="rp-management" class="font-weight-bold mr-2 mb-1">Gestión</label>
                <select id="rp-management" name="ManagementId" class="custom-select custom-select-sm mb-1" onchange="this.form.submit()">
                    <option value="">Todas las gestiones</option>
                    @foreach (var m in Model.Managements)
                    {
                        <option value="@m.Id" selected="@(m.Id == Model.ManagementId)">@m.Code · @Model.TypeLabel(m.Type)</option>
                    }
                </select>
                <button type="submit" class="btn btn-outline-primary btn-rounded btn-sm ml-2 mb-1">
                    <i class="fas fa-filter mr-1"></i> Ver
                </button>
                <span class="small text-muted ml-auto mb-1">@Model.Preview.ManagementsCount gestión(es) en la vista previa</span>
            </form>
        </div></div>

        <!-- KPIs -->
        <div class="row mb-3">
            <div class="col-6 col-lg-3 mb-2">
                <div class="rp-kpi">
                    <div class="rp-kpi__value text-dark">@Model.Preview.ManagementsCount</div>
                    <div class="rp-kpi__label">Gestiones</div>
                </div>
            </div>
            <div class="col-6 col-lg-3 mb-2">
                <div class="rp-kpi">
                    <div class="rp-kpi__value text-muted">@Model.Preview.TotalExistingPlans</div>
                    <div class="rp-kpi__label">Planes existentes</div>
                </div>
            </div>
            <div class="col-6 col-lg-3 mb-2">
                <div class="rp-kpi">
                    <div class="rp-kpi__value text-info">@Model.Preview.TotalCandidateUnits</div>
                    <div class="rp-kpi__label">Equipos con registros</div>
                </div>
            </div>
            <div class="col-6 col-lg-3 mb-2">
                <div class="rp-kpi">
                    <div class="rp-kpi__value @(Model.Preview.TotalNewPlans > 0 ? "text-success" : "text-muted")">@Model.Preview.TotalNewPlans</div>
                    <div class="rp-kpi__label">Planes a crear</div>
                </div>
            </div>
        </div>

        <form method="post" asp-page-handler="Apply" id="rp-apply-form">
            <input type="hidden" name="ManagementId" value="@Model.ManagementId" />
            <div class="card border-0 shadow-sm rounded-lg"><div class="card-body p-0">
                <div class="d-flex flex-wrap align-items-center p-3 border-bottom">
                    <div class="mr-auto">
                        <div class="font-weight-bold text-dark"><i class="fas fa-tools mr-1" style="color:#7460ee;"></i>Vista previa por gestión</div>
                        <div class="small text-muted">Los planes nuevos se crean con el registro más reciente de cada paso y el estado que corresponde a ese avance.</div>
                    </div>
                    <button type="submit" class="btn btn-success btn-rounded font-weight-bold px-4 mt-2 mt-md-0" id="rp-apply"
                            disabled="@(Model.Preview.TotalNewPlans == 0)">
                        <i class="fas fa-layer-group mr-1"></i> Reconstruir @Model.Preview.TotalNewPlans plan(es)
                    </button>
                </div>

                @if (!Model.Preview.Managements.Any())
                {
                    <div class="text-center text-muted py-5">
                        <i class="fas fa-check-circle text-success fa-2x d-block mb-2"></i>
                        La gestión seleccionada no tiene registros de verificaciones, solicitudes, mantenimientos ni salidas con equipo.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 rp-table" id="rp-table">
                            <thead class="thead-light">
                                <tr>
                                    <th>Gestión</th>
                                    <th>Tipo</th>
                                    <th class="text-right">Planes existentes</th>
                                    <th class="text-right">Equipos con registros</th>
                                    <th class="text-right">Planes a crear</th>
                                    <th>Desglose por estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.Preview.Managements)
                                {
                                    <tr>
                                        <td class="font-weight-bold text-dark">@row.Code</td>
                                        <td>@Model.TypeLabel(row.Type)</td>
                                        <td class="text-right">@row.ExistingPlans</td>
                                        <td class="text-right">@row.CandidateUnits</td>
                                        <td class="text-right">
                                            @if (row.NewPlans > 0)
                                            {
                                                <span class="badge badge-success badge-pill">@row.NewPlans</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">0</span>
                                            }
                                        </td>
                                        <td>
                                            @if (row.NewPlansByState.Count == 0)
                                            {
                                                <span class="small text-muted">Nada que crear</span>
                                            }
                                            else
                                            {
                                                foreach (var state in stateOrder.Where(s => row.NewPlansByState.ContainsKey(s)))
                                                {
                                                    <span class="badge badge-@Model.StateBadge(state) badge-pill rp-state">
                                                        @row.NewPlansByState[state] @Model.StateLabel(state)
                                                    </span>
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (Model.Preview.TotalNewPlans == 0 && Model.Preview.Managements.Any())
                {
                    <div class="px-3 py-2 border-top small text-muted">
                        <i class="fas fa-info-circle mr-1"></i> Todos los equipos con registros ya tienen su plan. Nada por reconstruir.
                    </div>
                }
            </div></div>
        </form>
    }
</div>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('rp-apply-form');
            if (!form) return;
            form.addEventListener('submit', function (e) {
                if (form.dataset.confirmed === '1') return;
                e.preventDefault();
                var send = function () {
                    form.dataset.confirmed = '1';
                    var button = document.getElementById('rp-apply');
                    if (button) { button.disabled = true; button.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Reconstruyendo…'; }
                    HTMLFormElement.prototype.submit.call(form);
                };
                if (typeof Swal === 'undefined') { send(); return; }
                Swal.fire({
                    title: '¿Reconstruir los planes?',
                    text: 'Se crearán los planes faltantes enlazando la verificación, solicitud, mantenimiento y salida más recientes de cada equipo. No se modifica ningún registro existente.',
                    type: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, reconstruir',
                    cancelButtonText: 'Cancelar',
                    confirmButtonColor: '#36bea6'
                }).then(function (result) { if (result && (result.value === true || result.isConfirmed === true)) send(); });
            });
        })();
    </script>
}
