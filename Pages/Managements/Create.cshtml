@page
@model Proyecto_Laboratorios_Univalle.Pages.Managements.CreateModel

@{
    ViewData["Title"] = "Crear Nueva Gestión L-48";
}

<div class="row page-titles">
    <div class="col-md-5 align-self-center">
        <h3 class="text-themecolor">Nueva Gestión</h3>
    </div>
    <div class="col-md-7 align-self-center">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="./Index">Gestiones L-48</a></li>
            <li class="breadcrumb-item active">Crear Registro</li>
        </ol>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-12">
            <div class="card shadow-sm border-top-info">
                <div class="card-header bg-white">
                    <h4 class="m-b-0 text-dark"><i class="fas fa-magic text-info"></i> Formulario de Apertura de Gestión</h4>
                    <p class="text-muted mb-0">Complete la información general para registrar un nuevo período (Módulo 2).</p>
                </div>
                <div class="card-body">
                    <form method="post">
                        <!-- Redirección rápida a Solicitud si falla -->
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 font-weight-bold"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.Code" class="control-label font-weight-bold"></label>
                                <input asp-for="Input.Code" class="form-control" placeholder="Ej: L48-2024-SEM1" />
                                <span asp-validation-for="Input.Code" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.Name" class="control-label font-weight-bold"></label>
                                <input asp-for="Input.Name" class="form-control" placeholder="Ej: Gestión Académica Par" />
                                <span asp-validation-for="Input.Name" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="Input.Responsible" class="control-label font-weight-bold"></label>
                                <input asp-for="Input.Responsible" class="form-control" placeholder="Nombre completo del encargado o líder" />
                                <span asp-validation-for="Input.Responsible" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.StartDate" class="control-label font-weight-bold"></label>
                                <input asp-for="Input.StartDate" class="form-control" />
                                <span asp-validation-for="Input.StartDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.PlannedEndDate" class="control-label font-weight-bold"></label>
                                <input asp-for="Input.PlannedEndDate" class="form-control" />
                                <span asp-validation-for="Input.PlannedEndDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="Input.Description" class="control-label font-weight-bold"></label>
                                <textarea asp-for="Input.Description" class="form-control" rows="3" placeholder="Contexto u observaciones de esta gestión..."></textarea>
                                <span asp-validation-for="Input.Description" class="text-danger"></span>
                            </div>
                        </div>

                        <hr />
                        <div class="d-flex justify-content-end mt-4">
                            <a asp-page="./Index" class="btn btn-outline-secondary btn-rounded mr-2">Cancelar</a>
                            <button type="submit" class="btn btn-info btn-rounded shadow-sm">
                                <i class="fas fa-save"></i> Iniciar Gestión L-48
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
