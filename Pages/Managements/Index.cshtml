@page
@using Proyecto_Laboratorios_Univalle.Models.Enums
@model Proyecto_Laboratorios_Univalle.Pages.Managements.IndexModel

@{
    ViewData["Title"] = "Gestiones de Mantenimiento";
}

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <ul class="nav nav-tabs customtab px-4 pt-3" role="tablist">
                <li class="nav-item">
                    <a class="nav-link @(Model.Type != "Corrective" ? "active" : "") font-weight-bold uppercase small"
                       href="?Type=Preventive">
                        <i class="fas fa-folder-open mr-2"></i> Preventivo
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(Model.Type == "Corrective" ? "active" : "") font-weight-bold uppercase small"
                       href="?Type=Corrective">
                        <i class="fas fa-tools mr-2"></i> Correctivo
                    </a>
                </li>
            </ul>

            <div class="tab-content">
                <div class="tab-pane active" id="gestiones" role="tabpanel">
                    <div class="card-body">
                        <div class="d-md-flex align-items-center mb-4">
                            <div>
                                <h3 class="card-title text-dark font-weight-bold mt-2 ml-2">Gestiones de Mantenimiento</h3>
                                <h6 class="card-subtitle text-muted ml-2">Gestión centralizada de ciclos de mantenimiento.</h6>
                            </div>
                            <div class="ml-auto mt-3">
                                <a asp-page="Create" asp-route-type="@Model.Type" class="btn bg-white border btn-rounded shadow-sm text-dark px-4 font-weight-bold">
                                    <i class="fas fa-plus-circle mr-1 text-info"></i> @(Model.Type == "Corrective" ? "Nueva Gestión Correctiva" : "Nueva Gestión")
                                </a>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover v-middle">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="border-top-0">Código / Período</th>
                                        <th class="border-top-0">Descripción</th>
                                        <th class="border-top-0 text-center">Avance L-48</th>
                                        <th class="border-top-0 text-center">Estado</th>
                                        <th class="border-top-0 text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.ManagementList == null || !Model.ManagementList.Any(m => m.Status != ManagementStatus.Deleted))
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center py-5 text-muted italic font-weight-bold">
                                                <i class="fas fa-folder-open fa-3x mb-3 d-block opacity-2"></i>
                                                No se encontraron gestiones registradas.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        foreach (var item in Model.ManagementList.Where(m => m.Status != ManagementStatus.Deleted))
                                        {
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div class="m-r-10">
                                                            <span class="btn btn-circle btn-sm @(item.Status == ManagementStatus.Active ? "btn-light-success text-success" : "btn-light-info text-info")">
                                                                <i class="fas fa-calendar-check"></i>
                                                            </span>
                                                        </div>
                                                        <div>
                                                            <h6 class="m-b-0 font-weight-bold text-dark">@item.Year - Semestre @item.Semester</h6>
                                                            <span class="text-muted small">ID: @item.Code</span>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <small class="text-muted d-block text-truncate" style="max-width: 250px;" title="@item.Description">
                                                        @(string.IsNullOrEmpty(item.Description) ? "Sin descripción detallada" : item.Description)
                                                    </small>
                                                    <div class="font-12">
                                                        <i class="fas fa-user-tie mr-1 text-muted"></i> Resp: @item.Responsible
                                                    </div>
                                                </td>
                                                <td class="text-center" style="min-width: 150px;">
                                                    <div class="progress mb-1" style="height: 6px;">
                                                        <div class="progress-bar bg-info" role="progressbar" style="width: @item.CompletionPercentage%" aria-valuenow="@item.CompletionPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                                                    </div>
                                                    <small class="font-weight-bold text-dark">@item.CompletionPercentage% (@item.CompletedMaintenances/@item.TotalEquipments)</small>
                                                </td>
                                                <td class="text-center v-middle">
                                                    @{
                                                        var (statusClass, statusText) = item.Status switch
                                                        {
                                                            ManagementStatus.Active => ("badge-light-success text-success", "ACTIVO"),
                                                            ManagementStatus.Inactive => ("badge-light-warning text-warning", "INACTIVO"),
                                                            ManagementStatus.Completed => ("badge-light-danger text-danger", "TERMINADO"),
                                                            _ => ("badge-secondary", "DESCONOCIDO")
                                                        };
                                                    }
                                                    <span class="badge badge-pill @statusClass px-3 py-1 font-weight-bold shadow-sm border">@statusText</span>
                                                </td>
                                                <td class="text-center v-middle">
                                                    <div class="btn-group">
                                                        <a asp-page="./Details" asp-route-id="@item.Id" asp-route-ActiveTab="dashboard" class="btn btn-sm btn-outline-info btn-rounded shadow-sm" title="Dashboard">
                                                            <i class="fas fa-chart-pie"></i>
                                                        </a>
                                                        <a asp-page="./Details" asp-route-id="@item.Id" asp-route-ActiveTab="l48" class="btn btn-sm btn-outline-success btn-rounded shadow-sm" title="L-48 / Cronograma">
                                                            <i class="fas fa-table"></i>
                                                        </a>
                                                        <a asp-page="./Details" asp-route-id="@item.Id" asp-route-ActiveTab="calendario" class="btn btn-sm btn-outline-secondary btn-rounded shadow-sm" title="Calendario">
                                                            <i class="fas fa-calendar-alt"></i>
                                                        </a>

                                                        @if (item.Status == ManagementStatus.Active && item.Type != ManagementType.Corrective)
                                                        {
                                                            <form method="post" asp-page-handler="SyncPlans" asp-route-id="@item.Id" class="d-inline ml-1">
                                                                <button type="submit" class="btn btn-sm btn-outline-primary btn-rounded shadow-sm" title="Sincronizar Nuevos Equipos">
                                                                    <i class="fas fa-sync"></i>
                                                                </button>
                                                            </form>
                                                        }
                                                        <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning btn-rounded mx-1 shadow-sm" title="Editar">
                                                            <i class="fas fa-edit"></i>
                                                        </a>
                                                        @if (item.Status != ManagementStatus.Active || item.Type == ManagementType.Corrective)
                                                        {
                                                            <form method="post" asp-page-handler="DeleteLogical" asp-route-id="@item.Id" class="d-inline" onsubmit="return confirm('¿Estás seguro de eliminar esta gestión?');">
                                                                <button type="submit" class="btn btn-sm btn-outline-danger btn-rounded shadow-sm" title="Eliminar (Lógico)">
                                                                    <i class="fas fa-trash"></i>
                                                                </button>
                                                            </form>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (Model.ManagementList.TotalPages > 1)
                        {
                            <nav aria-label="Paginación">
                                <ul class="pagination justify-content-center">
                                    @if (Model.ManagementList.HasPreviousPage)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" asp-page="./Index" asp-route-type="@Model.Type" asp-route-pageIndex="@(Model.ManagementList.PageIndex - 1)">Anterior</a>
                                        </li>
                                    }
                                    @for (var i = 1; i <= Model.ManagementList.TotalPages; i++)
                                    {
                                        <li class="page-item @(i == Model.ManagementList.PageIndex ? "active" : "")">
                                            <a class="page-link" asp-page="./Index" asp-route-type="@Model.Type" asp-route-pageIndex="@i">@i</a>
                                        </li>
                                    }
                                    @if (Model.ManagementList.HasNextPage)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" asp-page="./Index" asp-route-type="@Model.Type" asp-route-pageIndex="@(Model.ManagementList.PageIndex + 1)">Siguiente</a>
                                        </li>
                                    }
                                </ul>
                            </nav>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .customtab .nav-link {
            border: none;
            color: #747d8c;
            padding: 15px 25px;
            transition: all 0.3s ease;
        }
        .customtab .nav-link.active {
            color: #2962ff;
            background: transparent;
            border-bottom: 3px solid #2962ff;
        }
        .v-middle td {
            vertical-align: middle !important;
        }
        .uppercase {
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
    </style>
}
