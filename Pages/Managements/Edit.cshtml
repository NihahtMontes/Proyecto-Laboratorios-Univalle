@page
@model Proyecto_Laboratorios_Univalle.Pages.Managements.EditModel

@{
    ViewData["Title"] = "Editar Gestión L-48";
}

<div class="row page-titles">
    <div class="col-md-5 align-self-center">
        <h3 class="text-themecolor">Editar Gestión</h3>
    </div>
    <div class="col-md-7 align-self-center">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="./Index">Gestiones L-48</a></li>
            <li class="breadcrumb-item active">Editar Registro</li>
        </ol>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card shadow-sm border-top-warning">
                <div class="card-header bg-white">
                    <h4 class="m-b-0 text-dark font-weight-bold"><i class="fas fa-edit text-warning"></i> Modificación de Gestión</h4>
                    <p class="text-muted mb-0 font-12">Actualice los parámetros del periodo. Los cambios afectarán la visualización en el Dashboard.</p>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 font-weight-bold"></div>
                        <input type="hidden" asp-for="Input.Id" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.Year" class="control-label font-weight-bold"></label>
                                <input asp-for="Input.Year" class="form-control" type="number" />
                                <span asp-validation-for="Input.Year" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.Semester" class="control-label font-weight-bold"></label>
                                <select asp-for="Input.Semester" class="form-control custom-select">
                                    <option value="1">Semestre 1 (Junio - Julio)</option>
                                    <option value="2">Semestre 2 (Diciembre - Enero)</option>
                                </select>
                                <span asp-validation-for="Input.Semester" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.StartDate" class="control-label font-weight-bold"></label>
                                <input asp-for="Input.StartDate" class="form-control" type="date" />
                                <span asp-validation-for="Input.StartDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.PlannedEndDate" class="control-label font-weight-bold"></label>
                                <input asp-for="Input.PlannedEndDate" class="form-control" type="date" />
                                <span asp-validation-for="Input.PlannedEndDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="Input.Description" class="control-label font-weight-bold"></label>
                                <textarea asp-for="Input.Description" class="form-control" rows="3" placeholder="Observaciones de esta gestión..."></textarea>
                                <span asp-validation-for="Input.Description" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row border-top pt-3">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.Status" class="control-label font-weight-bold"></label>
                                <select asp-for="Input.Status" class="form-control custom-select" 
                                        asp-items="Html.GetEnumSelectList<Proyecto_Laboratorios_Univalle.Models.Enums.ManagementStatus>()">
                                </select>
                                <span asp-validation-for="Input.Status" class="text-danger"></span>
                            </div>
                        </div>

                        <hr />
                        <div class="d-flex justify-content-end mt-4">
                            <a asp-page="./Index" class="btn btn-outline-secondary btn-rounded mr-2">Cancelar</a>
                            <button type="submit" class="btn btn-warning btn-rounded shadow-sm px-4">
                                <i class="fas fa-save mr-1 text-white"></i> <span class="text-white">Actualizar Gestión</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
