@page
@model Proyecto_Laboratorios_Univalle.Pages.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Ingreso al Sistema | Proyecto Laboratorios";
}

<!DOCTYPE html>
<html lang="es" dir="ltr">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Acceso al sistema de gestión de laboratorios Univalle.">

    <title>@ViewData["Title"]</title>

    <!-- Tipografía Premium: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- CSS y Favicon -->
    <link rel="icon" type="image/png" sizes="16x16" href="~/assets/images/favicon.png">
    <link href="~/dist/css/style.min.css" rel="stylesheet">

    <style>
      /* 1. Fondo de pantalla - Cocina Industrial / Laboratorio de Gastronomía */
        .auth-wrapper {
            /* Imagen sugerente de laboratorio de gastronomía moderno */
            background-image: url('https://images.unsplash.com/photo-1600565193348-f74bd3c7ccdf?q=80&w=2070&auto=format&fit=crop');
            background-repeat: no-repeat;
            background-position: center center;
            background-size: cover;
            min-height: 100vh;
            position: relative;
            width: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 0;
            padding: 0;
            overflow: hidden;
        }
        /* Overlay oscuro para enfocar la tarjeta y que las letras se lean bien */
        .auth-wrapper::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(15, 23, 42, 0.65); /* Tono Navy oscuro translúcido */
            z-index: 1;
        }

        /* 2. Tarjeta Premium Split */
        .auth-box {
            position: relative;
            z-index: 2;
            background: #ffffff;
            width: 950px !important; 
            max-width: 95% !important;
            min-height: 550px;
            display: flex !important;
            flex-direction: row !important;
            border-radius: 24px;
            box-shadow: 0 40px 80px -20px rgba(0, 0, 0, 0.8);
            overflow: hidden;
            animation: floatUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            margin: auto;
        }

        @@keyframes floatUp {
            from { transform: translateY(40px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        /* 3. PANEL IZQUIERDO: Branding Azul Profundo Univalle */
        .auth-left {
            width: 42% !important;
            background: linear-gradient(135deg, #112240 0%, #020617 100%);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 50px 40px;
            position: relative;
            border-right: 1px solid rgba(255, 255, 255, 0.1);
        }

        .auth-left img {
            width: 70px;
            margin-bottom: 25px;
            filter: brightness(0) invert(1);
        }

        .brand-title {
            font-weight: 900;
            color: #ffffff;
            letter-spacing: 5px;
            text-transform: uppercase;
            font-size: 1.8rem;
            margin-bottom: 8px;
            text-align: center;
        }

        .brand-subtitle {
            font-weight: 500;
            color: #60a5fa;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 2px;
            text-align: center;
            line-height: 1.6;
            margin: 0;
        }

        /* 4. PANEL DERECHO: Formulario Limpio */
        .auth-right {
            width: 58% !important;
            padding: 60px 80px;
            background: #ffffff;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .form-title {
            font-weight: 900;
            color: #0f172a;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            font-size: 2rem;
            line-height: 1.2;
            text-align: center;
            margin-bottom: 8px;
        }

        .form-subtitle {
            color: #64748b;
            font-size: 0.95rem;
            font-weight: 500;
            text-align: center;
            margin-bottom: 40px;
        }

        /* 5. Inputs Modernos */
        .form-label-custom {
            font-size: 0.75rem;
            font-weight: 800;
            color: #475569;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 0.6rem;
            display: block;
        }

        .input-group-custom {
            display: flex;
            align-items: center;
            background: #f8fafc; 
            border: 1.5px solid #cbd5e1;
            border-radius: 12px;
            overflow: hidden;
            transition: all 0.3s ease;
            margin-bottom: 1.5rem;
        }
        
        .input-group-custom:focus-within {
            background: #ffffff;
            border-color: #2563eb;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.15);
        }

        .input-group-custom .form-control {
            border: none;
            box-shadow: none !important;
            padding: 1.2rem 1rem 1.2rem 0;
            color: #0f172a;
            font-size: 1rem;
            font-weight: 600;
            flex: 1;
            background: transparent;
            outline: none;
        }
        
        .input-group-custom .form-control::placeholder {
            color: #94a3b8;
            font-weight: 500;
        }

        .input-group-custom .input-group-text {
            background: transparent;
            border: none;
            color: #94a3b8;
            padding: 1.2rem 1.2rem;
        }

        .input-group-custom:focus-within .input-group-text i {
            color: #2563eb;
        }

        /* 6. Botón de Login */
        .btn-login-glow {
            background: linear-gradient(to right, #2563eb, #1e40af);
            border: none;
            border-radius: 12px;
            padding: 16px;
            font-weight: 800;
            font-size: 1rem;
            color: white;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            transition: all 0.3s ease;
            box-shadow: 0 10px 20px -5px rgba(37, 99, 235, 0.5);
            width: 100%;
            margin-top: 10px;
            cursor: pointer;
        }

        .btn-login-glow:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 25px -5px rgba(37, 99, 235, 0.7);
        }

        /* Checkbox */
        .custom-checkbox-container {
            display: flex;
            align-items: center;
            margin-bottom: 2.5rem;
            padding-left: 5px;
        }

        .custom-checkbox-container input[type="checkbox"] {
            width: 18px;
            height: 18px;
            margin-right: 12px;
            cursor: pointer;
            accent-color: #2563eb; 
        }

        .custom-checkbox-container label {
            color: #475569;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            margin: 0;
            user-select: none;
        }

        /* Responsivo (Celulares) */
        @@media (max-width: 768px) {
            .auth-box {
                flex-direction: column !important;
                width: 100% !important;
                max-width: 450px !important;
                min-height: auto;
            }
            .auth-left {
                width: 100% !important;
            }
            .auth-right {
                width: 100% !important;
            }
        }
    </style>
</head>
<body>
    <div class="main-wrapper">
        <!-- Preloader -->
        <div class="preloader">
            <div class="lds-ripple"><div class="lds-pos"></div><div class="lds-pos"></div></div>
        </div>

        <!-- Main Container -->
        <div class="auth-wrapper">
            <!-- Tarjeta Split -->
            <div class="auth-box">
                
                <!-- LADO IZQUIERDO: Branding Azul Profundo -->
                <div class="auth-left">
                    <img src="~/assets/images/logo-icon.png" alt="logo Univalle" />
                    <h3 class="brand-title">Univalle</h3>
                    <p class="brand-subtitle">Gestión de<br>Gastronomía</p>
                </div>

                <!-- LADO DERECHO: Formulario -->
                <div class="auth-right">
                    <div id="loginform">
                        
                        <div class="mb-4">
                            <h3 class="form-title">Ingreso<br>al Sistema</h3>
                            <p class="form-subtitle">Portal de Gestión Administrativa de Laboratorios</p>
                        </div>

                        <!-- FORMULARIO: Lógica 100% intacta -->
                        <form id="login-form" method="post">

                            <!-- Validation Summary -->
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded text-sm mb-3" role="alert"></div>

                            <!-- Username Input -->
                            <div>
                                <label asp-for="Input.UserName" class="form-label-custom">Usuario o Correo</label>
                                <div class="input-group-custom">
                                    <div class="input-group-text"><i class="ti-user"></i></div>
                                    <input asp-for="Input.UserName" class="form-control" placeholder="Ej: admin" required autofocus>
                                </div>
                                <span asp-validation-for="Input.UserName" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Password Input -->
                            <div>
                                <label asp-for="Input.Password" class="form-label-custom">Contraseña</label>
                                <div class="input-group-custom">
                                    <div class="input-group-text"><i class="ti-lock"></i></div>
                                    <input asp-for="Input.Password" type="password" class="form-control" placeholder="••••••••" required>
                                </div>
                                <span asp-validation-for="Input.Password" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Remember Me Checkbox -->
                            <div class="custom-checkbox-container">
                                <input asp-for="Input.RememberMe" type="checkbox" id="customCheck1">
                                <label for="customCheck1">Recordarme en este equipo</label>
                            </div>

                            <!-- Login Button -->
                            <div>
                                <button class="btn-login-glow" type="submit">
                                    INICIAR SESIÓN
                                </button>
                            </div>

                            <!-- Footer Text -->
                            <div class="mt-5 text-center">
                                <small class="text-muted">
                                    © @DateTime.UtcNow.Year Universidad del Valle <br> Sistema de Gestión de Laboratorios
                                </small>
                            </div>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/assets/libs/jquery/dist/jquery.min.js"></script>
    <script src="~/assets/libs/bootstrap/dist/js/bootstrap.min.js"></script>

    <script>
        $(function() {
            "use strict";
            $(".preloader").fadeOut();
        });
    </script>
</body>
</html>