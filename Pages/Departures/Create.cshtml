@page
@model Proyecto_Laboratorios_Univalle.Pages.Departures.CreateModel
@using Proyecto_Laboratorios_Univalle.Models.Enums

@{
    ViewData["Title"] = "Registrar Salida de Equipo (L-3)";
    bool isWizard = (bool)(ViewData["IsWizard"] ?? false);
}

<div class="row justify-content-center">
    <div class="col-lg-12">

        @if (isWizard)
        {
            await Html.RenderPartialAsync("_WizardSteps", 4);
        }

        <div class="card shadow-sm border-0 mt-3">
            <div class="card-body p-4">
                <div class="d-flex no-block align-items-center mb-4 pb-3 border-bottom">
                    <div>
                        <h4 class="card-title text-dark font-weight-bold">Registrar Salida de Equipo (L-3)</h4>
                        <h6 class="card-subtitle text-muted italic">Control de custodia y salidas temporales de activos fijos.</h6>
                    </div>
                    <div class="ml-auto mt-2 mt-md-0 text-right">
                         <i class="fas fa-sign-out-alt fa-2x text-warning"></i>
                    </div>
                </div>

                <!-- TABS DE SELECCIÓN DE TIPO -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="btn-group btn-group-toggle d-flex w-100 shadow-sm rounded overflow-hidden border" data-toggle="buttons">
                            <label class="btn btn-outline-info active border-0 py-3 w-50 font-weight-bold" id="label-loan-btn">
                                <input type="radio" name="tempType" id="type-loan" autocomplete="off" checked data-type="2"> 
                                <i class="fas fa-exchange-alt mr-2"></i> Préstamo Interno
                            </label>
                            <label class="btn btn-outline-warning border-0 py-3 w-50 font-weight-bold" id="label-maintenance-btn">
                                <input type="radio" name="tempType" id="type-maint" autocomplete="off" data-type="3"> 
                                <i class="fas fa-tools mr-2 text-dark"></i> Mantenimiento Externo
                            </label>
                        </div>
                    </div>
                    <div class="col-md-6 d-flex align-items-center mt-3 mt-md-0">
                        <div class="alert alert-light py-2 px-3 mb-0 border-left border-info shadow-none small d-flex align-items-center w-100">
                            <i class="fas fa-info-circle mr-2 text-info fa-lg"></i>
                            <span id="type-info-text" class="italic">Este registro crea una orden de salida temporal para el control de activos institucionales.</span>
                        </div>
                    </div>
                </div>

                <form method="post" id="departureForm" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm border-0 mb-4 small"></div>
                    
                    <input type="hidden" name="isWizard" value="@isWizard.ToString().ToLower()" />
                    <input type="hidden" asp-for="ManagementPlanId" />
                    <input type="hidden" asp-for="Input.Type" id="hiddenType" />

                    <div class="bg-light p-4 rounded mb-4 border-left border-warning shadow-sm" style="border-left-width: 4px;">
                        <h5 class="text-dark font-weight-bold mb-3 uppercase small"><i class="fas fa-microchip mr-2 text-warning"></i>Localización del Activo</h5>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="Input.FacultyId" class="control-label font-weight-bold small text-uppercase text-muted">Facultad <span class="text-danger">*</span></label>
                                    <select asp-for="Input.FacultyId" class="form-control custom-select border-warning" asp-items="ViewBag.FacultyId" id="facultySelector" required>
                                        <option value="">-- Seleccione Facultad --</option>
                                    </select>
                                    <span asp-validation-for="Input.FacultyId" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="Input.LaboratoryId" class="control-label font-weight-bold small text-uppercase text-muted">Ambiente / Lab <span class="text-danger">*</span></label>
                                    <select asp-for="Input.LaboratoryId" class="form-control custom-select border-warning" asp-items="ViewBag.LaboratoryId" id="labSelector" required>
                                        <option value="">-- Seleccione Laboratorio --</option>
                                    </select>
                                    <span asp-validation-for="Input.LaboratoryId" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="Input.EquipmentUnitId" class="control-label font-weight-bold small text-uppercase text-muted">Equipo Específico <span class="text-danger">*</span></label>
                                    <select asp-for="Input.EquipmentUnitId" class="form-control custom-select border-warning" asp-items="ViewBag.EquipmentUnitId" id="unitSelector" required>
                                        <option value="">-- Seleccione Equipo --</option>
                                    </select>
                                    <span asp-validation-for="Input.EquipmentUnitId" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-lg-7">
                            <h5 class="text-info font-weight-bold mb-3 uppercase small"><i class="far fa-user mr-2"></i>Identificación General</h5>
                            <div class="card border mb-4 shadow-sm">
                                <div class="card-body">
                                    <div class="form-group mb-4">
                                        <label asp-for="Input.BorrowerId" class="control-label font-weight-bold small text-uppercase text-muted" id="label-borrower">Responsable / Solicitante <span class="text-danger">*</span></label>
                                        <select asp-for="Input.BorrowerId" class="form-control custom-select bg-white border-info" asp-items="ViewBag.BorrowerId" required>
                                            <option value="">-- Seleccione del Catálogo --</option>
                                        </select>
                                        <span asp-validation-for="Input.BorrowerId" class="text-danger small"></span>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 border-right">
                                            <div class="form-group mb-0">
                                                <label asp-for="Input.DepartureDate" class="control-label font-weight-bold small text-uppercase text-muted">Fecha Efectiva de Salida <span class="text-danger">*</span></label>
                                                <input asp-for="Input.DepartureDate" class="form-control" type="date" required />
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group mb-0">
                                                <label asp-for="Input.EstimatedReturnDate" class="control-label font-weight-bold small text-uppercase text-muted">Retorno Estimado <span class="text-danger">*</span></label>
                                                <input asp-for="Input.EstimatedReturnDate" class="form-control border-danger" type="date" required />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-5">
                            <h5 class="text-primary font-weight-bold mb-3 uppercase small"><i class="fas fa-comment-dots mr-2"></i>Notas de Salida</h5>
                            <div class="card bg-light border-0 mb-4 shadow-sm">
                                <div class="card-body p-4">
                                    <div class="form-group mb-0">
                                        <label asp-for="Input.DepartureObservations" class="control-label font-weight-bold small text-uppercase text-muted italic">Estado físico del activo al salir</label>
                                        <textarea asp-for="Input.DepartureObservations" class="form-control bg-white shadow-none" rows="4" placeholder="Ej: Equipo sale en buen estado, incluye cables y manuales..."></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="mt-4" />

                    <div class="form-actions text-right pb-4 mt-4">
                        @if (isWizard)
                        {
                            <a asp-page="/Wizard/Index" asp-route-Step="4" class="btn btn-outline-secondary btn-rounded px-4 mr-2 font-weight-bold">
                                <i class="fas fa-undo mr-1"></i> Volver al Wizard
                            </a>
                        }
                        else
                        {
                            <a asp-page="./Index" class="btn btn-outline-secondary btn-rounded px-4 mr-2 font-weight-bold">
                                 <i class="fas fa-times mr-1"></i> Cancelar
                            </a>
                        }
                        <button type="submit" class="btn btn-warning btn-rounded px-5 shadow-sm font-weight-bold text-dark py-2">
                            <i class="fas fa-save mr-1"></i> Registrar Salida L-3
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section Styles {
    <style>
        .btn-group-toggle .btn { border: 1px solid #e9ecef !important; color: #6c757d; background: #f8f9fa; }
        .btn-group-toggle .btn.active { background: #2962ff !important; color: white !important; border-color: #2962ff !important; box-shadow: 0 4px 10px rgba(41, 98, 255, 0.2) !important; }
        #label-maintenance-btn.active { background: #4fc3f7 !important; border-color: #4fc3f7 !important; }
    </style>
}

@section Scripts {
    <script src="~/assets/extra-libs/jqbootstrapvalidation/validation.js"></script>
    <script>
        $(function () {
            "use strict";
            $("input,select,textarea").not("[type=submit]").jqBootstrapValidation();

            // LÓGICA DE TABS (TIPO DE SALIDA)
            $('input[name="tempType"]').change(function() {
                const type = $(this).data('type');
                $('#hiddenType').val(type);
                
                if(type == 3) { // Mantenimiento
                    $('#type-info-text').text("La salida por mantenimiento externo registra la custodia temporal por parte de un proveedor autorizado.");
                    $('#label-borrower').text("Proveedor / Técnico Externo");
                } else { // Préstamo
                    $('#type-info-text').text("Este registro crea una orden de salida temporal para el control de activos institucionales.");
                    $('#label-borrower').text("Responsable / Solicitante");
                }
            });

            // Sincronizar estado inicial de tabs si el modelo trae un valor (Wizard)
            const initialType = $('#hiddenType').val();
            if(initialType == 3) {
                $('#type-maint').prop('checked', true);
                $('#label-loan-btn').removeClass('active');
                $('#label-maintenance-btn').addClass('active');
                $('#type-maint').trigger('change');
            } else {
                $('#hiddenType').val(2); // Préstamo por defecto
            }

            // Selectores cascada
            $('#facultySelector').change(function () {
                var facultyId = $(this).val();
                $('#labSelector').empty().append('<option value="">-- Seleccione Laboratorio --</option>');
                $('#unitSelector').empty().append('<option value="">-- Seleccione Equipo --</option>');
                if (!facultyId) return;

                $.get('?handler=LaboratoriesByFaculty&facultyId=' + facultyId, function (data) {
                    $.each(data, function (i, item) {
                        $('#labSelector').append('<option value="' + item.id + '">' + item.name + '</option>');
                    });
                });
            });

            $('#labSelector').change(function () {
                var labId = $(this).val();
                $('#unitSelector').empty().append('<option value="">-- Seleccione Equipo --</option>');
                if (!labId) return;

                $.get('?handler=UnitsByLab&laboratoryId=' + labId, function (data) {
                    $.each(data, function (i, item) {
                        $('#unitSelector').append('<option value="' + item.id + '">' + item.name + '</option>');
                    });
                });
            });
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
