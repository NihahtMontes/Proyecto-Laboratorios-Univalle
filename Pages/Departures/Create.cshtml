@page
@model Proyecto_Laboratorios_Univalle.Pages.Departures.CreateModel
@using Proyecto_Laboratorios_Univalle.Models.Enums

@{
    ViewData["Title"] = "Registrar Salida de Equipo (L-3)";
    bool isWizard = (bool)(ViewData["IsWizard"] ?? false);
    int currentPhaseInt = (int)(ViewData["CurrentPhaseInt"] ?? 4);
}

<div class="row justify-content-center">
    <div class="col-lg-12">

        @if (isWizard)
        {
            await Html.RenderPartialAsync("_WizardSteps", currentPhaseInt);
        }

        <div class="card shadow-sm border-0 mt-3">
            <div class="card-body p-4">
                <div class="d-flex no-block align-items-center mb-4 pb-3 border-bottom">
                    <div>
                        <h4 class="card-title text-dark font-weight-bold">Registrar Salida de Equipo (L-3)</h4>
                        <h6 class="card-subtitle text-muted italic">Control de custodia y salidas temporales de activos fijos.</h6>
                    </div>
                    <div class="ml-auto mt-2 mt-md-0 text-right">
                         <i class="fas fa-sign-out-alt fa-2x text-warning"></i>
                    </div>
                </div>

@{
    bool techMissing = isWizard && (bool)(ViewData["TechnicianMissing"] ?? false);
    string techName = ViewData["TechnicianName"]?.ToString() ?? "—";
    bool techIsExtern = (bool)(ViewData["TechnicianIsExtern"] ?? false);
    string inferredTypeLabel = ViewData["InferredTypeLabel"]?.ToString() ?? "";
}

@if (!isWizard)
{
    <!-- TABS DE SELECCIÓN DE TIPO (solo fuera del wizard) -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="btn-group btn-group-toggle d-flex w-100 shadow-sm rounded overflow-hidden border" data-toggle="buttons">
                <label class="btn btn-outline-info active border-0 py-3 w-50 font-weight-bold" id="label-loan-btn">
                    <input type="radio" name="tempType" id="type-loan" autocomplete="off" checked data-type="2"> 
                    <i class="fas fa-exchange-alt mr-2"></i> Préstamo Interno
                </label>
                <label class="btn btn-outline-warning border-0 py-3 w-50 font-weight-bold" id="label-maintenance-btn">
                    <input type="radio" name="tempType" id="type-maint" autocomplete="off" data-type="3"> 
                    <i class="fas fa-tools mr-2 text-dark"></i> Mantenimiento Externo
                </label>
            </div>
        </div>
        <div class="col-md-6 d-flex align-items-center mt-3 mt-md-0">
            <div class="alert alert-light py-2 px-3 mb-0 border-left border-info shadow-none small d-flex align-items-center w-100">
                <i class="fas fa-info-circle mr-2 text-info fa-lg"></i>
                <span id="type-info-text" class="italic">Este registro crea una orden de salida temporal para el control de activos institucionales.</span>
            </div>
        </div>
    </div>
}

@if (isWizard && techMissing)
{
    <!-- BLOQUEO: sin técnico en L-8 -->
    <div class="alert d-flex align-items-center mb-4 shadow-sm" style="background:#fef2f2; border:1.5px solid #fecaca; border-radius:12px; padding:1.25rem;">
        <div class="mr-3" style="color:#ef4444; font-size:2rem;"><i class="fas fa-exclamation-triangle"></i></div>
        <div class="flex-grow-1">
            <h6 class="font-weight-bold mb-1" style="color:#b91c1c;">No hay técnico asignado en L-8</h6>
            <p class="mb-0 small" style="color:#7f1d1d;">Para registrar la salida, primero debe asignar un técnico en el acta de mantenimiento (L-8). La salida queda vinculada al técnico responsable.</p>
        </div>
        @if (ViewData["LinkedMaintenanceId"] != null)
        {
            <a href="/Maintenances/Edit?id=@ViewData["LinkedMaintenanceId"]" class="btn btn-sm btn-outline-danger btn-rounded font-weight-bold ml-3 shadow-sm">
                <i class="fas fa-edit mr-1"></i> Asignar Técnico en L-8
            </a>
        }
    </div>
}

@if (isWizard && !techMissing)
{
    <!-- CARD DE TÉCNICO INFERIDO (solo en wizard cuando hay técnico) -->
    <div class="row mb-4">
        <div class="col-md-8">
            <div class="p-3 rounded" style="background:#f0fdf4; border:1.5px solid #86efac;">
                <div class="d-flex align-items-center">
                    <div class="mr-3" style="color:#16a34a; font-size:1.5rem;">
                        <i class="fas @(techIsExtern ? "fa-user-tie" : "fa-user-cog")"></i>
                    </div>
                    <div class="flex-grow-1">
                        <p class="font-weight-bold mb-0" style="color:#166534;">@techName</p>
                        <small class="text-muted">Técnico responsable derivado de L-8</small>
                    </div>
                    <span class="badge @(techIsExtern ? "badge-warning" : "badge-success") px-3 py-2 ml-auto">
                        <i class="fas fa-tag mr-1"></i> @inferredTypeLabel
                    </span>
                </div>
            </div>
        </div>
    </div>
}

                <form method="post" id="departureForm" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm border-0 mb-4 small"></div>
                    
                    <input type="hidden" name="isWizard" value="@isWizard.ToString().ToLower()" />
                    <input type="hidden" asp-for="ManagementPlanId" />
                    <input type="hidden" asp-for="Input.Type" id="hiddenType" />

                    <div class="bg-light p-4 rounded mb-4 border-left border-warning shadow-sm" style="border-left-width: 4px;">
                        <h5 class="text-dark font-weight-bold mb-3 uppercase small"><i class="fas fa-microchip mr-2 text-warning"></i>Localización del Activo</h5>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="Input.FacultyId" class="control-label font-weight-bold small text-uppercase text-muted">Facultad <span class="text-danger">*</span></label>
                                    @if (isWizard)
                                    {
                                        <select asp-for="Input.FacultyId" class="form-control custom-select border-warning" asp-items="ViewBag.FacultyId" id="facultySelector" disabled>
                                            <option value="">-- Seleccione Facultad --</option>
                                        </select>
                                        <input type="hidden" asp-for="Input.FacultyId" />
                                    }
                                    else
                                    {
                                        <select asp-for="Input.FacultyId" class="form-control custom-select border-warning" asp-items="ViewBag.FacultyId" id="facultySelector" required>
                                            <option value="">-- Seleccione Facultad --</option>
                                        </select>
                                    }
                                    <span asp-validation-for="Input.FacultyId" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="Input.LaboratoryId" class="control-label font-weight-bold small text-uppercase text-muted">Ambiente / Lab <span class="text-danger">*</span></label>
                                    @if (isWizard)
                                    {
                                        <select asp-for="Input.LaboratoryId" class="form-control custom-select border-warning" asp-items="ViewBag.LaboratoryId" id="labSelector" disabled>
                                            <option value="">-- Seleccione Laboratorio --</option>
                                        </select>
                                        <input type="hidden" asp-for="Input.LaboratoryId" />
                                    }
                                    else
                                    {
                                        <select asp-for="Input.LaboratoryId" class="form-control custom-select border-warning" asp-items="ViewBag.LaboratoryId" id="labSelector" required>
                                            <option value="">-- Seleccione Laboratorio --</option>
                                        </select>
                                    }
                                    <span asp-validation-for="Input.LaboratoryId" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="Input.EquipmentUnitId" class="control-label font-weight-bold small text-uppercase text-muted">Equipo Específico <span class="text-danger">*</span></label>
                                    @if (isWizard)
                                    {
                                        <select asp-for="Input.EquipmentUnitId" class="form-control custom-select border-warning" asp-items="ViewBag.EquipmentUnitId" id="unitSelector" disabled>
                                            <option value="">-- Seleccione Equipo --</option>
                                        </select>
                                        <input type="hidden" asp-for="Input.EquipmentUnitId" />
                                    }
                                    else
                                    {
                                        <select asp-for="Input.EquipmentUnitId" class="form-control custom-select border-warning" asp-items="ViewBag.EquipmentUnitId" id="unitSelector" required>
                                            <option value="">-- Seleccione Equipo --</option>
                                        </select>
                                    }
                                    <span asp-validation-for="Input.EquipmentUnitId" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (isWizard && ViewData["LinkedMaintenanceId"] != null)
                    {
                        <div class="bg-light p-3 rounded mb-4 border-left border-info" style="border-left-width: 4px !important;">
                            <label class="control-label font-weight-bold small text-uppercase text-muted">Mantenimiento Relacionado (L-8)</label>
                            <div class="p-2 rounded mt-2" style="background:#f5f3ff; border: 1px solid #ddd6fe;">
                                <div class="d-flex align-items-center">
                                    <div class="mr-3" style="color: #7c3aed;"><i class="fas fa-wrench fa-lg"></i></div>
                                    <div>
                                        <h6 class="m-0 font-weight-bold" style="color: #5b21b6;">Mantenimiento L-8 Vinculado</h6>
                                        <span class="small" style="color: #7c3aed;">ID: @ViewData["LinkedMaintenanceId"]</span>
                                    </div>
                                    <a href="/Maintenances/Details/@ViewData["LinkedMaintenanceId"]" target="_blank" class="btn btn-sm btn-light rounded-pill font-weight-bold shadow-sm ml-auto" style="color: #7c3aed; border: 1px solid #ddd6fe;">
                                        Ver Detalles <i class="fas fa-external-link-alt ml-1"></i>
                                    </a>
                                    @{
                                        int prevPhaseEnumInt = 3; // Maintenance = 3
                                        int currentPhaseInt = 4;  // Departure Create = 4
                                        int diff = currentPhaseInt - prevPhaseEnumInt;
                                    }
                                    @if (diff == 1)
                                    {
                                        <a href="/Maintenances/Edit?id=@ViewData["LinkedMaintenanceId"]" class="btn btn-sm btn-outline-warning btn-rounded font-weight-bold shadow-sm ml-2">
                                            <i class="fas fa-edit"></i> Editar L-8
                                        </a>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger btn-rounded font-weight-bold shadow-sm ml-2" onclick="confirmRedoPhase(@Model.ManagementPlanId, @prevPhaseEnumInt, 'L-8 Mantenimiento', @currentPhaseInt)">
                                            <i class="fas fa-undo"></i> Rehacer L-8
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    <div class="row">
                        <div class="col-lg-7">
                            <h5 class="text-info font-weight-bold mb-3 uppercase small"><i class="far fa-user mr-2"></i>Identificación General</h5>
                            <div class="card border mb-4 shadow-sm">
                                <div class="card-body">
                                    <div class="form-group mb-4">
                                        <label asp-for="Input.BorrowerId" class="control-label font-weight-bold small text-uppercase text-muted" id="label-borrower">Responsable / Solicitante <span class="text-danger">*</span></label>
                                        <select asp-for="Input.BorrowerId" class="form-control custom-select bg-white border-info" asp-items="ViewBag.BorrowerId" required>
                                            <option value="">-- Seleccione del Catálogo --</option>
                                        </select>
                                        <span asp-validation-for="Input.BorrowerId" class="text-danger small"></span>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6 border-right">
                                            <div class="form-group mb-0">
                                                <label asp-for="Input.DepartureDate" class="control-label font-weight-bold small text-uppercase text-muted">Fecha Efectiva de Salida <span class="text-danger">*</span></label>
                                                <input asp-for="Input.DepartureDate" class="form-control" type="date" required />
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group mb-0">
                                                <label asp-for="Input.EstimatedReturnDate" class="control-label font-weight-bold small text-uppercase text-muted">Retorno Estimado <span class="text-danger">*</span></label>
                                                <input asp-for="Input.EstimatedReturnDate" class="form-control" type="date" required />
                                                <span asp-validation-for="Input.EstimatedReturnDate" class="text-danger small"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-5">
                            <h5 class="text-primary font-weight-bold mb-3 uppercase small"><i class="fas fa-comment-dots mr-2"></i>Notas de Salida</h5>
                            <div class="card bg-light border-0 mb-4 shadow-sm">
                                <div class="card-body p-4">
                                    <div class="form-group mb-0">
                                        <label asp-for="Input.DepartureObservations" class="control-label font-weight-bold small text-uppercase text-muted italic">Estado físico del activo al salir</label>
                                        <textarea asp-for="Input.DepartureObservations" class="form-control bg-white shadow-none" rows="4" placeholder="Ej: Equipo sale en buen estado, incluye cables y manuales..."></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="mt-4" />

                    <div class="row mt-3">
                        <div class="col-12">
                            <h5 class="text-dark font-weight-bold mb-3 text-uppercase small"><i class="fas fa-boxes mr-2 text-warning"></i>Ítems de la Salida</h5>
                            <div class="card border shadow-sm">
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-borderless v-middle mb-0" id="itemsTable">
                                            <thead class="bg-light">
                                                <tr>
                                                    <th style="width:40%">Producto <span class="text-danger">*</span></th>
                                                    <th style="width:12%">Cantidad</th>
                                                    <th style="width:12%">Unidad</th>
                                                    <th style="width:30%">Observaciones</th>
                                                    @if (!isWizard)
                                                    {
                                                        <th style="width:6%"></th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody id="itemsBody">
                                                @if (Model.Input.Items != null)
                                                {
                                                    for (int i = 0; i < Model.Input.Items.Count; i++)
                                                    {
                                                        var item = Model.Input.Items[i];
                                                        <tr class="item-row">
                                                            <td>
                                                                <input type="hidden" name="Input.Items[@i].Id" value="@item.Id" />
                                                                <input type="hidden" name="Input.Items[@i].EquipmentUnitId" value="@item.EquipmentUnitId" />
                                                                @if (isWizard)
                                                                {
                                                                    <select class="form-control form-control-sm custom-select bg-light" disabled>
                                                                        <option selected>@item.ProductName</option>
                                                                    </select>
                                                                    <input type="hidden" name="Input.Items[@i].ProductName" value="@item.ProductName" />
                                                                }
                                                                else
                                                                {
                                                                    <input type="text" name="Input.Items[@i].ProductName" value="@item.ProductName"
                                                                           class="form-control form-control-sm" placeholder="Nombre del producto o equipo" required />
                                                                }
                                                            </td>
                                                            <td>
                                                                <input type="number" name="Input.Items[@i].Quantity" value="@item.Quantity"
                                                                       class="form-control form-control-sm" min="1" required />
                                                            </td>
                                                            <td>
                                                                <input type="text" name="Input.Items[@i].UnitOfMeasure" value="@item.UnitOfMeasure"
                                                                       class="form-control form-control-sm" placeholder="UNIDAD" />
                                                            </td>
                                                            <td>
                                                                <input type="text" name="Input.Items[@i].Observations" value="@item.Observations"
                                                                       class="form-control form-control-sm" placeholder="Opcional" />
                                                            </td>
                                                            @if (!isWizard)
                                                            {
                                                                <td class="text-center">
                                                                    <button type="button" class="btn btn-sm btn-outline-danger btn-rounded remove-item-row" title="Quitar">
                                                                        <i class="fas fa-trash-alt"></i>
                                                                    </button>
                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    @if (!isWizard)
                                    {
                                        <div class="p-3 border-top">
                                            <button type="button" class="btn btn-sm btn-outline-info btn-rounded font-weight-bold" id="addItemBtn">
                                                <i class="fas fa-plus mr-1"></i> Agregar Ítem
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="mt-4" />

                    <div class="form-actions text-right pb-4 mt-4">
                        @if (isWizard)
                        {
                            <a asp-page="/Index" asp-route-ShowWizard="true" asp-route-Step="4" asp-route-ManagementId="@ViewData["ManagementId"]" class="btn btn-outline-secondary btn-rounded px-4 mr-2 font-weight-bold">
                                <i class="fas fa-undo mr-1"></i> Volver al Wizard
                            </a>
                        }
                        else
                        {
                            <a asp-page="./Index" class="btn btn-outline-secondary btn-rounded px-4 mr-2 font-weight-bold">
                                 <i class="fas fa-times mr-1"></i> Cancelar
                            </a>
                        }
                        @if (!techMissing)
                        {
                            <button type="submit" asp-page-handler="Draft" id="btnDraftDeparture" formnovalidate
                                    class="btn btn-outline-info btn-rounded px-4 shadow-sm font-weight-bold mr-2 py-2">
                                <i class="fas fa-save mr-1"></i> Guardar Borrador
                            </button>
                            <button type="button" class="btn btn-warning btn-rounded px-5 shadow-sm font-weight-bold text-dark py-2" onclick="confirmDepartureDirect()">
                                <i class="fas fa-save mr-1"></i> Registrar Salida L-3
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-secondary btn-rounded px-5 shadow-sm font-weight-bold py-2" disabled title="Asigne un técnico en L-8 primero">
                                <i class="fas fa-lock mr-1"></i> Asigne Técnico en L-8 Primero
                            </button>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section Styles {
    <style>
        .btn-group-toggle .btn { border: 1px solid #e9ecef !important; color: #6c757d; background: #f8f9fa; }
        .btn-group-toggle .btn.active { background: #2962ff !important; color: white !important; border-color: #2962ff !important; box-shadow: 0 4px 10px rgba(41, 98, 255, 0.2) !important; }
        #label-maintenance-btn.active { background: #4fc3f7 !important; border-color: #4fc3f7 !important; }
    </style>
}

@section Scripts {
    <script src="~/assets/extra-libs/jqbootstrapvalidation/validation.js"></script>
    <script>
        $(function () {
            "use strict";
            $("input,select,textarea").not("[type=submit]").jqBootstrapValidation();

            // LÓGICA DE TABS (TIPO DE SALIDA)
            $('input[name="tempType"]').change(function() {
                const type = $(this).data('type');
                $('#hiddenType').val(type);
                
                if(type == 3) { // Mantenimiento
                    $('#type-info-text').text("La salida por mantenimiento externo registra la custodia temporal por parte de un proveedor autorizado.");
                    $('#label-borrower').text("Proveedor / Técnico Externo");
                } else { // Préstamo
                    $('#type-info-text').text("Este registro crea una orden de salida temporal para el control de activos institucionales.");
                    $('#label-borrower').text("Responsable / Solicitante");
                }
            });

            // Sincronizar estado inicial de tabs si el modelo trae un valor (Wizard)
            const initialType = $('#hiddenType').val();
            if(initialType == 3) {
                $('#type-maint').prop('checked', true);
                $('#label-loan-btn').removeClass('active');
                $('#label-maintenance-btn').addClass('active');
                $('#type-maint').trigger('change');
            } else {
                $('#hiddenType').val(2); // Préstamo por defecto
            }

            // Selectores cascada
            $('#facultySelector').change(function () {
                var facultyId = $(this).val();
                $('#labSelector').empty().append('<option value="">-- Seleccione Laboratorio --</option>');
                $('#unitSelector').empty().append('<option value="">-- Seleccione Equipo --</option>');
                if (!facultyId) return;

                $.get('?handler=LaboratoriesByFaculty&facultyId=' + facultyId, function (data) {
                    $.each(data, function (i, item) {
                        $('#labSelector').append('<option value="' + item.id + '">' + item.name + '</option>');
                    });
                });
            });

            $('#labSelector').change(function () {
                var labId = $(this).val();
                $('#unitSelector').empty().append('<option value="">-- Seleccione Equipo --</option>');
                if (!labId) return;

                $.get('?handler=UnitsByLab&laboratoryId=' + labId, function (data) {
                    $.each(data, function (i, item) {
                        $('#unitSelector').append('<option value="' + item.id + '">' + item.name + '</option>');
                    });
                });
            });

        });

        let isConfirmedSubmit = false;
        $('#departureForm').on('submit', function(e) {
            if (isConfirmedSubmit) return true;

            var submitter = e.originalEvent && e.originalEvent.submitter ? e.originalEvent.submitter : document.activeElement;
            var isDraft = submitter && submitter.id === 'btnDraftDeparture';

            if (isDraft) {
                e.preventDefault();

                const form = this;
                const submitForm = function() {
                    isConfirmedSubmit = true;
                    $('#btnDraftDeparture').prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Guardando...');
                    HTMLFormElement.prototype.submit.call(form);
                };

                if (typeof Swal === 'undefined') {
                    submitForm();
                    return;
                }

                Swal.fire({
                    title: '¿Guardar borrador L-3?',
                    text: 'Se guardará el avance parcial sin pasar al Kardex. Podrás continuar la salida más tarde.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#17a2b8',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Sí, guardar borrador',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result && (result.isConfirmed === true || result.value === true)) {
                        submitForm();
                    }
                });
            }
        });

        function confirmDepartureDirect() {
            Swal.fire({
                title: '¿Confirmar Salida?',
                text: 'Se registrará la salida temporal de este equipo y avanzará al Kardex.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Sí, registrar salida',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#f59e0b',
                cancelButtonColor: '#6c757d'
            }).then((result) => {
                if (result && (result.isConfirmed === true || result.value === true)) {
                    document.getElementById('departureForm').submit();
                }
            });
        }

        @if (!isWizard)
        {
        <text>
        var itemRowCount = @(Model.Input.Items?.Count ?? 0);
        var itemRowTemplate = '<tr class="item-row">' +
            '<td><input type="hidden" name="Input.Items[{0}].Id" value="0" />' +
            '<input type="hidden" name="Input.Items[{0}].EquipmentUnitId" value="" />' +
            '<input type="text" name="Input.Items[{0}].ProductName" class="form-control form-control-sm" placeholder="Nombre del producto o equipo" required /></td>' +
            '<td><input type="number" name="Input.Items[{0}].Quantity" value="1" class="form-control form-control-sm" min="1" required /></td>' +
            '<td><input type="text" name="Input.Items[{0}].UnitOfMeasure" value="UNIDAD" class="form-control form-control-sm" /></td>' +
            '<td><input type="text" name="Input.Items[{0}].Observations" class="form-control form-control-sm" placeholder="Opcional" /></td>' +
            '<td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger btn-rounded remove-item-row" title="Quitar"><i class="fas fa-trash-alt"></i></button></td>' +
            '</tr>';

        $('#addItemBtn').click(function () {
            var row = itemRowTemplate.replace(/\{0\}/g, itemRowCount);
            $('#itemsBody').append(row);
            itemRowCount++;
        });

        $('#itemsBody').on('click', '.remove-item-row', function () {
            $(this).closest('tr.item-row').remove();
        });
        </text>
        }
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
