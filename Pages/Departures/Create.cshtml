@page
@model Proyecto_Laboratorios_Univalle.Pages.Departures.CreateModel
@using Proyecto_Laboratorios_Univalle.Models.Enums

@{
    ViewData["Title"] = "Registrar Salida de Equipo (L-3)";
    bool isWizard = (bool)(ViewData["IsWizard"] ?? false);
}

<div class="row justify-content-center">
    <div class="col-lg-10 col-xl-9">

        @if (isWizard)
        {
            <div class="wizard-steps mb-4 d-flex justify-content-between position-relative mt-3">
                <div class="step-line"></div>
                <div class="step-item"><span class="step-number" style="background:#28a745; color:white; border-color:#28a745;"><i class="fas fa-check"></i></span><span class="step-label" style="color:#28a745;">L6 Verificación</span></div>
                <div class="step-item"><span class="step-number" style="background:#28a745; color:white; border-color:#28a745;"><i class="fas fa-check"></i></span><span class="step-label" style="color:#28a745;">L7 Solicitud</span></div>
                <div class="step-item"><span class="step-number" style="background:#28a745; color:white; border-color:#28a745;"><i class="fas fa-check"></i></span><span class="step-label" style="color:#28a745;">L8 Mantenimiento</span></div>
                <div class="step-item active"><span class="step-number">4</span><span class="step-label">L3 Salida</span></div>
                <div class="step-item"><span class="step-number">5</span><span class="step-label">Kardex</span></div>
                <div class="step-item"><span class="step-number">6</span><span class="step-label">Desembolso</span></div>
            </div>
        }

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="d-flex no-block align-items-center mb-4">
                    <div>
                        <h4 class="card-title text-dark">Registrar Salida de Equipo (L-3)</h4>
                        <h6 class="card-subtitle text-muted">Registro de salida de equipo por préstamo o mantenimiento externo.</h6>
                    </div>
                    <div class="ml-auto">
                        <i class="fas fa-sign-out-alt fa-2x text-warning opacity-5"></i>
                    </div>
                </div>

                <form method="post" id="createDepartureForm">
                    <input type="hidden" name="isWizard" value="@(isWizard.ToString().ToLower())" />
                    <input type="hidden" asp-for="ManagementPlanId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm border-0 small"></div>

                    <div class="row">
                        <div class="col-md-6 border-right">
                            <h5 class="font-weight-bold text-warning mb-3">
                                <i class="fas fa-box mr-2"></i> Equipo y Responsable
                            </h5>

                            <div class="form-group mb-4">
                                <label asp-for="Input.EquipmentUnitId" class="control-label font-weight-bold small text-warning text-uppercase">
                                    Unidad Física <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Input.EquipmentUnitId" class="form-control select2" asp-items="ViewBag.EquipmentUnitId">
                                    <option value="">-- Seleccionar Equipo --</option>
                                </select>
                                <span asp-validation-for="Input.EquipmentUnitId" class="text-danger small"></span>
                            </div>

                            <div class="form-group mb-4">
                                <label asp-for="Input.BorrowerId" class="control-label font-weight-bold small text-uppercase text-muted">
                                    Responsable / Solicitante <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Input.BorrowerId" class="form-control select2" asp-items="ViewBag.BorrowerId">
                                    <option value="">-- Seleccionar Persona --</option>
                                </select>
                                <span asp-validation-for="Input.BorrowerId" class="text-danger small"></span>
                            </div>

                            <div class="form-group mb-4">
                                <label asp-for="Input.Type" class="control-label font-weight-bold small text-uppercase text-muted">
                                    Tipo de Salida <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Input.Type" class="form-control custom-select" asp-items="Html.GetEnumSelectList<DepartureType>()"></select>
                            </div>
                        </div>

                        <div class="col-md-6 pl-lg-4">
                            <h5 class="font-weight-bold text-muted mb-3">
                                <i class="fas fa-calendar-alt mr-2"></i> Fechas y Observaciones
                            </h5>

                            <div class="form-group mb-4">
                                <label asp-for="Input.DepartureDate" class="control-label font-weight-bold small text-uppercase text-muted">
                                    Fecha de Salida <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.DepartureDate" class="form-control" type="date" />
                                <span asp-validation-for="Input.DepartureDate" class="text-danger small"></span>
                            </div>

                            <div class="form-group mb-4">
                                <label asp-for="Input.EstimatedReturnDate" class="control-label font-weight-bold small text-uppercase text-muted">
                                    Fecha Estimada de Devolución <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.EstimatedReturnDate" class="form-control" type="date" />
                                <span asp-validation-for="Input.EstimatedReturnDate" class="text-danger small"></span>
                            </div>

                            <div class="form-group mb-4">
                                <label asp-for="Input.DepartureObservations" class="control-label font-weight-bold small text-uppercase text-muted">Observaciones</label>
                                <textarea asp-for="Input.DepartureObservations" class="form-control" rows="3" placeholder="Notas sobre el estado del equipo al salir..."></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="form-actions text-right mt-4">
                        @if (isWizard)
                        {
                            <a asp-page="/Wizard/Index" asp-route-Step="4" class="btn btn-outline-secondary btn-rounded mr-2 px-4">Volver al Wizard</a>
                        }
                        else
                        {
                            <a asp-page="./Index" class="btn btn-outline-secondary btn-rounded mr-2 px-4">Cancelar</a>
                        }
                        <button type="submit" class="btn btn-warning btn-rounded px-5 shadow-sm font-weight-bold">
                            Registrar Salida <i class="fas fa-arrow-right ml-2"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/libs/select2/dist/js/select2.full.min.js"></script>
    <script>
        $(function() {
            $(".select2").select2({ width: '100%' });
        });
    </script>
}
