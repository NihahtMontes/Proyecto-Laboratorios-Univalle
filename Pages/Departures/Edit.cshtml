@page
@model Proyecto_Laboratorios_Univalle.Pages.Departures.EditModel
@using Proyecto_Laboratorios_Univalle.Models.Enums

@{
    ViewData["Title"] = "Editar Salida de Equipo (L-3)";
    bool isWizard = (bool)(ViewData["IsWizard"] ?? false);
    int currentPhaseInt = (int)(ViewData["CurrentPhaseInt"] ?? 4);
    int? prevPhaseId = (int?)ViewData["LinkedMaintenanceId"];
    int? planId = (int?)ViewData["ManagementPlanId"];
}

<div class="row justify-content-center">
    <div class="col-lg-12">
        @if (isWizard)
        {
            await Html.RenderPartialAsync("_WizardSteps", currentPhaseInt);
        }
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">

                <div class="d-flex no-block align-items-center mb-4">
                    <div>
                        <h4 class="card-title text-dark font-weight-bold">Actualizar Salida #@Model.Input.Id</h4>
                        <h6 class="card-subtitle text-muted">Edite los datos de la salida del equipo.</h6>
                    </div>
                    <div class="ml-auto text-right">
                        <i class="fas fa-sign-out-alt fa-2x text-warning opacity-5"></i>
                    </div>
                </div>

                <form method="post" id="departureEditForm" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm border-0 mb-4"></div>
                    <input type="hidden" asp-for="Input.Id" />
                    <input type="hidden" asp-for="Input.EquipmentUnitId" />

                    <div class="bg-light p-4 rounded mb-4 border-left border-warning" style="border-left-width: 4px !important;">
                        <h5 class="text-dark font-weight-bold mb-3"><i class="fas fa-university mr-2 text-warning"></i>Contexto de Ubicación y Salida</h5>
                        
                        <!-- FILA 1: UBICACION (Locked if Wizard) -->
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <div class="form-group mb-0">
                                    <label asp-for="Input.FacultyId" class="control-label font-weight-bold small text-info text-uppercase">Facultad</label>
                                    @if (isWizard)
                                    {
                                        <select asp-for="Input.FacultyId" class="form-control select2" asp-items="ViewBag.FacultyId" disabled></select>
                                        <input type="hidden" asp-for="Input.FacultyId" />
                                    }
                                    else
                                    {
                                        <select asp-for="Input.FacultyId" class="form-control select2" id="facultySelect" asp-items="ViewBag.FacultyId"></select>
                                    }
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-0">
                                    <label asp-for="Input.LaboratoryId" class="control-label font-weight-bold small text-info text-uppercase">Laboratorio</label>
                                    @if (isWizard)
                                    {
                                        <select asp-for="Input.LaboratoryId" class="form-control select2" asp-items="ViewBag.LaboratoryId" disabled></select>
                                        <input type="hidden" asp-for="Input.LaboratoryId" />
                                    }
                                    else
                                    {
                                        <select asp-for="Input.LaboratoryId" class="form-control select2" id="laboratorySelect" asp-items="ViewBag.LaboratoryId"></select>
                                    }
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-0">
                                    <label asp-for="Input.EquipmentUnitId" class="control-label font-weight-bold small text-warning text-uppercase">Unidad Física</label>
                                    @if (isWizard)
                                    {
                                        <select asp-for="Input.EquipmentUnitId" class="form-control select2" asp-items="ViewBag.EquipmentUnitId" disabled></select>
                                        <input type="hidden" asp-for="Input.EquipmentUnitId" />
                                    }
                                    else
                                    {
                                        <select asp-for="Input.EquipmentUnitId" class="form-control select2" id="equipmentUnitSelect" asp-items="ViewBag.EquipmentUnitId"></select>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- FILA 2: EJECUCION -->
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group mb-0">
                                    <label asp-for="Input.Type" class="control-label font-weight-bold small text-uppercase text-muted">Tipo de Salida</label>
                                    <select asp-for="Input.Type" class="form-control custom-select" asp-items="Html.GetEnumSelectList<DepartureType>()">
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-0">
                                    <label asp-for="Input.BorrowerId" class="control-label font-weight-bold small text-uppercase text-muted">Responsable / Solicitante <span class="text-danger">*</span></label>
                                    <select asp-for="Input.BorrowerId" class="form-control custom-select bg-white border-info" asp-items="ViewBag.BorrowerId" required>
                                        <option value="">-- Seleccione --</option>
                                    </select>
                                    <span asp-validation-for="Input.BorrowerId" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-0">
                                    <label asp-for="Input.Status" class="control-label font-weight-bold small text-uppercase text-muted">Estado</label>
                                    <select asp-for="Input.Status" class="form-control custom-select border-warning font-weight-bold text-dark" asp-items="Html.GetEnumSelectList<LoanStatus>()">
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- TARJETA DE REFERENCIA L-8 -->
                        @if (isWizard && prevPhaseId != null && planId != null)
                        {
                            <div class="form-group mt-4 mb-0">
                                <label class="control-label font-weight-bold small text-uppercase text-muted">Mantenimiento Relacionado (L-8)</label>
                                <div class="p-2 rounded" style="background:#f5f3ff; border: 1px solid #ddd6fe;">
                                    <div class="d-flex align-items-center">
                                        <div class="mr-3" style="color: #7c3aed;"><i class="fas fa-wrench fa-lg"></i></div>
                                        <div>
                                            <h6 class="m-0 font-weight-bold" style="color: #5b21b6;">Mantenimiento L-8 Vinculado</h6>
                                            <span class="small" style="color: #7c3aed;">ID: @prevPhaseId</span>
                                        </div>
                                        <a href="/Maintenances/Details/@prevPhaseId" target="_blank" class="btn btn-sm btn-light rounded-pill font-weight-bold shadow-sm ml-auto" style="color: #7c3aed; border: 1px solid #ddd6fe;">
                                            Ver Detalles <i class="fas fa-external-link-alt ml-1"></i>
                                        </a>
                                        @{
                                            int prevPhaseEnumInt = 3; // Maintenance = 3
                                            int diff = currentPhaseInt - prevPhaseEnumInt;
                                        }
                                        @if (diff == 1)
                                        {
                                            <a href="/Maintenances/Edit?id=@prevPhaseId" class="btn btn-sm btn-outline-warning btn-rounded font-weight-bold shadow-sm ml-2">
                                                <i class="fas fa-edit"></i> Editar L-8
                                            </a>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger btn-rounded font-weight-bold shadow-sm ml-2" onclick="confirmRedoPhase(@planId, @prevPhaseEnumInt, 'L-8 Mantenimiento', @currentPhaseInt)">
                                                <i class="fas fa-undo"></i> Rehacer L-8
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="row">
                        <div class="col-lg-7">
                            <h5 class="text-dark font-weight-bold mb-3"><i class="far fa-user mr-2 text-info"></i>Identificación y Fechas</h5>
                            <div class="card border mb-4 shadow-none">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-4 border-right">
                                            <div class="form-group">
                                                <label asp-for="Input.DepartureDate" class="control-label font-weight-bold small text-uppercase text-muted">Fecha de Salida <span class="text-danger">*</span></label>
                                                <input asp-for="Input.DepartureDate" class="form-control" type="date" required />
                                            </div>
                                        </div>
                                        <div class="col-md-4 border-right">
                                            <div class="form-group">
                                                <label asp-for="Input.EstimatedReturnDate" class="control-label font-weight-bold small text-uppercase text-muted">Retorno Estimado <span class="text-danger">*</span></label>
                                                <input asp-for="Input.EstimatedReturnDate" class="form-control border-danger" type="date" required />
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label asp-for="Input.ActualReturnDate" class="control-label font-weight-bold small text-uppercase text-muted">Retorno Real</label>
                                                <input asp-for="Input.ActualReturnDate" class="form-control border-success" type="datetime-local" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-5">
                            <h5 class="text-dark font-weight-bold mb-3"><i class="fas fa-comment-dots mr-2 text-primary"></i>Notas</h5>
                            <div class="card bg-light border-0 mb-4 shadow-sm">
                                <div class="card-body p-4">
                                    <div class="form-group mb-3">
                                        <label asp-for="Input.DepartureObservations" class="control-label font-weight-bold small text-uppercase text-muted">Observaciones de Salida</label>
                                        <textarea asp-for="Input.DepartureObservations" class="form-control bg-white shadow-none" rows="3" placeholder="Estado físico del activo al salir..."></textarea>
                                    </div>
                                    <div class="form-group mb-0">
                                        <label asp-for="Input.ReturnObservations" class="control-label font-weight-bold small text-uppercase text-muted">Observaciones de Devolución</label>
                                        <textarea asp-for="Input.ReturnObservations" class="form-control bg-white shadow-none" rows="3" placeholder="Estado del activo al ser devuelto..."></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <div class="row mt-3">
                        <div class="col-12">
                            <h5 class="text-dark font-weight-bold mb-3 text-uppercase small"><i class="fas fa-boxes mr-2 text-warning"></i>Ítems de la Salida</h5>
                            <div class="card border shadow-sm">
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-borderless v-middle mb-0" id="itemsTable">
                                            <thead class="bg-light">
                                                <tr>
                                                    <th style="width:40%">Producto <span class="text-danger">*</span></th>
                                                    <th style="width:12%">Cantidad</th>
                                                    <th style="width:12%">Unidad</th>
                                                    <th style="width:30%">Observaciones</th>
                                                    <th style="width:6%"></th>
                                                </tr>
                                            </thead>
                                            <tbody id="itemsBody">
                                                @if (Model.Input.Items != null)
                                                {
                                                    for (int i = 0; i < Model.Input.Items.Count; i++)
                                                    {
                                                        var item = Model.Input.Items[i];
                                                        <tr class="item-row">
                                                            <td>
                                                                <input type="hidden" name="Input.Items[@i].Id" value="@item.Id" />
                                                                <input type="hidden" name="Input.Items[@i].EquipmentUnitId" value="@item.EquipmentUnitId" />
                                                                <input type="text" name="Input.Items[@i].ProductName" value="@item.ProductName"
                                                                       class="form-control form-control-sm" placeholder="Nombre del producto o equipo" required />
                                                            </td>
                                                            <td>
                                                                <input type="number" name="Input.Items[@i].Quantity" value="@item.Quantity"
                                                                       class="form-control form-control-sm" min="1" required />
                                                            </td>
                                                            <td>
                                                                <input type="text" name="Input.Items[@i].UnitOfMeasure" value="@item.UnitOfMeasure"
                                                                       class="form-control form-control-sm" placeholder="UNIDAD" />
                                                            </td>
                                                            <td>
                                                                <input type="text" name="Input.Items[@i].Observations" value="@item.Observations"
                                                                       class="form-control form-control-sm" placeholder="Opcional" />
                                                            </td>
                                                            <td class="text-center">
                                                                <button type="button" class="btn btn-sm btn-outline-danger btn-rounded remove-item-row" title="Quitar">
                                                                    <i class="fas fa-trash-alt"></i>
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="p-3 border-top">
                                        <button type="button" class="btn btn-sm btn-outline-info btn-rounded font-weight-bold" id="addItemBtn">
                                            <i class="fas fa-plus mr-1"></i> Agregar Ítem
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <div class="form-actions text-right pb-4">
                        <a asp-page="./Index" class="btn btn-outline-secondary btn-rounded px-4 mr-2">Cancelar</a>
                        <button type="submit" class="btn btn-warning btn-rounded px-5 shadow font-weight-bold text-dark">
                            <i class="fas fa-sync-alt mr-1"></i> Actualizar Salida
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/extra-libs/jqbootstrapvalidation/validation.js"></script>
    <script>
        $(function () {
            "use strict";
            $("input,select,textarea").not("[type=submit]").jqBootstrapValidation();
        });

        var itemRowCount = @(Model.Input.Items?.Count ?? 0);
        var itemRowTemplate = '<tr class="item-row">' +
            '<td><input type="hidden" name="Input.Items[{0}].Id" value="0" />' +
            '<input type="hidden" name="Input.Items[{0}].EquipmentUnitId" value="" />' +
            '<input type="text" name="Input.Items[{0}].ProductName" class="form-control form-control-sm" placeholder="Nombre del producto o equipo" required /></td>' +
            '<td><input type="number" name="Input.Items[{0}].Quantity" value="1" class="form-control form-control-sm" min="1" required /></td>' +
            '<td><input type="text" name="Input.Items[{0}].UnitOfMeasure" value="UNIDAD" class="form-control form-control-sm" /></td>' +
            '<td><input type="text" name="Input.Items[{0}].Observations" class="form-control form-control-sm" placeholder="Opcional" /></td>' +
            '<td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger btn-rounded remove-item-row" title="Quitar"><i class="fas fa-trash-alt"></i></button></td>' +
            '</tr>';

        $('#addItemBtn').click(function () {
            var row = itemRowTemplate.replace(/\{0\}/g, itemRowCount);
            $('#itemsBody').append(row);
            itemRowCount++;
        });

        $('#itemsBody').on('click', '.remove-item-row', function () {
            $(this).closest('tr.item-row').remove();
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
