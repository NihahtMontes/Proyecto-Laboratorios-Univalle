@page
@model Proyecto_Laboratorios_Univalle.Pages.Departures.EditModel
@using Proyecto_Laboratorios_Univalle.Models.Enums

@{
    ViewData["Title"] = "Editar Salida de Equipo (L-3)";
}

<div class="row justify-content-center">
    <div class="col-lg-12">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">

                <div class="d-flex no-block align-items-center mb-4">
                    <div>
                        <h4 class="card-title text-dark font-weight-bold">Actualizar Salida #@Model.Input.Id</h4>
                        <h6 class="card-subtitle text-muted">Edite los datos de la salida del equipo.</h6>
                    </div>
                    <div class="ml-auto text-right">
                        <i class="fas fa-sign-out-alt fa-2x text-warning opacity-5"></i>
                    </div>
                </div>

                <form method="post" id="departureEditForm" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm border-0 mb-4"></div>
                    <input type="hidden" asp-for="Input.Id" />
                    <input type="hidden" asp-for="Input.EquipmentUnitId" />

                    <div class="bg-light p-4 rounded mb-4 border-left border-warning" style="border-left-width: 4px !important;">
                        <h5 class="text-dark font-weight-bold mb-3"><i class="fas fa-microchip mr-2 text-warning"></i>Equipo Asignado</h5>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-0">
                                    <label class="control-label font-weight-bold small text-uppercase text-muted">Unidad Física</label>
                                    <select asp-for="Input.EquipmentUnitId" class="form-control custom-select" asp-items="ViewBag.EquipmentUnitId" disabled>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group mb-0">
                                    <label asp-for="Input.Type" class="control-label font-weight-bold small text-uppercase text-muted">Tipo de Salida</label>
                                    <select asp-for="Input.Type" class="form-control custom-select" asp-items="Html.GetEnumSelectList<DepartureType>()">
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group mb-0">
                                    <label asp-for="Input.Status" class="control-label font-weight-bold small text-uppercase text-muted">Estado</label>
                                    <select asp-for="Input.Status" class="form-control custom-select border-warning font-weight-bold text-dark" asp-items="Html.GetEnumSelectList<LoanStatus>()">
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-lg-7">
                            <h5 class="text-dark font-weight-bold mb-3"><i class="far fa-user mr-2 text-info"></i>Identificación y Fechas</h5>
                            <div class="card border mb-4 shadow-none">
                                <div class="card-body">
                                    <div class="form-group mb-4">
                                        <label asp-for="Input.BorrowerId" class="control-label font-weight-bold small text-uppercase text-muted">Responsable / Solicitante <span class="text-danger">*</span></label>
                                        <select asp-for="Input.BorrowerId" class="form-control custom-select bg-white border-info" asp-items="ViewBag.BorrowerId" required>
                                            <option value="">-- Seleccione del Catálogo --</option>
                                        </select>
                                        <span asp-validation-for="Input.BorrowerId" class="text-danger small"></span>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-4 border-right">
                                            <div class="form-group">
                                                <label asp-for="Input.DepartureDate" class="control-label font-weight-bold small text-uppercase text-muted">Fecha de Salida <span class="text-danger">*</span></label>
                                                <input asp-for="Input.DepartureDate" class="form-control" type="date" required />
                                            </div>
                                        </div>
                                        <div class="col-md-4 border-right">
                                            <div class="form-group">
                                                <label asp-for="Input.EstimatedReturnDate" class="control-label font-weight-bold small text-uppercase text-muted">Retorno Estimado <span class="text-danger">*</span></label>
                                                <input asp-for="Input.EstimatedReturnDate" class="form-control border-danger" type="date" required />
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label asp-for="Input.ActualReturnDate" class="control-label font-weight-bold small text-uppercase text-muted">Retorno Real</label>
                                                <input asp-for="Input.ActualReturnDate" class="form-control border-success" type="datetime-local" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-5">
                            <h5 class="text-dark font-weight-bold mb-3"><i class="fas fa-comment-dots mr-2 text-primary"></i>Notas</h5>
                            <div class="card bg-light border-0 mb-4 shadow-sm">
                                <div class="card-body p-4">
                                    <div class="form-group mb-3">
                                        <label asp-for="Input.DepartureObservations" class="control-label font-weight-bold small text-uppercase text-muted">Observaciones de Salida</label>
                                        <textarea asp-for="Input.DepartureObservations" class="form-control bg-white shadow-none" rows="3" placeholder="Estado físico del activo al salir..."></textarea>
                                    </div>
                                    <div class="form-group mb-0">
                                        <label asp-for="Input.ReturnObservations" class="control-label font-weight-bold small text-uppercase text-muted">Observaciones de Devolución</label>
                                        <textarea asp-for="Input.ReturnObservations" class="form-control bg-white shadow-none" rows="3" placeholder="Estado del activo al ser devuelto..."></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <div class="form-actions text-right pb-4">
                        <a asp-page="./Index" class="btn btn-outline-secondary btn-rounded px-4 mr-2">Cancelar</a>
                        <button type="submit" class="btn btn-warning btn-rounded px-5 shadow font-weight-bold text-dark">
                            <i class="fas fa-sync-alt mr-1"></i> Actualizar Salida
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/extra-libs/jqbootstrapvalidation/validation.js"></script>
    <script>
        $(function () {
            "use strict";
            $("input,select,textarea").not("[type=submit]").jqBootstrapValidation();
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
