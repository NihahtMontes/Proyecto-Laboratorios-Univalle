@page
@model Proyecto_Laboratorios_Univalle.Pages.Departures.MassCreateModel
@using Proyecto_Laboratorios_Univalle.Models.Enums

@{
    ViewData["Title"] = "Salida Masiva por Laboratorio (L-3)";
    bool isWizard = (bool)(ViewData["IsWizard"] ?? false);
}

<div class="row justify-content-center">
    <div class="col-lg-12">

        @if (isWizard)
        {
            await Html.RenderPartialAsync("_WizardSteps", 4);
        }

        <div class="card shadow-sm border-0 mt-3">
            <div class="card-body p-4">
                <div class="d-flex no-block align-items-center mb-4 pb-3 border-bottom">
                    <div>
                        <h4 class="card-title text-dark font-weight-bold">Salida Masiva por Laboratorio (L-3)</h4>
                        <h6 class="card-subtitle text-muted">Registra la salida de todos los equipos pendientes del laboratorio seleccionado.</h6>
                    </div>
                    <div class="ml-auto">
                        <i class="fas fa-sign-out-alt fa-2x text-warning opacity-5"></i>
                    </div>
                </div>

                <!-- SELECTOR DE LABORATORIO -->
                <div class="bg-light p-4 rounded mb-4 border-left border-warning shadow-sm" style="border-left-width: 4px;">
                    <div class="row align-items-end">
                        <div class="col-md-5">
                            <label class="font-weight-bold small text-uppercase text-muted">Laboratorio / Ambiente</label>
                            <select id="labSelector" class="form-control custom-select" asp-items="Model.LabList">
                                <option value="">-- Seleccione un laboratorio --</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <button type="button" id="btnLoad" class="btn btn-warning btn-rounded shadow-sm font-weight-bold px-4" onclick="loadEquipment()">
                                <i class="fas fa-sync-alt mr-1"></i> Cargar Equipos
                            </button>
                        </div>
                        <div class="col-md-4 text-right">
                            <span id="equipCount" class="badge badge-light px-3 py-2 shadow-sm" style="display:none;"></span>
                        </div>
                    </div>
                </div>

                <form method="post" id="massForm" novalidate>
                    <input type="hidden" name="IsWizard" value="@isWizard.ToString().ToLower()" />
                    <input type="hidden" name="LabId" id="hiddenLabId" value="@Model.LabId" />
                    <input type="hidden" name="ManagementId" value="@Model.ManagementId" />

                    <!-- FECHAS GLOBALES -->
                    <div id="datesSection" style="display:none;">
                        <div class="card border-left border-warning shadow-sm mb-4" style="border-left-width:4px;">
                            <div class="card-body">
                                <h5 class="font-weight-bold small text-uppercase text-muted mb-3">
                                    <i class="fas fa-calendar-alt mr-2 text-warning"></i>Fechas de la Salida
                                    <span class="badge badge-warning ml-2">Aplica a todos los equipos</span>
                                </h5>
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="form-group mb-0">
                                            <label class="control-label font-weight-bold small text-uppercase text-muted">
                                                Fecha Efectiva de Salida <span class="text-danger">*</span>
                                            </label>
                                            <input asp-for="DepartureDate" type="date" class="form-control" required id="globalDepartureDate" />
                                            <span asp-validation-for="DepartureDate" class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group mb-0">
                                            <label class="control-label font-weight-bold small text-uppercase text-muted">
                                                Retorno Estimado <span class="text-danger">*</span>
                                            </label>
                                            <input asp-for="EstimatedReturnDate" type="date" class="form-control" required id="globalReturnDate" />
                                            <span asp-validation-for="EstimatedReturnDate" class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-4 d-flex align-items-end">
                                        <div class="alert alert-light py-2 px-3 mb-0 small border-left border-info w-100">
                                            <i class="fas fa-info-circle mr-1 text-info"></i>
                                            Las mismas fechas aplican para toda la sesión de salidas.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TABLA DE EQUIPOS -->
                    <div id="equipmentTable" style="display:none;">
                        <div class="table-responsive">
                            <table class="table table-hover v-middle">
                                <thead class="bg-light">
                                    <tr class="small uppercase font-weight-bold">
                                        <th class="border-top-0" style="width:5%;">
                                            <input type="checkbox" id="checkAll" title="Seleccionar todos" />
                                        </th>
                                        <th class="border-top-0" style="width:25%;">Equipo</th>
                                        <th class="border-top-0" style="width:18%;">Inv. / Marca</th>
                                        <th class="border-top-0" style="width:15%;">Técnico (L-8)</th>
                                        <th class="border-top-0" style="width:28%;">Producto / Ítem de Salida</th>
                                    </tr>
                                </thead>
                                <tbody id="tableBody"></tbody>
                            </table>
                        </div>

                        <hr class="mt-4" />
                        <div class="form-actions text-right pb-4 mt-4">
                            @if (isWizard)
                            {
                                <a asp-page="/Index" asp-route-ShowWizard="true" asp-route-Step="4"
                                   asp-route-ManagementId="@Model.ManagementId"
                                   class="btn btn-outline-secondary btn-rounded px-4 mr-2 font-weight-bold">
                                    <i class="fas fa-arrow-left mr-1"></i> Volver al Wizard
                                </a>
                            }
                            else
                            {
                                <a asp-page="./Index" class="btn btn-outline-secondary btn-rounded px-4 mr-2 font-weight-bold">
                                    <i class="fas fa-times mr-1"></i> Cancelar
                                </a>
                            }
                            <button type="button" id="btnSubmit" class="btn btn-warning btn-rounded px-5 shadow-sm font-weight-bold text-dark" onclick="confirmMassSubmitDirect()">
                                <i class="fas fa-save mr-1"></i> Registrar Salidas
                            </button>
                        </div>
                    </div>
                </form>

                <div id="diagnosticBanner" class="alert border-left border-danger shadow-sm mb-4 small" style="border-left-width: 4px !important; display:none;">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-exclamation-triangle text-danger mr-3 fa-lg"></i>
                            <div>
                                <strong class="text-danger">Equipos sin técnico responsable</strong><br>
                                <span id="diagnosticText"></span><br>
                                <small class="text-muted">Para habilitar estos equipos, vaya a <strong>Mantenimiento L-8</strong> y asigne un técnico responsable antes de registrar la salida.</small>
                            </div>
                        </div>
                    </div>

                <div id="emptyState" class="text-center py-5 text-muted" style="display:none;">
                    <i class="fas fa-sign-out-alt fa-3x mb-3 d-block opacity-2"></i>
                    <span class="font-weight-bold">No hay equipos pendientes de salida en este laboratorio.</span>
                    <p class="small mt-2">Solo aparecen equipos en fase <strong>L-3 Salida</strong> con mantenimiento completado.</p>
                </div>

                <div id="loadingState" class="text-center py-5" style="display:none;">
                    <div class="spinner-border text-warning" role="status">
                        <span class="sr-only">Cargando...</span>
                    </div>
                    <p class="mt-2 text-muted font-weight-bold">Cargando equipos...</p>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var rowCount = 0;

        function loadEquipment() {
            var labId = $('#labSelector').val();
            if (!labId) {
                Swal.fire({ icon: 'warning', title: 'Seleccione laboratorio', text: 'Debe seleccionar un laboratorio para cargar los equipos.' });
                return;
            }

            $('#hiddenLabId').val(labId);
            $('#equipmentTable, #emptyState, #datesSection').hide();
            $('#loadingState').show();
            $('#btnSubmit').prop('disabled', true);

            var managementId = $('input[name="ManagementId"]').val();
            var url = '?handler=EquipmentByLab&labId=' + labId + (managementId ? '&managementId=' + managementId : '');

            $.get(url, function (data) {
                $('#loadingState').hide();
                var tbody = $('#tableBody');
                tbody.empty();
                rowCount = 0;

                if (!data || data.length === 0) {
                    $('#emptyState').show();
                    $('#equipCount').hide();
                    return;
                }

                $('#equipCount').text(data.length + ' equipo(s) pendiente(s)').show();

                $.each(data, function (i, item) {
                    var badges = '';
                    if (item.hasTechnician) {
                        badges += '<span class="badge badge-success px-2 mr-1">Con técnico</span>';
                    } else {
                        badges += '<span class="badge badge-danger px-2 mr-1"><i class="fas fa-exclamation-circle mr-1"></i>Sin técnico</span>';
                    }
                    if (!item.hasLaboratory) {
                        badges += '<span class="badge badge-warning px-2"><i class="fas fa-building mr-1"></i>Sin laboratorio</span>';
                    }

                    var canInclude = item.hasTechnician && item.hasLaboratory;

                    var row = '<tr class="hover-light item-row" data-row="' + rowCount + '" data-has-tech="' + item.hasTechnician + '" data-has-lab="' + item.hasLaboratory + '">';
                    row += '<td class="text-center">';
                    if (canInclude) {
                        row += '<input type="checkbox" name="Rows[' + rowCount + '].Include" value="true" class="row-check" checked onchange="updateSubmitBtn()" />';
                    } else {
                        var reasons = [];
                        if (!item.hasTechnician) reasons.push('técnico');
                        if (!item.hasLaboratory) reasons.push('laboratorio');
                        row += '<input type="checkbox" disabled title="Sin ' + reasons.join(' y ') + '" />';
                    }
                    row += '</td>';
                    row += '<td><h6 class="m-0 font-weight-bold text-dark">' + escapeHtml(item.name) + '</h6></td>';
                    row += '<td><span class="text-muted small">Inv: ' + escapeHtml(item.inventoryNumber) + '</span><br/>';
                    row += '<span class="text-muted small">' + escapeHtml(item.brand) + '</span></td>';
                    row += '<td>' + badges + '</td>';
                    var productLabel = item.name + ' (' + item.inventoryNumber + ')';
                    row += '<td>';
                    row += '<select class="form-control form-control-sm custom-select bg-light" disabled>';
                    row += '<option selected>' + escapeHtml(productLabel) + '</option>';
                    row += '</select>';
                    if (canInclude) {
                        row += '<input type="hidden" name="Rows[' + rowCount + '].ProductName" value="' + escapeHtml(productLabel) + '" />';
                        row += '<input type="hidden" name="Rows[' + rowCount + '].PlanId" value="' + item.planId + '" />';
                        row += '<input type="hidden" name="Rows[' + rowCount + '].EquipmentUnitId" value="' + item.equipmentUnitId + '" />';
                    }
                    row += '</td>';
                    row += '</tr>';

                    tbody.append(row);
                    // Solo incrementar si la fila genera inputs (índices contiguos para ASP.NET)
                    if (canInclude) {
                        rowCount++;
                    }
                });

                $('#datesSection').show();
                $('#equipmentTable').show();
                updateSubmitBtn();

                var totalRows = data.length;
                var noTech = data.filter(function(d) { return !d.hasTechnician; }).length;
                var noLab = data.filter(function(d) { return !d.hasLaboratory; }).length;
                var blocked = data.filter(function(d) { return !d.hasTechnician || !d.hasLaboratory; }).length;
                if (blocked > 0) {
                    var parts = [];
                    if (noTech > 0) parts.push('<strong>' + noTech + '</strong> sin técnico en L-8');
                    if (noLab > 0) parts.push('<strong>' + noLab + '</strong> sin laboratorio asignado');
                    $('#diagnosticText').html(parts.join(' y ') + ' de <strong>' + totalRows + '</strong> equipo(s) serán omitidos de la salida.');
                    $('#diagnosticBanner').show();
                } else {
                    $('#diagnosticBanner').hide();
                }
            }).fail(function () {
                $('#loadingState').hide();
                Swal.fire({ icon: 'error', title: 'Error', text: 'No se pudieron cargar los equipos.' });
            });
        }

        function updateSubmitBtn() {
            var dateOk = $('#globalDepartureDate').val() && $('#globalReturnDate').val();
            var checked = $('.row-check:checked').length;
            $('#btnSubmit').prop('disabled', !(checked > 0 && dateOk));
        }

        function showMassAlert(options) {
            if (typeof Swal !== 'undefined') {
                Swal.fire(options);
                return;
            }

            alert((options.title ? options.title + ': ' : '') + (options.text || ''));
        }

        function confirmMassSubmitDirect() {
            var depDate = $('#globalDepartureDate').val();
            var retDate = $('#globalReturnDate').val();
            var form = document.getElementById('massForm');

            if (!form) {
                showMassAlert({ icon: 'error', title: 'Formulario no encontrado', text: 'No se pudo ubicar el formulario de salida masiva.' });
                return;
            }

            if (!depDate || !retDate) {
                showMassAlert({ icon: 'warning', title: 'Fechas requeridas', text: 'Debe ingresar la fecha de salida y la fecha de retorno estimado.' });
                return;
            }

            if (new Date(retDate) < new Date(depDate)) {
                showMassAlert({ icon: 'warning', title: 'Fecha inválida', text: 'La fecha de retorno debe ser igual o posterior a la fecha de salida.' });
                return;
            }

            var count = $('.row-check:checked').length;
            if (count === 0) {
                showMassAlert({ icon: 'warning', title: 'Sin equipos', text: 'Seleccione al menos un equipo para registrar la salida.' });
                return;
            }

            var submitForm = function () {
                $('#btnSubmit').prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Registrando...');
                HTMLFormElement.prototype.submit.call(form);
            };

            if (typeof Swal === 'undefined') {
                submitForm();
                return;
            }

            Swal.fire({
                title: '¿Confirmar Salidas?',
                text: 'Se registrará la salida de ' + count + ' equipo(s) seleccionado(s) y avanzarán al Kardex.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Sí, registrar',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#f59e0b',
                cancelButtonColor: '#6c757d'
            }).then(function (result) {
                if (result && (result.isConfirmed === true || result.value === true)) {
                    submitForm();
                }
            });
        }

        // Check all toggle
        $('#checkAll').change(function () {
            $('.row-check').prop('checked', $(this).is(':checked'));
            updateSubmitBtn();
        });

        // Re-evaluar botón cuando cambian fechas
        $(document).on('change', '#globalDepartureDate, #globalReturnDate', updateSubmitBtn);

        function escapeHtml(text) {
            if (!text) return '';
            return $('<div/>').text(text).html();
        }

        $(function () {
            @if (Model.LabId.HasValue)
            {
                <text>$('#labSelector').val('@Model.LabId'); loadEquipment();</text>
            }
        });
    </script>
}
