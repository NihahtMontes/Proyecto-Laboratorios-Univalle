@page
@model Proyecto_Laboratorios_Univalle.Pages.Departures.DetailsModel
@using Proyecto_Laboratorios_Univalle.Models.Enums

@{
    ViewData["Title"] = "Detalle de Salida (L-3)";
    var d = Model.Departure;
}

<div class="container-fluid px-0">

    <!-- Hero Header -->
    <div class="card border-0 shadow-lg mb-4 overflow-hidden" style="border-radius: 12px;">
        <div class="card-body p-0">
            <div class="row no-gutters">
                <!-- Left Column: Primary Information -->
                <div class="col-lg-9 p-4 bg-white position-relative">
                    <div class="d-flex align-items-center mb-3">
                        <div class="icon-box bg-soft-warning text-warning rounded-circle mr-3 d-flex align-items-center justify-content-center">
                            <i class="fas fa-sign-out-alt fa-2x"></i>
                        </div>
                        <div>
                            <h6 class="text-uppercase text-muted small font-weight-bold mb-1">Salida de Equipo #@d.Id</h6>
                            <h3 class="text-dark font-weight-bold mb-0">@d.EquipmentUnit?.Equipment?.Name</h3>
                            <span class="badge badge-light border mt-1">
                                <i class="fas fa-barcode mr-1"></i> Inv: @d.EquipmentUnit?.InventoryNumber
                            </span>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-sm-3 mb-3 mb-sm-0">
                            <small class="text-uppercase text-muted font-weight-bold d-block mb-1">Fecha Salida</small>
                            <span class="font-weight-bold text-dark h6"><i class="far fa-calendar-alt mr-2 text-warning"></i>@d.DepartureDate.ToString("dd/MM/yyyy")</span>
                        </div>
                        <div class="col-sm-3 mb-3 mb-sm-0">
                            <small class="text-uppercase text-muted font-weight-bold d-block mb-1">Retorno Estimado</small>
                            <span class="font-weight-bold text-dark h6"><i class="far fa-calendar-check mr-2 text-danger"></i>@d.EstimatedReturnDate.ToString("dd/MM/yyyy")</span>
                        </div>
                        <div class="col-sm-3 mb-3 mb-sm-0">
                            <small class="text-uppercase text-muted font-weight-bold d-block mb-1">Retorno Real</small>
                            <span class="font-weight-bold text-dark h6">
                                @if (d.ActualReturnDate.HasValue)
                                {
                                    <i class="fas fa-check-circle mr-1 text-success"></i>@d.ActualReturnDate.Value.ToString("dd/MM/yyyy")
                                }
                                else
                                {
                                    <span class="text-muted">Pendiente</span>
                                }
                            </span>
                        </div>
                        <div class="col-sm-3">
                            <small class="text-uppercase text-muted font-weight-bold d-block mb-1">Laboratorio</small>
                            <span class="font-weight-bold text-dark h6"><i class="fas fa-flask mr-2 text-primary"></i>@(d.EquipmentUnit?.Laboratory?.Name ?? "—")</span>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Status -->
                <div class="col-lg-3 bg-light p-4 d-flex flex-column justify-content-center align-items-center border-left">
                    <small class="text-uppercase text-muted font-weight-bold mb-2">Estado</small>
                    @{
                        var stateConfig = d.Status switch {
                            LoanStatus.Active => ("text-info", "bg-soft-info", "fa-exchange-alt"),
                            LoanStatus.Returned => ("text-success", "bg-soft-success", "fa-check-circle"),
                            LoanStatus.Overdue => ("text-danger", "bg-soft-danger", "fa-exclamation-triangle"),
                            LoanStatus.Cancelled => ("text-secondary", "bg-soft-secondary", "fa-ban"),
                            _ => ("text-secondary", "bg-soft-secondary", "fa-question-circle")
                        };
                    }
                    <div class="status-circle @stateConfig.Item2 @stateConfig.Item1 d-flex align-items-center justify-content-center rounded-circle mb-2" style="width: 80px; height: 80px;">
                        <i class="fas @stateConfig.Item3 fa-3x"></i>
                    </div>
                    <h5 class="font-weight-bold @stateConfig.Item1 mb-0">@Html.DisplayFor(m => d.Status)</h5>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Left Column: Detail Cards -->
        <div class="col-lg-8">
            <div class="row">
                <!-- Tipo de Salida -->
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-header bg-white font-weight-bold text-warning border-bottom-0 pt-3">
                            <i class="fas fa-tag mr-2"></i> Tipo de Salida
                        </div>
                        <div class="card-body">
                            <h5 class="font-weight-bold text-dark">@Html.DisplayFor(m => d.Type)</h5>
                        </div>
                    </div>
                </div>

                <!-- Responsable -->
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-header bg-white font-weight-bold text-info border-bottom-0 pt-3">
                            <i class="fas fa-user mr-2"></i> Responsable / Solicitante
                        </div>
                        <div class="card-body">
                            <h5 class="font-weight-bold text-dark">@(d.Borrower?.FullName ?? "Sin asignar")</h5>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Observaciones -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white font-weight-bold text-dark border-bottom-0 pt-3">
                    <i class="fas fa-comment-dots mr-2 text-primary"></i> Observaciones de Salida
                </div>
                <div class="card-body border-left border-warning" style="border-left-width: 4px !important;">
                    <p class="mb-0 text-dark">
                        @(string.IsNullOrEmpty(d.DepartureObservations) ? "Sin observaciones registradas." : d.DepartureObservations)
                    </p>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(d.ReturnObservations))
            {
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white font-weight-bold text-dark border-bottom-0 pt-3">
                        <i class="fas fa-undo mr-2 text-success"></i> Observaciones de Devolución
                    </div>
                    <div class="card-body border-left border-success" style="border-left-width: 4px !important;">
                        <p class="mb-0 text-dark">@d.ReturnObservations</p>
                    </div>
                </div>
            }

            @if (d.Items != null && d.Items.Any())
            {
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white font-weight-bold text-warning border-bottom-0 pt-3">
                        <i class="fas fa-boxes mr-2"></i> Ítems de la Salida
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover v-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th>Producto</th>
                                        <th class="text-center">Cantidad</th>
                                        <th class="text-center">Unidad</th>
                                        <th class="text-center">Devuelto</th>
                                        <th class="text-center">Saldo</th>
                                        <th>Observaciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in d.Items)
                                    {
                                        <tr>
                                            <td class="font-weight-bold">@item.ProductName</td>
                                            <td class="text-center">@item.Quantity</td>
                                            <td class="text-center">@item.UnitOfMeasure</td>
                                            <td class="text-center">@(item.ReturnedQuantity?.ToString() ?? "0")</td>
                                            <td class="text-center">
                                                @{
                                                    var saldo = item.Balance;
                                                    var badgeClass = saldo == 0 ? "badge-success" : (saldo > 0 ? "badge-warning" : "badge-danger");
                                                }
                                                <span class="badge @badgeClass">@saldo</span>
                                            </td>
                                            <td class="small text-muted">@(item.Observations ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <!-- Auditoría -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white font-weight-bold text-muted border-bottom-0 pt-3">
                    <i class="fas fa-history mr-2"></i> Auditoría
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <small class="text-muted text-uppercase font-weight-bold d-block mb-1">Creado Por</small>
                            <span class="font-weight-bold text-dark">@(d.CreatedBy?.FullName ?? "Sistema")</span>
                            <span class="text-muted d-block small">@d.CreatedDate.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted text-uppercase font-weight-bold d-block mb-1">Última Modificación</small>
                            <span class="font-weight-bold text-dark">@(d.ModifiedBy?.FullName ?? "—")</span>
                            <span class="text-muted d-block small">@(d.LastModifiedDate?.ToString("dd/MM/yyyy HH:mm") ?? "—")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Actions -->
        <div class="col-lg-4">
            <h5 class="text-dark font-weight-bold mb-3 pl-1"><i class="fas fa-cogs mr-2 text-warning"></i>Acciones</h5>

            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <a asp-page="./Edit" asp-route-id="@d.Id" class="btn btn-primary btn-block shadow-sm font-weight-bold mb-2">
                        <i class="fas fa-edit mr-2"></i>Editar Registro
                    </a>
                    <a asp-page="./Index" class="btn btn-outline-secondary btn-block font-weight-bold">
                        <i class="fas fa-arrow-left mr-2"></i>Volver al Listado
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .icon-box { width: 60px; height: 60px; min-width: 60px; }
        .bg-soft-info { background-color: #e3f2fd; }
        .bg-soft-success { background-color: #e8f5e9; }
        .bg-soft-danger { background-color: #ffebee; }
        .bg-soft-warning { background-color: #fff8e1; }
        .bg-soft-secondary { background-color: #f5f5f5; }
    </style>
}
