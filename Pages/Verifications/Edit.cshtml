@page
@model Proyecto_Laboratorios_Univalle.Pages.Verifications.EditModel
@using Proyecto_Laboratorios_Univalle.Models.Enums
@{
    ViewData["Title"] = "Editar Verificación L-6";
}

<div class="container-fluid">
    @* HEADER HERO *@
    <div class="d-md-flex align-items-center mb-4">
        <div class="icon-box bg-soft-info text-info rounded-circle mr-3 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
            <i class="fas fa-clipboard-check fa-lg"></i>
        </div>
        <div>
            <h3 class="card-title text-dark font-weight-bold mb-0">Editar Verificación L-6</h3>
            <h6 class="card-subtitle text-muted small">Actualización de parámetros técnicos de inspección.</h6>
        </div>
    </div>

    <form method="post" id="verificationEditForm">
        <input type="hidden" asp-for="Input.Id" />
        <input type="hidden" asp-for="IsWizard" />
        <input type="hidden" asp-for="ManagementId" />
        <input type="hidden" asp-for="Input.Date" />
        <input type="hidden" asp-for="Input.Status" />
        <input type="hidden" asp-for="Input.EquipmentUnitId" />

        <div class="row">
            @* ZONA DE TRABAJO (8) *@
            <div class="col-lg-8">
                @* FICHA DEL EQUIPO *@
                <div class="card shadow-sm border-0 mb-4 bg-light">
                    <div class="card-body p-3">
                        <div class="row align-items-center">
                            <div class="col-md-7">
                                <label class="small font-weight-bold text-muted uppercase d-block mb-1">Equipo Inspeccionado</label>
                                <h5 class="text-dark font-weight-bold mb-0">@ViewData["EquipmentName"]</h5>
                            </div>
                            <div class="col-md-5 border-left">
                                <label class="small font-weight-bold text-muted uppercase d-block mb-1">N° Inventario</label>
                                <h5 class="text-info font-weight-bold mb-0">@ViewData["InventoryNumber"]</h5>
                            </div>
                        </div>
                    </div>
                </div>

                @* OBSERVACIONES *@
                <div class="card shadow-sm border-0 h-100" style="min-height: 400px;">
                    <div class="card-body p-4">
                        <div class="form-group mb-0">
                            <label asp-for="Input.Observations" class="font-weight-bold small uppercase text-muted mb-3 d-block">
                                <i class="fas fa-comment-dots mr-2 text-info"></i>Observaciones / Fallas Detectadas
                            </label>
                            <textarea asp-for="Input.Observations" class="form-control border-0 bg-light p-3" rows="15" 
                                      style="border-radius: 12px; resize: none;"
                                      placeholder="Describa aquí de forma detallada cualquier hallazgo técnico, falla crítica o recomendación..."></textarea>
                            <span asp-validation-for="Input.Observations" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            @* PANEL DE MANDO (4) *@
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body p-4">
                        <h5 class="card-title text-dark font-weight-bold mb-4 small uppercase border-bottom pb-2">
                            <i class="fas fa-cog mr-2 text-warning"></i> Evaluación Técnica
                        </h5>

                        <div class="form-group mb-4">
                            <label asp-for="Input.PhysicalCondition" class="font-weight-bold small uppercase text-muted d-block mb-3">Condición Física</label>
                            
                            @foreach (PhysicalCondition condition in Enum.GetValues(typeof(PhysicalCondition)))
                            {
                                var color = condition switch {
                                    PhysicalCondition.Excellent => "#16a34a",
                                    PhysicalCondition.Good => "#0ea5e9",
                                    PhysicalCondition.Regular => "#f59e0b",
                                    PhysicalCondition.Bad => "#ef4444",
                                    PhysicalCondition.Decommissioned => "#475569",
                                    _ => "#64748b"
                                };

                                <div class="custom-control custom-radio mb-3">
                                    <input type="radio" asp-for="Input.PhysicalCondition" value="@condition" class="custom-control-input" id="cond_@condition">
                                    <label class="custom-control-label font-weight-bold" for="cond_@condition" style="color: @color;">
                                        @Html.DisplayFor(m => condition)
                                    </label>
                                </div>
                            }
                        </div>

                        <hr />

                        <div class="mt-4">
                            <button type="submit" class="btn btn-info btn-block btn-rounded shadow-sm font-weight-bold py-3 mb-3">
                                <i class="fas fa-save mr-2"></i> Guardar Cambios
                            </button>

                            @if (Model.IsWizard)
                            {
                                <a asp-page="./Details" asp-route-id="@Model.Input.Id" asp-route-isWizard="true" asp-route-managementId="@Model.ManagementId" 
                                   class="btn btn-outline-secondary btn-block btn-rounded font-weight-bold py-2">
                                    Cancelar
                                </a>
                            }
                            else
                            {
                                <a asp-page="./Index" class="btn btn-outline-secondary btn-block btn-rounded font-weight-bold py-2">
                                    Volver al Listado
                                </a>
                            }
                        </div>
                    </div>
                </div>

                @* INFO BOX DE CONTEXTO *@
                <div class="alert alert-info border-0 shadow-sm small p-3">
                    <i class="fas fa-info-circle mr-2"></i>
                    Esta evaluación genera automáticamente el historial de mantenimiento preventivo.
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Inicialización de validaciones jqBootstrapValidation si aplica
        });
    </script>
}

<script>
    let confirmedHealthySubmit = false;
    const initialCondition = '@Model.Input.PhysicalCondition';
    const healthyConditions = ['Excellent', 'Good'];

    document.addEventListener('DOMContentLoaded', function () {
        $('#verificationEditForm').on('submit', function (e) {
        const selectedCondition = $('input[name="Input.PhysicalCondition"]:checked').val();
        const movesToHealthy = !healthyConditions.includes(initialCondition) && healthyConditions.includes(selectedCondition);

        if (!movesToHealthy || confirmedHealthySubmit) {
            return true;
        }

        e.preventDefault();
        Swal.fire({
            title: 'Enviar activo a sanos',
            text: 'Al guardar como Bueno o Excelente, el equipo saldra del flujo L-7 y quedara en la lista de activos sanos de la gestion.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#10b981',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Si, enviar a sanos',
            cancelButtonText: 'Revisar'
        }).then((result) => {
            if (result && (result.isConfirmed === true || result.value === true)) {
                confirmedHealthySubmit = true;
                $('#verificationEditForm').submit();
            }
        });
        });
    });
</script>

@section Styles {
    <style>
        .bg-soft-info { background-color: #e0f2fe; }
        .bg-light { background-color: #f8fafc !important; }
        .uppercase { text-transform: uppercase; letter-spacing: 1px; }
        .custom-control-label { cursor: pointer; padding-left: 5px; }
        .form-control:focus { background-color: #fff !important; border: 1px solid #0ea5e9 !important; box-shadow: 0 0 0 0.2rem rgba(14, 165, 233, 0.1) !important; }
    </style>
}
