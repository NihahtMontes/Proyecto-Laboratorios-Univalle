@page
@model Proyecto_Laboratorios_Univalle.Pages.Verifications.MassCreateModel
@using Proyecto_Laboratorios_Univalle.Models.Enums

@{
    ViewData["Title"] = "Verificaci\u00f3n Masiva (L-6)";
    bool isWizard = (bool)(ViewData["IsWizard"] ?? false);
}

<div class="row justify-content-center">
    <div class="col-lg-12">

        @if (isWizard)
        {
            await Html.RenderPartialAsync("_WizardSteps", 1);
        }

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="d-flex no-block align-items-center mb-4 pb-3 border-bottom">
                    <div>
                        <h4 class="card-title text-dark font-weight-bold">Verificación Masiva por Laboratorio</h4>
                        <h6 class="card-subtitle text-muted">Registro rápido del estado físico de todos los equipos del laboratorio seleccionado.</h6>
                    </div>
                    <div class="ml-auto">
                        <i class="fas fa-clipboard-check fa-2x text-info opacity-5"></i>
                    </div>
                </div>

                <div class="bg-light p-4 rounded mb-4 border-left border-info shadow-sm" style="border-left-width: 4px;">
                    <div class="row align-items-end">
                        <div class="col-md-5">
                            <label class="font-weight-bold small text-uppercase text-muted">Laboratorio / Ambiente</label>
                            <select id="labSelector" class="form-control custom-select" asp-items="Model.LabList">
                                <option value="">-- Seleccione un laboratorio --</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <button type="button" id="btnLoad" class="btn btn-info btn-rounded shadow-sm font-weight-bold px-4" onclick="loadEquipment()">
                                <i class="fas fa-sync-alt mr-1"></i> Cargar Equipos
                            </button>
                        </div>
                        <div class="col-md-4 text-right">
                            <span id="equipCount" class="badge badge-light px-3 py-2 shadow-sm" style="display:none;"></span>
                        </div>
                    </div>
                </div>

                <form method="post" id="massForm">
                    <input type="hidden" name="IsWizard" value="@isWizard.ToString().ToLower()" />
                    <input type="hidden" name="LabId" id="hiddenLabId" value="@Model.LabId" />

                    <div id="equipmentTable" style="display:none;">
                        <div class="table-responsive">
                            <table class="table table-hover v-middle">
                                <thead class="bg-light">
                                    <tr class="small uppercase font-weight-bold">
                                        <th class="border-top-0" style="width: 30%;">Equipo</th>
                                        <th class="border-top-0" style="width: 20%;">Inv. / Marca</th>
                                        <th class="border-top-0 text-center" style="width: 12%;">Estado Actual</th>
                                        <th class="border-top-0" style="width: 28%;">Condición Física</th>
                                        <th class="border-top-0 text-center" style="width: 10%;">Detalle</th>
                                    </tr>
                                </thead>
                                <tbody id="tableBody">
                                </tbody>
                            </table>
                        </div>

                        <hr class="mt-4" />
                        <div class="form-actions text-right pb-4 mt-4">
                            @if (isWizard)
                            {
                                <a asp-page="/Index" asp-route-ShowWizard="true" asp-route-Step="1"
                                   class="btn btn-outline-secondary btn-rounded px-4 mr-2 font-weight-bold">
                                    <i class="fas fa-arrow-left mr-1"></i> Volver al Wizard
                                </a>
                            }
                            <button type="submit" class="btn btn-success btn-rounded px-5 shadow-sm font-weight-bold">
                                <i class="fas fa-save mr-1"></i> Guardar Verificaciones
                            </button>
                        </div>
                    </div>
                </form>

                <div id="emptyState" class="text-center py-5 text-muted" style="display:none;">
                    <i class="fas fa-clipboard-check fa-3x mb-3 d-block opacity-2"></i>
                    <span class="font-weight-bold">No hay equipos pendientes de verificación en este laboratorio.</span>
                </div>

                <div id="loadingState" class="text-center py-5" style="display:none;">
                    <div class="spinner-border text-info" role="status">
                        <span class="sr-only">Cargando...</span>
                    </div>
                    <p class="mt-2 text-muted font-weight-bold">Cargando equipos...</p>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="obsModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title font-weight-bold">
                    <i class="fas fa-exclamation-triangle mr-2"></i>Estado Malo - Observaciones
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="obsRowIndex" />
                <div class="form-group mb-0">
                    <label class="font-weight-bold small text-uppercase text-muted">
                        Fallas o problemas del equipo <span class="text-danger">*</span>
                    </label>
                    <textarea id="obsText" class="form-control" rows="4"
                              placeholder="Describa detalladamente los fallos detectados en el equipo..."></textarea>
                    <small class="form-text text-muted">Este texto se enviará automáticamente como solicitud L-7.</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-rounded" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger btn-rounded font-weight-bold" onclick="saveObservation()">
                    <i class="fas fa-save mr-1"></i> Guardar Observación
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var currentRowIndex = -1;

        function loadEquipment() {
            var labId = $('#labSelector').val();
            if (!labId) {
                Swal.fire({ icon: 'warning', title: 'Seleccione laboratorio', text: 'Debe seleccionar un laboratorio para cargar los equipos.' });
                return;
            }

            $('#hiddenLabId').val(labId);
            $('#equipmentTable, #emptyState').hide();
            $('#loadingState').show();

            $.get('?handler=EquipmentByLab&labId=' + labId, function (data) {
                $('#loadingState').hide();
                var tbody = $('#tableBody');
                tbody.empty();

                if (!data || data.length === 0) {
                    $('#emptyState').show();
                    $('#equipCount').hide();
                    return;
                }

                $('#equipCount').text(data.length + ' equipo(s) pendiente(s)').show();

                $.each(data, function (i, item) {
                    var badgeClass = item.currentStatus === 'Operational' ? 'badge-success' : 'badge-warning';

                    var row = '<tr class="hover-light">';
                    row += '<td>';
                    row += '<h6 class="m-0 font-weight-bold text-dark">' + escapeHtml(item.name) + '</h6>';
                    row += '</td>';
                    row += '<td>';
                    row += '<span class="text-muted small">Inv: ' + escapeHtml(item.inventoryNumber) + '</span><br/>';
                    row += '<span class="text-muted small">' + escapeHtml(item.brand) + '</span>';
                    row += '</td>';
                    row += '<td class="text-center">';
                    row += '<span class="badge ' + badgeClass + ' px-3 py-1">' + escapeHtml(item.currentStatus) + '</span>';
                    row += '</td>';
                    row += '<td>';
                    row += '<select name="Rows[' + i + '].Condition" class="form-control custom-select condition-select" data-row="' + i + '" onchange="onConditionChange(this)">';
                    row += '<option value="5">Excelente (Nuevo)</option>';
                    row += '<option value="4" selected>Bueno</option>';
                    row += '<option value="3">Regular</option>';
                    row += '<option value="2">Malo</option>';
                    row += '<option value="1">Baja del Equipo</option>';
                    row += '</select>';
                    row += '</td>';
                    row += '<td class="text-center">';
                    row += '<span class="obs-indicator text-muted" id="obsIcon_' + i + '" style="display:none;">';
                    row += '<i class="fas fa-comment-dots text-danger fa-lg" title="Tiene observaciones"></i>';
                    row += '</span>';
                    row += '</td>';
                    row += '<input type="hidden" name="Rows[' + i + '].PlanId" value="' + item.planId + '" />';
                    row += '<input type="hidden" name="Rows[' + i + '].EquipmentUnitId" value="' + item.equipmentUnitId + '" />';
                    row += '<input type="hidden" name="Rows[' + i + '].Observations" id="obsHidden_' + i + '" value="" />';
                    row += '</tr>';
                    tbody.append(row);
                });

                $('#equipmentTable').show();
            }).fail(function () {
                $('#loadingState').hide();
                Swal.fire({ icon: 'error', title: 'Error', text: 'No se pudieron cargar los equipos.' });
            });
        }

        function onConditionChange(select) {
            var rowIndex = $(select).data('row');
            var value = $(select).val();

            if (value === '2') {
                currentRowIndex = rowIndex;
                $('#obsText').val($('#obsHidden_' + rowIndex).val());
                $('#obsRowIndex').val(rowIndex);
                $('#obsModal').modal('show');
            } else {
                $('#obsHidden_' + rowIndex).val('');
                $('#obsIcon_' + rowIndex).hide();
            }
        }

        function saveObservation() {
            var obs = $('#obsText').val().trim();
            var rowIndex = parseInt($('#obsRowIndex').val());

            if (!obs) {
                Swal.fire({ icon: 'warning', title: 'Observación requerida', text: 'Debe describir las fallas para equipos en estado Malo.' });
                return;
            }

            $('#obsHidden_' + rowIndex).val(obs);
            $('#obsIcon_' + rowIndex).show();
            $('#obsModal').modal('hide');
        }

        $('#obsModal').on('hidden.bs.modal', function () {
            var rowIndex = parseInt($('#obsRowIndex').val());
            if (rowIndex >= 0) {
                var obs = $('#obsHidden_' + rowIndex).val();
                if (!obs) {
                    $('select[data-row="' + rowIndex + '"]').val('4');
                }
            }
            currentRowIndex = -1;
        });

        function escapeHtml(text) {
            if (!text) return '';
            return $('<div/>').text(text).html();
        }

        $(function () {
            @if (Model.LabId.HasValue)
            {
                <text>$('#labSelector').val('@Model.LabId'); loadEquipment();</text>
            }
        });
    </script>
}
