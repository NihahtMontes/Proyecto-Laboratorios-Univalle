@page
@using Proyecto_Laboratorios_Univalle.Models.Enums
@model Proyecto_Laboratorios_Univalle.Pages.Verifications.CreateModel

<div class="row justify-content-center">
    <div class="col-lg-12">
        <div class="wizard-steps mb-4 d-flex justify-content-between position-relative">
            <div class="step-line"></div>
            <div class="step-item active"><span class="step-number">1</span><span class="step-label">L6 Verificación</span></div>
            <div class="step-item"><span class="step-number">2</span><span class="step-label">L7 Solicitud</span></div>
            <div class="step-item"><span class="step-number">3</span><span class="step-label">L8 Mantenimiento</span></div>
            <div class="step-item"><span class="step-number">4</span><span class="step-label">L3 Salida</span></div>
            <div class="step-item"><span class="step-number">5</span><span class="step-label">Kardex</span></div>
            <div class="step-item"><span class="step-number">6</span><span class="step-label">Desembolso</span></div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-4">
                    <div>
                        <h4 class="card-title text-dark font-weight-bold">Paso 1: Lista de Verificación Técnica (L6)</h4>
                        <h6 class="card-subtitle text-muted">Protocolo de inspección de estado operativo de equipos.</h6>
                    </div>
                    <div class="ml-auto">
                        <button type="button" class="btn btn-outline-success btn-sm btn-rounded font-weight-bold shadow-sm" onclick="markAllGood()">
                            <i class="fas fa-check-double mr-1"></i> Marcar Todo OK
                        </button>
                    </div>
                </div>

                <div class="progress mb-4" style="height: 6px;">
                    <div id="checkProgress" class="progress-bar bg-success" role="progressbar" style="width: 0%;"></div>
                </div>

                <form method="post" id="verificationForm">
                    <input type="hidden" name="isWizard" value="@(ViewData["IsWizard"]?.ToString().ToLower() ?? "false")" />
                    <input type="hidden" asp-for="ManagementPlanId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm border-0 small"></div>

                    <div class="bg-light p-4 rounded mb-4 border-left border-info border-3">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group mb-0">
                                    <label asp-for="Input.FacultyId" class="font-weight-bold small uppercase text-muted">Facultad</label>
                                    <select asp-for="Input.FacultyId" class="form-control select2 shadow-sm" id="facultySelect" asp-items="ViewBag.FacultyId" required>
                                        <option value="">-- Seleccionar Facultad --</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-0">
                                    <label asp-for="Input.LaboratoryId" class="font-weight-bold small uppercase text-muted">Laboratorio</label>
                                    <select asp-for="Input.LaboratoryId" class="form-control select2 shadow-sm" id="laboratorySelect" asp-items="ViewBag.LaboratoryId" required>
                                        <option value="">-- Seleccionar Facultad Primero --</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-0">
                                    <label asp-for="Input.EquipmentUnitId" class="font-weight-bold small uppercase text-muted">Unidad Física</label>
                                    <select asp-for="Input.EquipmentUnitId" class="form-control select2 shadow-sm" id="equipmentUnitSelect" asp-items="ViewBag.EquipmentUnitId" required>
                                        <option value="">-- Seleccionar Laboratorio Primero --</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="card border border-light bg-white shadow-sm mb-4">
                                <div class="card-header bg-white font-weight-bold text-info">Sistema de Combustión y Fluidos</div>
                                <div class="card-body pt-2">
                                    @foreach (var property in new[] { "GasHoseCheck", "WaterHoseCheck", "SolenoidValveCheck", "BurnerCheck", "FlameSensorCheck", "CombustionFlameCheck", "ElectrodeIgniterCheck" })
                                    {
                                        <div class="row align-items-center py-2 border-bottom check-item">
                                            <div class="col-8"><label class="mb-0 small font-weight-bold text-dark">@property</label></div>
                                            <div class="col-4">
                                                <select name="Input.@property" class="form-control custom-select verifier border-0 bg-light" asp-items="Html.GetEnumSelectList<VerificationResult>()"></select>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card border border-light bg-white shadow-sm mb-4">
                                <div class="card-header bg-white font-weight-bold text-info">Eléctrico y Control</div>
                                <div class="card-body pt-2">
                                    @foreach (var property in new[] { "CablingCheck", "TemperatureControlCheck", "LedDisplayCheck", "LightsCheck", "SoundAlarmCheck", "ThermocoupleCheck" })
                                    {
                                        <div class="row align-items-center py-2 border-bottom check-item">
                                            <div class="col-8"><label class="mb-0 small font-weight-bold text-dark">@property</label></div>
                                            <div class="col-4">
                                                <select name="Input.@property" class="form-control custom-select verifier border-0 bg-light" asp-items="Html.GetEnumSelectList<VerificationResult>()"></select>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6"><label asp-for="Input.CriticalFindings" class="font-weight-bold small uppercase text-danger">Hallazgos Críticos</label><textarea asp-for="Input.CriticalFindings" class="form-control border-danger" rows="3"></textarea></div>
                        <div class="col-md-6"><label asp-for="Input.Recommendations" class="font-weight-bold small uppercase text-success">Recomendaciones</label><textarea asp-for="Input.Recommendations" class="form-control border-success" rows="3"></textarea></div>
                    </div>

                    <div class="d-flex align-items-center bg-light p-4 rounded mt-2">
                        <div class="w-50 mr-4">
                            <label asp-for="Input.Status" class="font-weight-bold small uppercase">Estado del Reporte</label>
                            <select asp-for="Input.Status" class="form-control custom-select font-weight-bold" asp-items="Html.GetEnumSelectList<VerificationStatus>()"></select>
                        </div>
                        <div class="ml-auto">
                            <button type="submit" class="btn btn-info btn-rounded px-5 shadow-sm font-weight-bold">Guardar y Avanzar <i class="fas fa-arrow-right ml-2"></i></button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/libs/select2/dist/js/select2.full.min.js"></script>
    <script>
        $(document).ready(function () {
            $(".select2").select2({ width: '100%' });

            // Carga de Laboratorios
            $('#facultySelect').on('change', function() {
                let id = $(this).val();
                if (!id) {
                    $('#laboratorySelect').html('<option value="">-- Seleccionar Facultad Primero --</option>').trigger('change');
                    return;
                }
                $.get('/Verifications/Create?handler=LaboratoriesByFaculty', { facultyId: id }, function(data) {
                    let opts = '<option value="">-- Seleccionar Laboratorio --</option>';
                    $.each(data, function(i, item) { opts += `<option value="${item.id}">${item.name}</option>`; });
                    $('#laboratorySelect').html(opts).trigger('change');
                });
            });

            // Carga de Unidades
            $('#laboratorySelect').on('change', function() {
                let id = $(this).val();
                if (!id) return;
                $.get('/Verifications/Create?handler=UnitsByLab', { laboratoryId: id }, function(data) {
                    let opts = '<option value="">-- Seleccionar Unidad --</option>';
                    $.each(data, function(i, item) { opts += `<option value="${item.id}">${item.name}</option>`; });
                    $('#equipmentUnitSelect').html(opts).trigger('change');
                });
            });

            $(".verifier").on("change", function () { updateProgress(); });
            updateProgress();
        });

        function markAllGood() { $(".verifier").val("1").trigger("change"); }
        function updateProgress() {
            var total = $(".verifier").length;
            var checked = $(".verifier").filter(function () { return $(this).val() != "0"; }).length;
            var percent = Math.round((checked / total) * 100);
            $("#checkProgress").css("width", percent + "%");
        }
    </script>
}