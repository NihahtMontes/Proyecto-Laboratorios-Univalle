@page
@using Proyecto_Laboratorios_Univalle.Models.Enums
@model Proyecto_Laboratorios_Univalle.Pages.Verifications.CreateModel

@{
    ViewData["Title"] = "Registrar Verificación (L-6)";
    bool isWizard = (bool)(ViewData["IsWizard"] ?? false);
    int currentPhaseInt = (int)(ViewData["CurrentPhaseInt"] ?? 1);
    var categoryList = Html.GetEnumSelectList<CostCategory>();
}



<div class="row justify-content-center">
    <div class="col-lg-12">
        @if (isWizard)
        {
            await Html.RenderPartialAsync("_WizardSteps", currentPhaseInt);
        }

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-4">
                    <div class="w-100 mr-4">
                        <h4 class="card-title text-dark font-weight-bold m-0">Paso 1: Lista de Verificación Técnica (L6)</h4>
                        <div class="d-flex justify-content-between align-items-end mt-1">
                            <h6 class="card-subtitle text-muted mb-0">Protocolo de inspección de estado operativo de equipos.</h6>
                            <span class="text-info font-weight-bold small"><i class="fas fa-chart-line mr-1"></i>Avance: <span id="percentText">0%</span></span>
                        </div>
                        <div class="progress mt-2" style="height: 8px; border-radius: 4px; background-color: #f0f0f0;">
                            <div id="checkProgress" class="progress-bar bg-info" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                </div>

                <form method="post" id="verificationForm" novalidate>
                    <input type="hidden" name="isWizard" value="@(ViewData["IsWizard"]?.ToString().ToLower() ?? "false")" />
                    <input type="hidden" asp-for="ManagementPlanId" />
                    <input type="hidden" asp-for="ManagementId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm border-0 small"></div>

                    @* Selección de equipo *@
                    <div class="bg-light p-4 rounded mb-4 border-left border-info border-3 shadow-none" style="border-width: 4px !important;">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group mb-0">
                                    <label asp-for="Input.FacultyId" class="font-weight-bold small uppercase text-muted">Facultad</label>
                                    <select asp-for="Input.FacultyId" class="form-control select2 shadow-sm" id="facultySelect" asp-items="ViewBag.FacultyId" required>
                                        <option value="">-- Seleccionar Facultad --</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-0">
                                    <label asp-for="Input.LaboratoryId" class="font-weight-bold small uppercase text-muted">Laboratorio</label>
                                    <select asp-for="Input.LaboratoryId" class="form-control select2 shadow-sm" id="laboratorySelect" asp-items="ViewBag.LaboratoryId" required>
                                        <option value="">-- Seleccionar Facultad Primero --</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-0">
                                    <label asp-for="Input.EquipmentUnitId" class="font-weight-bold small uppercase text-muted">Unidad Física</label>
                                    <select asp-for="Input.EquipmentUnitId" class="form-control select2 shadow-sm" id="equipmentUnitSelect" asp-items="ViewBag.EquipmentUnitId" required>
                                        <option value="">-- Seleccionar Laboratorio Primero --</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* CHECKLIST DINÁMICA CON CHECKBOXES *@
                    @{
                        var grouped = Model.CheckItems
                            .GroupBy(c => c.Category ?? "General")
                            .OrderBy(g => g.Min(c => c.Order));
                    }

                    <div class="row">
                        @foreach (var group in grouped)
                        {
                            <div class="col-md-6">
                                <div class="card border border-light bg-white shadow-sm mb-4">
                                    <div class="card-header bg-white font-weight-bold text-info border-bottom d-flex justify-content-between align-items-center">
                                        <span><i class="fas fa-check-circle mr-2"></i>@group.Key</span>
                                        <button type="button" class="btn btn-link p-0 text-success font-weight-bold text-xs-premium" onclick="markGroupDone(this)">Marcar Grupo</button>
                                    </div>
                                    <div class="card-body pt-2 pb-0">
                                        @foreach (var item in group.OrderBy(c => c.Order))
                                        {
                                            <div class="row align-items-center py-2 border-bottom check-item hover:bg-slate-50 transition-all duration-200">
                                                <div class="col-1 text-muted small font-weight-bold">@item.Order.</div>
                                                <div class="col-9">
                                                    <label class="mb-0 small font-weight-bold text-dark cursor-pointer" for="chk_@item.Id">@item.Name</label>
                                                </div>
                                                <div class="col-2 text-right">
                                                    <div class="custom-control custom-checkbox custom-control-inline m-0">
                                                        <input type="checkbox" name="Input.Results[@item.Id]" value="Completed" 
                                                               class="custom-control-input verifier" id="chk_@item.Id">
                                                        <label class="custom-control-label" for="chk_@item.Id"></label>
                                                    </div>
                                                </div>
                                            </div>
                                        }%
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @* LISTA DE FALLAS (To-Do Style) *@
                    <div class="row mb-3">
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="font-weight-bold small uppercase text-danger m-0">
                                    <i class="fas fa-exclamation-triangle mr-1"></i>REPORTE DE FALLAS (VERIFICATION FAULTS)
                                </label>
                                <button type="button" class="btn btn-sm btn-outline-danger btn-rounded font-weight-bold shadow-sm" onclick="addFaultRow()">
                                    <i class="fas fa-plus mr-1"></i> Agregar Falla
                                </button>
                            </div>
                            <div id="faultsContainer" class="d-flex flex-column gap-2 bg-white p-3 rounded border border-danger shadow-sm" style="min-height: 80px;">
                                <!-- JS insertará los inputs aquí -->
                                <p id="emptyFaultsMsg" class="text-muted small m-0 text-center font-italic py-2">No hay fallas registradas. El equipo se considerará en perfectas condiciones.</p>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-between bg-light p-4 rounded mt-2">
                        <div>
                            @if (isWizard)
                            {
                                <a asp-page="/Index" asp-route-ShowWizard="true" asp-route-Step="1" asp-route-ManagementId="@ViewData["ManagementId"]"
                                   class="btn btn-outline-secondary btn-rounded px-4 font-weight-bold">
                                    <i class="fas fa-arrow-left mr-1"></i> Volver al Wizard
                                </a>
                            }
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <label asp-for="Input.Status" class="font-weight-bold small uppercase mr-2 mb-0">Estado del Reporte</label>
                            <select asp-for="Input.Status" class="form-control custom-select font-weight-bold" asp-items="Html.GetEnumSelectList<VerificationStatus>()" style="width:auto;"></select>
                            <button type="submit" asp-page-handler="Draft" id="btnDraftVerification" formnovalidate
                                    class="btn btn-outline-info btn-rounded px-4 shadow-sm font-weight-bold mr-2">
                                <i class="fas fa-save mr-1"></i> Guardar Borrador
                            </button>
                            <button type="submit" id="btnSubmitVerification" class="btn btn-info btn-rounded px-5 shadow-sm font-weight-bold">
                                Guardar y Avanzar <i class="fas fa-arrow-right ml-2"></i>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/libs/select2/dist/js/select2.full.min.js"></script>
    <script>
        $(document).ready(function () {
            $(".select2").select2({ width: '100%' });

            $('#facultySelect').on('change', function() {
                let id = $(this).val();
                if (!id) {
                    $('#laboratorySelect').html('<option value="">-- Seleccionar Facultad Primero --</option>').trigger('change');
                    return;
                }
                $.get('/Verifications/Create?handler=LaboratoriesByFaculty', { facultyId: id }, function(data) {
                    let opts = '<option value="">-- Seleccionar Laboratorio --</option>';
                    $.each(data, function(i, item) { opts += `<option value="${item.id}">${item.name}</option>`; });
                    $('#laboratorySelect').html(opts).trigger('change');
                });
            });

            $('#laboratorySelect').on('change', function() {
                let id = $(this).val();
                if (!id) return;
                $.get('/Verifications/Create?handler=UnitsByLab', { laboratoryId: id }, function(data) {
                    let opts = '<option value="">-- Seleccionar Unidad --</option>';
                    $.each(data, function(i, item) { opts += `<option value="${item.id}">${item.name}</option>`; });
                    $('#equipmentUnitSelect').html(opts).trigger('change');
                });
            });

            $(".verifier").on("change", function () { updateProgress(); });
            updateProgress();
        });

        function markGroupDone(btn) {
            $(btn).closest('.card').find('.verifier').prop('checked', true).trigger('change');
        }

        function updateProgress() {
            var total = $(".verifier").length;
            var checked = $(".verifier:checked").length;
            var percent = total > 0 ? Math.round((checked / total) * 100) : 0;
            
            $("#checkProgress").css("width", percent + "%");
            $("#percentText").text(percent + "%");
            
            if (percent === 100) {
                $("#checkProgress").addClass("bg-success").removeClass("bg-info");
            } else {
                $("#checkProgress").addClass("bg-info").removeClass("bg-success");
            }
        }

        // JS List Logic
        window.addFaultRow = function() {
            $('#emptyFaultsMsg').hide();
            let row = `
                <div class="input-group mb-2 fault-row animate-in fade-in duration-300">
                    <div class="input-group-prepend">
                        <span class="input-group-text bg-danger text-white border-danger"><i class="fas fa-wrench"></i></span>
                    </div>
                    <input type="text" name="Input.FaultDescriptions" class="form-control border-danger fault-input" placeholder="Describa la falla técnica detalladamente..." required />
                    <div class="input-group-append">
                        <button type="button" class="btn btn-outline-danger" onclick="removeFaultRow(this)"><i class="fas fa-trash"></i></button>
                    </div>
                </div>
            `;
            $('#faultsContainer').append(row);
        };

        window.removeFaultRow = function(btn) {
            $(btn).closest('.fault-row').remove();
            if ($('.fault-row').length === 0) {
                $('#emptyFaultsMsg').show();
            }
        };

        // Validación SweetAlert2
        let isConfirmedSubmit = false;
        $('#verificationForm').on('submit', function(e) {
            const form = this;
            if (isConfirmedSubmit) return true;

            var submitter = e.originalEvent && e.originalEvent.submitter ? e.originalEvent.submitter : document.activeElement;
            var isDraft = submitter && submitter.id === 'btnDraftVerification';

            if (isDraft) {
                e.preventDefault();

                const submitForm = function() {
                    isConfirmedSubmit = true;
                    $('#btnDraftVerification').prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Guardando...');
                    HTMLFormElement.prototype.submit.call(form);
                };

                if (typeof Swal === 'undefined') {
                    submitForm();
                    return;
                }

                Swal.fire({
                    title: '¿Guardar borrador L-6?',
                    text: 'Se guardará el avance parcial sin pasar a L-7. Podrás continuar la verificación más tarde.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#17a2b8',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Sí, guardar borrador',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result && (result.isConfirmed === true || result.value === true)) {
                        submitForm();
                    }
                });
                return;
            }
            
            let faultsCount = $('.fault-row').length;
            if (faultsCount === 0) {
                e.preventDefault();

                const submitForm = function() {
                    isConfirmedSubmit = true;
                    $('#btnSubmitVerification').prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Guardando...');
                    HTMLFormElement.prototype.submit.call(form);
                };

                if (typeof Swal === 'undefined') {
                    submitForm();
                    return;
                }

                Swal.fire({
                    title: '¿Equipo marcado en perfectas condiciones?',
                    text: 'Se guardará sin registrar fallas.',
                    icon: 'success',
                    showCancelButton: true,
                    confirmButtonColor: '#10b981',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Sí, confirmar',
                    cancelButtonText: 'Revisar'
                }).then((result) => {
                    if (result && (result.isConfirmed === true || result.value === true)) {
                        submitForm();
                    }
                });
            }
        });
    </script>
}
