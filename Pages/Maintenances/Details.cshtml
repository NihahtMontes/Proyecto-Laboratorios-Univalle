@page
@model Proyecto_Laboratorios_Univalle.Pages.Maintenances.DetailsModel
@using Proyecto_Laboratorios_Univalle.Models.Enums
@using Proyecto_Laboratorios_Univalle.Helpers
@{
    ViewData["Title"] = "Detalle de Mantenimiento (L-8)";
    var equipmentName = Model.Maintenance.EquipmentUnit?.Equipment?.Name ?? "Equipo historico no disponible";
    var inventoryNumber = Model.Maintenance.EquipmentUnit?.InventoryNumber ?? "Sin inventario";
    var laboratoryName = Model.Maintenance.EquipmentUnit?.Laboratory?.Name ?? "Sin ambiente vigente";
    var activeTasks = Model.Maintenance.Tasks
        .Where(task => !task.IsDeleted)
        .OrderBy(task => task.Id)
        .ToList();
    var activeParticipants = Model.Maintenance.Participants
        .Where(participant => participant.IsActive)
        .OrderByDescending(participant => participant.IsPrimary)
        .ThenBy(participant => participant.Role)
        .ToList();
    var costDetailTotal = Model.Maintenance.CalculatedTotal;
    var completionPercentage = Math.Clamp(Model.Maintenance.CompletionPercentage, 0, 100);
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
        <i class="fas fa-exclamation-triangle mr-2"></i> @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <div class="d-flex no-block align-items-center mb-4 pb-3 border-bottom">
                    <div>
                        <h4 class="card-title text-dark font-weight-bold">Mantenimiento #@Model.Maintenance.Id</h4>
                        <h6 class="card-subtitle text-muted small"><i class="fas fa-tools mr-1"></i> Ficha técnica del proceso de mantenimiento realizado.</h6>
                    </div>
                    <div class="ml-auto d-print-none">
                        <i class="fas fa-tools fa-2x text-info opacity-5"></i>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 border-right">
                        <h5 class="text-info font-weight-bold mb-3 small uppercase"><i class="fas fa-info-circle mr-2"></i> Información General</h5>
                        
                        <div class="mb-3">
                            <label class="small text-muted font-weight-bold d-block mb-0 uppercase">Equipamiento</label>
                            <p class="text-dark font-weight-bold mb-1">@equipmentName</p>
                            <span class="badge badge-pill badge-light border text-muted small">Inv: @inventoryNumber</span>
                            <span class="badge badge-pill badge-light border text-muted small ml-1">@laboratoryName</span>
                        </div>

                        <div class="mb-3">
                            <label class="small text-muted font-weight-bold d-block mb-0 uppercase">Gestión</label>
                            <p class="text-dark font-weight-bold mb-1">@Model.FormatManagement(Model.Maintenance.Management)</p>
                            <span class="text-muted small">@(Model.Maintenance.Management?.Type == ManagementType.Corrective ? "Correctiva" : "Preventiva")</span>
                        </div>

                        <div class="mb-3">
                            <label class="small text-muted font-weight-bold d-block mb-0 uppercase">Tipo de Mantenimiento</label>
                            <p class="text-dark font-weight-bold mb-1">@EnumHelper.GetDisplayName(Model.Maintenance.MaintenanceType)</p>
                            <span class="badge badge-light border mr-1">Servicio @DetailsModel.FormatServiceType(Model.Maintenance.ServiceType)</span>
                            @if (!string.IsNullOrWhiteSpace(Model.Maintenance.InstitutionalCode))
                            {
                                <span class="badge badge-light border">Código: @Model.Maintenance.InstitutionalCode</span>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="small text-muted font-weight-bold d-block mb-0 uppercase">Descripción / Hallazgos</label>
                            <p class="text-dark small">@(Model.Maintenance.Description ?? "Sin descripción registrada.")</p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <h5 class="text-info font-weight-bold mb-3 small uppercase"><i class="fas fa-calendar-alt mr-2"></i> Ejecución y Personal</h5>
                        
                        <div class="mb-3">
                            <label class="small text-muted font-weight-bold d-block mb-0 uppercase">Técnico Responsable</label>
                            <div class="d-flex align-items-center">
                                <i class="fas fa-user-cog text-info mr-2"></i>
                                <p class="text-dark font-weight-bold mb-0">@(Model.Maintenance.Technician?.FullName ?? Model.Maintenance.TechnicianName ?? "No asignado")</p>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="small text-muted font-weight-bold mb-0 uppercase">Avance registrado</label>
                                <span class="small font-weight-bold text-dark">@completionPercentage%</span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar bg-info" role="progressbar" style="width: @completionPercentage%;" aria-valuenow="@completionPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="small text-muted font-weight-bold d-block mb-0 uppercase">Programado</label>
                                <p class="text-dark small"><i class="far fa-calendar mr-1"></i> @(Model.Maintenance.ScheduledDate?.ToString("dd/MM/yyyy") ?? "-")</p>
                            </div>
                            <div class="col-6 mb-3">
                                <label class="small text-muted font-weight-bold d-block mb-0 uppercase">Inicio Real</label>
                                <p class="text-dark small"><i class="far fa-clock mr-1 text-success"></i> @(Model.Maintenance.StartDate?.ToString("dd/MM/yyyy") ?? "-")</p>
                            </div>
                            <div class="col-6 mb-3">
                                <label class="small text-muted font-weight-bold d-block mb-0 uppercase">Finalización</label>
                                <p class="text-dark small"><i class="fas fa-check-double mr-1 text-info"></i> @(Model.Maintenance.EndDate?.ToString("dd/MM/yyyy") ?? "-")</p>
                            </div>
                            <div class="col-6 mb-3">
                                <label class="small text-muted font-weight-bold d-block mb-0 uppercase">Duración real</label>
                                <p class="text-dark small">
                                    <i class="fas fa-hourglass-half mr-1"></i>
                                    @(Model.Maintenance.DurationHours.HasValue ? $"{Model.Maintenance.DurationHours.Value:N1} hora(s)" : "No disponible")
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mt-4 pt-3 border-top">
                    <div class="col-md-4">
                        <label class="small text-muted font-weight-bold d-block mb-0 uppercase">Nivel de Satisfacción</label>
                        <p class="text-dark font-weight-bold">
                            @if (Model.Maintenance.SatisfactionLevel.HasValue)
                            {
                                <i class="fas fa-star text-warning mr-1"></i> @Html.DisplayFor(m => m.Maintenance.SatisfactionLevel)
                            }
                            else
                            {
                                <span class="text-muted">No evaluado</span>
                            }
                        </p>
                    </div>
                    <div class="col-md-4">
                        <label class="small text-muted font-weight-bold d-block mb-0 uppercase">Próximo mantenimiento sugerido</label>
                        <p class="text-dark font-weight-bold">@(Model.Maintenance.SuggestedNextMaintenanceDate?.ToString("dd/MM/yyyy") ?? "No definido")</p>
                    </div>
                    <div class="col-md-4">
                        <label class="small text-muted font-weight-bold d-block mb-0 uppercase">Costos</label>
                        <p class="text-dark mb-0"><span class="text-muted small">Estimado:</span> <strong>@(Model.Maintenance.EstimatedCost.HasValue ? $"Bs {Model.Maintenance.EstimatedCost.Value:N2}" : "No registrado")</strong></p>
                        <p class="text-dark mb-0"><span class="text-muted small">Real declarado:</span> <strong>@(Model.Maintenance.ActualCost.HasValue ? $"Bs {Model.Maintenance.ActualCost.Value:N2}" : "No registrado")</strong></p>
                        <p class="text-dark"><span class="text-muted small">Suma de ítems:</span> <strong>@(costDetailTotal > 0 ? $"Bs {costDetailTotal:N2}" : "Sin ítems")</strong></p>
                    </div>
                </div>

                <div class="row pt-3 border-top">
                    <div class="col-md-6">
                        <label class="small text-muted font-weight-bold d-block mb-0 uppercase">Recomendaciones Técnicas</label>
                        <p class="text-dark small italic">@(Model.Maintenance.Recommendations ?? "Sin recomendaciones registradas.")</p>
                    </div>
                    <div class="col-md-6">
                        <label class="small text-muted font-weight-bold d-block mb-0 uppercase">Observaciones Finales</label>
                        <p class="text-dark small">@(Model.Maintenance.Observations ?? "Sin observaciones registradas.")</p>
                    </div>
                </div>

                <div class="mt-4 pt-4 border-top">
                    <h5 class="text-dark font-weight-bold mb-3 small uppercase"><i class="fas fa-clipboard-check mr-2 text-info"></i> Lista de control L-48</h5>
                    <div class="row">
                        <div class="col-sm-6 mb-2">
                            <span class="small"><i class="@(Model.Maintenance.Step1_Cleaning ? "fas fa-check-circle text-success" : "far fa-circle text-muted") mr-2"></i>Limpieza y desinfección</span>
                        </div>
                        <div class="col-sm-6 mb-2">
                            <span class="small"><i class="@(Model.Maintenance.Step2_Calibration ? "fas fa-check-circle text-success" : "far fa-circle text-muted") mr-2"></i>Calibración del sistema</span>
                        </div>
                        <div class="col-sm-6 mb-2">
                            <span class="small"><i class="@(Model.Maintenance.Step3_Testing ? "fas fa-check-circle text-success" : "far fa-circle text-muted") mr-2"></i>Pruebas de esfuerzo o carga</span>
                        </div>
                        <div class="col-sm-6 mb-2">
                            <span class="small"><i class="@(Model.Maintenance.Step4_FinalReview ? "fas fa-check-circle text-success" : "far fa-circle text-muted") mr-2"></i>Revisión final de seguridad</span>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-4 border-top">
                    <h5 class="text-dark font-weight-bold mb-3 small uppercase"><i class="fas fa-tasks mr-2 text-info"></i> Tareas L-48 Ejecutadas</h5>
                    @if (activeTasks.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover border">
                                <thead class="bg-light">
                                    <tr class="small uppercase font-weight-bold">
                                        <th>Tarea</th>
                                        <th class="text-center">Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var task in activeTasks)
                                    {
                                        var taskBadge = task.IsCompleted ? "badge-success" : "badge-secondary";
                                        var taskText = task.IsCompleted ? "Completada" : "Pendiente";
                                        <tr>
                                            <td class="small font-weight-bold">@task.Description</td>
                                            <td class="small text-center">
                                                <span class="badge @taskBadge font-weight-bold">@taskText</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light border shadow-none small">
                            <i class="fas fa-info-circle mr-2"></i> No se registraron tareas L-48 para este mantenimiento.
                        </div>
                    }
                </div>

                <div class="mt-4 pt-4 border-top">
                    <h5 class="text-dark font-weight-bold mb-3 small uppercase"><i class="fas fa-users mr-2 text-info"></i> Personal participante</h5>
                    @if (activeParticipants.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover border">
                                <thead class="bg-light">
                                    <tr class="small uppercase font-weight-bold">
                                        <th>Persona</th>
                                        <th>Rol</th>
                                        <th class="text-center">Responsabilidad</th>
                                        <th>Asignación</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var participant in activeParticipants)
                                    {
                                        <tr>
                                            <td class="small font-weight-bold">@(participant.Person?.FullName ?? "Persona no disponible")</td>
                                            <td class="small">@EnumHelper.GetDisplayName(participant.Role)</td>
                                            <td class="small text-center">
                                                @if (participant.IsPrimary)
                                                {
                                                    <span class="badge badge-info">Responsable principal</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-light border">Participante</span>
                                                }
                                            </td>
                                            <td class="small">@participant.AssignedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light border shadow-none small">
                            <i class="fas fa-info-circle mr-2"></i> No hay participantes adicionales; se conserva el técnico responsable mostrado en la cabecera.
                        </div>
                    }
                </div>

                <div class="mt-4 pt-4 border-top">
                    <h5 class="text-dark font-weight-bold mb-3 small uppercase"><i class="fas fa-file-alt mr-2 text-info"></i> Solicitudes relacionadas</h5>
                    @if (Model.RelatedRequests.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover border">
                                <thead class="bg-light">
                                    <tr class="small uppercase font-weight-bold">
                                        <th>Solicitud</th>
                                        <th>Fecha</th>
                                        <th>Solicitante</th>
                                        <th>Prioridad</th>
                                        <th>Estado</th>
                                        <th>Descripción</th>
                                        <th class="text-center">Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var request in Model.RelatedRequests)
                                    {
                                        <tr>
                                            <td class="small font-weight-bold">#SOL-@request.Id.ToString("D5")</td>
                                            <td class="small">@(request.RequestDate?.ToString("dd/MM/yyyy") ?? request.CreatedDate.ToString("dd/MM/yyyy"))</td>
                                            <td class="small">@DetailsModel.FormatRequester(request)</td>
                                            <td class="small">@EnumHelper.GetDisplayName(request.Priority)</td>
                                            <td class="small"><span class="badge badge-pill @DetailsModel.GetRequestStatusBadge(request.Status)">@EnumHelper.GetDisplayName(request.Status)</span></td>
                                            <td class="small text-muted">@request.Description</td>
                                            <td class="text-center">
                                                <a asp-page="/Requests/Details" asp-route-id="@request.Id" class="btn btn-sm btn-outline-info btn-rounded" title="Ver solicitud">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light border shadow-none small">
                            <i class="fas fa-info-circle mr-2"></i> Este mantenimiento no tiene una solicitud asociada.
                        </div>
                    }
                </div>

                @if (Model.Maintenance.CostDetails != null && Model.Maintenance.CostDetails.Any())
                {
                    <div class="mt-4 pt-4 border-top">
                        <h5 class="text-dark font-weight-bold mb-3 small uppercase"><i class="fas fa-money-bill-wave mr-2 text-success"></i> Desglose de Gastos</h5>
                        <div class="table-responsive">
                            <table class="table table-sm table-hover border">
                                <thead class="bg-light">
                                    <tr class="small uppercase font-weight-bold">
                                        <th>Ítem y detalle</th>
                                        <th>Categoría</th>
                                        <th>Proveedor / comprobante</th>
                                        <th>Fecha</th>
                                        <th class="text-right">Cantidad</th>
                                        <th class="text-right">Unitario</th>
                                        <th class="text-right">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Maintenance.CostDetails)
                                    {
                                        <tr>
                                            <td class="small">
                                                <span class="font-weight-bold text-dark d-block">@item.Concept</span>
                                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                                {
                                                    <span class="text-muted">@item.Description</span>
                                                }
                                            </td>
                                            <td class="small">@EnumHelper.GetDisplayName(item.Category)</td>
                                            <td class="small">
                                                <span class="d-block">@(item.ProviderPerson?.FullName ?? item.Provider ?? "Sin proveedor")</span>
                                                @if (!string.IsNullOrWhiteSpace(item.InvoiceNumber))
                                                {
                                                    <span class="text-muted">Comp.: @item.InvoiceNumber</span>
                                                }
                                            </td>
                                            <td class="small">@(item.CostDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                                            <td class="small text-right">@item.Quantity @item.UnitOfMeasure</td>
                                            <td class="small text-right">Bs @item.UnitPrice.ToString("N2")</td>
                                            <td class="small text-right font-weight-bold">Bs @item.Subtotal.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="bg-light">
                                    <tr>
                                        <td colspan="6" class="text-right font-weight-bold uppercase small">Total de ítems:</td>
                                        <td class="text-right font-weight-bold text-success" style="font-size: 1rem;">
                                            Bs @costDetailTotal.ToString("N2")
                                        </td>
                                    </tr>
                                    @if (Model.Maintenance.ActualCost.HasValue)
                                    {
                                        <tr>
                                            <td colspan="6" class="text-right font-weight-bold uppercase small">Costo real declarado:</td>
                                            <td class="text-right font-weight-bold">Bs @Model.Maintenance.ActualCost.Value.ToString("N2")</td>
                                        </tr>
                                    }
                                </tfoot>
                            </table>
                        </div>
                        @if (Model.Maintenance.ActualCost.HasValue && Model.Maintenance.ActualCost.Value != costDetailTotal)
                        {
                            <div class="alert alert-warning border small mb-0">
                                <i class="fas fa-exclamation-triangle mr-2"></i>
                                El costo real declarado no coincide con la suma de los ítems. Se muestran ambos valores sin alterar el registro.
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-light border shadow-none small mt-4">
                        <i class="fas fa-info-circle mr-2"></i> No se registraron costos adicionales para este mantenimiento.
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4 d-print-none">
        <div class="card shadow-sm border-0 mb-4 border-left border-info border-left-3 bg-light">
            <div class="card-body">
                <h5 class="font-weight-bold small uppercase mb-3 text-info"><i class="fas fa-shield-alt mr-2"></i> Estado de Mantenimiento</h5>
                <hr class="mb-4" />
                
                <div class="mb-3">
                    <label class="text-muted uppercase font-weight-bold d-block" style="font-size: 0.65rem;">Identificador Único</label>
                    <span class="font-weight-bold text-dark" style="font-size: 1.2rem;">#MNT-@Model.Maintenance.Id.ToString("D5")</span>
                </div>

                <div class="mb-0">
                    <label class="text-muted uppercase font-weight-bold d-block" style="font-size: 0.65rem;">Estatus Actual</label>
                    <span class="badge badge-pill @DetailsModel.GetMaintenanceStatusBadge(Model.Maintenance.Status) px-3 py-1 font-weight-bold">@EnumHelper.GetDisplayName(Model.Maintenance.Status)</span>
                </div>

                <div class="mt-3 pt-3 border-top">
                    <label class="text-muted uppercase font-weight-bold d-block" style="font-size: 0.65rem;">Cumplimiento de fecha</label>
                    @if (Model.Maintenance.CompletedOnTime.HasValue)
                    {
                        <span class="badge @(Model.Maintenance.CompletedOnTime.Value ? "badge-success" : "badge-warning")">
                            @(Model.Maintenance.CompletedOnTime.Value ? "Finalizado a tiempo" : "Finalizado fuera de fecha")
                        </span>
                    }
                    else
                    {
                        <span class="text-muted small">No evaluable con las fechas registradas</span>
                    }
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <h5 class="card-title text-dark font-weight-bold mb-4 small uppercase"><i class="fas fa-history mr-2 text-warning"></i> Bitácora de Auditoría</h5>
                <hr />
                <div class="audit-log">
                    <div class="mb-3">
                        <label class="text-muted d-block small uppercase mb-0 font-weight-bold" style="font-size: 0.65rem;">Origen de Solicitud</label>
                        <span class="font-weight-bold text-dark d-block">@(Model.Maintenance.CreatedBy?.FullName ?? "Sistema")</span>
                        <span class="text-muted small">@Model.Maintenance.CreatedDate.ToString("dd-MM-yyyy HH:mm")</span>
                    </div>
                    @if (Model.Maintenance.LastModifiedDate.HasValue)
                    {
                        <div class="mb-0 border-top pt-3 mt-3">
                            <label class="text-muted d-block small uppercase mb-0 font-weight-bold" style="font-size: 0.65rem;">Última Actualización</label>
                            <span class="font-weight-bold text-dark d-block">@(Model.Maintenance.ModifiedBy?.FullName ?? "-")</span>
                            <span class="text-muted small">@Model.Maintenance.LastModifiedDate.Value.ToString("dd-MM-yyyy HH:mm")</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="form-actions mt-4">
            <a asp-page="./Edit" asp-route-id="@Model.Maintenance.Id" asp-route-returnUrl="Details"
               asp-route-isWizard="@Model.IsWizard"
               asp-route-managementId="@ViewData["ManagementId"]"
               asp-route-managementPlanId="@Model.ManagementPlanId"
               asp-route-focusPlanId="@Model.FocusPlanId"
               class="btn btn-warning btn-block btn-rounded shadow-sm font-weight-bold py-3 mb-3">
                <i class="fas fa-edit mr-2"></i> Editar Registro
            </a>

            <a href="/api/reports/download/l8?managementPlanId=@Model.ManagementPlanId&unitId=@Model.Maintenance.EquipmentUnitId&managementId=@Model.Maintenance.ManagementId"
               class="btn btn-success btn-block btn-rounded shadow-sm font-weight-bold py-3 mb-3">
                <i class="fas fa-file-excel mr-2"></i> Descargar Kardex L-8
            </a>

            @if (Model.Maintenance.EquipmentUnit != null)
            {
                <a asp-page="/EquipmentUnits/Kardex" asp-route-id="@Model.Maintenance.EquipmentUnitId" class="btn btn-outline-primary btn-block btn-rounded shadow-sm font-weight-bold py-2 mb-3">
                    <i class="fas fa-history mr-2"></i> Ver Kardex
                </a>
            }
            else
            {
                <button type="button" class="btn btn-outline-secondary btn-block btn-rounded py-2 mb-3" disabled>
                    <i class="fas fa-history mr-2"></i> Kardex no disponible
                </button>
            }

            @if (Model.IsWizard)
            {
                <a asp-page="/Index" asp-route-ShowWizard="true" asp-route-Step="3" asp-route-ManagementId="@ViewData["ManagementId"]" asp-route-focusPlanId="@Model.FocusPlanId"
                   class="btn btn-outline-secondary btn-block btn-rounded font-weight-bold py-2 mb-4">
                    <i class="fas fa-arrow-left mr-2"></i> Volver al Wizard
                </a>
            }
            else
            {
                <a asp-page="./Index" class="btn btn-outline-secondary btn-block btn-rounded font-weight-bold py-2 mb-4">
                    <i class="fas fa-arrow-left mr-2"></i> Volver al Listado
                </a>
            }
        </div>
    </div>
</div>

@section Styles {
    <style>
        .border-left-3 { border-left-width: 4px !important; }
        .italic { font-style: italic; }
        .opacity-5 { opacity: 0.15; }
        .uppercase { text-transform: uppercase; letter-spacing: 0.5px; }
        .audit-log label { letter-spacing: 0.5px; }
    </style>
}
