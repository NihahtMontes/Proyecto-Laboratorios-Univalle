@page
@model Proyecto_Laboratorios_Univalle.Pages.Maintenances.PlanModel
@{
    ViewData["Title"] = "Plan de mantenimiento";
    ViewData["Section"] = "Mantenimiento de equipos";
    ViewData["HidePageTitle"] = true;
    var hasActiveFilters = !string.IsNullOrWhiteSpace(Model.SearchTerm)
        || Model.ManagementId.HasValue
        || Model.MaintenanceType.HasValue;
}

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="d-md-flex align-items-center mb-4">
                    <div>
                        <h3 class="card-title text-dark font-weight-bold mt-2 ml-2">Cronograma de mantenimiento</h3>
                        <h6 class="card-subtitle text-muted ml-2">Consulta de solo lectura del plan hist&oacute;rico de mantenimiento (datos importados).</h6>
                    </div>
                </div>

                <div class="bg-light p-3 mb-4 rounded border-left border-info">
                    <form method="get" data-live-filter-form>
                        <label asp-for="SearchTerm" class="sr-only">Buscar plan de mantenimiento</label>
                        <div class="input-group mb-3">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-white border-right-0"><i class="fas fa-search text-muted"></i></span>
                            </div>
                            <input type="search" asp-for="SearchTerm"
                                   class="form-control border-left-0 @(!string.IsNullOrWhiteSpace(Model.SearchTerm) ? "border-info" : "")"
                                   placeholder="Buscar por c&oacute;digo de plan, n.&ordm; de inventario o equipo"
                                   autocomplete="off"
                                   data-live-filter-search />
                        </div>

                        <div class="d-flex flex-wrap align-items-center border-top pt-3">
                            <select asp-for="ManagementId"
                                    class="custom-select btn-rounded w-auto mw-100 mr-2 mb-2 @(Model.ManagementId.HasValue ? "border-info text-info font-weight-bold" : "")"
                                    asp-items="Model.ManagementList"
                                    aria-label="Gesti&oacute;n"
                                    data-live-filter-control>
                                <option value="">Gesti&oacute;n</option>
                            </select>
                            <select asp-for="MaintenanceType"
                                    class="custom-select btn-rounded w-auto mw-100 mr-2 mb-2 @(Model.MaintenanceType.HasValue ? "border-info text-info font-weight-bold" : "")"
                                    asp-items="@Proyecto_Laboratorios_Univalle.Helpers.EnumHelper.ToSelectList<Proyecto_Laboratorios_Univalle.Models.Enums.MaintenanceType>()"
                                    aria-label="Tipo de mantenimiento"
                                    data-live-filter-control>
                                <option value="">Tipo de mantenimiento</option>
                            </select>

                            @if (hasActiveFilters)
                            {
                                <a asp-page="./Plan" class="btn btn-link btn-sm text-muted mb-2" title="Limpiar filtros">
                                    <i class="fas fa-times mr-1"></i> Limpiar filtros
                                </a>
                            }

                            <span class="small text-muted ml-auto mb-2" aria-live="polite">
                                <strong class="text-dark">@Model.Plans.TotalCount</strong> plan(es)
                            </span>
                        </div>
                    </form>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover v-middle">
                        <thead class="bg-light">
                            <tr class="small uppercase font-weight-bold">
                                <th>C&oacute;digo</th>
                                <th>Gesti&oacute;n</th>
                                <th>Equipamiento</th>
                                <th>Laboratorio</th>
                                <th>Tipo de Mantenimiento</th>
                                <th>Tipo de Servicio</th>
                                <th>Responsable</th>
                                <th class="text-center">Fecha Planificada</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center">Calidad</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Plans == null || !Model.Plans.Any())
                            {
                                <tr>
                                    <td colspan="10" class="text-center py-5 text-muted italic font-weight-bold">
                                        <i class="fas fa-clipboard-list fa-3x mb-3 d-block opacity-2"></i>
                                        No hay planes en el cronograma para la b&uacute;squeda actual.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model.Plans)
                                {
                                    <tr>
                                        <td>
                                            <span class="font-weight-bold text-dark">@(item.PlanCode ?? "—")</span>
                                        </td>
                                        <td>
                                            <div class="small font-weight-bold">@(item.Management?.Code ?? "—")</div>
                                        </td>
                                        <td>
                                            @if (item.EquipmentUnit != null)
                                            {
                                                <div class="d-flex align-items-center">
                                                    <div>
                                                        <h6 class="m-b-0 font-weight-bold text-dark">@(item.EquipmentUnit.Equipment?.Name ?? "S/E")</h6>
                                                        <span class="text-muted small">Inv: @item.EquipmentUnit.InventoryNumber</span>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="small">@(item.Laboratory?.Code ?? "—")</span>
                                        </td>
                                        <td>
                                            <div class="text-dark font-weight-bold">
                                                @(item.MaintenanceType.HasValue ? Proyecto_Laboratorios_Univalle.Helpers.EnumHelper.GetDisplayName(item.MaintenanceType.Value) : "—")
                                            </div>
                                        </td>
                                        <td>
                                            @if (item.ServiceType.HasValue)
                                            {
                                                <span class="small">@Proyecto_Laboratorios_Univalle.Helpers.EnumHelper.GetDisplayName(item.ServiceType.Value)</span>
                                            }
                                            else
                                            {
                                                <span class="small text-muted font-italic" title="El archivo del cliente indica 'Por confirmar'">Por confirmar</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="small font-weight-bold">@(item.ResponsiblePerson?.FullName ?? "—")</div>
                                        </td>
                                        <td class="text-center">
                                            <div class="small font-weight-bold">@(item.PlannedDate?.ToString("dd/MM/yyyy") ?? "—")</div>
                                        </td>
                                        <td class="text-center">
                                            @if (item.Status.HasValue)
                                            {
                                                var (statusClass, statusText) = item.Status.Value switch
                                                {
                                                    MaintenanceStatus.Pending => ("badge-warning", "PENDIENTE"),
                                                    MaintenanceStatus.InProgress => ("badge-warning", "EN EJECUCIÓN"),
                                                    MaintenanceStatus.Scheduled => ("badge-info", "PROGRAMADO"),
                                                    MaintenanceStatus.Completed => ("badge-success", "COMPLETADO"),
                                                    MaintenanceStatus.Cancelled => ("badge-danger", "CANCELADO"),
                                                    _ => ("badge-secondary", "DESCONOCIDO")
                                                };
                                                <span class="badge @statusClass px-3 py-1 font-weight-bold">@statusText</span>
                                            }
                                            else
                                            {
                                                <span class="small text-muted font-italic" title="El archivo del cliente indica 'Por confirmar'">Por confirmar</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (!string.IsNullOrWhiteSpace(item.QualityStatus))
                                            {
                                                var qualityClass = string.Equals(item.QualityStatus, "Válida", StringComparison.OrdinalIgnoreCase)
                                                    ? "badge-success"
                                                    : "badge-warning";
                                                <span class="badge @qualityClass px-2 font-weight-bold">@item.QualityStatus</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.Plans!.HasPreviousPage || Model.Plans.HasNextPage)
                {
                    <nav aria-label="Page navigation" class="mt-4">
                        <ul class="pagination justify-content-center">
                            @if (Model.Plans.HasPreviousPage)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-page="./Plan" asp-route-pageIndex="@(Model.Plans.PageIndex - 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-managementId="@Model.ManagementId" asp-route-maintenanceType="@Model.MaintenanceType">Anterior</a>
                                </li>
                            }
                            @for (var i = 1; i <= Model.Plans.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.Plans.PageIndex ? "active" : "")">
                                    <a class="page-link" asp-page="./Plan" asp-route-pageIndex="@i" asp-route-searchTerm="@Model.SearchTerm" asp-route-managementId="@Model.ManagementId" asp-route-maintenanceType="@Model.MaintenanceType">@i</a>
                                </li>
                            }
                            @if (Model.Plans.HasNextPage)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-page="./Plan" asp-route-pageIndex="@(Model.Plans.PageIndex + 1)" asp-route-searchTerm="@Model.SearchTerm" asp-route-managementId="@Model.ManagementId" asp-route-maintenanceType="@Model.MaintenanceType">Siguiente</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .v-middle td { vertical-align: middle !important; }
        .uppercase { text-transform: uppercase; letter-spacing: 0.5px; }
        .italic { font-style: italic; }
        .opacity-2 { opacity: 0.2; }
    </style>
}
