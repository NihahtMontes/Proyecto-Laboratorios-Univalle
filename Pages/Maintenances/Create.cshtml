@page
@model Proyecto_Laboratorios_Univalle.Pages.Maintenances.CreateModel
@using Proyecto_Laboratorios_Univalle.Models.Enums

@{
    ViewData["Title"] = "Registrar Mantenimiento (L-8)";
    bool isWizard = (bool)(ViewData["IsWizard"] ?? false);
    int currentPhaseInt = (int)(ViewData["CurrentPhaseInt"] ?? 3);
    var categoryList = Html.GetEnumSelectList<CostCategory>();
}

<div class="row justify-content-center">
    <div class="col-lg-12">

        @if (isWizard)
        {
            await Html.RenderPartialAsync("_WizardSteps", currentPhaseInt);
        }

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="d-flex no-block align-items-center mb-4">
                    <div>
                        <h4 class="card-title text-dark font-weight-bold">Registrar Mantenimiento / Servicio (L-8)</h4>
                        <h6 class="card-subtitle text-muted">Complete el registro técnico de la intervención realizada al equipo.</h6>
                    </div>
                    <div class="ml-auto text-right">
                         <i class="fas fa-tools fa-2x text-warning opacity-5"></i>
                    </div>
                </div>

                <form method="post" id="maintenanceForm" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm border-0 mb-4"></div>

                    <div class="alert bg-light border-left border-info shadow-sm mb-4 small" style="border-left-width: 4px !important;">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-info-circle text-info mr-3 fa-lg"></i>
                            <div>
                                @if (isWizard)
                                {
                                    <text><strong>Registro de mantenimiento en flujo.</strong> Los campos marcados con <span class="text-danger font-weight-bold">*</span> son obligatorios para avanzar.<br/>
                                    El <strong>Técnico Responsable</strong> es obligatorio porque la fase L-3 Salida necesita saber quién recibe el equipo.</text>
                                }
                                else
                                {
                                    <text><strong>Registro inicial de mantenimiento.</strong> Solo los campos marcados con <span class="text-danger font-weight-bold">*</span> son obligatorios para crear el registro.<br/>
                                    Los campos con <span class="badge badge-light border text-muted ml-1">Kardex</span> se completan después en la fase <strong>Concluir Mantenimiento (Kardex)</strong>.</text>
                                }
                            </div>
                        </div>
                    </div>
                    
                    <input type="hidden" name="isWizard" value="@isWizard.ToString().ToLower()" />
                    <input type="hidden" asp-for="ManagementPlanId" />

                    <div class="bg-light p-4 rounded mb-4 border-left border-warning" style="border-left-width: 4px;">
                        <h5 class="text-dark font-weight-bold mb-3"><i class="fas fa-microchip mr-2 text-warning"></i>Contexto del Servicio</h5>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="Input.FacultyId" class="control-label font-weight-bold small text-uppercase text-muted">Facultad <span class="text-danger">*</span></label>
                                    @if (isWizard)
                                    {
                                        <select asp-for="Input.FacultyId" class="form-control custom-select" asp-items="ViewBag.FacultyId" id="facultySelector" disabled>
                                            <option value="">-- Seleccione Facultad --</option>
                                        </select>
                                        <input type="hidden" asp-for="Input.FacultyId" />
                                    }
                                    else
                                    {
                                        <select asp-for="Input.FacultyId" class="form-control custom-select" asp-items="ViewBag.FacultyId" id="facultySelector" required>
                                            <option value="">-- Seleccione Facultad --</option>
                                        </select>
                                    }
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="Input.LaboratoryId" class="control-label font-weight-bold small text-uppercase text-muted">Laboratorio <span class="text-danger">*</span></label>
                                    @if (isWizard)
                                    {
                                        <select asp-for="Input.LaboratoryId" class="form-control custom-select" asp-items="ViewBag.LaboratoryId" id="labSelector" disabled>
                                            <option value="">-- Seleccione Laboratorio --</option>
                                        </select>
                                        <input type="hidden" asp-for="Input.LaboratoryId" />
                                    }
                                    else
                                    {
                                        <select asp-for="Input.LaboratoryId" class="form-control custom-select" asp-items="ViewBag.LaboratoryId" id="labSelector" required>
                                            <option value="">-- Seleccione Laboratorio --</option>
                                        </select>
                                    }
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="Input.EquipmentUnitId" class="control-label font-weight-bold small text-uppercase text-muted">Unidad Física <span class="text-danger">*</span></label>
                                    @if (isWizard)
                                    {
                                        <select asp-for="Input.EquipmentUnitId" class="form-control custom-select" asp-items="ViewBag.EquipmentUnitId" id="unitSelector" disabled>
                                            <option value="">-- Seleccione Equipo --</option>
                                        </select>
                                        <input type="hidden" asp-for="Input.EquipmentUnitId" />
                                    }
                                    else
                                    {
                                        <select asp-for="Input.EquipmentUnitId" class="form-control custom-select" asp-items="ViewBag.EquipmentUnitId" id="unitSelector" required>
                                            <option value="">-- Seleccione Equipo --</option>
                                        </select>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="row">
                             <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="Input.MaintenanceType" class="control-label font-weight-bold small text-uppercase text-muted">Tipo de Mantenimiento <span class="text-danger">*</span></label>
                                    @if (isWizard)
                                    {
                                        <select class="form-control custom-select bg-light font-weight-bold" disabled>
                                            <option selected>Preventivo</option>
                                        </select>
                                        <input type="hidden" asp-for="Input.MaintenanceType" value="1" />
                                    }
                                    else
                                    {
                                        <select asp-for="Input.MaintenanceType" class="form-control custom-select" asp-items="ViewBag.MaintenanceType" required>
                                            <option value="">-- Categoría --</option>
                                        </select>
                                        <span asp-validation-for="Input.MaintenanceType" class="text-danger small"></span>
                                    }
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    @if (isWizard)
                                    {
                                        <label asp-for="Input.TechnicianId" class="control-label font-weight-bold small text-uppercase text-muted">Técnico Responsable <span class="text-danger">*</span></label>
                                        <select asp-for="Input.TechnicianId" class="form-control custom-select" asp-items="ViewBag.TechnicianId" required>
                                            <option value="">-- Seleccione Técnico --</option>
                                        </select>
                                        <span asp-validation-for="Input.TechnicianId" class="text-danger small"></span>
                                    }
                                    else
                                    {
                                        <label asp-for="Input.TechnicianId" class="control-label font-weight-bold small text-uppercase text-muted">Técnico Responsable <span class="badge badge-light border text-muted ml-1">Kardex</span></label>
                                        <select asp-for="Input.TechnicianId" class="form-control custom-select" asp-items="ViewBag.TechnicianId">
                                            <option value="">-- Asignar Técnico --</option>
                                        </select>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-md-12">
                                <div class="form-group mb-0">
                                    <label class="control-label font-weight-bold small text-uppercase text-muted">Solicitud Técnica Relacionada (L-7)</label>
                                    <input type="hidden" asp-for="Input.RequestId" />
                                    @if (Model.Input.RequestId.HasValue)
                                    {
                                        <div class="p-2 rounded" style="background:#f5f3ff; border: 1px solid #ddd6fe;">
                                            <div class="d-flex align-items-center">
                                                <div class="mr-3" style="color: #7c3aed;"><i class="fas fa-file-invoice fa-lg"></i></div>
                                                <div>
                                                    <h6 class="m-0 font-weight-bold" style="color: #5b21b6;">Solicitud L-7 Vinculada</h6>
                                                    <span class="small" style="color: #7c3aed;">Req ID: @Model.Input.RequestId.Value</span>
                                                </div>
                                                <a href="/Requests/Details/@Model.Input.RequestId.Value?isWizard=true" target="_blank" class="btn btn-sm btn-light rounded-pill font-weight-bold shadow-sm ml-auto" style="color: #7c3aed; border: 1px solid #ddd6fe;">
                                                    Ver Detalles <i class="fas fa-external-link-alt ml-1"></i>
                                                </a>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="p-2 rounded bg-light border">
                                            <span class="text-muted small font-weight-bold"><i class="fas fa-info-circle mr-1"></i>Mantenimiento directo (Sin L-7)</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-lg-7">
                            <h5 class="text-dark font-weight-bold mb-3"><i class="far fa-calendar-alt mr-2 text-info"></i>Planificación Temporal</h5>
                            <div class="card border mb-4 shadow-none">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6 border-right">
                                            <div class="form-group">
                                                <label asp-for="Input.ScheduledDate" class="control-label font-weight-bold small text-uppercase text-muted">Fecha Programada <span class="text-danger">*</span></label>
                                                <input asp-for="Input.ScheduledDate" class="form-control" type="date" />
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group mb-3">
                                                <label asp-for="Input.StartDate" class="control-label font-weight-bold small text-uppercase text-muted">Inicio Real <span class="badge badge-light border text-muted ml-1">Kardex</span></label>
                                                <input asp-for="Input.StartDate" class="form-control" type="datetime-local" />
                                            </div>
                                            <div class="form-group mb-0">
                                                <label asp-for="Input.EndDate" class="control-label font-weight-bold small text-uppercase text-muted">Finalización <span class="badge badge-light border text-muted ml-1">Kardex</span></label>
                                                <input asp-for="Input.EndDate" class="form-control" type="datetime-local" />
                                                <span asp-validation-for="Input.EndDate" class="text-danger small"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-5">
                            <h5 class="text-dark font-weight-bold mb-3"><i class="fas fa-thermometer-half mr-2 text-danger"></i>Estado Final</h5>
                            <div class="card bg-light border-0 mb-4 shadow-none">
                                <div class="card-body">
                                    <div class="form-group mb-3">
                                        <label asp-for="Input.Status" class="control-label font-weight-bold small text-uppercase text-muted">Estado del Proceso</label>
                                        <select asp-for="Input.Status" class="form-control custom-select border-warning font-weight-bold text-dark"
                                                asp-items="@Proyecto_Laboratorios_Univalle.Helpers.EnumHelper.GetStatusSelectList<MaintenanceStatus>()"
                                                id="statusSelector">
                                        </select>
                                    </div>
                                    <p class="text-muted small mb-0"><i class="fas fa-info-circle mr-1"></i> Defina si el equipo está reparado o requiere mayor intervención.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card border mb-4 shadow-none">
                        <div class="card-header bg-white d-flex align-items-center border-bottom-0 pt-4 px-4">
                            <h5 class="text-dark font-weight-bold mb-0"><i class="fas fa-tasks mr-2 text-primary"></i>Lista de Verificación Técnica (L-48) <span class="badge badge-light border text-muted ml-1">Kardex</span></h5>
                            <button type="button" class="btn btn-sm btn-outline-primary btn-rounded ml-auto font-weight-bold" onclick="addTask()">
                                <i class="fas fa-plus mr-1"></i> Agregar Tarea
                            </button>
                        </div>
                        <div class="card-body px-4 pt-2">
                            <div class="row align-items-center">
                                <div class="col-md-7 border-right">
                                    <div id="tasksContainer">
                                        @for (int i = 0; i < Model.Input.Tasks.Count; i++)
                                        {
                                            <div class="task-row mb-2 d-flex align-items-center p-2 rounded hover-light">
                                                <div class="custom-control custom-checkbox flex-grow-1">
                                                    <input type="checkbox" class="custom-control-input maintenance-check" id="chk_@i"
                                                           name="Input.Tasks[@i].IsCompleted" value="true" onchange="calculatePercentage()"
                                                           @(Model.Input.Tasks[i].IsCompleted ? "checked" : "")>
                                                    <label class="custom-control-label font-weight-bold" for="chk_@i"></label>
                                                    <input type="text" name="Input.Tasks[@i].Description" value="@Model.Input.Tasks[i].Description"
                                                           class="form-control form-control-sm task-desc-input font-weight-bold ml-2"
                                                           placeholder="Descripción de la tarea..." required />
                                                </div>
                                                <button type="button" class="btn btn-sm btn-link text-danger p-0 ml-2" onclick="removeTask(this)">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="col-md-5 text-center px-4">
                                    <h6 class="text-muted text-uppercase font-weight-bold mb-3">Avance del Mantenimiento</h6>
                                    <h2 id="displayProgressText" class="display-4 font-weight-bold text-primary mb-2">0%</h2>
                                    <div class="progress rounded-pill shadow-sm" style="height: 12px;">
                                        <div id="visualProgressBar" class="progress-bar bg-primary progress-bar-striped progress-bar-animated" role="progressbar" style="width: 0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <input type="hidden" asp-for="Input.CompletionPercentage" id="hiddenPercentageInput" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Input.Description" class="control-label font-weight-bold text-dark">Descripción del Trabajo Realizado / Observaciones Técnicas <span class="badge badge-light border text-muted ml-1">Kardex</span></label>
                        <textarea asp-for="Input.Description" id="descriptionInput" class="form-control rounded" rows="3" placeholder="Detalle las fallas encontradas y las soluciones aplicadas..."></textarea>
                        <span asp-validation-for="Input.Description" class="text-danger small"></span>
                    </div>

                    <div class="card border shadow-none mb-4">
                        <div class="card-header bg-white d-flex align-items-center border-bottom-0 pt-4 px-4">
                            <h5 class="text-dark font-weight-bold mb-0"><i class="fas fa-file-invoice-dollar mr-2 text-success"></i>Control de Costos y Repuestos <span class="badge badge-light border text-muted ml-1">Kardex</span></h5>
                            <button type="button" id="btnAddCost" class="btn btn-sm btn-success btn-rounded shadow-sm ml-auto font-weight-bold px-3" onclick="addRow()">
                                <i class="fas fa-plus mr-1"></i> Agregar Ítem
                            </button>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover v-middle mb-0" id="costsTable">
                                    <thead class="bg-light text-uppercase small font-weight-bold text-muted">
                                        <tr>
                                            <th class="pl-4" style="width: 30%">Concepto</th>
                                            <th style="width: 20%">Categoría</th>
                                            <th style="width: 10%" class="text-center">Cant.</th>
                                            <th style="width: 15%" class="text-center">Unitario (Bs)</th>
                                            <th style="width: 15%" class="text-center">Subtotal</th>
                                            <th style="width: 10%"></th>
                                        </tr>
                                    </thead>
                                    <tbody id="costsContainer">
                                        <!-- Rows injected by JS -->
                                    </tbody>
                                    <tfoot>
                                        <tr class="bg-light">
                                            <td colspan="4" class="text-right font-weight-bold text-dark py-3">COSTO TOTAL DEL SERVICIO:</td>
                                            <td class="text-center font-weight-bold text-success h5 py-3 mb-0" id="totalDisplay">Bs 0.00</td>
                                            <td></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                            <input type="hidden" asp-for="Input.ActualCost" id="hiddenActualCost" />
                        </div>
                    </div>

                    <div class="row" id="completedOptionsBlock" style="display:none;">
                        <div class="col-md-6">
                            <div class="form-group mb-4">
                                <label asp-for="Input.SuggestedNextMaintenanceDate" class="control-label font-weight-bold small text-uppercase text-muted">Fecha Sugerida Próximo Mantenimiento <span class="badge badge-light border text-muted ml-1">Kardex</span></label>
                                <input asp-for="Input.SuggestedNextMaintenanceDate" class="form-control" type="date" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-4">
                                <label asp-for="Input.SatisfactionLevel" class="control-label font-weight-bold small text-uppercase text-muted">Nivel de Satisfacción <span class="badge badge-light border text-muted ml-1">Kardex</span></label>
                                <div class="rating-stars text-warning h4 m-0" style="cursor: pointer;">
                                    <i class="far fa-star" data-value="1"></i>
                                    <i class="far fa-star" data-value="2"></i>
                                    <i class="far fa-star" data-value="3"></i>
                                    <i class="far fa-star" data-value="4"></i>
                                    <i class="far fa-star" data-value="5"></i>
                                    <input type="hidden" asp-for="Input.SatisfactionLevel" id="satisfactionInput" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Input.Recommendations" class="control-label font-weight-bold small text-uppercase text-muted">Recomendaciones Post-Servicio <span class="badge badge-light border text-muted ml-1">Kardex</span></label>
                        <textarea asp-for="Input.Recommendations" class="form-control" rows="2" placeholder="Ej: No forzar el mando, limpiar después de cada uso..."></textarea>
                    </div>

                    <hr />

                    <div class="form-actions text-right pb-4">
                        @if (isWizard)
                        {
                            <a asp-page="/Index" asp-route-ShowWizard="true" asp-route-Step="3" asp-route-ManagementId="@ViewData["ManagementId"]" class="btn btn-outline-secondary btn-rounded px-4 mr-2">Volver al Wizard</a>
                        }
                        else
                        {
                            <a asp-page="./Index" class="btn btn-outline-secondary btn-rounded px-4 mr-2">Cancelar</a>
                        }
                        <button type="button" id="btnSubmitMaintenance" class="btn btn-warning btn-rounded px-5 shadow-sm font-weight-bold text-dark" onclick="window.confirmMaintenanceSubmit()">
                            <i class="fas fa-save mr-1"></i> Registrar Mantenimiento
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@* Template para filas de tareas *@
<div style="display:none" id="taskTemplateContainer">
    <div class="task-row mb-2 d-flex align-items-center p-2 rounded hover-light">
        <div class="custom-control custom-checkbox flex-grow-1">
            <input type="checkbox" class="custom-control-input maintenance-check" id="chk_INDEX"
                   name="Input.Tasks[INDEX].IsCompleted" value="true" onchange="calculatePercentage()" disabled>
            <label class="custom-control-label font-weight-bold" for="chk_INDEX"></label>
            <input type="text" name="Input.Tasks[INDEX].Description" value=""
                   class="form-control form-control-sm task-desc-input font-weight-bold ml-2"
                   placeholder="Descripción de la tarea..." required disabled />
        </div>
        <button type="button" class="btn btn-sm btn-link text-danger p-0 ml-2" onclick="removeTask(this)">
            <i class="fas fa-trash-alt"></i>
        </button>
    </div>
</div>

@* Template para filas de costo *@
<table style="display:none">
    <tbody id="costTemplate">
        <tr class="cost-row">
            <td class="pl-4">
                <input name="Input.CostDetails[INDEX].Concept" class="form-control" placeholder="Nombre del repuesto o servicio" disabled />
            </td>
            <td>
                <select name="Input.CostDetails[INDEX].Category" class="form-control custom-select" asp-items="@categoryList" disabled>
                </select>
            </td>
            <td>
                <input name="Input.CostDetails[INDEX].Quantity" class="form-control text-center txt-qty" type="number" step="0.01" value="1" min="0" onchange="calculateTotals()" disabled />
            </td>
            <td>
                <input name="Input.CostDetails[INDEX].UnitPrice" class="form-control text-center txt-price" type="number" step="0.01" value="0.00" min="0" onchange="calculateTotals()" disabled />
            </td>
            <td class="text-center font-weight-bold txt-subtotal py-3 text-dark">Bs 0.00</td>
            <td class="text-center">
                <button type="button" class="btn btn-circle btn-sm btn-outline-danger" onclick="removeRow(this)" data-toggle="tooltip" title="Quitar">
                    <i class="fas fa-trash"></i>
                </button>
            </td>
        </tr>
    </tbody>
</table>



@section Scripts {
    <script>
        $(function () {
            "use strict";

            // Selectores cascada
            $('#facultySelector').change(function () {
                var facultyId = $(this).val();
                $('#labSelector').empty().append('<option value="">-- Seleccione Laboratorio --</option>');
                $('#unitSelector').empty().append('<option value="">-- Seleccione Equipo --</option>');
                if (!facultyId) return;

                $.get('?handler=LaboratoriesByFaculty&facultyId=' + facultyId, function (data) {
                    $.each(data, function (i, item) {
                        $('#labSelector').append('<option value="' + item.id + '">' + item.name + '</option>');
                    });
                });
            });

            $('#labSelector').change(function () {
                var labId = $(this).val();
                $('#unitSelector').empty().append('<option value="">-- Seleccione Equipo --</option>');
                if (!labId) return;

                $.get('?handler=UnitsByLab&laboratoryId=' + labId, function (data) {
                    $.each(data, function (i, item) {
                        $('#unitSelector').append('<option value="' + item.id + '">' + item.name + '</option>');
                    });
                });
            });

            // Si ya hay datos (por redirección del wizard o recarga) inicializar porcentajes
            calculatePercentage();

            function applyStatusLogic() {
                var status = $('#statusSelector').val();
                if (status == "2") {
                    $('#descriptionInput').prop('required', true);
                    $('#completedOptionsBlock').slideDown(300);
                } else {
                    $('#descriptionInput').prop('required', false);
                    $('#completedOptionsBlock').slideUp(300);
                }
            }

            $('#statusSelector').on('change', applyStatusLogic);
            applyStatusLogic();

            // Stars Rating Logic
            $('.rating-stars i').on('click', function() {
                var value = $(this).data('value');
                $('#satisfactionInput').val(value);
                $('.rating-stars i').each(function() {
                    if ($(this).data('value') <= value) {
                        $(this).removeClass('far').addClass('fas');
                    } else {
                        $(this).removeClass('fas').addClass('far');
                    }
                });
            });
            // Initial render for stars
            var initialValue = $('#satisfactionInput').val();
            if (initialValue) {
                $('.rating-stars i[data-value="'+initialValue+'"]').trigger('click');
            }

        });

        var isMaintSubmitting = false;

        window.confirmMaintenanceSubmit = function () {
            var form = document.getElementById('maintenanceForm');
            if (!form) {
                alert('No se pudo ubicar el formulario de mantenimiento.');
                return;
            }

            if (isMaintSubmitting) return;

            var status = $('#statusSelector').val();
            var percent = parseInt($('#hiddenPercentageInput').val()) || 0;

            if (status == "2" && percent !== 100) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        title: 'Mantenimiento Incompleto',
                        text: 'Para marcar el mantenimiento como Completado, el avance debe estar al 100%.',
                        icon: 'warning',
                        confirmButtonText: 'Entendido',
                        confirmButtonColor: '#f59e0b'
                    });
                } else {
                    alert('Para marcar el mantenimiento como Completado, el avance debe estar al 100%.');
                }
                return;
            }

            var techId = $('#Input_TechnicianId').val();
            var statusLabel = $('#statusSelector option:selected').text();
            var techLabel = techId ? $('#Input_TechnicianId option:selected').text() : 'Sin asignar';

            var detailsHtml = '<div class="text-left mt-3 small">' +
                '<div class="d-flex justify-content-between py-1 border-bottom"><span class="text-muted">Estado:</span><span class="font-weight-bold">' + statusLabel + '</span></div>' +
                '<div class="d-flex justify-content-between py-1 border-bottom"><span class="text-muted">Técnico:</span><span class="font-weight-bold">' + techLabel + '</span></div>' +
                '<div class="d-flex justify-content-between py-1"><span class="text-muted">Avance:</span><span class="font-weight-bold">' + percent + '%</span></div>' +
                '</div>';

            var submitForm = function () {
                isMaintSubmitting = true;
                $('#btnSubmitMaintenance').prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Guardando...');
                HTMLFormElement.prototype.submit.call(form);
            };

            if (typeof Swal === 'undefined') {
                submitForm();
                return;
            }

            Swal.fire({
                title: '¿Confirmar registro de mantenimiento?',
                html: detailsHtml,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: '<i class="fas fa-save mr-1"></i> Registrar',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#f59e0b',
                cancelButtonColor: '#6c757d'
            }).then(function(result) {
                if (result && (result.isConfirmed === true || result.value === true)) {
                    submitForm();
                }
            });
        };

        // --- LÓGICA DE CHECKBOXES (PORCENTAJE L-48 DINÁMICO) ---
        function calculatePercentage() {
            const checkboxes = $('#tasksContainer .maintenance-check');
            const totalTasks = checkboxes.length;
            const completedTasks = checkboxes.filter(':checked').length;
            const percentage = totalTasks > 0 ? Math.round((completedTasks / totalTasks) * 100) : 0;

            $('#displayProgressText').text(percentage + '%');
            $('#visualProgressBar').css('width', percentage + '%').attr('aria-valuenow', percentage);
            $('#hiddenPercentageInput').val(percentage);
            
            // Actualizar color de barra basado en avance
            if(percentage < 50) $('#visualProgressBar').removeClass('bg-success bg-warning').addClass('bg-primary');
            else if(percentage < 100) $('#visualProgressBar').removeClass('bg-success bg-primary').addClass('bg-warning');
            else $('#visualProgressBar').removeClass('bg-warning bg-primary').addClass('bg-success');
        }

        function addTask() {
            const container = $('#tasksContainer');
            const template = $('#taskTemplateContainer').html();
            const index = container.children().length;

            const newRow = template.replace(/INDEX/g, index);
            container.append(newRow);
            container.children().last().find('input, select, textarea').prop('disabled', false);
            calculatePercentage();
        }

        function removeTask(btn) {
            $(btn).closest('.task-row').fadeOut(200, function () {
                $(this).remove();
                reindexTasks();
                calculatePercentage();
            });
        }

        function reindexTasks() {
            $('#tasksContainer .task-row').each(function (i) {
                $(this).find('input').each(function () {
                    const name = $(this).attr('name');
                    if (name) {
                        $(this).attr('name', name.replace(/Tasks\[\d+\]/, `Tasks[${i}]`));
                    }
                    const id = $(this).attr('id');
                    if (id && id.startsWith('chk_')) {
                        $(this).attr('id', `chk_${i}`);
                    }
                });
                $(this).find('label').each(function () {
                    const forAttr = $(this).attr('for');
                    if (forAttr && forAttr.startsWith('chk_')) {
                        $(this).attr('for', `chk_${i}`);
                    }
                });
            });
        }

        // --- LÓGICA DE COSTOS ---
        function addRow() {
            const container = $('#costsContainer');
            const template = $('#costTemplate').html();
            const index = container.children().length;

            const newRow = template.replace(/\[INDEX\]/g, `[${index}]`);
            container.append(newRow);
            container.children().last().find('input, select, textarea').prop('disabled', false);
        }

        function removeRow(btn) {
            const rows = $('#costsContainer tr').length;
            if (rows <= 1) {
                // No eliminar la última fila, solo limpiarla
                const row = $(btn).closest('tr');
                row.find('input').val('');
                row.find('.txt-qty').val('1');
                row.find('.txt-price').val('0.00');
                calculateTotals();
                return;
            }

            $(btn).closest('tr').fadeOut(200, function () {
                $(this).remove();
                reindexRows();
                calculateTotals();
            });
        }

        function reindexRows() {
            $('#costsContainer tr').each(function (i) {
                $(this).find('input, select').each(function () {
                    const name = $(this).attr('name');
                    if (name) {
                        $(this).attr('name', name.replace(/\[\d+\]/, `[${i}]`));
                    }
                });
            });
        }

        function calculateTotals() {
            let totalGeneral = 0;
            $('#costsContainer tr').each(function () {
                const qty = parseFloat($(this).find('.txt-qty').val()) || 0;
                const price = parseFloat($(this).find('.txt-price').val()) || 0;
                const subtotal = qty * price;

                $(this).find('.txt-subtotal').text('Bs ' + subtotal.toLocaleString('es-BO', { minimumFractionDigits: 2 }));
                totalGeneral += subtotal;
            });

            $('#totalDisplay').text('Bs ' + totalGeneral.toLocaleString('es-BO', { minimumFractionDigits: 2 }));
            $('#hiddenActualCost').val(totalGeneral.toFixed(2));
        }
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
