@page
@using Proyecto_Laboratorios_Univalle.Models.Enums
@model Proyecto_Laboratorios_Univalle.Pages.Maintenances.EditModel

@{
    var categoryList = Html.GetEnumSelectList<CostCategory>();
    bool isWizard = (bool)(ViewData["IsWizard"] ?? false);
    int currentPhaseInt = (int)(ViewData["CurrentPhaseInt"] ?? 3);
    int? prevPhaseId = (int?)ViewData["PreviousPhaseId"];
    int? planId = (int?)ViewData["ManagementPlanId"];
}

<div class="row justify-content-center">
    <div class="col-lg-12">
        @if (isWizard)
        {
            await Html.RenderPartialAsync("_WizardSteps", currentPhaseInt);
        }
        <div class="card shadow-sm border-0 overflow-hidden">
            <div class="card-header bg-dark p-4">
                <div class="d-flex no-block align-items-center">
                    <div>
                        <h4 class="card-title text-white font-weight-bold mb-0">Actualizar Servicio Técnico #@Model.Input.Id</h4>
                        <h6 class="card-subtitle text-white-50 mb-0">Gestión de parámetros técnicos, checklists L-48 y control de costos.</h6>
                    </div>
                    <div class="ml-auto">
                        <a asp-page="/EquipmentUnits/Kardex" asp-route-id="@Model.Input.EquipmentUnitId" class="btn btn-sm btn-outline-light btn-rounded">
                            <i class="fas fa-history mr-1"></i> Ver Kardex del Equipo
                        </a>
                    </div>
                </div>
            </div>
            
            <div class="card-body p-0">
                <!-- TABS NAVIGATION -->
                <ul class="nav nav-tabs customtab px-4 pt-3" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active font-weight-bold small uppercase" data-toggle="tab" href="#tab-general" role="tab">
                            <i class="fas fa-info-circle mr-2"></i> 1. Diagnóstico e Info
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link font-weight-bold small uppercase" data-toggle="tab" href="#tab-tecnico" role="tab">
                            <i class="fas fa-tools mr-2"></i> 2. Ejecución L-48
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link font-weight-bold small uppercase" data-toggle="tab" href="#tab-costos" role="tab">
                            <i class="fas fa-file-invoice-dollar mr-2"></i> 3. Costos y Repuestos
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link font-weight-bold small uppercase" data-toggle="tab" href="#tab-cierre" role="tab">
                            <i class="fas fa-check-double mr-2"></i> 4. Cierre y Evaluación
                        </a>
                    </li>
                </ul>

                <form method="post" id="maintenanceForm" class="tab-content p-4" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm border-0 mb-4"></div>
                    <input type="hidden" asp-for="Input.Id" />
                    <input type="hidden" asp-for="Input.ActualCost" id="hiddenActualCost" />
                    <input type="hidden" asp-for="Input.CompletionPercentage" id="hiddenPercentageInput" />
                    <input type="hidden" name="isWizard" value="@isWizard.ToString().ToLower()" />
                    <input type="hidden" name="ManagementPlanId" value="@planId" />
                    <input type="hidden" asp-for="FocusPlanId" />

                    <!-- TAB 1: GENERAL -->
                    <div class="tab-pane active" id="tab-general" role="tabpanel">
                        <div class="row">
                            <div class="col-md-8 border-right">
                                <h5 class="text-dark font-weight-bold mb-3 small uppercase text-info">Datos de Ubicación y Equipo</h5>
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="control-label font-weight-bold small text-muted uppercase">Facultad / Laboratorio</label>
                                            <div class="p-2 bg-light rounded border text-dark font-weight-bold">
                                                <i class="fas fa-university mr-2 text-muted"></i> @(ViewBag.LaboratoryId?.SelectedValue != null ? "Laboratorio Seleccionado" : "Datos Cargados")
                                            </div>
                                            <input type="hidden" asp-for="Input.FacultyId" />
                                            <input type="hidden" asp-for="Input.LaboratoryId" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="control-label font-weight-bold small text-muted uppercase">Equipo Objetivo</label>
                                            <div class="p-2 bg-light rounded border text-dark font-weight-bold">
                                                <i class="fas fa-box mr-2 text-muted"></i> Unidad #@Model.Input.EquipmentUnitId
                                            </div>
                                            <input type="hidden" asp-for="Input.EquipmentUnitId" />
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="Input.MaintenanceType" class="control-label font-weight-bold small uppercase text-muted">Categoría de Servicio</label>
                                            <select asp-for="Input.MaintenanceType" class="form-control custom-select" asp-items="ViewBag.MaintenanceType" required></select>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="Input.TechnicianId" class="control-label font-weight-bold small uppercase text-muted">Técnico Responsable</label>
                                            <select asp-for="Input.TechnicianId" class="form-control custom-select" asp-items="ViewBag.TechnicianId">
                                                <option value="">-- Asignar Técnico --</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label asp-for="Input.Description" class="control-label font-weight-bold text-dark uppercase small">Descripción del Trabajo</label>
                                    <textarea asp-for="Input.Description" class="form-control" rows="3" required></textarea>
                                </div>
                            </div>
                            
                            <div class="col-md-4">
                                <h5 class="text-dark font-weight-bold mb-3 small uppercase text-info">Estado y Tiempos</h5>
                                <div class="form-group mb-4">
                                    <label asp-for="Input.Status" class="control-label font-weight-bold small uppercase text-muted">Situación del Proceso</label>
                                    <select asp-for="Input.Status" class="form-control custom-select border-warning font-weight-bold" id="statusSelector"
                                            asp-items="@Proyecto_Laboratorios_Univalle.Helpers.EnumHelper.GetStatusSelectList<MaintenanceStatus>()">
                                    </select>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="Input.ScheduledDate" class="control-label font-weight-bold small uppercase text-muted">Fecha Programada</label>
                                    <input asp-for="Input.ScheduledDate" class="form-control" type="date" />
                                </div>
                                <div class="form-group mb-3">
                                    <label asp-for="Input.StartDate" class="control-label font-weight-bold small uppercase text-muted">Inicio Real</label>
                                    <input asp-for="Input.StartDate" class="form-control" type="datetime-local" />
                                </div>
                                <div class="form-group">
                                    <label asp-for="Input.EndDate" class="control-label font-weight-bold small uppercase text-muted">Finalización</label>
                                    <input asp-for="Input.EndDate" class="form-control" type="datetime-local" />
                                </div>
                            </div>
                        </div>
                        
                        <div class="mt-4 text-right">
                            <button type="button" class="btn btn-info btn-rounded px-4" onclick="$('a[href=\'#tab-tecnico\']').tab('show')">
                                Siguiente: Ejecución <i class="fas fa-arrow-right ml-1"></i>
                            </button>
                        </div>
                    </div>

                    <!-- TAB 2: TECNICO (L-48) -->
                    <div class="tab-pane" id="tab-tecnico" role="tabpanel">
                        <div class="row align-items-center">
                            <div class="col-md-7 border-right">
                                <div class="d-flex align-items-center mb-4">
                                    <h5 class="text-dark font-weight-bold mb-0"><i class="fas fa-tasks mr-2 text-primary"></i>Tareas de Verificación Técnica L-48</h5>
                                    <button type="button" class="btn btn-sm btn-outline-primary btn-rounded font-weight-bold ml-auto" onclick="addTask()">
                                        <i class="fas fa-plus mr-1"></i> Agregar Tarea
                                    </button>
                                </div>
                                <div class="bg-light p-4 rounded mb-4">
                                    <div id="tasksContainer">
                                        @for (int i = 0; i < Model.Input.Tasks.Count; i++)
                                        {
                                            <div class="task-row mb-2 d-flex align-items-center p-2 rounded bg-white border">
                                                <input type="hidden" name="Input.Tasks[@i].Id" value="@Model.Input.Tasks[i].Id" />
                                                <div class="custom-control custom-checkbox mr-2">
                                                    <input type="checkbox" class="custom-control-input maintenance-check" id="taskChk_@i" name="Input.Tasks[@i].IsCompleted" value="true" onchange="calculatePercentage()" @(Model.Input.Tasks[i].IsCompleted ? "checked" : "") />
                                                    <label class="custom-control-label" for="taskChk_@i"></label>
                                                </div>
                                                <input type="text" name="Input.Tasks[@i].Description" value="@Model.Input.Tasks[i].Description" class="form-control form-control-sm font-weight-bold task-desc" placeholder="Descripción de la tarea L-48" required />
                                                <button type="button" class="btn btn-sm btn-link text-danger ml-2 p-0" onclick="removeTask(this)" title="Quitar tarea">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-5 text-center p-5">
                                <div class="progress-circle mx-auto mb-4" style="width: 200px; height: 200px;">
                                    <h2 id="displayProgressText" class="display-4 font-weight-bold text-primary" style="line-height: 200px;">0%</h2>
                                </div>
                                <h6 class="text-muted text-uppercase font-weight-bold mb-0">Progreso de Tareas L-48</h6>
                            </div>
                        </div>
                        <div class="mt-4 d-flex justify-content-between">
                            <button type="button" class="btn btn-outline-secondary btn-rounded px-4" onclick="$('a[href=\'#tab-general\']').tab('show')">
                                <i class="fas fa-arrow-left mr-1"></i> Anterior
                            </button>
                            <button type="button" class="btn btn-info btn-rounded px-4" onclick="$('a[href=\'#tab-costos\']').tab('show')">
                                Siguiente: Costos <i class="fas fa-arrow-right ml-1"></i>
                            </button>
                        </div>
                    </div>

                    <!-- TAB 3: COSTOS -->
                    <div class="tab-pane" id="tab-costos" role="tabpanel">
                        <div class="d-flex align-items-center mb-4">
                            <h5 class="text-dark font-weight-bold mb-0"><i class="fas fa-file-invoice-dollar mr-2 text-success"></i>Detalle de Gastos y Repuestos</h5>
                            <button type="button" class="btn btn-sm btn-success btn-rounded shadow-sm ml-auto font-weight-bold px-3" onclick="addRow()">
                                <i class="fas fa-plus mr-1"></i> Agregar Ítem
                            </button>
                        </div>
                        
                        <div class="table-responsive border rounded mb-4">
                            <table class="table table-hover v-middle mb-0" id="costsTable">
                                <thead class="bg-light text-uppercase small font-weight-bold text-muted">
                                    <tr>
                                        <th class="pl-4" style="width: 35%">Concepto / Repuesto</th>
                                        <th style="width: 20%">Categoría</th>
                                        <th style="width: 10%" class="text-center">Cant.</th>
                                        <th style="width: 15%" class="text-center">P. Unit (Bs)</th>
                                        <th style="width: 15%" class="text-center">Subtotal</th>
                                        <th style="width: 5%"></th>
                                    </tr>
                                </thead>
                                <tbody id="costsContainer">
                                    @if (Model.Input.CostDetails != null)
                                    {
                                        for (int i = 0; i < Model.Input.CostDetails.Count; i++)
                                        {
                                            <tr class="cost-row">
                                                <input type="hidden" name="Input.CostDetails[@i].Id" value="@Model.Input.CostDetails[i].Id" />
                                                <td class="pl-4">
                                                    <input name="Input.CostDetails[@i].Concept" class="form-control" value="@Model.Input.CostDetails[i].Concept" required />
                                                </td>
                                                <td>
                                                    <select name="Input.CostDetails[@i].Category" class="form-control custom-select" asp-items="@categoryList" asp-for="@Model.Input.CostDetails[i].Category"></select>
                                                </td>
                                                <td>
                                                    <input name="Input.CostDetails[@i].Quantity" class="form-control text-center txt-qty" type="number" step="0.01" value="@Model.Input.CostDetails[i].Quantity.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" min="0" onchange="calculateTotals()" required />
                                                </td>
                                                <td>
                                                    <input name="Input.CostDetails[@i].UnitPrice" class="form-control text-center txt-price" type="number" step="0.01" value="@Model.Input.CostDetails[i].UnitPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" min="0" onchange="calculateTotals()" required />
                                                </td>
                                                <td class="text-center font-weight-bold txt-subtotal py-3 text-dark">Bs @Model.Input.CostDetails[i].Subtotal.ToString("N2")</td>
                                                <td class="text-center">
                                                    <button type="button" class="btn btn-link text-danger p-0" onclick="removeRow(this)"><i class="fas fa-trash-alt"></i></button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="bg-light">
                                        <td colspan="4" class="text-right font-weight-bold text-dark py-3 uppercase small">Inversión Total Realizada:</td>
                                        <td class="text-center font-weight-bold text-success h5 py-3 mb-0" id="totalDisplay">Bs 0.00</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <div class="mt-4 d-flex justify-content-between">
                            <button type="button" class="btn btn-outline-secondary btn-rounded px-4" onclick="$('a[href=\'#tab-tecnico\']').tab('show')">
                                <i class="fas fa-arrow-left mr-1"></i> Anterior
                            </button>
                            <button type="button" class="btn btn-info btn-rounded px-4" onclick="$('a[href=\'#tab-cierre\']').tab('show')">
                                Siguiente: Cierre <i class="fas fa-arrow-right ml-1"></i>
                            </button>
                        </div>
                    </div>

                    <!-- TAB 4: CIERRE -->
                    <div class="tab-pane" id="tab-cierre" role="tabpanel">
                        <div class="row">
                            <div class="col-md-6 border-right">
                                <h5 class="text-dark font-weight-bold mb-4"><i class="fas fa-comment-medical mr-2 text-warning"></i>Evaluación y Sugerencias</h5>
                                <div class="form-group mb-4">
                                    <label asp-for="Input.SatisfactionLevel" class="control-label font-weight-bold small uppercase text-muted">Nivel de Satisfacción Final</label>
                                    <div class="d-flex align-items-center bg-light p-3 rounded">
                                        <i class="fas fa-star fa-2x text-warning mr-3"></i>
                                        <select asp-for="Input.SatisfactionLevel" class="form-control custom-select font-weight-bold"
                                                asp-items="Html.GetEnumSelectList<MaintenanceSatisfaction>()">
                                            <option value="">-- Sin evaluar --</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label asp-for="Input.Recommendations" class="control-label font-weight-bold small uppercase text-muted">Recomendaciones Técnicas</label>
                                    <textarea asp-for="Input.Recommendations" class="form-control" rows="4" placeholder="Ej: Realizar limpieza de filtros cada 3 meses..."></textarea>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <h5 class="text-dark font-weight-bold mb-4"><i class="fas fa-clipboard-list mr-2 text-info"></i>Notas Internas de Auditoría</h5>
                                <div class="form-group">
                                    <label asp-for="Input.Observations" class="control-label font-weight-bold small uppercase text-muted">Observaciones Finales</label>
                                    <textarea asp-for="Input.Observations" class="form-control" rows="4" placeholder="Detalles técnicos adicionales para el departamento..."></textarea>
                                </div>
                                
                                <div id="finalReviewCard" class="alert alert-info border-0 shadow-sm mt-4">
                                    <h6 class="font-weight-bold mb-2 uppercase small"><i class="fas fa-info-circle mr-1"></i> Revisión Final</h6>
                                    <p class="small mb-0">Al marcar como <strong>Completado</strong>, se generará la alerta para la fase de salida del equipo.</p>
                                </div>
                            </div>
                        </div>

                        <div class="mt-5 d-flex justify-content-between border-top pt-4">
                            @{
                                var returnUrlEdit = ViewData["ReturnUrl"]?.ToString();
                            }
                            @if (returnUrlEdit == "Details")
                            {
                                <a asp-page="./Details" asp-route-id="@Model.Input.Id" asp-route-isWizard="@isWizard" asp-route-managementId="@ViewData["ManagementId"]" asp-route-focusPlanId="@Model.FocusPlanId" class="btn btn-outline-secondary btn-rounded px-4 font-weight-bold">
                                    <i class="fas fa-arrow-left mr-1"></i> Cancelar
                                </a>
                            }
                            else
                            {
                                <a asp-page="./Index" class="btn btn-outline-secondary btn-rounded px-4 font-weight-bold">
                                    <i class="fas fa-arrow-left mr-1"></i> Cancelar
                                </a>
                            }
                            <div>
                                <button type="submit" asp-page-handler="Draft" id="btnDraftMaintenance" formnovalidate class="btn btn-outline-info btn-rounded px-4 shadow-sm font-weight-bold mr-2">
                                    <i class="fas fa-save mr-2"></i> Guardar Borrador
                                </button>
                                <button type="button" class="btn btn-warning btn-rounded px-5 shadow-sm font-weight-bold text-white" onclick="confirmUpdate()">
                                    <i class="fas fa-save mr-2"></i> Actualizar Registro Final
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- TEMPLATE PARA COSTOS -->
<table style="display:none">
    <tbody id="costTemplate">
        <tr class="cost-row">
            <input type="hidden" name="Input.CostDetails[INDEX].Id" value="0" />
            <td class="pl-4">
                <input name="Input.CostDetails[INDEX].Concept" class="form-control" required placeholder="Nuevo concepto..." />
            </td>
            <td>
                <select name="Input.CostDetails[INDEX].Category" class="form-control custom-select" asp-items="categoryList"></select>
            </td>
            <td>
                <input name="Input.CostDetails[INDEX].Quantity" class="form-control text-center txt-qty" type="number" step="0.01" value="1" min="0" onchange="calculateTotals()" required />
            </td>
            <td>
                <input name="Input.CostDetails[INDEX].UnitPrice" class="form-control text-center txt-price" type="number" step="0.01" value="0.00" min="0" onchange="calculateTotals()" required />
            </td>
            <td class="text-center font-weight-bold txt-subtotal py-3 text-dark">Bs 0.00</td>
            <td class="text-center">
                <button type="button" class="btn btn-link text-danger p-0" onclick="removeRow(this)"><i class="fas fa-trash-alt"></i></button>
            </td>
        </tr>
    </tbody>
</table>

@section Styles {
    <style>
        .customtab .nav-link { border: none; color: #747d8c; padding: 15px 25px; transition: all 0.3s ease; border-bottom: 2px solid transparent; }
        .customtab .nav-link.active { color: #2962ff; background: transparent; border-bottom: 2px solid #2962ff; }
        .progress-circle { border: 15px solid #f8f9fa; border-top: 15px solid #2962ff; border-radius: 50%; }
        .uppercase { text-transform: uppercase; letter-spacing: 0.8px; }
        .custom-control-lg .custom-control-label::before, .custom-control-lg .custom-control-label::after { top: 0.1rem; left: -2rem; width: 1.5rem; height: 1.5rem; }
        .custom-control-lg { padding-left: 2.5rem; }
    </style>
}

@section Scripts {
    <script src="~/assets/extra-libs/jqbootstrapvalidation/validation.js"></script>
    <script src="~/assets/libs/sweetalert2/dist/sweetalert2.all.min.js"></script>
    <script>
        $(function () {
            "use strict";
            calculatePercentage();
            calculateTotals();

            // Link Start/End Dates
            $('#Input_StartDate').on('change', function() {
                $('#Input_EndDate').attr('min', $(this).val());
            });

            // Draft button handler
            $('#btnDraftMaintenance').on('click', function(e) {
                e.preventDefault();
                var form = $('#maintenanceForm');
                form.attr('action', '?handler=Draft');
                if (typeof Swal === 'undefined') { form.submit(); return; }
                Swal.fire({
                    title: '¿Guardar borrador L-8?',
                    text: 'Se guardará el progreso sin avanzar de fase. Podrá continuar después.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, guardar borrador',
                    cancelButtonText: 'Cancelar',
                    confirmButtonColor: '#17a2b8',
                    cancelButtonColor: '#6c757d'
                }).then(function(result) {
                    if (result && (result.isConfirmed === true || result.value === true)) {
                        form.data('confirmed', true);
                        HTMLFormElement.prototype.submit.call(form[0]);
                    }
                });
            });
        });

        function calculatePercentage() {
            const checkboxes = $('.maintenance-check');
            const completed = checkboxes.filter(':checked').length;
            const total = checkboxes.length;
            const percentage = total > 0 ? Math.round((completed / total) * 100) : 0;

            $('#displayProgressText').text(percentage + '%');
            $('#hiddenPercentageInput').val(percentage);

            // Actualizar color del circulo si es 100
            if(percentage === 100) $('.progress-circle').css('border-color', '#28a745');
            else $('.progress-circle').css('border-top-color', '#2962ff');
        }

        function addTask() {
            const container = $('#tasksContainer');
            const index = container.children('.task-row').length;
            const row = `
                <div class="task-row mb-2 d-flex align-items-center p-2 rounded bg-white border">
                    <input type="hidden" name="Input.Tasks[${index}].Id" value="0" />
                    <div class="custom-control custom-checkbox mr-2">
                        <input type="checkbox" class="custom-control-input maintenance-check" id="taskChk_${index}" name="Input.Tasks[${index}].IsCompleted" value="true" onchange="calculatePercentage()" />
                        <label class="custom-control-label" for="taskChk_${index}"></label>
                    </div>
                    <input type="text" name="Input.Tasks[${index}].Description" value="" class="form-control form-control-sm font-weight-bold task-desc" placeholder="Descripción de la tarea L-48" required />
                    <button type="button" class="btn btn-sm btn-link text-danger ml-2 p-0" onclick="removeTask(this)" title="Quitar tarea">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                </div>
            `;
            container.append(row);
        }

        function removeTask(btn) {
            $(btn).closest('.task-row').remove();
            reindexTasks();
            calculatePercentage();
        }

        function reindexTasks() {
            $('#tasksContainer .task-row').each(function (index) {
                $(this).find('input').each(function () {
                    const name = $(this).attr('name');
                    if (name) $(this).attr('name', name.replace(/Input\.Tasks\[\d+\]/, 'Input.Tasks[' + index + ']'));
                    const id = $(this).attr('id');
                    if (id && id.startsWith('taskChk_')) $(this).attr('id', 'taskChk_' + index);
                });
                $(this).find('label').each(function () {
                    const forAttr = $(this).attr('for');
                    if (forAttr && forAttr.startsWith('taskChk_')) $(this).attr('for', 'taskChk_' + index);
                });
            });
        }

        function addRow() {
            const container = $('#costsContainer');
            const template = $('#costTemplate').html();
            const index = container.children().length;
            const newRow = template.replace(/\[INDEX\]/g, `[${index}]`);
            container.append(newRow);
        }

        function removeRow(btn) {
            $(btn).closest('tr').remove();
            calculateTotals();
        }

        function calculateTotals() {
            let total = 0;
            $('.cost-row').each(function() {
                const qty = parseFloat($(this).find('.txt-qty').val()) || 0;
                const price = parseFloat($(this).find('.txt-price').val()) || 0;
                const sub = qty * price;
                $(this).find('.txt-subtotal').text('Bs ' + sub.toLocaleString('es-BO', { minimumFractionDigits: 2 }));
                total += sub;
            });
            $('#totalDisplay').text('Bs ' + total.toLocaleString('es-BO', { minimumFractionDigits: 2 }));
            $('#hiddenActualCost').val(total.toFixed(2));
        }

        function confirmUpdate() {
            const status = $('#statusSelector').val();
            const progress = $('#hiddenPercentageInput').val();

            if (status == "2" && progress < 100) {
                Swal.fire('Atención', 'No se puede completar el mantenimiento si el progreso técnico (L-48) no es del 100%.', 'warning');
                return;
            }

            Swal.fire({
                title: '¿Confirmar cambios?',
                text: 'Se actualizarán los datos técnicos y económicos del servicio.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Sí, guardar',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#2962ff'
            }).then((result) => {
                if (result && (result.isConfirmed === true || result.value === true)) {
                    $('#maintenanceForm').attr('action', '');
                    $('#maintenanceForm').data('confirmed', true);
                    HTMLFormElement.prototype.submit.call($('#maintenanceForm')[0]);
                }
            });
        }
    </script>
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
