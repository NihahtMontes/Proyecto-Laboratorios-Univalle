@page
@model Proyecto_Laboratorios_Univalle.Pages.Schedules.IndexModel
@using Proyecto_Laboratorios_Univalle.Models.Enums
@{
    ViewData["Title"] = "Cronograma de Intervenciones (L-48)";
    var hasActiveFilters = Model.LabFilterId.HasValue
        || Model.CategoryFilterId.HasValue
        || Model.TechFilterId.HasValue
        || !string.IsNullOrWhiteSpace(Model.StatusFilter);
}

<div class="row mb-4">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h4 class="card-title font-weight-bold mb-3">Filtros del cronograma</h4>
                <form method="get" data-live-filter-form>
                    <div class="d-flex flex-wrap align-items-center border-top pt-3">
                        <select asp-for="LabFilterId" asp-items="Model.LabFList" class="custom-select btn-rounded w-auto mw-100 mr-2 mb-2" aria-label="Laboratorio" data-live-filter-control>
                            <option value="">Laboratorio</option>
                        </select>
                        <select asp-for="CategoryFilterId" asp-items="Model.CategoryFList" class="custom-select btn-rounded w-auto mw-100 mr-2 mb-2" aria-label="Categoría de equipo" data-live-filter-control>
                            <option value="">Categoría de equipo</option>
                        </select>
                        <select asp-for="TechFilterId" asp-items="Model.TechFList" class="custom-select btn-rounded w-auto mw-100 mr-2 mb-2" aria-label="Técnico interno" data-live-filter-control>
                            <option value="">Técnico interno</option>
                        </select>
                        <select asp-for="StatusFilter" class="custom-select btn-rounded w-auto mw-100 mr-2 mb-2" aria-label="Estado o proveedor" data-live-filter-control>
                            <option value="">Estado o proveedor</option>
                            <optgroup label="Tipo">
                                <option value="Externo">Solo proveedor externo</option>
                            </optgroup>
                            <optgroup label="Estados">
                                <option value="Pending">Pendiente</option>
                                <option value="InProgress">En proceso</option>
                                <option value="Completed">Terminado</option>
                                <option value="Canceled">Cancelado</option>
                            </optgroup>
                        </select>

                        @if (hasActiveFilters)
                        {
                            <a asp-page="./Index" class="btn btn-link btn-sm text-muted mb-2" title="Limpiar filtros">
                                <i class="fas fa-times mr-1"></i> Limpiar filtros
                            </a>
                        }

                        <span class="small text-muted ml-auto mb-2" aria-live="polite">
                            <strong class="text-dark">@Model.ManagementPlans.Count</strong> intervención(es)
                        </span>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h4 class="card-title font-weight-bold">Cronograma de Mantenimientos</h4>
                <div class="table-responsive mt-3">
                    <table class="table table-hover">
                        <thead class="bg-light">
                            <tr>
                                <th>Fecha Planificada</th>
                                <th>Equipo / Inventario</th>
                                <th>Ubicación</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var plan in Model.ManagementPlans)
                            {
                                <tr>
                                    <td>@(plan.PlannedDate?.ToString("dd/MM/yyyy") ?? "No planificado")</td>
                                    <td>@plan.EquipmentUnit?.Equipment?.Name<br/><small class="text-muted">#@plan.EquipmentUnit?.InventoryNumber</small></td>
                                    <td>@plan.EquipmentUnit?.Laboratory?.Name</td>
                                    <td>@plan.PlanStatus</td>
                                    <td>
                                        <!-- TODO UI: Add View details link / button -->
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
