@page
@model Proyecto_Laboratorios_Univalle.Pages.Schedules.IndexModel
@using Proyecto_Laboratorios_Univalle.Models.Enums
@{
    ViewData["Title"] = "Cronograma de Intervenciones (L-48)";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h4 class="card-title font-weight-bold">Filtros Avanzados</h4>
                <form method="get" class="row">
                    <div class="col-md-3">
                        <label>Laboratorio</label>
                        <select asp-for="LabFilterId" asp-items="Model.LabFList" class="form-control">
                            <option value="">-- Todos --</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label>Categoría Equipo</label>
                        <select asp-for="CategoryFilterId" asp-items="Model.CategoryFList" class="form-control">
                            <option value="">-- Todas --</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label>Técnico (Interno)</label>
                        <select asp-for="TechFilterId" asp-items="Model.TechFList" class="form-control">
                            <option value="">-- Todos --</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label>Estado / Proveedor</label>
                        <select asp-for="StatusFilter" class="form-control">
                            <option value="">-- Todos --</option>
                            <optgroup label="Tipo">
                                <option value="Externo">Solo Proveedor Externo</option>
                            </optgroup>
                            <optgroup label="Estados">
                                <option value="Pending">Pendiente</option>
                                <option value="InProgress">En Proceso</option>
                                <option value="Completed">Terminado</option>
                                <option value="Canceled">Cancelado</option>
                            </optgroup>
                        </select>
                    </div>
                    <div class="col-md-12 mt-3 text-right">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-filter"></i> Filtrar</button>
                        <a asp-page="./Index" class="btn btn-outline-secondary">Limpiar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h4 class="card-title font-weight-bold">Cronograma de Mantenimientos</h4>
                <div class="table-responsive mt-3">
                    <table class="table table-hover">
                        <thead class="bg-light">
                            <tr>
                                <th>Fecha Planificada</th>
                                <th>Equipo / Inventario</th>
                                <th>Ubicación</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var plan in Model.ManagementPlans)
                            {
                                <tr>
                                    <td>@(plan.PlannedDate?.ToString("dd/MM/yyyy") ?? "No planificado")</td>
                                    <td>@plan.EquipmentUnit?.Equipment?.Name<br/><small class="text-muted">#@plan.EquipmentUnit?.InventoryNumber</small></td>
                                    <td>@plan.EquipmentUnit?.Laboratory?.Name</td>
                                    <td>@plan.PlanStatus</td>
                                    <td>
                                        <!-- TODO UI: Add View details link / button -->
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
