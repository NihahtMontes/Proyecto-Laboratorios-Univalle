@page
@model Proyecto_Laboratorios_Univalle.Pages.Docente.DisponibilidadModel
@using System.Globalization
@{
    ViewData["Title"] = "Consultar disponibilidad";
    ViewData["Section"] = "Portal docente";
    ViewData["HidePageTitle"] = true;
    var es = new CultureInfo("es-BO");
}

@section Styles {
    <link href="~/css/docente.css" rel="stylesheet" asp-append-version="true" />
}

<div class="page-breadcrumb">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h4 class="page-title text-uppercase font-weight-bold mb-0" style="color:#7460ee;">PORTAL DOCENTE</h4>
            <h2 class="font-weight-bold text-dark mb-0">Consultar disponibilidad</h2>
            <div class="text-muted small">Mira qué laboratorios están libres un día o en toda una semana académica, y cuánto material queda libre en un horario, antes de solicitar.</div>
        </div>
        <div class="col-md-4 text-md-right mt-2 mt-md-0">
            <div class="btn-group" role="group" aria-label="Tipo de vista" id="dv-view">
                <a asp-page="./Disponibilidad" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")"
                   class="btn btn-sm @(Model.View == "dia" ? "text-white" : "btn-light border")" style="@(Model.View == "dia" ? "background:#7460ee;" : null)"><i class="far fa-calendar mr-1"></i>Por día</a>
                <a asp-page="./Disponibilidad" asp-route-view="semana" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")"
                   class="btn btn-sm @(Model.View == "semana" ? "text-white" : "btn-light border")" style="@(Model.View == "semana" ? "background:#7460ee;" : null)"><i class="fas fa-calendar-week mr-1"></i>Por semana académica</a>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid mt-3">
@if (Model.View == "semana")
{
    @if (Model.Week == null)
    {
        <div class="card border-0 shadow-sm" style="border-radius:16px;"><div class="card-body dc-empty">
            <i class="far fa-calendar-times"></i>
            <div class="font-weight-bold text-dark">La gestión todavía no tiene calendario académico.</div>
        </div></div>
    }
    else
    {
        var week = Model.Week;
        var prev = Model.Weeks.LastOrDefault(w => w.Number < week.Number);
        var next = Model.Weeks.FirstOrDefault(w => w.Number > week.Number);
        <form method="get" class="card border-0 shadow-sm mb-3" style="border-radius:16px;" id="dv-week-form">
            <div class="card-body py-3">
                <input type="hidden" name="view" value="semana" />
                <div class="form-row align-items-end">
                    <div class="col-md-5 mb-2">
                        <label class="small font-weight-bold text-uppercase text-muted mb-1" for="week">Semana académica</label>
                        <div class="d-flex">
                            @if (prev != null)
                            {
                                <a asp-route-view="semana" asp-route-week="@prev.Number" asp-route-labId="@Model.LabId" class="btn btn-light border mr-1" title="Semana anterior" aria-label="Semana anterior"><i class="fas fa-chevron-left"></i></a>
                            }
                            <select class="custom-select" id="week" name="week" onchange="this.form.submit()">
                                @foreach (var w in Model.Weeks)
                                {
                                    <option value="@w.Number" selected="@(w.Number == week.Number)">@w.Label</option>
                                }
                            </select>
                            @if (next != null)
                            {
                                <a asp-route-view="semana" asp-route-week="@next.Number" asp-route-labId="@Model.LabId" class="btn btn-light border ml-1" title="Semana siguiente" aria-label="Semana siguiente"><i class="fas fa-chevron-right"></i></a>
                            }
                        </div>
                    </div>
                    <div class="col-md-5 mb-2">
                        <label class="small font-weight-bold text-uppercase text-muted mb-1" for="labId">Laboratorio</label>
                        <select class="custom-select" id="labId" name="labId" onchange="this.form.submit()">
                            <option value="">Todos los laboratorios</option>
                            @foreach (var l in Model.LabOptions)
                            {
                                <option value="@l.Id" selected="@(l.Id == Model.LabId)">@l.Label</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="dc-legend mt-1">
                    <span><i style="background:#f1f5f9;"></i>Libre</span>
                    <span><i style="background:#fde2e7;"></i>Ocupado (práctica)</span>
                    <span><i style="background:#e2f6fa;"></i>Práctica libre (cupo de estudiantes)</span>
                    <span><i style="background:#f3f1fe; border:1px dashed #b9aef5;"></i>No ocupa / pendiente</span>
                    <span><i style="height:6px; border-radius:999px; background:repeating-linear-gradient(90deg,#ffe9cc,#ffe9cc 5px,#f0cf9a 5px,#f0cf9a 7px);"></i>Limpieza 10 min</span>
                    <span><i style="background:#f8f9fa;"></i>Día no hábil</span>
                    <span><i style="background:#e8f8f4;"></i>Tus prácticas</span>
                    <span><i style="background:#cfe8ff;"></i>Tu solicitud en revisión</span>
                </div>
                <div class="small text-muted mt-2"><i class="fas fa-hand-pointer mr-1"></i>Toca una celda libre para solicitar ese horario, o una tuya para abrirla. Lo ocupado es lo mismo que ve el administrador.</div>
            </div>
        </form>

        @foreach (var lab in Model.WeekLabs)
        {
            <div class="card border-0 shadow-sm mb-3 dv-lab" style="border-radius:16px;" data-lab="@lab.Id">
                <div class="card-body">
                    <div class="d-flex flex-wrap align-items-center mb-2">
                        <h5 class="font-weight-bold text-dark mb-0"><i class="fas fa-flask mr-2" style="color:#7460ee;"></i>@lab.Code <small class="text-muted">@lab.Name</small></h5>
                        <span class="ml-auto small">
                            <span class="font-weight-bold @(lab.FreeCount > 0 ? "text-success" : "text-muted")">@lab.FreeCount periodos libres</span>
                            @if (lab.MineCount > 0) { <span class="text-muted"> · @lab.MineCount tuyos</span> }
                        </span>
                    </div>
                    <div class="table-responsive">
                        <table class="dc-grid dv-week" style="min-width:560px;">
                            <thead>
                                <tr>
                                    <th class="dc-grid__period">Periodo</th>
                                    @foreach (var d in lab.Days)
                                    {
                                        <th class="@(d.Enabled ? null : "text-muted")" title="@d.Note">
                                            @d.Date.ToString("ddd", es) <small class="d-block font-weight-normal">@d.Date.ToString("dd/MM")</small>
                                            @if (!d.Enabled) { <small class="d-block font-weight-normal text-danger text-truncate">@d.Note</small> }
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < Model.Periods.Count; i++)
                                {
                                    var period = Model.Periods[i];
                                    <tr>
                                        <th class="dc-grid__period">P@(period.Order)<small class="d-block text-muted font-weight-normal">@period.StartTime.ToString(@"hh\:mm")–@period.EndTime.ToString(@"hh\:mm")</small></th>
                                        @foreach (var d in lab.Days)
                                        {
                                            var cell = d.Cells[i];
                                            var label = cell.Label ?? DisponibilidadModel.CellLabel(cell.State);
                                            var title = cell.Title ?? label;
                                            @if (cell.State == "free" && Model.Window.Contains(d.Date))
                                            {
                                                <td class="dc-cell is-free p-0">
                                                    <a class="dv-link" asp-page="./NuevaSolicitud" asp-route-date="@d.Date.ToString("yyyy-MM-dd")" asp-route-startPeriodId="@cell.PeriodId" asp-route-labId="@lab.Id"
                                                       title="Solicitar @lab.Code el @d.Date.ToString("dd/MM") desde el periodo @period.Order">Libre</a>
                                                </td>
                                            }
                                            else if (cell.State is "mine" or "minepending" && cell.PlanningId is int planningId)
                                            {
                                                <td class="dc-cell is-@cell.State p-0">
                                                    <a class="dv-link" asp-page="./Solicitud" asp-route-id="@planningId" title="@title">@label</a>
                                                    @if (cell.Clean != null)
                                                    {
                                                        <span class="dc-cell__clean" title="Limpieza @cell.Clean (10 min)"></span>
                                                    }
                                                </td>
                                            }
                                            else
                                            {
                                                <td class="dc-cell is-@cell.State" style="cursor:default;" title="@(cell.State == "off" ? d.Note : title)">@label
                                                    @if (cell.Clean != null)
                                                    {
                                                        <span class="dc-cell__clean" title="Limpieza @cell.Clean (10 min)"></span>
                                                    }
                                                </td>
                                            }
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        @if (!Model.Window.IsOpen)
        {
            <div class="small text-muted"><i class="far fa-clock mr-1"></i>@Model.Window.ClosedReason</div>
        }
        else
        {
            <div class="small text-muted mb-4"><i class="far fa-clock mr-1"></i>Puedes solicitar @Model.Window.RangeText. Fuera de ese rango las celdas libres son solo informativas.</div>
        }
    }
}
else
{

    <form method="get" class="card border-0 shadow-sm mb-4" style="border-radius:16px;">
        <div class="card-body">
            <div class="form-row align-items-end">
                <div class="col-md-3 mb-2">
                    <label class="small font-weight-bold text-uppercase text-muted mb-1" for="date">Día</label>
                    <input type="date" class="form-control" id="date" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-3 mb-2">
                    <label class="small font-weight-bold text-uppercase text-muted mb-1" for="fromPeriodId">Desde el periodo</label>
                    <select class="custom-select" id="fromPeriodId" name="fromPeriodId">
                        @foreach (var p in Model.Periods)
                        {
                            <option value="@p.Id" selected="@(p.Id == Model.FromPeriodId)">P@(p.Order) · @p.StartTime.ToString(@"hh\:mm")</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 mb-2">
                    <label class="small font-weight-bold text-uppercase text-muted mb-1" for="periodCount">Periodos</label>
                    <select class="custom-select" id="periodCount" name="periodCount">
                        @for (var i = 1; i <= 6; i++)
                        {
                            <option value="@i" selected="@(i == Model.PeriodCount)">@i</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 mb-2">
                    <label class="small font-weight-bold text-uppercase text-muted mb-1" for="term">Artículo (opcional)</label>
                    <input type="search" class="form-control" id="term" name="term" value="@Model.Term" placeholder="Ej: batidora, bowl…" />
                </div>
                <div class="col-md-1 mb-2">
                    <button type="submit" class="btn btn-block text-white" style="background:#7460ee;" title="Consultar" aria-label="Consultar disponibilidad"><i class="fas fa-search"></i></button>
                </div>
            </div>
        </div>
    </form>

    <div class="card border-0 shadow-sm mb-4" style="border-radius:16px;">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center mb-3">
                <h5 class="font-weight-bold text-dark mb-0 text-capitalize"><i class="fas fa-th mr-2" style="color:#7460ee;"></i>Laboratorios el @Model.Date.ToString("dddd d 'de' MMMM", es)</h5>
                <div class="btn-group btn-group-sm ml-auto mt-2 mt-md-0">
                    <a asp-route-date="@Model.Date.AddDays(-1).ToString("yyyy-MM-dd")" asp-route-fromPeriodId="@Model.FromPeriodId" asp-route-periodCount="@Model.PeriodCount" asp-route-term="@Model.Term" class="btn btn-light border"><i class="fas fa-chevron-left"></i></a>
                    <a asp-route-date="@Model.Date.AddDays(1).ToString("yyyy-MM-dd")" asp-route-fromPeriodId="@Model.FromPeriodId" asp-route-periodCount="@Model.PeriodCount" asp-route-term="@Model.Term" class="btn btn-light border"><i class="fas fa-chevron-right"></i></a>
                </div>
            </div>
            @if (Model.DayNote != null)
            {
                <div class="alert alert-light border small"><i class="fas fa-info-circle mr-1"></i>@Model.DayNote</div>
            }
            <div class="table-responsive">
                <table class="dc-grid" style="min-width:820px;">
                    <thead>
                        <tr>
                            <th class="dc-grid__period" style="width:150px;">Laboratorio</th>
                            @foreach (var p in Model.Periods)
                            {
                                <th>P@(p.Order)<small class="d-block text-muted font-weight-normal">@p.StartTime.ToString(@"hh\:mm")</small></th>
                            }
                            <th style="width:70px;">Libres</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var lab in Model.Labs)
                        {
                            <tr>
                                <th class="dc-grid__period"><span class="text-dark">@lab.Code</span><small class="d-block text-muted text-truncate">@lab.Name</small></th>
                                @foreach (var cell in lab.Cells)
                                {
                                    var label = cell.State == "off" ? "Sin clases" : cell.Label ?? DisponibilidadModel.CellLabel(cell.State);
                                    var title = cell.Title ?? label;
                                    <td class="dc-cell is-@cell.State" style="cursor:default;" title="@title">@label
                                        @if (cell.Clean != null)
                                        {
                                            <span class="dc-cell__clean" title="Limpieza @cell.Clean (10 min)"></span>
                                        }
                                    </td>
                                }
                                <td class="text-center font-weight-bold @(lab.FreeCount > 0 ? "text-success" : "text-muted")">@lab.FreeCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="dc-legend mt-2">
                <span><i style="background:#f1f5f9;"></i>Libre</span>
                <span><i style="background:#fde2e7;"></i>Ocupado (práctica)</span>
                <span><i style="background:#e2f6fa;"></i>Práctica libre (cupo de estudiantes)</span>
                <span><i style="background:#f3f1fe; border:1px dashed #b9aef5;"></i>No ocupa / pendiente</span>
                <span><i style="height:6px; border-radius:999px; background:repeating-linear-gradient(90deg,#ffe9cc,#ffe9cc 5px,#f0cf9a 5px,#f0cf9a 7px);"></i>Limpieza 10 min</span>
                <span><i style="background:#f8f9fa;"></i>Día no hábil</span>
                <span><i style="background:#e8f8f4;"></i>Tus prácticas</span>
            </div>
            @if (Model.Window.Contains(Model.Date))
            {
                <div class="mt-3"><a asp-page="./NuevaSolicitud" class="btn btn-sm rounded-pill text-white px-3" style="background:#7460ee;"><i class="fas fa-plus mr-1"></i>Solicitar una práctica</a></div>
            }
            else
            {
                <div class="mt-3 small text-muted"><i class="far fa-clock mr-1"></i>Solo puedes solicitar @Model.Window.RangeText.</div>
            }
        </div>
    </div>

    @if (Model.Term != null)
    {
        <div class="card border-0 shadow-sm mb-4" style="border-radius:16px;">
            <div class="card-body">
                <h5 class="font-weight-bold text-dark mb-3"><i class="fas fa-box-open mr-2" style="color:#7460ee;"></i>Material libre en ese horario</h5>
                @if (Model.Articles.Count == 0)
                {
                    <div class="text-muted small">No encontramos artículos con “@Model.Term”.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="thead-light"><tr><th>Artículo</th><th class="text-center">Stock total</th><th class="text-center">En uso</th><th class="text-center">Libre</th></tr></thead>
                            <tbody>
                                @foreach (var a in Model.Articles)
                                {
                                    <tr>
                                        <td><span class="dc-light dc-light--@(a.Stock == null ? "secondary" : a.Free > 0 ? "success" : "danger")"></span><strong class="text-dark">@a.Name</strong> <small class="text-muted">@a.Code</small></td>
                                        <td class="text-center">@(a.Stock?.ToString("0.##") ?? "—")</td>
                                        <td class="text-center">@a.UsedByOthers.ToString("0.##")</td>
                                        <td class="text-center font-weight-bold">@(a.Free?.ToString("0.##") ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
}
</div>
