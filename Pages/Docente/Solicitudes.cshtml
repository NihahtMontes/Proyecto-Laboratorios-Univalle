@page
@model Proyecto_Laboratorios_Univalle.Pages.Docente.SolicitudesModel
@using System.Globalization
@using Proyecto_Laboratorios_Univalle.Pages.LaboratoryOperations
@{
    ViewData["Title"] = "Mis solicitudes";
    ViewData["Section"] = "Portal docente";
    ViewData["HidePageTitle"] = true;
    var es = new CultureInfo("es-BO");
    var today = DateTime.Today;
}

@section Styles {
    <link href="~/css/docente.css" rel="stylesheet" asp-append-version="true" />
}

<div class="page-breadcrumb">
    <div class="row align-items-center">
        <div class="col-md-7">
            <h4 class="page-title text-uppercase font-weight-bold mb-0" style="color:#7460ee;">PORTAL DOCENTE</h4>
            <h2 class="font-weight-bold text-dark mb-0">Mis solicitudes</h2>
            <div class="text-muted small">Sigue el estado de cada práctica que pediste.</div>
        </div>
        <div class="col-md-5 mt-3 mt-md-0">
            <form method="get" class="d-flex">
                <input type="hidden" name="tab" value="@Model.ActiveTab" />
                <div class="input-group">
                    <input type="search" name="q" value="@Model.Search" class="form-control" placeholder="Buscar por práctica, materia o código…" />
                    <div class="input-group-append"><button class="btn btn-light border" type="submit"><i class="fas fa-search"></i></button></div>
                </div>
                @if (Model.Window.IsOpen)
                {
                    <a asp-page="./NuevaSolicitud" class="btn text-white ml-2 text-nowrap rounded-pill px-3" style="background:#7460ee;"><i class="fas fa-plus mr-1"></i>Nueva</a>
                }
            </form>
        </div>
    </div>
</div>

<div class="container-fluid mt-3">
    <ul class="nav nav-pills mb-3 flex-wrap">
        @foreach (var tab in Model.Tabs)
        {
            var active = tab.Key == Model.ActiveTab;
            <li class="nav-item mr-2 mb-2">
                <a class="nav-link rounded-pill @(active ? "active" : "bg-white border")" asp-route-tab="@tab.Key" style="@(active ? "background:#7460ee;" : null)">
                    <i class="@tab.Icon mr-1"></i>@tab.Title
                    <span class="badge badge-pill @(active ? "badge-light" : $"badge-{tab.Css}") ml-1">@tab.Count</span>
                </a>
            </li>
        }
    </ul>

    <div class="card border-0 shadow-sm" style="border-radius:16px;">
        <div class="card-body p-0">
            @if (Model.Rows.Count == 0)
            {
                <div class="dc-empty">
                    <i class="far fa-folder-open" style="color:#7460ee;"></i>
                    <div class="font-weight-bold text-dark">No hay solicitudes en esta pestaña@(Model.Search != null ? " con ese texto" : "").</div>
                    @if (Model.ActiveTab == "revision" && Model.Window.IsOpen)
                    {
                        <a asp-page="./NuevaSolicitud" class="btn btn-sm rounded-pill text-white mt-3 px-3" style="background:#7460ee;">Solicitar una práctica</a>
                    }
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>Práctica</th>
                                <th>Fecha y hora</th>
                                <th>Laboratorio</th>
                                <th class="text-center">Material</th>
                                <th>Estado</th>
                                <th class="text-right"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Rows)
                            {
                                var code = L3Codes.Format(row.Id, row.Code);
                                var days = (row.Date.Date - today).Days;
                                Model.LastComment.TryGetValue(row.Id, out var comment);
                                <tr>
                                    <td>
                                        <a asp-page="./Solicitud" asp-route-id="@row.Id" class="font-weight-bold text-dark">@row.Practice</a>
                                        <div class="small text-muted">@code · @row.Subject · Gr. @row.Group</div>
                                        @if (!string.IsNullOrWhiteSpace(comment))
                                        {
                                            <div class="small mt-1 text-truncate" style="max-width:420px; color:#b26b00;"><i class="fas fa-comment-dots mr-1"></i>@comment</div>
                                        }
                                    </td>
                                    <td class="text-nowrap">
                                        <div class="text-capitalize">@row.Date.ToString("ddd d MMM", es)</div>
                                        <div class="small text-muted">@row.TimeText</div>
                                        @if (row.Status == Proyecto_Laboratorios_Univalle.Models.PlanningStatus.Approved && days >= 0 && days <= 7)
                                        {
                                            <span class="badge badge-light border small">@(days == 0 ? "Hoy" : days == 1 ? "Mañana" : $"En {days} días")</span>
                                        }
                                    </td>
                                    <td><strong>@row.LabCode</strong><div class="small text-muted">@row.LabName</div></td>
                                    <td class="text-center">@row.ItemCount</td>
                                    <td><span class="badge badge-pill badge-@row.StatusCss px-2 py-1"><i class="@row.StatusIcon mr-1"></i>@row.StatusText</span></td>
                                    <td class="text-right text-nowrap">
                                        @if (row.Status == Proyecto_Laboratorios_Univalle.Models.PlanningStatus.Observed && Model.Window.IsOpen)
                                        {
                                            <a asp-page="./NuevaSolicitud" asp-route-id="@row.Id" class="btn btn-sm rounded-pill text-white" style="background:#fb8c00;"><i class="fas fa-edit mr-1"></i>Corregir</a>
                                        }
                                        <a asp-page="./Solicitud" asp-route-id="@row.Id" class="btn btn-sm btn-light border rounded-pill"><i class="fas fa-eye"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
