@page
@model Proyecto_Laboratorios_Univalle.Pages.Docente.IndexModel
@using System.Globalization
@using Proyecto_Laboratorios_Univalle.Models
@using Proyecto_Laboratorios_Univalle.Pages.LaboratoryOperations
@{
    ViewData["Title"] = "Mi semana";
    ViewData["Section"] = "Portal docente";
    ViewData["HidePageTitle"] = true;
    var es = new CultureInfo("es-BO");
    var today = DateTime.Today;
    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Buenos días" : hour < 19 ? "Buenas tardes" : "Buenas noches";
}

@section Styles {
    <link href="~/css/docente.css" rel="stylesheet" asp-append-version="true" />
}

<div class="page-breadcrumb">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h4 class="page-title text-uppercase font-weight-bold mb-0" style="color:#7460ee;">PORTAL DOCENTE</h4>
            <h2 class="font-weight-bold text-dark mb-0">@greeting, @Model.Teacher.Name</h2>
            <div class="text-muted small">
                @if (Model.Window.IsOpen)
                {
                    <span><i class="far fa-calendar-check mr-1"></i>Gestión @Model.Window.ManagementCode · puedes solicitar prácticas @Model.Window.RangeText.</span>
                }
                else
                {
                    <span class="text-warning"><i class="fas fa-lock mr-1"></i>@Model.Window.ClosedReason</span>
                }
            </div>
        </div>
        <div class="col-md-4 text-md-right mt-3 mt-md-0">
            @if (Model.Window.IsOpen && Model.GroupCount > 0)
            {
                <a asp-page="./NuevaSolicitud" class="btn btn-lg rounded-pill px-4 shadow-sm text-white" style="background:#7460ee;">
                    <i class="fas fa-plus-circle mr-2"></i>Solicitar práctica
                </a>
            }
        </div>
    </div>
</div>

<div class="container-fluid mt-3">

    @if (Model.GroupCount == 0)
    {
        <div class="alert border-0 shadow-sm d-flex align-items-center mb-4" style="background:#fff8e8;">
            <i class="fas fa-users fa-lg text-warning mr-3"></i>
            <div><strong>No tienes grupos asignados en la gestión vigente.</strong> Pide al administrador que te asigne tus grupos en Materias para poder solicitar prácticas.</div>
        </div>
    }

    @if (Model.Observed > 0)
    {
        <a asp-page="./Solicitudes" asp-route-tab="observadas" class="alert border-0 shadow-sm d-flex align-items-center mb-4 text-decoration-none" style="background:#fff4e5;">
            <span class="dc-kpi__icon dc-soft-orange mr-3"><i class="fas fa-comment-dots"></i></span>
            <div class="flex-grow-1 text-dark">
                <strong>Tienes @Model.Observed solicitud(es) observada(s).</strong>
                <div class="small text-muted">El revisor dejó comentarios: corrígelas y reenvíalas para que puedan aprobarse.</div>
            </div>
            <span class="btn btn-sm rounded-pill text-white px-3" style="background:#fb8c00;">Revisar <i class="fas fa-arrow-right ml-1"></i></span>
        </a>
    }

    <div class="row">
        <!-- Próxima práctica -->
        <div class="col-lg-7 mb-4">
            @if (Model.Next != null)
            {
                var n = Model.Next;
                <div class="dc-hero p-4 h-100 shadow-sm">
                    <div class="position-relative" style="z-index:1;">
                        <div class="dc-hero__label mb-2"><i class="fas fa-bolt mr-1"></i>Tu próxima práctica</div>
                        <div class="dc-hero__title mb-1">@n.Practice</div>
                        <div class="mb-3" style="opacity:.9;">@n.Subject · Grupo @n.Group</div>
                        <div class="mb-3">
                            <span class="dc-chip"><i class="far fa-calendar"></i>@n.Date.ToString("dddd d 'de' MMMM", es)</span>
                            <span class="dc-chip"><i class="far fa-clock"></i>@n.TimeText</span>
                            <span class="dc-chip"><i class="fas fa-building"></i>@n.LabCode · @n.LabName</span>
                            <span class="dc-chip"><i class="fas fa-box-open"></i>@n.ItemCount artículo(s)</span>
                        </div>
                        <div class="d-flex flex-wrap align-items-end justify-content-between">
                            <div class="dc-countdown mb-2" id="countdown" data-start="@Model.NextStart!.Value.ToString("yyyy-MM-ddTHH:mm:ss")">
                                <div><b data-part="d">–</b><small>días</small></div>
                                <div><b data-part="h">–</b><small>horas</small></div>
                                <div><b data-part="m">–</b><small>min</small></div>
                            </div>
                            <div class="mb-2">
                                <a asp-page="./Solicitud" asp-route-id="@n.Id" class="btn btn-light rounded-pill px-3 mr-1"><i class="fas fa-eye mr-1"></i>Ver detalle</a>
                                <a asp-page="./Solicitud" asp-route-id="@n.Id" asp-page-handler="Ficha" class="btn btn-outline-light rounded-pill px-3" target="_blank"><i class="fas fa-file-pdf mr-1"></i>Ficha</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm h-100" style="border-radius:16px;">
                    <div class="card-body dc-empty d-flex flex-column justify-content-center">
                        <i class="far fa-calendar-plus" style="color:#7460ee;"></i>
                        <h5 class="font-weight-bold text-dark">No tienes prácticas aprobadas próximas</h5>
                        <p class="mb-3">Solicita una práctica: el sistema te sugiere horarios libres y revisa el material por ti.</p>
                        @if (Model.Window.IsOpen && Model.GroupCount > 0)
                        {
                            <div><a asp-page="./NuevaSolicitud" class="btn rounded-pill px-4 text-white" style="background:#7460ee;"><i class="fas fa-plus mr-1"></i>Solicitar práctica</a></div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Indicadores -->
        <div class="col-lg-5 mb-4">
            <div class="row h-100">
                <div class="col-6 mb-3">
                    <a asp-page="./Solicitudes" asp-route-tab="revision" class="dc-kpi h-100">
                        <span class="dc-kpi__icon dc-soft-primary"><i class="fas fa-hourglass-half"></i></span>
                        <div><div class="dc-kpi__value">@Model.InReview</div><div class="dc-kpi__label">En revisión</div></div>
                    </a>
                </div>
                <div class="col-6 mb-3">
                    <a asp-page="./Solicitudes" asp-route-tab="observadas" class="dc-kpi h-100">
                        <span class="dc-kpi__icon dc-soft-orange"><i class="fas fa-comment-dots"></i></span>
                        <div><div class="dc-kpi__value">@Model.Observed</div><div class="dc-kpi__label">Observadas</div></div>
                    </a>
                </div>
                <div class="col-6 mb-3">
                    <a asp-page="./Calendario" class="dc-kpi h-100">
                        <span class="dc-kpi__icon dc-soft-success"><i class="fas fa-check-circle"></i></span>
                        <div><div class="dc-kpi__value">@Model.Upcoming</div><div class="dc-kpi__label">Aprobadas próximas</div></div>
                    </a>
                </div>
                <div class="col-6 mb-3">
                    <a asp-page="./Solicitudes" asp-route-tab="realizadas" class="dc-kpi h-100">
                        <span class="dc-kpi__icon dc-soft-info"><i class="fas fa-flag-checkered"></i></span>
                        <div><div class="dc-kpi__value">@Model.Done</div><div class="dc-kpi__label">Realizadas</div></div>
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Programmed.Count > 0)
    {
        <!-- Prácticas del cronograma por solicitar -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius:16px;">
            <div class="card-body">
                <div class="d-flex flex-wrap align-items-center mb-3">
                    <h5 class="font-weight-bold text-dark mb-0 mr-3"><i class="fas fa-calendar-plus mr-2" style="color:#7460ee;"></i>Prácticas programadas por solicitar</h5>
                    <small class="text-muted">Según el cronograma de la gestión. Solicítalas con anticipación para asegurar laboratorio y material.</small>
                </div>
                <div class="list-group list-group-flush">
                    @foreach (var p in Model.Programmed)
                    {
                        <div class="list-group-item px-0 d-flex flex-wrap align-items-center">
                            <div class="mr-3 text-center" style="min-width:64px;">
                                <div class="font-weight-bold text-dark">@p.Date.ToString("dd/MM")</div>
                                <small class="text-muted text-capitalize">@p.Date.ToString("ddd", es)@(p.WeekNumber is int w ? $" · sem. {w}" : "")</small>
                            </div>
                            <div class="flex-grow-1">
                                <div class="font-weight-bold text-dark">@p.Practice</div>
                                <small class="text-muted">@p.Subject · Grupo @p.Group</small>
                            </div>
                            @if (p.InWindow)
                            {
                                <a asp-page="./NuevaSolicitud" asp-route-scheduleId="@p.ScheduleId" class="btn btn-sm text-white rounded-pill px-3" style="background:#7460ee;">
                                    <i class="fas fa-paper-plane mr-1"></i>Solicitar
                                </a>
                            }
                            else
                            {
                                <span class="badge badge-pill badge-light border px-3 py-2" title="Aún fuera del plazo para solicitar">Se habilita más adelante</span>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Semana -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius:16px;">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center mb-3">
                <div>
                    <h5 class="font-weight-bold text-dark mb-0"><i class="far fa-calendar-alt mr-2" style="color:#7460ee;"></i>Mi semana</h5>
                    <small class="text-muted">@Model.WeekStart.ToString("d 'de' MMMM", es) al @Model.WeekStart.AddDays(5).ToString("d 'de' MMMM yyyy", es)</small>
                </div>
                <div class="ml-auto btn-group btn-group-sm mt-2 mt-md-0">
                    <a asp-page="./Index" asp-route-week="@Model.WeekStart.AddDays(-7).ToString("yyyy-MM-dd")" class="btn btn-light border" title="Semana anterior"><i class="fas fa-chevron-left"></i></a>
                    <a asp-page="./Index" class="btn btn-light border">Hoy</a>
                    <a asp-page="./Index" asp-route-week="@Model.WeekStart.AddDays(7).ToString("yyyy-MM-dd")" class="btn btn-light border" title="Semana siguiente"><i class="fas fa-chevron-right"></i></a>
                </div>
            </div>
            <div class="dc-week">
                @for (var i = 0; i < 6; i++)
                {
                    var day = Model.WeekStart.AddDays(i);
                    var items = Model.Week.Where(w => w.Date.Date == day).ToList();
                    <div class="dc-day @(day == today ? "is-today" : null)">
                        <div class="dc-day__head"><b>@day.ToString("ddd", es)</b><span>@day.Day</span></div>
                        <div class="dc-day__body">
                            @if (items.Count == 0)
                            {
                                <div class="dc-day__empty">Libre</div>
                            }
                            @foreach (var item in items)
                            {
                                <a asp-page="./Solicitud" asp-route-id="@item.Id" class="dc-event dc-event--@item.StatusCss" title="@item.StatusText">
                                    <div class="dc-event__time">@item.TimeText</div>
                                    <div class="text-truncate">@item.Practice</div>
                                    <div class="text-muted text-truncate">@item.LabCode · Gr. @item.Group</div>
                                    <span class="badge badge-pill badge-@item.StatusCss mt-1" style="font-size:.6rem;">@item.StatusText</span>
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Novedades -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius:16px;">
        <div class="card-body">
            <h5 class="font-weight-bold text-dark mb-3"><i class="fas fa-list-ul mr-2" style="color:#7460ee;"></i>Novedades de tus solicitudes</h5>
            @if (Model.News.Count == 0)
            {
                <div class="text-muted small">Aún no hay revisiones. Cuando el revisor apruebe, observe o rechace una solicitud aparecerá aquí.</div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var news in Model.News)
                    {
                        var (icon, css, text) = news.Action switch
                        {
                            PlanningReviewAction.Approved => ("fas fa-check-circle", "success", "fue aprobada"),
                            PlanningReviewAction.ApprovedWithChanges => ("fas fa-clipboard-check", "success", "fue aprobada con cambios"),
                            PlanningReviewAction.Observed => ("fas fa-comment-dots", "orange", "tiene observaciones"),
                            PlanningReviewAction.Rejected => ("fas fa-times-circle", "danger", "fue rechazada"),
                            _ => ("fas fa-info-circle", "secondary", "se actualizó")
                        };
                        <a asp-page="./Solicitud" asp-route-id="@news.PlanningId" class="list-group-item list-group-item-action d-flex align-items-start px-0">
                            <span class="dc-kpi__icon dc-soft-@css" style="width:38px;height:38px;"><i class="@icon"></i></span>
                            <div class="flex-grow-1">
                                <div class="text-dark"><strong>@L3Codes.Format(news.PlanningId, news.Code)</strong> · @news.Practice <span class="text-muted">@text</span></div>
                                @if (!string.IsNullOrWhiteSpace(news.Comment))
                                {
                                    <div class="small text-muted text-truncate" style="max-width:720px;">“@news.Comment”</div>
                                }
                            </div>
                            <small class="text-muted ml-2 text-nowrap">@Proyecto_Laboratorios_Univalle.Helpers.BoliviaTime.ToLocal(news.Date).ToString("dd/MM HH:mm")</small>
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var box = document.getElementById('countdown');
            if (!box) return;
            var start = new Date(box.getAttribute('data-start'));
            function tick() {
                var diff = Math.max(0, start - new Date());
                var d = Math.floor(diff / 86400000), h = Math.floor(diff / 3600000) % 24, m = Math.floor(diff / 60000) % 60;
                box.querySelector('[data-part=d]').textContent = d;
                box.querySelector('[data-part=h]').textContent = h;
                box.querySelector('[data-part=m]').textContent = m;
            }
            tick();
            setInterval(tick, 30000);
        })();
    </script>
}
