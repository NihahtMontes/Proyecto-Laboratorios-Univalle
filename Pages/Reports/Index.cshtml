@page
@model Proyecto_Laboratorios_Univalle.Pages.Reports.IndexModel
@{
    ViewData["Title"] = "Centro de Reportes Oficiales";
}

<div class="d-flex justify-content-between align-items-center mb-4" style="font-family: 'Inter', sans-serif;">
    <div>
        <h3 class="wizard-title text-dark mb-1" style="font-weight: 900; color: #0f172a !important;">Centro de Reportes Oficiales</h3>
        <p class="wizard-subtitle mb-0" style="font-weight: 500; color: #64748b;">Panel central para exportación de actas y formularios de laboratorio.</p>
    </div>
</div>

<section class="section dashboard" style="font-family: 'Inter', sans-serif;">
    <!-- FILTRO DE LABORATORIO -->
    <div class="card premium-card border-0 mb-4 shadow-sm" style="border-radius: 16px; background: #ffffff; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
        <div class="card-body p-4">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h5 class="card-title p-0 m-0" style="font-weight: 800; color: #1e293b; border-bottom: none;">
                        <i class="fas fa-filter text-primary mr-2"></i> Selecciona un Laboratorio
                    </h5>
                    <p class="text-muted small mt-1 mb-0" style="font-weight: 500;">Elige un ambiente para ver sus equipos y descargar reportes individuales o consolidados.</p>
                </div>
                <div class="col-md-6 text-right">
                    <form method="get" class="d-flex align-items-center justify-content-end gap-3">
                        <input type="hidden" asp-for="ManagementId" />
                        <select asp-for="SelectedLabId" asp-items="Model.LaboratoriesList" class="form-control shadow-sm input-group-custom w-100" style="border-radius: 12px; background-color: #f8fafc; border: 1.5px solid #e2e8f0; font-weight: 600; color: #334155; padding: 8px 12px; height: 48px; outline: none; transition: box-shadow 0.2s; max-width: 350px;" onchange="this.form.submit()">
                            <option value="">-- Todos los Laboratorios --</option>
                        </select>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (Model.SelectedLabId.HasValue && Model.SelectedLaboratory != null)
    {
        <!-- CONSOLIDADOS DEL LABORATORIO -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 style="font-weight: 800; color: #334155; font-size: 1.2rem;" class="m-0">
                <i class="fas fa-flask text-primary mr-2"></i> Equipos en @Model.SelectedLaboratory.Name
            </h4>
            <div class="d-flex gap-2">
                <a href="/api/reports/download/l6?labId=@Model.SelectedLabId" class="btn btn-login-glow text-white font-weight-bold px-4 rounded-pill shadow-sm" style="background: linear-gradient(to right, #10b981, #059669); border: none; font-size: 0.9rem;">
                    <i class="fas fa-file-excel mr-2"></i> Descargar L-6 Consolidado
                </a>
                <a href="/api/reports/download/l48?labId=@Model.SelectedLabId" class="btn btn-login-glow text-white font-weight-bold px-4 rounded-pill shadow-sm" style="background: linear-gradient(to right, #f59e0b, #d97706); border: none; font-size: 0.9rem;">
                    <i class="fas fa-project-diagram mr-2"></i> Plan L-48 (Gantt)
                </a>
            </div>
        </div>

        <!-- LISTA DE EQUIPOS -->
        <div class="step-stack">
            @if (!Model.EquipmentStatuses.Any())
            {
                <div class="border-2 border-dashed rounded p-5 text-center text-slate-400 bg-slate-50" style="border-radius: 12px !important; border: 2px dashed #cbd5e1;">
                    <i class="fas fa-inbox text-3xl mb-3 opacity-25" style="font-size: 3rem; color: #94a3b8;"></i><br>
                    <span style="font-weight: 500; color: #64748b;">No hay equipos registrados en este laboratorio.</span>
                </div>
            }
            else
            {
                <div class="bg-white p-0 rounded shadow-sm border-0" style="border-radius: 16px !important; overflow: hidden;">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 pixel-perfect-table" style="font-size: 0.9rem;">
                            <thead class="bg-primary text-white text-center">
                                <tr>
                                    <th style="width: 35%; padding: 15px;" class="text-left font-weight-bold">EQUIPO</th>
                                    <th style="width: 15%; padding: 15px;" class="font-weight-bold">N° INVENTARIO</th>
                                    <th style="width: 50%; padding: 15px;" class="font-weight-bold">REPORTES TÉCNICOS INDIVIDUALES</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var status in Model.EquipmentStatuses)
                                {
                                    var unit = status.Unit;
                                    var hasAny = status.HasL7 || status.HasL8 || status.HasL3 || status.HasAdquisicion;
                                    <tr style="border-bottom: 1px solid #f1f5f9;">
                                        <td class="text-left p-3">
                                            <div class="d-flex align-items-center">
                                                <div class="icon-box bg-light text-primary rounded-circle d-flex align-items-center justify-content-center mr-3 shadow-sm" style="width: 45px; height: 45px;">
                                                    <i class="fas fa-microscope" style="font-size: 1.1rem;"></i>
                                                </div>
                                                <div>
                                                    <h6 class="mb-0" style="font-weight: 800; color: #1e293b;">@unit.Equipment?.Name</h6>
                                                    <small class="text-muted" style="font-weight: 500;">@unit.Equipment?.Brand @unit.Equipment?.Model</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center p-3">
                                            <span class="badge" style="background-color: #f1f5f9; color: #475569; font-weight: 700; padding: 8px 12px; font-size: 0.85rem; border: 1px solid #e2e8f0;">@unit.InventoryNumber</span>
                                        </td>
                                        <td class="text-center p-3">
                                            @if (!hasAny)
                                            {
                                                <span class="text-muted small" style="font-weight: 500; font-style: italic;">
                                                    <i class="fas fa-info-circle mr-1"></i> Sin registros disponibles
                                                </span>
                                            }
                                            else
                                            {
                                                <div class="d-flex justify-content-center gap-2 flex-wrap">
                                                    @if (status.HasL7)
                                                    {
                                                        <a href="/api/reports/download/l7?unitId=@unit.Id"
                                                           class="btn btn-sm rounded-pill font-weight-bold shadow-sm px-3"
                                                           style="background-color: #e0e7ff; color: #4f46e5; border: 1px solid #c7d2fe; transition: all 0.2s;"
                                                           onmouseover="this.style.backgroundColor='#4f46e5'; this.style.color='white'"
                                                           onmouseout="this.style.backgroundColor='#e0e7ff'; this.style.color='#4f46e5'">
                                                            <i class="fas fa-file-signature mr-1"></i> L-7
                                                        </a>
                                                    }
                                                    @if (status.HasL8)
                                                    {
                                                        <a href="/api/reports/download/l8?unitId=@unit.Id"
                                                           class="btn btn-sm rounded-pill font-weight-bold shadow-sm px-3"
                                                           style="background-color: #dcfce7; color: #16a34a; border: 1px solid #bbf7d0; transition: all 0.2s;"
                                                           onmouseover="this.style.backgroundColor='#16a34a'; this.style.color='white'"
                                                           onmouseout="this.style.backgroundColor='#dcfce7'; this.style.color='#16a34a'">
                                                            <i class="fas fa-history mr-1"></i> L-8 Kardex
                                                        </a>
                                                    }
                                                    @if (status.HasL3)
                                                    {
                                                        <a href="/api/reports/download/l3?unitId=@unit.Id"
                                                           class="btn btn-sm rounded-pill font-weight-bold shadow-sm px-3"
                                                           style="background-color: #fee2e2; color: #dc2626; border: 1px solid #fecaca; transition: all 0.2s;"
                                                           onmouseover="this.style.backgroundColor='#dc2626'; this.style.color='white'"
                                                           onmouseout="this.style.backgroundColor='#fee2e2'; this.style.color='#dc2626'">
                                                            <i class="fas fa-sign-out-alt mr-1"></i> L-3 Salida
                                                        </a>
                                                    }
                                                    @if (status.HasAdquisicion)
                                                    {
                                                        <a href="/api/reports/download/adquisicion?unitId=@unit.Id"
                                                           class="btn btn-sm rounded-pill font-weight-bold shadow-sm px-3"
                                                           style="background-color: #e0f2fe; color: #0284c7; border: 1px solid #bae6fd; transition: all 0.2s;"
                                                           onmouseover="this.style.backgroundColor='#0284c7'; this.style.color='white'"
                                                           onmouseout="this.style.backgroundColor='#e0f2fe'; this.style.color='#0284c7'">
                                                            <i class="fas fa-shopping-cart mr-1"></i> Insumos
                                                        </a>
                                                    }
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    }
    else if (!Model.SelectedLabId.HasValue)
    {
        <!-- ESTADO INICIAL -->
        <div class="border-2 border-dashed rounded p-5 text-center bg-white shadow-sm mt-4" style="border-radius: 16px !important; border: 2px dashed #cbd5e1;">
            <div class="icon-box bg-light text-primary rounded-circle d-flex align-items-center justify-content-center mx-auto mb-4" style="width: 80px; height: 80px;">
                <i class="fas fa-file-excel" style="font-size: 2.5rem;"></i>
            </div>
            <h4 style="font-weight: 800; color: #1e293b;">Selecciona un Laboratorio</h4>
            <p style="font-weight: 500; color: #64748b; max-width: 500px; margin: 0 auto;">Para comenzar a descargar y administrar los reportes de Verificación (L-6), Mantenimiento (L-8) y más, elige un laboratorio en el menú superior.</p>
        </div>
    }
</section>
