@page "{id:int}"
@model Proyecto_Laboratorios_Univalle.Pages.Acquisitions.DetailsModel
@using Proyecto_Laboratorios_Univalle.Models.Enums

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
        <i class="fas fa-exclamation-triangle mr-2"></i> @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="row">
    <div class="col-lg-8 border-right">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <div class="d-flex no-block align-items-center mb-4 pb-3 border-bottom">
                    <div>
                        <h4 class="card-title text-dark font-weight-bold">Solicitud de Adquisición: #@Model.AcquisitionRequest.Id</h4>
                        <h6 class="card-subtitle text-muted small italic">Detalles del requerimiento de compra e inversión para laboratorio.</h6>
                    </div>
                    <div class="ml-auto mt-2 mt-md-0">
                        <span class="badge badge-pill badge-success px-4 py-2" style="font-size: 0.9rem;">
                            <i class="fas fa-shopping-cart mr-2"></i> @Model.AcquisitionRequest.Status
                        </span>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-12">
                        <label class="small text-muted font-weight-bold uppercase mb-1">Activo Afectado / Vinculado</label>
                        <div class="p-3 bg-light rounded border-left border-success font-weight-bold text-dark d-flex justify-content-between align-items-center shadow-sm">
                            <span>
                                <i class="fas fa-cube mr-2 text-success"></i> @(Model.AcquisitionRequest.Equipment?.Name ?? "Item Especial de Manual")
                                <span class="text-muted font-weight-normal small ml-1 italic">(@(Model.AcquisitionRequest.EquipmentUnit?.InventoryNumber ?? "Nuevo Activo / Sin Inv."))</span>
                            </span>
                            <span class="badge badge-pill badge-outline-success px-3 border border-success text-success bg-white small">@Model.AcquisitionRequest.Equipment?.Category</span>
                        </div>
                    </div>
                </div>

                <h5 class="font-weight-bold text-dark mb-3 uppercase small">
                    <i class="fas fa-file-invoice-dollar mr-2 text-success"></i> Justificación de Compra
                </h5>

                <div class="row">
                    <div class="col-12">
                        <div class="mb-4">
                            <label class="control-label font-weight-bold small uppercase text-muted mb-1">Descripción Detallada</label>
                            <div class="p-3 bg-white border rounded text-dark shadow-none italic" style="min-height: 80px; white-space: pre-wrap;">@Model.AcquisitionRequest.Description</div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6 border-right">
                                <label class="control-label font-weight-bold small uppercase text-success mb-1">Código de Inversión</label>
                                <div class="p-2 px-3 bg-light rounded border-left border-3 border-success text-dark font-weight-bold shadow-sm">
                                    <i class="fas fa-barcode mr-2 text-success"></i> @(Model.AcquisitionRequest.InvestmentCode ?? "N/A")
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="control-label font-weight-bold small uppercase text-muted mb-1">Nivel de Prioridad</label>
                                <div class="p-2 px-3 bg-light rounded border text-dark font-weight-bold shadow-sm">
                                    @{
                                        var pIcon = Model.AcquisitionRequest.Priority == RequestPriority.High ? "fa-bolt text-danger" : (Model.AcquisitionRequest.Priority == RequestPriority.Medium ? "fa-info-circle text-warning" : "fa-check-circle text-info");
                                    }
                                    <i class="fas @pIcon mr-2"></i> @Model.AcquisitionRequest.Priority
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="control-label font-weight-bold small uppercase text-muted mb-1">Centro de Costos Asignado</label>
                            <div class="p-2 px-3 bg-light rounded border text-dark font-weight-bold shadow-sm">
                                <i class="fas fa-university mr-2 text-muted"></i> @(Model.AcquisitionRequest.CostCenter ?? "No especificado")
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="control-label font-weight-bold small uppercase text-muted mb-1">Observaciones / Notas Extra</label>
                            <div class="alert alert-light border shadow-none small italic p-3 text-muted">
                                @(string.IsNullOrEmpty(Model.AcquisitionRequest.Observations) ? "Sin observaciones adicionales registradas en esta solicitud." : Model.AcquisitionRequest.Observations)
                            </div>
                        </div>
                    </div>
                </div>

                @if (Model.AcquisitionRequest.CostDetails.Any())
                {
                    <div class="mt-4 mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                            <h5 class="font-weight-bold text-success mb-0 small uppercase"><i class="fas fa-list-ol mr-2"></i> Desglose de Referencia (Valores Estimados)</h5>
                        </div>
                        <div class="table-responsive border rounded bg-white shadow-sm overflow-hidden">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="bg-light text-muted small uppercase font-weight-bold">
                                    <tr>
                                        <th class="border-top-0 pl-3 py-2">Concepto</th>
                                        <th class="border-top-0 text-center py-2">Cant / Unid.</th>
                                        <th class="border-top-0 text-right pr-3 py-2">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ decimal grandTotal = 0; }
                                    @foreach (var item in Model.AcquisitionRequest.CostDetails)
                                    {
                                        var subtotal = item.Quantity * item.UnitPrice;
                                        grandTotal += subtotal;
                                        <tr>
                                            <td class="pl-3 font-weight-bold text-dark py-2">@item.Concept</td>
                                            <td class="text-center font-weight-bold py-2">@item.Quantity.ToString("0.##")</td>
                                            <td class="text-right pr-3 font-weight-bold text-dark py-2">Bs @subtotal.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="bg-light-success">
                                    <tr class="font-weight-bold">
                                        <td colspan="2" class="text-right text-dark uppercase pr-3 py-3 small">Monto Total Solicitado (Aprox):</td>
                                        <td class="text-right text-success pr-3 py-3" style="font-size: 1.1rem;">Bs @grandTotal.ToString("N2")</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                }

                @if (Model.AcquisitionRequest.Status != RequestStatus.Pending)
                {
                    <div class="mt-5 border-top pt-4">
                        <h5 class="font-weight-bold text-dark mb-3 uppercase small">
                            <i class="fas fa-check-double mr-2 text-info"></i> Resolución Administrativa
                        </h5>
                        @{
                            var resClass = Model.AcquisitionRequest.Status == RequestStatus.Approved ? "bg-light-success text-success border-success" : "bg-light-danger text-danger border-danger";
                            var resIcon = Model.AcquisitionRequest.Status == RequestStatus.Approved ? "fa-check-circle" : "fa-times-circle";
                        }
                        <div class="alert @resClass border p-4 shadow-sm">
                            <div class="d-flex align-items-center">
                                <i class="fas @resIcon fa-3x mr-4 opacity-5"></i>
                                <div>
                                    <h6 class="mb-1 font-weight-bold uppercase" style="font-size: 1.1rem;">Verdict: @Model.AcquisitionRequest.Status.ToString().ToUpper()</h6>
                                    <div class="text-muted mb-0 small font-weight-bold pt-1">
                                        <i class="far fa-calendar-check mr-1"></i> Notificado el @(Model.AcquisitionRequest.ApprovalDate?.ToString("dd/MM/yyyy HH:mm") ?? "Fecha no registrada")
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <!-- Sidebar Detalles Premium -->
        <div class="card shadow-sm border-0 mb-4 bg-dark text-white shadow-lg overflow-hidden">
            <div class="card-body p-4 position-relative">
                <i class="fas fa-shopping-basket position-absolute text-white" style="font-size: 8rem; opacity: 0.05; right:-20px; top:-20px;"></i>
                <h5 class="card-title text-white font-weight-bold small uppercase mb-4 border-bottom border-secondary pb-2"><i class="fas fa-shield-alt mr-2 text-info"></i> Control Fiscal</h5>
                
                <div class="mb-4">
                    <label class="text-muted uppercase font-weight-bold d-block mb-1" style="font-size: 0.65rem;">Identificador Sistema</label>
                    <span class="font-weight-bold text-info" style="font-size: 1.3rem;">#ACQ-@Model.AcquisitionRequest.Id.ToString("D5")</span>
                </div>
                
                <div class="mb-0">
                    <label class="text-muted uppercase font-weight-bold d-block mb-2" style="font-size: 0.65rem;">Estado Operativo</label>
                    @{
                        var sBadge = Model.AcquisitionRequest.Status == RequestStatus.Approved ? "badge-success" : (Model.AcquisitionRequest.Status == RequestStatus.Rejected ? "badge-danger" : "badge-warning");
                    }
                    <span class="badge badge-pill @sBadge px-4 py-2 font-weight-bold shadow-sm" style="font-size: 0.85rem;">
                        <i class="fas fa-dot-circle mr-1 animate__animated animate__pulse animate__infinite"></i> @Model.AcquisitionRequest.Status
                    </span>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <h5 class="card-title text-dark font-weight-bold mb-4 small uppercase border-bottom pb-2">
                    <i class="fas fa-history mr-2 text-warning"></i> Control de Auditoría
                </h5>
                <div class="audit-log small">
                    <div class="mb-3">
                        <label class="text-muted d-block small uppercase mb-0 font-weight-bold">Originado Por</label>
                        <span class="font-weight-bold text-dark d-block">@(Model.AcquisitionRequest.RequestedBy?.FullName ?? "Solicitante Externo")</span>
                        <div class="text-muted pt-1 small italic"><i class="far fa-clock mr-1"></i> @Model.AcquisitionRequest.CreatedDate.ToString("dd-MM-yyyy HH:mm")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-actions mt-4 px-2">
            @if (Model.AcquisitionRequest.Status == RequestStatus.Pending)
            {
                <a asp-page="./Edit" asp-route-id="@Model.AcquisitionRequest.Id" class="btn btn-warning btn-block btn-rounded text-dark shadow-sm font-weight-bold py-3 mb-3 animate__animated animate__pulse">
                    <i class="fas fa-edit mr-2"></i> Modificar Solicitud
                </a>
            }

            <a asp-page="./Details" asp-page-handler="DescargarReporte" asp-route-id="@Model.AcquisitionRequest.Id" 
               class="btn btn-success btn-block btn-rounded shadow-sm font-weight-bold py-3 mb-3">
                <i class="fas fa-file-excel mr-2"></i> Exportar a Excel (L-12)
            </a>

            <a asp-page="./Index" class="btn btn-outline-secondary btn-block btn-rounded py-2 mb-4 font-weight-bold">
                <i class="fas fa-arrow-left mr-2 font-weight-bold"></i> Volver al Listado
            </a>
            
            <a asp-page="./Delete" asp-route-id="@Model.AcquisitionRequest.Id" class="btn btn-link btn-block text-danger small font-weight-bold font-italic mt-3">
                <i class="fas fa-trash-alt mr-2"></i> Anular permanentemente
            </a>
        </div>
    </div>
</div>


@section Styles {
    <style>
        .bg-light-success { background-color: rgba(40, 167, 69, 0.05); }
        .bg-light-danger { background-color: rgba(220, 53, 69, 0.05); }
        .opacity-5 { opacity: 0.15; }
        .italic { font-style: italic; }
        .border-left-3 { border-left-width: 4px !important; }
    </style>
}
