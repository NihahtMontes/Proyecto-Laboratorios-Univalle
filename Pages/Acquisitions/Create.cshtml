@page
@model Proyecto_Laboratorios_Univalle.Pages.Acquisitions.CreateModel

@{
    ViewData["Title"] = "Solicitud de Adquisición (L-12)";
    bool isWizard = (bool)(ViewData["IsWizard"] ?? false);
    int currentPhaseInt = (int)(ViewData["CurrentPhaseInt"] ?? 6);
}

<div class="row justify-content-center">
    <div class="col-lg-11 col-xl-10">

        @if (isWizard)
        {
            await Html.RenderPartialAsync("_WizardSteps", currentPhaseInt);
        }

        <div class="card shadow-sm border-0 mt-3">
            <div class="card-body p-4">
                <div class="d-flex no-block align-items-center mb-4 pb-3 border-bottom">
                    <div>
                        <h4 class="card-title text-dark font-weight-bold">Formulario de Solicitud de Adquisición (L-12)</h4>
                        <h6 class="card-subtitle text-muted">Gestión de compra de nuevos activos, repuestos e insumos para laboratorios.</h6>
                    </div>
                    <div class="ml-auto mt-2 mt-md-0">
                        <i class="fas fa-shopping-cart fa-2x text-success"></i>
                    </div>
                </div>

                <form method="post" novalidate id="createAcquisitionForm">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm border-0 small" role="alert"></div>

                    <input type="hidden" name="isWizard" value="@isWizard.ToString().ToLower()" />
                    <input type="hidden" asp-for="ManagementPlanId" />

                    <!-- FILA 1: UBICACION (Layout 3 Columnas) -->
                    <div class="bg-light p-4 rounded mb-4 border-left border-dark shadow-sm" style="border-left-width: 4px;">
                        <h5 class="text-dark font-weight-bold mb-3 uppercase small"><i class="fas fa-map-marker-alt mr-2 text-dark"></i>Localización y Activo</h5>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="Input.FacultyId" class="control-label font-weight-bold small text-uppercase text-muted">Facultad <span class="text-danger">*</span></label>
                                    @if (isWizard)
                                    {
                                        <select asp-for="Input.FacultyId" class="form-control custom-select border-dark" asp-items="ViewBag.FacultyId" id="facultySelect" disabled></select>
                                        <input type="hidden" asp-for="Input.FacultyId" />
                                    }
                                    else
                                    {
                                        <select asp-for="Input.FacultyId" class="form-control custom-select border-dark" asp-items="ViewBag.FacultyId" id="facultySelect" required>
                                            <option value="">-- Seleccione Facultad --</option>
                                        </select>
                                    }
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="Input.LaboratoryId" class="control-label font-weight-bold small text-uppercase text-muted">Laboratorio <span class="text-danger">*</span></label>
                                    @if (isWizard)
                                    {
                                        <select asp-for="Input.LaboratoryId" class="form-control custom-select border-dark" asp-items="ViewBag.LaboratoryId" id="laboratorySelect" disabled></select>
                                        <input type="hidden" asp-for="Input.LaboratoryId" />
                                    }
                                    else
                                    {
                                        <select asp-for="Input.LaboratoryId" class="form-control custom-select border-dark" asp-items="ViewBag.LaboratoryId" id="laboratorySelect" required disabled>
                                            <option value="">-- Primero seleccione facultad --</option>
                                        </select>
                                    }
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="Input.EquipmentUnitId" class="control-label font-weight-bold small text-uppercase text-muted">Unidad Física <span class="text-danger">*</span></label>
                                    @if (isWizard)
                                    {
                                        <select asp-for="Input.EquipmentUnitId" class="form-control custom-select border-dark" asp-items="ViewBag.EquipmentUnitId" id="equipmentUnitSelect" disabled></select>
                                        <input type="hidden" asp-for="Input.EquipmentUnitId" />
                                    }
                                    else
                                    {
                                        <select asp-for="Input.EquipmentUnitId" class="form-control custom-select border-dark" asp-items="ViewBag.EquipmentUnitId" id="equipmentUnitSelect" required disabled>
                                            <option value="">-- Seleccione laboratorio --</option>
                                        </select>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TARJETA DE REFERENCIA KARDEX / MANTENIMIENTO -->
                    @if (isWizard && ViewData["LinkedMaintenanceId"] != null)
                    {
                        <div class="bg-light p-3 rounded mb-4 border-left border-info" style="border-left-width: 4px !important;">
                            <label class="control-label font-weight-bold small text-uppercase text-muted">Antecedentes Históricos</label>
                            <div class="p-2 rounded mt-2" style="background:#e8f4fd; border: 1px solid #bae6fd;">
                                <div class="d-flex align-items-center">
                                    <div class="mr-3" style="color: #0284c7;"><i class="fas fa-clipboard-list fa-lg"></i></div>
                                    <div>
                                        <h6 class="m-0 font-weight-bold" style="color: #0369a1;">Kardex / Historial Previos (Fase 5)</h6>
                                        <span class="small" style="color: #0284c7;">Ref L-8 Mantenimiento: @ViewData["LinkedMaintenanceId"]</span>
                                    </div>
                                    <a href="/Maintenances/Details/@ViewData["LinkedMaintenanceId"]" target="_blank" class="btn btn-sm btn-light rounded-pill font-weight-bold shadow-sm ml-auto" style="color: #0284c7; border: 1px solid #bae6fd;">
                                        Ver Mantenimiento L-8 <i class="fas fa-external-link-alt ml-1"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger btn-rounded font-weight-bold shadow-sm ml-2" onclick="confirmRedoPhase(@Model.ManagementPlanId, 5, 'Kardex e Historial', 6)">
                                        <i class="fas fa-undo"></i> Rehacer Kardex
                                    </button>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="row mt-4">
                        <div class="col-md-5 border-right">
                            <h6 class="text-muted font-weight-bold text-uppercase mb-3"><i class="fas fa-file-invoice-dollar mr-2 text-success"></i> Datos Financieros</h6>

                            <div class="form-group mb-3">
                                <label asp-for="Input.InvestmentCode" class="control-label font-weight-bold small uppercase text-muted">Código de Inversión (Activos) <span class="text-danger">*</span></label>
                                <input asp-for="Input.InvestmentCode" class="form-control border-success" id="investmentCodeInput" placeholder="Ej: INV-2024-001" />
                                <span asp-validation-for="Input.InvestmentCode" class="text-danger small"></span>
                                <small class="form-text text-muted italic">Código sugerido según la unidad seleccionada.</small>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Input.CostCenter" class="control-label font-weight-bold small uppercase text-muted">Centro de Costos <span class="text-danger">*</span></label>
                                <input asp-for="Input.CostCenter" class="form-control border-success" placeholder="Ej: FAC-MED-01" />
                                <span asp-validation-for="Input.CostCenter" class="text-danger small"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Input.MaintenanceId" class="control-label font-weight-bold small uppercase text-muted">Importar de Mantenimiento</label>
                                @if (isWizard && ViewData["LinkedMaintenanceId"] != null)
                                {
                                    <select asp-for="Input.MaintenanceId" class="form-control custom-select bg-light text-dark font-weight-bold" id="maintenanceSelect">
                                        <option value="@ViewData["LinkedMaintenanceId"]" selected>Mnt #@ViewData["LinkedMaintenanceId"] (Seleccionado por Wizard)</option>
                                    </select>
                                }
                                else
                                {
                                    <select asp-for="Input.MaintenanceId" class="form-control custom-select" id="maintenanceSelect" disabled>
                                        <option value="">-- No referenciar mantenimiento --</option>
                                    </select>
                                }
                                <small class="form-text text-muted italic">Mantenimientos vinculados a esta unidad.</small>
                            </div>
                        </div>

                        <div class="col-md-7 pl-lg-4 mt-4 mt-md-0">
                            <h5 class="font-weight-bold text-info mb-3">
                                <i class="fas fa-comment-dollar mr-2"></i> Justificación y Detalle
                            </h5>

                            <div class="form-group mb-4 pl-3 bg-light p-3 rounded shadow-sm" style="border-left: 4px solid #28a745;">
                                <label asp-for="Input.Description" class="control-label font-weight-bold small text-uppercase text-dark">Justificación del Pedido <span class="text-danger">*</span></label>
                                <textarea asp-for="Input.Description" class="form-control shadow-none border-0" rows="4" placeholder="Justifique detalladamente la necesidad de esta adquisición o servicio..."></textarea>
                                <span asp-validation-for="Input.Description" class="text-danger small"></span>
                            </div>

                            <div class="form-group mb-4">
                                <label asp-for="Input.Observations" class="control-label font-weight-bold small uppercase text-muted">Observaciones Adicionales</label>
                                <textarea asp-for="Input.Observations" class="form-control" rows="3" placeholder="Contexto adicional o notas..."></textarea>
                            </div>

                            <div id="cost-summary-section" class="animated fadeInUp">
                                <hr />
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="font-weight-bold text-success mb-0 uppercase"><i class="fas fa-receipt mr-2"></i> Items Proyectados (Importados)</h6>
                                </div>

                                <div class="table-responsive border rounded bg-white shadow-sm" style="max-height: 400px; overflow-y: auto;">
                                    <table class="table table-sm table-hover mb-0" id="itemsTable">
                                        <thead class="thead-light">
                                            <tr class="small uppercase">
                                                <th style="width: 50%">Concepto</th>
                                                <th style="width: 25%" class="text-center">Cant.</th>
                                                <th style="width: 25%" class="text-right">Total Estimado</th>
                                            </tr>
                                        </thead>
                                        <tbody id="itemsSummaryBody" class="small">
                                            <tr>
                                                <td colspan="3" class="text-center text-muted py-4 italic">
                                                    No hay ítems cargados. Seleccione un mantenimiento de origen.
                                                </td>
                                            </tr>
                                        </tbody>
                                        <tfoot class="bg-light font-weight-bold" id="itemsFooter" style="display:none;">
                                            <tr>
                                                <td colspan="2" class="text-right">Total Solicitado (Bs):</td>
                                                <td class="text-success text-right" id="totalAmount">0.00</td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="mt-5" />

                    <div class="form-actions text-right mt-4">
                        @if (isWizard)
                        {
                            <a asp-page="/Index" asp-route-ShowWizard="true" asp-route-Step="6" asp-route-ManagementId="@ViewData["ManagementId"]"
                               class="btn btn-outline-secondary btn-rounded mr-2 px-4 font-weight-bold">
                                <i class="fas fa-arrow-left mr-1"></i> Volver al Wizard
                            </a>
                        }
                        else
                        {
                            <a asp-page="./Index" class="btn btn-outline-secondary btn-rounded mr-2 px-4 font-weight-bold">
                                <i class="fas fa-times mr-1"></i> Cancelar
                            </a>
                        }
                        <button type="button" class="btn btn-success btn-rounded px-5 shadow-sm font-weight-bold py-2" onclick="confirmAcquisition()">
                            <i class="fas fa-check-circle mr-1"></i> Crear Solicitud L-12
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <link href="~/assets/libs/select2/dist/css/select2.min.css" rel="stylesheet">
        <script src="~/assets/libs/select2/dist/js/select2.full.min.js"></script>
        <script>
            $(function() {
                $(".select2").select2({ width: '100%', allowClear: true });

                // Cascading Selectors
                $('#facultySelect').on('change', function() {
                    let id = $(this).val();
                    let $lab = $('#laboratorySelect');
                    let $unit = $('#equipmentUnitSelect');

                    $lab.empty().append('<option value="">-- Cargando... --</option>').prop('disabled', true);
                    $unit.empty().append('<option value="">-- Seleccione laboratorio --</option>').prop('disabled', true);

                    if (!id) {
                        $lab.html('<option value="">-- Primero seleccione facultad --</option>');
                        return;
                    }

                    $.get('/Acquisitions/Create?handler=LaboratoriesByFaculty', { facultyId: id }, function(data) {
                        let opts = '<option value="">-- Seleccionar Laboratorio --</option>';
                        $.each(data, function(i, item) { opts += `<option value="${item.id}">${item.name}</option>`; });
                        $lab.html(opts).prop('disabled', false).trigger('change');
                    });
                });

                $('#laboratorySelect').on('change', function() {
                    let id = $(this).val();
                    let $unit = $('#equipmentUnitSelect');

                    $unit.empty().append('<option value="">-- Cargando... --</option>').prop('disabled', true);

                    if (!id) {
                        $unit.html('<option value="">-- Seleccione laboratorio --</option>');
                        return;
                    }

                    $.get('/Acquisitions/Create?handler=UnitsByLab', { laboratoryId: id }, function(data) {
                        let opts = '<option value="">-- Seleccionar Unidad Física --</option>';
                        $.each(data, function(i, item) { opts += `<option value="${item.id}">${item.name}</option>`; });
                        $unit.html(opts).prop('disabled', false).trigger('change');
                    });
                });

                $('#equipmentUnitSelect').on('change', function() {
                    let id = $(this).val();
                    let $mnt = $('#maintenanceSelect');

                    if (!id) {
                        $mnt.empty().append('<option value="">-- No referenciar mantenimiento --</option>').prop('disabled', true);
                        return;
                    }

                    // Cargar Código de Inversión Sugerido
                    $.get('/Acquisitions/Create?handler=NextInvestmentCode', { unitId: id }, function(data) {
                        if (data.code) $('#investmentCodeInput').val(data.code);
                    });

                    // Cargar Mantenimientos
                    $.get('/Acquisitions/Create?handler=MaintenancesByUnit', { unitId: id }, function(data) {
                        let opts = '<option value="">-- No referenciar mantenimiento --</option>';
                        $.each(data, function(i, item) { opts += `<option value="${item.id}">${item.displayName}</option>`; });
                        $mnt.html(opts).prop('disabled', false).trigger('change');
                    });
                });

                $('#maintenanceSelect').on('change', function() {
                    let id = $(this).val();
                    let $body = $('#itemsSummaryBody');
                    let $footer = $('#itemsFooter');

                    if (!id) {
                        $body.html('<tr><td colspan="3" class="text-center text-muted py-3">No hay ítems cargados. Seleccione un mantenimiento.</td></tr>');
                        $footer.hide();
                        return;
                    }

                    $.get('/Acquisitions/Create?handler=MaintenanceCosts', { maintenanceId: id }, function(data) {
                        $body.empty();
                        let total = 0;
                        if (data.length === 0) {
                            $body.html('<tr><td colspan="3" class="text-center text-muted py-3">Este mantenimiento no tiene costos registrados.</td></tr>');
                            $footer.hide();
                        } else {
                            $.each(data, function(i, item) {
                                let sub = item.quantity * item.unitPrice;
                                total += sub;
                                $body.append(`<tr><td>${item.concept}</td><td>${item.quantity} ${item.unitOfMeasure || ''}</td><td>${sub.toFixed(2)}</td></tr>`);
                            });
                            $('#totalAmount').text(total.toFixed(2));
                            $footer.show();
                        }
                    });
                });
                // Manejo de carga inicial en caso de edición o pre-selección del Wizard
                let preMntId = $('#maintenanceSelect').val();
                if (preMntId) {
                    $('#maintenanceSelect').trigger('change');
                }
            });

            function confirmAcquisition() {
                Swal.fire({
                    title: '¿Confirmar Solicitud?',
                    text: 'Se enviará la solicitud de adquisición (L-12) para aprobación financiera.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, crear solicitud',
                    cancelButtonText: 'Cancelar',
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#6c757d'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $('#createAcquisitionForm').submit();
                    }
                });
            }
        </script>
    }