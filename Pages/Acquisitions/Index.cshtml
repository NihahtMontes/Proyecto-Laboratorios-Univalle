@page
@model Proyecto_Laboratorios_Univalle.Pages.Acquisitions.IndexModel
@using Proyecto_Laboratorios_Univalle.Models.Enums
@{
    ViewData["Title"] = "Solicitudes de Adquisición";
}

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <strong>Error:</strong> @TempData["Error"]
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                }

                <div class="d-md-flex align-items-center mb-4">
                    <div>
                        <h3 class="card-title text-dark font-weight-bold mt-2 ml-2">Solicitudes de AdquisiciÃ³n (L-12)</h3>
                        <h6 class="card-subtitle text-muted ml-2">GestiÃ³n de compra de nuevos activos, repuestos e insumos.</h6>
                    </div>
                    <div class="ml-auto mt-3">
                        <a asp-page="Create" class="btn btn-success btn-rounded shadow-sm text-white px-4 font-weight-bold">
                            <i class="fas fa-cart-plus mr-1"></i> Nueva AdquisiciÃ³n
                        </a>
                    </div>
                </div>

                <!-- FILTROS -->
                <div class="bg-light p-3 mb-4 rounded border-left border-success shadow-sm">
                    <form method="get">
                        <div class="row align-items-end">
                            <div class="col-md-3">
                                <label class="small font-weight-bold text-muted uppercase">Laboratorio</label>
                                <select asp-for="FilterLaboratoryId" class="form-control custom-select" asp-items="Model.LaboratoryList">
                                    <option value="">-- Todos --</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="small font-weight-bold text-muted uppercase">BÃºsqueda RÃ¡pida</label>
                                <div class="input-group drop-shadow">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-white border-right-0"><i class="fas fa-search text-muted"></i></span>
                                    </div>
                                    <input type="text" asp-for="SearchTerm" class="form-control border-left-0" placeholder="Ã�tem, cÃ³digo o solicitante..." />
                                </div>
                            </div>
                            <div class="col-md-2">
                                <label class="small font-weight-bold text-muted uppercase">Prioridad</label>
                                <select asp-for="PriorityFilter" class="form-control custom-select"
                                        asp-items="Html.GetEnumSelectList<RequestPriority>()">
                                    <option value="">-- Todas --</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="small font-weight-bold text-muted uppercase">Estado</label>
                                <select asp-for="StatusFilter" class="form-control custom-select"
                                        asp-items="Html.GetEnumSelectList<RequestStatus>()">
                                    <option value="">-- Todos --</option>
                                </select>
                            </div>
                            <div class="col-md-2 text-right mt-2 mt-md-0">
                                <button type="submit" class="btn btn-dark btn-rounded px-3 shadow-sm" title="Filtrar">
                                    <i class="fas fa-filter"></i>
                                </button>
                                <a asp-page="./Index" class="btn btn-outline-secondary btn-rounded ml-1" title="Limpiar">
                                    <i class="fas fa-sync-alt"></i>
                                </a>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- TABLA -->
                <div id="localNotificationsArea" class="mb-4" style="display: none;">
                    <h5 class="font-weight-bold text-success mb-3 border-bottom pb-2">
                        <i class="fas fa-shopping-basket mr-2"></i> Alertas de Adquisiciones
                    </h5>
                    <div id="localNotificationsList">
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover v-middle">
                        <thead class="thead-light">
                            <tr class="small uppercase font-weight-bold">
                                <th>Ã�tem / Concepto</th>
                                <th>UbicaciÃ³n</th>
                                <th class="text-center">Prioridad</th>
                                <th class="text-center">Estado</th>
                                <th>Solicitante</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Requests.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted font-weight-bold">
                                        <i class="fas fa-shopping-basket fa-3x mb-3 d-block opacity-2"></i>
                                        No se encontraron solicitudes de adquisiciÃ³n registradas.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model.Requests)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="m-r-10">
                                                    <span class="btn btn-circle btn-light-success text-success"><i class="fas fa-shopping-cart"></i></span>
                                                </div>
                                                <div>
                                                    <h6 class="m-b-0 font-weight-bold text-dark">@(item.Equipment?.Name ?? "Item Especial")</h6>
                                                    <small class="text-muted text-truncate d-block" style="max-width: 200px;">@item.Description</small>
                                                    <small class="text-muted d-block">Ref: #@item.Id</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="text-dark font-weight-bold">@item.Laboratory?.Name</div>
                                            <small class="text-muted">CÃ³d. Inv: @(item.InvestmentCode ?? "-")</small>
                                        </td>
                                        <td class="text-center">
                                            @{
                                                var pBadge = item.Priority == RequestPriority.High ? "badge-danger" : (item.Priority == RequestPriority.Medium ? "badge-warning" : "badge-info");
                                            }
                                            <span class="badge badge-pill @pBadge px-3 py-1">@item.Priority</span>
                                        </td>
                                        <td class="text-center">
                                            @{
                                                var sBadge = item.Status == RequestStatus.Approved ? "badge-success" : (item.Status == RequestStatus.Rejected ? "badge-danger" : "badge-warning");
                                            }
                                            <span class="badge badge-pill @sBadge px-3 py-1">@item.Status</span>
                                        </td>
                                        <td>
                                            <div class="font-weight-bold text-dark">@(item.RequestedBy?.FullName ?? "N/A")</div>
                                            <small class="text-muted">@item.CreatedDate.ToString("dd/MM/yyyy")</small>
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group">
                                                <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info btn-rounded mr-1" title="Ver Detalles">
                                                    <i class="fas fa-search-plus"></i>
                                                </a>
                                                <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning btn-rounded mr-1" title="Editar">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger btn-rounded" title="Eliminar">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .v-middle td { vertical-align: middle !important; }
        .opacity-2 { opacity: 0.2; }
        .uppercase { text-transform: uppercase; letter-spacing: 0.5px; }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // ==============================================================
            // AÃ‘ADIDO: LÃ“GICA DE NOTIFICACIONES LOCALES PARA ADQUISICIONES
            // ==============================================================
            function loadLocalAcquisitionNotifications() {
                // Le pasamos el filtro 'AdquisiciÃ³n' a la API
                $.get('/Api/Notifications?handler=Unread&filter=AdquisiciÃ³n', function(data) {
                    const $area = $('#localNotificationsArea');
                    const $list = $('#localNotificationsList');
                    
                    if (data.items && data.items.length > 0) {
                        $list.empty();
                        $.each(data.items, function(i, item) {
                            const icon = item.icon || 'fas fa-shopping-cart text-success';
                            const url = item.url ? item.url : 'javascript:void(0)';
                            
                            $list.append(`
                                <div class="alert alert-light border border-success shadow-sm d-flex align-items-center mb-2" id="local-notif-${item.id}">
                                    <div class="mr-3"><i class="${icon} fa-2x"></i></div>
                                    <div class="flex-grow-1">
                                        <h6 class="alert-heading font-weight-bold mb-1 text-dark">${item.title}</h6>
                                        <p class="mb-0 small text-muted">${item.message}</p>
                                        <small class="text-muted italic"><i class="far fa-clock mr-1"></i> ${item.time}</small>
                                    </div>
                                    <div class="ml-3">
                                        <a href="${url}" class="btn btn-sm btn-success btn-rounded px-3 font-weight-bold shadow-sm" onclick="markLocalAsRead(event, ${item.id}, '${url}')">
                                            Ver Detalles <i class="fas fa-arrow-right ml-1"></i>
                                        </a>
                                    </div>
                                </div>
                            `);
                        });
                        $area.slideDown();
                    } else {
                        $area.slideUp();
                    }
                });
            }

            // Ejecutamos al cargar la vista
            loadLocalAcquisitionNotifications();

            // FunciÃ³n para marcar como leÃ­da y desaparecer la alerta
            window.markLocalAsRead = function(e, id, url) {
                $.get(`/Api/Notifications?handler=MarkAsRead&id=${id}`, function() {
                    if (url && url !== 'javascript:void(0)') {
                        window.location.href = url;
                    } else {
                        // Ocultamos el cuadro suavemente
                        $(`#local-notif-${id}`).fadeOut(300, function() {
                            $(this).remove();
                            // Si era la Ãºltima alerta, ocultamos todo el panel principal
                            if ($('#localNotificationsList').children().length === 0) {
                                $('#localNotificationsArea').slideUp();
                            }
                        });
                    }
                });
            };
            
        });
    </script>
}