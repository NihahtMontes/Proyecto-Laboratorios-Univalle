@page "{id:int}"
@model Proyecto_Laboratorios_Univalle.Pages.Acquisitions.EditModel
@using Proyecto_Laboratorios_Univalle.Models.Enums

@{
    ViewData["Title"] = "Editar Solicitud de Adquisición (L-12)";
    bool isWizard = (bool)(ViewData["IsWizard"] ?? false);
    int currentPhaseInt = (int)(ViewData["CurrentPhaseInt"] ?? 6);
    int? planId = (int?)ViewData["ManagementPlanId"];
}

<div class="row justify-content-center">
    <div class="col-lg-12">
        @if (isWizard)
        {
            await Html.RenderPartialAsync("_WizardSteps", 6);
        }

        <div class="card shadow-sm border-0 mt-3">
            <div class="card-body p-4">
                <div class="d-flex no-block align-items-center mb-4 pb-3 border-bottom">
                    <div>
                        <h4 class="card-title text-dark font-weight-bold">Editar Solicitud de Adquisición</h4>
                        <h6 class="card-subtitle text-muted italic">Modificando expediente técnico de compra #@Model.Input.Id</h6>
                    </div>
                    <div class="ml-auto mt-2 mt-md-0 text-right">
                         <i class="fas fa-edit fa-2x text-warning"></i>
                    </div>
                </div>

                <form method="post" id="editAcquisitionForm" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm border-0 mb-4 small"></div>
                    
                    <input type="hidden" asp-for="Input.Id" />
                    <input type="hidden" name="isWizard" value="@isWizard.ToString().ToLower()" />
                    <input type="hidden" name="ManagementPlanId" value="@planId" />

                    <!-- FILA 1: UBICACION (Layout 3 Columnas) -->
                    <div class="bg-light p-4 rounded mb-4 border-left border-dark shadow-sm" style="border-left-width: 4px;">
                        <h5 class="text-dark font-weight-bold mb-3 uppercase small"><i class="fas fa-map-marker-alt mr-2 text-dark"></i>Localización y Activo</h5>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="Input.FacultyId" class="control-label font-weight-bold small text-uppercase text-muted">Facultad</label>
                                    @if (isWizard)
                                    {
                                        <select asp-for="Input.FacultyId" class="form-control custom-select border-dark" asp-items="ViewBag.FacultyId" disabled></select>
                                        <input type="hidden" asp-for="Input.FacultyId" />
                                    }
                                    else
                                    {
                                        <select asp-for="Input.FacultyId" class="form-control custom-select border-dark" asp-items="ViewBag.FacultyId" required disabled>
                                        </select>
                                    }
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="Input.LaboratoryId" class="control-label font-weight-bold small text-uppercase text-muted">Laboratorio</label>
                                    @if (isWizard)
                                    {
                                        <select asp-for="Input.LaboratoryId" class="form-control custom-select border-dark" asp-items="ViewBag.LaboratoryId" disabled></select>
                                        <input type="hidden" asp-for="Input.LaboratoryId" />
                                    }
                                    else
                                    {
                                        <select asp-for="Input.LaboratoryId" class="form-control custom-select border-dark" asp-items="ViewBag.LaboratoryId" required disabled>
                                        </select>
                                    }
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="Input.EquipmentUnitId" class="control-label font-weight-bold small text-uppercase text-muted">Unidad Física</label>
                                    @if (isWizard)
                                    {
                                        <select asp-for="Input.EquipmentUnitId" class="form-control custom-select border-dark" asp-items="ViewBag.EquipmentUnitId" disabled></select>
                                        <input type="hidden" asp-for="Input.EquipmentUnitId" />
                                    }
                                    else
                                    {
                                        <select asp-for="Input.EquipmentUnitId" class="form-control custom-select border-dark" asp-items="ViewBag.EquipmentUnitId" required disabled>
                                        </select>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TARJETA DE REFERENCIA KARDEX / MANTENIMIENTO -->
                    @if (isWizard && ViewData["LinkedMaintenanceId"] != null)
                    {
                        <div class="bg-light p-3 rounded mb-4 border-left border-info" style="border-left-width: 4px !important;">
                            <label class="control-label font-weight-bold small text-uppercase text-muted">Antecedentes Históricos</label>
                            <div class="p-2 rounded mt-2" style="background:#e8f4fd; border: 1px solid #bae6fd;">
                                <div class="d-flex align-items-center">
                                    <div class="mr-3" style="color: #0284c7;"><i class="fas fa-clipboard-list fa-lg"></i></div>
                                    <div>
                                        <h6 class="m-0 font-weight-bold" style="color: #0369a1;">Kardex / Historial Previos (Fase 5)</h6>
                                        <span class="small" style="color: #0284c7;">Ref L-8 Mantenimiento: @ViewData["LinkedMaintenanceId"]</span>
                                    </div>
                                    <a href="/Maintenances/Details?id=@ViewData["LinkedMaintenanceId"]" target="_blank" class="btn btn-sm btn-light rounded-pill font-weight-bold shadow-sm ml-auto" style="color: #0284c7; border: 1px solid #bae6fd;">
                                        Ver Mantenimiento L-8 <i class="fas fa-external-link-alt ml-1"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger btn-rounded font-weight-bold shadow-sm ml-2" onclick="confirmRedoPhase(@planId, 5, 'Kardex e Historial', 6)">
                                        <i class="fas fa-undo"></i> Rehacer Kardex
                                    </button>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="row mt-4">
                        <div class="col-md-5 border-right">
                            <h5 class="font-weight-bold text-info mb-3 small uppercase">
                                <i class="fas fa-file-signature mr-2"></i> Identificadores del Pedido
                            </h5>

                            <div class="form-group mb-4">
                                <label asp-for="Input.InvestmentCode" class="control-label font-weight-bold small text-muted text-uppercase mb-1">Código de Inversión <span class="text-danger">*</span></label>
                                <input asp-for="Input.InvestmentCode" class="form-control border-info" placeholder="Ej: INV-2024-001" />
                                <span asp-validation-for="Input.InvestmentCode" class="text-danger small"></span>
                            </div>

                            <div class="form-group mb-4">
                                <label asp-for="Input.CostCenter" class="control-label font-weight-bold small text-muted text-uppercase mb-1">Centro de Costos Asignado</label>
                                <input asp-for="Input.CostCenter" class="form-control" />
                                <span asp-validation-for="Input.CostCenter" class="text-danger small"></span>
                            </div>

                            <div class="form-group mb-4">
                                <label asp-for="Input.Priority" class="control-label font-weight-bold small text-muted text-uppercase mb-1">Nivel de Prioridad Académica</label>
                                <select asp-for="Input.Priority" class="form-control custom-select border-warning" asp-items="Html.GetEnumSelectList<RequestPriority>()"></select>
                                <span asp-validation-for="Input.Priority" class="text-danger small"></span>
                            </div>

                            <div class="form-group mb-4 border-top pt-3">
                                <label asp-for="Input.Status" class="control-label font-weight-bold small text-info text-uppercase mb-2">Estado Administrativo del Proceso</label>
                                <select asp-for="Input.Status" class="form-control custom-select bg-light font-weight-bold text-dark border-info" asp-items="Html.GetEnumSelectList<RequestStatus>()"></select>
                                <span asp-validation-for="Input.Status" class="text-danger small"></span>
                                <small class="form-text text-muted italic small mt-1"><i class="fas fa-info-circle mr-1"></i> El cambio de estado notifica automáticamente al solicitante.</small>
                            </div>
                        </div>

                        <div class="col-md-7 pl-lg-4 mt-4 mt-md-0">
                            <h5 class="font-weight-bold text-info mb-3 small uppercase">
                                <i class="fas fa-comment-dollar mr-2"></i> Justificación Detallada
                            </h5>

                            <div class="form-group mb-4 bg-light p-3 rounded shadow-sm border-left border-3 border-success">
                                <label asp-for="Input.Description" class="control-label font-weight-bold small text-dark text-uppercase mb-2">Motivo Original de la Solicitud <span class="text-danger">*</span></label>
                                <textarea asp-for="Input.Description" class="form-control shadow-none border-0" rows="5" placeholder="Describa la necesidad técnica..."></textarea>
                                <span asp-validation-for="Input.Description" class="text-danger small"></span>
                            </div>

                            <div class="form-group mb-4 pt-2">
                                <label asp-for="Input.Observations" class="control-label font-weight-bold small text-muted text-uppercase mb-2">Bitácora / Observaciones de Seguimiento</label>
                                <textarea asp-for="Input.Observations" class="form-control italic" rows="4" placeholder="Notas sobre el proceso de validación o evaluación técnica..."></textarea>
                                <span asp-validation-for="Input.Observations" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <hr class="mt-5" />

                    <div class="form-actions text-right mt-4 pb-2">
                        @if (isWizard)
                        {
                            <a asp-page="/Index" asp-route-ShowWizard="true" asp-route-Step="6" class="btn btn-outline-secondary btn-rounded px-4 mr-2 font-weight-bold">
                                <i class="fas fa-undo mr-1"></i> Volver al Wizard
                            </a>
                        }
                        else
                        {
                            <a asp-page="./Details" asp-route-id="@Model.Input.Id" class="btn btn-outline-secondary btn-rounded px-4 mr-2 font-weight-bold">
                                <i class="fas fa-times mr-1"></i> Cancelar Edición
                            </a>
                        }
                        <button type="submit" class="btn btn-warning btn-rounded px-5 shadow-sm font-weight-bold text-dark border-0 py-2 animate__animated animate__pulse animate__infinite">
                            <i class="fas fa-check-circle mr-1"></i> Aplicar Cambios Técnicos
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
