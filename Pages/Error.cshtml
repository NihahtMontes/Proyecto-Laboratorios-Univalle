@page
@model Proyecto_Laboratorios_Univalle.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card shadow-sm border-0 mt-4">
            <div class="card-body p-5">
                <div class="d-flex align-items-start">
                    <div class="btn btn-circle btn-lg btn-light-danger text-danger mr-4">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h2 class="font-weight-bold text-dark mb-2">@Model.Title</h2>
                        <p class="text-muted mb-4">
                            El sistema no pudo mostrar la informacion solicitada. Puede volver a la pantalla anterior o regresar al listado del modulo.
                        </p>

                        <div class="bg-light border rounded p-4 mb-4">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="small text-muted font-weight-bold text-uppercase mb-1">Modulo</label>
                                    <div class="font-weight-bold text-dark">@Model.Module</div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="small text-muted font-weight-bold text-uppercase mb-1">Identificador</label>
                                    <div class="font-weight-bold text-dark">@(string.IsNullOrWhiteSpace(Model.EntityId) ? "Sin dato" : Model.EntityId)</div>
                                </div>
                                <div class="col-12">
                                    <label class="small text-muted font-weight-bold text-uppercase mb-1">Detalle</label>
                                    <div class="text-dark">@Model.Message</div>
                                </div>
                            </div>
                        </div>

                        @if (Model.ShowRequestId)
                        {
                            <div class="alert alert-light border small text-muted mb-4">
                                <i class="fas fa-fingerprint mr-2"></i>
                                Codigo tecnico de seguimiento: <strong>@Model.RequestId</strong>
                            </div>
                        }

                        <div class="d-flex flex-wrap">
                            <a href="@Model.ReturnUrl" class="btn btn-outline-secondary btn-rounded px-4 mr-2 mb-2">
                                <i class="fas fa-arrow-left mr-2"></i> Volver
                            </a>
                            <a href="@Model.ListUrl" class="btn btn-info btn-rounded px-4 mb-2 shadow-sm">
                                <i class="fas fa-list mr-2"></i> @Model.ListText
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
