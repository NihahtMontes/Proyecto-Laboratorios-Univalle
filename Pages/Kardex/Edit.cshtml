@page
@model Proyecto_Laboratorios_Univalle.Pages.Kardex.EditModel
@using Proyecto_Laboratorios_Univalle.Models.Enums

@{
    ViewData["Title"] = "Editar Registro de Kardex";
    bool isWizard = (bool)(ViewData["IsWizard"] ?? false);
    int currentPhaseInt = (int)(ViewData["CurrentPhaseInt"] ?? 5);
    int? planId = (int?)ViewData["ManagementPlanId"];
}

<div class="row justify-content-center">
    <div class="col-lg-12">
        @if (isWizard)
        {
            await Html.RenderPartialAsync("_WizardSteps", currentPhaseInt);
        }

        <div class="card shadow-sm border-0 mt-3">
            <div class="card-body p-4">
                <div class="d-flex no-block align-items-center mb-4 pb-3 border-bottom">
                    <div>
                        <h4 class="card-title text-dark font-weight-bold">Actualizar Kardex e Historial</h4>
                        <h6 class="card-subtitle text-muted italic">Edición de un registro histórico del activo.</h6>
                    </div>
                    <div class="ml-auto mt-2 mt-md-0 text-right">
                         <i class="fas fa-clipboard-list fa-2x text-info"></i>
                    </div>
                </div>

                <form method="post" id="kardexEditForm" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm border-0 mb-4 small"></div>
                     
                    <input type="hidden" asp-for="Input.Id" />
                    <input type="hidden" asp-for="Input.MaintenanceId" />
                    <input type="hidden" asp-for="Input.CompletionPercentage" id="hiddenPercentageInput" />
                    <input type="hidden" asp-for="IsWizard" />
                    <input type="hidden" asp-for="ManagementId" />
                    <input type="hidden" asp-for="SelectedLabId" />
                    <input type="hidden" asp-for="ReturnStep" />

                    <!-- FILA 1: UBICACION (Layout 3 Columnas) -->
                    <div class="bg-light p-4 rounded mb-4 border-left border-info shadow-sm" style="border-left-width: 4px;">
                        <h5 class="text-dark font-weight-bold mb-3 uppercase small"><i class="fas fa-map-marker-alt mr-2 text-info"></i>Localización y Activo</h5>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="Input.FacultyId" class="control-label font-weight-bold small text-uppercase text-muted">Facultad</label>
                                    @if (isWizard)
                                    {
                                        <select asp-for="Input.FacultyId" class="form-control custom-select border-info" asp-items="ViewBag.FacultyId" id="facultySelector" disabled></select>
                                        <input type="hidden" asp-for="Input.FacultyId" />
                                    }
                                    else
                                    {
                                        <select asp-for="Input.FacultyId" class="form-control custom-select border-info" asp-items="ViewBag.FacultyId" id="facultySelector" required>
                                            <option value="">-- Seleccione Facultad --</option>
                                        </select>
                                    }
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="Input.LaboratoryId" class="control-label font-weight-bold small text-uppercase text-muted">Laboratorio</label>
                                    @if (isWizard)
                                    {
                                        <select asp-for="Input.LaboratoryId" class="form-control custom-select border-info" asp-items="ViewBag.LaboratoryId" id="labSelector" disabled></select>
                                        <input type="hidden" asp-for="Input.LaboratoryId" />
                                    }
                                    else
                                    {
                                        <select asp-for="Input.LaboratoryId" class="form-control custom-select border-info" asp-items="ViewBag.LaboratoryId" id="labSelector" required>
                                            <option value="">-- Seleccione Laboratorio --</option>
                                        </select>
                                    }
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <label asp-for="Input.EquipmentUnitId" class="control-label font-weight-bold small text-uppercase text-muted">Unidad Física</label>
                                    @if (isWizard)
                                    {
                                        <select asp-for="Input.EquipmentUnitId" class="form-control custom-select border-info" asp-items="ViewBag.EquipmentUnitId" id="unitSelector" disabled></select>
                                        <input type="hidden" asp-for="Input.EquipmentUnitId" />
                                    }
                                    else
                                    {
                                        <select asp-for="Input.EquipmentUnitId" class="form-control custom-select border-info" asp-items="ViewBag.EquipmentUnitId" id="unitSelector" required>
                                            <option value="">-- Seleccione Equipo --</option>
                                        </select>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- TARJETAS DE REFERENCIA -->
                        @if (isWizard && ViewData["LinkedDepartureId"] != null)
                        {
                            <div class="form-group mt-4 mb-0">
                                <label class="control-label font-weight-bold small text-uppercase text-muted">Salida de Equipo Relacionada (L-3)</label>
                                <div class="p-2 rounded mt-2" style="background:#fffbeb; border: 1px solid #fef08a;">
                                    <div class="d-flex align-items-center">
                                        <div class="mr-3" style="color: #d97706;"><i class="fas fa-sign-out-alt fa-lg"></i></div>
                                        <div>
                                            <h6 class="m-0 font-weight-bold" style="color: #b45309;">Salida L-3 Vinculada</h6>
                                            <span class="small" style="color: #d97706;">ID: @ViewData["LinkedDepartureId"]</span>
                                        </div>
                                        <a href="/Departures/Details?id=@ViewData["LinkedDepartureId"]" target="_blank" class="btn btn-sm btn-light rounded-pill font-weight-bold shadow-sm ml-auto" style="color: #d97706; border: 1px solid #fef08a;">
                                            Ver Detalles <i class="fas fa-external-link-alt ml-1"></i>
                                        </a>
                                        @{
                                            int prevPhaseEnumInt = 4; // Exit = 4
                                            int diff = currentPhaseInt - prevPhaseEnumInt;
                                        }
                                        @if (diff == 1)
                                        {
                                            <a href="/Departures/Edit?id=@ViewData["LinkedDepartureId"]" class="btn btn-sm btn-outline-warning btn-rounded font-weight-bold shadow-sm ml-2">
                                                <i class="fas fa-edit"></i> Editar L-3
                                            </a>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger btn-rounded font-weight-bold shadow-sm ml-2" onclick="confirmRedoPhase(@planId, @prevPhaseEnumInt, 'L-3 Salida', @currentPhaseInt)">
                                                <i class="fas fa-undo"></i> Rehacer L-3
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        else if (isWizard && ViewData["LinkedMaintenanceId"] != null)
                        {
                            <div class="form-group mt-4 mb-0">
                                <label class="control-label font-weight-bold small text-uppercase text-muted">Mantenimiento Relacionado (L-8)</label>
                                <div class="p-2 rounded mt-2" style="background:#f5f3ff; border: 1px solid #ddd6fe;">
                                    <div class="d-flex align-items-center">
                                        <div class="mr-3" style="color: #7c3aed;"><i class="fas fa-wrench fa-lg"></i></div>
                                        <div>
                                            <h6 class="m-0 font-weight-bold" style="color: #5b21b6;">Mantenimiento L-8 Vinculado</h6>
                                            <span class="small" style="color: #7c3aed;">ID: @ViewData["LinkedMaintenanceId"]</span>
                                        </div>
                                        <a href="/Maintenances/Details/@ViewData["LinkedMaintenanceId"]" target="_blank" class="btn btn-sm btn-light rounded-pill font-weight-bold shadow-sm ml-auto" style="color: #7c3aed; border: 1px solid #ddd6fe;">
                                            Ver Detalles <i class="fas fa-external-link-alt ml-1"></i>
                                        </a>
                                        @{
                                            int prevPhaseEnumInt = 3; // Maintenance = 3
                                            int diff = currentPhaseInt - prevPhaseEnumInt;
                                        }
                                        @if (diff == 1)
                                        {
                                            // Wait, diff from 5 to 3 is 2! So it will show Rehacer. Which is correct!
                                            <a href="/Maintenances/Edit?id=@ViewData["LinkedMaintenanceId"]" class="btn btn-sm btn-outline-warning btn-rounded font-weight-bold shadow-sm ml-2">
                                                <i class="fas fa-edit"></i> Editar L-8
                                            </a>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger btn-rounded font-weight-bold shadow-sm ml-2" onclick="confirmRedoPhase(@planId, @prevPhaseEnumInt, 'L-8 Mantenimiento', @currentPhaseInt)">
                                                <i class="fas fa-undo"></i> Rehacer L-8
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- FILA 2: DATOS DE HISTORIAL -->
                    <div class="row">
                        <div class="col-lg-7">
                            <h5 class="text-success font-weight-bold mb-3 uppercase small"><i class="fas fa-check-circle mr-2"></i>Estado Final (Kardex)</h5>
                            <div class="card border mb-4 shadow-sm">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-4 border-right">
                                            <div class="form-group mb-0">
                                                <label asp-for="Input.Status" class="control-label font-weight-bold small text-uppercase text-muted">Estado Actual <span class="text-danger">*</span></label>
                                                <select asp-for="Input.Status" class="form-control custom-select border-success" asp-items="Html.GetEnumSelectList<EquipmentStatus>()" required>
                                                    <option value="">-- Seleccione Estado --</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-4 border-right">
                                            <div class="form-group mb-0">
                                                <label asp-for="Input.StartDate" class="control-label font-weight-bold small text-uppercase text-muted">Fecha de Inicio <span class="text-danger">*</span></label>
                                                <input asp-for="Input.StartDate" class="form-control" type="datetime-local" required />
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group mb-0">
                                                <label asp-for="Input.EndDate" class="control-label font-weight-bold small text-uppercase text-muted">Fecha de Fin</label>
                                                <input asp-for="Input.EndDate" class="form-control text-muted" type="datetime-local" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-5">
                            <h5 class="text-primary font-weight-bold mb-3 uppercase small"><i class="fas fa-comment-dots mr-2"></i>Motivo del Registro</h5>
                            <div class="card bg-light border-0 mb-4 shadow-sm">
                                <div class="card-body p-4">
                                    <div class="form-group mb-0">
                                        <label asp-for="Input.Reason" class="control-label font-weight-bold small text-uppercase text-muted italic">Justificación / Motivo</label>
                                        <textarea asp-for="Input.Reason" class="form-control bg-white shadow-none" rows="3" required></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-lg-8">
                            <div class="card border-0 shadow-sm mb-4" style="border-left: 4px solid #17a2b8;">
                                <div class="card-body p-4">
                                    <div class="d-flex align-items-center mb-3">
                                        <div>
                                            <h5 class="text-dark font-weight-bold mb-1 uppercase small"><i class="fas fa-tasks mr-2 text-info"></i>Tareas Técnicas L-48</h5>
                                            <p class="text-muted small mb-0">Añade, modifica o elimina lógicamente las tareas asociadas al mantenimiento.</p>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-info btn-rounded font-weight-bold ml-auto" onclick="addTask()">
                                            <i class="fas fa-plus mr-1"></i> Agregar Tarea
                                        </button>
                                    </div>

                                    <div id="tasksContainer">
                                        @for (int i = 0; i < Model.Input.Tasks.Count; i++)
                                        {
                                            <div class="task-row mb-2 d-flex align-items-center p-2 rounded bg-light border">
                                                <input type="hidden" name="Input.Tasks[@i].Id" value="@Model.Input.Tasks[i].Id" />
                                                <div class="custom-control custom-checkbox mr-2">
                                                    <input type="checkbox" class="custom-control-input maintenance-check" id="taskChk_@i" name="Input.Tasks[@i].IsCompleted" value="true" onchange="calculatePercentage()" @(Model.Input.Tasks[i].IsCompleted ? "checked" : "") />
                                                    <label class="custom-control-label" for="taskChk_@i"></label>
                                                </div>
                                                <input type="text" name="Input.Tasks[@i].Description" value="@Model.Input.Tasks[i].Description" class="form-control form-control-sm font-weight-bold task-desc" placeholder="Descripción de la tarea L-48" required />
                                                <button type="button" class="btn btn-sm btn-link text-danger ml-2 p-0" onclick="removeTask(this)" title="Quitar tarea">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="card bg-info text-white border-0 shadow-sm mb-4">
                                <div class="card-body p-4">
                                    <h6 class="text-white-50 font-weight-bold uppercase small mb-2">Avance L-48</h6>
                                    <div class="d-flex align-items-end mb-3">
                                        <span id="displayProgressText" class="display-4 font-weight-bold line-height-1">0%</span>
                                        <span class="ml-2 mb-2 small text-white-50">completado</span>
                                    </div>
                                    <div class="progress rounded-pill bg-white-50" style="height: 10px;">
                                        <div id="visualProgressBar" class="progress-bar bg-white" role="progressbar" style="width:0%" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="mt-4" />

                    <div class="form-actions text-right pb-4 mt-4">
                        @if (isWizard)
                        {
                            <a asp-page="/Index" asp-route-ShowWizard="true" asp-route-Step="@Model.ReturnStep" asp-route-SelectedLabId="@Model.SelectedLabId" asp-route-ManagementId="@Model.ManagementId" class="btn btn-outline-secondary btn-rounded px-4 mr-2 font-weight-bold">
                                <i class="fas fa-magic mr-1"></i> Volver al Wizard
                            </a>
                        }
                        else
                        {
                            <a href="/EquipmentStateHistories/Index" class="btn btn-outline-secondary btn-rounded px-4 mr-2 font-weight-bold">
                                 <i class="fas fa-times mr-1"></i> Cancelar
                            </a>
                        }
                        <button type="submit" class="btn btn-info btn-rounded px-5 shadow-sm font-weight-bold text-white py-2">
                            <i class="fas fa-sync-alt mr-1"></i> Actualizar Kardex
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div style="display:none" id="taskTemplateContainer">
    <div class="task-row mb-2 d-flex align-items-center p-2 rounded bg-light border">
        <input type="hidden" name="Input.Tasks[INDEX].Id" value="0" disabled />
        <div class="custom-control custom-checkbox mr-2">
            <input type="checkbox" class="custom-control-input maintenance-check" id="taskChk_INDEX" name="Input.Tasks[INDEX].IsCompleted" value="true" onchange="calculatePercentage()" disabled />
            <label class="custom-control-label" for="taskChk_INDEX"></label>
        </div>
        <input type="text" name="Input.Tasks[INDEX].Description" value="" class="form-control form-control-sm font-weight-bold task-desc" placeholder="Descripción de la tarea L-48" required disabled />
        <button type="button" class="btn btn-sm btn-link text-danger ml-2 p-0" onclick="removeTask(this)" title="Quitar tarea">
            <i class="fas fa-trash-alt"></i>
        </button>
    </div>
</div>

@section Scripts {
    <script src="~/assets/extra-libs/jqbootstrapvalidation/validation.js"></script>
    <script>
        $(function () {
            "use strict";
            $("input,select,textarea").not("[type=submit]").jqBootstrapValidation();
            calculatePercentage();
        });

        function calculatePercentage() {
            const checkboxes = $('#tasksContainer .maintenance-check');
            const completed = checkboxes.filter(':checked').length;
            const percentage = checkboxes.length === 0 ? 0 : Math.round((completed / checkboxes.length) * 100);
            $('#displayProgressText').text(percentage + '%');
            $('#visualProgressBar').css('width', percentage + '%').attr('aria-valuenow', percentage);
            $('#hiddenPercentageInput').val(percentage);
        }

        function addTask() {
            const container = $('#tasksContainer');
            const index = container.children('.task-row').length;
            const template = $('#taskTemplateContainer').html().replace(/INDEX/g, index);
            container.append(template);
            container.children().last().find('input').prop('disabled', false);
            calculatePercentage();
        }

        function removeTask(btn) {
            $(btn).closest('.task-row').remove();
            reindexTasks();
            calculatePercentage();
        }

        function reindexTasks() {
            $('#tasksContainer .task-row').each(function (index) {
                $(this).find('input').each(function () {
                    const name = $(this).attr('name');
                    if (name) $(this).attr('name', name.replace(/Input\.Tasks\[\d+\]/, 'Input.Tasks[' + index + ']'));

                    const id = $(this).attr('id');
                    if (id && id.startsWith('taskChk_')) $(this).attr('id', 'taskChk_' + index);
                });
                $(this).find('label').each(function () {
                    const forAttr = $(this).attr('for');
                    if (forAttr && forAttr.startsWith('taskChk_')) $(this).attr('for', 'taskChk_' + index);
                });
            });
        }
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
