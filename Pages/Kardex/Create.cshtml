@page
@model Proyecto_Laboratorios_Univalle.Pages.Kardex.CreateModel
@using Proyecto_Laboratorios_Univalle.Models.Enums
@using Proyecto_Laboratorios_Univalle.Helpers

@{
    ViewData["Title"] = "Concluir Mantenimiento (Kardex)";
    bool isWizard = (bool)(ViewData["IsWizard"] ?? false);
    int currentPhaseInt = (int)(ViewData["CurrentPhaseInt"] ?? 5);
    var categoryList = Html.GetEnumSelectList<CostCategory>();
}

<div class="row justify-content-center">
    <div class="col-lg-12">
        @if (isWizard)
        {
            await Html.RenderPartialAsync("_WizardSteps", currentPhaseInt);
        }

        <div class="card shadow-sm border-0 overflow-hidden mt-3">
            <div class="card-header bg-info p-4">
                <div class="d-flex no-block align-items-center">
                    <div>
                        <h4 class="card-title text-white font-weight-bold mb-0">Concluir Mantenimiento (Kardex)</h4>
                        <h6 class="card-subtitle text-white-50 mb-0">Completa los datos del mantenimiento L-8, cierra la salida L-3 y habilita el desembolso.</h6>
                    </div>
                    <div class="ml-auto text-right text-white">
                        <div class="font-weight-bold h5 mb-1">@Model.EquipmentTitle</div>
                        <div class="small text-white-50">@Model.InventoryTitle · @Model.LaboratoryTitle</div>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <ul class="nav nav-tabs customtab px-4 pt-3" role="tablist">
                    <li class="nav-item"><a class="nav-link active font-weight-bold small uppercase" data-toggle="tab" href="#tab-general" role="tab"><i class="fas fa-info-circle mr-2"></i> 1. Datos L-8</a></li>
                    <li class="nav-item"><a class="nav-link font-weight-bold small uppercase" data-toggle="tab" href="#tab-costos" role="tab"><i class="fas fa-file-invoice-dollar mr-2"></i> 2. Costos e Insumos</a></li>
                    <li class="nav-item"><a class="nav-link font-weight-bold small uppercase" data-toggle="tab" href="#tab-cierre" role="tab"><i class="fas fa-check-double mr-2"></i> 3. Cierre Kardex</a></li>
                </ul>

                <form method="post" id="kardexForm" class="tab-content p-4" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm border-0 mb-4"></div>
                    <input type="hidden" name="isWizard" value="@isWizard.ToString().ToLower()" />
                    <input type="hidden" asp-for="ManagementPlanId" />
                    <input type="hidden" asp-for="Input.MaintenanceId" />
                    <input type="hidden" asp-for="Input.EquipmentUnitId" />
                    <input type="hidden" asp-for="Input.FacultyId" />
                    <input type="hidden" asp-for="Input.LaboratoryId" />
                    <input type="hidden" asp-for="Input.Status" value="@MaintenanceStatus.Completed" />
                    <input type="hidden" asp-for="Input.ActualCost" id="hiddenActualCost" />
                    <input type="hidden" asp-for="Input.CompletionPercentage" id="hiddenPercentageInput" />

                    <div class="tab-pane active" id="tab-general" role="tabpanel">
                        <div class="alert alert-light border-left border-info shadow-sm mb-4" style="border-left-width:4px;">
                            <div class="row align-items-center">
                                <div class="col-md-4"><strong>Equipo:</strong> @Model.EquipmentTitle<br /><span class="text-muted small">Inv: @Model.InventoryTitle</span></div>
                                <div class="col-md-4"><strong>Laboratorio:</strong> @Model.LaboratoryTitle</div>
                                <div class="col-md-4"><strong>L-3:</strong> @(Model.LinkedDepartureId.HasValue ? $"Salida #{Model.LinkedDepartureId}" : "Sin salida vinculada")<br /><span class="text-muted small">Fecha salida: @(Model.DepartureDate?.ToString("dd/MM/yyyy") ?? "Pendiente")</span></div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-8 border-right">
                                <h5 class="text-info font-weight-bold mb-3 small uppercase">Trabajo Realizado</h5>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="Input.MaintenanceType" class="control-label font-weight-bold small uppercase text-muted">Tipo de Mantenimiento <span class="text-danger">*</span></label>
                                            <select asp-for="Input.MaintenanceType" class="form-control custom-select" asp-items="ViewBag.MaintenanceType" required></select>
                                            <span asp-validation-for="Input.MaintenanceType" class="text-danger small"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="Input.TechnicianId" class="control-label font-weight-bold small uppercase text-muted">Técnico Responsable <span class="text-danger">*</span></label>
                                            <select asp-for="Input.TechnicianId" class="form-control custom-select" asp-items="ViewBag.TechnicianId" required>
                                                <option value="">-- Asignar Técnico --</option>
                                            </select>
                                            <span asp-validation-for="Input.TechnicianId" class="text-danger small"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label asp-for="Input.Description" class="control-label font-weight-bold text-dark uppercase small">Descripción de Trabajos Realizados <span class="text-danger">*</span></label>
                                    <textarea asp-for="Input.Description" class="form-control" rows="5" required placeholder="Ej: Mantenimiento correctivo, cambio de piezas, entrega del equipo funcionando..."></textarea>
                                    <span asp-validation-for="Input.Description" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <h5 class="text-info font-weight-bold mb-3 small uppercase">Fechas de Cierre</h5>
                                <div class="form-group mb-3">
                                    <label asp-for="Input.ScheduledDate" class="control-label font-weight-bold small uppercase text-muted">Fecha Programada <span class="text-danger">*</span></label>
                                    <input asp-for="Input.ScheduledDate" class="form-control" type="date" required />
                                    <span asp-validation-for="Input.ScheduledDate" class="text-danger small"></span>
                                </div>
                                <div class="form-group mb-3">
                                    <label asp-for="Input.StartDate" class="control-label font-weight-bold small uppercase text-muted">Inicio Real <span class="text-danger">*</span></label>
                                    <input asp-for="Input.StartDate" class="form-control" type="datetime-local" required />
                                    <span asp-validation-for="Input.StartDate" class="text-danger small"></span>
                                </div>
                                <div class="form-group mb-3">
                                    <label asp-for="Input.EndDate" class="control-label font-weight-bold small uppercase text-muted">Finalización Real <span class="text-danger">*</span></label>
                                    <input asp-for="Input.EndDate" class="form-control" type="datetime-local" required />
                                    <span asp-validation-for="Input.EndDate" class="text-danger small"></span>
                                </div>
                                <div class="form-group mb-0">
                                    <label asp-for="Input.ActualReturnDate" class="control-label font-weight-bold small uppercase text-muted">Devolución Real L-3 <span class="text-danger">*</span></label>
                                    <input asp-for="Input.ActualReturnDate" class="form-control border-info" type="date" required />
                                    <span asp-validation-for="Input.ActualReturnDate" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 text-right">
                            <button type="button" class="btn btn-info btn-rounded px-4" onclick="$('a[href=\'#tab-costos\']').tab('show')">Siguiente: Costos <i class="fas fa-arrow-right ml-1"></i></button>
                        </div>
                    </div>

                    <div class="tab-pane" id="tab-costos" role="tabpanel">
                        <div class="d-flex align-items-center mb-4">
                            <h5 class="text-dark font-weight-bold mb-0"><i class="fas fa-file-invoice-dollar mr-2 text-success"></i>Detalle de Costos e Insumos</h5>
                            <button type="button" class="btn btn-sm btn-success btn-rounded shadow-sm ml-auto font-weight-bold px-3" onclick="addRow()"><i class="fas fa-plus mr-1"></i> Agregar Ítem</button>
                        </div>

                        <div class="table-responsive border rounded mb-4">
                            <table class="table table-hover v-middle mb-0" id="costsTable">
                                <thead class="bg-light text-uppercase small font-weight-bold text-muted">
                                    <tr>
                                        <th class="pl-4" style="width: 28%">Concepto / Repuesto</th>
                                        <th style="width: 17%">Categoría</th>
                                        <th style="width: 10%" class="text-center">Cant.</th>
                                        <th style="width: 12%">Unidad</th>
                                        <th style="width: 13%" class="text-center">P. Unit (Bs)</th>
                                        <th style="width: 15%" class="text-center">Subtotal</th>
                                        <th style="width: 5%"></th>
                                    </tr>
                                </thead>
                                <tbody id="costsContainer">
                                    @for (int i = 0; i < Model.Input.CostDetails.Count; i++)
                                    {
                                        <tr class="cost-row">
                                            <td class="pl-4">
                                                <input type="hidden" name="Input.CostDetails[@i].Id" value="@Model.Input.CostDetails[i].Id" />
                                                <input name="Input.CostDetails[@i].Concept" class="form-control" value="@Model.Input.CostDetails[i].Concept" required />
                                            </td>
                                            <td><select name="Input.CostDetails[@i].Category" class="form-control custom-select" asp-items="@categoryList" asp-for="@Model.Input.CostDetails[i].Category"></select></td>
                                            <td><input name="Input.CostDetails[@i].Quantity" class="form-control text-center txt-qty" type="number" step="0.01" value="@Model.Input.CostDetails[i].Quantity.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" min="0.01" onchange="calculateTotals()" required /></td>
                                            <td><input name="Input.CostDetails[@i].UnitOfMeasure" class="form-control" value="@(Model.Input.CostDetails[i].UnitOfMeasure ?? "Unidad")" /></td>
                                            <td><input name="Input.CostDetails[@i].UnitPrice" class="form-control text-center txt-price" type="number" step="0.01" value="@Model.Input.CostDetails[i].UnitPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" min="0" onchange="calculateTotals()" required /></td>
                                            <td class="text-center font-weight-bold txt-subtotal py-3 text-dark">Bs @Model.Input.CostDetails[i].Subtotal.ToString("N2")</td>
                                            <td class="text-center"><button type="button" class="btn btn-link text-danger p-0" onclick="removeRow(this)"><i class="fas fa-trash-alt"></i></button></td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="bg-light">
                                        <td colspan="5" class="text-right font-weight-bold text-dark py-3 uppercase small">Importe Total Real:</td>
                                        <td class="text-center font-weight-bold text-success h5 py-3 mb-0" id="totalDisplay">Bs 0.00</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <div class="mt-4 d-flex justify-content-between">
                            <button type="button" class="btn btn-outline-secondary btn-rounded px-4" onclick="$('a[href=\'#tab-general\']').tab('show')"><i class="fas fa-arrow-left mr-1"></i> Anterior</button>
                            <button type="button" class="btn btn-info btn-rounded px-4" onclick="$('a[href=\'#tab-cierre\']').tab('show')">Siguiente: Cierre <i class="fas fa-arrow-right ml-1"></i></button>
                        </div>
                    </div>

                    <div class="tab-pane" id="tab-cierre" role="tabpanel">
                        <div class="row">
                            <div class="col-md-6 border-right">
                                <h5 class="text-dark font-weight-bold mb-4"><i class="fas fa-comment-medical mr-2 text-warning"></i>Evaluación Final</h5>
                                <div class="form-group mb-4">
                                    <label asp-for="Input.SatisfactionLevel" class="control-label font-weight-bold small uppercase text-muted">Nivel de Satisfacción <span class="text-danger">*</span></label>
                                    <select asp-for="Input.SatisfactionLevel" class="form-control custom-select font-weight-bold" asp-items="Html.GetEnumSelectList<MaintenanceSatisfaction>()" required>
                                        <option value="">-- Seleccione evaluación --</option>
                                    </select>
                                    <span asp-validation-for="Input.SatisfactionLevel" class="text-danger small"></span>
                                </div>
                                <div class="form-group mb-4">
                                    <label asp-for="Input.SuggestedNextMaintenanceDate" class="control-label font-weight-bold small uppercase text-muted">Próximo Mantenimiento <span class="text-danger">*</span></label>
                                    <input asp-for="Input.SuggestedNextMaintenanceDate" class="form-control" type="date" required />
                                    <span asp-validation-for="Input.SuggestedNextMaintenanceDate" class="text-danger small"></span>
                                </div>
                                <div class="form-group">
                                    <label asp-for="Input.Recommendations" class="control-label font-weight-bold small uppercase text-muted">Recomendaciones <span class="text-danger">*</span></label>
                                    <textarea asp-for="Input.Recommendations" class="form-control" rows="4" required></textarea>
                                    <span asp-validation-for="Input.Recommendations" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex align-items-center mb-3">
                                    <h5 class="text-dark font-weight-bold mb-0"><i class="fas fa-tasks mr-2 text-primary"></i>Validación Técnica L-48</h5>
                                    <button type="button" class="btn btn-sm btn-outline-primary btn-rounded font-weight-bold ml-auto" onclick="addTask()">
                                        <i class="fas fa-plus mr-1"></i> Agregar Tarea
                                    </button>
                                </div>
                                <div class="bg-light p-4 rounded mb-4">
                                    <div id="tasksContainer">
                                        @for (int i = 0; i < Model.Input.Tasks.Count; i++)
                                        {
                                            <div class="task-row mb-2 d-flex align-items-center p-2 rounded bg-white border">
                                                <input type="hidden" name="Input.Tasks[@i].Id" value="@Model.Input.Tasks[i].Id" />
                                                <div class="custom-control custom-checkbox mr-2">
                                                    <input type="checkbox" class="custom-control-input maintenance-check" id="taskChk_@i" name="Input.Tasks[@i].IsCompleted" value="true" onchange="calculatePercentage()" @(Model.Input.Tasks[i].IsCompleted ? "checked" : "") />
                                                    <label class="custom-control-label" for="taskChk_@i"></label>
                                                </div>
                                                <input type="text" name="Input.Tasks[@i].Description" value="@Model.Input.Tasks[i].Description" class="form-control form-control-sm font-weight-bold task-desc" placeholder="Descripción de la tarea L-48" required />
                                                <button type="button" class="btn btn-sm btn-link text-danger ml-2 p-0" onclick="removeTask(this)" title="Quitar tarea">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                    <div class="mt-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="font-weight-bold text-muted small text-uppercase">Avance L-48</span>
                                            <span id="displayProgressText" class="font-weight-bold text-info">0%</span>
                                        </div>
                                        <div class="progress rounded-pill shadow-sm" style="height: 10px;">
                                            <div id="visualProgressBar" class="progress-bar bg-info" role="progressbar" style="width:0%" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label asp-for="Input.Observations" class="control-label font-weight-bold small uppercase text-muted">Observaciones Finales <span class="text-danger">*</span></label>
                                    <textarea asp-for="Input.Observations" class="form-control" rows="4" required></textarea>
                                    <span asp-validation-for="Input.Observations" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-info border-0 shadow-sm mt-4">
                            <strong>Al concluir:</strong> el mantenimiento L-8 quedará <strong>Completado</strong>, la salida L-3 se cerrará con devolución y el equipo avanzará a Desembolso. El registro quedará disponible en el Kardex histórico del equipo.
                        </div>

                        <div class="mt-5 d-flex justify-content-between border-top pt-4">
                            <div>
                                <button type="button" class="btn btn-outline-secondary btn-rounded px-4" onclick="$('a[href=\'#tab-costos\']').tab('show')"><i class="fas fa-arrow-left mr-1"></i> Anterior</button>
                                @if (isWizard)
                                {
                                    <a asp-page="/Index" asp-route-ShowWizard="true" asp-route-Step="5" asp-route-SelectedLabId="@Model.Input.LaboratoryId" asp-route-ManagementId="@ViewData["ManagementId"]" class="btn btn-outline-secondary btn-rounded px-4 ml-2">
                                        <i class="fas fa-magic mr-1"></i> Volver al Wizard
                                    </a>
                                }
                            </div>
                            <div>
                                <button type="submit" asp-page-handler="Draft" id="btnDraftKardex" formnovalidate class="btn btn-outline-info btn-rounded px-4 shadow-sm font-weight-bold mr-2">
                                    <i class="fas fa-save mr-2"></i> Guardar Borrador
                                </button>
                                <button type="submit" asp-page-handler="Close" id="btnSubmitKardex" formnovalidate class="btn btn-info btn-rounded px-5 shadow-sm font-weight-bold text-white">
                                    <i class="fas fa-check-double mr-2"></i> Concluir Mantenimiento
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<table style="display:none">
    <tbody id="costTemplate">
        <tr class="cost-row">
            <td class="pl-4">
                <input type="hidden" name="Input.CostDetails[INDEX].Id" value="0" disabled />
                <input name="Input.CostDetails[INDEX].Concept" class="form-control" required placeholder="Nuevo concepto..." disabled />
            </td>
            <td><select name="Input.CostDetails[INDEX].Category" class="form-control custom-select" asp-items="categoryList" disabled></select></td>
            <td><input name="Input.CostDetails[INDEX].Quantity" class="form-control text-center txt-qty" type="number" step="0.01" value="1" min="0.01" onchange="calculateTotals()" required disabled /></td>
            <td><input name="Input.CostDetails[INDEX].UnitOfMeasure" class="form-control" value="Unidad" disabled /></td>
            <td><input name="Input.CostDetails[INDEX].UnitPrice" class="form-control text-center txt-price" type="number" step="0.01" value="0.00" min="0" onchange="calculateTotals()" required disabled /></td>
            <td class="text-center font-weight-bold txt-subtotal py-3 text-dark">Bs 0.00</td>
            <td class="text-center"><button type="button" class="btn btn-link text-danger p-0" onclick="removeRow(this)"><i class="fas fa-trash-alt"></i></button></td>
        </tr>
    </tbody>
</table>

<div style="display:none" id="taskTemplateContainer">
    <div class="task-row mb-2 d-flex align-items-center p-2 rounded bg-white border">
        <input type="hidden" name="Input.Tasks[INDEX].Id" value="0" disabled />
        <div class="custom-control custom-checkbox mr-2">
            <input type="checkbox" class="custom-control-input maintenance-check" id="taskChk_INDEX" name="Input.Tasks[INDEX].IsCompleted" value="true" onchange="calculatePercentage()" disabled />
            <label class="custom-control-label" for="taskChk_INDEX"></label>
        </div>
        <input type="text" name="Input.Tasks[INDEX].Description" value="" class="form-control form-control-sm font-weight-bold task-desc" placeholder="Descripción de la tarea L-48" required disabled />
        <button type="button" class="btn btn-sm btn-link text-danger ml-2 p-0" onclick="removeTask(this)" title="Quitar tarea">
            <i class="fas fa-trash-alt"></i>
        </button>
    </div>
</div>

@section Styles {
    <style>
        .customtab .nav-link { border: none; color: #747d8c; padding: 15px 25px; transition: all 0.3s ease; border-bottom: 2px solid transparent; }
        .customtab .nav-link.active { color: #17a2b8; background: transparent; border-bottom: 2px solid #17a2b8; }
        .uppercase { text-transform: uppercase; letter-spacing: 0.8px; }
    </style>
}

@section Scripts {
    <script src="~/assets/extra-libs/jqbootstrapvalidation/validation.js"></script>
    <script src="~/assets/libs/sweetalert2/dist/sweetalert2.all.min.js"></script>
    <script>
        $(function () {
            calculatePercentage();
            calculateTotals();

            $('#kardexForm').on('submit', function (event) {
                const form = this;
                if ($(form).data('confirmed') === true) return true;

                event.preventDefault();
                const submitter = event.originalEvent && event.originalEvent.submitter ? event.originalEvent.submitter : document.activeElement;
                const isDraft = submitter && submitter.id === 'btnDraftKardex';
                const targetAction = submitter && submitter.getAttribute('formaction') ? submitter.getAttribute('formaction') : form.action;

                const submitForm = function () {
                    $(form).data('confirmed', true);
                    form.action = targetAction;
                    $('#btnDraftKardex, #btnSubmitKardex').prop('disabled', true);
                    if (isDraft) {
                        $('#btnDraftKardex').html('<i class="fas fa-spinner fa-spin mr-1"></i> Guardando...');
                    } else {
                        $('#btnSubmitKardex').html('<i class="fas fa-spinner fa-spin mr-1"></i> Cerrando...');
                    }
                    HTMLFormElement.prototype.submit.call(form);
                };

                if (typeof Swal === 'undefined') {
                    submitForm();
                    return;
                }

                Swal.fire({
                    title: isDraft ? '¿Guardar borrador?' : '¿Concluir Mantenimiento?',
                    text: isDraft
                        ? 'Se guardará el avance sin pasar a desembolso. Podrás continuar el cierre de Kardex más tarde.'
                        : 'Se completará el mantenimiento L-8, se cerrará la salida L-3 con devolución y el equipo avanzará a Desembolso.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: isDraft ? 'Sí, guardar borrador' : 'Sí, concluir',
                    cancelButtonText: 'Cancelar',
                    confirmButtonColor: '#17a2b8',
                    cancelButtonColor: '#6c757d'
                }).then((result) => {
                    if (result && (result.isConfirmed === true || result.value === true)) {
                        submitForm();
                    }
                });
            });
        });

        function calculatePercentage() {
            const checkboxes = $('#tasksContainer .maintenance-check');
            const completed = checkboxes.filter(':checked').length;
            const percentage = checkboxes.length === 0 ? 0 : Math.round((completed / checkboxes.length) * 100);
            $('#displayProgressText').text(percentage + '%');
            $('#visualProgressBar').css('width', percentage + '%').attr('aria-valuenow', percentage);
            $('#hiddenPercentageInput').val(percentage);
        }

        function addTask() {
            const container = $('#tasksContainer');
            const index = container.children('.task-row').length;
            const template = $('#taskTemplateContainer').html().replace(/INDEX/g, index);
            container.append(template);
            container.children().last().find('input').prop('disabled', false);
            calculatePercentage();
        }

        function removeTask(btn) {
            $(btn).closest('.task-row').remove();
            reindexTasks();
            calculatePercentage();
        }

        function reindexTasks() {
            $('#tasksContainer .task-row').each(function (index) {
                $(this).find('input').each(function () {
                    const name = $(this).attr('name');
                    if (name) $(this).attr('name', name.replace(/Input\.Tasks\[\d+\]/, 'Input.Tasks[' + index + ']'));

                    const id = $(this).attr('id');
                    if (id && id.startsWith('taskChk_')) $(this).attr('id', 'taskChk_' + index);
                });
                $(this).find('label').each(function () {
                    const forAttr = $(this).attr('for');
                    if (forAttr && forAttr.startsWith('taskChk_')) $(this).attr('for', 'taskChk_' + index);
                });
            });
        }

        function addRow() {
            const container = $('#costsContainer');
            const template = $('#costTemplate').html();
            const index = container.children('.cost-row').length;
            container.append(template.replace(/\[INDEX\]/g, `[${index}]`));
            container.children().last().find('input, select').prop('disabled', false);
            calculateTotals();
        }

        function removeRow(btn) {
            $(btn).closest('tr').remove();
            reindexRows();
            calculateTotals();
        }

        function reindexRows() {
            $('#costsContainer .cost-row').each(function (index) {
                $(this).find('input, select').each(function () {
                    const name = $(this).attr('name');
                    if (name) $(this).attr('name', name.replace(/Input\.CostDetails\[\d+\]/, 'Input.CostDetails[' + index + ']'));
                });
            });
        }

        function calculateTotals() {
            let total = 0;
            $('#costsContainer .cost-row').each(function () {
                const qty = parseFloat(($(this).find('.txt-qty').val() || '').toString().replace(',', '.')) || 0;
                const price = parseFloat(($(this).find('.txt-price').val() || '').toString().replace(',', '.')) || 0;
                const sub = qty * price;
                $(this).find('.txt-subtotal').text('Bs ' + sub.toLocaleString('es-BO', { minimumFractionDigits: 2 }));
                total += sub;
            });
            $('#totalDisplay').text('Bs ' + total.toLocaleString('es-BO', { minimumFractionDigits: 2 }));
            $('#hiddenActualCost').val(total.toFixed(2));
        }
    </script>
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
