@page
@model Proyecto_Laboratorios_Univalle.Pages.LaboratoryOperations.GrillaModel
@using System.Globalization
@using Proyecto_Laboratorios_Univalle.Models
@using Proyecto_Laboratorios_Univalle.Services
@using Proyecto_Laboratorios_Univalle.Pages.LaboratoryOperations
@{
    ViewData["Title"] = "Grilla por laboratorio";
    ViewData["HidePageTitle"] = true;
    var grid = Model.Grid;
    var origin = Model.Origin;
    var overview = Model.RecoveryOverview;
    var mode = Model.IsRescheduleMode && grid != null;
    // En modo reprogramación "dos semanas" es el valor por defecto: el "no" se envía explícito.
    string? twoWeeksRoute = grid is { TwoWeeks: true } ? "true" : mode ? "false" : null;
    int? reprogramarRoute = mode && !Model.IsRecoveryMode ? origin!.Id : null;
    int? reponerRoute = mode && Model.IsRecoveryMode ? origin!.Id : null;
    // Reprogramar a mano sigue siendo exclusivo del SuperAdmin; en reposición de día alcanza con CanRecover.
    var canReschedule = (Model.IsRecoveryMode ? Model.CanRecover : Model.IsSuperAdmin) && grid is { CanAdd: true };
    var legendStatuses = new[]
    {
        PlanningStatus.Planned, PlanningStatus.Approved, PlanningStatus.Finalized,
        PlanningStatus.Rescheduled, PlanningStatus.PendingRecovery, PlanningStatus.Recovered
    };
    var inv = CultureInfo.InvariantCulture;
}

@section Styles {
    <link href="~/assets/libs/select2/dist/css/select2.min.css" rel="stylesheet">
    <link href="~/css/grilla.css" rel="stylesheet" asp-append-version="true">
}

<div class="page-breadcrumb gr-noprint">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h4 class="page-title text-uppercase text-primary font-weight-bold mb-0">OPERACIÓN DE LABORATORIOS</h4>
            <h2 class="font-weight-bold text-dark">Grilla por laboratorio</h2>
            @if (mode)
            {
                <div class="text-muted small">@(Model.IsRecoveryMode ? "Reposición de día" : "Reprogramación"): arrastre el bloque resaltado o elija el destino en el panel lateral.</div>
            }
            else
            {
                <div class="text-muted small">Horario semanal de un ambiente: lunes a sábado por periodos académicos.</div>
            }
        </div>
        @if (grid != null)
        {
            <div class="col-md-4 mt-2 mt-md-0 text-md-right">
                <a asp-page="./Index" asp-route-managementId="@grid.Management.Id" class="btn btn-light border btn-rounded btn-sm">
                    <i class="mdi mdi-view-dashboard mr-1"></i> Panel de planificación
                </a>
            </div>
        }
    </div>
</div>

<div class="container-fluid mt-3 @(mode ? "gr-mode-reschedule" : string.Empty)">
    @if (grid == null)
    {
        <div class="gr-empty-state">
            <i class="mdi mdi-table-large gr-empty-state__icon"></i>
            <h3 class="font-weight-bold text-dark mb-2">No hay una gestión académica activa</h3>
            <p class="text-muted mb-4">Active una gestión semestral o abra la grilla desde una gestión para consultar el horario de sus laboratorios.</p>
            <a asp-page="/Managements/Index" class="btn btn-primary btn-rounded px-4 shadow-sm gr-btn-primary">
                <i class="fas fa-university mr-2"></i> Ir a Gestiones
            </a>
        </div>
    }
    else
    {
        var management = grid.Management;
        var lab = grid.Laboratory;

        @if (mode)
        {
            <!-- Banda del modo reprogramación -->
            <div class="gr-rs-band shadow-sm rounded-lg mb-3 gr-noprint" role="status">
                <i class="mdi mdi-calendar-clock gr-rs-band__icon" aria-hidden="true"></i>
                <div class="gr-rs-band__text">
                        <span class="gr-rs-band__eyebrow">@(Model.IsRecoveryMode ? "Reponiendo día" : "Reprogramando")</span>
                    <span>
                        <strong>@origin!.Code</strong> · @origin.SubjectName (@origin.GroupName)
                        · origen @origin.Date.ToString("dd/MM") @origin.PeriodsText · @origin.LaboratoryLabel
                    </span>
                </div>
                @if (Model.SafeReturnUrl is string exitUrl)
                {
                    @* Con pantalla de origen (p. ej. conflictos), salir vuelve a ella. *@
                    <a href="@exitUrl"
                       id="gr-rs-exit"
                       class="btn btn-light btn-rounded btn-sm font-weight-bold ml-auto">
                        <i class="fas fa-times mr-1"></i> Salir del modo de traslado
                    </a>
                }
                else
                {
                    <a asp-page="./Grilla" asp-route-managementId="@origin.ManagementId" asp-route-laboratoryId="@origin.LaboratoryId"
                       asp-route-date="@origin.Date.ToString("yyyy-MM-dd", inv)"
                       id="gr-rs-exit"
                       class="btn btn-light btn-rounded btn-sm font-weight-bold ml-auto">
                        <i class="fas fa-times mr-1"></i> Salir del modo de traslado
                    </a>
                }
                @* Chips de ambientes: visibles solo durante un arrastre (los llena grilla-reprogramar.js) *@
                <div class="gr-rs-chips" id="gr-rs-chips" hidden aria-label="Cambiar de ambiente durante el arrastre"></div>
            </div>
        }

        @if (!grid.CanAdd)
        {
            <div class="alert border-0 shadow-sm rounded-lg d-flex align-items-center mb-3 gr-noprint gr-readonly">
                <i class="fas fa-eye text-warning fa-lg mr-3"></i>
                <div class="flex-grow-1">
                    <strong class="text-dark">Consultando la gestión @management.Code (@management.StatusText): solo lectura.</strong>
                    <div class="small text-muted">Esta gestión no admite nuevas planificaciones.</div>
                </div>
            </div>
        }

        @if (overview != null && !mode)
        {
            <!-- Banda de reposición de día en curso (sin planificación elegida) -->
            <div class="gr-rs-band shadow-sm rounded-lg mb-3 gr-noprint" role="status">
                <i class="mdi mdi-backup-restore gr-rs-band__icon" aria-hidden="true"></i>
                <div class="gr-rs-band__text">
                    <span class="gr-rs-band__eyebrow">Reposición de día en curso</span>
                    <span>
                        <strong>Afectados del @overview.Date.ToString("dd/MM/yyyy")</strong>
                        · @overview.Recovered de @overview.Total repuestas
                        · @overview.Pending pendiente(s)
                    </span>
                </div>
                <a asp-page="./Reposiciones" asp-route-managementId="@management.Id" asp-route-recoveryId="@overview.Id"
                   class="btn btn-light btn-rounded btn-sm font-weight-bold ml-auto">
                    <i class="fas fa-clipboard-list mr-1"></i> Ver detalle
                </a>
                <a asp-page="./Grilla" asp-route-managementId="@management.Id" id="gr-rec-exit"
                   class="btn btn-light btn-rounded btn-sm font-weight-bold">
                    <i class="fas fa-times mr-1"></i> Salir
                </a>
            </div>
        }

        <!-- Barra de controles -->
        <div class="card border-0 shadow-sm rounded-lg mb-3 gr-noprint">
            <div class="card-body py-3">
                <form method="get" id="gr-controls" class="gr-controls">
                    @if (mode)
                    {
                         <input type="hidden" name="@(Model.IsRecoveryMode ? "reponer" : "reprogramar")" value="@origin!.Id" />
                         @if (Model.IsRecoveryMode) { <input type="hidden" name="recoveryId" value="@Model.RecoveryId" /> }
                        <input type="hidden" name="managementId" value="@management.Id" />
                    }
                    <div class="gr-controls__field">
                        <label for="gr-management" class="gr-controls__label">Gestión</label>
                        <select id="gr-management" name="@(mode ? null : "managementId")" class="custom-select custom-select-sm" disabled="@mode"
                                title="@(mode ? "La reprogramación se hace dentro de la gestión de la planificación." : null)">
                            @foreach (var m in grid.Managements)
                            {
                                <option value="@m.Id" selected="@(m.Id == management.Id)">@m.Code · @m.StatusText@(m.IsCurrent ? " (actual)" : "")</option>
                            }
                        </select>
                    </div>

                    <div class="gr-controls__field gr-controls__field--lab">
                        <label for="gr-lab" class="gr-controls__label">Ambiente</label>
                        <select id="gr-lab" name="laboratoryId" class="form-control form-control-sm" disabled="@(!grid.HasLaboratories)">
                            @foreach (var l in grid.Laboratories)
                            {
                                var pendingInLab = Model.RecoveryPending.Count(p => p.LaboratoryId == l.Id);
                                <option value="@l.Id" selected="@(lab != null && l.Id == lab.Id)">@l.Label@(l.PlanningCount > 0 ? $" ({l.PlanningCount})" : "")@(pendingInLab > 0 ? $" · {pendingInLab} pendiente(s)" : "")</option>
                            }
                        </select>
                    </div>

                    @if (grid.HasWeeks)
                    {
                        <div class="gr-controls__field">
                            <span class="gr-controls__label">Semana académica</span>
                            <div class="d-flex align-items-center">
                                @if (grid.PreviousWeekNumber.HasValue)
                                {
                                    <a asp-page="./Grilla" asp-route-managementId="@management.Id" asp-route-laboratoryId="@lab?.Id"
                                        asp-route-week="@grid.PreviousWeekNumber" asp-route-twoWeeks="@twoWeeksRoute" asp-route-reprogramar="@reprogramarRoute" asp-route-reponer="@reponerRoute" asp-route-recoveryId="@Model.RecoveryId"
                                       class="btn btn-outline-secondary btn-sm btn-rounded mr-1" title="Semana anterior" aria-label="Semana anterior">
                                        <i class="fas fa-chevron-left"></i>
                                    </a>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-outline-secondary btn-sm btn-rounded mr-1" disabled aria-label="Semana anterior">
                                        <i class="fas fa-chevron-left"></i>
                                    </button>
                                }
                                <select id="gr-week" name="week" class="custom-select custom-select-sm gr-controls__week" aria-label="Ir a la semana">
                                    @foreach (var w in grid.WeekOptions)
                                    {
                                        <option value="@w.Number" selected="@(w.Number == grid.SelectedWeekNumber)">Semana @w.Number · @w.RangeText</option>
                                    }
                                </select>
                                @if (grid.NextWeekNumber.HasValue)
                                {
                                    <a asp-page="./Grilla" asp-route-managementId="@management.Id" asp-route-laboratoryId="@lab?.Id"
                                        asp-route-week="@grid.NextWeekNumber" asp-route-twoWeeks="@twoWeeksRoute" asp-route-reprogramar="@reprogramarRoute" asp-route-reponer="@reponerRoute" asp-route-recoveryId="@Model.RecoveryId"
                                       class="btn btn-outline-secondary btn-sm btn-rounded ml-1" title="Semana siguiente" aria-label="Semana siguiente">
                                        <i class="fas fa-chevron-right"></i>
                                    </a>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-outline-secondary btn-sm btn-rounded ml-1" disabled aria-label="Semana siguiente">
                                        <i class="fas fa-chevron-right"></i>
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="gr-controls__field gr-controls__field--switch">
                            <div class="custom-control custom-switch">
                                <input type="checkbox" class="custom-control-input" id="gr-two-weeks" name="twoWeeks" value="true" checked="@grid.TwoWeeks">
                                <label class="custom-control-label" for="gr-two-weeks">Ver dos semanas</label>
                            </div>
                            @if (mode)
                            {
                                @* Va después de la casilla: si está marcada se toma "true" (primer valor), si no, "false". *@
                                <input type="hidden" name="twoWeeks" value="false" />
                            }
                        </div>
                    }

                    @if (grid.HasWeeks && Model.ConflictTags.Count > 0)
                    {
                        <div class="gr-controls__field gr-controls__field--switch gr-cf-bar">
                            <div class="custom-control custom-switch">
                                <input type="checkbox" class="custom-control-input" id="gr-show-conflicts"
                                       data-conflict-toggle data-target=".gr-grid" data-class="gr-grid--conflicts"
                                       data-storage-key="gr-show-conflicts" checked="@Model.ShowConflicts">
                                <label class="custom-control-label" for="gr-show-conflicts">Resaltar conflictos de material</label>
                            </div>
                            <span class="gr-cf-legend">
                                @foreach (var tipo in ConflictTypes.All)
                                {
                                    <span class="gr-cf-legend__item">
                                        <span class="gr-cf-legend__dot gr-cf-legend__dot--@tipo.Css" aria-hidden="true"></span>@tipo.Label
                                    </span>
                                }
                            </span>
                            <a asp-page="./Conflictos" asp-route-managementId="@management.Id"
                               asp-route-date="@grid.Weeks[0].StartDate.ToString("yyyy-MM-dd", inv)" class="gr-cf-link">
                                <i class="mdi mdi-alert-octagram mr-1" aria-hidden="true"></i> Ver conflictos de la semana
                            </a>
                        </div>
                    }

                    <div class="gr-controls__actions">
                        <button type="button" class="btn btn-outline-primary btn-rounded btn-sm" id="gr-print">
                            <i class="fas fa-print mr-1"></i> Imprimir
                        </button>
                        @if (grid.CanAdd && !mode)
                        {
                            <a asp-page="./Planificacion" asp-route-managementId="@management.Id" asp-route-laboratoryId="@lab?.Id"
                               class="btn btn-primary btn-rounded btn-sm font-weight-bold shadow-sm gr-btn-primary">
                                <i class="fas fa-plus mr-1"></i> Nueva planificación
                            </a>
                        }
                    </div>
                    <noscript><button type="submit" class="btn btn-sm btn-secondary">Aplicar</button></noscript>
                </form>
            </div>
        </div>

        @if (!grid.HasLaboratories)
        {
            <div class="gr-empty-state">
                <i class="fas fa-flask gr-empty-state__icon"></i>
                <h4 class="font-weight-bold text-dark mb-2">No hay ambientes activos</h4>
                <p class="text-muted mb-0">Registre o active un laboratorio para consultar su horario.</p>
            </div>
        }
        else if (!grid.HasWeeks)
        {
            <div class="gr-empty-state">
                <i class="far fa-calendar gr-empty-state__icon"></i>
                <h4 class="font-weight-bold text-dark mb-2">La gestión @management.Code no tiene semanas académicas</h4>
                <p class="text-muted mb-4">Genere el calendario académico de la gestión para ver la grilla semanal de los laboratorios.</p>
                <a asp-page="./CalendarioAcademico" asp-route-managementId="@management.Id" class="btn btn-outline-primary btn-rounded px-4">
                    <i class="mdi mdi-calendar-month mr-1"></i> Calendario académico
                </a>
            </div>
        }
        else if (lab != null)
        {
            <div class="gr-layout @((mode || overview != null) ? "gr-layout--rs" : string.Empty)">
                <div class="gr-layout__main">
                    @foreach (var week in grid.Weeks)
                    {
                        <section class="gr-sheet card border-0 shadow-sm rounded-lg mb-4" aria-label="Semana académica @week.Number">
                            <!-- Encabezado del formulario oficial -->
                            <header class="gr-sheet__head">
                                <div class="gr-sheet__brand">
                                    <strong>UNIVALLE</strong>
                                    <span>Laboratorios</span>
                                </div>
                                <div class="gr-sheet__title">
                                    <span>REGISTRO DE HORARIOS — HORARIO POR AULA</span>
                                </div>
                                <div class="gr-sheet__code">
                                    <span>Código</span>
                                    <strong>RE-10-VAC-007</strong>
                                </div>
                            </header>
                            <dl class="gr-sheet__meta">
                                <div><dt>Gestión</dt><dd>@management.Code</dd></div>
                                <div class="gr-sheet__meta-wide"><dt>Ambiente</dt><dd>@lab.Label</dd></div>
                                <div><dt>Piso / ubicación</dt><dd>@lab.LocationText</dd></div>
                                <div><dt>Capacidad</dt><dd>@lab.CapacityText</dd></div>
                                <div><dt>Semana académica</dt><dd>@week.Number (@week.RangeText)</dd></div>
                            </dl>

                            <!-- Grilla: columna de periodos + lunes a sábado; filas = cabecera + periodos -->
                            <div class="gr-scroll">
                                <div class="gr-grid @(Model.ShowConflicts ? "gr-grid--conflicts" : string.Empty)"
                                     style="grid-template-rows: auto repeat(@grid.Periods.Count, minmax(var(--gr-row-height), auto));"
                                     data-laboratory-id="@lab.Id" data-week="@week.Number"
                                     data-conflict-scope="gr-grid--hovering" data-conflict-related-class="gr-block--related">
                                    <div class="gr-corner" style="grid-column: 1; grid-row: 1;">Periodo</div>

                                    @foreach (var day in week.Days)
                                    {
                                        var headCss = !day.InManagement ? "gr-dayhead--out" : day.IsSuspended ? "gr-dayhead--suspended" : string.Empty;
                                        <div class="gr-dayhead @headCss" style="grid-column: @(day.Weekday + 1); grid-row: 1;"
                                             data-date="@day.Date.ToString("yyyy-MM-dd", inv)">
                                            <span class="gr-dayhead__name">@day.Name</span>
                                            <span class="gr-dayhead__date">@day.Date.ToString("dd/MM")</span>
                                            @if (!day.InManagement)
                                            {
                                                <span class="gr-dayhead__note">Fuera de la gestión</span>
                                            }
                                             else if (day.IsSuspended)
                                             {
                                                 <span class="gr-dayhead__note gr-dayhead__note--suspended" title="@day.Reason">
                                                     <i class="mdi mdi-calendar-remove"></i> Suspendido@(string.IsNullOrWhiteSpace(day.Reason) ? "" : ": " + day.Reason)
                                                 </span>
                                                 <a asp-page="./Reposiciones" asp-route-managementId="@management.Id" class="small gr-noprint">Ver reposiciones</a>
                                             }
                                             else if (Model.CanRecover && !mode && grid.CanAdd && day.Blocks.Any(b => b.Occupies))
                                             {
                                                 <a asp-page="./CalendarioAcademico" asp-route-managementId="@management.Id"
                                                    asp-fragment="day-@day.Date.ToString("yyyy-MM-dd", inv)" class="small gr-noprint">Reponer día</a>
                                             }
                                        </div>
                                    }

                                    @foreach (var period in grid.Periods)
                                    {
                                        var row = period.Order + 1;
                                        <div class="gr-period" style="grid-column: 1; grid-row: @row;">
                                            <span class="gr-period__badge" aria-hidden="true">@period.Order</span>
                                            <span class="gr-period__time">@period.Label</span>
                                        </div>

                                        @foreach (var day in week.Days)
                                        {
                                            var dateValue = day.Date.ToString("yyyy-MM-dd", inv);
                                            var busy = day.IsBusy(period.Order);
                                            var buffer = day.AcceptsBlocks && day.IsBuffer(period.Order);
                                            var cellCss = !day.InManagement ? "gr-cell--out" : day.IsSuspended ? "gr-cell--suspended" : string.Empty;
                                            <div class="gr-cell @cellCss @(busy ? "gr-cell--busy" : string.Empty) @(buffer ? "gr-cell--buffer" : string.Empty)"
                                                 style="grid-column: @(day.Weekday + 1); grid-row: @row;"
                                                 data-date="@dateValue" data-order="@period.Order" data-laboratory-id="@lab.Id" data-col="@(day.Weekday + 1)"
                                                 data-suspended="@(day.IsSuspended ? "true" : null)" data-out="@(day.InManagement ? null : "true")"
                                                 title="@(buffer ? "Periodo de separación entre prácticas" : null)">
                                                @if (grid.CanAdd && !mode && day.AcceptsBlocks && !busy && !buffer)
                                                {
                                                    <a asp-page="./Planificacion" asp-route-managementId="@management.Id" asp-route-date="@dateValue"
                                                       asp-route-periodId="@period.Id" asp-route-laboratoryId="@lab.Id"
                                                       class="gr-cell__add" title="Nueva planificación: @day.Name @day.Date.ToString("dd/MM"), Periodo @period.Order (@period.Label)"
                                                       aria-label="Nueva planificación el @day.Name @day.Date.ToString("dd/MM") en el Periodo @period.Order (@period.Label)">
                                                        <i class="fas fa-plus"></i>
                                                    </a>
                                                }
                                            </div>
                                        }
                                    }

                                    @foreach (var day in week.Days)
                                    {
                                        @foreach (var b in day.Blocks)
                                        {
                                            var isOrigin = mode && b.PlanningId == origin!.Id;
                                            var relocCss = b.Relocation is { Kind: GridRelocationKind.MovedFrom } ? $"gr-block--reloc-{b.Relocation.Css}" : string.Empty;
                                            var rescheduleUrl = canReschedule && b.IsReschedulable && !isOrigin ? Url.Page("./Grilla", new { reprogramar = b.PlanningId }) : null;
                                            var tags = Model.ConflictTags.TryGetValue(b.PlanningId, out var blockTags) ? blockTags : null;
                                            var hasTags = tags is { Count: > 0 };
                                            var cfKeys = hasTags ? string.Join(" ", tags!.Select(t => t.Key).Distinct()) : null;
                                            var cfCss = hasTags ? ConflictTypes.Of(tags![0].Kind).Css : null;
                                            <div class="gr-block gr-block--@b.StatusCss @(b.Occupies ? string.Empty : "gr-block--inactive") @(b.LaneCount > 1 ? "gr-block--lane" : string.Empty) @relocCss @(isOrigin ? "gr-block--origin" : string.Empty) @(Model.Resaltar == b.PlanningId ? "gr-block--highlight" : string.Empty) @(cfCss == null ? string.Empty : $"gr-block--has-conflict gr-block--cf-{cfCss}") @(cfCss != null && b.PeriodCount == 1 ? "gr-block--cf-tight" : string.Empty)"
                                                 style="grid-column: @(day.Weekday + 1); grid-row: @(b.StartOrder!.Value + 1) / span @b.PeriodCount; --gr-lane: @b.LaneIndex; --gr-lanes: @b.LaneCount;"
                                                 title="@b.Tooltip"
                                                 draggable="@(isOrigin ? "true" : null)"
                                                 data-planning-id="@b.PlanningId" data-code="@b.Code" data-date="@b.Date.ToString("yyyy-MM-dd", inv)"
                                                 data-start-order="@b.StartOrder" data-period-count="@b.PeriodCount"
                                                 data-laboratory-id="@b.LaboratoryId" data-status="@b.Status"
                                                 data-next-url="@b.NextUrl" data-reschedule-url="@rescheduleUrl"
                                                 data-conflict-keys="@cfKeys">
                                                <a href="@b.NextUrl" class="gr-block__open" draggable="false" aria-label="Abrir @b.Code: @b.SubjectName (@b.GroupName)"></a>
                                                <span class="gr-block__title">@b.SubjectShort (@b.GroupName)</span>
                                                <span class="gr-block__teacher"><i class="fas fa-user-tie mr-1"></i>@b.TeacherName</span>
                                                @if (hasTags)
                                                {
                                                    <span class="gr-block__conflicts">
                                                        @foreach (var t in tags!.Take(3))
                                                        {
                                                            var tipo = ConflictTypes.Of(t.Kind);
                                                            var relText = t.RelatedPlanningIds.Count > 0
                                                                ? $"\nRelacionadas: {string.Join(", ", t.RelatedPlanningIds.Select(L3Codes.Format))}" : string.Empty;
                                                            var titulo = $"{t.Tag} · {tipo.Label} · {t.ArticleName} · {t.Date.ToString("dd/MM")}{relText}\nClic para resolver en Conflictos";
                                                            <a class="gr-ctag gr-ctag--@tipo.Css @(t.Involved ? "is-involved" : "is-loose")" href="@t.Url" draggable="false"
                                                               data-conflict-key="@t.Key" data-cf-color="var(--cf-@tipo.Css)"
                                                               title="@titulo">@t.Tag</a>
                                                        }
                                                        @if (tags!.Count > 3)
                                                        {
                                                            <span class="gr-ctag gr-ctag--more">+@(tags.Count - 3)</span>
                                                        }
                                                    </span>
                                                }
                                                @if (b.Relocation != null)
                                                {
                                                    <a href="@b.Relocation.Url" class="gr-block__reloc gr-block__reloc--@b.Relocation.Css" draggable="false" title="@b.Relocation.Text">
                                                        <i class="mdi @b.Relocation.Icon" aria-hidden="true"></i> @b.Relocation.Text
                                                    </a>
                                                }
                                                <span class="gr-block__foot">
                                                    <span class="gr-block__code">@b.Code</span>
                                                    <span class="badge badge-@b.StatusCss gr-block__badge @(b.StatusCss == "light" ? "border" : string.Empty)">@b.StatusLabel</span>
                                                </span>
                                                @if (isOrigin)
                                                {
                                                    <span class="gr-block__drag-hint"><i class="mdi mdi-cursor-move" aria-hidden="true"></i> Arrástrelo</span>
                                                }
                                                <button type="button" class="gr-block__menu-btn gr-noprint" aria-haspopup="true" aria-label="Acciones de @b.Code" title="Acciones">
                                                    <i class="mdi mdi-dots-vertical" aria-hidden="true"></i>
                                                </button>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>

                            @if (week.Unscheduled.Count > 0)
                            {
                                <div class="gr-unscheduled">
                                    <h6 class="font-weight-bold text-dark mb-2">
                                        <i class="fas fa-clock text-warning mr-1"></i> Sin periodo asignado
                                        <small class="text-muted font-weight-normal ml-1">Planificaciones anteriores al registro por periodos; se muestran con su horario original.</small>
                                    </h6>
                                    <ul class="list-unstyled mb-0">
                                        @foreach (var b in week.Unscheduled)
                                        {
                                            <li>
                                                <a href="@b.NextUrl" class="gr-unscheduled__item @(b.Occupies ? string.Empty : "gr-block--inactive")" title="@b.Tooltip"
                                                   data-planning-id="@b.PlanningId" data-date="@b.Date.ToString("yyyy-MM-dd", inv)"
                                                   data-laboratory-id="@b.LaboratoryId" data-status="@b.Status">
                                                    <span class="gr-unscheduled__when">@b.Date.ToString("ddd dd/MM", CultureInfo.GetCultureInfo("es-BO")) · @b.TimeText</span>
                                                    <strong>@b.SubjectShort (@b.GroupName)</strong>
                                                    <span class="text-muted">@b.TeacherName</span>
                                                    <span class="gr-block__code">@b.Code</span>
                                                    <span class="badge badge-@b.StatusCss @(b.StatusCss == "light" ? "border" : string.Empty)">@b.StatusLabel</span>
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }

                            @if (week.BlockCount == 0)
                            {
                                <div class="gr-week-empty">
                                    <i class="far fa-calendar-check mr-1"></i> Sin planificaciones de @lab.Code en esta semana.
                                </div>
                            }
                        </section>
                    }

                    <!-- Leyenda de estados -->
                    <div class="card border-0 shadow-sm rounded-lg mb-4 gr-legend-card">
                        <div class="card-body py-3">
                            <div class="d-flex flex-wrap align-items-center gr-legend">
                                <span class="font-weight-bold text-dark mr-2">Estados:</span>
                                @foreach (var status in legendStatuses)
                                {
                                    var css = PlanningStatusView.Css(status);
                                    <span class="gr-legend__item">
                                        <span class="gr-legend__swatch gr-block--@css @(PlanningStatus.Occupies(status) ? string.Empty : "gr-block--inactive")"></span>
                                        @PlanningStatus.Label(status)
                                    </span>
                                }
                                <span class="gr-legend__item">
                                    <span class="gr-legend__swatch gr-legend__swatch--rescheduling"></span>
                                    <i class="mdi mdi-calendar-clock gr-legend__icon--rescheduling" aria-hidden="true"></i> Reprogramada desde otra fecha
                                </span>
                                <span class="gr-legend__item">
                                    <span class="gr-legend__swatch gr-legend__swatch--recovery"></span>
                                    <i class="mdi mdi-backup-restore gr-legend__icon--recovery" aria-hidden="true"></i> Reposición de un día suspendido
                                </span>
                                <span class="gr-legend__item">
                                    <span class="gr-legend__swatch gr-legend__swatch--suspended"></span> Día suspendido
                                </span>
                                <span class="gr-legend__item">
                                    <span class="gr-legend__swatch gr-legend__swatch--out"></span> Fuera de la gestión
                                </span>
                                @if (mode)
                                {
                                    <span class="gr-legend__item">
                                        <span class="gr-legend__swatch gr-legend__swatch--group-own"></span> Clase del grupo (esta materia)
                                    </span>
                                    <span class="gr-legend__item">
                                        <span class="gr-legend__swatch gr-legend__swatch--group-busy"></span> Clase de otra materia del grupo
                                    </span>
                                }
                                <span class="gr-legend__note text-muted small">Los estados atenuados no ocupan el ambiente; <i class="mdi mdi-arrow-right-bold" aria-hidden="true"></i> lleva a su nueva ubicación.</span>
                            </div>
                        </div>
                    </div>
                </div>

                @if (mode)
                {
                    var o = origin!;
                    var firstWeek = grid.WeekOptions.First();
                    var lastWeek = grid.WeekOptions.Last();
                    var selectedPeriodId = Model.DestPeriodId ?? o.StartPeriodId;
                    var selectedTeacherId = Model.DestTeacherId ?? o.TeacherPersonId;
                    <aside class="gr-layout__side gr-noprint" aria-label="Panel de reprogramación">
                        <div class="card border-0 shadow-sm rounded-lg gr-rs-panel" id="gr-rs-panel">
                            <div class="card-body p-3">
                                 <h5 class="font-weight-bold text-dark mb-3"><i class="mdi mdi-calendar-clock gr-rs-violet mr-1"></i> @(Model.IsRecoveryMode ? "Reposición de día" : "Reprogramación")</h5>

                                <!-- Ficha del origen (arrastrable si el bloque no está en la vista) -->
                                <div class="gr-rs-card @(Model.OriginInView ? string.Empty : "gr-rs-card--draggable")" id="gr-rs-origin-card"
                                     draggable="@(Model.OriginInView ? null : "true")" tabindex="@(Model.OriginInView ? null : "0")">
                                    <div class="gr-rs-card__eyebrow">Origen @(o.IsCompleted ? "· completada" : string.Empty)</div>
                                    <div class="font-weight-bold text-dark">@o.Code · @o.SubjectName (@o.GroupName)</div>
                                    <div class="small text-muted text-truncate" title="@o.PracticeName">@o.PracticeName</div>
                                    <div class="small mt-1"><i class="far fa-calendar mr-1"></i>@GrillaModel.LongDate(o.Date)</div>
                                    <div class="small"><i class="far fa-clock mr-1"></i>@o.TimeText</div>
                                    <div class="small"><i class="fas fa-flask mr-1"></i>@o.LaboratoryLabel</div>
                                    <div class="small"><i class="fas fa-user-tie mr-1"></i>@o.TeacherName</div>
                                    <div class="gr-rs-card__hint">
                                        @if (Model.OriginInView)
                                        {
                                            <span><i class="mdi mdi-cursor-move"></i> Arrastre el bloque resaltado de la grilla a una celda libre.</span>
                                        }
                                        else
                                        {
                                            <span><i class="mdi mdi-cursor-move"></i> El bloque no está en esta vista: arrastre esta ficha a una celda de la grilla.</span>
                                        }
                                    </div>
                                 </div>

                                 @if (o.CourseGroupId is int && o.SubjectId is int horarioSubjectId && !Model.HasGroupSchedule)
                                 {
                                     <div class="gr-rs-noschedule small mt-2" role="note">
                                         <i class="mdi mdi-information-outline" aria-hidden="true"></i>
                                         El grupo no tiene horario de clases registrado; regístralo en
                                         <a href="@Url.Page("/Catalogs/Subjects/Horario", new { id = horarioSubjectId, managementId = o.ManagementId })">Materias → Horario</a>.
                                     </div>
                                 }

                                  @* "Tomar bloque": pone la planificación en mano para soltarla en cualquier celda (sobrevive al cambio de ambiente) *@
                                 <button type="button" id="gr-rs-pick" class="btn btn-outline-primary btn-sm btn-rounded btn-block mt-2">
                                     <i class="mdi mdi-cursor-move mr-1"></i> Tomar bloque
                                 </button>

                                 @if (Model.IsRecoveryMode)
                                 {
                                     <div class="border-top mt-3 pt-3 gr-rs-pending" aria-label="Bandeja de planificaciones pendientes">
                                         <h6 class="font-weight-bold text-dark">Afectados del @o.Date.ToString("dd/MM") · @Model.RecoveryPending.Count pendiente(s)</h6>
                                         @foreach (var group in Model.RecoveryPending.GroupBy(p => p.Laboratory))
                                         {
                                             <div class="small font-weight-bold text-muted mt-2"><i class="fas fa-flask mr-1"></i>@group.Key</div>
                                             @foreach (var pending in group)
                                             {
                                                 <a asp-page="./Grilla" asp-route-reponer="@pending.Id" asp-route-recoveryId="@Model.RecoveryId"
                                                    asp-route-laboratoryId="@pending.LaboratoryId"
                                                    class="d-block small rounded border px-2 py-1 mb-1 @(pending.Id == o.Id ? "border-warning bg-light" : "")">
                                                     <strong>@pending.Code</strong> · @pending.Subject (@pending.Group) · @pending.Periods
                                                     <span class="d-block text-muted">@pending.Teacher · antes @pending.PreviousStatus</span>
                                                 </a>
                                             }
                                         }
                                         @if (Model.RecoveryPending.Count == 0)
                                         {
                                             <div class="gr-rec-done mt-2"><i class="fas fa-check-circle mr-1"></i> Todas las planificaciones del día fueron repuestas.</div>
                                         }
                                     </div>
                                 }

                                <form method="post" asp-page-handler="Reprogramar" id="gr-rs-form" class="mt-3" novalidate
                                     asp-route-managementId="@management.Id" asp-route-laboratoryId="@lab.Id"
                                       asp-route-week="@grid.SelectedWeekNumber" asp-route-twoWeeks="@twoWeeksRoute" asp-route-reprogramar="@reprogramarRoute" asp-route-reponer="@reponerRoute" asp-route-recoveryId="@Model.RecoveryId">
                                     <input type="hidden" name="Move.PlanningId" value="@o.Id" />
                                     @if (Model.IsRecoveryMode) { <input type="hidden" name="Move.DayRecoveryId" value="@Model.RecoveryId" /> }
                                     @* Reprogramación individual: al confirmar se vuelve a la pantalla de origen (p. ej. conflictos). *@
                                     @if (!Model.IsRecoveryMode && Model.SafeReturnUrl is string modeReturnUrl)
                                     { <input type="hidden" name="ReturnUrl" value="@modeReturnUrl" /> }

                                    <!-- Destino (alternativa sin arrastre) -->
                                    <fieldset class="gr-rs-fieldset">
                                        <legend class="gr-rs-legend">Destino</legend>
                                        <div class="form-row">
                                            <div class="form-group col-7 mb-2">
                                                <label for="gr-rs-date" class="gr-controls__label">Fecha</label>
                                                <input type="date" id="gr-rs-date" name="Move.Date" class="form-control form-control-sm"
                                                       min="@firstWeek.StartDate.ToString("yyyy-MM-dd", inv)" max="@lastWeek.EndDate.ToString("yyyy-MM-dd", inv)"
                                                       value="@Model.DestDate" />
                                            </div>
                                            <div class="form-group col-5 mb-2">
                                                <label for="gr-rs-period" class="gr-controls__label">Periodo inicial</label>
                                                <select id="gr-rs-period" name="Move.StartPeriodId" class="custom-select custom-select-sm">
                                                    @foreach (var p in grid.Periods)
                                                    {
                                                        <option value="@p.Id" selected="@(p.Id == selectedPeriodId)">@PlanningSlot.PeriodsText(p.Order, 1) · @p.Label</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                        <div class="form-group mb-2">
                                            <label for="gr-rs-lab" class="gr-controls__label">Ambiente</label>
                                            <select id="gr-rs-lab" name="Move.LaboratoryId" class="custom-select custom-select-sm">
                                                @foreach (var l in grid.Laboratories)
                                                {
                                                    <option value="@l.Id" selected="@(l.Id == lab.Id)">@l.Label</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="form-group mb-2">
                                            <label for="gr-rs-teacher" class="gr-controls__label">Docente</label>
                                            <select id="gr-rs-teacher" name="Move.TeacherPersonId" class="form-control form-control-sm">
                                                @foreach (var t in Model.Teachers)
                                                {
                                                    <option value="@t.Id" selected="@(t.Id == selectedTeacherId)">@t.Name</option>
                                                }
                                            </select>
                                        </div>
                                        <small class="form-text text-muted mb-2">El bloque se mueve completo: @o.PeriodCount periodo(s).</small>
                                        <button type="button" id="gr-rs-preview-btn" class="btn btn-outline-primary btn-sm btn-rounded btn-block">
                                            <i class="mdi mdi-eye mr-1"></i> Previsualizar
                                        </button>
                                    </fieldset>

                                    <!-- Previsualización (la llena grilla-reprogramar.js con la respuesta del servidor) -->
                                    <div id="gr-rs-preview" class="gr-rs-preview" aria-live="polite">
                                        <div class="gr-rs-preview__empty">
                                            <i class="mdi mdi-hand-pointing-right" aria-hidden="true"></i>
                                            Arrastre el bloque a una celda o elija el destino y pulse <strong>Previsualizar</strong>.
                                        </div>
                                    </div>

                                    <!-- Confirmación: visible cuando el destino quedó fijado sin bloqueos -->
                                    <div id="gr-rs-confirm" class="gr-rs-confirm" hidden>
                                        <div class="form-group mb-2">
                                            <label for="gr-rs-reason" class="gr-controls__label">Motivo <span class="text-danger">*</span></label>
                                            <textarea id="gr-rs-reason" name="Move.Reason" class="form-control form-control-sm" rows="3"
                                                      maxlength="@ReschedulingService.MaxReasonLength" required
                                                      placeholder="Ej.: el docente tiene un congreso ese día">@Model.PreviousReason</textarea>
                                        </div>
                                        <div class="custom-control custom-checkbox mb-2" id="gr-rs-accept-wrap" hidden>
                                            <input type="checkbox" class="custom-control-input" id="gr-rs-accept" />
                                            <label class="custom-control-label font-weight-bold text-dark" for="gr-rs-accept">Acepto las advertencias</label>
                                        </div>
                                        <div id="gr-rs-accepted"></div>
                                        <button type="submit" class="btn btn-block btn-rounded font-weight-bold gr-rs-submit">
                                             <i class="mdi mdi-check mr-1"></i> @(Model.IsRecoveryMode ? "Confirmar reposición" : "Confirmar reprogramación")
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </aside>
                }

                @if (overview != null && !mode)
                {
                    <!-- Panel lateral: afectados del día en reposición (para saltar a otro bloque) -->
                    <aside class="gr-layout__side gr-noprint" aria-label="Planificaciones afectadas por la reposición del día">
                        <div class="card border-0 shadow-sm rounded-lg gr-rs-panel">
                            <div class="card-body p-3">
                                <h5 class="font-weight-bold text-dark mb-1">
                                    <i class="mdi mdi-backup-restore gr-rs-violet mr-1"></i> Afectados del @overview.Date.ToString("dd/MM")
                                </h5>
                                <div class="small text-muted mb-2">@overview.Reason</div>
                                <div class="small font-weight-bold text-dark">@overview.Recovered de @overview.Total repuestas</div>
                                <span class="gr-rec-progress mt-1" aria-hidden="true">
                                    <span class="gr-rec-progress__fill" style="width: @(overview.Total > 0 ? (int)Math.Round(overview.Recovered * 100.0 / overview.Total) : 100)%;"></span>
                                </span>
                                @if (Model.RecoveryPending.Count == 0)
                                {
                                    <div class="gr-rec-done mt-3">
                                        <i class="fas fa-check-circle mr-1"></i> Todas las planificaciones del día fueron repuestas.
                                    </div>
                                }
                                else
                                {
                                    @foreach (var group in Model.RecoveryPending.GroupBy(p => p.Laboratory))
                                    {
                                        <div class="small font-weight-bold text-muted mt-3 mb-1"><i class="fas fa-flask mr-1"></i>@group.Key</div>
                                        @foreach (var pending in group)
                                        {
                                            <div class="gr-rec-item rounded @(Model.Resaltar == pending.Id ? "gr-rec-item--current" : string.Empty)">
                                                <div class="small font-weight-bold text-dark">@pending.Code · @pending.Subject (@pending.Group)</div>
                                                <div class="small text-muted">@pending.Teacher · @pending.Periods · antes @pending.PreviousStatus</div>
                                                <a asp-page="./Grilla" asp-route-reponer="@pending.Id" asp-route-recoveryId="@overview.Id"
                                                   asp-route-laboratoryId="@pending.LaboratoryId" asp-route-managementId="@management.Id"
                                                   class="btn btn-sm btn-outline-warning btn-rounded mt-1">
                                                    <i class="mdi mdi-arrow-right-bold mr-1"></i>Reubicar
                                                </a>
                                            </div>
                                        }
                                    }
                                }
                            </div>
                        </div>
                    </aside>
                }
            </div>
        }
    }
</div>

<!-- Menú contextual de los bloques (uno solo, posicionado junto al botón "⋮") -->
<div id="gr-block-menu" class="dropdown-menu gr-ctx-menu" role="menu" aria-hidden="true"></div>

@if (mode && grid?.Laboratory != null && grid.HasWeeks)
{
    var rsConfig = new
    {
        planningId = origin!.Id,
        code = origin.Code,
        subject = origin.SubjectName,
        periodCount = origin.PeriodCount,
        originDate = origin.Date.ToString("yyyy-MM-dd", inv),
        originStartOrder = origin.StartOrder,
        originLabId = origin.LaboratoryId,
        originTeacherId = origin.TeacherPersonId,
        maxOrder = grid.Periods.Count > 0 ? grid.Periods.Max(p => p.Order) : PlanningSlot.MaxPeriods,
        validateUrl = Url.Page("/Api/SlotValidation"),
        periods = grid.Periods.Select(p => new { id = p.Id, order = p.Order, label = p.Label }),
        labs = grid.Laboratories.Select(l => new { id = l.Id, label = l.Label }),
        groupSlots = Model.GroupSlots.Select(s => new { weekday = s.Weekday, order = s.PeriodOrder }),
        siblingClasses = Model.GroupSiblings.Select(s => new { weekday = s.Weekday, order = s.PeriodOrder, subject = s.SubjectName, group = s.GroupName }),
        groupName = origin.GroupName,
        hasGroupSchedule = Model.HasGroupSchedule,
        completedText = "Esta planificación ya está completada. ¿Seguro que desea reprogramarla?",
        recovery = Model.IsRecoveryMode,
        recoveryId = Model.RecoveryId,
        initial = !string.IsNullOrWhiteSpace(Model.DestDate) && Model.DestPeriodId.HasValue
            ? new { date = Model.DestDate, periodId = Model.DestPeriodId.Value }
            : null
    };
    <script type="application/json" id="gr-rs-config">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(rsConfig))</script>
}

@section Scripts {
    <script src="~/assets/libs/select2/dist/js/select2.full.min.js"></script>
    <script>
        (function () {
            var form = document.getElementById('gr-controls');
            if (!form) return;

            function submitControls() {
                HTMLFormElement.prototype.submit.call(form);
            }

            var management = document.getElementById('gr-management');
            if (management) {
                management.addEventListener('change', function () {
                    // La numeración de semanas es propia de cada gestión: se elige la semana por defecto.
                    var week = document.getElementById('gr-week');
                    if (week) week.disabled = true;
                    submitControls();
                });
            }

            var lab = $('#gr-lab');
            if (lab.length && $.fn.select2) {
                lab.select2({
                    width: '100%',
                    language: { noResults: function () { return 'Sin coincidencias'; } }
                });
            }
            lab.on('change', submitControls);

            var week = document.getElementById('gr-week');
            if (week) week.addEventListener('change', submitControls);

            var twoWeeks = document.getElementById('gr-two-weeks');
            if (twoWeeks) twoWeeks.addEventListener('change', submitControls);

            var print = document.getElementById('gr-print');
            if (print) print.addEventListener('click', function () { window.print(); });
        })();
    </script>
    <script src="~/js/conflict-tags.js" asp-append-version="true"></script>
    <script src="~/js/grilla-reprogramar.js" asp-append-version="true"></script>
}
