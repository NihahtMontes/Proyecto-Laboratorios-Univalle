@page
@model Proyecto_Laboratorios_Univalle.Pages.LaboratoryOperations.CalendarioModel
@{ ViewData["Title"] = "Calendario de laboratorios"; }

<div class="page-breadcrumb">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h4 class="page-title text-uppercase text-primary font-weight-bold mb-0">OPERACIÓN DE LABORATORIOS</h4>
            <h2 class="font-weight-bold text-dark">Calendario de laboratorios</h2>
            <div class="text-muted small">Navega por las planificaciones académicas; cada tarjeta abre el siguiente paso del flujo L-3/L-5.</div>
        </div>
    </div>
</div>

<div class="container-fluid mt-3">
    @if (!Model.HasPlanning)
    {
        <div class="card border-0 shadow-sm rounded-lg">
            <div class="card-body text-center py-5">
                <i class="fas fa-calendar-plus fa-4x text-muted mb-3"></i>
                <h4 class="font-weight-bold text-dark">Aún no hay planificaciones académicas</h4>
                <p class="text-muted mb-4">Crea la primera planificación para generar las semanas lectivas y registrar prácticas en el calendario.</p>
                <a asp-page="./Planificacion" class="btn btn-primary btn-rounded px-4 font-weight-bold">
                    <i class="mdi mdi-plus mr-1"></i> Crear planificación
                </a>
            </div>
        </div>
    }
    else
    {
        var planningId = Model.Planning!.Id;

        <!-- Barra superior: selector de planificación + acciones -->
        <div class="card border-0 shadow-sm rounded-lg mb-3">
            <div class="card-body py-3">
                <div class="form-row align-items-center">
                    <div class="col-md-6 mb-2 mb-md-0">
                        <form method="get" class="m-0">
                            <label asp-for="PlanningId" class="small font-weight-bold text-muted mb-1">Planificación</label>
                            <select asp-for="PlanningId" asp-items="Model.PlanningList" class="form-control select2" id="planningSelect"></select>
                        </form>
                    </div>
                    <div class="col-auto ml-auto d-flex flex-wrap">
                        <a asp-page="./Planificacion" class="btn btn-outline-primary btn-rounded font-weight-bold px-3 mr-2 mb-2 mb-md-0">
                            <i class="mdi mdi-plus mr-1"></i> Nueva planificación
                        </a>
                        <a asp-page="./Planificacion" asp-route-id="@planningId" class="btn btn-primary btn-rounded font-weight-bold px-3">
                            <i class="fas fa-edit mr-1"></i> Editar planificación
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tarjeta resumen de la planificación -->
        <div class="card border-0 shadow-sm rounded-lg mb-3">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-3">
                    <div class="rounded-circle bg-light-primary text-primary p-3 mr-3"><i class="fas fa-university fa-lg"></i></div>
                    <div class="flex-grow-1">
                        <h5 class="font-weight-bold text-primary mb-1">@Model.Planning.Code</h5>
                        <small class="text-muted">@Model.Planning.Name</small>
                    </div>
                </div>
                <div class="row">
                    <div class="form-group col-md-3 mb-2">
                        <label class="small font-weight-bold text-muted">Gestión</label>
                        <input class="form-control" value="@Model.Planning.ManagementCode" disabled />
                    </div>
                    <div class="form-group col-md-4 mb-2">
                        <label class="small font-weight-bold text-muted">Facultad</label>
                        <input class="form-control" value="@Model.Planning.FacultyName" disabled />
                    </div>
                    <div class="form-group col-md-5 mb-2">
                        <label class="small font-weight-bold text-muted">Carrera</label>
                        <input class="form-control" value="@Model.Planning.CareerName" disabled />
                    </div>
                    <div class="form-group col-md-6 mb-2">
                        <label class="small font-weight-bold text-muted">Fecha de inicio</label>
                        <input class="form-control" value="@Model.Planning.StartDate.ToString("dd/MM/yyyy")" disabled />
                    </div>
                    <div class="form-group col-md-6 mb-2">
                        <label class="small font-weight-bold text-muted">Fecha de fin</label>
                        <input class="form-control" value="@Model.Planning.EndDate.ToString("dd/MM/yyyy")" disabled />
                    </div>
                    <div class="form-group col-md-6 mb-2">
                        <label class="small font-weight-bold text-muted">Semanas académicas</label>
                        <input class="form-control" value="@Model.Planning.WeekCount" disabled />
                    </div>
                    <div class="form-group col-md-6 mb-2">
                        <label class="small font-weight-bold text-muted">Prácticas activas</label>
                        <input class="form-control" value="@Model.Planning.PracticeCount" disabled />
                    </div>
                </div>
            </div>
        </div>

        <!-- Navegación de meses -->
        <div class="card border-0 shadow-sm rounded-lg mb-3">
            <div class="card-body py-3">
                <div class="d-flex flex-wrap align-items-center">
                    <div class="d-flex align-items-center">
                        @if (!string.IsNullOrEmpty(Model.PreviousMonth))
                        {
                            <a asp-page="./Calendario" asp-route-planningId="@planningId" asp-route-month="@Model.PreviousMonth"
                               class="btn btn-outline-secondary btn-rounded btn-sm mr-2" title="Mes anterior" aria-label="Mes anterior">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-secondary btn-rounded btn-sm mr-2" disabled aria-label="Mes anterior">
                                <i class="fas fa-chevron-left"></i>
                            </button>
                        }
                        <h5 class="font-weight-bold text-dark mb-0 mx-2 pl-month-title">@Model.MonthLabel</h5>
                        @if (!string.IsNullOrEmpty(Model.NextMonth))
                        {
                            <a asp-page="./Calendario" asp-route-planningId="@planningId" asp-route-month="@Model.NextMonth"
                               class="btn btn-outline-secondary btn-rounded btn-sm ml-2" title="Mes siguiente" aria-label="Mes siguiente">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-secondary btn-rounded btn-sm ml-2" disabled aria-label="Mes siguiente">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        }
                    </div>
                    <div class="ml-auto mt-2 mt-md-0">
                        <span class="badge badge-light border px-3 py-2">
                            <i class="fas fa-flask mr-1 text-primary"></i>
                            <strong>@Model.PracticesInMonth</strong> prácticas en el mes
                        </span>
                    </div>
                </div>
                <div class="pl-month-pills mt-3" role="navigation" aria-label="Meses de la planificación">
                    @foreach (var m in Model.Months)
                    {
                        <a asp-page="./Calendario" asp-route-planningId="@planningId" asp-route-month="@m.Value"
                           class="pl-month-pill @(m.Selected ? "pl-month-pill--active" : string.Empty)"
                           aria-current="@(m.Selected ? "true" : "false")">@m.Label</a>
                    }
                </div>
            </div>
        </div>

        <!-- Semanas académicas -->
        @if (Model.Weeks.Count == 0)
        {
            <div class="card border-0 shadow-sm rounded-lg">
                <div class="card-body text-center py-5">
                    <i class="far fa-calendar fa-3x text-muted mb-3"></i>
                    <h5 class="font-weight-bold text-dark">No hay semanas académicas en este mes</h5>
                    <p class="text-muted mb-0">Cambia de mes o revisa la planificación para verificar el rango de fechas.</p>
                </div>
            </div>
        }
        else
        {
            @foreach (var week in Model.Weeks)
            {
                <div class="card border-0 shadow-sm rounded-lg mb-3 @(week.IsLective ? string.Empty : "pl-week--non-lective")">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center mb-3 flex-wrap">
                            <div class="rounded-circle bg-light-primary text-primary p-2 mr-3"><i class="fas fa-calendar-week"></i></div>
                            <div>
                                <h6 class="font-weight-bold text-primary mb-0">Semana académica @week.Number</h6>
                                <small class="text-muted">@week.StartDate.ToString("dd/MM") – @week.EndDate.ToString("dd/MM")</small>
                            </div>
                            @if (!week.IsLective)
                            {
                                <div class="ml-auto text-right">
                                    <span class="badge badge-secondary px-3 py-2">No lectiva</span>
                                    @if (!string.IsNullOrWhiteSpace(week.Note))
                                    {
                                        <div class="small text-muted mt-1">@week.Note</div>
                                    }
                                </div>
                            }
                        </div>

                        <div class="pl-week-grid">
                            @foreach (var day in week.Days)
                            {
                                <div class="pl-day @(day.InMonth ? string.Empty : "pl-day--out")">
                                    <div class="pl-day__head">
                                        <strong class="pl-day__name">@day.Name</strong>
                                        <span class="pl-day__date">@day.Date.ToString("dd/MM")</span>
                                    </div>
                                    <div class="pl-day__body">
                                        @if (day.Practices.Count == 0)
                                        {
                                            <div class="pl-empty">Sin prácticas</div>
                                            @if (day.CanAdd)
                                            {
                                                <a asp-page="./Practica" asp-route-planningId="@planningId" asp-route-weekId="@week.Id" asp-route-day="@day.Weekday"
                                                   class="btn btn-sm btn-outline-primary btn-rounded pl-add">
                                                    <i class="fas fa-plus mr-1"></i> Práctica
                                                </a>
                                            }
                                        }
                                        else
                                        {
                                            @foreach (var p in day.Practices)
                                            {
                                                <a href="@p.NextUrl" class="pl-card" title="Abrir práctica @p.Code">
                                                    <div class="pl-card__time">@p.Start.ToString("HH:mm")–@p.End.ToString("HH:mm")</div>
                                                    <div class="pl-card__title">@p.PracticeName</div>
                                                    <div class="pl-card__sub"><i class="fas fa-book mr-1"></i>@p.SubjectName</div>
                                                    <div class="pl-card__sub"><i class="fas fa-flask mr-1"></i>@p.LaboratoryName</div>
                                                    <div class="pl-card__sub"><i class="fas fa-users mr-1"></i>Grupo @p.GroupName</div>
                                                    <div class="pl-card__sub"><i class="fas fa-user-tie mr-1"></i>@p.TeacherName</div>
                                                    <div class="pl-card__foot">
                                                        <span class="badge badge-@p.StatusCss">@p.Status</span>
                                                        <span class="pl-card__code">@p.Code</span>
                                                    </div>
                                                </a>
                                            }
                                            @if (day.CanAdd)
                                            {
                                                <a asp-page="./Practica" asp-route-planningId="@planningId" asp-route-weekId="@week.Id" asp-route-day="@day.Weekday"
                                                   class="btn btn-sm btn-outline-primary btn-rounded pl-add">
                                                    <i class="fas fa-plus mr-1"></i> Práctica
                                                </a>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    }
</div>

@section Styles {
    <link href="~/assets/libs/select2/dist/css/select2.min.css" rel="stylesheet">
    <style>
        .bg-light-primary { background-color: #e8e7ff; }
        .pl-month-title { text-transform: capitalize; }

        .pl-month-pills { display: flex; flex-wrap: wrap; gap: 6px; }
        .pl-month-pill {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 999px;
            border: 1px solid #e0e0e0;
            background: #fff;
            color: #555;
            font-size: 12px;
            font-weight: 600;
            text-transform: capitalize;
            transition: all .2s;
        }
        .pl-month-pill:hover { background: #f4f3ff; color: #7460ee; border-color: #c7c2f0; text-decoration: none; }
        .pl-month-pill--active { background: #7460ee; border-color: #7460ee; color: #fff; }
        .pl-month-pill--active:hover { background: #5d4dd1; color: #fff; }

        .pl-week--non-lective { background: #fafafa; }
        .pl-week--non-lective .pl-day__head { background: #f1f1f1; }

        .pl-week-grid {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 10px;
        }
        .pl-day {
            background: #fff;
            border: 1px solid #ececec;
            border-radius: 8px;
            min-height: 150px;
            display: flex;
            flex-direction: column;
        }
        .pl-day--out { opacity: 0.45; }
        .pl-day__head {
            background: #f4f3ff;
            color: #555;
            padding: 6px 10px;
            border-bottom: 1px solid #ececec;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 12px;
        }
        .pl-day__name { color: #7460ee; }
        .pl-day__date { font-weight: 600; }
        .pl-day__body { padding: 8px; display: flex; flex-direction: column; gap: 6px; flex: 1; }

        .pl-empty { font-size: 11px; color: #b3b3b3; font-style: italic; }

        .pl-card {
            display: block;
            background: #fff;
            border: 1px solid #ececec;
            border-left: 3px solid #7460ee;
            border-radius: 6px;
            padding: 6px 8px;
            text-decoration: none;
            color: #333;
            font-size: 12px;
            transition: all .2s;
        }
        .pl-card:hover { background: #faf9ff; box-shadow: 0 2px 6px rgba(116,96,238,.15); text-decoration: none; color: #333; }
        .pl-card__time { color: #7460ee; font-weight: 700; font-size: 11px; }
        .pl-card__title { font-weight: 700; color: #1a1a1a; margin: 1px 0 2px 0; line-height: 1.2; }
        .pl-card__sub { color: #777; line-height: 1.25; font-size: 11px; }
        .pl-card__foot { display: flex; justify-content: space-between; align-items: center; margin-top: 4px; }
        .pl-card__code { color: #999; font-size: 10px; font-weight: 600; }

        .pl-add { align-self: flex-start; font-size: 11px; padding: 2px 8px; }

        @@media (max-width: 768px) {
            .pl-week-grid { grid-template-columns: 1fr; }
        }
    </style>
}

@section Scripts {
    <script src="~/assets/libs/select2/dist/js/select2.full.min.js"></script>
    <script>
        (function () {
            $('#planningSelect').select2({
                width: '100%',
                language: { noResults: function () { return 'Sin coincidencias'; } }
            }).on('change', function () {
                $(this).closest('form').trigger('submit');
            });
        })();
    </script>
}
