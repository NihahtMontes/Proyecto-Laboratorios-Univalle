@page
@model Proyecto_Laboratorios_Univalle.Pages.LaboratoryOperations.CalendarioModel
@{ ViewData["Title"] = "Calendario de laboratorios"; }

<div class="page-breadcrumb"><div class="row"><div class="col-12"><h4 class="page-title text-uppercase text-primary font-weight-bold mb-0">AGENDA OPERATIVA</h4><h2 class="font-weight-bold text-dark">Calendario de laboratorios</h2><div class="text-muted small">Eventos cargados desde las planificaciones L-3 persistidas; cada evento abre su siguiente paso en el flujo.</div></div></div></div>

<div class="container-fluid mt-3">
    <div class="card border-0 shadow-sm rounded-lg mb-3"><div class="card-body py-3"><form method="get" class="form-row align-items-center"><div class="col-auto"><label asp-for="LaboratoryId" class="small font-weight-bold mb-0 mr-2">LABORATORIO:</label></div><div class="col-md-4"><select asp-for="LaboratoryId" asp-items="Model.LaboratoryList" class="custom-select custom-select-sm"><option value="">Todos los laboratorios</option></select></div><div class="col-auto"><button type="submit" class="btn btn-sm btn-primary btn-rounded"><i class="fas fa-filter mr-1"></i> Filtrar</button></div><div class="col-auto ml-auto"><span class="badge badge-success mr-1">Aprobada</span><span class="badge badge-warning mr-1">Planificada</span><span class="badge badge-dark">Finalizada</span></div></form></div></div>
    <div class="card border-0 shadow-sm rounded-lg"><div class="card-body p-3"><div id="lab-calendar"></div></div></div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/assets/libs/fullcalendar/dist/fullcalendar.min.css" />
}

@section Scripts {
    <script src="~/assets/libs/moment/min/moment.min.js"></script>
    <script src="~/assets/libs/fullcalendar/dist/fullcalendar.min.js"></script>
    <script>
        $(function () {
            var events = @Html.Raw(Model.EventsJson);
            $('#lab-calendar').fullCalendar({
                defaultView: 'agendaWeek',
                height: 650,
                header: { left: 'prev,next today', center: 'title', right: 'month,agendaWeek,agendaDay' },
                buttonText: { today: 'Hoy', month: 'Mes', week: 'Semana', day: 'Día' },
                allDayText: 'Todo el día',
                events: events,
                eventClick: function (event) {
                    Swal.fire({
                        icon: 'info',
                        title: event.title,
                        html: '<strong>Laboratorio:</strong> ' + $('<div>').text(event.lab).html() + '<br><strong>Responsable:</strong> ' + $('<div>').text(event.responsible).html() + '<br><strong>Estado:</strong> ' + $('<div>').text(event.status).html(),
                        confirmButtonColor: '#2962ff'
                    });
                    return false;
                }
            });
        });
    </script>
}
