@page
@model Proyecto_Laboratorios_Univalle.Pages.LaboratoryOperations.DisponibilidadModel
@{ ViewData["Title"] = "Disponibilidad — Paso 3"; }

<div class="page-breadcrumb">
    <div class="row">
        <div class="col-12">
            <h4 class="page-title text-uppercase text-primary font-weight-bold mb-0">PASO 3 · @Model.Code</h4>
            <h2 class="font-weight-bold text-dark">Verificación de disponibilidad</h2>
            @if (Model.Plan != null)
            {
                <div class="text-muted small">
                    @(Model.Plan.Laboratory?.Name) · @(Model.Plan.Subject?.Name) · @(Model.Plan.Group?.Name) ·
                    @Model.Plan.ScheduledDate.ToString("dd/MM/yyyy HH:mm")
                </div>
            }
        </div>
    </div>
</div>

<div class="container-fluid mt-3">
    @await Html.PartialAsync("../LaboratoryOperations/_StepsBar", 3)

    @if (Model.HasConflict)
    {
        <div class="alert alert-danger border-0 rounded d-flex align-items-center mb-4">
            <i class="fas fa-exclamation-triangle fa-2x mr-3"></i>
            <div>
                <strong>Hay un conflicto de disponibilidad.</strong><br />
                <span>Reduce las cantidades o vuelve al paso anterior para ajustarlas antes de continuar.</span>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-success border-0 rounded d-flex align-items-center mb-4">
            <i class="fas fa-check-circle fa-2x mr-3"></i>
            <div>
                <strong>Todo está disponible.</strong><br />
                <span>La práctica puede aprobarse para iniciar la operación.</span>
            </div>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-lg">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="font-weight-bold text-primary mb-0">DETALLE DE DISPONIBILIDAD</h5>
                <span class="badge badge-light border">@Model.Items.Count ítem(s)</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th>MATERIAL</th>
                            <th class="text-center">SOLICITADO</th>
                            <th class="text-center">DISPONIBLE</th>
                            <th class="text-center">BALANCE</th>
                            <th>ESTADO</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Items)
                        {
                            <tr class="@(row.Ok ? "" : "table-danger")">
                                <td class="font-weight-bold">@row.EquipmentName</td>
                                <td class="text-center">@row.Requested</td>
                                <td class="text-center">@row.Available</td>
                                <td class="text-center font-weight-bold @(row.Ok ? "text-success" : "text-danger")">
                                    @(row.Difference > 0 ? "+" : "")@row.Difference
                                </td>
                                <td>
                                    @if (row.Ok)
                                    {
                                        <span class="badge badge-success rounded-pill">Disponible</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger rounded-pill">Faltante</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                @if (Model.HasConflict)
                {
                    <a asp-page="./Requerimientos" asp-route-planId="@Model.PlanId" asp-route-conflict="true"
                       class="btn btn-warning btn-rounded font-weight-bold px-4">
                        <i class="mdi mdi-arrow-left mr-1"></i> Volver a requerimientos
                    </a>
                    <button type="button" class="btn btn-secondary btn-rounded" disabled>
                        <i class="fas fa-lock mr-1"></i> Aprobar bloqueado
                    </button>
                }
                else if (Model.IsApproved)
                {
                    <a asp-page="./Requerimientos" asp-route-planId="@Model.PlanId"
                       class="btn btn-outline-secondary btn-rounded px-4">
                        <i class="mdi mdi-arrow-left mr-1"></i> Atrás
                    </a>
                    <a asp-page="./L3" asp-route-id="@Model.PlanId"
                       class="btn btn-primary btn-rounded font-weight-bold px-4">
                        Continuar en L-3 <i class="mdi mdi-arrow-right ml-1"></i>
                    </a>
                }
                else
                {
                    <a asp-page="./Requerimientos" asp-route-planId="@Model.PlanId"
                       class="btn btn-outline-secondary btn-rounded px-4">
                        <i class="mdi mdi-arrow-left mr-1"></i> Ajustar requerimientos
                    </a>
                    <form method="post" asp-page-handler="Approve" asp-route-planId="@Model.PlanId" class="d-inline" id="form-approve">
                        <button type="submit" class="btn btn-success btn-rounded font-weight-bold px-4 js-approve-confirm">
                            <i class="mdi mdi-check mr-1"></i> Aprobar y pasar a L-3
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('form-approve');
            if (!form) return;
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                if (typeof Swal === 'undefined') {
                    HTMLFormElement.prototype.submit.call(form);
                    return;
                }
                Swal.fire({
                    title: '¿Aprobar práctica?',
                    text: 'Se confirmará la disponibilidad y la práctica pasará al paso L-3.',
                    type: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, aprobar',
                    cancelButtonText: 'Cancelar',
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#6c757d'
                }).then(function (result) {
                    if (result && (result.isConfirmed === true || result.value === true)) {
                        HTMLFormElement.prototype.submit.call(form);
                    }
                });
            });
        })();
    </script>
}