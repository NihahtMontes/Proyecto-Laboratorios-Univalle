@page
@model Proyecto_Laboratorios_Univalle.Pages.LaboratoryOperations.DisponibilidadModel
@{ ViewData["Title"] = "Disponibilidad de materiales"; }

<div class="page-breadcrumb">
    <div class="row"><div class="col-12"><h4 class="page-title text-uppercase text-primary font-weight-bold mb-0">PASO 3 · @Model.Plan?.Code</h4><h2 class="font-weight-bold text-dark">Verificación de disponibilidad</h2><div class="text-muted small">Confirma que los requerimientos pueden atenderse antes de operar la práctica.</div></div></div>
</div>

<div class="container-fluid mt-3">
    @await Html.PartialAsync("../LaboratoryOperations/_StepsBar", 3)

    @if (Model.HasConflict)
    {
        <div class="alert alert-danger border-0 rounded d-flex align-items-center"><i class="fas fa-exclamation-triangle fa-2x mr-3"></i><div><strong>Hay un conflicto de disponibilidad.</strong><br /><span>Reduce las cantidades o vuelve al paso anterior para corregirlas.</span></div></div>
    }
    else
    {
        <div class="alert alert-success border-0 rounded d-flex align-items-center"><i class="fas fa-check-circle fa-2x mr-3"></i><div><strong>Todo está disponible.</strong><br /><span>La planificación puede aprobarse para iniciar la operación.</span></div></div>
    }

    <div class="card border-0 shadow-sm rounded-lg">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3"><h5 class="font-weight-bold text-primary mb-0">DETALLE DE DISPONIBILIDAD</h5><span class="badge badge-light border">@Model.Rows.Count ítem(s)</span></div>
            <div class="table-responsive">
                <table class="table table-hover mb-0"><thead class="bg-dark text-white"><tr><th>MATERIAL</th><th>UNIDAD</th><th class="text-center">SOLICITADO</th><th class="text-center">DISPONIBLE</th><th class="text-center">BALANCE</th><th>ESTADO</th></tr></thead><tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr class="@(row.Difference < 0 ? "table-danger" : "")"><td class="font-weight-bold">@row.Name</td><td>@row.Unit</td><td class="text-center">@row.Requested</td><td class="text-center">@row.Available</td><td class="text-center font-weight-bold @(row.Difference < 0 ? "text-danger" : "text-success")">@(row.Difference > 0 ? "+" : "")@row.Difference</td><td><span class="badge badge-@(row.Difference < 0 ? "danger" : "success") rounded-pill">@(row.Difference < 0 ? "Insuficiente" : "Disponible")</span></td></tr>
                }
                </tbody></table>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                <a asp-page="./Requerimientos" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-rounded px-4"><i class="mdi mdi-arrow-left mr-1"></i> Ajustar requerimientos</a>
                @if (Model.HasConflict)
                {
                    <button type="button" class="btn btn-secondary btn-rounded" disabled><i class="fas fa-lock mr-1"></i> Aprobar bloqueado</button>
                }
                else
                {
                    <form method="post" asp-page-handler="Approve" asp-route-id="@Model.Id"><button type="submit" class="btn btn-success btn-rounded font-weight-bold px-4"><i class="mdi mdi-check mr-1"></i> Aprobar y pasar a L-3</button></form>
                }
            </div>
        </div>
    </div>
</div>
