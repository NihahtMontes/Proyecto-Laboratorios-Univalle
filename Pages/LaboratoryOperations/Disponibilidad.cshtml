@page
@model Proyecto_Laboratorios_Univalle.Pages.LaboratoryOperations.DisponibilidadModel
@{ ViewData["Title"] = "Disponibilidad — Paso 3"; }

<div class="page-breadcrumb">
    <div class="row">
        <div class="col-12">
            <h4 class="page-title text-uppercase text-primary font-weight-bold mb-0">PASO 3 · <span class="text-dark">L3-@Model.PlanId</span></h4>
            <h2 class="font-weight-bold text-dark">Verificación de Disponibilidad</h2>
            <div class="text-muted small">
                @if (Model.PlanActivo != null)
                {
                    @(Model.PlanActivo.Laboratory?.Name) @: · @(Model.PlanActivo.Subject?.Name) · @(Model.PlanActivo.Teacher?.FirstName) @(Model.PlanActivo.Teacher?.LastName)
                }
            </div>
        </div>
    </div>
</div>

<div class="container-fluid mt-3">
    @await Html.PartialAsync("../LaboratoryOperations/_StepsBar", 3)

    @* ── ALERTAS ── *@
    @if (Model.HasConflict)
    {
        <div class="alert alert-danger border-0 rounded d-flex align-items-center mb-4">
            <i class="mdi mdi-alert-circle mdi-36px mr-3"></i>
            <div>
                <strong>¡Conflicto de disponibilidad!</strong><br>
                Uno o más utensilios no tienen stock suficiente. Corrige los ítems marcados en rojo volviendo al Paso 2.
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-success border-0 rounded d-flex align-items-center mb-4">
            <i class="mdi mdi-check-circle mdi-36px mr-3"></i>
            <div>
                <strong>¡Todo disponible!</strong><br>
                Todos los utensilios requeridos tienen stock suficiente. Puedes aprobar la reserva.
            </div>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-lg">
        <div class="card-body p-4">
            <h6 class="font-weight-bold text-primary mb-3">DETALLE DE DISPONIBILIDAD</h6>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th class="border-0">UTENSILIO</th>
                            <th class="border-0 text-center">INVENTARIO</th>
                            <th class="border-0 text-center">SOLICITADO</th>
                            <th class="border-0 text-center">DISPONIBLE</th>
                            <th class="border-0 text-center">DIFERENCIA</th>
                            <th class="border-0 text-center">ESTADO</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr class="@(!item.Ok ? "table-danger" : "")">
                                <td class="align-middle font-weight-bold">@item.Nombre</td>
                                <td class="align-middle text-center"><span class="badge badge-secondary">@item.Inventario</span></td>
                                <td class="align-middle text-center">@item.Solicitado</td>
                                <td class="align-middle text-center">@item.Disponible</td>
                                <td class="align-middle text-center font-weight-bold @(item.Ok ? "text-success" : "text-danger")">
                                    @(item.Ok ? "+" : "")@item.Diferencia
                                </td>
                                <td class="align-middle text-center">
                                    @if (item.Ok)
                                    {
                                        <span class="badge badge-success px-3 py-2 rounded-pill">Disponible</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger px-3 py-2 rounded-pill">Sin stock</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* ── BOTONES ── *@
    <div class="d-flex justify-content-between mt-4">
        @if (Model.HasConflict)
        {
            <a asp-page="/LaboratoryOperations/Requerimientos" asp-route-planId="@Model.PlanId" asp-route-conflict="true"
               class="btn btn-warning font-weight-bold px-4 py-2">
                <i class="mdi mdi-arrow-left mr-1"></i> Volver a Requerimientos
            </a>
            <span class="text-danger align-self-center small">
                <i class="mdi mdi-information mr-1"></i> Resuelve los conflictos antes de aprobar.
            </span>
        }
        else
        {
            <a asp-page="/LaboratoryOperations/Requerimientos" asp-route-planId="@Model.PlanId"
               class="btn btn-outline-secondary px-4 py-2">
                <i class="mdi mdi-arrow-left mr-1"></i> Atrás
            </a>
            <form method="post" asp-page-handler="Approve">
                <input type="hidden" name="planId" value="@Model.PlanId" />
                <button type="submit" class="btn btn-success font-weight-bold px-5 py-2">
                    <i class="mdi mdi-check mr-1"></i> Aprobar Reserva
                </button>
            </form>
        }
    </div>
</div>
