@page
@model Proyecto_Laboratorios_Univalle.Pages.LaboratoryOperations.DisponibilidadModel
@using Proyecto_Laboratorios_Univalle.Pages.LaboratoryOperations
@using Proyecto_Laboratorios_Univalle.Services
@{
    ViewData["Title"] = "Disponibilidad";
    ViewData["Section"] = "Planificación académica";
    var canApprove = !Model.IsApproved && !(Model.Context?.IsReadOnly ?? false);
    var hasWarnings = Model.HasShortage || Model.HasUnregistered;
    var selectedOriginId = Model.OriginLabId ?? 0;
    var needsAck = Model.HasShortage || (Model.PracticeIssues?.Count ?? 0) > 0;

    // Agrupamos prácticas y demandas por día para iterar en orden dentro de la grilla.
    var practicesByDay = Model.Week != null
        ? Model.Week.Practices
            .GroupBy(p => p.Date.Date)
            .ToDictionary(g => g.Key, g => g.OrderBy(p => p.StartTime ?? TimeSpan.Zero).ToList())
        : new Dictionary<DateTime, List<WeekPractice>>();
    var demandsByDay = Model.Week != null
        ? Model.Week.Demands
            .GroupBy(d => d.Date.Date)
            .ToDictionary(g => g.Key, g => g.OrderByDescending(x => x.HasIssue).ThenBy(x => x.ArticleName).ToList())
        : new Dictionary<DateTime, List<ArticleDayDemand>>();
    var dayNames = new Dictionary<DayOfWeek, string>
    {
        { DayOfWeek.Monday, "Lunes" }, { DayOfWeek.Tuesday, "Martes" },
        { DayOfWeek.Wednesday, "Miércoles" }, { DayOfWeek.Thursday, "Jueves" },
        { DayOfWeek.Friday, "Viernes" }, { DayOfWeek.Saturday, "Sábado" },
        { DayOfWeek.Sunday, "Domingo" }
    };

    var anyConflict = (Model.Week?.ConflictCount ?? 0) > 0;
    var anyRotation = (Model.Week?.RotationCount ?? 0) > 0;
    var practiceHasConflict = Model.PracticeIssues != null && Model.PracticeIssues.Any(i => i.State == DemandState.Conflict);
    var practiceHasOnlyRotation = !practiceHasConflict && Model.PracticeIssues != null && Model.PracticeIssues.Any(i => i.State == DemandState.Rotation);
}

<div class="container-fluid mt-3">
    @if (Model.Context != null)
    {
        <partial name="_PlanningContext" model="Model.Context" />


        @if (Model.Context.IsReadOnly)
        {
            <div class="alert alert-warning border-0 rounded d-flex align-items-center mb-4">
                <i class="fas fa-eye fa-2x mr-3"></i>
                <div>
                    <strong>Solo consulta.</strong><br />
                    <span>La gestión no admite aprobar esta planificación; el detalle de disponibilidad se conserva para auditoría.</span>
                </div>
            </div>
        }

        <div class="card border-0 shadow-sm rounded-lg mb-4">
            <div class="card-body p-3 p-md-4">
                <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
                    <div>
                        <span class="text-uppercase small text-primary font-weight-bold">Comparar contra</span>
                        <h6 class="font-weight-bold text-dark mb-0 mt-1">Stock disponible (total o por laboratorio)</h6>
                        @if (!string.IsNullOrEmpty(Model.OriginName))
                        {
                            <small class="text-muted">Seleccionado: <strong>@Model.OriginName</strong></small>
                        }
                    </div>
                    <form method="get" class="m-0" id="form-origin">
                        <input type="hidden" name="planId" value="@Model.PlanId" />
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-white border-right-0"><i class="fas fa-warehouse text-primary"></i></span>
                            </div>
                            <select name="originLabId" asp-items="Model.OriginList" class="form-control select2" id="origin-select">
                                <option value="0">Total institucional (todos los laboratorios)</option>
                            </select>
                            <div class="input-group-append">
                                <button type="submit" class="btn btn-primary font-weight-bold">
                                    <i class="fas fa-sync-alt mr-1"></i> Recalcular
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                @if (Model.IsApproved)
                {
                    <div class="alert alert-success border-0 rounded d-flex align-items-center mb-0">
                        <i class="fas fa-check-circle fa-2x mr-3"></i>
                        <div>
                            <strong>La planificación está aprobada.</strong><br />
                            <span>El detalle siguiente se conserva como auditoría. La entrega y los incidentes se registran como proceso aparte.</span>
                        </div>
                    </div>
                }
                else if (hasWarnings)
                {
                    <div class="alert alert-warning border-0 rounded d-flex align-items-start mb-0">
                        <i class="fas fa-exclamation-triangle fa-2x mr-3 mt-1"></i>
                        <div>
                            <strong>Atención: revisá el detalle antes de aprobar.</strong><br />
                            <span>
                                La solicitud <strong>solo advierte</strong> y se puede aprobar aunque falte cobertura: la salida de artículos es la que se bloqueará si no alcanza el stock disponible.
                                @if (Model.HasUnregistered)
                                {
                                    <span><br />Los artículos <strong>sin registro de stock</strong> se entregarán sin descontar del inventario.</span>
                                }
                            </span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-success border-0 rounded d-flex align-items-center mb-0">
                        <i class="fas fa-check-circle fa-2x mr-3"></i>
                        <div>
                            <strong>Todo está disponible.</strong><br />
                            <span>La planificación puede aprobarse; la entrega se registra como proceso aparte.</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* --- Alerta de issues de la semana (solo si esta práctica participa en alguno) --- *@
        @if (Model.PracticeIssues != null && Model.PracticeIssues.Count > 0)
        {
            var alertClass = practiceHasConflict ? "alert-danger" : "alert-warning";
            var alertIcon = practiceHasConflict ? "fa-exclamation-triangle" : "fa-sync-alt";
            var alertTitle = practiceHasConflict
                ? "He detectado faltantes o conflictos de horario en la semana"
                : "He detectado rotaciones de material en la semana";
            <div class="alert @alertClass border-0 rounded mb-4">
                <div class="d-flex align-items-start">
                    <i class="fas @alertIcon fa-2x mr-3 mt-1"></i>
                    <div class="flex-grow-1">
                        <strong>@alertTitle</strong>
                        <div class="small mt-1 mb-2">
                            <span><strong>Conflicto</strong> = planificaciones al mismo tiempo piden más unidades que el stock disponible. </span>
                            <span><strong>Rotación</strong> = el total del día supera el stock pero en horarios distintos: hay que pasarse el material entre planificaciones.</span>
                        </div>
                        <ul class="mb-0 pl-3">
                            @foreach (var issue in Model.PracticeIssues)
                            {
                                var isConflict = issue.State == DemandState.Conflict;
                                <li class="mb-1">
                                    @if (isConflict && issue.Practices.Count == 1)
                                    {
                                        <span class="badge badge-danger mr-1">Stock insuficiente</span>
                                    }
                                    else if (isConflict)
                                    {
                                        <span class="badge badge-danger mr-1">Conflicto de horario</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning text-white mr-1">Requiere rotación</span>
                                    }
                                    <span>
                                        <strong>Día @issue.Date.ToString("dd/MM")</strong> ·
                                        Artículo <strong>@issue.ArticleName</strong>:
                                        piden <strong>@issue.TotalRequested.ToString("0.##")</strong> en el día
                                        (máx. <strong>@issue.PeakRequested.ToString("0.##")</strong> a la vez,
                                        <em>@issue.PeakText</em>)
                                        y hay <strong>@(issue.Stock.Available?.ToString("0.##") ?? "0")</strong>.
                                    </span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }

        <div class="card border-0 shadow-sm rounded-lg">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="font-weight-bold text-primary mb-0">DETALLE DE DISPONIBILIDAD</h5>
                    <span class="badge badge-light border">@Model.Items.Count ítem(s)</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="bg-dark text-white">
                            <tr>
                                <th>ARTÍCULO</th>
                                <th class="text-center">SOLICITADO</th>
                                <th class="text-center">DISPONIBLE</th>
                                <th class="text-center">DIFERENCIA</th>
                                <th class="text-center">ESTADO</th>
                                <th class="text-center">ACCIÓN</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Items)
                            {
                                var hasAvailable = row.Available.HasValue;
                                var isInsufficient = hasAvailable && row.Available.GetValueOrDefault() < row.Requested;
                                var isOk = hasAvailable && !isInsufficient;
                                var rowClass = isInsufficient ? "table-danger" : (!hasAvailable ? "table-secondary" : "");
                                <tr class="@rowClass" data-focus-key="art-@row.ArticleId">
                                    <td class="font-weight-bold">
                                        @row.ArticleName
                                        <small class="d-block text-muted">@row.ArticleCode@(string.IsNullOrWhiteSpace(row.Unit) ? "" : $" · {row.Unit}")</small>
                                        @if (!string.IsNullOrWhiteSpace(row.InventoryNumber))
                                        {
                                            <span class="badge badge-secondary badge-pill mt-1">@row.InventoryNumber</span>
                                        }
                                        @if (row.ArticlePending)
                                        {
                                            <span class="badge badge-warning badge-pill mt-1">Por confirmar</span>
                                        }
                                    </td>
                                    <td class="text-center font-weight-bold">@row.Requested.ToString("0.##")</td>
                                    <td class="text-center">
                                        @if (hasAvailable)
                                        {
                                            <div class="font-weight-bold">@row.Available.GetValueOrDefault().ToString("0.##")</div>
                                            <small class="d-block text-muted">@row.Stock.SourceText</small>
                                            @if (row.Stock.Source == StockSource.EquipmentUnits)
                                            {
                                                <small class="d-block text-muted">
                                                    @{
                                                        var parts = new List<string>();
                                                        parts.Add($"{row.Stock.TotalUnits} unidades");
                                                        if (row.Stock.OnLoan > 0) { parts.Add($"{row.Stock.OnLoan} en préstamo"); }
                                                        if (row.Stock.InMaintenance > 0) { parts.Add($"{row.Stock.InMaintenance} en mantenimiento"); }
                                                        if (row.Stock.OutOfService > 0) { parts.Add($"{row.Stock.OutOfService} fuera de servicio"); }
                                                    }
                                                    @string.Join(" · ", parts)@if (row.Stock.Unconfirmed > 0) { <span> · @row.Stock.Unconfirmed por confirmar</span> }
                                                </small>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary badge-pill">Sin registro</span>
                                            <small class="d-block text-muted">Sin stock registrado</small>
                                        }
                                    </td>
                                    <td class="text-center font-weight-bold @(isOk ? "text-success" : (isInsufficient ? "text-danger" : "text-muted"))">
                                        @if (row.Difference.HasValue)
                                        {
                                            @(row.Difference.Value > 0 ? "+" : "")@row.Difference.Value.ToString("0.##")
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (isOk)
                                        {
                                            <span class="badge badge-success rounded-pill"><i class="fas fa-check mr-1"></i> Disponible</span>
                                        }
                                        else if (isInsufficient)
                                        {
                                            <span class="badge badge-danger rounded-pill"><i class="fas fa-times mr-1"></i> Insuficiente</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary rounded-pill"><i class="fas fa-question mr-1"></i> Sin registro</span>
                                            <small class="d-block text-muted">Sin stock registrado</small>
                                        }
                                    </td>
                                    <td class="text-center small">
                                        @if (Model.RowStockAction(row) is StockAction rowAction)
                                        {
                                            <a href="@rowAction.Url" class="btn btn-sm @rowAction.Style btn-rounded mt-1 px-2 py-0 small font-weight-bold">
                                                <i class="@rowAction.Icon mr-1"></i>@rowAction.Label
                                            </a>
                                        }
                                        else if (StockActionLinks.NeedsAction(row.Stock, row.Requested))
                                        {
                                            <small class="d-block text-muted">Pide a un administrador que actualice el stock</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top flex-wrap gap-2">
                    <a asp-page="./Requerimientos" asp-route-planId="@Model.PlanId"
                       class="btn btn-outline-secondary btn-rounded px-4">
                        <i class="mdi mdi-arrow-left mr-1"></i> Ajustar requerimientos
                    </a>
                    @if (Model.IsApproved)
                    {
                        <a asp-page="./Index" class="btn btn-primary btn-rounded font-weight-bold px-4">
                            <i class="fas fa-th-large mr-1"></i> Volver al panel
                        </a>
                    }
                    else if (canApprove)
                    {
                        <form method="post" asp-page-handler="Approve" asp-route-planId="@Model.PlanId"
                              class="d-inline-flex align-items-center flex-wrap gap-2" id="form-approve">
                            <input type="hidden" name="OriginLabId" value="@selectedOriginId" />
                            @if (needsAck)
                            {
                                <div class="form-check mr-1">
                                    <input type="checkbox" class="form-check-input" id="acknowledgeCheck" name="Acknowledged" value="true" />
                                    <label class="form-check-label font-weight-bold text-dark" for="acknowledgeCheck">Estoy consciente de los faltantes/conflictos y continúo</label>
                                </div>
                            }
                            <button type="submit" class="btn btn-success btn-rounded font-weight-bold px-4 js-approve-confirm">
                                <i class="mdi mdi-check mr-1"></i> Aprobar planificación
                            </button>
                        </form>
                    }
                    else
                    {
                        <button type="button" class="btn btn-secondary btn-rounded" disabled>
                            <i class="fas fa-lock mr-1"></i> Aprobar no disponible
                        </button>
                    }
                </div>
            </div>
        </div>

        @* --- Semana académica (debajo de la tabla) --- *@
        @if (Model.Week != null)
        {
            <div class="card border-0 shadow-sm rounded-lg mt-4">
                <div class="card-body p-4">
                    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
                        <div>
                            <span class="text-uppercase small text-primary font-weight-bold">Semana académica</span>
                            <h5 class="font-weight-bold text-dark mb-0 mt-1">
                                @(Model.Week.WeekNumber.HasValue ? $"Semana {Model.Week.WeekNumber.Value}" : "Semana")
                                <small class="text-muted font-weight-normal">· @Model.Week.StartDate.ToString("dd/MM")–@Model.Week.EndDate.ToString("dd/MM")</small>
                            </h5>
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            @if (anyConflict)
                            {
                                <span class="badge badge-danger px-3 py-2 font-weight-bold">
                                    <i class="fas fa-exclamation-triangle mr-1"></i>@Model.Week.ConflictCount conflicto(s) de horario
                                </span>
                            }
                            @if (anyRotation)
                            {
                                <span class="badge badge-warning text-white px-3 py-2 font-weight-bold">
                                    <i class="fas fa-sync-alt mr-1"></i>@Model.Week.RotationCount rotación(es)
                                </span>
                            }
                            @if (!anyConflict && !anyRotation)
                            {
                                <span class="badge badge-success px-3 py-2 font-weight-bold">
                                    <i class="fas fa-check mr-1"></i>Sin conflictos ni rotaciones
                                </span>
                            }
                        </div>
                    </div>

                    <div class="av-week-grid"
                         data-conflict-scope="av-week--hovering" data-conflict-related-class="av-practice--related">
                        @foreach (var day in Model.Week.Days)
                        {
                            var dayKey = day.Date;
                            var hasDayPractices = practicesByDay.TryGetValue(dayKey, out var dayPractices) && dayPractices != null && dayPractices.Count > 0;

                            // Regla: si es domingo y no tiene prácticas, no se muestra.
                            if (day.DayOfWeek == DayOfWeek.Sunday && !hasDayPractices)
                            {
                                continue;
                            }

                            var dayDemands = demandsByDay.TryGetValue(dayKey, out var dList) ? dList : new List<ArticleDayDemand>();
                            var dayHasConflict = dayDemands.Any(d => d.State == DemandState.Conflict);
                            var dayHasRotation = dayDemands.Any(d => d.State == DemandState.Rotation);
                            <div class="av-week-day">
                                <div class="av-week-day-head">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <span class="av-week-day-name">@dayNames[day.DayOfWeek]</span>
                                        <span class="av-week-day-date">@day.ToString("dd/MM")</span>
                                    </div>
                                    @if (dayHasConflict || dayHasRotation)
                                    {
                                        <div class="mt-1">
                                            @if (dayHasConflict)
                                            {
                                                <span class="badge badge-danger badge-pill mr-1">Conflicto</span>
                                            }
                                            @if (dayHasRotation)
                                            {
                                                <span class="badge badge-warning text-white badge-pill">Rotación</span>
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="av-week-day-body">
                                    @if (!hasDayPractices)
                                    {
                                        <div class="text-muted small text-center py-3">Sin planificaciones</div>
                                    }
                                    else
                                    {
                                        @foreach (var p in dayPractices!)
                                        {
                                            var isCurrent = p.Id == Model.PlanId;
                                            string pStateClass = "";
                                            if (Model.Week.PracticeStates.TryGetValue(p.Id, out var pState))
                                            {
                                                if (pState == DemandState.Conflict) { pStateClass = "av-practice-conflict"; }
                                                else if (pState == DemandState.Rotation) { pStateClass = "av-practice-rotation"; }
                                            }
                                            var linkClass = "av-practice" + (isCurrent ? " av-practice-current" : "") + (string.IsNullOrEmpty(pStateClass) ? "" : " " + pStateClass);
                                            var cardTags = Model.ConflictTags.TryGetValue(p.Id, out var cardTagList) ? cardTagList : null;
                                            var hasCardTags = cardTags is { Count: > 0 };
                                            var cardKeys = hasCardTags ? string.Join(" ", cardTags!.Select(t => t.Key).Distinct()) : null;
                                            <a class="@linkClass" asp-page="./Requerimientos" asp-route-planId="@p.Id"
                                               data-conflict-keys="@cardKeys">
                                                <div class="av-practice-time">@p.TimeText</div>
                                                <div class="av-practice-code">@p.Code</div>
                                                <div class="av-practice-name">@p.PracticeName</div>
                                                @if (!string.IsNullOrEmpty(p.SubjectName) || !string.IsNullOrEmpty(p.GroupName))
                                                {
                                                    <small class="d-block text-muted">@(p.SubjectName ?? "")@(string.IsNullOrEmpty(p.GroupName) ? "" : $" · {p.GroupName}")</small>
                                                }
                                                @if (!string.IsNullOrEmpty(p.LaboratoryCode))
                                                {
                                                    <small class="d-block text-muted"><i class="fas fa-map-marker-alt mr-1"></i>@p.LaboratoryCode</small>
                                                }
                                                @if (hasCardTags)
                                                {
                                                    @* La tarjeta ya es un enlace: las etiquetas no pueden ser <a> anidadas; conflict-tags.js las abre. *@
                                                    <span class="av-practice__conflicts">
                                                        @foreach (var t in cardTags!.Take(3))
                                                        {
                                                            var tipo = ConflictTypes.Of(t.Kind);
                                                            var relText = t.RelatedPlanningIds.Count > 0
                                                                ? $"\nRelacionadas: {string.Join(", ", t.RelatedDisplayCodes)}" : string.Empty;
                                                            var titulo = $"{t.Tag} · {tipo.Label} · {t.ArticleName} · {t.Date.ToString("dd/MM")}{relText}\nClic para resolver en Conflictos";
                                                            <span class="gr-ctag gr-ctag--@tipo.Css @(t.Involved ? "is-involved" : "is-loose") js-cf-open" tabindex="0" role="link"
                                                                  data-conflict-key="@t.Key" data-cf-color="var(--cf-@tipo.Css)" data-href="@t.Url"
                                                                  title="@titulo">@t.Tag</span>
                                                        }
                                                        @if (cardTags!.Count > 3)
                                                        {
                                                            <span class="gr-ctag gr-ctag--more">+@(cardTags.Count - 3)</span>
                                                        }
                                                    </span>
                                                }
                                                @if (isCurrent)
                                                {
                                                    <span class="badge badge-primary badge-pill mt-1">Esta planificación</span>
                                                }
                                            </a>
                                        }
                                    }

                                    @if (dayDemands.Any(d => d.HasIssue))
                                    {
                                        <div class="av-demands">
                                            @foreach (var d in dayDemands.Where(x => x.HasIssue))
                                            {
                                                var demandClass = d.State == DemandState.Conflict ? "av-demand-conflict" : "av-demand-rotation";
                                                var chipLabel = d.Kind == ConflictKind.Overlap ? "Conflicto"
                                                    : d.Kind == ConflictKind.Shortage ? "Stock insuficiente"
                                                    : d.Kind == ConflictKind.Rotation ? "Rotación"
                                                    : "Sin stock";
                                                var chipBadge = d.Kind == ConflictKind.Rotation ? "badge-warning text-white" : "badge-danger";
                                                <a class="av-demand @demandClass" title="Ver detalle del conflicto"
                                                   asp-page="./Conflictos"
                                                   asp-route-selDate="@d.Date.ToString("yyyy-MM-dd")"
                                                   asp-route-articleId="@d.ArticleId"
                                                   style="display:block;text-decoration:none;color:inherit;">
                                                    <div class="av-demand-head">
                                                        <span title="@d.ArticleName">@d.ArticleName</span>
                                                        <span class="av-demand-qty">@d.TotalRequested.ToString("0.##")/@(d.Stock.Available?.ToString("0.##") ?? "0")</span>
                                                    </div>
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <span class="badge badge-pill @chipBadge">@chipLabel</span>
                                                        <small class="text-muted">@d.PeakText</small>
                                                    </div>
                                                </a>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

@section Styles {
    <link href="~/assets/libs/select2/dist/css/select2.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/row-focus.css" asp-append-version="true" />
    <style>
        .bg-light-primary { background-color: #e8e7ff; }

        /* Semana académica (prefijo .av-) */
        .av-week-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
        }
        .av-week-day {
            flex: 1 1 0;
            min-width: 140px;
            background: #fbfaff;
            border: 1px solid #e9e5fb;
            border-radius: 10px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            min-height: 80px;
        }
        @@media (max-width: 575.98px) {
            .av-week-day { flex: 1 1 100%; }
        }
        .av-week-day-head {
            background: linear-gradient(90deg, #f6f4ff 0%, #ffffff 100%);
            padding: 0.5rem 0.65rem;
            border-bottom: 1px solid #ecebf6;
        }
        .av-week-day-name {
            font-weight: 800;
            color: #2a1d6b;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }
        .av-week-day-date {
            color: #8a82b5;
            font-size: 0.7rem;
            font-weight: 700;
        }
        .av-week-day-body {
            padding: 0.5rem;
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
            flex: 1;
        }

        .av-practice {
            display: block;
