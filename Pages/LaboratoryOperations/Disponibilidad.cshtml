            background: #f5f1ff;
            border-color: #7460ee;
            color: #2a1d6b;
        }
        .av-practice-current {
            border-color: #7460ee;
            border-left-color: #7460ee;
            background: #f6f4ff;
            box-shadow: 0 0 0 1px rgba(116, 96, 238, 0.25);
        }
        .av-practice-conflict {
            border-left-width: 4px;
            border-left-color: #dc3545;
            background: #fff5f5;
        }
        .av-practice-rotation {
            border-left-width: 4px;
            border-left-color: #fd7e14;
            background: #fff8ed;
        }
        .av-practice-time {
            font-weight: 800;
            color: #5d3df5;
            font-size: 0.72rem;
        }
        .av-practice-code {
            font-size: 0.68rem;
            color: #8a82b5;
