            flex-direction: column;
            gap: 0.25rem;
        }
        .av-demand {
            font-size: 0.72rem;
            background: #ffffff;
            border: 1px solid #f0ecfa;
            border-left: 3px solid #c8c0e8;
            border-radius: 6px;
            padding: 0.3rem 0.4rem;
            display: flex;
            flex-direction: column;
            gap: 0.15rem;
        }
        .av-demand-conflict {
            border-left-color: #dc3545;
            background: #fff5f5;
        }
        .av-demand-rotation {
            border-left-color: #fd7e14;
            background: #fff8ed;
        }
        .av-demand-head {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 0.35rem;
            font-weight: 700;
            color: #2a1d6b;
        }
        .av-demand-qty {
            font-weight: 800;
            color: #5d3df5;
            white-space: nowrap;
            font-size: 0.72rem;
        }

        /* Conflictos de material: etiquetas iguales a la Grilla (mismos colores que conflictos.css) */
        .av-week-grid {
            --cf-overlap: #dc3545;
            --cf-shortage: #8b1e3f;
            --cf-rotation: #fd7e14;
            --cf-nostock: #6c757d;
        }
        .av-practice__conflicts {
            display: flex;
            flex-wrap: nowrap;
            align-items: center;
            gap: 3px;
            overflow: hidden;
            max-height: 15px;
            margin-top: 0.2rem;
            line-height: 1;
        }
        .gr-ctag {
            display: inline-flex;
            align-items: center;
            flex: 0 0 auto;
            font-size: 10px;
            font-weight: 700;
            line-height: 1;
            padding: 2px 5px;
            border-radius: 8px;
            border: 1px solid transparent;
            color: #fff;
            text-decoration: none;
            white-space: nowrap;
            user-select: none;
            cursor: pointer;
        }
        .gr-ctag:hover, .gr-ctag:focus { text-decoration: none; color: #fff; filter: brightness(1.08); }
        .gr-ctag--overlap { background: var(--cf-overlap); }
        .gr-ctag--shortage { background: var(--cf-shortage); }
        .gr-ctag--rotation { background: var(--cf-rotation); }
        .gr-ctag--nostock { background: var(--cf-nostock); }
        .gr-ctag--overlap.is-loose { background: #fff; border-color: var(--cf-overlap); color: var(--cf-overlap); }
        .gr-ctag--shortage.is-loose { background: #fff; border-color: var(--cf-shortage); color: var(--cf-shortage); }
        .gr-ctag--rotation.is-loose { background: #fff; border-color: var(--cf-rotation); color: var(--cf-rotation); }
        .gr-ctag--nostock.is-loose { background: #fff; border-color: var(--cf-nostock); color: var(--cf-nostock); }
        .gr-ctag--more { background: #eef0f3; color: #555; border-color: #d8dbe0; cursor: default; }
        .av-practice--related {
            outline: 2px solid var(--cf-active, #7460ee);
            outline-offset: 1px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, .15);
        }
        .av-week--hovering .av-practice:not(.av-practice--related) { opacity: .3; }
    </style>
}

@section Scripts {
    <script src="~/assets/libs/select2/dist/js/select2.full.min.js"></script><script src="~/js/select2-es.js" asp-append-version="true"></script>
    <script src="~/js/row-focus.js" asp-append-version="true"></script>
    <script src="~/js/conflict-tags.js" asp-append-version="true"></script>
    <script>
        (function () {
            $('.select2').select2({
                width: '100%',
                language: { noResults: function () { return 'Sin coincidencias'; } }
            });

            // Etiquetas de conflicto dentro de la tarjeta (span: no puede haber <a> dentro de <a>).
            // preventDefault cancela la navegación de la tarjeta hacia Requerimientos.
            function abrirConflicto(e) {
                var tag = e.target && e.target.closest ? e.target.closest('.js-cf-open') : null;
                var url = tag && tag.getAttribute('data-href');
                if (url) {
                    e.preventDefault();
                    window.location.href = url;
                }
            }
            document.addEventListener('click', abrirConflicto);
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' || e.key === ' ') abrirConflicto(e);
            });

            var form = document.getElementById('form-approve');
            if (form) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    var ackBox = form.querySelector('input[name="Acknowledged"]');
                    if (ackBox && !ackBox.checked) {
                        if (typeof Swal === 'undefined') return;
                        Swal.fire({
                            title: 'Confirma antes de aprobar',
                            text: 'Hay faltantes, conflictos o rotaciones. Marca la casilla para confirmar que estás consciente antes de aprobar.',
                            type: 'warning',
                            confirmButtonText: 'Entendido',
                            confirmButtonColor: '#ffc107'
                        });
                        return;
                    }
                    if (typeof Swal === 'undefined') {
                        HTMLFormElement.prototype.submit.call(form);
                        return;
                    }
                    Swal.fire({
                        title: '¿Aprobar planificación?',
                        text: 'Esta planificación se aprobará. La entrega de artículos se realiza como proceso aparte.',
                        type: 'question',
                        showCancelButton: true,
                        confirmButtonText: 'Sí, aprobar',
                        cancelButtonText: 'Cancelar',
                        confirmButtonColor: '#28a745',
                        cancelButtonColor: '#6c757d'
                    }).then(function (result) {
                        if (result && (result.isConfirmed === true || result.value === true)) {
                            HTMLFormElement.prototype.submit.call(form);
                        }
                    });
                });
            }

            // El selector de laboratorio de origen recarga la página con GET (D1: cambio en vivo).
            var $origin = $('#origin-select');
            if ($origin.length) {
                $origin.on('change', function () {
                    var formOrigin = document.getElementById('form-origin');
                    if (formOrigin) formOrigin.submit();
                });
            }
        })();
    </script>
}