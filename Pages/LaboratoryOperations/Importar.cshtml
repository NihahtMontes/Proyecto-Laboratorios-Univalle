@page
@model Proyecto_Laboratorios_Univalle.Pages.LaboratoryOperations.ImportarModel
@using Proyecto_Laboratorios_Univalle.Services.PlanningImport
@{
    ViewData["Title"] = "Cargar planificación desde Excel";
    ViewData["Section"] = "Planificación académica";
    ViewData["HidePageTitle"] = true;
    var a = Model.Analysis;
    var step = a == null ? 1 : a.CanApply ? 3 : 2;
}

@section Styles {
    <style>
        .im-steps { display: flex; flex-wrap: wrap; gap: 8px; }
        .im-step { display: flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 999px; background: #fff; border: 1px solid #e5e7eb; color: #6b7280; font-weight: 600; font-size: .875rem; }
        .im-step__n { width: 24px; height: 24px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: #e5e7eb; color: #4b5563; font-size: .8rem; }
        .im-step.is-current { border-color: #7460ee; color: #1f2937; }
        .im-step.is-current .im-step__n { background: #7460ee; color: #fff; }
        .im-step.is-done { color: #128a74; }
        .im-step.is-done .im-step__n { background: #36bea6; color: #fff; }
        .im-kpi { border-radius: 14px; padding: 12px 14px; background: #fff; border: 1px solid #eef0f4; height: 100%; display: block; color: inherit; }
        .im-kpi:hover { text-decoration: none; border-color: #7460ee; color: inherit; }
        .im-kpi.is-active { border-color: #7460ee; box-shadow: 0 0 0 2px rgba(116, 96, 238, .15); }
        .im-kpi__value { font-size: 1.5rem; font-weight: 800; line-height: 1.1; }
        .im-kpi__label { font-size: .75rem; color: #6b7280; font-weight: 600; text-transform: uppercase; letter-spacing: .3px; }
        .im-row--blocked { background: #fff5f6; }
        .im-row--decide { background: #fff9ee; }
        .im-row--skip td { color: #9ca3af; }
        .im-issue { display: flex; gap: 6px; align-items: flex-start; font-size: .8125rem; margin-bottom: 3px; line-height: 1.3; }
        .im-issue__col { font-weight: 700; white-space: nowrap; }
        .im-issue--error { color: #b42340; }
        .im-issue--clash { color: #b45309; }
        .im-issue--warning { color: #6b7280; }
        .im-existing { font-size: .8125rem; background: #fff; border: 1px dashed #f0b860; border-radius: 8px; padding: 6px 8px; margin-top: 4px; }
        .im-table td { vertical-align: top; }
        .im-table select { min-width: 150px; }
        .im-drop { border: 2px dashed #cfc8fa; border-radius: 14px; padding: 22px; background: #faf9ff; }
    </style>
}

<div class="page-breadcrumb">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h4 class="page-title text-uppercase text-primary font-weight-bold mb-0">PLANIFICACIÓN</h4>
            <h2 class="font-weight-bold text-dark mb-0">Cargar planificación desde Excel</h2>
            <div class="text-muted small">Carga de una vez todas las prácticas del semestre. El sistema revisa cada fila antes de guardar nada.</div>
        </div>
        <div class="col-md-4 text-md-right mt-2 mt-md-0">
            <a asp-page="./Index" asp-route-managementId="@Model.ManagementId" class="btn btn-light border btn-rounded btn-sm">
                <i class="mdi mdi-view-dashboard mr-1"></i> Panel de planificación
            </a>
        </div>
    </div>
</div>

<div class="container-fluid mt-3">
    <div class="im-steps mb-3" id="im-steps" data-step="@step">
        <span class="im-step @(step == 1 ? "is-current" : "is-done")"><span class="im-step__n">@(step > 1 ? "✓" : "1")</span>Subir el archivo</span>
        <span class="im-step @(step == 2 ? "is-current" : step > 2 ? "is-done" : null)"><span class="im-step__n">@(step > 2 ? "✓" : "2")</span>Revisar y decidir</span>
        <span class="im-step @(step == 3 ? "is-current" : null)"><span class="im-step__n">3</span>Confirmar la carga</span>
    </div>

    @if (Model.Management == null)
    {
        <div class="card border-0 shadow-sm rounded-lg"><div class="card-body text-center py-5">
            <i class="mdi mdi-calendar-remove fa-3x text-muted" aria-hidden="true"></i>
            <h5 class="font-weight-bold mt-3">No hay una gestión editable</h5>
            <p class="text-muted mb-0">Active una gestión semestral y genere su calendario académico antes de cargar la planificación.</p>
        </div></div>
    }
    else if (a == null)
    {
        <!-- Paso 1 -->
        <div class="row">
            <div class="col-lg-7 mb-3">
                <div class="card border-0 shadow-sm rounded-lg h-100"><div class="card-body p-4">
                    <h5 class="font-weight-bold text-dark mb-3"><i class="fas fa-file-upload mr-2" style="color:#7460ee;"></i>Subir el Excel de la planificación</h5>
                    <form method="get" class="form-inline mb-3">
                        <label for="im-management" class="font-weight-bold mr-2">Gestión</label>
                        <select id="im-management" name="managementId" class="custom-select custom-select-sm" onchange="this.form.submit()">
                            @foreach (var m in Model.Managements)
                            {
                                <option value="@m.Id" selected="@(m.Id == Model.ManagementId)">@m.Code · @m.StatusText</option>
                            }
                        </select>
                    </form>
                    <form method="post" asp-page-handler="Upload" enctype="multipart/form-data" id="im-upload-form">
                        <input type="hidden" name="ManagementId" value="@Model.ManagementId" />
                        <div class="im-drop mb-3">
                            <label for="im-file" class="font-weight-bold d-block mb-2">Archivo de la gestión @Model.Management.Code (.xlsx)</label>
                            <input type="file" id="im-file" name="Upload" accept=".xlsx" class="form-control-file" required />
                            <small class="text-muted d-block mt-2">Subir el archivo no guarda nada todavía: primero verá la revisión completa.</small>
                        </div>
                        <button type="submit" class="btn btn-primary btn-rounded font-weight-bold px-4">
                            <i class="fas fa-search mr-1"></i> Revisar el archivo
                        </button>
                    </form>
                </div></div>
            </div>
            <div class="col-lg-5 mb-3">
                <div class="card border-0 shadow-sm rounded-lg h-100"><div class="card-body p-4">
                    <h5 class="font-weight-bold text-dark mb-2"><i class="fas fa-file-excel mr-2 text-success"></i>Plantilla</h5>
                    <p class="small text-muted">Se descarga con las materias, grupos, prácticas, laboratorios y docentes de hoy en listas desplegables, para que nadie escriba un nombre distinto al del sistema.</p>
                    <a asp-page-handler="Template" asp-route-managementId="@Model.ManagementId" class="btn btn-outline-success btn-rounded font-weight-bold" id="im-template">
                        <i class="fas fa-download mr-1"></i> Descargar plantilla de @Model.Management.Code
                    </a>
                    <hr />
                    <ul class="small text-muted pl-3 mb-0">
                        <li>Una fila por práctica de cada grupo, siempre con fecha.</li>
                        <li>El material no va en el archivo: sale de la receta de cada práctica.</li>
                        <li>No incluya reprogramaciones ni reposiciones: se hacen después, en el sistema.</li>
                        <li>Antes de cargar deben existir el calendario académico, los grupos con su docente y las prácticas.</li>
                    </ul>
                </div></div>
            </div>
        </div>
    }
    else
    {
        var ver = Model.Ver ?? (a.BlockedCount > 0 ? "problemas" : a.NeedsDecisionCount > 0 ? "decidir" : "todas");
        bool Shown(ImportRow r) => ver switch
        {
            "problemas" => r.Action == ImportRowAction.Blocked,
            "decidir" => r.Action == ImportRowAction.NeedsDecision || (r.State == ImportRowState.Existing && r.Action == ImportRowAction.Overwrite),
            "cargar" => r.Action is ImportRowAction.Create or ImportRowAction.Overwrite,
            "avisos" => r.HasWarnings && r.Action is ImportRowAction.Create or ImportRowAction.Overwrite,
            "omitidas" => r.Action is ImportRowAction.Skip or ImportRowAction.Unchanged,
            _ => true
        };
        var shown = a.Rows.Where(Shown).ToList();
        const int pageSize = 300;

        <!-- Pasos 2 y 3 -->
        <div class="card border-0 shadow-sm rounded-lg mb-3"><div class="card-body py-3 d-flex flex-wrap align-items-center">
            <div class="mr-auto">
                <div class="font-weight-bold text-dark"><i class="fas fa-file-excel text-success mr-1"></i>@a.FileName</div>
                <div class="small text-muted">Gestión @a.ManagementCode · @a.Rows.Count práctica(s) en el archivo</div>
            </div>
            <a asp-page-handler="Result" asp-route-token="@Model.Token" class="btn btn-outline-success btn-rounded btn-sm mr-2 mt-2 mt-md-0" id="im-result">
                <i class="fas fa-download mr-1"></i> Descargar Excel con el resultado
            </a>
            <form method="post" asp-page-handler="Cancel" asp-route-token="@Model.Token" class="d-inline mt-2 mt-md-0">
                <button type="submit" class="btn btn-light border btn-rounded btn-sm"><i class="fas fa-times mr-1"></i> Subir otro archivo</button>
            </form>
        </div></div>

        @foreach (var issue in a.ExtraSheetIssues)
        {
            <div class="alert alert-danger border-0 shadow-sm"><i class="fas fa-exclamation-circle mr-1"></i>@issue</div>
        }

        <div class="row mb-2">
            @{
                var kpis = new (string Key, string Label, int Value, string Css)[]
                {
                    ("problemas", "Con error o choque", a.BlockedCount, a.BlockedCount > 0 ? "text-danger" : "text-muted"),
                    ("decidir", "Ya cargadas: decidir", a.NeedsDecisionCount, a.NeedsDecisionCount > 0 ? "text-warning" : "text-muted"),
                    ("cargar", "Se cargarán", a.CreateCount + a.OverwriteCount, "text-success"),
                    ("avisos", "Con avisos", a.WarningCount, "text-dark"),
                    ("omitidas", "Omitidas o sin cambios", a.SkipCount + a.UnchangedCount, "text-muted"),
                    ("todas", "Todas", a.Rows.Count, "text-dark")
                };
            }
            @foreach (var k in kpis)
            {
                <div class="col-6 col-md-4 col-xl-2 mb-2">
                    <a asp-route-token="@Model.Token" asp-route-ver="@k.Key" class="im-kpi @(ver == k.Key ? "is-active" : null)" data-ver="@k.Key">
                        <div class="im-kpi__value @k.Css">@k.Value</div>
                        <div class="im-kpi__label">@k.Label</div>
                    </a>
                </div>
            }
        </div>

        @if (a.CanApply)
        {
            <div class="alert border-0 shadow-sm rounded-lg d-flex flex-wrap align-items-center" style="background:#e8f8f4;" id="im-ready">
                <i class="fas fa-check-circle fa-2x text-success mr-3"></i>
                <div class="mr-auto">
                    <strong class="text-dark">Todo resuelto. Se cargarán @a.CreateCount práctica(s) nuevas@(a.OverwriteCount > 0 ? $" y se sobrescribirán {a.OverwriteCount}" : "").</strong>
                    <div class="small text-muted">
                        Quedarán aprobadas, con el material de su receta.
                        @if (a.SkipCount + a.UnchangedCount > 0) { <span>@(a.SkipCount) omitida(s) y @(a.UnchangedCount) sin cambios no se tocan.</span> }
                        Se carga todo junto: si algo falla, no se guarda nada.
                    </div>
                </div>
                <form method="post" asp-page-handler="Apply" asp-route-token="@Model.Token" id="im-apply-form" class="mt-2 mt-md-0">
                    <button type="submit" class="btn btn-success btn-rounded font-weight-bold px-4" id="im-apply">
                        <i class="fas fa-cloud-upload-alt mr-1"></i> Confirmar y cargar
                    </button>
                </form>
            </div>
        }
        else
        {
            <div class="alert border-0 shadow-sm rounded-lg" style="background:#fff9ee;" id="im-pending">
                <strong class="text-dark"><i class="fas fa-tasks mr-1 text-warning"></i>Antes de cargar falta resolver:</strong>
                <ul class="mb-0 mt-1 small">
                    @if (a.BlockedCount > 0)
                    {
                        <li><strong>@a.BlockedCount fila(s) con error o choque.</strong> Corríjalas en el Excel y súbalo de nuevo, u omítalas aquí.</li>
                    }
                    @if (a.NeedsDecisionCount > 0)
                    {
                        <li><strong>@a.NeedsDecisionCount práctica(s) que ya están cargadas.</strong> Decida en cada una si se sobrescribe o se omite.</li>
                    }
                    @if (a.BlockedCount == 0 && a.NeedsDecisionCount == 0)
                    {
                        <li>No queda ninguna fila para cargar: todas están omitidas o ya estaban cargadas igual.</li>
                    }
                </ul>
            </div>
        }

        <form method="post" asp-page-handler="Decide" asp-route-token="@Model.Token" asp-route-ver="@ver" id="im-decide-form">
            <div class="card border-0 shadow-sm rounded-lg"><div class="card-body p-0">
                <div class="d-flex flex-wrap align-items-center p-3 border-bottom">
                    <span class="font-weight-bold text-dark mr-auto">@shown.Count fila(s) en esta vista</span>
                    @if (a.NeedsDecisionCount > 0)
                    {
                        <button type="submit" name="bulk" value="overwriteAll" class="btn btn-sm btn-outline-warning btn-rounded mr-2 mb-1 js-bulk"
                                data-title="¿Sobrescribir todas las que se pueden?" data-text="Las prácticas ya cargadas pasarán a la fecha, horario, laboratorio y docente del Excel. Las que ya tienen material entregado o están finalizadas no se tocan.">
                            <i class="fas fa-sync-alt mr-1"></i> Sobrescribir todas las ya cargadas
                        </button>
                        <button type="submit" name="bulk" value="skipExisting" class="btn btn-sm btn-outline-secondary btn-rounded mr-2 mb-1 js-bulk"
                                data-title="¿Omitir todas las ya cargadas?" data-text="Se dejan como están en el sistema y esas filas del Excel no se cargan.">
                            <i class="fas fa-forward mr-1"></i> Omitir todas las ya cargadas
                        </button>
                    }
                    @if (a.BlockedCount > 0)
                    {
                        <button type="submit" name="bulk" value="skipProblems" class="btn btn-sm btn-outline-danger btn-rounded mr-2 mb-1 js-bulk"
                                data-title="¿Omitir todas las filas con error o choque?" data-text="Esas prácticas NO se cargarán. Podrá cargarlas después con otro archivo corregido.">
                            <i class="fas fa-ban mr-1"></i> Omitir las @a.BlockedCount con problemas
                        </button>
                    }
                    @if (a.SkipCount + a.OverwriteCount > 0)
                    {
                        <button type="submit" name="bulk" value="reset" class="btn btn-sm btn-light border btn-rounded mb-1 js-bulk"
                                data-title="¿Deshacer todas las decisiones?" data-text="La lista vuelve a como estaba al subir el archivo.">
                            <i class="fas fa-undo mr-1"></i> Deshacer decisiones
                        </button>
                    }
                </div>
                @if (shown.Count == 0)
                {
                    <div class="text-center text-muted py-5"><i class="fas fa-check-circle text-success fa-2x d-block mb-2"></i>No hay filas en esta vista.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table mb-0 im-table" id="im-table">
                            <thead class="thead-light">
                                <tr>
                                    <th style="width:60px;">Fila</th>
                                    <th>Práctica</th>
                                    <th>Cuándo y dónde</th>
                                    <th>Revisión</th>
                                    <th style="width:190px;">Qué hacer</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in shown.Take(pageSize))
                                {
                                    var css = row.Action switch
                                    {
                                        ImportRowAction.Blocked => "im-row--blocked",
                                        ImportRowAction.NeedsDecision => "im-row--decide",
                                        ImportRowAction.Skip or ImportRowAction.Unchanged => "im-row--skip",
                                        _ => null
                                    };
                                    var badge = row.Action switch
                                    {
                                        ImportRowAction.Create => "success",
                                        ImportRowAction.Overwrite => "info",
                                        ImportRowAction.NeedsDecision => "warning",
                                        ImportRowAction.Blocked => "danger",
                                        _ => "secondary"
                                    };
                                    <tr class="@css" data-row="@row.RowNumber" data-action="@row.Action">
                                        <td class="font-weight-bold">@row.RowNumber</td>
                                        <td>
                                            <div class="font-weight-bold text-dark">@(row.PracticeLabel ?? row.Raw.Practice)</div>
                                            <div class="small text-muted">@(row.SubjectLabel ?? row.Raw.Subject) · Grupo @(row.GroupName ?? row.Raw.Group)</div>
                                            @if (row.ExtraLines.Count > 0)
                                            {
                                                <div class="small text-muted"><i class="fas fa-plus-circle mr-1"></i>@row.ExtraLines.Count artículo(s) extra</div>
                                            }
                                        </td>
                                        <td class="small">
                                            <div class="font-weight-bold text-dark">@(row.Date?.ToString("ddd dd/MM/yyyy", System.Globalization.CultureInfo.GetCultureInfo("es-BO")) ?? row.Raw.Date)</div>
                                            <div>
                                                @(row.StartOrder is int so && row.PeriodCount is int pc ? Proyecto_Laboratorios_Univalle.Services.PlanningSlot.PeriodsText(so, pc) : $"Periodo {row.Raw.StartPeriod} × {row.Raw.PeriodCount}")
                                                @if (row.WeekNumber is int w) { <span class="text-muted">· semana @w</span> }
                                            </div>
                                            <div>@(row.LaboratoryLabel ?? row.Raw.Laboratory) · @(row.TeacherName ?? row.Raw.Teacher)</div>
                                        </td>
                                        <td>
                                            <span class="badge badge-pill badge-@badge mb-1">@row.ResultText</span>
                                            @foreach (var issue in row.Issues.OrderBy(i => i.Level))
                                            {
                                                var level = issue.Level.ToString().ToLowerInvariant();
                                                <div class="im-issue im-issue--@level">
                                                    <i class="fas @(issue.Level == ImportIssueLevel.Error ? "fa-times-circle" : issue.Level == ImportIssueLevel.Clash ? "fa-exclamation-triangle" : "fa-info-circle") mt-1"></i>
                                                    <span><span class="im-issue__col">@issue.Column:</span> @issue.Message</span>
                                                </div>
                                            }
                                            @if (row.State != ImportRowState.New && row.ExistingPlanningId is int existingId)
                                            {
                                                <div class="im-existing">
                                                    <i class="fas fa-map-marker-alt text-warning mr-1"></i><strong>Aquí ya está:</strong> @row.ExistingCode · @row.ExistingSummary
                                                    <a asp-page="./Grilla" asp-route-managementId="@a.ManagementId" asp-route-laboratoryId="@row.ExistingLaboratoryId"
                                                       asp-route-date="@row.ExistingDate?.ToString("yyyy-MM-dd")" asp-route-resaltar="@existingId"
                                                       target="_blank" rel="noopener" class="ml-1 font-weight-bold">Ver en la grilla <i class="fas fa-external-link-alt"></i></a>
                                                    @if (!row.CanOverwrite && row.State == ImportRowState.Existing)
                                                    {
                                                        <div class="text-danger mt-1"><i class="fas fa-lock mr-1"></i>No se puede sobrescribir: @row.OverwriteBlockReason. Solo se puede omitir.</div>
                                                    }
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            @if (row.Action == ImportRowAction.Unchanged)
                                            {
                                                <span class="small text-muted">Nada que hacer</span>
                                            }
                                            else
                                            {
                                                <select name="d[@row.RowNumber]" class="custom-select custom-select-sm js-decision" aria-label="Qué hacer con la fila @row.RowNumber">
                                                    @if (row.State == ImportRowState.Existing)
                                                    {
                                                        <option value="" selected="@(row.Decision == "")">— Decidir —</option>
                                                        @if (row.CanOverwrite)
                                                        {
                                                            <option value="@ImportDecisions.Overwrite" selected="@(row.Decision == ImportDecisions.Overwrite)">Sobrescribir</option>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <option value="" selected="@(row.Decision == "")">@(row.Action == ImportRowAction.Blocked ? "Corregir en el Excel" : "Cargar")</option>
                                                    }
                                                    <option value="@ImportDecisions.Skip" selected="@(row.Decision == ImportDecisions.Skip)">Omitir esta fila</option>
                                                </select>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (shown.Count > pageSize)
                    {
                        <div class="small text-muted px-3 py-2 border-top">Se muestran las primeras @pageSize de @shown.Count. Use las acciones para todas las filas o descargue el Excel con el resultado para verlas completas.</div>
                    }
                }
            </div></div>
        </form>
    }
</div>

@section Scripts {
    <script>
        (function () {
            var decide = document.getElementById('im-decide-form');
            if (decide) {
                // Cada decisión se guarda al elegirla: la lista se vuelve a revisar con ella.
                decide.querySelectorAll('.js-decision').forEach(function (select) {
                    select.addEventListener('change', function () { HTMLFormElement.prototype.submit.call(decide); });
                });
                decide.querySelectorAll('.js-bulk').forEach(function (button) {
                    button.addEventListener('click', function (e) {
                        e.preventDefault();
                        var send = function () {
                            var hidden = document.createElement('input');
                            hidden.type = 'hidden'; hidden.name = 'bulk'; hidden.value = button.value;
                            decide.appendChild(hidden);
                            HTMLFormElement.prototype.submit.call(decide);
                        };
                        if (typeof Swal === 'undefined') { send(); return; }
                        Swal.fire({
                            title: button.getAttribute('data-title'), text: button.getAttribute('data-text'), type: 'question',
                            showCancelButton: true, confirmButtonText: 'Sí, aplicar', cancelButtonText: 'Cancelar', confirmButtonColor: '#7460ee'
                        }).then(function (r) { if (r && (r.isConfirmed === true || r.value === true)) send(); });
                    });
                });
            }

            var apply = document.getElementById('im-apply-form');
            if (apply) {
                apply.addEventListener('submit', function (e) {
                    if (apply.dataset.confirmed === '1') return;
                    e.preventDefault();
                    var send = function () {
                        apply.dataset.confirmed = '1';
                        var button = document.getElementById('im-apply');
                        if (button) { button.disabled = true; button.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Cargando…'; }
                        HTMLFormElement.prototype.submit.call(apply);
                    };
                    if (typeof Swal === 'undefined') { send(); return; }
                    Swal.fire({
                        title: '¿Cargar la planificación?',
                        text: 'Las prácticas quedarán aprobadas y ocuparán sus laboratorios. Después podrá reprogramarlas o reponerlas desde la grilla.',
                        type: 'question', showCancelButton: true, confirmButtonText: 'Sí, cargar', cancelButtonText: 'Cancelar', confirmButtonColor: '#36bea6'
                    }).then(function (r) { if (r && (r.isConfirmed === true || r.value === true)) send(); });
                });
            }
        })();
    </script>
}
