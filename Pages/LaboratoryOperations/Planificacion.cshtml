@page
@model Proyecto_Laboratorios_Univalle.Pages.LaboratoryOperations.PlanificacionModel
@{ ViewData["Title"] = "Planificación — Paso 1"; }

<div class="page-breadcrumb">
    <div class="row">
        <div class="col-12 d-flex justify-content-between align-items-start">
            <div>
                <h4 class="page-title text-uppercase text-primary font-weight-bold mb-0">PASO 1</h4>
                <h2 class="font-weight-bold text-dark">Planificación de Práctica</h2>
                <div class="text-muted small">Registra los datos de la sesión de laboratorio que se va a realizar.</div>
            </div>
            <button type="button" class="btn btn-outline-info px-3" onclick="buscarPlanes()">
                <i class="mdi mdi-calendar-search mr-1"></i> Buscar Código de Planificación
            </button>
        </div>
    </div>
</div>

<div class="container-fluid mt-3">
    @await Html.PartialAsync("../LaboratoryOperations/_StepsBar", 1)

    @* ── CARD DE CONFIRMACIÓN (solo visible tras crear) ── *@
    @if (Model.ShowConfirmation && Model.CreatedPlan != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-lg d-flex align-items-start mb-4">
            <i class="mdi mdi-check-circle mdi-36px mr-3 text-success"></i>
            <div>
                <h5 class="font-weight-bold mb-1">¡Planificación creada exitosamente!</h5>
                <table class="mb-2">
                    <tr><td class="font-weight-bold pr-3">ID Generado:</td><td><span class="badge badge-dark px-3 py-1">L3-@Model.CreatedPlan.Id</span></td></tr>
                    <tr><td class="font-weight-bold pr-3">Práctica:</td><td>@Model.CreatedPlan.PracticeName</td></tr>
                    <tr><td class="font-weight-bold pr-3">Fecha / Hora:</td><td>@Model.CreatedPlan.ScheduledDate.ToString("dd/MM/yyyy HH:mm")</td></tr>
                    <tr><td class="font-weight-bold pr-3">Laboratorio:</td><td>@Model.CreatedPlan.Laboratory?.Name</td></tr>
                    <tr><td class="font-weight-bold pr-3">Semana Académica:</td><td>@Model.CreatedPlan.AcademicWeek</td></tr>
                </table>
                <a asp-page="/LaboratoryOperations/Requerimientos" asp-route-planId="@Model.CreatedPlan.Id"
                   class="btn btn-dark font-weight-bold px-5">
                    Continuar al Paso 2 <i class="mdi mdi-arrow-right ml-1"></i>
                </a>
            </div>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-lg">
        <div class="card-body p-4">
            <h5 class="font-weight-bold mb-4 text-primary">Datos de la Sesión</h5>

            <form method="post">
                <div class="form-row">
                    <div class="form-group col-md-4">
                        <label class="small font-weight-bold text-muted">LABORATORIO <span class="text-danger">*</span></label>
                        <select asp-for="Plan.LaboratoryId" asp-items="Model.LaboratoriesList" class="custom-select" required>
                            <option value="">— Seleccionar sala —</option>
                        </select>
                    </div>
                    <div class="form-group col-md-4">
                        <label class="small font-weight-bold text-muted">DOCENTE RESPONSABLE <span class="text-danger">*</span></label>
                        <select asp-for="Plan.TeacherId" asp-items="Model.TeachersList" class="custom-select" required>
                            <option value="">— Seleccionar —</option>
                        </select>
                    </div>
                    <div class="form-group col-md-4">
                        <label class="small font-weight-bold text-muted">MATERIA / ASIGNATURA <span class="text-danger">*</span></label>
                        <select asp-for="Plan.SubjectId" asp-items="Model.SubjectsList" class="custom-select" required>
                            <option value="">— Seleccionar —</option>
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group col-md-3">
                        <label class="small font-weight-bold text-muted">GRUPO / PARALELO <span class="text-danger">*</span></label>
                        <select asp-for="Plan.GroupId" asp-items="Model.GroupsList" class="custom-select" required>
                            <option value="">— Seleccionar —</option>
                        </select>
                    </div>
                    <div class="form-group col-md-5">
                        <label class="small font-weight-bold text-muted">NOMBRE DE PRÁCTICA <span class="text-danger">*</span></label>
                        <input type="text" asp-for="Plan.PracticeName" class="form-control" required placeholder="Ej: Cocina Boliviana Contemporánea" />
                    </div>
                    <div class="form-group col-md-2">
                        <label class="small font-weight-bold text-muted">SEMANA ACADÉMICA</label>
                        <input type="number" asp-for="Plan.AcademicWeek" class="form-control" min="1" max="20" value="1" />
                    </div>
                    <div class="form-group col-md-2">
                        <label class="small font-weight-bold text-muted">FECHA Y HORA <span class="text-danger">*</span></label>
                        <input type="datetime-local" asp-for="Plan.ScheduledDate" class="form-control" required />
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <a asp-page="/LaboratoryOperations/Index" class="btn btn-outline-secondary px-4 py-2">
                        <i class="mdi mdi-arrow-left mr-1"></i> Cancelar
                    </a>
                    <button type="submit" class="btn btn-dark font-weight-bold px-5 py-2">
                        <i class="mdi mdi-content-save mr-1"></i> Crear Planificación
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ── MODAL BUSCAR PLANIFICACIONES ── *@
<div class="modal fade" id="modalBuscarPlanes" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title font-weight-bold"><i class="mdi mdi-calendar-search mr-2"></i>Planificaciones Existentes</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body p-0">
                <div class="text-center py-4" id="loadingPlans">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-muted">Cargando planificaciones...</p>
                </div>
                <div class="table-responsive" id="containerPlans" style="display:none;">
                    <table class="table table-hover mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>CÓDIGO</th>
                                <th>PRÁCTICA</th>
                                <th>LABORATORIO</th>
                                <th>DOCENTE</th>
                                <th>FECHA</th>
                                <th>ESTADO</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="tbodyPlans"></tbody>
                    </table>
                </div>
                <div class="text-center py-4 text-muted" id="emptyPlans" style="display:none;">
                    <i class="mdi mdi-calendar-blank mdi-36px d-block mb-2"></i>
                    No hay planificaciones registradas aún.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    async function buscarPlanes() {
        document.getElementById('loadingPlans').style.display = '';
        document.getElementById('containerPlans').style.display = 'none';
        document.getElementById('emptyPlans').style.display = 'none';
        $('#modalBuscarPlanes').modal('show');

        try {
            const response = await fetch('?handler=SearchPlans');
            const data = await response.json();
            const tbody = document.getElementById('tbodyPlans');
            tbody.innerHTML = '';

            if (data.length === 0) {
                document.getElementById('emptyPlans').style.display = '';
            } else {
                data.forEach(function(p) {
                    var statusBadge = p.status === 'Aprobado'
                        ? '<span class="badge badge-success">' + p.status + '</span>'
                        : '<span class="badge badge-secondary">' + p.status + '</span>';
                    var row = '<tr>' +
                        '<td class="font-weight-bold">L3-' + p.id + '</td>' +
                        '<td>' + p.practiceName + '</td>' +
                        '<td>' + p.lab + '</td>' +
                        '<td>' + p.teacher + '</td>' +
                        '<td>' + p.date + '</td>' +
                        '<td>' + statusBadge + '</td>' +
                        '<td><a href="Requerimientos?planId=' + p.id + '" class="btn btn-sm btn-success font-weight-bold"><i class="mdi mdi-arrow-right mr-1"></i>Seleccionar</a></td>' +
                        '</tr>';
                    tbody.innerHTML += row;
                });
                document.getElementById('containerPlans').style.display = '';
            }
        } catch (err) {
            document.getElementById('emptyPlans').style.display = '';
            document.getElementById('emptyPlans').innerHTML = '<i class="mdi mdi-alert mdi-36px d-block mb-2 text-danger"></i>Error cargando datos.';
        }
        document.getElementById('loadingPlans').style.display = 'none';
    }
</script>
}
