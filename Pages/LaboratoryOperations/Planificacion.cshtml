@page
@model Proyecto_Laboratorios_Univalle.Pages.LaboratoryOperations.PlanificacionModel
@using System.Text.Json
@{
    ViewData["Title"] = Model.Title;
    var readonlyClass = Model.IsReadOnly ? "bg-light" : null;
    var isEdit = Model.Id.HasValue && !Model.IsReadOnly;

    // Hora completa de un periodo (ej. "07:35 – 08:25") para las fichas del selector.
    string FormatPeriod(TimeSpan s, TimeSpan e) => $"{s.ToString(@"hh\:mm")} – {e.ToString(@"hh\:mm")}";

    // Serializamos las opciones de práctica para que el JS filtre por materia en el cliente.
    var practiceJson = JsonSerializer.Serialize(
        Model.PracticeOptions.Select(m => new
        {
            id = m.Id,
            subjectId = m.SubjectId,
            code = m.Code,
            label = m.Label,
            requirementCount = m.RequirementCount
        }),
        new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });

    // Sugerencias de grupo (datalist) con sus metadatos para autocompletar estudiantes y factor.
    var groupJson = JsonSerializer.Serialize(
        Model.GroupOptions.Select(g => new
        {
            subjectId = g.SubjectId,
            name = g.Name,
            label = g.Label,
            studentCount = g.StudentCount,
            scalingFactor = g.ScalingFactor
        }),
        new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });

    // Catálogo de periodos para calcular el rango resultante (fecha + periodo inicial + cantidad).
    var periodJson = JsonSerializer.Serialize(
        Model.Periods.Select(p => new
        {
            id = p.Id,
            order = p.Order,
            start = p.StartTime.ToString(@"hh\:mm"),
            end = p.EndTime.ToString(@"hh\:mm")
        }),
        new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
}

<div class="container-fluid mt-3">
    <partial name="_PlanningContext" model="Model.Context" />

    <form method="post" asp-route-id="@Model.Id" asp-route-managementId="@Model.ManagementId" id="form-planificacion">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ManagementId" />
        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 rounded-lg">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-4">
                            <div class="rounded-circle bg-light-primary text-primary p-3 mr-3"><i class="fas fa-calendar-check fa-lg"></i></div>
                            <div>
                                <h5 class="font-weight-bold text-primary mb-1">Datos de la planificación</h5>
                                <small class="text-muted">Selecciona la materia, la práctica del catálogo, el laboratorio, el docente y el horario (fecha + periodos) de la sesión.</small>
                            </div>
                        </div>

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        @if (!string.IsNullOrWhiteSpace(Model.ScheduleCode))
                        {
                            <div class="alert alert-info border-0 rounded d-flex align-items-center mb-4 small">
                                <i class="fas fa-calendar-check fa-2x mr-3"></i>
                                <div>
                                    <strong>Programación vinculada:</strong> <span class="font-monospace">@Model.ScheduleCode</span><br />
                                    <span class="text-muted">Esta planificación ya tiene una programación registrada en la gestión.</span>
                                </div>
                            </div>
                        }

                        @if (Model.IsReadOnly)
                        {
                            <div class="alert alert-warning border-0 rounded d-flex align-items-center mb-4 small">
                                <i class="fas fa-eye fa-2x mr-3"></i>
                                <div>
                                    <strong>Solo consulta.</strong>
                                    @if (Model.StatusText != "Planificada")
                                    {
                                        <span>La planificación está en estado @Model.StatusText y no se puede editar.</span>
                                    }
                                    else
                                    {
                                        <span>La gestión de esta planificación no admite cambios.</span>
                                    }
                                </div>
                            </div>
                        }

                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label asp-for="Input.SubjectId" class="small font-weight-bold text-muted"></label>
                                <select asp-for="Input.SubjectId" asp-items="Model.SubjectList" class="form-control select2" id="subject-select" disabled="@(Model.IsReadOnly ? "disabled" : null)">
                                    <option value="0">— Seleccionar materia —</option>
                                </select>
                                <span asp-validation-for="Input.SubjectId" class="text-danger small"></span>
                                @if (Model.SubjectList.Count == 0)
                                {
                                    <small class="text-warning d-block mt-1"><i class="fas fa-exclamation-triangle mr-1"></i> No hay materias activas registradas.</small>
                                }
                                <div id="practice-status" class="mt-2 small"></div>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="Input.PracticeId" class="small font-weight-bold text-muted"></label>
                                <div class="d-flex align-items-center">
                                    <select asp-for="Input.PracticeId" id="practice-select" class="form-control select2 flex-grow-1" disabled="@(Model.IsReadOnly ? "disabled" : null)" data-placeholder="— Seleccionar práctica —">
                                        <option value="0">— Seleccionar práctica —</option>
                                    </select>
                                    @if (Model.CanCreatePractice && !Model.IsReadOnly)
                                    {
                                        <button type="button" id="new-practice-link" class="btn btn-link btn-sm ml-2 flex-shrink-0" data-toggle="modal" data-target="#modal-new-practice" style="display:none;">
                                            <i class="fas fa-plus mr-1"></i>Nueva práctica
                                        </button>
                                    }
                                </div>
                                <span asp-validation-for="Input.PracticeId" class="text-danger small"></span>
                                <small id="practice-hint" class="text-muted d-block mt-1" style="display:none;"></small>
                                <small id="practice-empty-hint" class="text-warning d-block mt-1" style="display:none;">
                                    <i class="fas fa-exclamation-triangle mr-1"></i> No hay prácticas del catálogo para la materia seleccionada.
                                </small>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label asp-for="Input.LaboratoryId" class="small font-weight-bold text-muted"></label>
                                <select asp-for="Input.LaboratoryId" asp-items="Model.LaboratoryList" class="form-control select2" disabled="@(Model.IsReadOnly ? "disabled" : null)">
                                    <option value="0">— Seleccionar laboratorio —</option>
                                </select>
                                <span asp-validation-for="Input.LaboratoryId" class="text-danger small"></span>
                                @if (Model.LaboratoryList.Count() == 0)
                                {
                                    <small class="text-warning d-block mt-1"><i class="fas fa-exclamation-triangle mr-1"></i> No hay laboratorios activos.</small>
                                }
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="Input.TeacherPersonId" class="small font-weight-bold text-muted"></label>
                                <select asp-for="Input.TeacherPersonId" asp-items="Model.TeacherList" class="form-control select2" disabled="@(Model.IsReadOnly ? "disabled" : null)">
                                    <option value="0">— Seleccionar docente —</option>
                                </select>
                                <span asp-validation-for="Input.TeacherPersonId" class="text-danger small"></span>
                                @if (Model.TeacherList.Count() == 0)
                                {
                                    <small class="text-warning d-block mt-1"><i class="fas fa-exclamation-triangle mr-1"></i> No hay docentes registrados.</small>
                                }
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-4">
                                <label asp-for="Input.GroupName" class="small font-weight-bold text-muted"></label>
                                <input asp-for="Input.GroupName" id="group-name" list="group-options" maxlength="20" class="form-control text-uppercase @readonlyClass" placeholder="Ej: A1, B, LND-2" disabled="@(Model.IsReadOnly ? "disabled" : null)" />
                                <datalist id="group-options"></datalist>
                                <span asp-validation-for="Input.GroupName" class="text-danger small"></span>
                            </div>
                            <div class="form-group col-md-4">
                                <label asp-for="Input.StudentCount" class="small font-weight-bold text-muted"></label>
                                <input asp-for="Input.StudentCount" id="student-count" type="number" min="0" max="500" class="form-control @readonlyClass" disabled="@(Model.IsReadOnly ? "disabled" : null)" />
                                <span asp-validation-for="Input.StudentCount" class="text-danger small"></span>
                            </div>
                            <div class="form-group col-md-4">
                                <label asp-for="Input.ScalingFactor" class="small font-weight-bold text-muted"></label>
                                <input asp-for="Input.ScalingFactor" id="scaling-factor" type="number" min="1" max="100" class="form-control @readonlyClass" disabled="@(Model.IsReadOnly ? "disabled" : null)" />
                                <span asp-validation-for="Input.ScalingFactor" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-12">
                                <div class="custom-control custom-checkbox mt-2">
                                    <input asp-for="Input.IsDemonstrative" id="is-demonstrative" type="checkbox" class="custom-control-input" disabled="@(Model.IsReadOnly ? "disabled" : null)" />
                                    <label asp-for="Input.IsDemonstrative" class="custom-control-label small font-weight-bold text-muted"></label>
                                </div>
                            </div>
                        </div>

                        <div class="bg-light p-3 rounded mb-4 border-left" style="border-left: 4px solid #7460ee;">
                            <h5 class="text-dark font-weight-bold mb-3 small text-uppercase" style="letter-spacing:.04em;">
                                <i class="fas fa-clock mr-2 text-primary"></i>Horario de la sesión
                            </h5>
                            <div class="form-row">
                                <div class="form-group col-md-4">
                                    <label asp-for="Input.Date" class="small font-weight-bold text-muted"></label>
                                    <input asp-for="Input.Date" type="date" class="form-control @readonlyClass" disabled="@(Model.IsReadOnly ? "disabled" : null)" />
                                    <span asp-validation-for="Input.Date" class="text-danger small"></span>
                                    <small class="form-text text-muted"><i class="fas fa-info-circle mr-1"></i>Lunes a sábado, dentro del calendario de la gestión.</small>
                                </div>
                                <div class="form-group col-md-8">
                                    <label class="small font-weight-bold text-muted d-block">Periodos de la sesión <span class="text-danger">*</span></label>
                                    @* Campos enviados al servidor: el selector visual los sincroniza. *@
                                    <input type="hidden" asp-for="Input.StartPeriodId" id="period-start" />
                                    <input type="hidden" asp-for="Input.PeriodCount" id="period-count" />
                                    @if (Model.Periods.Count == 0)
                                    {
                                        <div class="alert alert-warning border-0 small py-2 mb-2">
                                            <i class="fas fa-exclamation-triangle mr-1"></i>El catálogo de periodos académicos no está configurado.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="pp-grid @(Model.IsReadOnly ? "pp-grid--readonly" : null)" id="period-grid" role="group" aria-label="Selector visual de periodos">
                                            @foreach (var p in Model.Periods.OrderBy(x => x.Order))
                                            {
                                                <button type="button" class="pp-slot" data-period-id="@p.Id" data-order="@p.Order"
                                                        title="Periodo @p.Order · @FormatPeriod(p.StartTime, p.EndTime)"
                                                        disabled="@(Model.IsReadOnly ? "disabled" : null)">
                                                    <span class="pp-slot__num">@p.Order</span>
                                                    <span class="pp-slot__time">@FormatPeriod(p.StartTime, p.EndTime)</span>
                                                </button>
                                            }
                                        </div>
                                        <div class="d-flex flex-wrap align-items-center mt-2">
                                            <span class="small font-weight-bold text-muted mr-2">Cantidad de periodos</span>
                                            <div class="pp-stepper" id="period-stepper" role="group" aria-label="Cantidad de periodos">
                                                <button type="button" class="pp-stepper__btn" data-step="-1" aria-label="Quitar un periodo" disabled="@(Model.IsReadOnly ? "disabled" : null)">&minus;</button>
                                                <span class="pp-stepper__value" id="period-count-label">@Math.Max(1, Model.Input.PeriodCount)</span>
                                                <button type="button" class="pp-stepper__btn" data-step="1" aria-label="Agregar un periodo" disabled="@(Model.IsReadOnly ? "disabled" : null)">+</button>
                                            </div>
                                            <small class="text-muted ml-2"><i class="fas fa-hand-pointer mr-1"></i>Toca una ficha para elegir el periodo de inicio.</small>
                                        </div>
                                        <div class="pp-legend mt-2">
                                            <span class="pp-legend__item"><span class="pp-legend__swatch pp-legend__swatch--free"></span>Disponible</span>
                                            <span class="pp-legend__item"><span class="pp-legend__swatch pp-legend__swatch--block"></span>Sesión elegida</span>
                                            <span class="pp-legend__item"><span class="pp-legend__swatch pp-legend__swatch--occupied"></span>Ocupado</span>
                                            <span class="pp-legend__item"><span class="pp-legend__swatch pp-legend__swatch--gap"></span>Separación entre prácticas</span>
                                            <span class="pp-legend__item"><span class="pp-legend__swatch pp-legend__swatch--group-own"></span>Clase del grupo (esta materia)</span>
                                            <span class="pp-legend__item"><span class="pp-legend__swatch pp-legend__swatch--group-busy"></span>El grupo tiene clase de otra materia</span>
                                        </div>
                                    }
                                    <span asp-validation-for="Input.StartPeriodId" class="text-danger small d-block"></span>
                                    <span asp-validation-for="Input.PeriodCount" class="text-danger small d-block"></span>
                                    <div id="slot-range" class="small font-weight-bold text-primary mt-1" style="display:none;"></div>
                                    <div id="period-occupancy" class="small mt-1" style="display:none;"></div>
                                    <div id="period-group" class="small mt-1" style="display:none;"></div>
                                </div>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-12">
                                <label asp-for="Input.Observations" class="small font-weight-bold text-muted"></label>
                                <textarea asp-for="Input.Observations" class="form-control" rows="2" placeholder="Observaciones o contexto de la sesión" disabled="@(Model.IsReadOnly ? "disabled" : null)"></textarea>
                                <span asp-validation-for="Input.Observations" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                            <a asp-page="./Index" class="btn btn-outline-secondary btn-rounded px-4">
                                <i class="fas fa-times mr-1"></i> Cancelar
                            </a>

                            @if (Model.IsReadOnly)
                            {
                                <a asp-page="./Requerimientos" asp-route-planId="@Model.Id" class="btn btn-primary btn-rounded font-weight-bold px-4">
                                    Ver requerimientos <i class="mdi mdi-arrow-right ml-1"></i>
                                </a>
                            }
                            else if (isEdit)
                            {
                                <button type="submit" class="btn btn-primary btn-rounded font-weight-bold px-4 js-edit-confirm">
                                    Guardar cambios <i class="mdi mdi-content-save ml-1"></i>
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-primary btn-rounded font-weight-bold px-4">
                                    Guardar y definir requerimientos <i class="mdi mdi-arrow-right ml-1"></i>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 mt-3 mt-lg-0">
                <div class="card border-0 shadow-sm rounded-lg h-100">
                    <div class="card-body p-4">
                        <span class="text-uppercase small text-primary font-weight-bold">Planificación dentro del flujo</span>
                        <h5 class="font-weight-bold text-dark mt-2">Una planificación, tres pasos</h5>
                        <div class="d-flex mb-3"><span class="badge badge-primary mr-2">1</span><span>Elegir materia y práctica del catálogo; luego laboratorio, docente y horario por periodos.</span></div>
                        <div class="d-flex mb-3"><span class="badge badge-info mr-2">2</span><span>Agregar materiales y cantidades.</span></div>
                        <div class="d-flex"><span class="badge badge-warning mr-2">3</span><span>Validar disponibilidad: conflictos y rotaciones.</span></div>

                        <div class="alert alert-light border mt-4 mb-0 small">
                            <i class="fas fa-info-circle text-primary mr-1"></i>
                            El horario se define tocando la ficha del periodo de inicio y ajustando la cantidad de periodos: la hora de inicio y de fin se calculan del catálogo de periodos académicos. Las fichas grises muestran la ocupación del ambiente elegido; entre prácticas del mismo ambiente debe quedar un periodo libre.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@if (Model.CanCreatePractice && !Model.IsReadOnly)
{
    <div class="modal fade" id="modal-new-practice" tabindex="-1" role="dialog" aria-labelledby="modal-new-practice-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title font-weight-bold" id="modal-new-practice-title">
                        <i class="fas fa-flask mr-1"></i>Nueva práctica
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Cerrar">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form id="new-practice-form" novalidate>
                    <div class="modal-body">
                        <div id="new-practice-error" class="alert alert-danger small" role="alert" style="display:none;"></div>
                        <div class="form-group">
                            <label class="small font-weight-bold text-muted">Materia</label>
                            <div id="new-practice-subject" class="font-weight-bold text-dark"></div>
                            <input type="hidden" id="new-practice-management-id" value="@Model.ManagementId" />
                        </div>
                        <div class="form-group">
                            <label for="new-practice-name" class="small font-weight-bold text-muted">Nombre de la práctica <span class="text-danger">*</span></label>
                            <input type="text" id="new-practice-name" class="form-control" maxlength="200" placeholder="Ej: Cortes básicos de vegetales" required />
                        </div>
                        <div class="form-group">
                            <label for="new-practice-description" class="small font-weight-bold text-muted">Descripción</label>
                            <textarea id="new-practice-description" class="form-control" rows="3" maxlength="2000" placeholder="Describe brevemente el objetivo o contenido de la práctica"></textarea>
                        </div>
                        <small class="form-text text-muted"><i class="fas fa-info-circle mr-1"></i>El código PRC-xxxxx se genera automáticamente.</small>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Cancelar</button>
                        <button type="submit" id="new-practice-save" class="btn btn-primary font-weight-bold">
                            <i class="fas fa-save mr-1"></i>Guardar práctica
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Styles {
    <link href="~/assets/libs/select2/dist/css/select2.min.css" rel="stylesheet">
    <link href="~/css/planificacion.css" rel="stylesheet">
    <style>
        .bg-light-primary { background-color: #e8e7ff; }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/libs/select2/dist/js/select2.full.min.js"></script>
    <script src="~/js/planificacion-periodos.js"></script>
    <script>
        (function () {
            var practices = @Html.Raw(practiceJson);
            var groups = @Html.Raw(groupJson);
            var periods = @Html.Raw(periodJson);
            var canCreatePractice = @(Model.CanCreatePractice ? "true" : "false");
            var isReadOnly = @(Model.IsReadOnly ? "true" : "false");
            var managementId = @(Model.ManagementId ?? 0);
            var subjectLabels = {};

            var $subject = $('#subject-select');
            var $practice = $('#practice-select');
            var $practiceStatus = $('#practice-status');
            var $emptyHint = $('#practice-empty-hint');
            var $hint = $('#practice-hint');
            var $group = $('#group-name');
            var $student = $('#student-count');
            var $factor = $('#scaling-factor');
            var $datalist = $('#group-options');
            var $newPracticeLink = $('#new-practice-link');

            // Mapa de id -> texto de materia (para mostrar la materia seleccionada dentro del modal).
            $subject.find('option').each(function () {
                var v = $(this).val();
                if (v && v !== '0') {
                    subjectLabels[v] = $(this).text();
                }
            });

            // ── Selector visual de periodos (fichas + stepper + ocupación del ambiente + horario del grupo) ──
            if (window.PeriodSelector) {
                window.PeriodSelector.create({
                    grid: '#period-grid',
                    startInput: '#period-start',
                    countInput: '#period-count',
                    countLabel: '#period-count-label',
                    stepper: '#period-stepper',
                    range: '#slot-range',
                    occupancyBox: '#period-occupancy',
                    groupBox: '#period-group',
                    dateInput: '#Input_Date',
                    laboratorySelect: '#Input_LaboratoryId',
                    subjectSelect: '#subject-select',
                    groupInput: '#group-name',
                    periods: periods,
                    readOnly: isReadOnly,
                    excludeId: @(Model.Id ?? 0),
                    managementId: managementId,
                    occupancyUrl: window.location.pathname,
                    groupScheduleUrl: window.location.pathname
                });
            }

            function renderPracticeStatus(subjectId) {
                if (!subjectId || Number(subjectId) === 0) {
                    $practiceStatus.html('<span class="text-muted"><i class="fas fa-info-circle mr-1"></i>Elige la materia para ver sus prácticas del catálogo.</span>');
                    if ($newPracticeLink.length) $newPracticeLink.hide();
                    return;
                }
                var matched = practices.filter(function (p) { return p.subjectId === Number(subjectId); });
                if (matched.length > 0) {
                    var n = matched.length;
                    $practiceStatus.html('<span class="badge badge-success"><i class="fas fa-check-circle mr-1"></i>Esta materia tiene ' + n + ' práctica(s) en el catálogo</span>');
                    if ($newPracticeLink.length) $newPracticeLink.show();
                } else {
                    var html = '<div class="alert alert-warning border-0 small p-2 mb-2"><i class="fas fa-exclamation-triangle mr-1"></i>Esta materia todavía no tiene prácticas en el catálogo.</div>';
                    if (canCreatePractice && !isReadOnly) {
                        html += '<button type="button" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#modal-new-practice"><i class="fas fa-plus mr-1"></i>Crear práctica para esta materia</button>';
                    } else {
                        html += '<div class="text-muted small">Solicita a un administrador que registre la práctica.</div>';
                    }
                    $practiceStatus.html(html);
                    if ($newPracticeLink.length) $newPracticeLink.hide();
                }
            }

            function renderPractices(subjectId) {
                // Mantenemos el valor seleccionado si la materia sigue siendo la misma.
                var previousValue = $practice.val() || '0';
                $practice.empty();
                $practice.append('<option value="0">— Seleccionar práctica —</option>');

                var matched = [];
                if (subjectId && Number(subjectId) > 0) {
                    matched = practices.filter(function (p) { return p.subjectId === Number(subjectId); });
                }
                matched.forEach(function (p) {
                    var text = p.label + ' · ' + (p.requirementCount > 0
                        ? p.requirementCount + ' artículo(s) en receta'
                        : 'sin receta');
                    $practice.append('<option value="' + p.id + '" data-requirements="' + p.requirementCount + '">' + text + '</option>');
                });

                // Si el valor anterior sigue disponible, lo conservamos.
                var stillVisible = matched.some(function (p) { return String(p.id) === String(previousValue); });
                $practice.val(stillVisible ? previousValue : '0');

                if (subjectId && Number(subjectId) > 0 && matched.length === 0) {
                    $practice.prop('disabled', true);
                } else if (!isReadOnly) {
                    $practice.prop('disabled', false);
                }

                if (matched.length === 0 && subjectId && Number(subjectId) > 0) {
                    $emptyHint.show();
                    $hint.hide();
                } else {
                    $emptyHint.hide();
                    $hint.show();
                }

                updatePracticeHint();
                $practice.trigger('change.select2');
            }

            function updatePracticeHint() {
                var selected = $practice.find('option:selected');
                if (!selected.length || selected.val() === '0') {
                    $hint.hide();
                    return;
                }
                var requirements = selected.data('requirements');
                if (requirements > 0) {
                    $hint.html('<i class="fas fa-list-check mr-1"></i> La receta tiene <strong>' + requirements + '</strong> artículo(s). Podrás cargarlos en el paso 2.');
                } else {
                    $hint.html('<i class="fas fa-info-circle mr-1"></i> Esta práctica no tiene una receta registrada; agrega los artículos manualmente en el paso 2.');
                }
                $hint.show();
            }

            function renderGroupOptions(subjectId) {
                $datalist.empty();
                if (!subjectId) return;
                groups
                    .filter(function (g) { return g.subjectId === Number(subjectId); })
                    .forEach(function (g) {
                        var opt = document.createElement('option');
                        opt.value = g.name;
                        opt.label = g.label || g.name;
                        opt.dataset.student = g.studentCount != null ? g.studentCount : '';
                        opt.dataset.factor = g.scalingFactor != null ? g.scalingFactor : '';
                        $datalist.append(opt);
                    });
            }

            // Cambio de materia.
            $subject.on('change', function () {
                var subjectId = $(this).val();
                renderPractices(subjectId);
                renderGroupOptions(subjectId);
                renderPracticeStatus(subjectId);
            });

            // Cambio de práctica.
            $practice.on('change', function () {
                updatePracticeHint();
            });

            // Sugerencia de grupo seleccionada.
            $group.on('input change', function () {
                var typed = ($group.val() || '').trim().toUpperCase();
                $group.val(typed);
                var match = groups.find(function (g) {
                    return (g.name || '').toUpperCase() === typed;
                });
                if (!match) return;
                if (match.studentCount != null && $student.length) {
                    $student.val(match.studentCount);
                }
                if (match.scalingFactor != null && $factor.length) {
                    $factor.val(match.scalingFactor);
                }
            });

            // Estado inicial.
            var initialSubject = $subject.val() || '0';
            renderPractices(initialSubject);
            renderGroupOptions(initialSubject);
            renderPracticeStatus(initialSubject);
            updatePracticeHint();

            // Confirmación previa al guardar una edición.
            var form = document.getElementById('form-planificacion');
            var editButton = form ? form.querySelector('.js-edit-confirm') : null;
            if (form && editButton) {
                form.addEventListener('submit', function (e) {
                    if (form.dataset.confirmed === '1') return true;
                    e.preventDefault();
                    if (typeof Swal === 'undefined') {
                        form.dataset.confirmed = '1';
                        HTMLFormElement.prototype.submit.call(form);
                        return;
                    }
                    Swal.fire({
                        title: '¿Guardar cambios?',
                        text: 'Se actualizará la planificación @Model.Code con los datos del formulario.',
                        type: 'question',
                        showCancelButton: true,
                        confirmButtonText: 'Sí, guardar',
                        cancelButtonText: 'Cancelar',
                        confirmButtonColor: '#7460ee',
                        cancelButtonColor: '#6c757d'
                    }).then(function (result) {
                        if (result && (result.isConfirmed === true || result.value === true)) {
                            form.dataset.confirmed = '1';
                            HTMLFormElement.prototype.submit.call(form);
                        }
                    });
                });
            }

            // Modal: solo se renderiza cuando CanCreatePractice && !IsReadOnly.
            var $modal = $('#modal-new-practice');
            if ($modal.length) {
                var $form = $('#new-practice-form');
                var $errBox = $('#new-practice-error');
                var $name = $('#new-practice-name');
                var $desc = $('#new-practice-description');
                var $save = $('#new-practice-save');
                var $subjectLabel = $('#new-practice-subject');
                var $managementInput = $('#new-practice-management-id');

                function resetModal() {
                    $errBox.hide().text('');
                    $name.val('');
                    $desc.val('');
                    $save.prop('disabled', false);
                }

                function syncSubjectLabel() {
                    var sid = $subject.val() || '0';
                    $subjectLabel.text(subjectLabels[sid] || '');
                    $managementInput.val(managementId);
                }

                $modal.on('show.bs.modal', function () {
                    syncSubjectLabel();
                    resetModal();
                });

                $modal.on('hidden.bs.modal', function () {
                    resetModal();
                });

                $form.on('submit', function (e) {
                    e.preventDefault();
                    var name = ($name.val() || '').trim();
                    if (!name) {
                        $errBox.text('El nombre de la práctica es obligatorio.').show();
                        $name.trigger('focus');
                        return;
                    }
                    var subjectId = $subject.val() || '0';
                    if (!subjectId || Number(subjectId) === 0) {
                        $errBox.text('Selecciona primero una materia.').show();
                        return;
                    }
                    var description = ($desc.val() || '').trim();
                    var token = $('#form-planificacion input[name="__RequestVerificationToken"]').val() || '';

                    $save.prop('disabled', true);
                    $.ajax({
                        url: window.location.pathname + '?handler=CreatePractice',
                        method: 'POST',
                        data: {
                            __RequestVerificationToken: token,
                            subjectId: subjectId,
                            name: name,
                            description: description,
                            managementId: managementId
                        }
                    }).done(function (resp) {
                        if (resp && resp.ok && resp.practice) {
                            practices.push(resp.practice);
                            renderPractices(subjectId);
                            $practice.val(String(resp.practice.id));
                            $practice.trigger('change.select2');
                            renderPracticeStatus(subjectId);
                            $modal.modal('hide');
                            if (window.Swal) {
                                Swal.fire({
                                    type: 'success',
                                    title: 'Práctica creada',
                                    text: resp.practice.label || name
                                });
                            }
                        } else {
                            var msg = (resp && resp.message) ? resp.message : 'No se pudo crear la práctica.';
                            $errBox.text(msg).show();
                        }
                    }).fail(function (xhr) {
                        var msg = 'No se pudo crear la práctica.';
                        if (xhr && xhr.responseJSON && xhr.responseJSON.message) {
                            msg = xhr.responseJSON.message;
                        } else if (xhr && xhr.responseText) {
                            try {
                                var parsed = JSON.parse(xhr.responseText);
                                if (parsed && parsed.message) msg = parsed.message;
                            } catch (_) { /* mensaje genérico */ }
                        }
                        $errBox.text(msg).show();
                    }).always(function () {
                        $save.prop('disabled', false);
                    });
                });
            }
        })();
    </script>
}
