@page
@model Proyecto_Laboratorios_Univalle.Pages.LaboratoryOperations.PlanificacionModel
@{ ViewData["Title"] = "Planificación de práctica"; }

<div class="page-breadcrumb">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h4 class="page-title text-uppercase text-primary font-weight-bold mb-0">OPERACIÓN DE LABORATORIOS</h4>
            <h2 class="font-weight-bold text-dark">@Model.StatusText</h2>
            <div class="text-muted small">MVP local: registra una práctica y continúa con sus requerimientos.</div>
        </div>
        <div class="col-md-4 text-md-right mt-3 mt-md-0">
            <span class="badge badge-light border px-3 py-2"><i class="fas fa-database mr-1 text-success"></i> Catálogos locales</span>
        </div>
    </div>
</div>

<div class="container-fluid mt-3">
    @await Html.PartialAsync("../LaboratoryOperations/_StepsBar", 1)

    <form method="post" asp-route-id="@Model.Id" id="form-planificacion">
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 rounded-lg">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-4">
                            <div class="rounded-circle bg-light-primary text-primary p-3 mr-3"><i class="far fa-calendar-alt fa-lg"></i></div>
                            <div>
                                <h5 class="font-weight-bold text-primary mb-1">Datos de la práctica</h5>
                                <small class="text-muted">Los campos se validan en el servidor y se conservan durante esta sesión.</small>
                            </div>
                        </div>

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label asp-for="Input.FacultyId" class="small font-weight-bold text-muted"></label>
                                <select asp-for="Input.FacultyId" asp-items="Model.FacultyList" class="custom-select">
                                    <option value="0">— Seleccionar facultad —</option>
                                </select>
                                <span asp-validation-for="Input.FacultyId" class="text-danger small"></span>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="Input.CareerId" class="small font-weight-bold text-muted"></label>
                                <select asp-for="Input.CareerId" asp-items="Model.CareerList" class="custom-select">
                                    <option value="0">— Seleccionar carrera —</option>
                                </select>
                                <span asp-validation-for="Input.CareerId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-7">
                                <label asp-for="Input.LaboratoryId" class="small font-weight-bold text-muted"></label>
                                <select asp-for="Input.LaboratoryId" asp-items="Model.LaboratoryList" class="custom-select">
                                    <option value="0">— Seleccionar laboratorio —</option>
                                </select>
                                <span asp-validation-for="Input.LaboratoryId" class="text-danger small"></span>
                            </div>
                            <div class="form-group col-md-5">
                                <label asp-for="Input.ResponsibleName" class="small font-weight-bold text-muted"></label>
                                <input asp-for="Input.ResponsibleName" class="form-control" placeholder="Ej. Chef responsable" />
                                <span asp-validation-for="Input.ResponsibleName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-7">
                                <label asp-for="Input.Subject" class="small font-weight-bold text-muted"></label>
                                <input asp-for="Input.Subject" class="form-control" placeholder="Ej. Cocina Boliviana Contemporánea" />
                                <span asp-validation-for="Input.Subject" class="text-danger small"></span>
                            </div>
                            <div class="form-group col-md-2">
                                <label asp-for="Input.Group" class="small font-weight-bold text-muted"></label>
                                <input asp-for="Input.Group" class="form-control" placeholder="A" />
                                <span asp-validation-for="Input.Group" class="text-danger small"></span>
                            </div>
                            <div class="form-group col-md-3">
                                <label asp-for="Input.PracticeNumber" class="small font-weight-bold text-muted"></label>
                                <input asp-for="Input.PracticeNumber" class="form-control" min="1" />
                                <span asp-validation-for="Input.PracticeNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-4">
                                <label asp-for="Input.PracticeDate" class="small font-weight-bold text-muted"></label>
                                <input asp-for="Input.PracticeDate" class="form-control" />
                                <span asp-validation-for="Input.PracticeDate" class="text-danger small"></span>
                            </div>
                            <div class="form-group col-md-4">
                                <label asp-for="Input.StartTime" class="small font-weight-bold text-muted">Hora inicio</label>
                                <input asp-for="Input.StartTime" type="time" class="form-control" />
                                <span asp-validation-for="Input.StartTime" class="text-danger small"></span>
                            </div>
                            <div class="form-group col-md-4">
                                <label asp-for="Input.EndTime" class="small font-weight-bold text-muted">Hora fin</label>
                                <input asp-for="Input.EndTime" type="time" class="form-control" />
                                <span asp-validation-for="Input.EndTime" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-5">
                                <label asp-for="Input.MaterialCategory" class="small font-weight-bold text-muted">Categoría de material</label>
                                <select asp-for="Input.MaterialCategory" class="custom-select">
                                    <option>Gastronomía (Utensilios)</option>
                                    <option>Gastronomía (Misceláneos)</option>
                                    <option>Gastronomía (Botiquín)</option>
                                    <option>Limpieza</option>
                                </select>
                            </div>
                            <div class="form-group col-md-7">
                                <label asp-for="Input.Observations" class="small font-weight-bold text-muted"></label>
                                <textarea asp-for="Input.Observations" class="form-control" rows="2" placeholder="Observaciones o contexto de la práctica"></textarea>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                            <a asp-page="./Index" class="btn btn-outline-secondary btn-rounded px-4">Cancelar</a>
                            <button type="submit" class="btn btn-primary btn-rounded font-weight-bold px-4">
                                Guardar y definir requerimientos <i class="mdi mdi-arrow-right ml-1"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 mt-3 mt-lg-0">
                <div class="card border-0 shadow-sm rounded-lg h-100">
                    <div class="card-body p-4">
                        <span class="text-uppercase small text-primary font-weight-bold">Flujo demostrable</span>
                        <h5 class="font-weight-bold text-dark mt-2">Una planificación, cuatro decisiones</h5>
                        <div class="d-flex mb-3"><span class="badge badge-primary mr-2">1</span><span>Registrar fecha, sala y responsable.</span></div>
                        <div class="d-flex mb-3"><span class="badge badge-info mr-2">2</span><span>Agregar materiales y cantidades.</span></div>
                        <div class="d-flex mb-3"><span class="badge badge-warning mr-2">3</span><span>Validar disponibilidad y solapamientos.</span></div>
                        <div class="d-flex"><span class="badge badge-success mr-2">4</span><span>Confirmar operación, devolución o incidencia.</span></div>
                        <div class="alert alert-light border mt-4 mb-0 small">
                            <i class="fas fa-info-circle text-primary mr-1"></i>
                            Esta primera versión guarda el recorrido en la sesión del navegador para no modificar aún el esquema histórico.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Styles {
<style>
    .bg-light-primary { background-color: #e8f0fe; }
</style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
