@page
@model Proyecto_Laboratorios_Univalle.Pages.LaboratoryOperations.PracticasModel
@{
    ViewData["Title"] = "Prácticas";
    var statusText = Model.Status switch
    {
        Models.L3RequestStatus.Planned => "Planificado",
        Models.L3RequestStatus.Approved => "Aprobado",
        Models.L3RequestStatus.Finalized => "Finalizado",
        Models.L3RequestStatus.Cancelled => "Cancelado",
        _ => Model.Status ?? string.Empty
    };
}

<div class="page-breadcrumb">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h4 class="page-title text-uppercase text-primary font-weight-bold mb-0">PLANIFICACIÓN</h4>
            <h2 class="font-weight-bold text-dark">Prácticas</h2>
            @if (Model.Planning != null)
            {
                <div class="text-muted small">
                    <span class="font-weight-bold text-dark">@Model.Planning.Name</span>
                    · <span>@Model.Planning.ManagementCode · @Model.Planning.FacultyName · @Model.Planning.CareerName</span>
                    · <span>@Model.Planning.StartDate.ToString("dd/MM/yyyy") – @Model.Planning.EndDate.ToString("dd/MM/yyyy")</span>
                    <span class="badge badge-@(Model.Planning.IsActive ? "success" : "secondary") px-2 py-1 rounded-pill ml-1">@Model.Planning.StatusText</span>
                </div>
            }
            else
            {
                <div class="text-muted small">Listado de prácticas registradas dentro de la planificación académica activa.</div>
            }
        </div>
        <div class="col-md-4 text-md-right mt-3 mt-md-0">
            <a asp-page="./Index" class="btn btn-outline-secondary btn-rounded px-3 mr-1">
                <i class="fas fa-tachometer-alt mr-1"></i> Panel de planificación
            </a>
            @if (Model.Planning?.IsActive == true)
            {
                <a asp-page="./Practica" class="btn btn-primary btn-rounded font-weight-bold px-4">
                    <i class="fas fa-plus mr-1"></i> Nueva práctica
                </a>
            }
        </div>
    </div>
</div>

<div class="container-fluid mt-3">

    @if (Model.Planning == null)
    {
        <div class="card border-0 shadow-sm rounded-lg">
            <div class="card-body text-center p-5">
                <div class="mb-3">
                    <i class="fas fa-folder-open text-primary opacity-50" style="font-size: 4rem;"></i>
                </div>
                <h3 class="font-weight-bold text-dark mb-2">No tiene ninguna planificación activa</h3>
                <p class="text-muted mb-4">
                    Cree una nueva planificación académica o active una existente para registrar prácticas en el flujo.
                </p>
                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    <a asp-page="./Planificacion" class="btn btn-primary btn-rounded font-weight-bold px-4 shadow-sm">
                        <i class="fas fa-plus mr-2"></i> Crear planificación
                    </a>
                    <a asp-page="./Planificaciones" class="btn btn-outline-primary btn-rounded font-weight-bold px-4 shadow-sm">
                        <i class="fas fa-list mr-2"></i> Ver planificaciones
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-lg mb-4">
            <div class="card-body py-3">
                <form method="get" class="form-row align-items-end">
                    <input type="hidden" name="PlanningId" value="@Model.Planning.Id" />
                    <div class="col-md-3">
                        <label asp-for="WeekNumber" class="small font-weight-bold text-muted">SEMANA</label>
                        <select asp-for="WeekNumber" asp-items="Model.WeekOptions" class="form-control select2">
                            <option value="">Todas las semanas</option>
                        </select>
                    </div>
                    <div class="col-md-3 mt-3 mt-md-0">
                        <label asp-for="Status" class="small font-weight-bold text-muted">ESTADO</label>
                        <select asp-for="Status" asp-items="Model.StatusOptions" class="form-control select2">
                            <option value="">Todos los estados</option>
                        </select>
                    </div>
                    <div class="col-md-3 mt-3 mt-md-0">
                        <label asp-for="LaboratoryId" class="small font-weight-bold text-muted">LABORATORIO</label>
                        <select asp-for="LaboratoryId" asp-items="Model.LaboratoryOptions" class="form-control select2">
                            <option value="">Todos los laboratorios</option>
                        </select>
                    </div>
                    <div class="col-md-3 mt-3 mt-md-0 d-flex">
                        <button type="submit" class="btn btn-dark font-weight-bold flex-grow-1 mr-1" title="Aplicar filtros">
                            <i class="fas fa-filter mr-1"></i> Filtrar
                        </button>
                        <a asp-page="./Practicas" asp-route-planningId="@Model.Planning.Id" class="btn btn-outline-secondary" title="Limpiar filtros">
                            <i class="fas fa-undo"></i>
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-lg">
            <div class="card-body p-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div>
                        <h5 class="font-weight-bold text-primary mb-1">PRÁCTICAS REGISTRADAS</h5>
                        <small class="text-muted">
                            @if (!string.IsNullOrEmpty(statusText))
                            {
                                <span>Filtrando por estado <strong>@statusText</strong>.</span>
                            }
                            else
                            {
                                <span>Listado completo de la planificación seleccionada.</span>
                            }
                        </small>
                    </div>
                    <span class="badge badge-light border">@Model.Rows.Count práctica(s)</span>
                </div>

                @if (Model.Rows.Count == 0)
                {
                    <div class="text-center border rounded-lg p-5 bg-light">
                        <i class="far fa-calendar-plus fa-3x text-muted mb-3"></i>
                        <h5 class="font-weight-bold">No hay prácticas que coincidan con los filtros</h5>
                        @if (Model.Planning.IsActive)
                        {
                            <p class="text-muted mb-3">Ajuste los filtros o registre una nueva práctica en la planificación activa.</p>
                            <a asp-page="./Practica" asp-route-planningId="@Model.Planning.Id" class="btn btn-primary btn-rounded">
                                <i class="fas fa-plus mr-1"></i> Nueva práctica
                            </a>
                        }
                        else
                        {
                            <p class="text-muted mb-0">La planificación está cerrada: solo se permite consulta.</p>
                        }
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-dark text-white">
                                <tr>
                                    <th class="border-0">CÓDIGO</th>
                                    <th class="border-0">PRÁCTICA</th>
                                    <th class="border-0">DOCENTE · GRUPO</th>
                                    <th class="border-0">LABORATORIO</th>
                                    <th class="border-0">SEMANA · DÍA</th>
                                    <th class="border-0">FECHA · HORA</th>
                                    <th class="border-0 text-center">ESTADO</th>
                                    <th class="border-0 text-right">ACCIONES</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.Rows)
                                {
                                    <tr>
                                        <td class="small font-weight-bold text-primary">@row.Code</td>
                                        <td>
                                            <strong class="text-dark">@row.PracticeName</strong>
                                            <div class="text-muted">@row.SubjectName</div>
                                        </td>
                                        <td class="small">
                                            <div class="font-weight-bold">@row.TeacherName</div>
                                            <div class="text-muted">Grupo @row.GroupName</div>
                                        </td>
                                        <td class="small text-muted">@row.LaboratoryName</td>
                                        <td class="small">
                                            <div class="font-weight-bold">Semana @row.AcademicWeek</div>
                                            <div class="text-muted">@row.WeekdayName</div>
                                        </td>
                                        <td class="small">
                                            <div>@row.ScheduledDate.ToString("dd/MM/yyyy")</div>
                                            <div class="text-muted">@row.ScheduledDate.ToString(@"hh\:mm")–@((row.ScheduledEndDate ?? row.ScheduledDate.AddHours(1)).ToString(@"hh\:mm"))</div>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge badge-@row.StatusCss px-2 py-1 rounded-pill">@row.Status</span>
                                            @if (row.HasIncident)
                                            {
                                                <div class="small text-danger mt-1"><i class="fas fa-exclamation-triangle mr-1"></i>Incidente L-5</div>
                                            }
                                        </td>
                                        <td class="text-right text-nowrap">
                                            <a href="@row.NextUrl" class="btn btn-sm btn-outline-primary btn-rounded" title="Abrir práctica">
                                                <i class="fas fa-folder-open mr-1"></i> Abrir
                                            </a>
                                            @if (Model.Planning.IsActive && row.Status == Models.L3RequestStatus.Planned)
                                            {
                                                <a asp-page="./Practica" asp-route-id="@row.Id" class="btn btn-sm btn-outline-warning btn-rounded ml-1" title="Editar práctica">
                                                    <i class="fas fa-edit mr-1"></i> Editar
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        @if (!Model.Planning.IsActive)
        {
            <div class="alert alert-warning border-0 rounded-lg shadow-sm mt-4 mb-0">
                <i class="fas fa-lock mr-1"></i>
                <strong>Solo consulta.</strong> La planificación está cerrada o inactiva; no se pueden editar registros.
            </div>
        }
    }
</div>

@section Styles {
    <link href="~/assets/libs/select2/dist/css/select2.min.css" rel="stylesheet">
    <style>
        .bg-light-primary { background-color: #e8e7ff; }
    </style>
}

@section Scripts {
    <script src="~/assets/libs/select2/dist/js/select2.full.min.js"></script>
    <script>
        (function () {
            $('.select2').select2({
                width: '100%',
                language: {
                    noResults: function () { return 'Sin coincidencias'; }
                }
            });
        })();
    </script>
}