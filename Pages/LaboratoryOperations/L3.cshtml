@page
@model Proyecto_Laboratorios_Univalle.Pages.LaboratoryOperations.L3Model
@{ ViewData["Title"] = "L-3 y Devolución — Paso 4"; var sessionId = "L3-2026-0095"; }

<div class="page-breadcrumb">
    <div class="row">
        <div class="col-12">
            <h4 class="page-title text-uppercase text-primary font-weight-bold mb-0">PASO 4 · <span class="text-dark">@sessionId</span></h4>
            <h2 class="font-weight-bold text-dark">L-3 y Devolución</h2>
            <div class="text-muted small">SAL 01 — Lab. Cocina Fría · Chef Francisco Galindo · Cocina Boliviana Contemporánea</div>
        </div>
    </div>
</div>

<div class="container-fluid mt-3">
    @await Html.PartialAsync("../LaboratoryOperations/_StepsBar", 4)

    <div class="card shadow-sm rounded-lg border-0">
        <div class="card-body p-4">

            <!-- Tabla de devolución -->
            <h6 class="font-weight-bold text-primary mb-3">DETALLE DE PRÉSTAMO — Confirmación de Devolución</h6>
            <div class="table-responsive">
                <table class="table" id="tabla-devolucion">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th class="border-0">UTENSILIO</th>
                            <th class="border-0 text-center">CATEGORÍA</th>
                            <th class="border-0 text-center">ENTREGADO</th>
                            <th class="border-0 text-center">DEVUELTO</th>
                            <th class="border-0 text-center">DIFERENCIA</th>
                            <th class="border-0 text-center">ESTADO</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var prestamos = new[] {
                                new { Nombre="PLATO PLANO REDONDO",   Categoria="Utensilio",   Entregado=20 },
                                new { Nombre="COPA MARTINI",          Categoria="Utensilio",   Entregado=15 },
                                new { Nombre="SHOT",                  Categoria="Utensilio",   Entregado=8  },
                                new { Nombre="PAPEL FILM 1400 METROS",Categoria="Misceláneos", Entregado=2  },
                            };
                        }
                        @foreach (var p in prestamos)
                        {
                            <tr id="row-@p.Nombre.Replace(" ","_")">
                                <td class="align-middle font-weight-bold">@p.Nombre</td>
                                <td class="align-middle text-center"><span class="badge badge-secondary">@p.Categoria</span></td>
                                <td class="align-middle text-center font-weight-bold">@p.Entregado</td>
                                <td class="text-center align-middle" style="width:130px;">
                                    <input type="number" class="form-control text-center inp-devuelto"
                                           value="@p.Entregado" min="0" max="@p.Entregado"
                                           data-entregado="@p.Entregado"
                                           data-nombre="@p.Nombre"
                                           onchange="calcularDiff(this)" />
                                </td>
                                <td class="text-center align-middle font-weight-bold diff-cell" id="diff-@p.Nombre.Replace(" ","_")">0</td>
                                <td class="text-center align-middle estado-cell" id="estado-@p.Nombre.Replace(" ","_")">
                                    <span class="badge badge-success px-3 py-2 rounded-pill">Completo</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Resumen de diferencias -->
            <div id="panel-diferencias" style="display:none;" class="mt-3">
                <div class="alert alert-warning d-flex align-items-center">
                    <i class="fas fa-exclamation-triangle fa-2x mr-3 text-warning"></i>
                    <div>
                        <strong>Se detectaron diferencias en la devolución.</strong><br>
                        <span id="texto-diferencias"></span>
                        ¿Deseas registrar una incidencia formal?
                        <a asp-page="/LaboratoryOperations/L5" class="btn btn-sm btn-warning ml-3 font-weight-bold">
                            <i class="mdi mdi-alert-outline mr-1"></i> Registrar incidencia L-5
                        </a>
                    </div>
                </div>
            </div>

            <!-- Botones -->
            <div class="d-flex justify-content-between align-items-center mt-4">
                <a asp-page="/LaboratoryOperations/Disponibilidad" class="btn btn-outline-secondary px-4 py-2">
                    <i class="mdi mdi-arrow-left mr-1"></i> Atrás
                </a>
                <button type="button" class="btn btn-dark font-weight-bold px-5 py-2" id="btn-confirmar" onclick="confirmarDevolucion()">
                    <i class="mdi mdi-check mr-1"></i> Confirmar devolución
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
var diferencias = {};

function calcularDiff(input) {
    var entregado = parseInt(input.dataset.entregado);
    var devuelto  = parseInt(input.value) || 0;
    var diff = devuelto - entregado;
    var nombre = input.dataset.nombre;
    var key    = nombre.replace(/ /g, '_');
    var diffCell   = document.getElementById('diff-' + key);
    var estadoCell = document.getElementById('estado-' + key);

    diffCell.textContent = diff;
    diffCell.className   = 'text-center align-middle font-weight-bold diff-cell ' + (diff < 0 ? 'text-danger' : 'text-success');

    if (diff < 0) {
        diferencias[nombre] = diff;
        estadoCell.innerHTML = '<span class="badge badge-danger px-3 py-2 rounded-pill">Diferencia: ' + diff + '</span>';
    } else {
        delete diferencias[nombre];
        estadoCell.innerHTML = '<span class="badge badge-success px-3 py-2 rounded-pill">Completo</span>';
    }

    // Mostrar panel de diferencias
    var panelDiff = document.getElementById('panel-diferencias');
    var keys = Object.keys(diferencias);
    if (keys.length > 0) {
        panelDiff.style.display = '';
        var txt = keys.map(function(k){ return k + ' (falta ' + Math.abs(diferencias[k]) + ')'; }).join(', ');
        document.getElementById('texto-diferencias').textContent = 'Ítems con diferencia: ' + txt + '. ';
    } else {
        panelDiff.style.display = 'none';
    }
}

function confirmarDevolucion() {
    if (Object.keys(diferencias).length > 0) {
        if (!confirm('Hay diferencias en la devolución. ¿Confirmas igualmente y deseas registrar las incidencias por separado?')) return;
    }
    // Simulación de guardado
    document.getElementById('btn-confirmar').disabled = true;
    document.getElementById('btn-confirmar').innerHTML = '<i class="mdi mdi-loading mdi-spin mr-1"></i> Guardando...';
    setTimeout(function() {
        alert('✅ Devolución confirmada. Estado actualizado a "Entregado/Devuelto".\n\nEn la versión final esto se guardará en la base de datos.');
        window.location.href = '/LaboratoryOperations/Index';
    }, 1200);
}
</script>
}
