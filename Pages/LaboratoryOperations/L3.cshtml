@page
@model Proyecto_Laboratorios_Univalle.Pages.LaboratoryOperations.L3Model
@{ ViewData["Title"] = "L-3 devolución"; }

<div class="page-breadcrumb"><div class="row"><div class="col-12"><h4 class="page-title text-uppercase text-primary font-weight-bold mb-0">PASO 4 · @Model.Plan?.Code</h4><h2 class="font-weight-bold text-dark">L-3 y devolución</h2><div class="text-muted small">Registra cuánto material vuelve de la práctica. Un faltante abre el flujo L-5.</div></div></div></div>

<div class="container-fluid mt-3">
    @await Html.PartialAsync("../LaboratoryOperations/_StepsBar", 4)
    <form method="post" asp-page-handler="Confirm" asp-route-id="@Model.Id">
        <div class="card border-0 shadow-sm rounded-lg">
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="alert alert-light border small"><i class="fas fa-info-circle text-primary mr-1"></i> Los valores se validan contra las cantidades solicitadas; no se confía en datos ocultos del navegador.</div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0"><thead class="bg-dark text-white"><tr><th>MATERIAL</th><th class="text-center">SOLICITADO</th><th class="text-center">DEVUELTO</th><th class="text-center">FALTANTE</th></tr></thead><tbody>
                    @for (var index = 0; index < Model.Items.Count; index++)
                    {
                        var item = Model.Items[index];
                        <tr>
                            <td class="font-weight-bold">@item.Name<input type="hidden" asp-for="Items[index].Code" /><input type="hidden" asp-for="Items[index].Name" /><input type="hidden" asp-for="Items[index].Requested" /></td>
                            <td class="text-center">@item.Requested</td>
                            <td class="text-center" style="max-width:150px"><input asp-for="Items[index].Returned" class="form-control text-center" min="0" max="@item.Requested" /></td>
                            <td class="text-center text-muted">—</td>
                        </tr>
                    }
                    </tbody></table>
                </div>
                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <a asp-page="./Disponibilidad" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-rounded px-4"><i class="mdi mdi-arrow-left mr-1"></i> Atrás</a>
                    <button type="submit" class="btn btn-dark btn-rounded font-weight-bold px-4"><i class="mdi mdi-check mr-1"></i> Confirmar devolución</button>
                </div>
            </div>
        </div>
    </form>
</div>
