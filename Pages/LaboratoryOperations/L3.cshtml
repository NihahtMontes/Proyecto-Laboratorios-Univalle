@page
@model Proyecto_Laboratorios_Univalle.Pages.LaboratoryOperations.L3Model
@{ ViewData["Title"] = "L-3 y Devolución — Paso 4"; var planId = Model.L3RequestData?.Id ?? 0; }

<div class="page-breadcrumb">
    <div class="row">
        <div class="col-12">
            <h4 class="page-title text-uppercase text-primary font-weight-bold mb-0">PASO 4 · <span class="text-dark">L3-@planId</span></h4>
            <h2 class="font-weight-bold text-dark">L-3 y Devolución</h2>
            <div class="text-muted small">
                @if (Model.L3RequestData?.Id > 0)
                {
                    <text>@(Model.L3RequestData.Laboratory?.Name) &middot; Docente: @(Model.L3RequestData.Teacher?.FirstName) @(Model.L3RequestData.Teacher?.LastName) &middot; Práctica: @(Model.L3RequestData.PracticeName)</text>
                }
                else
                {
                    <text>No hay registros de L3 para mostrar.</text>
                }
            </div>
        </div>
    </div>
</div>

<div class="container-fluid mt-3">
    @await Html.PartialAsync("../LaboratoryOperations/_StepsBar", 4)

    @if (Model.BloquearFinalizacion)
    {
        <div class="alert alert-warning border-0 rounded d-flex align-items-center mb-4">
            <i class="mdi mdi-lock mdi-36px mr-3"></i>
            <div>
                <strong>Finalización bloqueada.</strong><br>
                Existen faltantes sin incidente L-5 registrado. Debes reportar cada faltante antes de poder cerrar este formulario.
            </div>
        </div>
    }

    <div class="card shadow-sm rounded-lg border-0">
        <div class="card-body p-4">
            <h6 class="font-weight-bold text-primary mb-3">DETALLE DE PRÉSTAMO — Confirmación de Devolución</h6>
            <div class="table-responsive">
                <table class="table" id="tabla-devolucion">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th class="border-0">EQUIPO/UTENSILIO</th>
                            <th class="border-0 text-center">INVENTARIO</th>
                            <th class="border-0 text-center">ENTREGADO</th>
                            <th class="border-0 text-center">DEVUELTO</th>
                            <th class="border-0 text-center">ESTADO</th>
                            <th class="border-0 text-center">ACCIÓN</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in Model.RequestDetails)
                        {
                            var faltante = detail.DeliveredQuantity - detail.ReturnedQuantity;
                            var tieneIncidente = Model.IncidentesL5.Any(i => i.EquipmentUnitId == detail.EquipmentUnitId);

                            <tr class="@(faltante > 0 && !tieneIncidente ? "table-danger" : faltante > 0 && tieneIncidente ? "table-warning" : "")">
                                <td class="align-middle font-weight-bold">@(detail.EquipmentUnit?.Equipment?.Name ?? "Desconocido")</td>
                                <td class="align-middle text-center"><span class="badge badge-secondary">@(detail.EquipmentUnit?.InventoryNumber)</span></td>
                                <td class="align-middle text-center font-weight-bold">@detail.DeliveredQuantity</td>
                                <td class="text-center align-middle" style="width:130px;">
                                    <form method="post" asp-page-handler="UpdateReturn">
                                        <input type="hidden" name="detailId" value="@detail.Id" />
                                        <input type="hidden" name="planId" value="@planId" />
                                        <div class="input-group input-group-sm">
                                            <input type="number" name="returnedQuantity" class="form-control text-center"
                                                   value="@detail.ReturnedQuantity" min="0" max="@detail.DeliveredQuantity" />
                                            <div class="input-group-append">
                                                <button type="submit" class="btn btn-outline-success"><i class="mdi mdi-check"></i></button>
                                            </div>
                                        </div>
                                    </form>
                                </td>
                                <td class="align-middle text-center">
                                    @if (faltante <= 0)
                                    {
                                        <span class="badge badge-success px-3 py-1">Completo ✓</span>
                                    }
                                    else if (tieneIncidente)
                                    {
                                        <span class="badge badge-warning px-3 py-1">L-5 Registrado ✓</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger px-3 py-1">Faltan @faltante</span>
                                    }
                                </td>
                                <td class="text-center align-middle">
                                    @if (faltante > 0 && !tieneIncidente)
                                    {
                                        <a asp-page="/LaboratoryOperations/L5" asp-route-planId="@planId" asp-route-unitid="@detail.EquipmentUnitId"
                                           class="btn btn-sm btn-danger font-weight-bold">
                                            <i class="mdi mdi-alert-outline mr-1"></i> Reportar L-5
                                        </a>
                                    }
                                    else if (tieneIncidente)
                                    {
                                        <span class="text-muted small"><i class="mdi mdi-check-circle text-success"></i> Registrado</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-4">
                <a asp-page="/LaboratoryOperations/Disponibilidad" asp-route-planId="@planId"
                   class="btn btn-outline-secondary px-4 py-2">
                    <i class="mdi mdi-arrow-left mr-1"></i> Atrás
                </a>
                <form method="post" asp-page-handler="Finalize">
                    <input type="hidden" name="planId" value="@planId" />
                    <button type="submit" class="btn btn-dark font-weight-bold px-5 py-2" @(Model.BloquearFinalizacion ? "disabled" : "")>
                        <i class="mdi mdi-check mr-1"></i> Finalizar L-3
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
