</style>

@section Scripts {
<script>
function filtrarDemanda() {
    var cat   = document.getElementById('filtro-categoria').value;
    var orden = document.getElementById('filtro-orden').value;
    var tbody = document.getElementById('tbody-demanda');
    var rows  = Array.from(tbody.querySelectorAll('tr'));

    // Filtrar por categoría
    rows.forEach(function(row) {
        var rowCat = row.dataset.cat;
        row.style.display = (cat === 'todos' || rowCat === cat) ? '' : 'none';
    });

    // Ordenar por salidas
    var visibles = rows.filter(function(r){ return r.style.display !== 'none'; });
    visibles.sort(function(a, b) {
        var sa = parseInt(a.dataset.salidas) || 0;
        var sb = parseInt(b.dataset.salidas) || 0;
        return orden === 'mas' ? sb - sa : sa - sb;
    });
    visibles.forEach(function(r, i) {
        tbody.appendChild(r);
        r.querySelector('td:first-child').textContent = i + 1;
    });
}
</script>
}
