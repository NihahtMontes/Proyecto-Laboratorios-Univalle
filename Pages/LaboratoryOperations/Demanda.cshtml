@page
@model Proyecto_Laboratorios_Univalle.Pages.LaboratoryOperations.DemandaModel
@using Proyecto_Laboratorios_Univalle.Services
@{ ViewData["Title"] = "Demanda"; }

<div class="page-breadcrumb">
    <div class="row align-items-end">
        <div class="col-md-8">
            <h4 class="page-title text-uppercase text-primary font-weight-bold mb-1">PRÁCTICAS FUTURAS</h4>
            <h2 class="font-weight-bold text-dark mb-1">Demanda de utensilios y materiales</h2>
            <div class="text-muted small">Consolidado de los requerimientos registrados en planificaciones L-3 vigentes con fecha igual o posterior a hoy.</div>
        </div>
        <div class="col-md-4 text-md-right mt-3 mt-md-0">
            @if (Model.HasManagement)
            {
                <span class="badge badge-light border text-muted font-weight-bold px-3 py-2">
                    <i class="fas fa-calendar-alt mr-1 text-primary"></i> Gestión @Model.Management!.Code
                </span>
            }
        </div>
    </div>
</div>

<div class="container-fluid mt-3">

    @if (!Model.HasManagement)
    {
        <div class="card border-0 shadow-sm rounded-lg">
            <div class="card-body text-center p-5">
                <div class="mb-3">
                    <i class="fas fa-calendar-times text-primary opacity-50" style="font-size: 4rem;"></i>
                </div>
                <h3 class="font-weight-bold text-dark mb-2">No hay una gestión académica disponible</h3>
                <p class="text-muted mb-4">
                    La demanda se calcula sobre las planificaciones de una gestión académica. Cree o active una gestión para ver los requerimientos consolidados.
                </p>
                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    <a asp-page="/Managements/Index" asp-route-type="Preventive" class="btn btn-primary btn-rounded font-weight-bold px-4 shadow-sm">
                        <i class="fas fa-calendar-plus mr-2"></i> Ver gestiones
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-light border rounded-lg d-flex align-items-center mb-4 shadow-sm">
            <div class="rounded-circle bg-light-primary text-primary p-2 mr-3"><i class="fas fa-university"></i></div>
            <div class="flex-grow-1">
                <strong class="text-dark">Gestión @Model.Management!.Code</strong>
                <small class="text-muted ml-1">— @Model.Management.StatusText@if (Model.Management.StartDate.HasValue && Model.Management.EndDate.HasValue) {<text> · @Model.Management.StartDate.Value.ToString("dd/MM/yyyy") – @Model.Management.EndDate.Value.ToString("dd/MM/yyyy")</text>}</small>
            </div>
            <span class="badge @(Model.Management.IsCurrent ? "badge-success" : "badge-light border text-muted") font-weight-bold">
                @(Model.Management.IsCurrent ? "Gestión actual" : "Histórica")
            </span>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body py-3">
            <form method="get" class="form-row align-items-end">
                <div class="col-md-3">
                    <label asp-for="ManagementId" class="small font-weight-bold">GESTIÓN</label>
                    <select asp-for="ManagementId" asp-items="Model.ManagementList" class="custom-select"></select>
                </div>
                <div class="col-md-3 mt-3 mt-md-0">
                    <label asp-for="LaboratoryId" class="small font-weight-bold">LABORATORIO</label>
                    <select asp-for="LaboratoryId" asp-items="Model.LaboratoryList" class="custom-select">
                        <option value="">Todos los laboratorios</option>
                    </select>
                </div>
                <div class="col-md-2 mt-3 mt-md-0">
                    <label asp-for="Category" class="small font-weight-bold">CATEGORÍA</label>
                    <select asp-for="Category" class="custom-select">
                        <option value="todos">Todas las categorías</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category">@category</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 mt-3 mt-md-0">
                    <label asp-for="Order" class="small font-weight-bold">ORDENAR POR</label>
                    <select asp-for="Order" class="custom-select">
                        <option value="mas">Mayor cantidad solicitada</option>
                        <option value="menos">Menor cantidad solicitada</option>
                    </select>
                </div>
                <div class="col-md-1 mt-3 mt-md-0">
                    <button type="submit" class="btn btn-dark btn-block font-weight-bold" title="Aplicar filtros">
                        <i class="fas fa-filter"></i>
                    </button>
                </div>
                <div class="col-md-1 mt-3 mt-md-0">
                    <a asp-page="./Demanda" class="btn btn-outline-secondary btn-block" title="Limpiar filtros">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4 mb-3 mb-md-0">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-light-primary text-primary d-flex align-items-center justify-content-center mr-3 metric-icon">
                        <i class="fas fa-boxes"></i>
                    </div>
                    <div>
                        <div class="small text-muted text-uppercase font-weight-bold">Cantidad solicitada</div>
                        <div class="h3 mb-0 font-weight-bold">@Model.TotalRequested.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3 mb-md-0">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-light-danger text-danger d-flex align-items-center justify-content-center mr-3 metric-icon">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <div>
                        <div class="small text-muted text-uppercase font-weight-bold">Ítems con déficit</div>
                        <div class="h3 mb-0 font-weight-bold text-danger">@Model.DeficitCount</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-light-success text-success d-flex align-items-center justify-content-center mr-3 metric-icon">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div>
                        <div class="small text-muted text-uppercase font-weight-bold">Ítems con cobertura</div>
                        <div class="h3 mb-0 font-weight-bold text-success">@Model.SurplusCount</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm rounded-lg border-0">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h6 class="font-weight-bold text-primary mb-1">CONSOLIDADO DE DEMANDA POR ARTÍCULO</h6>
                    <span class="text-muted small">
                        @if (!string.IsNullOrEmpty(Model.OriginLaboratoryCode))
                        {
                            <span>Stock comparado con el Economato (<strong>@Model.OriginLaboratoryCode</strong>).</span>
                        }
                        else
                        {
                            <span>No se encontró un laboratorio con código "ECONO" para comparar el stock; las columnas Disponible mostrarán "Sin registro".</span>
                        }
                    </span>
                </div>
                <span class="badge badge-light text-muted">@Model.Rows.Count artículos</span>
            </div>

            @if (Model.Rows.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="fas fa-chart-line text-muted mb-3" style="font-size:36px;"></i>
                    <h5 class="font-weight-bold">Todavía no hay requerimientos consolidados</h5>
                    <p class="text-muted mb-3">Crea una planificación y agrega artículos para ver su demanda aquí.</p>
                    <a asp-page="./Planificaciones" class="btn btn-primary">Ver planificaciones</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-dark text-white">
                            <tr>
                                <th class="border-0">#</th>
                                <th class="border-0">ARTÍCULO</th>
                                <th class="border-0 text-center">CATEGORÍA</th>
                                <th class="border-0 text-center">SOLICITADO</th>
                                <th class="border-0 text-center">DISPONIBLE</th>
                                <th class="border-0 text-center">SALDO</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var index = 0; index < Model.Rows.Count; index++)
                            {
                                var row = Model.Rows[index];
                                var balanceClass = row.Balance < 0 ? "text-danger" : "text-success";
                                var balanceSign = row.Balance > 0 ? "+" : string.Empty;
                                <tr>
                                    <td class="text-muted small">@(index + 1)</td>
                                    <td>
                                        <div class="font-weight-bold">
                                            @row.Name
                                            @if (row.ReviewPending)
                                            {
                                                <span class="badge badge-warning text-dark ml-1" title="Artículo con revisión pendiente">
                                                    <i class="fas fa-exclamation-circle mr-1"></i>Por confirmar
                                                </span>
                                            }
                                        </div>
                                        <div class="text-muted small">@row.Code · @row.PlanCount planificación(es)</div>
                                    </td>
                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(row.Category))
                                        {
                                            <span class="badge badge-info">@row.Category</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                    <td class="text-center font-weight-bold">@row.Requested.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)</td>
                                    <td class="text-center">
                                        @if (row.Available.HasValue)
                                        {
                                            <span>@row.Available.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-light text-muted">Sin registro</span>
                                        }
                                    </td>
                                    <td class="text-center @balanceClass font-weight-bold">@balanceSign@row.Balance.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="alert alert-info border-0 shadow-sm mt-4 mb-0">
        <i class="fas fa-info-circle mr-2"></i>
        Esta pantalla agrega los requerimientos de las planificaciones L-3 de la gestión seleccionada a partir del flujo persistido (planificación, requerimientos, disponibilidad y devolución). El stock proviene de los registros de existencias del Economato.
    </div>
    }
</div>

<style>
    .metric-icon { width: 42px; height: 42px; }
    .bg-light-primary { background-color: #e8e7ff; }
    .bg-light-danger { background-color: #fce8e6; }
    .bg-light-success { background-color: #e4f7ed; }
</style>
