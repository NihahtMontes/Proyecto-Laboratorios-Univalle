@page
@model Proyecto_Laboratorios_Univalle.Pages.LaboratoryOperations.DemandaModel
@{ ViewData["Title"] = "Demanda"; }

<div class="page-breadcrumb">
    <div class="row align-items-end">
        <div class="col-md-8">
            <h4 class="page-title text-uppercase text-primary font-weight-bold mb-1">PLANIFICACIÓN FUTURA</h4>
            <h2 class="font-weight-bold text-dark mb-1">Demanda de utensilios y materiales</h2>
            <div class="text-muted small">Consolidado de los requerimientos registrados en esta sesión de demostración.</div>
        </div>
        <div class="col-md-4 text-md-right mt-3 mt-md-0">
            <a asp-page="./Planificacion" class="btn btn-primary font-weight-bold">
                <i class="fas fa-plus mr-1"></i> Nueva planificación
            </a>
        </div>
    </div>
</div>

<div class="container-fluid mt-3">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body py-3">
            <form method="get" class="form-row align-items-end">
                <div class="col-md-4">
                    <label asp-for="Category" class="small font-weight-bold">CATEGORÍA</label>
                    <select asp-for="Category" class="custom-select">
                        <option value="todos">Todas las categorías</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category">@category</option>
                        }
                    </select>
                </div>
                <div class="col-md-4 mt-3 mt-md-0">
                    <label asp-for="Order" class="small font-weight-bold">ORDENAR POR</label>
                    <select asp-for="Order" class="custom-select">
                        <option value="mas">Mayor cantidad solicitada</option>
                        <option value="menos">Menor cantidad solicitada</option>
                    </select>
                </div>
                <div class="col-md-2 mt-3 mt-md-0">
                    <button type="submit" class="btn btn-dark btn-block font-weight-bold">
                        <i class="fas fa-filter mr-1"></i> Aplicar
                    </button>
                </div>
                <div class="col-md-2 mt-3 mt-md-0">
                    <a asp-page="./Demanda" class="btn btn-outline-secondary btn-block">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4 mb-3 mb-md-0">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-light-primary text-primary d-flex align-items-center justify-content-center mr-3 metric-icon">
                        <i class="fas fa-boxes"></i>
                    </div>
                    <div>
                        <div class="small text-muted text-uppercase font-weight-bold">Cantidad solicitada</div>
                        <div class="h3 mb-0 font-weight-bold">@Model.TotalRequested</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3 mb-md-0">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-light-danger text-danger d-flex align-items-center justify-content-center mr-3 metric-icon">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <div>
                        <div class="small text-muted text-uppercase font-weight-bold">Ítems con déficit</div>
                        <div class="h3 mb-0 font-weight-bold text-danger">@Model.DeficitCount</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-light-success text-success d-flex align-items-center justify-content-center mr-3 metric-icon">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div>
                        <div class="small text-muted text-uppercase font-weight-bold">Ítems con cobertura</div>
                        <div class="h3 mb-0 font-weight-bold text-success">@Model.SurplusCount</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm rounded-lg border-0">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h6 class="font-weight-bold text-primary mb-1">CONSOLIDADO DE DEMANDA</h6>
                    <span class="text-muted small">El stock corresponde al catálogo demo local configurado para la presentación.</span>
                </div>
                <span class="badge badge-light text-muted">@Model.Rows.Count ítems</span>
            </div>

            @if (Model.Rows.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="fas fa-chart-line text-muted mb-3" style="font-size:36px;"></i>
                    <h5 class="font-weight-bold">Todavía no hay requerimientos consolidados</h5>
                    <p class="text-muted mb-3">Crea una planificación y agrega materiales para ver su demanda aquí.</p>
                    <a asp-page="./Planificacion" class="btn btn-primary">Crear planificación</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-dark text-white">
                            <tr>
                                <th class="border-0">#</th>
                                <th class="border-0">MATERIAL / UTENSILIO</th>
                                <th class="border-0 text-center">UNIDAD</th>
                                <th class="border-0 text-center">CATEGORÍA</th>
                                <th class="border-0 text-center">SOLICITADO</th>
                                <th class="border-0 text-center">STOCK DEMO</th>
                                <th class="border-0 text-center">BALANCE</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var index = 0; index < Model.Rows.Count; index++)
                            {
                                var row = Model.Rows[index];
                                var balanceClass = row.Balance < 0 ? "text-danger" : "text-success";
                                var categoryClass = row.Category == "Botiquín" ? "warning" : row.Category == "Limpieza" ? "primary" : row.Category == "Misceláneos" ? "secondary" : "info";
                                <tr>
                                    <td class="text-muted small">@(index + 1)</td>
                                    <td>
                                        <div class="font-weight-bold">@row.Name</div>
                                        <div class="text-muted small">@row.PlanCount planificación(es) · @row.Code</div>
                                    </td>
                                    <td class="text-center">@row.Unit</td>
                                    <td class="text-center"><span class="badge badge-@categoryClass">@row.Category</span></td>
                                    <td class="text-center font-weight-bold">@row.Requested</td>
                                    <td class="text-center">@row.Available</td>
                                    <td class="text-center @balanceClass font-weight-bold">@(row.Balance > 0 ? "+" : "")@row.Balance</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="alert alert-info border-0 shadow-sm mt-4 mb-0">
        <i class="fas fa-info-circle mr-2"></i>
        Esta pantalla es parte del MVP de presentación: resume las planificaciones guardadas en la sesión del navegador y no registra todavía compras ni movimientos L-3 en la base de datos.
    </div>
</div>

<style>
    .metric-icon { width: 42px; height: 42px; }
    .bg-light-primary { background-color: #e8e7ff; }
    .bg-light-danger { background-color: #fce8e6; }
    .bg-light-success { background-color: #e4f7ed; }
</style>
