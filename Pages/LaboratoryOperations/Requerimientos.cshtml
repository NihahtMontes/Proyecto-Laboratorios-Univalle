@page
@model Proyecto_Laboratorios_Univalle.Pages.LaboratoryOperations.RequerimientosModel
@{ ViewData["Title"] = "Requerimientos de la práctica"; }

<div class="page-breadcrumb">
    <div class="row align-items-center">
        <div class="col-12">
            <h4 class="page-title text-uppercase text-primary font-weight-bold mb-0">PASO 2 · @Model.Plan?.Code</h4>
            <h2 class="font-weight-bold text-dark">Requerimientos de la práctica</h2>
            <div class="text-muted small">@Model.LaboratoryName · @Model.Plan?.Subject · Grupo @Model.Plan?.Group</div>
        </div>
    </div>
</div>

<div class="container-fluid mt-3">
    @await Html.PartialAsync("../LaboratoryOperations/_StepsBar", 2)

    <div class="row">
        <div class="col-lg-4 mb-4 mb-lg-0">
            <div class="card border-0 shadow-sm rounded-lg">
                <div class="card-body p-4">
                    <h5 class="font-weight-bold text-primary mb-1">Agregar material</h5>
                    <p class="text-muted small">Catálogo demo local para recorrer la disponibilidad.</p>
                    <form method="post" asp-page-handler="Add" asp-route-id="@Model.Id">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <div class="form-group">
                            <label asp-for="Input.Code" class="small font-weight-bold text-muted">Material / utensilio</label>
                            <select asp-for="Input.Code" class="custom-select">
                                <option value="">— Seleccionar —</option>
                                @foreach (var item in Model.Catalog)
                                {
                                    <option value="@item.Code">@item.Name · stock @item.AvailableStock @item.Unit</option>
                                }
                            </select>
                            <span asp-validation-for="Input.Code" class="text-danger small"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Input.Quantity" class="small font-weight-bold text-muted">Cantidad solicitada</label>
                            <input asp-for="Input.Quantity" class="form-control" min="1" />
                            <span asp-validation-for="Input.Quantity" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn btn-primary btn-rounded btn-block font-weight-bold"><i class="mdi mdi-plus mr-1"></i> Agregar a la lista</button>
                    </form>
                    <div class="alert alert-light border small mt-4 mb-0"><i class="fas fa-info-circle text-primary mr-1"></i> Puedes cargar una cantidad superior al stock para mostrar cómo se detecta un conflicto.</div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-lg">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div><h5 class="font-weight-bold text-primary mb-1">LISTA DE REQUERIMIENTOS</h5><small class="text-muted">@Model.Plan?.PracticeDate.ToString("dd/MM/yyyy") · @Model.Plan?.StartTime.ToString(@"hh\:mm")–@Model.Plan?.EndTime.ToString(@"hh\:mm")</small></div>
                        <span class="badge badge-light border">@Model.Plan?.Requirements.Count ítem(s)</span>
                    </div>

                    @if (Model.Plan?.Requirements.Count == 0)
                    {
                        <div class="text-center border rounded-lg p-5 bg-light"><i class="fas fa-clipboard-list fa-3x text-muted mb-3"></i><p class="text-muted mb-0">Aún no hay materiales agregados.</p></div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="bg-dark text-white"><tr><th>MATERIAL</th><th>CATEGORÍA</th><th class="text-center">CANTIDAD</th><th class="text-center">STOCK DEMO</th><th></th></tr></thead>
                                <tbody>
                                @foreach (var item in Model.Plan!.Requirements)
                                {
                                    var conflict = item.RequestedQuantity > item.AvailableQuantity;
                                    <tr class="@(conflict ? "table-danger" : "")">
                                        <td class="font-weight-bold">@item.Name<br /><small class="text-muted">@item.Unit</small></td>
                                        <td><span class="badge badge-light border">@item.Category</span></td>
                                        <td class="text-center font-weight-bold">@item.RequestedQuantity</td>
                                        <td class="text-center">@item.AvailableQuantity<br /><small class="@(conflict ? "text-danger" : "text-success")">@(conflict ? "Insuficiente" : "Disponible")</small></td>
                                        <td class="text-right"><form method="post" asp-page-handler="Remove" asp-route-id="@Model.Id" asp-route-code="@item.Code"><button type="submit" class="btn btn-sm btn-outline-danger" title="Retirar"><i class="mdi mdi-delete"></i></button></form></td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <a asp-page="./Planificacion" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-rounded px-4"><i class="mdi mdi-arrow-left mr-1"></i> Atrás</a>
                        <form method="post" asp-page-handler="Continue" asp-route-id="@Model.Id" class="d-inline"><button type="submit" class="btn btn-dark btn-rounded font-weight-bold px-4">Validar disponibilidad <i class="mdi mdi-arrow-right ml-1"></i></button></form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
