@page
@model Proyecto_Laboratorios_Univalle.Pages.LaboratoryOperations.RequerimientosModel
@{ ViewData["Title"] = "Requerimientos — Paso 2"; }

<div class="page-breadcrumb">
    <div class="row">
        <div class="col-12">
            <h4 class="page-title text-uppercase text-primary font-weight-bold mb-0">PASO 2 · <span class="text-dark">L3-@Model.PlanId</span></h4>
            <h2 class="font-weight-bold text-dark">Requerimientos de Utensilios</h2>
            <div class="text-muted small">Agrega los utensilios que se necesitan para la práctica.</div>
        </div>
    </div>
</div>

<div class="container-fluid mt-3">
    @await Html.PartialAsync("../LaboratoryOperations/_StepsBar", 2)

    @* ── ALERTA DE CONFLICTO (devuelto desde Paso 3) ── *@
    @if (Model.HasConflict)
    {
        <div class="alert alert-danger border-0 rounded d-flex align-items-center mb-4">
            <i class="mdi mdi-alert-circle mdi-36px mr-3"></i>
            <div>
                <strong>¡Conflicto de disponibilidad detectado!</strong><br>
                Uno o más utensilios no tienen stock suficiente. Ajusta las cantidades o elimina los ítems problemáticos antes de volver a validar.
            </div>
        </div>
    }

    @if (Model.PlanActivo != null)
    {
        <div class="row">
            @* ── PANEL IZQUIERDO: SELECTOR ── *@
            <div class="col-md-5">
                <div class="card shadow-sm border-0 rounded-lg mb-3">
                    <div class="card-body p-4">
                        <h6 class="font-weight-bold text-primary mb-3">SELECCIÓN DE UTENSILIOS</h6>

                        @* Laboratorio readonly *@
                        <div class="form-group">
                            <label class="small font-weight-bold text-muted">LABORATORIO (HEREDADO DEL PASO 1)</label>
                            <input type="text" readonly class="form-control bg-light font-weight-bold"
                                   value="@Model.PlanActivo.Laboratory?.Name" />
                        </div>

                        <form method="post" asp-page-handler="AddDetail">
                            <input type="hidden" asp-for="PlanId" />
                            <div class="form-group">
                                <label class="small font-weight-bold text-muted">BUSCAR UTENSILIO <span class="text-danger">*</span></label>
                                <select asp-for="EquipmentUnitId" asp-items="Model.EquipmentUnitsList" class="custom-select" required>
                                    <option value="">— Seleccionar utensilio —</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="small font-weight-bold text-muted">CANTIDAD SOLICITADA <span class="text-danger">*</span></label>
                                <input type="number" asp-for="ExpectedQuantity" class="form-control" min="1" value="1" required />
                            </div>
                            <button type="submit" class="btn btn-primary btn-block font-weight-bold">
                                <i class="mdi mdi-plus mr-1"></i> Agregar a la lista
                            </button>
                        </form>
                    </div>
                </div>

                @* Info práctica *@
                <div class="card border-0 bg-light shadow-sm rounded-lg">
                    <div class="card-body py-3 px-4">
                        <small class="text-muted font-weight-bold d-block mb-1">SESIÓN ACTIVA</small>
                        <span class="font-weight-bold">L3-@Model.PlanId</span><br>
                        <small class="text-muted">
                            @Model.PlanActivo.Laboratory?.Name ·
                            @Model.PlanActivo.Subject?.Name ·
                            @(Model.PlanActivo.Teacher?.FirstName + " " + Model.PlanActivo.Teacher?.LastName)
                        </small>
                    </div>
                </div>
            </div>

            @* ── PANEL DERECHO: LISTA DE REQUERIMIENTOS ── *@
            <div class="col-md-7">
                <div class="card shadow-sm border-0 rounded-lg">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="font-weight-bold text-primary mb-0">LISTA DE REQUERIMIENTOS</h6>
                            <span class="badge badge-pill badge-primary px-3">@Model.PlanActivo.Details.Count ítems</span>
                        </div>

                        <div class="table-responsive">
                            <table class="table">
                                <thead class="bg-dark text-white">
                                    <tr>
                                        <th class="border-0 small">UTENSILIO</th>
                                        <th class="border-0 small text-center">INVENTARIO</th>
                                        <th class="border-0 small text-center">CANT. SOLICITADA</th>
                                        <th class="border-0 small text-center"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!Model.PlanActivo.Details.Any())
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center text-muted py-4">
                                                <i class="mdi mdi-format-list-checks mdi-36px d-block mb-2"></i>
                                                Agrega utensilios desde el panel izquierdo.
                                            </td>
                                        </tr>
                                    }
                                    @foreach (var detail in Model.PlanActivo.Details)
                                    {
                                        <tr>
                                            <td class="align-middle font-weight-bold small">@(detail.EquipmentUnit?.Equipment?.Name ?? "—")</td>
                                            <td class="align-middle text-center"><span class="badge badge-secondary">@(detail.EquipmentUnit?.InventoryNumber ?? "—")</span></td>
                                            <td class="align-middle text-center" style="width: 140px;">
                                                <form method="post" asp-page-handler="UpdateQuantity" class="m-0">
                                                    <input type="hidden" name="detailId" value="@detail.Id" />
                                                    <input type="hidden" asp-for="PlanId" />
                                                    <div class="input-group input-group-sm">
                                                        <input type="number" name="newQuantity" class="form-control text-center" value="@detail.ExpectedQuantity" min="1" />
                                                        <div class="input-group-append">
                                                            <button type="submit" class="btn btn-outline-success">
                                                                <i class="mdi mdi-check"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </form>
                                            </td>
                                            <td class="align-middle text-center">
                                                <form method="post" asp-page-handler="RemoveDetail" class="d-inline">
                                                    <input type="hidden" name="detailId" value="@detail.Id" />
                                                    <input type="hidden" asp-for="PlanId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="mdi mdi-delete"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                @* Botones *@
                <div class="d-flex justify-content-between mt-3">
                    <a asp-page="/LaboratoryOperations/Planificacion" class="btn btn-outline-secondary px-4 py-2">
                        <i class="mdi mdi-arrow-left mr-1"></i> Atrás
                    </a>
                    @if (Model.PlanActivo.Details.Any())
                    {
                        <a asp-page="/LaboratoryOperations/Disponibilidad" asp-route-planId="@Model.PlanId"
                           class="btn btn-dark font-weight-bold px-5 py-2">
                            Validar disponibilidad <i class="mdi mdi-arrow-right ml-1"></i>
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-dark font-weight-bold px-5 py-2" disabled>
                            Validar disponibilidad <i class="mdi mdi-arrow-right ml-1"></i>
                        </button>
                    }
                </div>
            </div>
        </div>
    }
</div>
