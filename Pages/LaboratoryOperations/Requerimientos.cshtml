@page
@model Proyecto_Laboratorios_Univalle.Pages.LaboratoryOperations.RequerimientosModel
@using Proyecto_Laboratorios_Univalle.Pages.Shared
@using Proyecto_Laboratorios_Univalle.Services
@{
    ViewData["Title"] = "Requerimientos — Paso 2";
    var canWrite = Model.IsEditable && !(Model.Context?.IsReadOnly ?? false);
    var showRecipeCard = canWrite && Model.Recipe.Count > 0;
    var kitSubjectId = Model.Plan?.SubjectId;
    var hasKitItems = Model.Kit.Count > 0;
    var canShowKitCard = canWrite || hasKitItems;
}

<div class="container-fluid mt-3">
    @if (Model.Context != null)
    {
        <partial name="_PlanningContext" model="Model.Context" />


        @if (Model.Context.IsReadOnly)
        {
            <div class="alert alert-warning border-0 rounded d-flex align-items-center mb-4">
                <i class="fas fa-eye fa-2x mr-3"></i>
                <div>
                    <strong>Solo consulta.</strong><br />
                    <span>La planificación no admite agregar, modificar ni retirar requerimientos.</span>
                </div>
            </div>
        }

        @if (Model.Conflict)
        {
            <div class="alert alert-danger border-0 rounded d-flex align-items-center mb-4">
                <i class="fas fa-exclamation-triangle fa-2x mr-3"></i>
                <div>
                    <strong>Stock insuficiente en el laboratorio.</strong><br />
                    <span>Vuelve a ajustar las cantidades antes de revalidar disponibilidad.</span>
                </div>
            </div>
        }

        <div class="row">
            @if (canWrite)
            {
                <div class="col-lg-4 mb-4 mb-lg-0">
                    @if (showRecipeCard)
                    {
                        <div class="card border-0 shadow-sm rounded-lg mb-4">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="rounded-circle bg-light-info text-info p-2 mr-2"><i class="fas fa-book-open"></i></div>
                                    <div>
                                        <h6 class="font-weight-bold text-info mb-0">Receta de la práctica</h6>
                                        <small class="text-muted">@Model.Recipe.Count artículo(s) declarado(s) en la receta del catálogo.</small>
                                    </div>
                                </div>

                                <div class="d-flex flex-wrap gap-2 small text-muted mb-3">
                                    <span class="badge badge-light border"><i class="fas fa-users mr-1"></i> Estudiantes: <strong class="text-info">@(Model.StudentCount?.ToString() ?? "—")</strong></span>
                                    <span class="badge badge-light border"><i class="fas fa-divide mr-1"></i> Factor: <strong class="text-info">@(Model.ScalingFactor?.ToString() ?? "—")</strong></span>
                                </div>

                                <div class="table-responsive" style="max-height: 260px; overflow-y:auto;">
                                    <table class="table table-sm table-borderless mb-0">
                                        <thead class="bg-light text-dark">
                                            <tr>
                                                <th>Artículo</th>
                                                <th class="text-center">Base</th>
                                                <th class="text-center">Calculada</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var r in Model.Recipe)
                                            {
                                                <tr>
                                                    <td>
                                                        <div class="font-weight-bold small">@r.ArticleName</div>
                                                        <small class="text-muted">@r.ArticleCode</small>
                                                        @if (r.ArticlePending)
                                                        {
                                                            <span class="badge badge-warning badge-pill ml-1" title="Artículo por confirmar">Por confirmar</span>
                                                        }
                                                        @if (!string.IsNullOrEmpty(r.Note))
                                                        {
                                                            <small class="d-block text-muted">@r.Note</small>
                                                        }
                                                    </td>
                                                    <td class="text-center small">@(r.BaseQuantity?.ToString("0.##") ?? "—")</td>
                                                    <td class="text-center font-weight-bold">
                                                        @(r.ComputedQuantity?.ToString("0.##") ?? "—")
                                                        <small class="d-block text-muted">@(r.IsScalable ? "Escalable" : "Fija")</small>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <form method="post" asp-page-handler="LoadRecipe" asp-route-planId="@Model.PlanId" class="mt-3">
                                    <button type="submit" class="btn btn-info btn-rounded btn-block font-weight-bold js-load-recipe">
                                        <i class="fas fa-magic mr-1"></i> Cargar receta
                                    </button>
                                </form>
                                <small class="text-muted d-block mt-1 small">Solo se agregan los artículos que aún no están en la lista.</small>
                            </div>
                        </div>
                    }

                    <div class="card border-0 shadow-sm rounded-lg mb-4">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-2">
                                <div class="rounded-circle bg-light-primary text-primary p-2 mr-2"><i class="fas fa-search-plus"></i></div>
                                <div>
                                    <h6 class="font-weight-bold text-primary mb-0">Agregar requerimientos</h6>
                                    <small class="text-muted">Busca artículos por categoría o nombre, y equipos por nombre, n.º de inventario o n.º de serie.</small>
                                </div>
                            </div>
                            <button type="button" class="btn btn-primary btn-rounded btn-block font-weight-bold" data-toggle="modal" data-target="#requirement-picker">
                                <i class="fas fa-search mr-1"></i> Buscar artículos y equipos
                            </button>
                            <div class="alert alert-light border small mt-3 mb-0">
                                <i class="fas fa-info-circle text-primary mr-1"></i>
                                Los artículos repetidos acumulan cantidad; una misma unidad física no se agrega dos veces.
                            </div>
                        </div>
                    </div>

                    @if (canShowKitCard)
                    {
                        <div class="card border-0 shadow-sm rounded-lg">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="rounded-circle bg-light-warning text-warning p-2 mr-2"><i class="fas fa-boxes"></i></div>
                                    <div>
                                        <h6 class="font-weight-bold text-warning mb-0">Kit de la materia</h6>
                                        @if (!string.IsNullOrWhiteSpace(Model.SubjectName))
                                        {
                                            <small class="text-muted">@Model.SubjectName</small>
                                        }
                                        else
                                        {
                                            <small class="text-muted">Sin materia asignada.</small>
                                        }
                                    </div>
                                </div>

                                @if (!hasKitItems)
                                {
                                    <div class="text-center rounded-lg p-3 bg-light mb-2">
                                        <i class="fas fa-box-open fa-2x text-muted mb-2"></i>
                                        <p class="text-muted small mb-2">Esta materia aún no tiene kit.</p>
                                        @if (Model.CanEditKit && kitSubjectId.HasValue)
                                        {
                                            <a class="btn btn-sm btn-outline-warning btn-rounded font-weight-bold" href="/Catalogs/Subjects/Kit/@kitSubjectId.Value">
                                                <i class="fas fa-plus mr-1"></i> Definir kit de la materia
                                            </a>
                                            <small class="d-block text-muted mt-2">o arma la lista aquí y usa <strong>Guardar como kit</strong>.</small>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="table-responsive" style="max-height: 240px; overflow-y:auto;">
                                        <table class="table table-sm table-borderless mb-0">
                                            <thead class="bg-light text-dark">
                                                <tr>
                                                    <th>Artículo</th>
                                                    <th class="text-center">Base</th>
                                                    <th class="text-center">Calculada</th>
                                                    <th class="text-center" style="width:48px;"></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var k in Model.Kit)
                                                {
                                                    <tr>
                                                        <td>
                                                            <div class="font-weight-bold small">@k.ArticleName</div>
                                                            <small class="text-muted">@k.ArticleCode@(string.IsNullOrWhiteSpace(k.Category) ? "" : $" · {k.Category}")</small>
                                                            @if (k.IsEquipment)
                                                            {
                                                                <span class="badge badge-info badge-pill ml-1">Equipo</span>
                                                            }
                                                            @if (k.IsScalable)
                                                            {
                                                                <span class="badge badge-light border text-muted ml-1">Escalable</span>
                                                            }
                                                        </td>
                                                        <td class="text-center small">@(k.BaseQuantity.ToString("0.##"))</td>
                                                        <td class="text-center font-weight-bold">@(k.ComputedQuantity?.ToString("0.##") ?? "—")</td>
                                                        <td class="text-center">
                                                            @if (k.AlreadyInRequest)
                                                            {
                                                                <i class="fas fa-check-circle text-success" title="Ya está en la solicitud"></i>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted">—</span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>

                                    <form method="post" asp-page-handler="LoadKit" asp-route-planId="@Model.PlanId" class="mt-3">
                                        <button type="submit" class="btn btn-warning btn-rounded btn-block font-weight-bold js-load-kit">
                                            <i class="fas fa-boxes mr-1"></i> Cargar kit de la materia (@Model.Kit.Count)
                                        </button>
                                    </form>
                                    @if (Model.CanEditKit && kitSubjectId.HasValue)
                                    {
                                        <a class="btn btn-link btn-sm btn-block text-warning font-weight-bold" href="/Catalogs/Subjects/Kit/@kitSubjectId.Value">
                                            <i class="fas fa-edit mr-1"></i> Editar kit
                                        </a>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="@(canWrite ? "col-lg-8" : "col-lg-12")">
                <div class="card border-0 shadow-sm rounded-lg">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h5 class="font-weight-bold text-primary mb-1">LISTA DE REQUERIMIENTOS</h5>
                                @if (Model.Plan != null)
                                {
                                    <small class="text-muted">@Model.Plan.ScheduledDate.ToString("dd/MM/yyyy")</small>
                                }
                            </div>
                            <span class="badge badge-light border">@Model.Items.Count ítem(s)</span>
                        </div>

                        @if (Model.Items.Count == 0)
                        {
                            <div class="text-center rounded-lg p-5 bg-light">
                                <i class="fas fa-clipboard-list fa-3x text-muted mb-3"></i>
                                <p class="text-muted mb-0">Aún no hay artículos en esta planificación.</p>
                                @if (canWrite && Model.Recipe.Count > 0)
                                {
                                    <small class="d-block text-info mt-2">
                                        <i class="fas fa-book-open mr-1"></i> Usa <strong>Cargar receta</strong> para traer los artículos declarados en el catálogo.
                                    </small>
                                }
                            </div>
                        }
                        else
                        {
                            var shortArticleIds = Model.Items.Where(i => Model.IsShort(i)).Select(i => i.ArticleId).ToHashSet();
                            if (shortArticleIds.Count > 0)
                            {
                                <div class="alert alert-warning border-0 rounded d-flex align-items-center mb-3">
                                    <i class="fas fa-exclamation-triangle fa-2x mr-3"></i>
                                    <div>
                                        <strong>Hay @shortArticleIds.Count artículo(s) cuya cantidad supera el stock.</strong><br />
                                        <span>Puedes continuar; en Disponibilidad verás el detalle de la semana.</span>
                                    </div>
                                </div>
                            }
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="bg-dark text-white">
                                        <tr>
                                            <th>ARTÍCULO</th>
                                            <th>UNIDAD FÍSICA</th>
                                            <th class="text-center">CANTIDAD</th>
                                            <th class="text-center">STOCK</th>
                                            <th>OBSERVACIONES</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Items)
                                        {
                                            var isFixedUnit = !string.IsNullOrWhiteSpace(item.InventoryNumber);
                                            var itemStock = item.Stock;
                                            var itemIsShort = Model.IsShort(item);
                                            var itemAvailable = itemStock?.Available;
                                            var itemRequested = Model.RequestedByArticle.TryGetValue(item.ArticleId, out var req) ? req : 0m;
                                            string stockTitle = string.Empty;
                                            if (itemStock != null && itemStock.Source == StockSource.EquipmentUnits)
                                            {
                                                stockTitle = $"{itemStock.TotalUnits} unidades: {itemStock.Available} disponibles, {itemStock.OnLoan} en préstamo, {itemStock.InMaintenance} en mantenimiento, {itemStock.OutOfService} fuera de servicio";
                                                if (itemStock.Unconfirmed > 0)
                                                {
                                                    stockTitle += $" ({itemStock.Unconfirmed} por confirmar)";
                                                }
                                            }
                                            <tr class="@(itemIsShort ? "row-short-stock" : null)">
                                                <td class="font-weight-bold">
                                                    @item.ArticleName
                                                    <small class="d-block text-muted">@item.ArticleCode@(string.IsNullOrWhiteSpace(item.Unit) ? "" : $" · {item.Unit}")</small>
                                                    @if (item.ArticlePending)
                                                    {
                                                        <span class="badge badge-warning badge-pill mt-1">Por confirmar</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrWhiteSpace(item.InventoryNumber))
                                                    {
                                                        <span class="badge badge-secondary"><i class="fas fa-tools mr-1"></i>@item.InventoryNumber</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">—</span>
                                                    }
                                                </td>
                                                <td class="text-center" style="width:200px;">
                                                    @if (canWrite && !isFixedUnit)
                                                    {
                                                        <form method="post" asp-page-handler="UpdateQuantity" asp-route-planId="@Model.PlanId" class="m-0">
                                                            <div class="input-group input-group-sm">
                                                                <input type="hidden" name="detailId" value="@item.DetailId" />
                                                                <input type="number" name="newQuantity" step="0.01" min="0.01" max="999999"
                                                                       class="form-control text-center" value="@(item.Quantity?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))" />
                                                                <div class="input-group-append">
                                                                    <button type="submit" class="btn btn-outline-success" title="Actualizar cantidad">
                                                                        <i class="mdi mdi-check"></i>
                                                                    </button>
                                                                </div>
                                                            </div>
                                                        </form>
                                                    }
                                                    else
                                                    {
                                                        <span class="font-weight-bold">@(item.Quantity?.ToString("0.##") ?? "0")</span>
                                                        @if (isFixedUnit)
                                                        {
                                                            <small class="d-block text-muted">fija (unidad física)</small>
                                                        }
                                                    }
                                                </td>
                                                <td class="text-center small">
                                                    @if (!itemAvailable.HasValue)
                                                    {
                                                        <span class="badge badge-secondary"><i class="fas fa-question-circle mr-1"></i>Sin stock</span>
                                                        <small class="d-block text-muted">sin registro</small>
                                                    }
                                                    else if (itemIsShort)
                                                    {
                                                        <span class="text-danger font-weight-bold" title="@stockTitle">
                                                            <i class="fas fa-times-circle mr-1"></i>@itemAvailable.Value.ToString("0.##")
                                                        </span>
                                                        <small class="d-block text-danger">faltan @((itemRequested - itemAvailable.Value).ToString("0.##"))</small>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-success font-weight-bold" title="@stockTitle">
                                                            <i class="fas fa-check-circle mr-1"></i>@itemAvailable.Value.ToString("0.##")
                                                        </span>
                                                        <small class="d-block text-muted">@itemStock!.SourceText</small>
                                                    }
                                                </td>
                                                <td class="small text-muted">
                                                    @if (!string.IsNullOrWhiteSpace(item.Observations))
                                                    {
                                                        @item.Observations
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">—</span>
                                                    }
                                                </td>
                                                <td class="text-right">
                                                    @if (canWrite)
                                                    {
                                                        <form method="post" asp-page-handler="Remove" asp-route-planId="@Model.PlanId" class="d-inline js-form-remove-requirement">
                                                            <input type="hidden" name="detailId" value="@item.DetailId" />
                                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Retirar">
                                                                <i class="mdi mdi-delete"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top flex-wrap">
                            <a asp-page="./Planificacion" asp-route-id="@Model.PlanId" class="btn btn-outline-secondary btn-rounded px-4 mb-2">
                                <i class="mdi mdi-arrow-left mr-1"></i> Atrás
                            </a>
                            <div class="d-flex flex-wrap align-items-center">
                                @if (canWrite && Model.CanEditKit && Model.Items.Count > 0 && kitSubjectId.HasValue)
                                {
                                    <form method="post" asp-page-handler="SaveKit" asp-route-planId="@Model.PlanId" class="d-inline js-form-save-kit mr-2 mb-2">
                                        <button type="submit" class="btn btn-outline-warning btn-rounded font-weight-bold">
                                            <i class="fas fa-boxes mr-1"></i> Guardar como kit de la materia
                                        </button>
                                    </form>
                                }
                                @if (canWrite)
                                {
                                    <form method="post" asp-page-handler="Continue" asp-route-planId="@Model.PlanId" class="d-inline">
                                        <button type="submit" class="btn btn-dark btn-rounded font-weight-bold px-4 mb-2">
                                            Validar disponibilidad <i class="mdi mdi-arrow-right ml-1"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <div class="d-flex">
                                        <a asp-page="./Disponibilidad" asp-route-planId="@Model.PlanId" class="btn btn-primary btn-rounded font-weight-bold px-4">
                                            Ver disponibilidad <i class="mdi mdi-arrow-right ml-1"></i>
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (canWrite)
{
    var pickerOptions = new RequirementPickerOptions(
        RequirementPickerOptions.UnitsMode,
        "Agregar requerimientos",
        Model.PlanId,
        Url.Page("./Requerimientos", "AddBatch", new { planId = Model.PlanId })!,
        Model.Categories,
        Model.Laboratories.Select(l => new RequirementPickerOptions.Option(l.Id, l.Name)).ToList(),
        Model.Plan?.LaboratoryId);
    <partial name="_RequirementPicker" model="pickerOptions" />
}

@section Styles {
    <style>
        .bg-light-info { background-color: #e6f3fb; }
        .bg-light-primary { background-color: #e3edff; }
        .bg-light-warning { background-color: #fff3cd; }
        tr.row-short-stock > td { background-color: #fde7ea !important; }
    </style>
}

@section Scripts {
    <script>
        (function () {
            // Confirmación al retirar un requerimiento
            document.querySelectorAll('form.js-form-remove-requirement').forEach(function (form) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    if (typeof Swal === 'undefined') {
                        HTMLFormElement.prototype.submit.call(form);
                        return;
                    }
                    Swal.fire({
                        title: '¿Retirar requerimiento?',
                        text: 'Esta acción elimina el artículo de la planificación en estado Planificada.',
                        type: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Sí, retirar',
                        cancelButtonText: 'Cancelar',
                        confirmButtonColor: '#bb1e2d',
                        cancelButtonColor: '#6c757d'
                    }).then(function (result) {
                        if (result && (result.isConfirmed === true || result.value === true)) {
                            HTMLFormElement.prototype.submit.call(form);
                        }
                    });
                });
            });

            // Confirmación al cargar la receta
            document.querySelectorAll('form.js-load-recipe').forEach(function (form) {
                form.addEventListener('submit', function (e) {
                    if (typeof Swal === 'undefined') return;
                    e.preventDefault();
                    Swal.fire({
                        title: '¿Cargar receta de la práctica?',
                        text: 'Se agregarán a la solicitud los artículos declarados en la receta del catálogo que aún no están en la lista. Las cantidades se escalan según los estudiantes y el factor configurados.',
                        type: 'question',
                        showCancelButton: true,
                        confirmButtonText: 'Sí, cargar',
                        cancelButtonText: 'Cancelar',
                        confirmButtonColor: '#17a2b8',
                        cancelButtonColor: '#6c757d'
                    }).then(function (result) {
                        if (result && (result.isConfirmed === true || result.value === true)) {
                            HTMLFormElement.prototype.submit.call(form);
                        }
                    });
                });
            });

            // Confirmación al guardar como kit de la materia (soft-replace: sí o sí confirma)
            document.querySelectorAll('form.js-form-save-kit').forEach(function (form) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    if (typeof Swal === 'undefined') {
                        HTMLFormElement.prototype.submit.call(form);
                        return;
                    }
                    var subjectName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SubjectName ?? "la materia"));
                    var itemCount = @Model.Items.Count.ToString(System.Globalization.CultureInfo.InvariantCulture);
                    Swal.fire({
                        title: '¿Guardar como kit de la materia?',
                        text: 'Se reemplazará el kit de ' + subjectName + ' con las ' + itemCount + ' líneas actuales (sumadas por artículo). ¿Continuar?',
                        type: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Sí, guardar',
                        cancelButtonText: 'Cancelar',
                        confirmButtonColor: '#ffc107',
                        cancelButtonColor: '#6c757d'
                    }).then(function (result) {
                        if (result && (result.isConfirmed === true || result.value === true)) {
                            HTMLFormElement.prototype.submit.call(form);
                        }
                    });
                });
            });
        })();
    </script>
}