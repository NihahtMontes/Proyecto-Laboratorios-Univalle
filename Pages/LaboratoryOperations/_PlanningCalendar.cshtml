@*
    Partial: _PlanningCalendar.cshtml
    Calendario resumen de la gestión: navegación de meses + semanas académicas + días lunes a sábado.
    Model: Proyecto_Laboratorios_Univalle.Pages.LaboratoryOperations.PlanningCalendar
*@
@model Proyecto_Laboratorios_Univalle.Pages.LaboratoryOperations.PlanningCalendar

<!-- Navegación de meses -->
<div class="card border-0 shadow-sm rounded-lg mb-3">
    <div class="card-body py-3">
        <div class="d-flex flex-wrap align-items-center">
            <div class="d-flex align-items-center">
                @if (!string.IsNullOrEmpty(Model.PreviousMonth))
                {
                    <a asp-page="./Index" asp-route-managementId="@Model.ManagementId" asp-route-month="@Model.PreviousMonth"
                       class="btn btn-outline-secondary btn-rounded btn-sm mr-2" title="Mes anterior" aria-label="Mes anterior">
                        <i class="fas fa-chevron-left"></i>
                    </a>
                }
                else
                {
                    <button type="button" class="btn btn-outline-secondary btn-rounded btn-sm mr-2" disabled aria-label="Mes anterior">
                        <i class="fas fa-chevron-left"></i>
                    </button>
                }
                <h5 class="font-weight-bold text-dark mb-0 mx-2 pl-month-title">@Model.MonthLabel</h5>
                @if (!string.IsNullOrEmpty(Model.NextMonth))
                {
                    <a asp-page="./Index" asp-route-managementId="@Model.ManagementId" asp-route-month="@Model.NextMonth"
                       class="btn btn-outline-secondary btn-rounded btn-sm ml-2" title="Mes siguiente" aria-label="Mes siguiente">
                        <i class="fas fa-chevron-right"></i>
                    </a>
                }
                else
                {
                    <button type="button" class="btn btn-outline-secondary btn-rounded btn-sm ml-2" disabled aria-label="Mes siguiente">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                }
            </div>
            <div class="ml-auto mt-2 mt-md-0">
                <span class="badge badge-light border px-3 py-2">
                    <i class="fas fa-flask mr-1 text-primary"></i>
                    <strong>@Model.PlanningsInMonth</strong> planificaciones en el mes
                </span>
            </div>
        </div>
        <div class="pl-month-pills mt-3" role="navigation" aria-label="Meses de la gestión">
            @foreach (var m in Model.Months)
            {
                <a asp-page="./Index" asp-route-managementId="@Model.ManagementId" asp-route-month="@m.Value"
                   class="pl-month-pill @(m.Selected ? "pl-month-pill--active" : string.Empty)"
                   aria-current="@(m.Selected ? "true" : "false")">@m.Label</a>
            }
        </div>
    </div>
</div>

<!-- Semanas académicas -->
@if (Model.Weeks.Count == 0)
{
    <div class="card border-0 shadow-sm rounded-lg">
        <div class="card-body text-center py-5">
            <i class="far fa-calendar fa-3x text-muted mb-3"></i>
            <h5 class="font-weight-bold text-dark">No hay semanas académicas en este mes</h5>
            <p class="text-muted mb-3">Cambia de mes o genera el calendario de la gestión.</p>
            <a asp-page="./CalendarioAcademico" asp-route-managementId="@Model.ManagementId" class="btn btn-outline-primary btn-rounded btn-sm">
                <i class="mdi mdi-calendar-month mr-1"></i> Calendario académico
            </a>
        </div>
    </div>
}
else
{
    @foreach (var week in Model.Weeks)
    {
        <div class="card border-0 shadow-sm rounded-lg mb-3">
            <div class="card-body p-3">
                <div class="d-flex align-items-center mb-3 flex-wrap">
                    <div class="rounded-circle bg-light-primary text-primary p-2 mr-3"><i class="fas fa-calendar-week"></i></div>
                    <div>
                        <h6 class="font-weight-bold text-primary mb-0">Semana académica @week.Number</h6>
                        <small class="text-muted">@week.StartDate.ToString("dd/MM") – @week.EndDate.ToString("dd/MM")</small>
                    </div>
                </div>

                <div class="pl-week-grid">
                    @foreach (var day in week.Days)
                    {
                        var dayCss = !day.Exists ? "pl-day--none" : day.IsSuspended ? "pl-day--suspended" : string.Empty;
                        <div class="pl-day @(day.InMonth ? string.Empty : "pl-day--out") @dayCss">
                            <div class="pl-day__head">
                                <strong class="pl-day__name">@day.Name</strong>
                                <span class="pl-day__date">@day.Date.ToString("dd/MM")</span>
                            </div>
                            <div class="pl-day__body">
                                @if (!day.Exists)
                                {
                                    <div class="pl-empty">Fuera de la gestión</div>
                                }
                                else if (day.IsSuspended)
                                {
                                    <div class="pl-suspended" title="@day.Reason">
                                        <i class="mdi mdi-calendar-remove mr-1"></i><strong>Suspendido</strong>
                                        @if (!string.IsNullOrWhiteSpace(day.Reason))
                                        {
                                            <div>@day.Reason</div>
                                        }
                                    </div>
                                }
                                else if (day.Plannings.Count == 0)
                                {
                                    <div class="pl-empty">Sin planificaciones</div>
                                }

                                @foreach (var p in day.Plannings)
                                {
                                    <a href="@p.NextUrl" class="pl-card @(p.Occupies ? string.Empty : "pl-card--inactive")" title="Abrir planificación @p.Code">
                                        <div class="pl-card__time">@p.TimeText</div>
                                        <div class="pl-card__title">@p.PracticeName</div>
                                        <div class="pl-card__sub"><i class="fas fa-book mr-1"></i>@p.SubjectName</div>
                                        <div class="pl-card__sub"><i class="fas fa-flask mr-1"></i>@p.LaboratoryName</div>
                                        <div class="pl-card__sub"><i class="fas fa-users mr-1"></i>Grupo @p.GroupName</div>
                                        <div class="pl-card__sub"><i class="fas fa-user-tie mr-1"></i>@p.TeacherName</div>
                                        <div class="pl-card__foot">
                                            <span class="badge badge-@p.StatusCss @(p.StatusCss == "light" ? "border" : string.Empty)">@p.StatusLabel</span>
                                            <span class="pl-card__code">@p.Code</span>
                                        </div>
                                    </a>
                                }

                                @if (day.CanAdd)
                                {
                                    <a asp-page="./Planificacion" asp-route-managementId="@Model.ManagementId" asp-route-date="@day.Date.ToString("yyyy-MM-dd")"
                                       class="btn btn-sm btn-outline-primary btn-rounded pl-add">
                                        <i class="fas fa-plus mr-1"></i> Planificación
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}

<style>
    .bg-light-primary { background-color: #e8e7ff; }
    .pl-month-title { text-transform: capitalize; }

    .pl-month-pills { display: flex; flex-wrap: wrap; gap: 6px; }
    .pl-month-pill {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 999px;
        border: 1px solid #e0e0e0;
        background: #fff;
        color: #555;
        font-size: 12px;
        font-weight: 600;
        text-transform: capitalize;
        transition: all .2s;
    }
    .pl-month-pill:hover { background: #f4f3ff; color: #7460ee; border-color: #c7c2f0; text-decoration: none; }
    .pl-month-pill--active { background: #7460ee; border-color: #7460ee; color: #fff; }
    .pl-month-pill--active:hover { background: #5d4dd1; color: #fff; }

    .pl-week-grid {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 10px;
    }
    .pl-day {
        background: #fff;
        border: 1px solid #ececec;
        border-radius: 8px;
        min-height: 150px;
        display: flex;
        flex-direction: column;
    }
    .pl-day--out { opacity: 0.45; }
    .pl-day--none { background: #fafafa; }
    .pl-day--none .pl-day__head { background: #f1f1f1; }
    .pl-day--suspended {
        background: repeating-linear-gradient(45deg, #f5f5f5, #f5f5f5 8px, #ebebeb 8px, #ebebeb 16px);
    }
    .pl-day--suspended .pl-day__head { background: #e2e2e2; }
    .pl-day__head {
        background: #f4f3ff;
        color: #555;
        padding: 6px 10px;
        border-bottom: 1px solid #ececec;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 12px;
    }
    .pl-day__name { color: #7460ee; }
    .pl-day__date { font-weight: 600; }
    .pl-day__body { padding: 8px; display: flex; flex-direction: column; gap: 6px; flex: 1; }

    .pl-empty { font-size: 11px; color: #b3b3b3; font-style: italic; }
    .pl-suspended { font-size: 11px; color: #555; background: rgba(255,255,255,.85); border-radius: 6px; padding: 4px 6px; }

    .pl-card {
        display: block;
        background: #fff;
        border: 1px solid #ececec;
        border-left: 3px solid #7460ee;
        border-radius: 6px;
        padding: 6px 8px;
        text-decoration: none;
        color: #333;
        font-size: 12px;
        transition: all .2s;
    }
    .pl-card:hover { background: #faf9ff; box-shadow: 0 2px 6px rgba(116,96,238,.15); text-decoration: none; color: #333; }
    .pl-card--inactive { opacity: .55; border-left-color: #b3b3b3; }
    .pl-card__time { color: #7460ee; font-weight: 700; font-size: 11px; }
    .pl-card__title { font-weight: 700; color: #1a1a1a; margin: 1px 0 2px 0; line-height: 1.2; }
    .pl-card__sub { color: #777; line-height: 1.25; font-size: 11px; }
    .pl-card__foot { display: flex; justify-content: space-between; align-items: center; margin-top: 4px; }
    .pl-card__code { color: #999; font-size: 10px; font-weight: 600; }

    .pl-add { align-self: flex-start; font-size: 11px; padding: 2px 8px; }

    @@media (max-width: 992px) {
        .pl-week-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
    @@media (max-width: 768px) {
        .pl-week-grid { grid-template-columns: 1fr; }
    }
</style>
