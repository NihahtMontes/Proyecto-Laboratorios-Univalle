@page
@model Proyecto_Laboratorios_Univalle.Pages.LaboratoryOperations.Solicitudes.IndexModel
@using System.Globalization
@using Proyecto_Laboratorios_Univalle.Models
@using Proyecto_Laboratorios_Univalle.Pages.LaboratoryOperations
@{
    ViewData["Title"] = "Solicitudes de docentes";
    ViewData["Section"] = "Planificación académica";
    ViewData["HidePageTitle"] = true;
    var es = new CultureInfo("es-BO");
    var clean = Model.Rows.Where(r => r.Status == PlanningStatus.Requested && r.Clean).ToList();
}

@section Styles {
    <link href="~/css/docente.css" rel="stylesheet" asp-append-version="true" />
}

<div class="page-breadcrumb">
    <div class="row align-items-center">
        <div class="col-md-7">
            <h4 class="page-title text-uppercase text-primary font-weight-bold mb-0">OPERACIÓN DE LABORATORIOS</h4>
            <h2 class="font-weight-bold text-dark mb-0">Solicitudes de docentes</h2>
            <div class="text-muted small">Ordenadas por la fecha de la práctica: lo más urgente primero. Una solicitud no reserva el laboratorio hasta aprobarla.</div>
        </div>
        <div class="col-md-5 text-md-right mt-3 mt-md-0">
            @if (Model.Tab == "revisar" && clean.Count > 0)
            {
                <form method="post" asp-page-handler="ApproveClean" id="approveCleanForm" class="d-inline">
                    @foreach (var row in clean)
                    {
                        <input type="hidden" name="ids" value="@row.Id" />
                    }
                    <button type="button" class="btn btn-success rounded-pill px-4 shadow-sm" id="btnApproveClean">
                        <i class="fas fa-clipboard-check mr-1"></i>Aprobar @clean.Count sin observaciones
                    </button>
                </form>
            }
        </div>
    </div>
</div>

<div class="container-fluid mt-3">
    <div class="row mb-3">
        <div class="col-md-4 mb-2">
            <a asp-route-tab="revisar" class="dc-kpi @(Model.Tab == "revisar" ? "border-primary" : null)">
                <span class="dc-kpi__icon dc-soft-primary"><i class="fas fa-inbox"></i></span>
                <div><div class="dc-kpi__value">@Model.ToReview</div><div class="dc-kpi__label">Por revisar</div></div>
            </a>
        </div>
        <div class="col-md-4 mb-2">
            <a asp-route-tab="observadas" class="dc-kpi">
                <span class="dc-kpi__icon dc-soft-orange"><i class="fas fa-comment-dots"></i></span>
                <div><div class="dc-kpi__value">@Model.Observed</div><div class="dc-kpi__label">Esperando corrección del docente</div></div>
            </a>
        </div>
        <div class="col-md-4 mb-2">
            <a asp-route-tab="resueltas" class="dc-kpi">
                <span class="dc-kpi__icon dc-soft-success"><i class="fas fa-history"></i></span>
                <div><div class="dc-kpi__value"><i class="fas fa-arrow-right" style="font-size:1rem;"></i></div><div class="dc-kpi__label">Resueltas (30 días)</div></div>
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius:16px;">
        <div class="card-body p-0">
            @if (Model.Rows.Count == 0)
            {
                <div class="dc-empty">
                    <i class="fas fa-inbox text-success"></i>
                    <div class="font-weight-bold text-dark">@(Model.Tab == "revisar" ? "¡Bandeja al día! No hay solicitudes por revisar." : "No hay solicitudes en esta vista.")</div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>Práctica y docente</th>
                                <th>Cuándo</th>
                                <th>Laboratorio</th>
                                <th>Análisis</th>
                                <th class="text-right"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Rows)
                            {
                                var rowCss = row.Status == PlanningStatus.Requested ? (row.Urgent ? "is-urgent" : row.Soon ? "is-soon" : null) : null;
                                <tr class="dc-inbox-row @rowCss">
                                    <td>
                                        <a asp-page="./Revisar" asp-route-id="@row.Id" class="font-weight-bold text-dark">@row.Practice</a>
                                        <div class="small text-muted">@row.Code · @row.Subject · Gr. @row.Group</div>
                                        <div class="small"><i class="fas fa-user mr-1 text-muted"></i>@row.Teacher</div>
                                        @if (Model.Tab != "revisar" && !string.IsNullOrWhiteSpace(row.Comment))
                                        {
                                            <div class="small text-muted text-truncate" style="max-width:380px;"><i class="fas fa-comment mr-1"></i>@row.Comment</div>
                                        }
                                    </td>
                                    <td class="text-nowrap">
                                        <div class="text-capitalize font-weight-bold">@row.Date.ToString("ddd d MMM", es)</div>
                                        <div class="small text-muted">@row.TimeText</div>
                                        @if (row.Status == PlanningStatus.Requested)
                                        {
                                            <span class="badge @(row.Urgent ? "badge-danger" : row.Soon ? "badge-warning" : "badge-light border")">
                                                @(row.DaysLeft < 0 ? "Fecha pasada" : row.DaysLeft == 0 ? "Hoy" : row.DaysLeft == 1 ? "Mañana" : $"En {row.DaysLeft} días")
                                            </span>
                                        }
                                    </td>
                                    <td><strong>@row.LabCode</strong><div class="small text-muted">@row.Items artículo(s)</div></td>
                                    <td>
                                        @if (row.Status != PlanningStatus.Requested)
                                        {
                                            <span class="badge badge-pill badge-@PlanningStatusView.Css(row.Status)">@PlanningStatus.Label(row.Status)</span>
                                        }
                                        else if (row.Clean)
                                        {
                                            <span class="dc-flag dc-soft-success"><i class="fas fa-check-circle mr-1"></i>Sin observaciones</span>
                                        }
                                        else
                                        {
                                            @if (row.Blocks > 0)
                                            {
                                                <span class="dc-flag dc-soft-danger"><i class="fas fa-ban mr-1"></i>Choque de horario</span>
                                            }
                                            @if (row.Competitors > 0)
                                            {
                                                <span class="dc-flag dc-soft-primary"><i class="fas fa-random mr-1"></i>Compite con otra solicitud</span>
                                            }
                                            @if (row.MaterialShort > 0)
                                            {
                                                <span class="dc-flag dc-soft-orange"><i class="fas fa-box-open mr-1"></i>@row.MaterialShort artículo(s) no alcanzan</span>
                                            }
                                        }
                                        @if (row.MaterialNoStock > 0)
                                        {
                                            <span class="dc-flag dc-soft-secondary"><i class="fas fa-question-circle mr-1"></i>@row.MaterialNoStock sin stock registrado</span>
                                        }
                                    </td>
                                    <td class="text-right">
                                        <a asp-page="./Revisar" asp-route-id="@row.Id" class="btn btn-sm rounded-pill px-3 @(row.Status == PlanningStatus.Requested ? "btn-primary" : "btn-light border")">
                                            @(row.Status == PlanningStatus.Requested ? "Revisar" : "Ver")<i class="fas fa-arrow-right ml-1"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var btn = document.getElementById('btnApproveClean');
            if (!btn) return;
            btn.addEventListener('click', function () {
                Swal.fire({
                    title: '¿Aprobar @clean.Count solicitud(es)?',
                    text: 'Solo las que no tienen choques, competencia ni faltantes. Se revalidan una por una antes de aprobar y los docentes reciben el aviso.',
                    type: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, aprobar',
                    cancelButtonText: 'Cancelar',
                    confirmButtonColor: '#36bea6'
                }).then(function (result) {
                    if (result && (result.isConfirmed === true || result.value === true)) {
                        btn.disabled = true;
                        HTMLFormElement.prototype.submit.call(document.getElementById('approveCleanForm'));
                    }
                });
            });
        })();
    </script>
}
