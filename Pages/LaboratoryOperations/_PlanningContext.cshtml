@* Partial: _PlanningContext.cshtml
   Franja superior del wizard de la práctica: planificación, código de práctica y stepper de 5 pasos.
   Modelo: Proyecto_Laboratorios_Univalle.Pages.LaboratoryOperations.PlanningContextViewModel
   Uso: <partial name="_PlanningContext" model="Model.Context" />

   Clases prefijadas con .pc- para no chocar con .wizard-stepper de Pages/Index.cshtml.
*@
@model Proyecto_Laboratorios_Univalle.Pages.LaboratoryOperations.PlanningContextViewModel

@{
    var planning = Model.Planning;
    var stepIcons = new[] { "fa-flask", "fa-list-check", "fa-boxes", "fa-exchange-alt", "fa-exclamation-triangle" };
}

<style>
    .pc-strip {
        background: #fbfaff;
        border: 1px solid #e9e5fb;
        border-left: 4px solid #7460ee;
        border-radius: 12px;
        padding: 1rem 1.25rem;
        box-shadow: 0 1px 3px rgba(116, 96, 238, 0.04);
    }
    .pc-strip--readonly {
        background: #fff8eb;
        border-color: #fce3a4;
        border-left-color: #f6c453;
    }
    .pc-strip__eyebrow {
        font-size: 0.65rem;
        letter-spacing: 0.06em;
        font-weight: 800;
        color: #8a82b5;
        text-transform: uppercase;
    }
    .pc-strip__title {
        font-weight: 800;
        color: #2a1d6b;
        font-size: 0.95rem;
    }
    .pc-strip__title b { color: #7460ee; }
    .pc-strip__icon {
        width: 38px; height: 38px;
        background: #eee9fc; color: #7460ee;
    }
    .pc-chip {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: #ffffff;
        border: 1px solid #e9e5fb;
        color: #4a3f7d;
        border-radius: 999px;
        padding: 4px 10px;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        text-transform: uppercase;
    }
    .pc-chip i { color: #7460ee; font-size: 0.7rem; }
    .pc-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border-radius: 999px;
        padding: 4px 10px;
        font-size: 0.7rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.02em;
    }
    .pc-badge--active { background: #e8f8ee; border: 1px solid #bfe6cd; color: #1b6f3d; }
    .pc-badge--inactive { background: #f5f5f7; border: 1px solid #e0e0e6; color: #6c757d; }
    .pc-warn {
        background: #fff7e6;
        border: 1px solid #f5d491;
        border-radius: 10px;
        padding: 8px 12px;
        color: #8a5a00;
        font-size: 0.85rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 0.75rem;
        margin-bottom: 0;
    }
    .pc-empty {
        background: #fbfaff;
        border: 1px dashed #d2cbf3;
        border-left: 4px solid #7460ee;
        border-radius: 12px;
        padding: 1rem 1.25rem;
        color: #5a4f8a;
        font-size: 0.9rem;
    }
    .pc-panel-link {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 14px;
        border-radius: 999px;
        border: 1px solid #e9e5fb;
        color: #4a3f7d;
        font-weight: 700;
        font-size: 0.78rem;
        text-decoration: none;
        background: white;
        transition: all .2s ease;
    }
    .pc-panel-link:hover { background: #f5f1ff; color: #2a1d6b; text-decoration: none; }

    /* Stepper morado (prefijo .pc-) — gemelo del wizard de Pages/Index.cshtml */
    .pc-stepper-card {
        background: white;
        border-radius: 12px;
        border: 1px solid #eef0f5;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    }
    .pc-stepper {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        position: relative;
        padding: 0 8px;
    }
    .pc-stepper::before {
        content: '';
        position: absolute;
        top: 22px;
        left: 48px;
        right: 48px;
        height: 3px;
        background: #e9e5fb;
        z-index: 0;
        border-radius: 3px;
    }
    .pc-step-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        flex: 1;
    }
    .pc-step-circle {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        transition: all .3s ease;
        position: relative;
        z-index: 2;
        border: 2px solid #e9e5fb;
        background: white;
        color: #8a82b5;
    }
    .pc-step-circle.completed {
        background: #7460ee;
        color: white;
        border-color: #7460ee;
    }
    .pc-step-circle.active {
        background: #5d3df5;
        color: white;
        border-color: #5d3df5;
        box-shadow: 0 0 0 6px rgba(116, 96, 238, 0.15);
        animation: pc-step-pulse 2s infinite;
    }
    .pc-step-label {
        margin-top: 8px;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.02em;
        color: #8a82b5;
        text-align: center;
        line-height: 1.2;
        max-width: 110px;
    }
    .pc-step-label.active { color: #2a1d6b; }
    .pc-step-label.completed { color: #5d3df5; }
    .pc-step-connector-right {
        position: absolute;
        top: 22px;
        left: 50%;
        width: 100%;
        height: 3px;
        z-index: 0;
        border-radius: 3px;
        background: #e9e5fb;
    }
    .pc-step-connector-right.completed { background: #7460ee; }
    @@keyframes pc-step-pulse {
        0%   { box-shadow: 0 0 0 6px rgba(116, 96, 238, 0.15); }
        50%  { box-shadow: 0 0 0 10px rgba(116, 96, 238, 0.08); }
        100% { box-shadow: 0 0 0 6px rgba(116, 96, 238, 0.15); }
    }
    @@media (max-width: 768px) {
        .pc-step-circle { width: 36px; height: 36px; font-size: .85rem; }
        .pc-step-label { font-size: .6rem; max-width: 60px; }
        .pc-stepper::before { top: 18px; left: 36px; right: 36px; }
        .pc-step-connector-right { top: 18px; }
    }
</style>

<div class="mb-4">
    @if (planning != null)
    {
        <div class="pc-strip @(Model.IsReadOnly ? "pc-strip--readonly" : "")">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <div class="rounded-circle d-flex align-items-center justify-content-center mr-1 pc-strip__icon">
                        <i class="fas fa-university"></i>
                    </div>
                    <div class="mr-3">
                        <div class="pc-strip__eyebrow">Planificación académica</div>
                        <div class="pc-strip__title">Planificación: <b>@planning.Name</b></div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <span class="pc-chip"><i class="fas fa-calendar-alt"></i> Gestión @planning.ManagementCode</span>
                        <span class="pc-chip"><i class="fas fa-graduation-cap"></i> @planning.FacultyName</span>
                        <span class="pc-chip"><i class="fas fa-book"></i> @planning.CareerName</span>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="pc-badge @(planning.IsActive ? "pc-badge--active" : "pc-badge--inactive")">
                        <i class="fas @(planning.IsActive ? "fa-check-circle" : "fa-circle")"></i> @planning.StatusText
                    </span>
                    <a asp-page="./Index" class="pc-panel-link">
                        <i class="fas fa-th-large"></i> Panel
                    </a>
                </div>
            </div>
            @if (Model.IsReadOnly)
            {
                <div class="pc-warn">
                    <i class="fas fa-lock"></i>
                    <span>Planificación no activa: solo consulta. Las prácticas, requerimientos y registros se conservan para auditoría.</span>
                </div>
            }
        </div>
    }
    else
    {
        <div class="pc-empty d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-2">
                <i class="fas fa-info-circle" style="color:#7460ee;font-size:1.1rem;"></i>
                <span>Práctica sin planificación académica (registro anterior al módulo de planificación).</span>
            </div>
            <a asp-page="./Index" class="pc-panel-link">
                <i class="fas fa-th-large"></i> Panel
            </a>
        </div>
    }

    <div class="pc-stepper-card mt-3">
        <div class="p-3 p-md-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                <div>
                    <span class="pc-strip__eyebrow">Práctica</span>
                    <h5 class="font-weight-bold text-dark mb-0">@Model.PracticeTitle</h5>
                </div>
            </div>
            <div class="pc-stepper">
                @for (int i = 1; i <= 5; i++)
                {
                    var isCompleted = i < Model.Step;
                    var isActive = i == Model.Step;
                    var iconClass = stepIcons[i - 1];
                    <div class="pc-step-item">
                        @if (i < 5)
                        {
                            <div class="pc-step-connector-right @(isCompleted || isActive ? "completed" : "")"></div>
                        }
                        <div class="pc-step-circle @(isCompleted ? "completed" : isActive ? "active" : "")">
                            @if (isCompleted)
                            {
                                <i class="fas fa-check"></i>
                            }
                            else
                            {
                                <i class="fas @iconClass"></i>
                            }
                        </div>
                        <span class="pc-step-label @(isActive ? "active" : isCompleted ? "completed" : "")">@PlanningContextViewModel.StepNames[i]</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>