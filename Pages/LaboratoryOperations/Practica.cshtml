@page
@model Proyecto_Laboratorios_Univalle.Pages.LaboratoryOperations.PracticaModel
@{ ViewData["Title"] = "Práctica de laboratorio"; }

<div class="container-fluid mt-3">
    <partial name="_PlanningContext" model="Model.Context" />

    <form method="post" asp-route-id="@Model.Id" asp-route-planningId="@Model.PlanningId" id="form-practica">
        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 rounded-lg">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-4">
                            <div class="rounded-circle bg-light-primary text-primary p-3 mr-3"><i class="fas fa-flask fa-lg"></i></div>
                            <div>
                                <h5 class="font-weight-bold text-primary mb-1">Datos de la práctica</h5>
                                <small class="text-muted">Selecciona el laboratorio, responsable, materia, grupo y la semana académica en la que se ejecutará.</small>
                            </div>
                        </div>

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        @if (Model.Planning != null)
                        {
                            <div class="bg-light p-3 rounded mb-4 border-left" style="border-left: 4px solid #7460ee;">
                                <h5 class="text-dark font-weight-bold mb-3 small text-uppercase" style="letter-spacing:.04em;">
                                    <i class="fas fa-link mr-2 text-primary"></i>Datos heredados de la planificación
                                </h5>
                                <div class="row">
                                    <div class="form-group col-md-4 mb-2">
                                        <label class="small font-weight-bold text-muted">
                                            <i class="fas fa-lock text-muted mr-1"></i>Gestión
                                        </label>
                                        <select class="form-control select2" disabled>
                                            <option selected>@Model.Planning.ManagementCode</option>
                                        </select>
                                        <small class="form-text text-muted"><i class="fas fa-info-circle mr-1"></i>Se define en la planificación.</small>
                                    </div>
                                    <div class="form-group col-md-4 mb-2">
                                        <label class="small font-weight-bold text-muted">
                                            <i class="fas fa-lock text-muted mr-1"></i>Facultad
                                        </label>
                                        <select class="form-control select2" disabled>
                                            <option selected>@Model.Planning.FacultyName</option>
                                        </select>
                                        <small class="form-text text-muted"><i class="fas fa-info-circle mr-1"></i>Se define en la planificación.</small>
                                    </div>
                                    <div class="form-group col-md-4 mb-2">
                                        <label class="small font-weight-bold text-muted">
                                            <i class="fas fa-lock text-muted mr-1"></i>Carrera
                                        </label>
                                        <select class="form-control select2" disabled>
                                            <option selected>@Model.Planning.CareerName</option>
                                        </select>
                                        <small class="form-text text-muted"><i class="fas fa-info-circle mr-1"></i>Se define en la planificación.</small>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label asp-for="Input.LaboratoryId" class="small font-weight-bold text-muted"></label>
                                <select asp-for="Input.LaboratoryId" asp-items="Model.LaboratoryList" class="form-control select2" disabled="@(Model.IsReadOnly ? "disabled" : null)">
                                    <option value="0">— Seleccionar laboratorio —</option>
                                </select>
                                <span asp-validation-for="Input.LaboratoryId" class="text-danger small"></span>
                                @if (Model.LaboratoryList.Count() == 0)
                                {
                                    <small class="text-warning d-block mt-1"><i class="fas fa-exclamation-triangle mr-1"></i> No hay laboratorios registrados en esta facultad.</small>
                                }
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="Input.TeacherPersonId" class="small font-weight-bold text-muted"></label>
                                <select asp-for="Input.TeacherPersonId" asp-items="Model.TeacherList" class="form-control select2" disabled="@(Model.IsReadOnly ? "disabled" : null)">
                                    <option value="0">— Seleccionar docente —</option>
                                </select>
                                <span asp-validation-for="Input.TeacherPersonId" class="text-danger small"></span>
                                @if (Model.TeacherList.Count() == 0)
                                {
                                    <small class="text-warning d-block mt-1"><i class="fas fa-exclamation-triangle mr-1"></i> No hay docentes registrados.</small>
                                }
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label asp-for="Input.SubjectId" class="small font-weight-bold text-muted"></label>
                                <select asp-for="Input.SubjectId" asp-items="Model.SubjectList" class="form-control select2" disabled="@(Model.IsReadOnly ? "disabled" : null)">
                                    <option value="0">— Seleccionar materia —</option>
                                </select>
                                <span asp-validation-for="Input.SubjectId" class="text-danger small"></span>
                                @if (Model.SubjectList.Count() == 0)
                                {
                                    <small class="text-warning d-block mt-1"><i class="fas fa-exclamation-triangle mr-1"></i> No hay materias registradas.</small>
                                }
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="Input.GroupId" class="small font-weight-bold text-muted"></label>
                                <select asp-for="Input.GroupId" asp-items="Model.GroupList" class="form-control select2" disabled="@(Model.IsReadOnly ? "disabled" : null)">
                                    <option value="0">— Seleccionar grupo —</option>
                                </select>
                                <span asp-validation-for="Input.GroupId" class="text-danger small"></span>
                                @if (Model.GroupList.Count() == 0)
                                {
                                    <small class="text-warning d-block mt-1"><i class="fas fa-exclamation-triangle mr-1"></i> No hay grupos registrados.</small>
                                }
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-12">
                                <label asp-for="Input.PracticeName" class="small font-weight-bold text-muted"></label>
                                <input asp-for="Input.PracticeName" class="form-control" placeholder="Ej. Cocina Boliviana Contemporánea" disabled="@(Model.IsReadOnly ? "disabled" : null)" />
                                <span asp-validation-for="Input.PracticeName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label asp-for="Input.AcademicWeekId" class="small font-weight-bold text-muted"></label>
                                <select asp-for="Input.AcademicWeekId" asp-items="Model.WeekList" class="form-control select2" disabled="@(Model.IsReadOnly ? "disabled" : null)">
                                    <option value="0">— Seleccionar semana —</option>
                                </select>
                                <span asp-validation-for="Input.AcademicWeekId" class="text-danger small"></span>
                                @if (Model.WeekList.Count() == 0)
                                {
                                    <small class="text-warning d-block mt-1"><i class="fas fa-exclamation-triangle mr-1"></i> No hay semanas lectivas en esta planificación.</small>
                                }
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="Input.Weekday" class="small font-weight-bold text-muted"></label>
                                <select asp-for="Input.Weekday" asp-items="Model.DayList" class="form-control select2" disabled="@(Model.IsReadOnly ? "disabled" : null)">
                                    <option value="0">— Seleccionar día —</option>
                                </select>
                                <span asp-validation-for="Input.Weekday" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label asp-for="Input.StartTime" class="small font-weight-bold text-muted"></label>
                                <input asp-for="Input.StartTime" type="time" class="form-control" disabled="@(Model.IsReadOnly ? "disabled" : null)" />
                                <span asp-validation-for="Input.StartTime" class="text-danger small"></span>
                            </div>
                            <div class="form-group col-md-6">
                                <label asp-for="Input.EndTime" class="small font-weight-bold text-muted"></label>
                                <input asp-for="Input.EndTime" type="time" class="form-control" disabled="@(Model.IsReadOnly ? "disabled" : null)" />
                                <span asp-validation-for="Input.EndTime" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-12">
                                <label asp-for="Input.Observations" class="small font-weight-bold text-muted"></label>
                                <textarea asp-for="Input.Observations" class="form-control" rows="2" placeholder="Observaciones o contexto de la práctica" disabled="@(Model.IsReadOnly ? "disabled" : null)"></textarea>
                                <span asp-validation-for="Input.Observations" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                            @if (Model.Planning != null)
                            {
                                <a asp-page="./Calendario" asp-route-planningId="@Model.Planning.Id" class="btn btn-outline-secondary btn-rounded px-4">
                                    <i class="fas fa-times mr-1"></i> Cancelar
                                </a>
                            }
                            else
                            {
                                <a asp-page="./Calendario" class="btn btn-outline-secondary btn-rounded px-4">
                                    <i class="fas fa-times mr-1"></i> Cancelar
                                </a>
                            }

                            @if (Model.IsReadOnly)
                            {
                                <a asp-page="./Requerimientos" asp-route-planId="@Model.Id" class="btn btn-primary btn-rounded font-weight-bold px-4">
                                    Ver requerimientos <i class="mdi mdi-arrow-right ml-1"></i>
                                </a>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-primary btn-rounded font-weight-bold px-4">
                                    Guardar y definir requerimientos <i class="mdi mdi-arrow-right ml-1"></i>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 mt-3 mt-lg-0">
                <div class="card border-0 shadow-sm rounded-lg h-100">
                    <div class="card-body p-4">
                        <span class="text-uppercase small text-primary font-weight-bold">Práctica dentro del flujo</span>
                        <h5 class="font-weight-bold text-dark mt-2">Una práctica, cinco decisiones</h5>
                        <div class="d-flex mb-3"><span class="badge badge-primary mr-2">1</span><span>Definir práctica (laboratorio, docente, horario).</span></div>
                        <div class="d-flex mb-3"><span class="badge badge-info mr-2">2</span><span>Agregar materiales y cantidades.</span></div>
                        <div class="d-flex mb-3"><span class="badge badge-warning mr-2">3</span><span>Validar disponibilidad y solapamientos.</span></div>
                        <div class="d-flex mb-3"><span class="badge badge-dark mr-2">4</span><span>Registrar entrega/devolución L-3.</span></div>
                        <div class="d-flex"><span class="badge badge-danger mr-2">5</span><span>Cerrar con L-5 incidente (si aplica).</span></div>

                        <div class="alert alert-light border mt-4 mb-0 small">
                            <i class="fas fa-info-circle text-primary mr-1"></i>
                            La planificación y su código se conservan durante todo el flujo. Si necesitas cambiarla, usa <strong>Editar planificación</strong>.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Styles {
    <link href="~/assets/libs/select2/dist/css/select2.min.css" rel="stylesheet">
    <style>
        .bg-light-primary { background-color: #e8e7ff; }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/libs/select2/dist/js/select2.full.min.js"></script>
    <script>
        (function () {
            $('.select2').select2({
                width: '100%',
                language: {
                    noResults: function () { return 'Sin coincidencias'; }
                }
            });
        })();
    </script>
}