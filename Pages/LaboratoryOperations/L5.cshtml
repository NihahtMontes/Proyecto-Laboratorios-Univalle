@page
@model Proyecto_Laboratorios_Univalle.Pages.LaboratoryOperations.L5Model
@{ ViewData["Title"] = "Incidente L-5 — Paso 5"; }

<div class="page-breadcrumb">
    <div class="row">
        <div class="col-12">
            <h4 class="page-title text-uppercase text-primary font-weight-bold mb-0">PASO 5 · <span class="text-dark">L3-@Model.PlanId</span></h4>
            <h2 class="font-weight-bold text-dark">Registro de Incidente L-5</h2>
            <div class="text-muted small">Reporte de daño, rotura o pérdida de equipos/utensilios.</div>
        </div>
    </div>
</div>

<div class="container-fluid mt-3">
    @await Html.PartialAsync("../LaboratoryOperations/_StepsBar", 5)

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-lg">
                <div class="card-body p-4">
                    <h6 class="font-weight-bold text-primary mb-1">FORMULARIO L-5</h6>

                    @if (!string.IsNullOrEmpty(Model.RelatedL3Name))
                    {
                        <div class="alert alert-info mt-2 mb-3">
                            <strong>Práctica:</strong> @Model.RelatedL3Name ·
                            <strong>Laboratorio:</strong> @Model.RelatedLabName
                        </div>
                    }

                    <form method="post">
                        <input type="hidden" asp-for="PlanId" />
                        <input type="hidden" asp-for="Incident.L3RequestId" />

                        @* ── EQUIPO AFECTADO (Solo los de esta práctica) ── *@
                        <div class="form-group">
                            <label class="small font-weight-bold text-muted">EQUIPO AFECTADO (De la Práctica Actual) <span class="text-danger">*</span></label>
                            <select asp-for="Incident.EquipmentUnitId" asp-items="Model.EquiposPrestadosList" class="form-control" required>
                                <option value="">Seleccione el utensilio dañado...</option>
                            </select>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label class="small font-weight-bold text-muted">TIPO DE INCIDENTE <span class="text-danger">*</span></label>
                                <select asp-for="Incident.IncidentType" class="form-control" required>
                                    <option value="">Seleccione...</option>
                                    <option value="Daño">Daño</option>
                                    <option value="Rotura">Rotura</option>
                                    <option value="Pérdida">Pérdida</option>
                                    <option value="Faltante">Faltante</option>
                                </select>
                            </div>
                            <div class="form-group col-md-6">
                                <label class="small font-weight-bold text-muted">CANTIDAD AFECTADA <span class="text-danger">*</span></label>
                                <input type="number" asp-for="Incident.AffectedQuantity" class="form-control" value="1" min="1" required />
                            </div>
                        </div>

                        @* ── INVOLUCRADO (Texto libre según Excel L-5) ── *@
                        <div class="form-row">
                            <div class="form-group col-md-4">
                                <label class="small font-weight-bold text-muted">TIPO INVOLUCRADO <span class="text-danger">*</span></label>
                                <select asp-for="Incident.ResponsibleType" class="form-control" required>
                                    <option value="ESTUDIANTE">ESTUDIANTE</option>
                                    <option value="DOCENTE">DOCENTE</option>
                                </select>
                            </div>
                            <div class="form-group col-md-8">
                                <label class="small font-weight-bold text-muted">NOMBRE DEL INVOLUCRADO <span class="text-danger">*</span></label>
                                <input type="text" asp-for="Incident.ResponsibleName" class="form-control" required
                                       placeholder="Ej: Juan Perez Mamani" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="small font-weight-bold text-muted">DESCRIPCIÓN DEL DAÑO <span class="text-danger">*</span></label>
                            <textarea asp-for="Incident.DamageDescription" class="form-control" rows="3" required
                                      placeholder="Describe cómo ocurrió el daño o pérdida..."></textarea>
                        </div>

                        <hr />
                        <div class="d-flex justify-content-between">
                            <a asp-page="/LaboratoryOperations/L3" asp-route-id="@Model.PlanId"
                               class="btn btn-outline-secondary px-4">
                                <i class="mdi mdi-arrow-left"></i> Volver al L-3
                            </a>
                            <button type="submit" class="btn btn-danger px-5 font-weight-bold">
                                <i class="mdi mdi-content-save"></i> Registrar Incidente L-5
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        @* ── PANEL LATERAL INFO ── *@
        <div class="col-md-4">
            <div class="card border-0 bg-light shadow-sm rounded-lg">
                <div class="card-body py-3 px-4">
                    <small class="text-muted font-weight-bold d-block mb-2">INFORMACIÓN DEL FORMULARIO</small>
                    <p class="small mb-1"><strong>Práctica:</strong> @(Model.RelatedL3Name ?? "—")</p>
                    <p class="small mb-1"><strong>Laboratorio:</strong> @(Model.RelatedLabName ?? "—")</p>
                    <p class="small mb-1"><strong>Código L3:</strong> L3-@Model.PlanId</p>
                    <hr />
                    <p class="small text-muted mb-0">
                        <i class="mdi mdi-information mr-1"></i>
                        Tras registrar el incidente serás devuelto al formulario L-3 de Devolución.
                        El botón "Finalizar L-3" se desbloqueará automáticamente.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
