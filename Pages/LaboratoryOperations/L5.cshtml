@page
@model Proyecto_Laboratorios_Univalle.Pages.LaboratoryOperations.L5Model
@using Proyecto_Laboratorios_Univalle.Helpers
@{
    ViewData["Title"] = "Incidente de material";
    ViewData["Section"] = "Planificación académica";
    var closureOnly = PracticeClosureAccess.IsClosureOnly(User);
}

<div class="container-fluid mt-3">
    <div class="mb-2">
        <a asp-page="/Cierre/Index" class="btn btn-outline-primary btn-rounded btn-sm font-weight-bold">
            <i class="mdi mdi-arrow-left mr-1"></i> Cierre del día
        </a>
    </div>
    @if (Model.Context != null)
    {
        <partial name="_PlanningContext" model="Model.Context" />

        <div class="row">
            @if (Model.Context.IsReadOnly)
            {
                <div class="col-lg-8">
                    <div class="alert alert-warning border-0 rounded d-flex align-items-center mb-4">
                        <i class="fas fa-eye fa-2x mr-3"></i>
                        <div>
                            <strong>Solo consulta.</strong><br />
                            <span>La gestión de esta planificación no admite el registro de incidentes de material.</span>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="col-lg-8">
                    <div class="card shadow-sm border-0 rounded-lg">
                        <div class="card-body p-4">
                            <h6 class="font-weight-bold text-danger mb-1">INCIDENTE DE MATERIAL</h6>
                            <p class="text-muted small mb-3">Reporta el incidente de un artículo entregado para la práctica (y, si corresponde, la unidad física concreta).</p>

                            <div class="alert alert-warning border-0 rounded-lg d-flex align-items-start mb-4">
                                <i class="fas fa-exclamation-triangle fa-2x mr-3 mt-1"></i>
                                <div class="small">
                                    Si indicas una unidad física, al guardar quedará marcada como averiada y se cerrará su estado anterior.
                                    El incidente queda asentado en el historial y pendiente de reposición; la cantidad cubierta se descuenta del faltante pendiente de devolución.
                                </div>
                            </div>

                            <form method="post" asp-route-planId="@Model.PlanId" id="form-l5">
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                                @* ── ARTÍCULO AFECTADO ── *@
                                <div class="form-group">
                                    <label asp-for="Input.ArticleId" class="small font-weight-bold text-muted">ARTÍCULO AFECTADO <span class="text-danger">*</span></label>
                                    <select asp-for="Input.ArticleId" asp-items="Model.ArticleOptions" class="form-control select2">
                                        <option value="0">— Seleccionar artículo entregado —</option>
                                    </select>
                                    <span asp-validation-for="Input.ArticleId" class="text-danger small"></span>
                                </div>

                                @* ── UNIDAD FÍSICA (OPCIONAL) ── *@
                                <div class="form-group">
                                    <label asp-for="Input.EquipmentUnitId" class="small font-weight-bold text-muted">UNIDAD FÍSICA <span class="text-muted small font-weight-normal">(opcional)</span></label>
                                    <select asp-for="Input.EquipmentUnitId" asp-items="Model.UnitOptions" class="form-control select2">
                                        <option value="">— Sin unidad física —</option>
                                    </select>
                                    <span asp-validation-for="Input.EquipmentUnitId" class="text-danger small"></span>
                                </div>

                                <div class="form-row">
                                    @* ── TIPO DE INCIDENTE ── *@
                                    <div class="form-group col-md-6">
                                        <label asp-for="Input.IncidentType" class="small font-weight-bold text-muted">TIPO DE INCIDENTE <span class="text-danger">*</span></label>
                                        <select asp-for="Input.IncidentType" class="form-control select2">
                                            @foreach (var t in L5Model.IncidentTypes)
                                            {
                                                <option value="@t">@t</option>
                                            }
                                        </select>
                                        <span asp-validation-for="Input.IncidentType" class="text-danger small"></span>
                                    </div>

                                    @* ── CANTIDAD AFECTADA ── *@
                                    <div class="form-group col-md-6">
                                        <label asp-for="Input.AffectedQuantity" class="small font-weight-bold text-muted">CANTIDAD AFECTADA <span class="text-danger">*</span></label>
                                        <input asp-for="Input.AffectedQuantity" type="number" class="form-control" min="1" max="999" />
                                        <span asp-validation-for="Input.AffectedQuantity" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="form-row">
                                    @* ── TIPO INVOLUCRADO ── *@
                                    <div class="form-group col-md-4">
                                        <label asp-for="Input.ResponsibleType" class="small font-weight-bold text-muted">TIPO DE INVOLUCRADO <span class="text-danger">*</span></label>
                                        <select asp-for="Input.ResponsibleType" class="form-control select2">
                                            @foreach (var t in L5Model.ResponsibleTypes)
                                            {
                                                <option value="@t">@t</option>
                                            }
                                        </select>
                                        <span asp-validation-for="Input.ResponsibleType" class="text-danger small"></span>
                                    </div>

                                    @* ── NOMBRE DEL INVOLUCRADO ── *@
                                    <div class="form-group col-md-8">
                                        <label asp-for="Input.ResponsibleName" class="small font-weight-bold text-muted">NOMBRE DEL INVOLUCRADO <span class="text-danger">*</span></label>
                                        <input asp-for="Input.ResponsibleName" class="form-control" placeholder="Ej: Juan Pérez Mamani" maxlength="200" />
                                        <span asp-validation-for="Input.ResponsibleName" class="text-danger small"></span>
                                    </div>
                                </div>

                                @* ── DESCRIPCIÓN DEL DAÑO ── *@
                                <div class="form-group">
                                    <label asp-for="Input.DamageDescription" class="small font-weight-bold text-muted">DESCRIPCIÓN DEL DAÑO <span class="text-danger">*</span></label>
                                    <textarea asp-for="Input.DamageDescription" class="form-control" rows="4" maxlength="2000"
                                              placeholder="Describe cómo ocurrió el daño, rotura o pérdida, y cualquier antecedente relevante."></textarea>
                                    <span asp-validation-for="Input.DamageDescription" class="text-danger small"></span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                                    <a asp-page="./L3" asp-route-id="@Model.PlanId" class="btn btn-outline-secondary btn-rounded px-4">
                                        <i class="mdi mdi-arrow-left mr-1"></i> Volver
                                    </a>
                                    <button type="submit" class="btn btn-danger btn-rounded font-weight-bold px-5 js-l5-confirm">
                                        <i class="mdi mdi-content-save mr-1"></i> Registrar incidente
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }

            @* ── PANEL LATERAL: TRAZABILIDAD ── *@
            <div class="col-lg-4 mt-4 mt-lg-0">
                <div class="card border-0 bg-light shadow-sm rounded-lg h-100">
                    <div class="card-body p-4">
                        <small class="text-uppercase text-danger font-weight-bold d-block mb-2">Trazabilidad</small>
                        <h5 class="font-weight-bold mt-1 mb-3">@Model.Code</h5>

                        <p class="small mb-1"><strong>Laboratorio:</strong> @(Model.Plan?.Laboratory?.Name ?? "—")</p>
                        <p class="small mb-1"><strong>Materia:</strong> @(Model.Plan?.Subject?.Name ?? "—")</p>
                        <p class="small mb-3"><strong>Fecha planificada:</strong> @(Model.Plan?.ScheduledDate.ToString("dd/MM/yyyy HH:mm") ?? "—")</p>

                        @if (!Model.Context.IsReadOnly)
                        {
                            <hr />

                            <p class="small text-muted mb-0">
                                <i class="fas fa-info-circle text-primary mr-1"></i>
                                Al guardar el incidente volverás a la entrega y devolución de material. La cantidad cubierta por el incidente se descontará automáticamente del faltante pendiente.
                            </p>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Styles {
    <link href="~/assets/libs/select2/dist/css/select2.min.css" rel="stylesheet">
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/libs/select2/dist/js/select2.full.min.js"></script><script src="~/js/select2-es.js" asp-append-version="true"></script>
    <script>
        (function () {
            $('.select2').select2({
                width: '100%',
                language: { noResults: function () { return 'Sin coincidencias'; } }
            });

            var form = document.getElementById('form-l5');
            if (!form) return;
            form.addEventListener('submit', function (e) {
                if (form.dataset.confirmed === '1') return true;
                e.preventDefault();
                if (typeof Swal === 'undefined') {
                    form.dataset.confirmed = '1';
                    HTMLFormElement.prototype.submit.call(form);
                    return;
                }
                Swal.fire({
                    title: '¿Registrar el incidente?',
                    text: 'Se asentará en el historial y quedará pendiente de reposición. Si indicaste una unidad física, se marcará como averiada.',
                    type: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Sí, registrar',
                    cancelButtonText: 'Cancelar'
                }).then(function (result) {
                    if (result && (result.isConfirmed === true || result.value === true)) {
                        form.dataset.confirmed = '1';
                        HTMLFormElement.prototype.submit.call(form);
                    }
                });
            });
        })();
    </script>
}