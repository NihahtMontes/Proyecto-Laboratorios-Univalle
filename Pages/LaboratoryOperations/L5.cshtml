@page
@model Proyecto_Laboratorios_Univalle.Pages.LaboratoryOperations.L5Model
@{ ViewData["Title"] = "Incidencia L-5"; }

<div class="page-breadcrumb"><div class="row"><div class="col-12"><h4 class="page-title text-uppercase text-primary font-weight-bold mb-0">PASO 5 · @Model.Plan?.Code</h4><h2 class="font-weight-bold text-dark">Registro de incidencia L-5</h2><div class="text-muted small">Documenta un faltante o daño detectado durante la devolución.</div></div></div></div>

<div class="container-fluid mt-3">
    @await Html.PartialAsync("../LaboratoryOperations/_StepsBar", 5)
    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-lg"><div class="card-body p-4">
                <form method="post" asp-page-handler="Save" asp-route-id="@Model.Id">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <div class="form-row">
                        <div class="form-group col-md-6"><label asp-for="Input.Type" class="small font-weight-bold text-muted">Tipo de novedad</label><select asp-for="Input.Type" class="custom-select"><option>Daño</option><option>Faltante</option><option>Contaminación</option><option>Otra novedad</option></select><span asp-validation-for="Input.Type" class="text-danger small"></span></div>
                        <div class="form-group col-md-6"><label asp-for="Input.AffectedItem" class="small font-weight-bold text-muted">Ítem afectado</label><select asp-for="Input.AffectedItem" class="custom-select"><option value="">— Seleccionar —</option>@foreach (var item in Model.Plan?.Requirements ?? []) { <option value="@item.Name">@item.Name</option> }</select><span asp-validation-for="Input.AffectedItem" class="text-danger small"></span></div>
                    </div>
                    <div class="form-group"><label asp-for="Input.Quantity" class="small font-weight-bold text-muted">Cantidad afectada</label><input asp-for="Input.Quantity" class="form-control" min="1" /><span asp-validation-for="Input.Quantity" class="text-danger small"></span></div>
                    <div class="form-group"><label asp-for="Input.Observations" class="small font-weight-bold text-muted">Observaciones</label><textarea asp-for="Input.Observations" class="form-control" rows="4" placeholder="Describe qué ocurrió y qué decisión queda pendiente."></textarea><span asp-validation-for="Input.Observations" class="text-danger small"></span></div>
                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top"><a asp-page="./L3" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-rounded px-4"><i class="mdi mdi-arrow-left mr-1"></i> Volver a L-3</a><button type="submit" class="btn btn-danger btn-rounded font-weight-bold px-4"><i class="fas fa-file-medical-alt mr-1"></i> Guardar incidencia</button></div>
                </form>
            </div></div>
        </div>
        <div class="col-lg-4 mt-4 mt-lg-0"><div class="card border-0 shadow-sm rounded-lg h-100"><div class="card-body p-4"><span class="text-uppercase small text-danger font-weight-bold">Trazabilidad</span><h5 class="font-weight-bold mt-2">@Model.Plan?.Code</h5><p class="text-muted small">La incidencia queda asociada a la planificación actual de la sesión. En el modelo definitivo se vinculará al documento L-3 persistente.</p><div class="alert alert-warning small mb-0"><i class="fas fa-exclamation-triangle mr-1"></i> Este MVP no genera todavía PDF ni escribe una tabla L-5.</div></div></div></div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
