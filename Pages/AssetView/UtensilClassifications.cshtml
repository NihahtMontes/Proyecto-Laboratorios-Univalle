@page
@model Proyecto_Laboratorios_Univalle.Pages.AssetView.UtensilClassificationsModel

@{
    ViewData["Title"] = "Clasificacion de Utensilios";
}

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="d-md-flex align-items-center mb-4 pb-3 border-bottom">
                    <div>
                        <h3 class="card-title text-dark font-weight-bold mt-2 ml-2">Utensilios</h3>
                        <h6 class="card-subtitle text-muted ml-2">Seleccione una subclasificacion para ver las unidades fisicas vigentes.</h6>
                    </div>
                    <div class="ml-auto mt-3 mt-md-0">
                        <a asp-page="./Index" asp-route-activeTab="Inventario" class="btn btn-outline-secondary btn-rounded px-4 font-weight-bold">
                            <i class="fas fa-arrow-left mr-1"></i> Volver
                        </a>
                    </div>
                </div>

                <div class="row">
                    @foreach (var card in Model.Cards)
                    {
                        <div class="col-xl-3 col-md-4 col-sm-6 mb-3">
                            <a asp-page="./UtensilUnits" asp-route-utensilType="@card.UtensilType" class="text-decoration-none">
                                <div class="card text-white @card.ColorClass shadow-sm border-0 h-100">
                                    <div class="card-header bg-transparent border-0">
                                        <h5 class="m-b-0 text-white">@card.Title</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="d-flex align-items-center">
                                            <div class="mr-3">
                                                <i class="@card.IconClass fa-2x"></i>
                                            </div>
                                            <div>
                                                <h2 class="card-title text-white font-weight-bold mb-0">@card.Count</h2>
                                                <p class="card-text mb-0">Unidades vigentes</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
