                                        </div>
                                        <ul class="inicio-donut-legend" data-indicadores-legend="category"></ul>
                                    </div>
                                </div>
                                <div class="col-xl-4 col-lg-6 col-12 mb-4">
                                    <div class="asset-chart-panel p-4 h-100">
                                        <div class="asset-chart-header">
                                            <h4 class="card-title mb-1" data-indicadores-title="status"></h4>
                                            <small class="text-muted" data-indicadores-conclusion="status"></small>
                                        </div>
