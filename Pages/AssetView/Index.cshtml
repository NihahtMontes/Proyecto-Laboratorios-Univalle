@section Scripts {
    <!-- Chart.js 3.9.1 (misma URL de CDN que Managements/Details) -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
    <script>
        $(function () {
            'use strict';

            var indicadoresUrl = '@Url.Page("/AssetView/Index", "Indicadores")';
            var chartsBuilt = false;
            var activeCharts = [];

            var donutPalette = ['#1e88e5', '#00c292', '#ffb22b', '#7460ee', '#03a9f3', '#95a5a6'];
            var statusPalette = ['#00c292', '#1e88e5', '#ffb22b', '#f62d51', '#7460ee', '#03a9f3', '#95a5a6'];
            var barColors = {
                equipment: '#1e88e5',
                utensil: '#00c292',
                other: '#ffb22b',
                condition: '#7460ee',
                environment: '#03a9f3'
            };

            function escapeHtml(text) {
                return $('<div>').text(text == null ? '' : String(text)).html();
            }

            // Escribe el valor al final de cada barra (plugin local, sin librerías extra).
            var valueLabelsPlugin = {
                id: 'inicioValueLabels',
                afterDatasetsDraw: function (chart) {
                    var ctx = chart.ctx;
                    ctx.save();
                    ctx.font = '600 11px "Segoe UI", Arial, sans-serif';
                    ctx.fillStyle = '#475569';
                    ctx.textAlign = 'left';
                    ctx.textBaseline = 'middle';
                    chart.getDatasetMeta(0).data.forEach(function (element, index) {
                        var value = chart.data.datasets[0].data[index];
                        if (value !== null && value !== undefined) {
                            ctx.fillText(String(value), element.x + 6, element.y);
                        }
                    });
                    ctx.restore();
                }
            };

            // Total al centro de las donas.
            var centerTotalPlugin = {
                id: 'inicioCenterTotal',
                afterDraw: function (chart) {
                    var opts = chart.options.plugins.inicioCenterTotal;
                    if (!opts || !opts.display) return;
                    var arc = chart.getDatasetMeta(0).data[0];
                    if (!arc) return;
                    var ctx = chart.ctx;
                    ctx.save();
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';
                    ctx.font = '700 22px "Segoe UI", Arial, sans-serif';
                    ctx.fillStyle = '#1f2937';
                    ctx.fillText(opts.total, arc.x, arc.y - 9);
                    ctx.font = '500 11px "Segoe UI", Arial, sans-serif';
                    ctx.fillStyle = '#64748b';
                    ctx.fillText(opts.label, arc.x, arc.y + 12);
                    ctx.restore();
                }
            };

            function showEmptyBox(box, icon) {
                box.css('min-height', '220px');
                box.html(
                    '<div class="inicio-empty-inline"><div>' +
                    '<i class="' + icon + ' fa-2x mb-2 d-block" style="color:#b8c2d6;"></i>' +
                    '<strong>Sin datos todavía</strong>' +
                    '<div class="small text-muted mt-1">Cuando existan registros, el gráfico aparecerá aquí.</div>' +
                    '</div></div>');
            }

            function renderBar(chart, color) {
                var box = $('[data-indicadores-box="' + chart.key + '"]');
                var canvas = document.getElementById('indicadores-chart-' + chart.key);
                if (!canvas || !chart.items || chart.items.length === 0) {
                    showEmptyBox(box, 'fas fa-chart-bar');
                    return;
                }

                var labels = chart.items.map(function (item) { return item.label; });
                var values = chart.items.map(function (item) { return item.value; });
                var maxValue = Math.max.apply(null, values);
                box.css('min-height', Math.max(220, chart.items.length * 36 + 30) + 'px');

                activeCharts.push(new Chart(canvas.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            data: values,
                            backgroundColor: color,
                            borderRadius: 4,
                            barThickness: 18
                        }]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        maintainAspectRatio: false,
                        layout: { padding: { right: 56 } },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function (context) {
                                        return context.parsed.x + ' unidades';
                                    }
                                }
                            }
                        },
                        scales: {
                            x: { display: false, beginAtZero: true, suggestedMax: maxValue * 1.12 },
                            y: {
                                grid: { display: false },
                                border: { display: false },
                                ticks: { color: '#475569', font: { size: 11 }, autoSkip: false }
                            }
                        }
                    },
                    plugins: [valueLabelsPlugin]
                }));
            }

            function renderDonut(chart, palette) {
                var box = $('[data-indicadores-box="' + chart.key + '"]');
                var canvas = document.getElementById('indicadores-chart-' + chart.key);
                var legend = $('[data-indicadores-legend="' + chart.key + '"]');
                if (!canvas || !chart.items || chart.items.length === 0) {
                    showEmptyBox(box, 'fas fa-chart-pie');
                    if (legend) legend.empty();
                    return;
                }

                var labels = chart.items.map(function (item) { return item.label; });
                var values = chart.items.map(function (item) { return item.value; });
                var total = chart.total || values.reduce(function (sum, value) { return sum + value; }, 0);
                var colors = palette.slice(0, values.length);

                activeCharts.push(new Chart(canvas.getContext('2d'), {
                    type: 'doughnut',
                    data: {
                        labels: labels,
                        datasets: [{
                            data: values,
                            backgroundColor: colors,
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '68%',
                        plugins: {
                            legend: { display: false },
                            inicioCenterTotal: { display: true, total: String(total), label: 'unidades' },
                            tooltip: {
                                callbacks: {
                                    label: function (context) {
                                        var value = context.parsed;
                                        var pct = total > 0 ? Math.round(value * 100 / total) : 0;
                                        return ' ' + value + ' unidades (' + pct + ' %)';
                                    }
                                }
                            }
                        }
                    },
                    plugins: [centerTotalPlugin]
                }));

                if (legend) {
                    legend.html(chart.items.map(function (item, index) {
                        var pct = total > 0 ? Math.round(item.value * 100 / total) : 0;
                        return '<li><span class="inicio-legend-dot" style="background:' + colors[index] + ';"></span>' +
                            escapeHtml(item.label) + ' · ' + item.value + ' (' + pct + ' %)</li>';
                    }).join(''));
                }
            }

            function renderAll(data) {
                if (typeof Chart === 'undefined') {
                    throw new Error('Chart.js no está disponible');
                }

                var meta = $('#indicadores-meta');
                if (meta && data.totalUnits !== undefined) {
                    meta.html('<i class="fas fa-database mr-1"></i> Unidades vigentes: <strong>' +
                        escapeHtml(data.totalUnits) + '</strong> · actualizado a las ' + escapeHtml(data.generatedAt));
                }

                (data.charts || []).forEach(function (chart) {
                    $('[data-indicadores-title="' + chart.key + '"]').text(chart.title);
                    $('[data-indicadores-conclusion="' + chart.key + '"]').text(chart.conclusion);
                    if (chart.type === 'donut') {
                        renderDonut(chart, chart.key === 'status' ? statusPalette : donutPalette);
                    } else {
                        renderBar(chart, barColors[chart.key] || '#1e88e5');
                    }
                });
            }

            function loadIndicadores() {
                if (chartsBuilt) return;

                var loading = $('#indicadores-loading');
                var error = $('#indicadores-error');
                var content = $('#indicadores-content');
                loading.removeClass('d-none');
                error.addClass('d-none');
                content.addClass('d-none');

                fetch(indicadoresUrl, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (response) {
                        if (!response.ok) throw new Error('HTTP ' + response.status);
                        return response.json();
                    })
                    .then(function (data) {
                        renderAll(data);
                        loading.addClass('d-none');
                        content.removeClass('d-none');
                        chartsBuilt = true;
                    })
                    .catch(function (err) {
                        // Se reporta en consola y se ofrece reintento: no es un error silencioso.
                        console.error('No se pudieron cargar los indicadores:', err);
                        loading.addClass('d-none');
                        error.removeClass('d-none');
                    });
            }

            $('#indicadores-retry').on('click', loadIndicadores);

            $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
                if ($(e.target).attr('href') === '#indicadores') {
                    loadIndicadores();
                }
                activeCharts.forEach(function (chart) { chart.resize(); });
            });

            @if (Model.ShowIndicatorsTab)
            {
                <text>loadIndicadores();</text>
            }
        });
    </script>
}
