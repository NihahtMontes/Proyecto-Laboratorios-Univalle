@page
@model Proyecto_Laboratorios_Univalle.Pages.AssetView.IndexModel
@using System.Globalization
@{
    ViewData["Title"] = "Inicio";
    // /EquipmentUnits, /Catalogs/Stock y /Catalogs/Articles son solo para Administrator/SuperAdmin.
    var canOpenAdminLists = User.IsInRole("Administrator") || User.IsInRole("SuperAdmin");
    var esBo = CultureInfo.GetCultureInfo("es-BO");

    var weekPanel = Model.WeekPanel;
    var weekTotal = weekPanel?.Days.Sum(d => d.Practices.Count) ?? 0;
    var feedItemsByGroup = Model.FeedItems.GroupBy(i => i.Group).ToDictionary(g => g.Key, g => g.ToList());
    var visibleFeedItems = feedItemsByGroup.Sum(g => g.Value.Count);
    var pendientesTotal = Model.FeedActionableCount + Model.PendingTeacherRequests + Model.CorrectivePendingRequests;
    // Primeros avisos accionables para la vista previa del Resumen.
    var peekItems = Model.FeedItems
        .Where(i => !string.Equals(i.Group, "revisar-datos", StringComparison.Ordinal))
        .Take(2)
        .ToList();

    // Pestañas: el servidor renderiza la activa (sin parpadeo) y panel-tabs.js toma el control después.
    var active = Model.ActivePanel;
    string TabSelected(string key) => active == key ? "true" : "false";
    string TabIndex(string key) => active == key ? "0" : "-1";
    string? PanelHidden(string key) => active == key ? null : "hidden";

    // Barras del Resumen: alturas relativas al máximo de cada serie (0–100 %).
    var maxPerDay = weekPanel?.Days.Max(d => d.Practices.Count) ?? 0;
    var weeklySeries = Model.WeeklySeries;
    var maxPerWeek = weeklySeries.Count == 0 ? 0 : weeklySeries.Max(p => p.Count);
    var currentWeekCount = weeklySeries.FirstOrDefault(p => p.IsCurrent)?.Count;
    int BarHeight(int count, int max) => max <= 0 ? 0 : (int)Math.Round(count * 100.0 / max);

    // Anillo de avance del preventivo (ph-ring, base panel-home.css).
    var preventivePercent = Model.PreventivePlannedUnits == 0 ? 0
        : (int)Math.Round(Model.PreventiveCompletedUnits * 100m / Model.PreventivePlannedUnits);

    // Clave estable del aviso para sincronizar la bandeja con la vista previa del Resumen.
    static string FeedKey(string? syntheticKey, int id) => string.IsNullOrEmpty(syntheticKey) ? "n:" + id : "s:" + syntheticKey;
}

@section Styles {
    <link href="~/css/panel-home.css" rel="stylesheet" asp-append-version="true">
    <link href="~/css/inicio-panel.css" rel="stylesheet" asp-append-version="true">
}

<div class="ip-panel ph-home">
    <script type="application/json" id="ip-data">@Html.Raw(Model.PanelDataJson)</script>

    @* ══════════════════════════ Cabecera ══════════════════════════ *@
    <header class="ip-header">
        <div>
            <h2 class="ip-header__title">@Model.Greeting, @Model.UserDisplayName</h2>
            <div class="ip-header__meta">
                <span><i class="far fa-calendar mr-1" aria-hidden="true"></i>@Model.TodayText</span>
                @if (Model.HasPreventive && !string.IsNullOrEmpty(Model.PreventiveCode))
                {
                    <span class="ip-chip"><span class="ip-chip__dot ip-chip__dot--green" aria-hidden="true"></span>Preventivo @Model.PreventiveCode</span>
                }
                @if (Model.HasCorrective && !string.IsNullOrEmpty(Model.CorrectiveCode))
                {
                    <span class="ip-chip"><span class="ip-chip__dot ip-chip__dot--amber" aria-hidden="true"></span>Correctivo @Model.CorrectiveCode</span>
                }
            </div>
        </div>
        <div class="ip-header__actions">
            <a asp-page="/Requests/Index" asp-page-handler="NewRequest" class="ip-btn-primary">
                <i class="fas fa-bolt" aria-hidden="true"></i> Reportar una falla
            </a>
            <a asp-page="/Reports/Index" class="ip-btn-secondary">
                <i class="fas fa-file-alt" aria-hidden="true"></i> Reportes
            </a>
        </div>
    </header>

    @* ══════════════════════════ Indicadores ══════════════════════════ *@
    <section class="ph-kpis" aria-label="Indicadores del día">
        @if (Model.IsAdminMenu)
        {
            <a class="ph-kpi ph-tone-blue" asp-page="/Managements/Index" asp-page-handler="CurrentPreventive" title="Abrir el panel de la gestión preventiva activa">
                @if (Model.HasPreventive)
                {
                    <span class="ph-ring" style="--ph-value:@preventivePercent" role="img" aria-label="Avance del preventivo: @preventivePercent por ciento"><span>@preventivePercent %</span></span>
                }
                else
                {
                    <span class="ph-kpi__icon"><i class="fas fa-shield-alt" aria-hidden="true"></i></span>
                }
                <span class="ph-kpi__body">
                    <span class="ph-kpi__label">Avance del preventivo</span>
                    @if (Model.HasPreventive)
                    {
                        <span class="ph-kpi__detail">@Model.PreventiveCompletedUnits de @Model.PreventivePlannedUnits equipos</span>
                    }
                    else
                    {
                        <span class="ph-kpi__value">—</span>
                        <span class="ph-kpi__detail">Sin gestión activa</span>
                    }
                </span>
            </a>
        }
        <a class="ph-kpi ph-tone-green" data-ph-tab="semana" href="?activeTab=semana" title="Ver las prácticas de la semana">
            <span class="ph-kpi__icon"><i class="far fa-calendar-check" aria-hidden="true"></i></span>
            <span class="ph-kpi__body">
                <span class="ph-kpi__label">Prácticas de hoy</span>
                @if (weekPanel != null)
                {
                    <span class="ph-kpi__value">@weekPanel.TodayCount</span>
                    <span class="ph-kpi__detail">@weekTotal esta semana</span>
                }
                else
                {
                    <span class="ph-kpi__value">—</span>
                    <span class="ph-kpi__detail">Sin datos ahora</span>
                }
            </span>
        </a>
        <a class="ph-kpi ph-tone-amber" data-ph-tab="bandeja" href="?activeTab=bandeja" title="Ir a la bandeja de pendientes">
            <span class="ph-kpi__icon"><i class="fas fa-bell" aria-hidden="true"></i></span>
            <span class="ph-kpi__body">
                <span class="ph-kpi__label">Pendientes por atender</span>
                <span class="ph-kpi__value" id="ip-kpi-pendientes">@pendientesTotal</span>
                <span class="ph-kpi__detail">@Model.FeedActionableCount avisos · @Model.PendingTeacherRequests solicitudes de docentes · @Model.CorrectivePendingRequests servicio técnico</span>
            </span>
        </a>
        <a class="ph-kpi ph-tone-cyan" data-ph-tab="inventario" href="?activeTab=inventario" title="Ir al inventario">
            <span class="ph-kpi__icon"><i class="fas fa-boxes" aria-hidden="true"></i></span>
            <span class="ph-kpi__body">
                <span class="ph-kpi__label">Inventario</span>
                <span class="ph-kpi__value">@Model.TotalUnitsCount</span>
                <span class="ph-kpi__detail">
                    unidades vigentes
                    <span class="ph-meter" aria-hidden="true"><span style="width:@Model.ClassificationQualityPercent%;"></span></span>
                    Calidad de clasificación @Model.ClassificationQualityPercent %
                </span>
            </span>
        </a>
    </section>

    @* ══════════════════════════ Pestañas ══════════════════════════ *@
    <div class="ph-tabs" role="tablist" aria-label="Secciones del inicio" data-ph-param="activeTab">
        <a class="ph-tab" role="tab" id="ph-tab-resumen" data-ph-key="resumen" href="?activeTab=resumen"
           aria-selected="@TabSelected("resumen")" tabindex="@TabIndex("resumen")">
            <i class="fas fa-th-large" aria-hidden="true"></i> Resumen
        </a>
        <a class="ph-tab" role="tab" id="ph-tab-semana" data-ph-key="semana" href="?activeTab=semana"
           aria-selected="@TabSelected("semana")" tabindex="@TabIndex("semana")">
            <i class="far fa-calendar-check" aria-hidden="true"></i> Prácticas <span class="ph-tab__count">@weekTotal</span>
        </a>
        <a class="ph-tab" role="tab" id="ph-tab-bandeja" data-ph-key="bandeja" href="?activeTab=bandeja"
           aria-selected="@TabSelected("bandeja")" tabindex="@TabIndex("bandeja")">
            <i class="fas fa-inbox" aria-hidden="true"></i> Bandeja
            <span class="ph-tab__count @(Model.FeedActionableCount > 0 ? "ph-tab__count--alert" : null)" id="ip-tab-bandeja-count">@Model.FeedActionableCount</span>
        </a>
        <a class="ph-tab" role="tab" id="ph-tab-graficos" data-ph-key="graficos" data-ph-alias="indicadores" href="?activeTab=graficos"
           aria-selected="@TabSelected("graficos")" tabindex="@TabIndex("graficos")">
            <i class="fas fa-chart-bar" aria-hidden="true"></i> Gráficos
        </a>
        <a class="ph-tab" role="tab" id="ph-tab-inventario" data-ph-key="inventario" href="?activeTab=inventario"
           aria-selected="@TabSelected("inventario")" tabindex="@TabIndex("inventario")">
            <i class="fas fa-boxes" aria-hidden="true"></i> Inventario
        </a>
    </div>

    @* ══════════════════════════ Panel: Resumen ══════════════════════════ *@
    <div class="ph-panel" role="tabpanel" data-ph-key="resumen" aria-labelledby="ph-tab-resumen" @PanelHidden("resumen")>
        <div class="ph-sections">
            <a class="ph-section ph-tone-green" data-ph-tab="semana" href="?activeTab=semana">
                <span class="ph-section__head">
                    <span class="ph-section__icon"><i class="far fa-calendar-check" aria-hidden="true"></i></span>
                    <span class="ph-section__heading">
                        <span class="ph-section__title">Prácticas de la semana</span>
                        <span class="ph-section__desc">@(weekPanel != null
                            ? $"Del {weekPanel.Monday.ToString("dd MMM", esBo)} al {weekPanel.Saturday.ToString("dd MMM", esBo)}"
                            : "Lunes a sábado")</span>
                    </span>
                    <span class="ph-section__count">@weekTotal</span>
                </span>
                <span class="ph-section__preview">
                    @if (weekPanel != null)
                    {
                        <span class="ph-days">
                            @foreach (var day in weekPanel.Days)
                            {
                                <span class="ph-days__item @(day.IsToday ? "is-current" : null)" style="--ph-h:@BarHeight(day.Practices.Count, maxPerDay)%">
                                    <span class="ph-days__value">@day.Practices.Count</span>
                                    <span class="ph-days__track"><span class="ph-days__bar"></span></span>
                                    <span class="ph-days__label">@day.DayName.Substring(0, 3)</span>
                                </span>
                            }
                        </span>
                    }
                    else
                    {
                        <span class="ip-note">
                            <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
                            <span>No se pudo cargar la semana en este momento.</span>
                        </span>
                    }
                </span>
                <span class="ph-section__cta">Ver prácticas <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
            </a>

            <a class="ph-section ph-tone-amber" data-ph-tab="bandeja" href="?activeTab=bandeja">
                <span class="ph-section__head">
                    <span class="ph-section__icon"><i class="fas fa-bell" aria-hidden="true"></i></span>
                    <span class="ph-section__heading">
                        <span class="ph-section__title">Bandeja de pendientes</span>
                        <span class="ph-section__desc">Vencidos, de hoy y próximos</span>
                    </span>
                    <span class="ph-section__count" id="ip-resumen-bandeja-count">@Model.FeedActionableCount</span>
                </span>
                <span class="ph-section__preview">
                    <span class="ph-section__desc ip-section__line"><span id="ip-resumen-bandeja-total">@Model.FeedActionableCount</span> por atender</span>
                    @if (peekItems.Count > 0)
                    {
                        <ul class="ph-peek" id="ip-resumen-peek">
                            @foreach (var item in peekItems)
                            {
                                <li data-feed-key="@FeedKey(item.SyntheticKey, item.Id)"><span>@item.Title</span></li>
                            }
                        </ul>
                    }
                    <span class="ph-section__desc ip-section__line" id="ip-resumen-peek-empty" hidden="@(peekItems.Count > 0 ? "hidden" : null)">Todo al día</span>
                </span>
                <span class="ph-section__cta">Ver bandeja <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
            </a>

            <a class="ph-section ph-tone-blue" data-ph-tab="graficos" href="?activeTab=graficos">
                <span class="ph-section__head">
                    <span class="ph-section__icon"><i class="fas fa-chart-bar" aria-hidden="true"></i></span>
                    <span class="ph-section__heading">
                        <span class="ph-section__title">Gráficos</span>
                        <span class="ph-section__desc">Prácticas por semana y composición del inventario</span>
                    </span>
                    <span class="ph-section__count">@(currentWeekCount?.ToString() ?? "—")</span>
                </span>
                <span class="ph-section__preview">
                    @if (weeklySeries.Count > 0)
                    {
                        <span class="ph-days">
                            @foreach (var point in weeklySeries)
                            {
                                <span class="ph-days__item @(point.IsCurrent ? "is-current" : null)" style="--ph-h:@BarHeight(point.Count, maxPerWeek)%">
                                    <span class="ph-days__value">@point.Count</span>
                                    <span class="ph-days__track"><span class="ph-days__bar"></span></span>
                                    <span class="ph-days__label">@point.Start.ToString("dd/MM", esBo)</span>
                                </span>
                            }
                        </span>
                    }
                    else
                    {
                        <span class="ip-note">
                            <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
                            <span>No se pudo cargar la serie semanal en este momento.</span>
                        </span>
                    }
                </span>
                <span class="ph-section__cta">Ver gráficos <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
            </a>

            <a class="ph-section ph-tone-cyan" data-ph-tab="inventario" href="?activeTab=inventario">
                <span class="ph-section__head">
                    <span class="ph-section__icon"><i class="fas fa-boxes" aria-hidden="true"></i></span>
                    <span class="ph-section__heading">
                        <span class="ph-section__title">Inventario</span>
                        <span class="ph-section__desc">Unidades vigentes del laboratorio</span>
                    </span>
                    <span class="ph-section__count">@Model.TotalUnitsCount</span>
                </span>
                <span class="ph-section__preview">
                    <span class="ph-section__desc ip-section__line">@Model.EquipmentUnitsCount equipos · @Model.UtensilUnitsCount utensilios · @Model.EnvironmentsCount ambientes</span>
                    <span class="ph-meter" role="img" aria-label="Calidad de clasificación: @Model.ClassificationQualityPercent por ciento">
                        <span style="width:@Model.ClassificationQualityPercent%;"></span>
                    </span>
                    <span class="ph-section__desc ip-section__line">Calidad de clasificación @Model.ClassificationQualityPercent %</span>
                </span>
                <span class="ph-section__cta">Ver inventario <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
            </a>
        </div>
    </div>

    @* ══════════════════════════ Panel: Prácticas (semana) ══════════════════════════ *@
    <div class="ph-panel" role="tabpanel" data-ph-key="semana" aria-labelledby="ph-tab-semana" @PanelHidden("semana")>
        <article class="ip-card" aria-labelledby="ip-semana-title">
            <div class="ip-card__head">
                <h3 class="ip-card__title" id="ip-semana-title">Prácticas de esta semana</h3>
                @if (weekPanel != null)
                {
                    <span class="ip-card__hint">
                        Del @weekPanel.Monday.ToString("dd MMM", esBo) al @weekPanel.Saturday.ToString("dd MMM", esBo) · @weekTotal práctica(s)
                    </span>
                }
            </div>
            <div class="ip-card__body ip-weekwrap">
                @if (weekPanel == null)
                {
                    <div class="ip-note">
                        <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
                        <span>No se pudo cargar la semana en este momento.</span>
                    </div>
                }
                else if (weekTotal == 0)
                {
                    <div class="ip-empty">
                        <i class="far fa-calendar" aria-hidden="true"></i>
                        <strong>Sin prácticas esta semana</strong>
                        <div>Cuando se aprueben solicitudes, aparecerán aquí agrupadas por día.</div>
                    </div>
                }
                else
                {
                    <table class="ip-table">
                        <caption class="sr-only">Prácticas de la semana del @weekPanel.Monday.ToString("dd/MM/yyyy", esBo) al @weekPanel.Saturday.ToString("dd/MM/yyyy", esBo), agrupadas por día.</caption>
                        <thead>
                            <tr>
                                <th scope="col">Hora</th>
                                <th scope="col">Práctica</th>
                                <th scope="col">Materia · grupo</th>
                                <th scope="col">Laboratorio</th>
                                <th scope="col">Docente</th>
                                <th scope="col">Estado</th>
                            </tr>
                        </thead>
                        @foreach (var day in weekPanel.Days)
                        {
                            <tbody class="ip-day ip-day--@day.Weekday @(day.IsToday ? "ip-day--today" : string.Empty)" id="ip-day-@day.Weekday">
                                <tr class="ip-day__head">
                                    <th colspan="6" scope="colgroup">
                                        <button type="button" class="ip-day__toggle" aria-expanded="@(day.IsPast ? "false" : "true")" aria-controls="ip-day-@day.Weekday">
                                            <span class="ip-day__name">@day.HeaderText</span>
                                            <span class="ip-day__count">@day.Practices.Count</span>
                                            <i class="fas fa-chevron-down ip-day__chevron" aria-hidden="true"></i>
                                        </button>
                                    </th>
                                </tr>
                                @foreach (var practice in day.Practices)
                                {
                                    <tr class="ip-row" hidden="@(day.IsPast ? "hidden" : null)">
                                        <td data-label="Hora"><span class="ip-row__time">@practice.TimeText</span></td>
                                        <td data-label="Práctica">
                                            <a class="ip-row__practice" href="@practice.NextUrl">@practice.PracticeName</a>
                                            @if (!string.IsNullOrEmpty(practice.PracticeNumber))
                                            {
                                                <span class="ip-row__num">Práctica @practice.PracticeNumber</span>
                                            }
                                        </td>
                                        <td data-label="Materia · grupo">
                                            @practice.SubjectName
                                            <span class="ip-row__sub">Grupo @practice.GroupLabel</span>
                                        </td>
                                        <td data-label="Laboratorio">@practice.LaboratoryName</td>
                                        <td data-label="Docente">@practice.TeacherName</td>
                                        <td data-label="Estado">
                                            <span class="badge ip-status badge-@practice.StatusCss @(practice.StatusCss == "light" ? "border text-dark" : string.Empty)">@practice.StatusLabel</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        }
                    </table>
                }
            </div>
            <div class="ip-card__foot">
                <div class="ip-weekchips">
                    @if (weekPanel != null)
                    {
                        foreach (var status in weekPanel.StatusCounts)
                        {
                            <span class="badge badge-@status.Css @(status.Css == "light" ? "border text-dark" : string.Empty)">@status.Label @status.Count</span>
                        }
                    }
                </div>
                <a asp-page="/LaboratoryOperations/Planificaciones">Ver todas las planificaciones <i class="fas fa-arrow-right ml-1" aria-hidden="true"></i></a>
            </div>
        </article>
    </div>

    @* ══════════════════════════ Panel: Bandeja ══════════════════════════ *@
    <div class="ph-panel" role="tabpanel" data-ph-key="bandeja" aria-labelledby="ph-tab-bandeja" @PanelHidden("bandeja")>
        <article class="ip-card" id="bandeja" aria-labelledby="bandeja-title">
            <div class="ip-card__head">
                <h3 class="ip-card__title" id="bandeja-title">Bandeja de pendientes</h3>
                <span class="ip-card__hint"><span id="ip-feed-total">@Model.FeedActionableCount</span> por atender</span>
            </div>
            <div class="ip-card__body p-0">
                @if (Model.FeedUnavailable)
                {
                    <div class="ip-note mx-3 mt-3">
                        <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
                        <span>No se pudieron cargar los avisos en este momento. Vuelve a intentar en unos minutos.</span>
                    </div>
                }
                <div class="ip-feed" id="ip-feed">
                    @foreach (var (groupKey, groupLabel, groupIcon, groupTone) in IndexModel.FeedGroupOrder)
                    {
                        if (!feedItemsByGroup.TryGetValue(groupKey, out var items) || items.Count == 0)
                        {
                            continue;
                        }
                        Model.FeedGroupCounts.TryGetValue(groupKey, out var groupCount);
                        var displayCount = groupCount > 0 ? groupCount : items.Count;
                        var countTone = groupKey == "vencidos" ? "ip-feed__count--danger"
                            : groupKey == "hoy" ? "ip-feed__count--warning"
                            : string.Empty;

                        if (groupKey == "revisar-datos")
                        {
                            <details class="ip-feed__group ip-feed__review" data-ip-group="@groupKey">
                                <summary>
                                    <i class="@groupIcon" aria-hidden="true"></i>
                                    @groupLabel
                                    <span class="ip-feed__count" data-ip-count="@groupKey">@displayCount</span>
                                </summary>
                                @foreach (var item in items)
                                {
                                    var safeUrl = IndexModel.SafeFeedUrl(item.Url);
                                    var icon = string.IsNullOrEmpty(item.Icon) ? groupIcon : item.Icon;
                                    <div class="ip-feed__item" data-synthetic-key="@item.SyntheticKey" data-notification-id="@item.Id" data-feed-key="@FeedKey(item.SyntheticKey, item.Id)">
                                        <span class="ip-feed__icon ip-feed__icon--@groupTone"><i class="@icon" aria-hidden="true"></i></span>
                                        <div class="ip-feed__main">
                                            <p class="ip-feed__title">@item.Title</p>
                                            <p class="ip-feed__msg">@item.Message</p>
                                            <span class="ip-feed__time"><i class="far fa-clock mr-1" aria-hidden="true"></i>@item.Time</span>
                                        </div>
                                        <div class="ip-feed__actions">
                                            @if (safeUrl != null)
                                            {
                                                <a class="ip-feed__action ip-feed__action--resolve" href="@safeUrl">Resolver</a>
                                            }
                                            @if (!string.IsNullOrEmpty(item.SyntheticKey))
                                            {
                                                <button type="button" class="ip-feed__action ip-feed__action--ghost js-ip-snooze">Posponer</button>
                                            }
                                            @if (item.IsPersisted)
                                            {
                                                <button type="button" class="ip-feed__action ip-feed__action--ghost js-ip-done">Listo</button>
                                            }
                                        </div>
                                    </div>
                                }
                            </details>
                        }
                        else
                        {
                            <section class="ip-feed__group" data-ip-group="@groupKey" aria-label="@groupLabel">
                                <h4 class="ip-feed__group-head">
                                    <i class="@groupIcon" aria-hidden="true"></i>
                                    @groupLabel
                                    <span class="ip-feed__count @countTone" data-ip-count="@groupKey">@displayCount</span>
                                </h4>
                                @foreach (var item in items)
                                {
                                    var safeUrl = IndexModel.SafeFeedUrl(item.Url);
                                    var icon = string.IsNullOrEmpty(item.Icon) ? groupIcon : item.Icon;
                                    <div class="ip-feed__item" data-synthetic-key="@item.SyntheticKey" data-notification-id="@item.Id" data-feed-key="@FeedKey(item.SyntheticKey, item.Id)">
                                        <span class="ip-feed__icon ip-feed__icon--@groupTone"><i class="@icon" aria-hidden="true"></i></span>
                                        <div class="ip-feed__main">
                                            <p class="ip-feed__title">@item.Title</p>
                                            <p class="ip-feed__msg">@item.Message</p>
                                            <span class="ip-feed__time"><i class="far fa-clock mr-1" aria-hidden="true"></i>@item.Time</span>
                                        </div>
                                        <div class="ip-feed__actions">
                                            @if (safeUrl != null)
                                            {
                                                <a class="ip-feed__action ip-feed__action--resolve" href="@safeUrl">Resolver</a>
                                            }
                                            @if (!string.IsNullOrEmpty(item.SyntheticKey))
                                            {
                                                <button type="button" class="ip-feed__action ip-feed__action--ghost js-ip-snooze">Posponer</button>
                                            }
                                            @if (item.IsPersisted)
                                            {
                                                <button type="button" class="ip-feed__action ip-feed__action--ghost js-ip-done">Listo</button>
                                            }
                                        </div>
                                    </div>
                                }
                            </section>
                        }
                    }
                    <div class="ip-empty" id="ip-feed-empty" hidden="@(visibleFeedItems > 0 ? "hidden" : null)">
                        <i class="far fa-check-circle" aria-hidden="true"></i>
                        <strong>Todo al día</strong>
                        <div>No tienes avisos pendientes.</div>
                    </div>
                </div>
            </div>
            <div class="ip-card__foot">
                <span class="text-muted">Incluye vencidos, de hoy y próximos.</span>
                <a asp-page="/Notifications">Ver todas las notificaciones <i class="fas fa-arrow-right ml-1" aria-hidden="true"></i></a>
            </div>
        </article>
    </div>

    @* ══════════════════════════ Panel: Gráficos ══════════════════════════ *@
    <div class="ph-panel" role="tabpanel" data-ph-key="graficos" aria-labelledby="ph-tab-graficos" @PanelHidden("graficos")>
        <div class="row ip-row-grid">
            <div class="col-lg-8">
                <article class="ip-card" aria-labelledby="ip-weekly-title">
                    <div class="ip-card__head">
                        <h3 class="ip-card__title" id="ip-weekly-title">Prácticas por semana</h3>
                        <span class="ip-card__hint">Cinco semanas atrás, la actual y dos por venir</span>
                    </div>
                    <div class="ip-card__body">
                        <div class="ip-chartbox" data-ip-box="weekly">
                            <canvas id="ip-chart-weekly" role="img" aria-label="Cantidad de prácticas por semana: cinco semanas anteriores, la actual resaltada y dos siguientes"></canvas>
                        </div>
                        <div class="alert alert-warning d-none mt-3 mb-0" role="alert" data-chart-fallback>
                            El gráfico semanal necesita Chart.js, que no se pudo cargar.
                        </div>
                    </div>
                </article>
            </div>

            <div class="col-lg-4">
                <article class="ip-card" data-ip-chart="category" aria-labelledby="ip-category-title">
                    <div class="ip-card__head">
                        <h3 class="ip-card__title" id="ip-category-title">¿Cómo se compone el inventario?</h3>
                    </div>
                    <div class="ip-card__body">
                        <div data-ip-state="loading" class="ip-loading">
                            <i class="fas fa-circle-notch fa-spin" aria-hidden="true"></i>
                            <span>Cargando indicadores…</span>
                        </div>
                        <div data-ip-state="error" class="ip-error d-none">
                            <span>No se pudieron cargar los indicadores.</span>
                            <button type="button" class="ip-feed__action ip-feed__action--ghost" data-ip-retry>Reintentar</button>
                        </div>
                        <div data-ip-state="content" class="d-none">
                            <div class="ip-chartbox ip-chartbox--small" data-ip-box="category">
                                <canvas id="ip-chart-category" role="img" aria-label="Distribución del inventario por tipo de recurso"></canvas>
                            </div>
                            <ul class="ip-legend" data-ip-legend="category"></ul>
                            <p class="ip-card__hint mt-2 mb-0" id="ip-category-meta"></p>
                        </div>
                    </div>
                </article>
            </div>
        </div>

        <div id="indicadores-loading" class="ip-loading">
            <i class="fas fa-circle-notch fa-spin" aria-hidden="true"></i>
            <span>Cargando indicadores…</span>
        </div>
        <div id="indicadores-error" class="ip-error d-none" role="alert">
            <span>No se pudieron cargar los indicadores.</span>
            <button type="button" class="ip-feed__action ip-feed__action--ghost" id="indicadores-retry">Reintentar</button>
        </div>
        <div id="indicadores-content" class="d-none">
            <div class="row pt-2">
                <div class="col-md-6 mb-4">
                    <div class="ip-indicator">
                    <h4 class="ip-card__title mb-1" data-ip-title="status"></h4>
                    <small class="text-muted" data-ip-conclusion="status"></small>
                    <div class="ip-chartbox ip-chartbox--small pt-2" data-ip-box="status">
                        <canvas id="indicadores-chart-status" role="img" aria-label="Estado operativo de las unidades físicas"></canvas>
                    </div>
                    <ul class="ip-legend" data-ip-legend="status"></ul>
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <div class="ip-indicator">
                    <h4 class="ip-card__title mb-1" data-ip-title="equipment"></h4>
                    <small class="text-muted" data-ip-conclusion="equipment"></small>
                    <div class="ip-chartbox ip-chartbox--small pt-2" data-ip-box="equipment">
                        <canvas id="indicadores-chart-equipment" role="img" aria-label="Equipos por clasificación técnica"></canvas>
                    </div>
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <div class="ip-indicator">
                    <h4 class="ip-card__title mb-1" data-ip-title="utensil"></h4>
                    <small class="text-muted" data-ip-conclusion="utensil"></small>
                    <div class="ip-chartbox ip-chartbox--small pt-2" data-ip-box="utensil">
                        <canvas id="indicadores-chart-utensil" role="img" aria-label="Utensilios por tipo"></canvas>
                    </div>
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <div class="ip-indicator">
                    <h4 class="ip-card__title mb-1" data-ip-title="other"></h4>
                    <small class="text-muted" data-ip-conclusion="other"></small>
                    <div class="ip-chartbox ip-chartbox--small pt-2" data-ip-box="other">
                        <canvas id="indicadores-chart-other" role="img" aria-label="Otros activos por clasificación"></canvas>
                    </div>
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <div class="ip-indicator">
                    <h4 class="ip-card__title mb-1" data-ip-title="condition"></h4>
                    <small class="text-muted" data-ip-conclusion="condition"></small>
                    <div class="ip-chartbox ip-chartbox--small pt-2" data-ip-box="condition">
                        <canvas id="indicadores-chart-condition" role="img" aria-label="Condición física del inventario"></canvas>
                    </div>
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <div class="ip-indicator">
                    <h4 class="ip-card__title mb-1" data-ip-title="environment"></h4>
                    <small class="text-muted" data-ip-conclusion="environment"></small>
                    <div class="ip-chartbox ip-chartbox--small pt-2" data-ip-box="environment">
                        <canvas id="indicadores-chart-environment" role="img" aria-label="Ambientes con mayor cantidad de unidades"></canvas>
                    </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ══════════════════════════ Panel: Inventario ══════════════════════════ *@
    <div class="ph-panel" role="tabpanel" data-ph-key="inventario" aria-labelledby="ph-tab-inventario" @PanelHidden("inventario")>
        <section id="inventario" aria-labelledby="inventario-title">
            <div class="d-flex flex-wrap align-items-end justify-content-between mb-3">
                <div>
                    <h2 class="h3 font-weight-bold text-dark mb-1" id="inventario-title">Inventario</h2>
                    <span class="text-muted small"><i class="fas fa-database mr-1" aria-hidden="true"></i> Unidades vigentes: <strong>@Model.TotalUnitsCount</strong></span>
                </div>
            </div>

            <div class="ip-tiles mb-3">
                <a class="ip-tile" asp-page="./EquipmentClassifications" asp-route-activeTab="Inventario" title="Ver equipos">
                    <span class="ip-tile__icon ip-tile__icon--blue"><i class="mdi mdi-microscope" aria-hidden="true"></i></span>
                    <span class="ip-tile__value">@Model.EquipmentUnitsCount</span>
                    <span class="ip-tile__label">Equipos</span>
                    <span class="ip-tile__hint">Unidades clasificadas como equipo</span>
                </a>
                <a class="ip-tile" asp-page="./UtensilClassifications" asp-route-activeTab="Inventario" title="Ver utensilios">
                    <span class="ip-tile__icon ip-tile__icon--green"><i class="fas fa-utensils" aria-hidden="true"></i></span>
                    <span class="ip-tile__value">@Model.UtensilUnitsCount</span>
                    <span class="ip-tile__label">Utensilios</span>
                    <span class="ip-tile__hint">Con N.º de inventario</span>
                </a>
                <a class="ip-tile" asp-page="./OtherUnits" asp-route-activeTab="Inventario" title="Ver otros activos">
                    <span class="ip-tile__icon ip-tile__icon--amber"><i class="mdi mdi-layers" aria-hidden="true"></i></span>
                    <span class="ip-tile__value">@Model.OtherUnitsCount</span>
                    <span class="ip-tile__label">Otros</span>
                    <span class="ip-tile__hint">Fuera de equipo/utensilio</span>
                </a>
                <a class="ip-tile" asp-page="./Environments" title="Ver ambientes">
                    <span class="ip-tile__icon ip-tile__icon--cyan"><i class="mdi mdi-home-modern" aria-hidden="true"></i></span>
                    <span class="ip-tile__value">@Model.EnvironmentsCount</span>
                    <span class="ip-tile__label">Ambientes</span>
                    <span class="ip-tile__hint">@Model.EnvironmentsWithUnitsCount con inventario asignado</span>
                </a>
                @if (canOpenAdminLists)
                {
                    <a class="ip-tile" asp-page="/EquipmentUnits/Index" title="Ver todas las unidades físicas">
                        <span class="ip-tile__icon ip-tile__icon--red"><i class="fas fa-clipboard-list" aria-hidden="true"></i></span>
                        <span class="ip-tile__value">@Model.UnitsWithoutSpecificClassificationCount</span>
                        <span class="ip-tile__label">Por clasificar</span>
                        <span class="ip-tile__hint">@Model.PendingClassificationUnitsCount pendientes · @Model.LegacyInferredUnitsCount heredadas</span>
                    </a>
                    <a class="ip-tile" asp-page="/Catalogs/Stock/Index" title="Ver existencias">
                        <span class="ip-tile__icon ip-tile__icon--green"><i class="fas fa-boxes" aria-hidden="true"></i></span>
                        <span class="ip-tile__value">@Model.StockRecordsCount</span>
                        <span class="ip-tile__label">Existencias</span>
                        <span class="ip-tile__hint">Stock en @Model.StockLaboratoriesCount ambiente(s)</span>
                    </a>
                    <a class="ip-tile" asp-page="/Catalogs/Articles/Index" title="Ver el catálogo de artículos">
                        <span class="ip-tile__icon ip-tile__icon--blue"><i class="mdi mdi-blender" aria-hidden="true"></i></span>
                        <span class="ip-tile__value">@Model.ArticlesCount.ToString("N0", esBo)</span>
                        <span class="ip-tile__label">Artículos</span>
                        <span class="ip-tile__hint">En @Model.ArticleCategoriesCount categoría(s)</span>
                    </a>
                }
                else
                {
                    <div class="ip-tile ip-tile--plain">
                        <span class="ip-tile__icon ip-tile__icon--red"><i class="fas fa-clipboard-list" aria-hidden="true"></i></span>
                        <span class="ip-tile__value">@Model.UnitsWithoutSpecificClassificationCount</span>
                        <span class="ip-tile__label">Por clasificar</span>
                        <span class="ip-tile__hint">Solo administración</span>
                    </div>
                    <div class="ip-tile ip-tile--plain">
                        <span class="ip-tile__icon ip-tile__icon--green"><i class="fas fa-boxes" aria-hidden="true"></i></span>
                        <span class="ip-tile__value">@Model.StockRecordsCount</span>
                        <span class="ip-tile__label">Existencias</span>
                        <span class="ip-tile__hint">Solo administración</span>
                    </div>
                    <div class="ip-tile ip-tile--plain">
                        <span class="ip-tile__icon ip-tile__icon--blue"><i class="mdi mdi-blender" aria-hidden="true"></i></span>
                        <span class="ip-tile__value">@Model.ArticlesCount.ToString("N0", esBo)</span>
                        <span class="ip-tile__label">Artículos</span>
                        <span class="ip-tile__hint">Solo administración</span>
                    </div>
                }
            </div>

            <div class="ip-quality__card mb-3">
                <h3 class="ip-card__title mb-2">Calidad de clasificación</h3>
                <span class="text-muted small">Cuánto inventario ya tiene una clasificación específica.</span>
                <div class="d-flex align-items-end justify-content-between mt-3">
                    <div>
                        <span class="ip-quality__pct">@Model.ClassificationQualityPercent %</span>
                        <span class="d-block text-muted small">Clasificado correctamente</span>
                    </div>
                    <div class="text-right">
                        <span class="d-block font-weight-bold" style="font-size:1.2rem;">@Model.UnitsWithoutSpecificClassificationCount</span>
                        <span class="text-muted small">Pendientes de clasificar</span>
                    </div>
                </div>
                <div class="ip-quality__track" role="img" aria-label="Calidad de clasificación: @Model.ClassificationQualityPercent por ciento">
                    <span class="ip-quality__fill" style="width:@Model.ClassificationQualityPercent%;"></span>
                </div>
                <div class="ip-quality__stats">
                    <span><strong>@Model.UnitsWithoutSerialCount</strong> sin serie</span>
                    <span><strong>@Model.UnitsWithoutEnvironmentCount</strong> sin ambiente</span>
                </div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <!-- Chart.js 3.9.1 (misma URL de CDN que ya usaba la página) -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
    <script src="~/js/panel-tabs.js" asp-append-version="true"></script>
    <script src="~/js/inicio-panel.js" asp-append-version="true"></script>
}
