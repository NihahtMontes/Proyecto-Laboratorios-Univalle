@page
@model Proyecto_Laboratorios_Univalle.Pages.AssetView.IndexModel

@{
    ViewData["Title"] = "Inicio";
    // /Catalogs/Stock y /EquipmentUnits son solo para Administrator/SuperAdmin: el Supervisor ve la tarjeta sin enlace.
    var canOpenAdminLists = User.IsInRole("Administrator") || User.IsInRole("SuperAdmin");
    var adminLinkStyle = canOpenAdminLists ? "" : "pointer-events:none;cursor:default;";
}

@section Styles {
    <style>
        .inicio-shortcut-card {
            display: block;
            background: #fff;
            border: 1px solid #edf1f5;
            border-radius: 10px;
            box-shadow: 0 6px 16px rgba(15, 23, 42, .05);
            padding: 1.15rem 1.25rem;
            height: 100%;
            color: #263445;
            transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
        }

        .inicio-shortcut-card:hover,
        .inicio-shortcut-card:focus {
            transform: translateY(-3px);
            box-shadow: 0 14px 28px rgba(15, 23, 42, .10);
            border-color: #d9e2ef;
            text-decoration: none;
            color: #263445;
        }

        .inicio-shortcut-icon {
            width: 52px;
            height: 52px;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }

        .inicio-icon-blue { background: rgba(41, 98, 255, .10); color: #2962ff; }
        .inicio-icon-green { background: rgba(0, 194, 146, .12); color: #00a584; }
        .inicio-icon-amber { background: rgba(255, 178, 43, .16); color: #e08600; }
        .inicio-icon-purple { background: rgba(116, 96, 238, .12); color: #7460ee; }
        .inicio-icon-cyan { background: rgba(3, 169, 243, .12); color: #03a9f3; }
        .inicio-icon-red { background: rgba(246, 45, 81, .10); color: #f62d51; }
        .inicio-icon-slate { background: rgba(108, 117, 125, .12); color: #6c757d; }

        .inicio-shortcut-value {
            font-size: 1.9rem;
            font-weight: 700;
            line-height: 1;
            letter-spacing: 0;
        }

        .inicio-shortcut-code {
            font-size: 1.35rem;
            font-weight: 700;
            line-height: 1.15;
            letter-spacing: .5px;
        }

        .asset-metric-tile {
            min-height: 134px;
            border-radius: 8px;
            color: #fff;
            box-shadow: 0 10px 24px rgba(15, 23, 42, .12);
            overflow: hidden;
            position: relative;
        }

        .asset-metric-tile:after {
            content: "";
            width: 96px;
            height: 96px;
            border-radius: 50%;
            background: rgba(255, 255, 255, .14);
            position: absolute;
            right: -24px;
            top: -24px;
        }

        .asset-metric-icon {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: rgba(255, 255, 255, .18);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .asset-metric-value {
            font-size: 2rem;
            line-height: 1;
            letter-spacing: 0;
        }

        .asset-chart-panel {
            background: #fff;
            border: 1px solid #edf1f5;
            border-radius: 8px;
            box-shadow: 0 8px 20px rgba(15, 23, 42, .06);
            min-height: 100%;
        }

        .asset-chart-header {
            min-height: 58px;
        }

        .asset-empty-state {
            min-height: 210px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: #8d97ad;
            background: #f8fafc;
            border: 1px dashed #d9e2ef;
            border-radius: 8px;
        }

        .asset-empty-state i {
            font-size: 2rem;
            display: block;
            margin-bottom: .65rem;
            color: #b8c2d6;
        }

        .inicio-chart-box {
            position: relative;
            min-height: 250px;
        }

        .inicio-chart-box-small {
            min-height: 220px;
        }

        .inicio-chart-box .inicio-empty-inline {
            min-height: 220px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: #8d97ad;
        }

        .inicio-donut-legend {
            list-style: none;
            padding: 0;
            margin: .75rem 0 0;
            display: flex;
            flex-wrap: wrap;
            gap: .35rem .9rem;
        }

        .inicio-donut-legend li {
            display: inline-flex;
            align-items: center;
            font-size: .8rem;
            color: #546e7a;
        }

        .inicio-donut-legend .inicio-legend-dot {
            width: 10px;
            height: 10px;
            border-radius: 3px;
            display: inline-block;
            margin-right: .4rem;
        }

        .inicio-spinner {
            color: #7460ee;
        }

        .asset-quality-track {
            height: 12px;
            border-radius: 999px;
            background: #edf1f5;
            overflow: hidden;
        }

        .asset-quality-fill {
            height: 100%;
            border-radius: inherit;
            background: linear-gradient(90deg, #00c292, #03a9f3);
        }

        .asset-bg-blue { background: linear-gradient(135deg, #2962ff, #36a3ff); }
        .asset-bg-green { background: linear-gradient(135deg, #00c292, #48d65b); }
        .asset-bg-amber { background: linear-gradient(135deg, #ffb22b, #ff8f00); }
        .asset-bg-purple { background: linear-gradient(135deg, #7460ee, #a163f7); }
        .asset-bg-red { background: linear-gradient(135deg, #f62d51, #ff6b6b); }
        .asset-bg-cyan { background: linear-gradient(135deg, #03a9f3, #4fc3f7); }
        .asset-bg-teal { background: linear-gradient(135deg, #00838f, #26c6da); }
        .asset-bg-slate { background: linear-gradient(135deg, #6c757d, #95a5a6); }
        .asset-bg-pink { background: linear-gradient(135deg, #d81b60, #f06292); }

        .asset-nav-card {
            min-height: 172px;
            border-radius: 8px;
            color: #fff;
            box-shadow: 0 10px 24px rgba(15, 23, 42, .12);
            overflow: hidden;
            position: relative;
            transition: transform .18s ease, box-shadow .18s ease;
        }

        .asset-nav-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 16px 30px rgba(15, 23, 42, .16);
        }

        .asset-nav-card:after {
            content: "";
            width: 112px;
            height: 112px;
            border-radius: 50%;
            background: rgba(255, 255, 255, .16);
            position: absolute;
            right: -24px;
            top: -24px;
        }

        .asset-nav-card.bg-primary { background: linear-gradient(135deg, #2962ff, #36a3ff) !important; }
        .asset-nav-card.bg-success { background: linear-gradient(135deg, #00c292, #48d65b) !important; }
        .asset-nav-card.bg-warning { background: linear-gradient(135deg, #ffb22b, #ff8f00) !important; }
        .asset-nav-card.bg-danger { background: linear-gradient(135deg, #f62d51, #ff6b6b) !important; }
        .asset-nav-card.bg-info,
        .asset-nav-card.bg-cyan { background: linear-gradient(135deg, #03a9f3, #4fc3f7) !important; }
        .asset-nav-card.bg-secondary { background: linear-gradient(135deg, #6c757d, #95a5a6) !important; }

        .asset-nav-icon {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: rgba(255, 255, 255, .18);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .asset-nav-title {
            font-size: 1.1rem;
            line-height: 1.25;
            letter-spacing: 0;
        }

        .asset-nav-value {
            font-size: 2rem;
            line-height: 1;
            letter-spacing: 0;
        }
    </style>
}

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <ul class="nav nav-tabs customtab px-4 pt-3 border-0" role="tablist">
                <li class="nav-item">
                    <a class="nav-link @(Model.ShowInventoryTab || Model.ShowIndicatorsTab ? "" : "active") font-weight-bold" data-toggle="tab" href="#resumen" role="tab">
                        <span class="hidden-xs-down"><i class="fas fa-home mr-2"></i> Resumen</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(Model.ShowInventoryTab ? "active" : "") font-weight-bold" data-toggle="tab" href="#inventario" role="tab">
                        <span class="hidden-xs-down"><i class="fas fa-boxes mr-2"></i> Inventario</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(Model.ShowIndicatorsTab ? "active" : "") font-weight-bold" data-toggle="tab" href="#indicadores" role="tab">
                        <span class="hidden-xs-down"><i class="fas fa-chart-bar mr-2"></i> Indicadores</span>
                    </a>
                </li>
            </ul>

            <div class="tab-content border-top">
                @* ════════════════════════════ RESUMEN ════════════════════════════ *@
                <div class="tab-pane @(Model.ShowInventoryTab || Model.ShowIndicatorsTab ? "" : "active")" id="resumen" role="tabpanel">
                    <div class="card-body">
                        <div class="d-md-flex align-items-center justify-content-between mb-4 pb-3 border-bottom">
                            <div>
                                <h2 class="font-weight-bold text-dark mb-1">@Model.Greeting, @Model.UserDisplayName</h2>
                                <div class="text-muted">
                                    <i class="far fa-calendar mr-1"></i> @Model.TodayText
                                    @if (Model.HasCorrective && !string.IsNullOrEmpty(Model.CorrectiveCode))
                                    {
                                        <span class="mx-2 text-muted">·</span>
                                        <span><i class="fas fa-wrench mr-1"></i>Correctivo activo @Model.CorrectiveCode</span>
                                    }
                                </div>
                            </div>
                            <div class="text-muted small mt-2 mt-md-0">
                                <i class="fas fa-database mr-1"></i> Unidades vigentes: <strong>@Model.TotalUnitsCount</strong>
                            </div>
                        </div>

                        <h3 class="card-title text-dark font-weight-bold mt-2 ml-2 mb-1">Atajos rápidos</h3>
                        <h6 class="card-subtitle text-muted ml-2 mb-4">Las tareas más frecuentes de tu rol, a un clic.</h6>

                        <div class="row">
                            <div class="col-xl-3 col-md-4 col-sm-6 mb-3">
                                <a asp-page="/LaboratoryOperations/Solicitudes/Index" class="inicio-shortcut-card" title="Revisar solicitudes de prácticas de docentes">
                                    <span class="inicio-shortcut-icon inicio-icon-red mb-3"><i class="mdi mdi-inbox-arrow-down"></i></span>
                                    <div class="inicio-shortcut-value font-weight-bold @(Model.PendingTeacherRequests == 0 ? "text-success" : "text-danger")">@(Model.PendingTeacherRequests > 0 ? Model.PendingTeacherRequests.ToString() : "✓")</div>
                                    <div class="font-weight-bold mt-2">Solicitudes de docentes</div>
                                    <small class="text-muted d-block">@(Model.PendingTeacherRequests == 0 ? "Sin prácticas por revisar" : $"{Model.PendingTeacherRequests} solicitud(es) por revisar")</small>
                                </a>
                            </div>

                            <div class="col-xl-3 col-md-4 col-sm-6 mb-3">
                                <a asp-page="/Requests/Index" asp-page-handler="NewRequest" class="inicio-shortcut-card" title="Registrar una falla dentro del correctivo actual">
                                    <span class="inicio-shortcut-icon inicio-icon-amber mb-3"><i class="mdi mdi-alert-circle-outline"></i></span>
                                    <div class="inicio-shortcut-code font-weight-bold text-warning">Reportar</div>
                                    <div class="font-weight-bold mt-2">Reportar una falla</div>
                                    <small class="text-muted d-block">Crea la solicitud de servicio técnico del correctivo actual</small>
                                </a>
                            </div>

                            @if (Model.IsAdminMenu)
                            {
                                <div class="col-xl-3 col-md-4 col-sm-6 mb-3">
                                    <a asp-page="/Managements/Index" asp-page-handler="CurrentCorrective" class="inicio-shortcut-card" title="Abrir el panel de la gestión correctiva activa">
                                        <span class="inicio-shortcut-icon inicio-icon-blue mb-3"><i class="mdi mdi-wrench"></i></span>
                                        <div class="inicio-shortcut-value font-weight-bold @(Model.CorrectivePendingRequests == 0 ? "text-success" : "text-primary")">@(Model.CorrectivePendingRequests > 0 ? Model.CorrectivePendingRequests.ToString() : "✓")</div>
                                        <div class="font-weight-bold mt-2">Panel del correctivo</div>
                                        <small class="text-muted d-block">@(Model.HasCorrective ? $"{Model.CorrectivePendingRequests} solicitud(es) de servicio técnico pendientes" : "Sin gestión correctiva activa")</small>
                                    </a>
                                </div>

                                <div class="col-xl-3 col-md-4 col-sm-6 mb-3">
                                    <a asp-page="/Managements/Index" asp-page-handler="CurrentPreventive" class="inicio-shortcut-card" title="Abrir el panel de la gestión preventiva activa">
                                        <span class="inicio-shortcut-icon inicio-icon-green mb-3"><i class="mdi mdi-shield-outline"></i></span>
                                        <div class="inicio-shortcut-code font-weight-bold @(Model.HasPreventive ? "text-success" : "text-secondary")">@(Model.HasPreventive ? Model.PreventiveCode : "—")</div>
                                        <div class="font-weight-bold mt-2">Mantenimiento preventivo</div>
                                        <small class="text-muted d-block">
                                            @(Model.HasPreventive
                                                ? $"{Model.PreventivePlannedUnits} equipo(s) planificados · {Model.PreventiveCompletedUnits} completados"
                                                : "Sin gestión preventiva activa")
                                        </small>
                                    </a>
                                </div>
                            }

                            <div class="col-xl-3 col-md-4 col-sm-6 mb-3">
                                <a asp-page="/Requests/Index" class="inicio-shortcut-card" title="Listado y seguimiento de solicitudes de servicio técnico">
                                    <span class="inicio-shortcut-icon inicio-icon-purple mb-3"><i class="mdi mdi-message-text-outline"></i></span>
                                    <div class="inicio-shortcut-code font-weight-bold text-purple" style="color:#7460ee;">Solicitudes</div>
                                    <div class="font-weight-bold mt-2">L7 · Servicio técnico</div>
                                    <small class="text-muted d-block">Listado y seguimiento de solicitudes</small>
                                </a>
                            </div>

                            <div class="col-xl-3 col-md-4 col-sm-6 mb-3">
                                <a asp-page="/Reports/Index" class="inicio-shortcut-card" title="Reportes institucionales">
                                    <span class="inicio-shortcut-icon inicio-icon-cyan mb-3"><i class="mdi mdi-file-chart"></i></span>
                                    <div class="inicio-shortcut-code font-weight-bold" style="color:#03a9f3;">PDF · Excel</div>
                                    <div class="font-weight-bold mt-2">Reportes</div>
                                    <small class="text-muted d-block">Reportes institucionales listos para descargar</small>
                                </a>
                            </div>

                            <div class="col-xl-3 col-md-4 col-sm-6 mb-3">
                                <a asp-page="/LaboratoryOperations/Index" class="inicio-shortcut-card" title="Panel de planificación académica">
                                    <span class="inicio-shortcut-icon inicio-icon-blue mb-3"><i class="mdi mdi-view-dashboard"></i></span>
                                    <div class="inicio-shortcut-code font-weight-bold" style="color:#2962ff;">Planificación</div>
                                    <div class="font-weight-bold mt-2">Panel de planificación</div>
                                    <small class="text-muted d-block">Solicitudes, grilla y calendario académico</small>
                                </a>
                            </div>

                            <div class="col-xl-3 col-md-4 col-sm-6 mb-3">
                                <a asp-page="/Acquisitions/Index" class="inicio-shortcut-card" title="Solicitudes de compra y desembolsos">
                                    <span class="inicio-shortcut-icon inicio-icon-amber mb-3"><i class="mdi mdi-cart-outline"></i></span>
                                    <div class="inicio-shortcut-code font-weight-bold text-warning">Compras</div>
                                    <div class="font-weight-bold mt-2">Adquisición</div>
                                    <small class="text-muted d-block">Solicitudes de compra y desembolsos</small>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                @* ════════════════════════════ INVENTARIO ════════════════════════════ *@
                <div class="tab-pane @(Model.ShowInventoryTab ? "active" : "")" id="inventario" role="tabpanel">
                    <div class="card-body">
                        <div class="d-md-flex align-items-center mb-4 pb-3 border-bottom">
                            <div>
                                <h3 class="card-title text-dark font-weight-bold mt-2 ml-2">Inventario por Tipo de Recurso</h3>
                                <h6 class="card-subtitle text-muted ml-2">Indicadores vivos y navegación en cascada para consultar unidades físicas vigentes.</h6>
                            </div>
                            <div class="text-muted small mt-2 mt-md-0">
                                <i class="fas fa-database mr-1"></i> Unidades vigentes: <strong>@Model.TotalUnitsCount</strong>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-xl-3 col-md-4 col-sm-6 mb-3">
                                <div class="asset-metric-tile asset-bg-blue p-3">
                                    <div class="asset-metric-icon mb-3"><i class="fas fa-cubes"></i></div>
                                    <div class="asset-metric-value font-weight-bold">@Model.TotalUnitsCount</div>
                                    <div class="font-weight-bold mt-2">Total activos</div>
                                    <small>Unidades físicas: patrimonio por N.º de inventario</small>
                                </div>
                            </div>
                            <div class="col-xl-3 col-md-4 col-sm-6 mb-3">
                                <a asp-page="/Catalogs/Stock/Index" class="text-decoration-none" title="Ver existencias de artículos consumibles" style="@adminLinkStyle" aria-disabled="@(canOpenAdminLists ? "false" : "true")">
                                    <div class="asset-metric-tile asset-bg-teal p-3">
                                        <div class="asset-metric-icon mb-3"><i class="fas fa-boxes"></i></div>
                                        <div class="asset-metric-value font-weight-bold">@Model.StockRecordsCount</div>
                                        <div class="font-weight-bold mt-2">Existencias</div>
                                        <small>Registros de stock de artículos consumibles</small>
                                        <small class="d-block">Consumibles por stock en @Model.StockLaboratoriesCount ambiente(s)</small>
                                    </div>
                                </a>
                            </div>
                            <div class="col-xl-3 col-md-4 col-sm-6 mb-3">
                                <a asp-page="/Catalogs/Articles/Index" class="text-decoration-none" title="Ver el catálogo de artículos" style="@adminLinkStyle" aria-disabled="@(canOpenAdminLists ? "false" : "true")">
                                    <div class="asset-metric-tile asset-bg-pink p-3">
                                        <div class="asset-metric-icon mb-3"><i class="fas fa-blender"></i></div>
                                        <div class="asset-metric-value font-weight-bold">@Model.ArticlesCount.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("es-BO"))</div>
                                        <div class="font-weight-bold mt-2">Artículos</div>
                                        <small>Catálogo de utensilios, vajilla, cristalería y más</small>
                                        <small class="d-block">En @Model.ArticleCategoriesCount categoría(s)</small>
                                    </div>
                                </a>
                            </div>
                            <div class="col-xl-3 col-md-4 col-sm-6 mb-3">
                                <div class="asset-metric-tile asset-bg-purple p-3">
                                    <div class="asset-metric-icon mb-3"><i class="fas fa-microscope"></i></div>
                                    <div class="asset-metric-value font-weight-bold">@Model.EquipmentUnitsCount</div>
                                    <div class="font-weight-bold mt-2">Equipos</div>
                                    <small>Clasificados como equipo</small>
                                </div>
                            </div>
                            <div class="col-xl-3 col-md-4 col-sm-6 mb-3">
                                <div class="asset-metric-tile asset-bg-green p-3">
                                    <div class="asset-metric-icon mb-3"><i class="fas fa-utensils"></i></div>
                                    <div class="asset-metric-value font-weight-bold">@Model.UtensilUnitsCount</div>
                                    <div class="font-weight-bold mt-2">Utensilios patrimoniales</div>
                                    <small>Unidades con N.º de inventario (no incluye el catálogo de artículos)</small>
                                </div>
                            </div>
                            <div class="col-xl-3 col-md-4 col-sm-6 mb-3">
                                <div class="asset-metric-tile asset-bg-amber p-3">
                                    <div class="asset-metric-icon mb-3"><i class="fas fa-layer-group"></i></div>
                                    <div class="asset-metric-value font-weight-bold">@Model.OtherUnitsCount</div>
                                    <div class="font-weight-bold mt-2">Otros</div>
                                    <small>Fuera de equipo/utensilio</small>
                                </div>
                            </div>
                            <div class="col-xl-3 col-md-4 col-sm-6 mb-3">
                                @if (Model.UnitsWithoutSpecificClassificationCount > 0)
                                {
                                    <a asp-page="/EquipmentUnits/Index" class="text-decoration-none" title="Ver todas las unidades físicas" style="@adminLinkStyle" aria-disabled="@(canOpenAdminLists ? "false" : "true")">
                                        <div class="asset-metric-tile asset-bg-amber p-3">
                                            <div class="asset-metric-icon mb-3"><i class="fas fa-clipboard-list"></i></div>
                                            <div class="asset-metric-value font-weight-bold">@Model.UnitsWithoutSpecificClassificationCount</div>
                                            <div class="font-weight-bold mt-2">Por clasificar</div>
                                            <small>Pendientes: @Model.PendingClassificationUnitsCount · Heredadas: @Model.LegacyInferredUnitsCount</small>
                                        </div>
                                    </a>
                                }
                                else
                                {
                                    <div class="asset-metric-tile asset-bg-slate p-3">
                                        <div class="asset-metric-icon mb-3"><i class="fas fa-clipboard-check"></i></div>
                                        <div class="asset-metric-value font-weight-bold">0</div>
                                        <div class="font-weight-bold mt-2">Por clasificar</div>
                                        <small>Al día: sin pendientes</small>
                                    </div>
                                }
                            </div>
                            <div class="col-xl-3 col-md-4 col-sm-6 mb-3">
                                <div class="asset-metric-tile asset-bg-cyan p-3">
                                    <div class="asset-metric-icon mb-3"><i class="fas fa-door-open"></i></div>
                                    <div class="asset-metric-value font-weight-bold">@Model.EnvironmentsWithUnitsCount</div>
                                    <div class="font-weight-bold mt-2">Ambientes</div>
                                    <small>Con inventario asignado</small>
                                </div>
                            </div>
                            <div class="col-xl-3 col-md-4 col-sm-6 mb-3">
                                <div class="asset-metric-tile asset-bg-red p-3">
                                    <div class="asset-metric-icon mb-3"><i class="fas fa-exclamation-triangle"></i></div>
                                    <div class="asset-metric-value font-weight-bold">@Model.UnitsWithoutEnvironmentCount</div>
                                    <div class="font-weight-bold mt-2">Sin ambiente</div>
                                    <small>Requieren ubicación</small>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-2">
                            <div class="col-xl-4 col-lg-5 mb-4">
                                <div class="asset-chart-panel p-4 h-100">
                                    <div class="asset-chart-header">
                                        <h4 class="card-title mb-1">Calidad de clasificación</h4>
                                        <small class="text-muted">Mide cuánto inventario ya tiene una clasificación específica.</small>
                                    </div>
                                    <div class="pt-3">
                                        <div class="d-flex align-items-end justify-content-between mb-2">
                                            <div>
                                                <h2 class="font-weight-bold text-info mb-0">@Model.ClassificationQualityPercent%</h2>
                                                <span class="text-muted">Clasificado correctamente</span>
                                            </div>
                                            <div class="text-right">
                                                <h4 class="font-weight-bold text-warning mb-0">@Model.UnitsWithoutSpecificClassificationCount</h4>
                                                <span class="text-muted small">Pendientes de clasificar</span>
                                            </div>
                                        </div>
                                        <div class="asset-quality-track mb-4">
                                            <div class="asset-quality-fill" style="width: @Model.ClassificationQualityPercent%;"></div>
                                        </div>
                                        <div class="row text-center">
                                            <div class="col-6 border-right">
                                                <h4 class="font-weight-bold mb-0">@Model.UnitsWithoutSerialCount</h4>
                                                <small class="text-muted d-block">Sin serie</small>
                                                <small class="text-muted">Se identifican por N.º de inventario</small>
                                            </div>
                                            <div class="col-6">
                                                <h4 class="font-weight-bold mb-0">@Model.UnitsWithoutEnvironmentCount</h4>
