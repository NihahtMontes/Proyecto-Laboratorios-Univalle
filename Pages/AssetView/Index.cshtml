                                {
                                    <div class="asset-nav-card bg-secondary h-100 p-4">
                                        <div class="asset-nav-icon mb-3"><i class="fas fa-clipboard-check"></i></div>
                                        <h4 class="asset-nav-title text-white font-weight-bold mb-4">Por clasificar</h4>
                                        <div class="asset-nav-value font-weight-bold mb-2">0</div>
                                        <p class="mb-0 font-weight-bold">Clasificación al día: sin pendientes.</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                @* ════════════════════════════ INDICADORES ════════════════════════════ *@
                <div class="tab-pane @(Model.ShowIndicatorsTab ? "active" : "")" id="indicadores" role="tabpanel">
                    <div class="card-body">
                        <div class="d-md-flex align-items-center justify-content-between mb-4 pb-3 border-bottom">
                            <div>
                                <h3 class="card-title text-dark font-weight-bold mt-2 ml-2">Indicadores del inventario</h3>
