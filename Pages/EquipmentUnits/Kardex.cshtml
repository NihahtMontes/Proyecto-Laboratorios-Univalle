@page "{id:int}"
@model Proyecto_Laboratorios_Univalle.Pages.EquipmentUnits.KardexModel
@{
    ViewData["Title"] = "Kardex de Equipo";
}

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="d-md-flex align-items-center mb-4 pb-3 border-bottom">
                    <div class="d-flex align-items-center">
                        <div class="btn btn-circle btn-lg btn-light-primary text-primary mr-3 shadow-sm">
                            <i class="fas fa-history"></i>
                        </div>
                        <div>
                            <h3 class="card-title text-dark font-weight-bold mb-0">Kardex Histórico de Mantenimiento</h3>
                            <h6 class="card-subtitle text-muted">@Model.Unit.Equipment?.Name <span class="badge badge-light border ml-2">Inv: @Model.Unit.InventoryNumber</span></h6>
                        </div>
                    </div>
                    <div class="ml-auto mt-3 mt-md-0">
                        <a href="javascript:history.back()" class="btn btn-outline-secondary btn-rounded px-4">
                            <i class="fas fa-arrow-left mr-2"></i> Volver
                        </a>
                    </div>
                </div>

                @if (!Model.History.Any())
                {
                    <div class="text-center py-5">
                        <i class="fas fa-calendar-times fa-4x text-muted mb-3 opacity-2"></i>
                        <h5 class="text-muted font-weight-bold">No existen registros históricos para este equipo.</h5>
                        <p class="text-muted small">Este equipo aún no ha pasado por un proceso de mantenimiento formal.</p>
                    </div>
                }
                else
                {
                    <div class="timeline-main mt-4">
                        @foreach (var m in Model.History)
                        {
                            <div class="card border-left border-3 mb-4 @(m.Status == Proyecto_Laboratorios_Univalle.Models.Enums.MaintenanceStatus.Completed ? "border-success" : "border-warning") shadow-sm">
                                <div class="card-body">
                                    <div class="d-md-flex justify-content-between align-items-start mb-3">
                                        <div>
                                            <span class="badge @(m.Status == Proyecto_Laboratorios_Univalle.Models.Enums.MaintenanceStatus.Completed ? "badge-success" : "badge-warning") text-uppercase mb-2">
                                                @m.Status
                                            </span>
                                            <h5 class="font-weight-bold text-dark mb-1">Mantenimiento #@m.Id - @m.MaintenanceType</h5>
                                            <p class="text-muted small mb-0"><i class="far fa-calendar-alt mr-1"></i> @(m.EndDate?.ToString("dd/MM/yyyy") ?? m.ScheduledDate?.ToString("dd/MM/yyyy") ?? "-")</p>
                                        </div>
                                        <div class="text-md-right mt-2 mt-md-0">
                                            <div class="small font-weight-bold text-muted uppercase">Técnico</div>
                                            <div class="text-dark font-weight-bold">@(m.Technician?.FullName ?? "N/A")</div>
                                        </div>
                                    </div>
                                    
                                    <div class="bg-light p-3 rounded mb-3">
                                        <h6 class="small font-weight-bold text-muted uppercase mb-2">Descripción del Servicio</h6>
                                        <p class="text-dark mb-0 small">@(m.Description ?? "Sin descripción.")</p>
                                    </div>

                                    @if (m.ActualCost.HasValue && m.ActualCost > 0)
                                    {
                                        <div class="d-flex align-items-center">
                                            <span class="badge badge-pill badge-light text-success font-weight-bold px-3 py-2 border">
                                                <i class="fas fa-money-bill-wave mr-2"></i> Inversión: Bs @m.ActualCost.Value.ToString("N2")
                                            </span>
                                            @if (m.SatisfactionLevel.HasValue)
                                            {
                                                <span class="badge badge-pill badge-light text-warning font-weight-bold px-3 py-2 border ml-2">
                                                    <i class="fas fa-star mr-1"></i> @m.SatisfactionLevel
                                                </span>
                                            }
                                        </div>
                                    }
                                    
                                    <div class="mt-3 text-right border-top pt-2">
                                        <a asp-page="/Maintenances/Details" asp-route-id="@m.Id" class="btn btn-sm btn-link text-info font-weight-bold">
                                            Ver Ficha Técnica <i class="fas fa-chevron-right ml-1"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .border-3 { border-left-width: 5px !important; }
    .timeline-main { position: relative; padding-left: 20px; }
    .timeline-main::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 2px;
        background: #e9ecef;
    }
</style>
