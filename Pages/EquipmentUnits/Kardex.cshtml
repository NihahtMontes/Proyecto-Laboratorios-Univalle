@page "{id:int}"
@model Proyecto_Laboratorios_Univalle.Pages.EquipmentUnits.KardexModel
@using Proyecto_Laboratorios_Univalle.Models.Enums
@using Proyecto_Laboratorios_Univalle.Helpers
@{
    ViewData["Title"] = "Kardex integral del activo";
}

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="d-md-flex align-items-center mb-4 pb-3 border-bottom">
                    <div class="d-flex align-items-center">
                        <div class="btn btn-circle btn-lg btn-light-info text-info mr-3 shadow-sm">
                            <i class="fas fa-history fa-lg"></i>
                        </div>
                        <div>
                            <h3 class="card-title text-dark font-weight-bold mb-0">Kardex integral del activo</h3>
                            <h6 class="card-subtitle text-muted mt-1">
                                @Model.Unit.Equipment?.Name
                                <span class="badge badge-light border ml-2">Inv: @Model.Unit.InventoryNumber</span>
                                @if (!string.IsNullOrWhiteSpace(Model.Unit.Equipment?.Brand))
                                {
                                    <span class="badge badge-light border ml-1">@Model.Unit.Equipment.Brand</span>
                                }
                                @if (Model.Unit.Laboratory != null)
                                {
                                    <span class="badge badge-light border ml-1">@Model.Unit.Laboratory.Name</span>
                                }
                            </h6>
                        </div>
                    </div>
                    <div class="ml-auto mt-3 mt-md-0">
                        @if (Model.IsWizard)
                        {
                            <a asp-page="/Index" asp-route-ShowWizard="true" asp-route-Step="@Model.ReturnStep" asp-route-SelectedLabId="@Model.SelectedLabId" asp-route-ManagementId="@Model.ManagementId" class="btn btn-outline-secondary btn-rounded px-4 font-weight-bold shadow-sm">
                                <i class="fas fa-magic mr-2"></i> Volver al Wizard
                            </a>
                        }
                        else
                        {
                            <a href="javascript:history.back()" class="btn btn-outline-secondary btn-rounded px-4 font-weight-bold shadow-sm">
                                <i class="fas fa-arrow-left mr-2"></i> Volver
                            </a>
                        }
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-4 mb-2 mb-md-0">
                        <div class="border rounded p-3 h-100">
                            <span class="small text-uppercase text-muted font-weight-bold d-block mb-2">Estado actual</span>
                            <span class="badge badge-pill @KardexModel.GetEquipmentStatusBadge(Model.Unit.CurrentStatus) px-3 py-1">
                                @EnumHelper.GetDisplayName(Model.Unit.CurrentStatus)
                            </span>
                        </div>
                    </div>
                    <div class="col-md-4 mb-2 mb-md-0">
                        <div class="border rounded p-3 h-100">
                            <span class="small text-uppercase text-muted font-weight-bold d-block">Cambios de estado</span>
                            <strong class="h4 text-dark mb-0">@Model.StateHistory.Count</strong>
                            <span class="small text-muted d-block">Eventos operativos registrados</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="border rounded p-3 h-100">
                            <span class="small text-uppercase text-muted font-weight-bold d-block">Mantenimientos formales</span>
                            <strong class="h4 text-dark mb-0">@Model.History.Count</strong>
                            <span class="small text-muted d-block">Servicios con ficha técnica propia</span>
                        </div>
                    </div>
                </div>

                <div class="alert alert-light border small mb-4">
                    <i class="fas fa-info-circle text-info mr-2"></i>
                    Un cambio de estado no equivale a un mantenimiento. Ambos historiales se muestran separados para evitar confundir una novedad operativa con una intervención técnica formal.
                </div>

                <ul class="nav nav-tabs" id="kardexTabs" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active font-weight-bold" id="state-history-tab" data-toggle="tab" href="#state-history" role="tab" aria-controls="state-history" aria-selected="true">
                            <i class="fas fa-exchange-alt mr-2"></i> Historial de estados
                            <span class="badge badge-light border ml-1">@Model.StateHistory.Count</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link font-weight-bold" id="maintenance-history-tab" data-toggle="tab" href="#maintenance-history" role="tab" aria-controls="maintenance-history" aria-selected="false">
                            <i class="fas fa-tools mr-2"></i> Mantenimientos
                            <span class="badge badge-light border ml-1">@Model.History.Count</span>
                        </a>
                    </li>
                </ul>

                <div class="tab-content border border-top-0" id="kardexTabContent">
                    <div class="tab-pane fade show active" id="state-history" role="tabpanel" aria-labelledby="state-history-tab">
                        @if (!Model.StateHistory.Any())
                        {
                            <div class="text-center py-5 px-3">
                                <i class="fas fa-exchange-alt fa-3x text-muted mb-3 d-block"></i>
                                <h5 class="text-muted font-weight-bold">Sin cambios de estado</h5>
                                <p class="text-muted small mb-0">No existen novedades operativas registradas para esta unidad.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover v-middle mb-0">
                                    <thead class="bg-light">
                                        <tr class="small text-uppercase font-weight-bold">
                                            <th class="border-top-0">Inicio</th>
                                            <th class="border-top-0">Fin</th>
                                            <th class="border-top-0">Estado detectado</th>
                                            <th class="border-top-0">Motivo del cambio</th>
                                            <th class="border-top-0">Registro</th>
                                            <th class="border-top-0 text-center">Duración</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var state in Model.StateHistory)
                                        {
                                            <tr>
                                                <td class="small font-weight-bold">@state.StartDate.ToString("dd/MM/yyyy HH:mm")</td>
                                                <td class="small">
                                                    @if (state.EndDate.HasValue)
                                                    {
                                                        @state.EndDate.Value.ToString("dd/MM/yyyy HH:mm")
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-light border">Vigente</span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="badge badge-pill @KardexModel.GetEquipmentStatusBadge(state.Status) px-3 py-1">
                                                        @EnumHelper.GetDisplayName(state.Status)
                                                    </span>
                                                </td>
                                                <td class="small text-muted">@(string.IsNullOrWhiteSpace(state.Reason) ? "Sin motivo registrado" : state.Reason)</td>
                                                <td class="small">
                                                    <span class="font-weight-bold text-dark d-block">@(state.CreatedBy?.FullName ?? "Sistema")</span>
                                                    <span class="text-muted">@state.CreatedDate.ToString("dd/MM/yyyy HH:mm")</span>
                                                    @if (state.LastModifiedDate.HasValue)
                                                    {
                                                        <span class="text-muted d-block">Actualizado: @state.LastModifiedDate.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                                    }
                                                </td>
                                                <td class="small text-center">@(state.DurationDays.HasValue && state.DurationDays.Value >= 0 ? $"{state.DurationDays} día(s)" : "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>

                    <div class="tab-pane fade" id="maintenance-history" role="tabpanel" aria-labelledby="maintenance-history-tab">
                        @if (!Model.History.Any())
                        {
                            <div class="text-center py-5 px-3">
                                <i class="fas fa-tools fa-3x text-muted mb-3 d-block"></i>
                                <h5 class="text-muted font-weight-bold">Sin mantenimientos formales</h5>
                                <p class="text-muted small mb-0">Esta unidad tiene historial de estados, pero todavía no posee una ficha de mantenimiento asociada.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover v-middle mb-0">
                                    <thead class="bg-light">
                                        <tr class="small text-uppercase font-weight-bold">
                                            <th class="border-top-0">Fecha y estado</th>
                                            <th class="border-top-0">Gestión</th>
                                            <th class="border-top-0">Tipo y servicio</th>
                                            <th class="border-top-0">Trabajo realizado</th>
                                            <th class="border-top-0">Técnico</th>
                                            <th class="border-top-0 text-center">Contenido</th>
                                            <th class="border-top-0 text-right">Costo</th>
                                            <th class="border-top-0 text-center">Acción</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var maintenance in Model.History)
                                        {
                                            var maintenanceDate = maintenance.EndDate ?? maintenance.StartDate ?? maintenance.ScheduledDate ?? maintenance.CreatedDate;
                                            var activeTaskCount = maintenance.Tasks.Count(task => !task.IsDeleted);
                                            var totalCost = maintenance.ActualCost ?? maintenance.CalculatedTotal;
                                            <tr>
                                                <td class="small">
                                                    <span class="font-weight-bold text-dark d-block">@maintenanceDate.ToString("dd/MM/yyyy")</span>
                                                    <span class="badge badge-pill @KardexModel.GetMaintenanceStatusBadge(maintenance.Status) px-2 py-1 mt-1">
                                                        @EnumHelper.GetDisplayName(maintenance.Status)
                                                    </span>
                                                </td>
                                                <td class="small font-weight-bold">@KardexModel.FormatManagement(maintenance.Management)</td>
                                                <td class="small">
                                                    <span class="font-weight-bold text-dark d-block">@EnumHelper.GetDisplayName(maintenance.MaintenanceType)</span>
                                                    <span class="text-muted">@(maintenance.ServiceType == ServiceType.External ? "Externo" : "Interno")</span>
                                                </td>
                                                <td class="small text-muted">@(string.IsNullOrWhiteSpace(maintenance.Description) ? "Sin descripción registrada" : maintenance.Description)</td>
                                                <td class="small">@(maintenance.Technician?.FullName ?? maintenance.TechnicianName ?? "Sin asignar")</td>
                                                <td class="small text-center">
                                                    <span class="badge badge-light border d-block mb-1">@activeTaskCount tarea(s)</span>
                                                    <span class="badge badge-light border d-block">@maintenance.CostDetails.Count costo(s)</span>
                                                </td>
                                                <td class="small text-right font-weight-bold">@(totalCost > 0 ? $"Bs {totalCost:N2}" : "—")</td>
                                                <td class="text-center">
                                                    <a asp-page="/Maintenances/Details" asp-route-id="@maintenance.Id"
                                                       class="btn btn-sm btn-outline-info btn-rounded font-weight-bold px-3"
                                                       title="Ver ficha técnica completa del mantenimiento">
                                                        <i class="fas fa-eye mr-1"></i> Ver detalle
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .v-middle td { vertical-align: middle !important; }
        .tab-content > .tab-pane { min-height: 240px; }
    </style>
}
