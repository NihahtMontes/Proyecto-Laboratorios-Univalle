@page "{id:int}"
@model Proyecto_Laboratorios_Univalle.Pages.EquipmentUnits.KardexModel
@using Proyecto_Laboratorios_Univalle.Models.Enums
@using Proyecto_Laboratorios_Univalle.Helpers
@{
    ViewData["Title"] = "Kardex Histórico del Equipo";
}

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="d-md-flex align-items-center mb-4 pb-3 border-bottom">
                    <div class="d-flex align-items-center">
                        <div class="btn btn-circle btn-lg btn-light-info text-info mr-3 shadow-sm">
                            <i class="fas fa-history fa-lg"></i>
                        </div>
                        <div>
                            <h3 class="card-title text-dark font-weight-bold mb-0">Kardex Histórico de Mantenimiento</h3>
                            <h6 class="card-subtitle text-muted mt-1">
                                @Model.Unit.Equipment?.Name
                                <span class="badge badge-light border ml-2">Inv: @Model.Unit.InventoryNumber</span>
                                @if (!string.IsNullOrEmpty(Model.Unit.Equipment?.Brand))
                                {
                                    <span class="badge badge-light border ml-1">@Model.Unit.Equipment?.Brand</span>
                                }
                            </h6>
                        </div>
                    </div>
                    <div class="ml-auto mt-3 mt-md-0">
                        @if (Model.IsWizard)
                        {
                            <a asp-page="/Index" asp-route-ShowWizard="true" asp-route-Step="@Model.ReturnStep" asp-route-SelectedLabId="@Model.SelectedLabId" asp-route-ManagementId="@Model.ManagementId" class="btn btn-outline-secondary btn-rounded px-4 font-weight-bold shadow-sm">
                                <i class="fas fa-magic mr-2"></i> Volver al Wizard
                            </a>
                        }
                        else
                        {
                            <a href="javascript:history.back()" class="btn btn-outline-secondary btn-rounded px-4 font-weight-bold shadow-sm">
                                <i class="fas fa-arrow-left mr-2"></i> Volver
                            </a>
                        }
                    </div>
                </div>

                @if (!Model.History.Any())
                {
                    <div class="text-center py-5">
                        <i class="fas fa-clipboard-list fa-4x text-muted mb-3 opacity-2 d-block"></i>
                        <h5 class="text-muted font-weight-bold">Sin registros históricos</h5>
                        <p class="text-muted small">Este equipo aún no ha pasado por un proceso de mantenimiento formal.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover v-middle mb-0">
                            <thead class="bg-light">
                                <tr class="small text-uppercase font-weight-bold">
                                    <th class="border-top-0">Fecha</th>
                                    <th class="border-top-0">Descripción de Trabajos Realizados</th>
                                    <th class="border-top-0">Servicio Efectuado Por</th>
                                    <th class="border-top-0">Próx. Mantenimiento</th>
                                    <th class="border-top-0">Importe (Bs)</th>
                                    <th class="border-top-0">Satisfacción</th>
                                    <th class="border-top-0">Observaciones</th>
                                    <th class="border-top-0" style="width:120px;">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var m in Model.History)
                            {
                                var totalCost = m.ActualCost ?? m.CalculatedTotal;
                                var maintDate = m.EndDate ?? m.ScheduledDate ?? m.CreatedDate;
                                <tr>
                                    <td class="font-weight-bold small">
                                        @maintDate.ToString("dd/MM/yyyy")
                                        <div class="mt-1">
                                            @{
                                                var badgeClass = m.Status switch
                                                {
                                                    MaintenanceStatus.Completed => "badge-success",
                                                    MaintenanceStatus.InProgress => "badge-info",
                                                    MaintenanceStatus.Pending => "badge-warning",
                                                    MaintenanceStatus.Cancelled => "badge-secondary",
                                                    _ => "badge-light"
                                                };
                                            }
                                            <span class="badge @badgeClass px-2 py-1 small">@EnumHelper.GetDisplayName(m.Status)</span>
                                        </div>
                                    </td>
                                    <td>
                                        <p class="mb-1 small text-dark" style="max-width: 250px;">@(m.Description ?? "—")</p>
                                        <span class="text-muted small">@EnumHelper.GetDisplayName(m.MaintenanceType)</span>
                                        @{
                                            var activeTasks = m.Tasks?.Where(t => !t.IsDeleted).OrderBy(t => t.Id).ToList() ?? new List<Proyecto_Laboratorios_Univalle.Models.MaintenanceTask>();
                                        }
                                        @if (activeTasks.Any())
                                        {
                                            <div class="mt-2 p-2 rounded" style="background:#f8fafc; border:1px solid #e2e8f0;">
                                                <div class="small font-weight-bold text-info text-uppercase mb-1">Tareas L-48</div>
                                                @foreach (var task in activeTasks)
                                                {
                                                    <div class="small d-flex align-items-center mb-1">
                                                        <i class="@(task.IsCompleted ? "fas fa-check-circle text-success" : "far fa-circle text-muted") mr-1"></i>
                                                        <span class="@(task.IsCompleted ? "text-dark" : "text-muted")">@task.Description</span>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td class="small">@(m.Technician?.FullName ?? m.TechnicianName ?? "—")</td>
                                    <td class="small text-center">
                                        @(m.SuggestedNextMaintenanceDate?.ToString("dd/MM/yyyy") ?? "—")
                                    </td>
                                    <td class="text-center">
                                        @if (totalCost > 0)
                                        {
                                            <span class="font-weight-bold text-success small">@totalCost.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                        @if (m.CostDetails != null && m.CostDetails.Count > 0)
                                        {
                                            <div class="small text-muted">@m.CostDetails.Count ítem(s)</div>
                                        }
                                    </td>
                                    <td class="text-center small">
                                        @if (m.SatisfactionLevel.HasValue)
                                        {
                                            var satClass = m.SatisfactionLevel.Value switch
                                            {
                                                MaintenanceSatisfaction.VerySatisfied => "text-success",
                                                MaintenanceSatisfaction.Satisfied => "text-info",
                                                MaintenanceSatisfaction.Ok => "text-primary",
                                                MaintenanceSatisfaction.Dissatisfied => "text-warning",
                                                MaintenanceSatisfaction.Unacceptable => "text-danger",
                                                _ => "text-muted"
                                            };
                                            <span class="font-weight-bold @satClass">@EnumHelper.GetDisplayName(m.SatisfactionLevel.Value)</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="small text-muted" style="max-width: 180px;">@(m.Recommendations ?? m.Observations ?? "—")</td>
                                    <td class="text-center">
                                        <a asp-page="/Maintenances/Details" asp-route-id="@m.Id"
                                           class="btn btn-sm btn-outline-info btn-rounded font-weight-bold px-3 shadow-sm"
                                           title="Ver ficha técnica del mantenimiento">
                                            <i class="fas fa-eye mr-1"></i> Detalles
                                        </a>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
