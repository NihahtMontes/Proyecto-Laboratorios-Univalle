@page "{id:int}"
@model Proyecto_Laboratorios_Univalle.Pages.Equipment.DetailsModel
@using Proyecto_Laboratorios_Univalle.Models.Enums
@{
    ViewData["Title"] = "Detalles del Equipo";
}

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="d-flex no-block align-items-center mb-4 pb-3 border-bottom">
                    <div>
                        <h4 class="card-title text-dark font-weight-bold">Expediente Técnico: @Model.Equipment.Name</h4>
                        <h6 class="card-subtitle text-muted">Información detallada de la definición del activo y su origen geográfico.</h6>
                    </div>
                    <div class="ml-auto mt-2 mt-md-0">
                        <span class="badge badge-pill badge-info px-4 py-2" style="font-size: 0.9rem;">
                            <i class="fas fa-cubes mr-2"></i> Definición de Catálogo
                        </span>
                    </div>
                </div>

                <div class="row mt-4">
                    <div class="col-md-6 border-right">
                        <h5 class="font-weight-bold text-info mb-3">
                            <i class="fas fa-microscope mr-2"></i> Especificaciones del Activo
                        </h5>
                        <table class="table table-sm table-borderless bg-light rounded p-3">
                            <tbody>
                                <tr>
                                    <th class="text-muted small uppercase pl-3 pt-3" style="width: 40%;">Marca / Modelo</th>
                                    <td class="font-weight-bold pt-3 text-dark">
                                        @(Model.Equipment.Brand ?? "N/A") / @(Model.Equipment.Model ?? "N/A")
                                    </td>
                                </tr>
                                <tr>
                                    <th class="text-muted small uppercase pl-3">Clasificación</th>
                                    <td class="font-weight-bold text-dark">
                                        @if (Model.Equipment.Category == EquipmentCategory.Utensil)
                                        {
                                            @Model.Equipment.UtensilType
                                        }
                                        else
                                        {
                                            @Model.Equipment.TypeClassification
                                        }
                                        <small class="text-muted d-block">(@Model.Equipment.Category)</small>
                                    </td>
                                </tr>
                                <tr>
                                    <th class="text-muted small uppercase pl-3 pb-3">Vida Útil Est.</th>
                                    <td class="font-weight-bold pb-3 text-dark">
                                        @(Model.Equipment.UsefulLifeYears?.ToString() ?? "No definida") años
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="col-md-6">
                        <h5 class="font-weight-bold text-info mb-3">
                            <i class="fas fa-globe-americas mr-2"></i> Origen y Procedencia
                        </h5>
                        <table class="table table-sm table-borderless bg-light rounded p-3">
                            <tbody>
                                <tr>
                                    <th class="text-muted small uppercase pl-3 pb-3">País</th>
                                    <td class="font-weight-bold pb-3 text-dark">@(Model.Equipment.Country?.Name ?? "No Definido")</td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="alert alert-soft-info py-2 px-3 small border-0 mt-3">
                            <i class="fas fa-info-circle mr-2"></i> La ubicación física (Laboratorio) se rastrea por cada unidad individual.
                        </div>
                    </div>
                </div>

                <!-- NOTAS DEL FABRICANTE MOVIDAS ARRIBA CON PAGINACIÓN -->
                <div class="card border shadow-sm mt-4 mb-4">
                    <div class="card-header bg-white border-bottom-0 pt-3 px-4 d-flex justify-content-between align-items-center">
                        <h6 class="font-weight-bold mb-0 text-dark">
                            <i class="fas fa-sticky-note mr-2 text-info"></i>Notas del Fabricante / Prevención
                        </h6>
                        @if (Model.Equipment.Notes != null && Model.Equipment.Notes.Count > 4)
                        {
                            <div class="pagination-controls btn-group btn-group-sm shadow-sm">
                                <button type="button" class="btn btn-outline-secondary" id="btnPrevNotes" disabled title="Página Anterior"><i class="fas fa-chevron-left"></i></button>
                                <span class="btn btn-light disabled font-weight-bold text-dark px-3" id="lblPageNotes" style="opacity: 1 !important;">1 / ?</span>
                                <button type="button" class="btn btn-outline-secondary" id="btnNextNotes" title="Página Siguiente"><i class="fas fa-chevron-right"></i></button>
                            </div>
                        }
                    </div>
                    <div class="card-body pt-2 px-4 pb-4">
                        @if (Model.Equipment.Notes != null && Model.Equipment.Notes.Any())
                        {
                            <ul class="mb-0 pl-3" id="equipmentNotesList">
                                @foreach (var note in Model.Equipment.Notes)
                                {
                                    <li class="mb-3 small text-dark font-weight-bold note-item">@note.Note</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="text-center py-3">
                                <i class="fas fa-comment-slash fa-2x text-light mb-2 d-block"></i>
                                <span class="text-muted small italic">No se han registrado pautas de mantenimiento preventivo para este modelo.</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="mt-5">
                    <div class="d-flex align-items-center mb-4 pb-2 border-bottom">
                        <h5 class="font-weight-bold text-dark mb-0">
                            <i class="fas fa-boxes mr-2 text-warning"></i> Control de Unidades Físicas
                        </h5>
                        <div class="ml-auto">
                            <a asp-page="/EquipmentUnits/Create" asp-route-equipmentId="@Model.Equipment.Id" class="btn btn-sm btn-success btn-rounded px-3">
                                <i class="fas fa-plus mr-1"></i> Registrar Nueva Unidad
                            </a>
                        </div>
                    </div>

                    <div class="bg-light p-3 mb-4 rounded border-left border-info">
                        <form method="get" data-live-filter-form>
                            <label asp-for="SearchTerm" class="sr-only">Buscar por número de inventario o serie</label>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-white border-right-0"><i class="fas fa-search text-muted"></i></span>
                                </div>
                                <input type="search" asp-for="SearchTerm"
                                       class="form-control border-left-0 @(!string.IsNullOrWhiteSpace(Model.SearchTerm) ? "border-info" : "")"
                                       placeholder="Buscar por número de inventario o serie"
                                       autocomplete="off"
                                       data-live-filter-search />
                                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                                {
                                    <div class="input-group-append">
                                        <a asp-page="./Details" asp-route-id="@Model.Equipment.Id" class="btn btn-link text-muted" title="Limpiar filtros">
                                            <i class="fas fa-times mr-1"></i> Limpiar
                                        </a>
                                    </div>
                                }
                            </div>
                            <div class="small text-muted text-right mt-2" aria-live="polite">
                                <strong class="text-dark">@(Model.Equipment.Units?.Count ?? 0)</strong> unidad(es)
                            </div>
                        </form>
                    </div>

                    @if (Model.Equipment.Units != null && Model.Equipment.Units.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover bg-white border shadow-sm rounded">
                                <thead class="bg-light text-muted uppercase small font-weight-bold">
                                    <tr>
                                        <th>Identificación</th>
                                        <th>Laboratorio / Facultad</th>
                                        <th>Estado Operativo</th>
                                        <th>Condición Física</th>
                                        <th class="text-center">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var unit in Model.Equipment.Units)
                                    {
                                        <tr>
                                            <td class="font-weight-bold text-dark v-middle">
                                                <i class="fas fa-barcode text-muted mr-2"></i>@unit.InventoryNumber
                                                <div class="small text-muted mt-1">S/N: @(unit.SerialNumber ?? "N/A")</div>
                                                @if (unit.Career != null)
                                                {
                                                    <div class="small text-info mt-1"><i class="fas fa-graduation-cap mr-1"></i>@unit.Career.Name</div>
                                                }
                                            </td>
                                            <td class="v-middle">
                                                <div class="font-weight-bold">@(unit.Laboratory?.Name ?? "No asignado")</div>
                                                <small class="text-muted">@(unit.Laboratory?.Faculty?.Name ?? "Sin facultad")</small>
                                            </td>
                                            <td class="v-middle">
                                                @{
                                                    var badgeClass = unit.CurrentStatus switch
                                                    {
                                                        EquipmentStatus.Operational => "badge-success",
                                                        EquipmentStatus.UnderMaintenance => "badge-warning",
                                                        EquipmentStatus.OutOfService => "badge-danger",
                                                        EquipmentStatus.Deleted => "badge-dark",
                                                        _ => "badge-secondary"
                                                    };
                                                }
                                                <span class="badge badge-pill @badgeClass px-3 py-1">@Html.DisplayFor(m => unit.CurrentStatus)</span>
                                            </td>
                                            <td class="v-middle">
                                                <span class="badge badge-pill badge-warning px-2 py-1 font-weight-bold shadow-none small text-white">@Html.DisplayFor(m => unit.PhysicalCondition)</span>
                                            </td>
                                            <td class="text-center v-middle">
                                                <div class="btn-group shadow-sm">
                                                    <a asp-page="/EquipmentUnits/Edit" asp-route-id="@unit.Id" class="btn btn-sm btn-outline-warning btn-rounded-left" title="Editar">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <a asp-page="/EquipmentUnits/Details" asp-route-id="@unit.Id" class="btn btn-sm btn-outline-info" title="Ver Historial">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <form method="post" asp-page-handler="DeleteUnit" asp-route-id="@unit.Id" class="d-inline delete-unit-form m-0">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger btn-rounded-right" title="Dar de baja">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 bg-light rounded border border-dashed">
                            <i class="fas fa-info-circle fa-2x text-muted mb-3 d-block opacity-5"></i>
                            <p class="text-muted mb-0 font-weight-bold text-dark">No se encontraron unidades registradas.</p>
                            <small class="text-muted">Haga clic en 'Registrar Nueva Unidad' para dar de alta un activo físico.</small>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(Model.Equipment.Description))
                {
                    <div class="alert alert-light border-0 mt-4 p-3 shadow-none small text-dark border-left border-info">
                        <label class="font-weight-bold uppercase mb-1 d-block text-info"><i class="fas fa-info-circle mr-2"></i> Descripción / Ficha Técnica:</label>
                        <div class="text-muted">@Model.Equipment.Description</div>
                    </div>
                }


            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm border-0 mb-4 overflow-hidden">
            <div class="card-body p-3 text-center">
                @if (!string.IsNullOrEmpty(Model.Equipment.ImageUrl))
                {
                    <img src="~/uploads/equipment/@Model.Equipment.ImageUrl" alt="@Model.Equipment.Name" class="img-fluid rounded shadow-sm" style="max-height: 250px; object-fit: contain;" />
                }
                else
                {
                    <div class="py-5 bg-light rounded border border-dashed text-muted">
                        <i class="fas fa-camera fa-3x mb-2 opacity-5"></i>
                        <p class="small font-weight-bold mb-0 uppercase">Sin imagen de referencia</p>
                        <small class="opacity-7">Puede subir una foto editando la ficha técnica.</small>
                    </div>
                }
            </div>
        </div>


        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <h5 class="card-title text-dark font-weight-bold mb-4 small uppercase border-bottom pb-2">
                    <i class="fas fa-history mr-2 text-warning"></i> Control de Auditoría
                </h5>
                <div class="small">
                    <div class="mb-3">
                        <label class="text-muted d-block small uppercase mb-0 font-weight-bold">Alta del Registro</label>
                        <span class="font-weight-bold text-dark d-block">@Model.Equipment.CreatedDate.ToString("dd/MM/yyyy HH:mm")</span>
                        <div class="text-muted pt-1"><i class="fas fa-user-circle mr-1"></i> @(Model.Equipment.CreatedBy?.FullName ?? "Sistema")</div>
                    </div>
                    @if (Model.Equipment.LastModifiedDate.HasValue)
                    {
                        <div class="mb-0 border-top pt-3 mt-3">
                            <label class="text-muted d-block small uppercase mb-0 font-weight-bold">Última Gestión</label>
                            <span class="font-weight-bold text-dark d-block">@Model.Equipment.LastModifiedDate.Value.ToString("dd/MM/yyyy HH:mm")</span>
                            <div class="text-muted pt-1"><i class="fas fa-user-edit mr-1"></i> @(Model.Equipment.ModifiedBy?.FullName ?? "-")</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="form-actions mt-4">
            <a asp-page="./Edit" asp-route-id="@Model.Equipment.Id" asp-route-returnUrl="Details" class="btn btn-warning btn-block btn-rounded text-white shadow-sm font-weight-bold py-2 mb-2">
                <i class="fas fa-edit mr-1"></i> Modificar Ficha Técnica
            </a>
            <a asp-page="./Index" class="btn btn-outline-secondary btn-block btn-rounded py-2 mb-4 font-weight-bold">
                <i class="fas fa-list mr-1"></i> Volver al Catálogo
            </a>

            <a asp-page="./Delete" asp-route-id="@Model.Equipment.Id" class="btn btn-link btn-block text-danger small font-weight-bold mt-2">
                <i class="fas fa-trash-alt mr-1"></i> Dar de Baja Definición del Sistema
            </a>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .v-middle {
            vertical-align: middle !important;
        }

        .italic {
            font-style: italic;
        }

        .opacity-7 {
            opacity: 0.7;
        }

        .opacity-5 {
            opacity: 0.5;
        }

        .border-dashed {
            border-style: dashed !important;
        }

        .alert-soft-info {
            background-color: #e1f5fe;
            color: #01579b;
            border-left: 5px solid #03a9f4;
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const notes = document.querySelectorAll('.note-item');
            if (notes.length > 4) {
                const itemsPerPage = 4;
                let currentPage = 1;
                const totalPages = Math.ceil(notes.length / itemsPerPage);

                const btnPrev = document.getElementById('btnPrevNotes');
                const btnNext = document.getElementById('btnNextNotes');
                const lblPage = document.getElementById('lblPageNotes');

                function renderPage(page) {
                    notes.forEach((note, index) => {
                        if (index >= (page - 1) * itemsPerPage && index < page * itemsPerPage) {
                            note.style.display = 'list-item';
                        } else {
                            note.style.display = 'none';
                        }
                    });
                    lblPage.innerText = page + ' / ' + totalPages;
                    btnPrev.disabled = page === 1;
                    btnNext.disabled = page === totalPages;
                }

                btnPrev.addEventListener('click', () => { 
                    if (currentPage > 1) { 
                        currentPage--; 
                        renderPage(currentPage); 
                    } 
                });
                
                btnNext.addEventListener('click', () => { 
                    if (currentPage < totalPages) { 
                        currentPage++; 
                        renderPage(currentPage); 
                    } 
                });

                renderPage(1);
            }

            // Confirmación SweetAlert2 para eliminar unidad física
            $(document).on('submit', '.delete-unit-form', function(e) {
                e.preventDefault();
                var form = this;
                if (typeof Swal === 'undefined') {
                    HTMLFormElement.prototype.submit.call(form);
                    return;
                }
                Swal.fire({
                    title: '¿Dar de baja esta unidad?',
                    text: 'Esta acción marcará la unidad física como eliminada.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, dar de baja',
                    cancelButtonText: 'Cancelar',
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d'
                }).then(function(result) {
                    if (result && (result.isConfirmed === true || result.value === true)) {
                        HTMLFormElement.prototype.submit.call(form);
                    }
                });
            });
        });
    </script>
}
