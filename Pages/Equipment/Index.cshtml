@page
@model Proyecto_Laboratorios_Univalle.Pages.Equipment.IndexModel
@using Proyecto_Laboratorios_Univalle.Helpers
@using Proyecto_Laboratorios_Univalle.Models.Enums

@{
    var isEquipmentCategory = Model.SelectedCategory == EquipmentCategory.Equipment;
    var isUtensilCategory = Model.SelectedCategory == EquipmentCategory.Utensil;
    var hasSubclassification = isEquipmentCategory || isUtensilCategory;
    var hasActiveFilters = !string.IsNullOrWhiteSpace(Model.SearchTerm)
        || Model.SelectedCategory.HasValue
        || Model.SelectedEquipmentTypeClassification.HasValue
        || Model.SelectedUtensilType.HasValue
        || Model.SelectedReviewStatus.HasValue
        || Model.SelectedLaboratoryId.HasValue;
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mx-4 mt-3" role="alert">
        <i class="fas fa-exclamation-triangle mr-2"></i> @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0 mt-3">
            <div class="card-body">
                <div class="d-md-flex align-items-center mb-4">
                    <div>
                        <h3 class="card-title text-dark font-weight-bold mt-2 ml-2">Registro y codificación de activos fijos del laboratorio</h3>
                        <h6 class="card-subtitle text-muted ml-2">Definiciones técnicas y control de inventario global.</h6>
                    </div>
                    <div class="ml-auto mt-3">
                        <a asp-page="Create" class="btn bg-white border btn-rounded shadow-sm text-dark px-4 font-weight-bold">
                            <i class="fas fa-plus-circle mr-1 text-info"></i> Registrar nuevo activo
                        </a>
                    </div>
                </div>

                <div class="bg-light p-3 mb-4 rounded border-left border-info">
                    <form method="get" data-live-filter-form>
                        <label asp-for="SearchTerm" class="sr-only">Buscar por nombre, marca o código</label>
                        <div class="input-group mb-3">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-white border-right-0"><i class="fas fa-search text-muted"></i></span>
                            </div>
                            <input type="search" asp-for="SearchTerm"
                                   class="form-control border-left-0 @(!string.IsNullOrWhiteSpace(Model.SearchTerm) ? "border-info" : "")"
                                   placeholder="Buscar por nombre, marca o código"
                                   autocomplete="off"
                                   data-live-filter-search />
                        </div>

                        <div class="d-flex flex-wrap align-items-center border-top pt-3">
                            <select asp-for="SelectedCategory"
                                    class="custom-select btn-rounded w-auto mw-100 mr-2 mb-2 @(Model.SelectedCategory.HasValue ? "border-info text-info font-weight-bold" : "")"
                                    asp-items="Html.GetEnumSelectList<EquipmentCategory>()"
                                    aria-label="Tipo de recurso"
                                    data-live-filter-control>
                                <option value="">Tipo de recurso</option>
                            </select>

                            <div id="subclassificationColumn" class="mr-2 mb-2 @(hasSubclassification ? "" : "d-none")">
                                <div id="equipmentSubclassificationContainer" class="@(isEquipmentCategory ? "" : "d-none")">
                                    <select asp-for="SelectedEquipmentTypeClassification"
                                            class="custom-select btn-rounded w-auto mw-100 @(Model.SelectedEquipmentTypeClassification.HasValue ? "border-info text-info font-weight-bold" : "")"
                                            asp-items="Model.EquipmentTypeClassificationOptions"
                                            aria-label="Subclasificación de equipo"
                                            data-live-filter-control
                                            disabled="@(!isEquipmentCategory)">
                                        <option value="">Subclasificación</option>
                                    </select>
                                </div>

                                <div id="utensilSubclassificationContainer" class="@(isUtensilCategory ? "" : "d-none")">
                                    <select asp-for="SelectedUtensilType"
                                            class="custom-select btn-rounded w-auto mw-100 @(Model.SelectedUtensilType.HasValue ? "border-info text-info font-weight-bold" : "")"
                                            asp-items="Model.UtensilTypeOptions"
                                            aria-label="Subclasificación de utensilio"
                                            data-live-filter-control
                                            disabled="@(!isUtensilCategory)">
                                        <option value="">Subclasificación</option>
                                    </select>
                                </div>
                            </div>

                            <select asp-for="SelectedReviewStatus"
                                    class="custom-select btn-rounded w-auto mw-100 mr-2 mb-2 @(Model.SelectedReviewStatus.HasValue ? "border-info text-info font-weight-bold" : "")"
                                    aria-label="Estado de revisión"
                                    data-live-filter-control>
                                <option value="">Revisión</option>
                                <option value="@((int)EquipmentClassificationReviewStatus.Confirmed)" class="text-success">● @EnumHelper.GetDisplayName(EquipmentClassificationReviewStatus.Confirmed)</option>
                                <option value="@((int)EquipmentClassificationReviewStatus.PendingClient)" class="text-warning">● @EnumHelper.GetDisplayName(EquipmentClassificationReviewStatus.PendingClient)</option>
                                <option value="@((int)EquipmentClassificationReviewStatus.LegacyInferred)" class="text-danger">● @EnumHelper.GetDisplayName(EquipmentClassificationReviewStatus.LegacyInferred)</option>
                            </select>

                            <select asp-for="SelectedLaboratoryId"
                                    class="custom-select btn-rounded w-auto mw-100 mr-2 mb-2 @(Model.SelectedLaboratoryId.HasValue ? "border-info text-info font-weight-bold" : "")"
                                    asp-items="Model.LaboratoriesList"
                                    aria-label="Ambiente"
                                    data-live-filter-control>
                                <option value="">Ambiente</option>
                            </select>

                            @if (hasActiveFilters)
                            {
                                <a asp-page="./Index" class="btn btn-link btn-sm text-muted mb-2" title="Limpiar filtros">
                                    <i class="fas fa-times mr-1"></i> Limpiar filtros
                                </a>
                            }

                            <span class="small text-muted ml-auto mb-2" aria-live="polite">
                                <strong class="text-dark">@Model.Equipment.TotalCount</strong> activo(s)
                            </span>
                        </div>
                    </form>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover v-middle">
                        <thead class="bg-light">
                            <tr class="small uppercase font-weight-bold">
                                <th>Definición de Equipo</th>
                                <th>Clasificación</th>
                                <th>Ubicación Predominante</th>
                                <th>Marca / Modelo</th>
                                <th class="text-center">Existencias</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Equipment == null || !Model.Equipment.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted italic font-weight-bold">
                                        <i class="fas fa-inbox fa-3x mb-3 d-block opacity-2"></i>
                                        No se encontraron definiciones de equipos para la búsqueda actual.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model.Equipment)
                                {
                                    var classificationConfirmed = item.ClassificationReviewStatus == EquipmentClassificationReviewStatus.Confirmed;
                                    var resolvedCategory = item.Category;
                                    var subclassificationName = !classificationConfirmed
                                        ? (item.ClassificationReviewStatus == EquipmentClassificationReviewStatus.PendingClient
                                            ? "Pendiente de cliente"
                                            : "Inferido legado")
                                        : resolvedCategory switch
                                    {
                                        EquipmentCategory.Equipment when item.TypeClassification.HasValue => EnumHelper.GetDisplayName(item.TypeClassification.Value),
                                        EquipmentCategory.Utensil when item.UtensilType.HasValue => EnumHelper.GetDisplayName(item.UtensilType.Value),
                                        EquipmentCategory.Other => item.OtherClassificationDetail ?? "Otro confirmado",
                                        _ => "Sin subclasificación confirmada"
                                    };
                                    var classificationBadge = !classificationConfirmed
                                        ? (item.ClassificationReviewStatus == EquipmentClassificationReviewStatus.PendingClient ? "badge-warning" : "badge-dark")
                                        : resolvedCategory == EquipmentCategory.Equipment ? "badge-info"
                                        : resolvedCategory == EquipmentCategory.Utensil ? "badge-success"
                                        : "badge-secondary";

                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div>
                                                    <h6 class="m-b-0 font-weight-bold text-dark">@item.Name</h6>
                                                    <span class="text-muted small">@(classificationConfirmed ? EnumHelper.GetDisplayName(resolvedCategory) : "Clasificación no confirmada")</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="v-middle">
                                            <span class="badge badge-pill @classificationBadge px-3 py-1 shadow-sm font-weight-bold">
                                                <i class="fas @(resolvedCategory == EquipmentCategory.Equipment ? "fa-microchip" : resolvedCategory == EquipmentCategory.Utensil ? "fa-utensils" : "fa-cube") mr-1"></i> @subclassificationName
                                            </span>
                                        </td>
                                        <td class="v-middle">
                                            <div class="small">
                                                @if (item.Units != null && item.Units.Any(u => u.Laboratory != null && u.CurrentStatus != EquipmentStatus.Deleted))
                                                {
                                                    var predominantLab = item.Units
                                                    .Where(u => u.Laboratory != null && u.CurrentStatus != EquipmentStatus.Deleted)
                                                    .GroupBy(u => u.Laboratory!.Name)
                                                    .OrderByDescending(g => g.Count())
                                                    .First().Key;

                                                    <div class="text-dark font-weight-bold">
                                                        <i class="fas fa-map-marker-alt mr-1 text-danger"></i> @predominantLab
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="text-muted italic">
                                                        <i class="fas fa-map-marker-alt mr-1 opacity-5"></i> Sin asignar
                                                    </div>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <div class="text-dark">@(item.Brand ?? "Catálogo")</div>
                                            <small class="text-muted italic">@(item.Model ?? "-")</small>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge badge-pill @classificationBadge px-3 py-1 text-white border-0 shadow-sm font-weight-bold">
                                                <i class="fas fa-cubes mr-1" style="font-size: 0.65rem;"></i> @(item.Units?.Count ?? 0) Und.
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group">
                                                <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info btn-rounded mx-1" title="Ver Expediente Téc.">
                                                    <i class="fas fa-search-plus"></i>
                                                </a>
                                                <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning btn-rounded" title="Editar">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-page="/EquipmentUnits/Create" asp-route-equipmentId="@item.Id" class="btn btn-sm btn-outline-success btn-rounded ml-1" title="Agregar Unidad Física">
                                                    <i class="fas fa-plus"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.Equipment!.TotalPages > 1)
                {
                    <nav aria-label="Paginación">
                        <ul class="pagination justify-content-center">
                            @if (Model.Equipment.HasPreviousPage)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-page="./Index" asp-route-pageIndex="@(Model.Equipment.PageIndex - 1)" asp-route-SearchTerm="@Model.SearchTerm" asp-route-SelectedLaboratoryId="@Model.SelectedLaboratoryId" asp-route-SelectedCategory="@Model.SelectedCategory" asp-route-SelectedEquipmentTypeClassification="@Model.SelectedEquipmentTypeClassification" asp-route-SelectedUtensilType="@Model.SelectedUtensilType" asp-route-SelectedReviewStatus="@Model.SelectedReviewStatus">Anterior</a>
                                </li>
                            }
                            @for (var i = 1; i <= Model.Equipment.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.Equipment.PageIndex ? "active" : "")">
                                    <a class="page-link" asp-page="./Index" asp-route-pageIndex="@i" asp-route-SearchTerm="@Model.SearchTerm" asp-route-SelectedLaboratoryId="@Model.SelectedLaboratoryId" asp-route-SelectedCategory="@Model.SelectedCategory" asp-route-SelectedEquipmentTypeClassification="@Model.SelectedEquipmentTypeClassification" asp-route-SelectedUtensilType="@Model.SelectedUtensilType" asp-route-SelectedReviewStatus="@Model.SelectedReviewStatus">@i</a>
                                </li>
                            }
                            @if (Model.Equipment.HasNextPage)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-page="./Index" asp-route-pageIndex="@(Model.Equipment.PageIndex + 1)" asp-route-SearchTerm="@Model.SearchTerm" asp-route-SelectedLaboratoryId="@Model.SelectedLaboratoryId" asp-route-SelectedCategory="@Model.SelectedCategory" asp-route-SelectedEquipmentTypeClassification="@Model.SelectedEquipmentTypeClassification" asp-route-SelectedUtensilType="@Model.SelectedUtensilType" asp-route-SelectedReviewStatus="@Model.SelectedReviewStatus">Siguiente</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .v-middle td {
            vertical-align: middle !important;
        }

        .uppercase {
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .italic {
            font-style: italic;
        }

        .opacity-2 {
            opacity: 0.2;
        }
    </style>
}

@section Scripts {
    <script src="~/assets/libs/sweetalert2/dist/sweetalert2.all.min.js"></script>
    <script>
        $(function () {
            $('[data-toggle="tooltip"]').tooltip();

            var equipmentCategory = '@((int)EquipmentCategory.Equipment)';
            var utensilCategory = '@((int)EquipmentCategory.Utensil)';
            var $category = $('#SelectedCategory');
            var $subclassificationColumn = $('#subclassificationColumn');
            var $equipmentContainer = $('#equipmentSubclassificationContainer');
            var $utensilContainer = $('#utensilSubclassificationContainer');
            var $equipmentSelect = $('#SelectedEquipmentTypeClassification');
            var $utensilSelect = $('#SelectedUtensilType');

            function synchronizeSubclassification(resetInactiveValues) {
                var selectedCategory = $category.val();
                var showEquipment = selectedCategory === equipmentCategory;
                var showUtensil = selectedCategory === utensilCategory;

                $subclassificationColumn.toggleClass('d-none', !showEquipment && !showUtensil);
                $equipmentContainer.toggleClass('d-none', !showEquipment);
                $utensilContainer.toggleClass('d-none', !showUtensil);
                $equipmentSelect.prop('disabled', !showEquipment);
                $utensilSelect.prop('disabled', !showUtensil);

                if (resetInactiveValues && !showEquipment) {
                    $equipmentSelect.val('');
                }

                if (resetInactiveValues && !showUtensil) {
                    $utensilSelect.val('');
                }
            }

            $category.on('change', function () {
                synchronizeSubclassification(true);
            });

            synchronizeSubclassification(false);
        });
    </script>
}
